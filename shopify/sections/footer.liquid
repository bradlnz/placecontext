<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <span class="site-footer__name">{{ shop.name }}</span>
      {%- if section.settings.tagline != blank -%}
        <p class="site-footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}
      <a class="site-footer__email" href="mailto:{{ settings.support_email }}">{{ settings.support_email }}</a>
    </div>

    <nav class="site-footer__nav" aria-label="{{ 'general.navigation.footer' | t }}">
      {%- for link in section.settings.menu.links -%}
        <a class="site-footer__nav-link" href="{{ link.url }}">{{ link.title }}</a>
      {%- endfor -%}
    </nav>
  </div>

  <div class="container site-footer__bottom">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ 'general.footer.rights' | t }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Property feasibility reports, delivered fast."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "footer"
    }
  ]
}
{% endschema %}
