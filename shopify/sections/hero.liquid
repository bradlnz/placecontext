{%- comment -%}
  Hero — headline, subheading, primary CTA and optional background image.
  If no button link is set, the primary CTA falls back to the store's first product.
{%- endcomment -%}

{%- assign cta_href = section.settings.button_link -%}
{%- if cta_href == blank -%}
  {%- assign cta_href = collections.all.products.first.url -%}
{%- endif -%}

<section class="hero{% if section.settings.image != blank %} hero--with-image{% endif %}">
  {%- if section.settings.image != blank -%}
    <div class="hero__media" aria-hidden="true">
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        alt=""
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    </div>
    <div class="hero__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="container hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="hero__heading">{{ section.settings.heading }}</h1>

    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="hero__actions">
      {%- if section.settings.button_label != blank and cta_href != blank -%}
        <a class="button button--primary" href="{{ cta_href }}">
          {{ section.settings.button_label }}
          {% render 'icon', icon: 'arrow-right' %}
        </a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a class="button button--ghost" href="{{ section.settings.secondary_link | default: '#sample-report' }}">
          {{ section.settings.secondary_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Site feasibility reports"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Know what your site can do before you commit"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A clear, decision-ready feasibility report for your property or development site — researched by our automated platform and reviewed by a human before it lands in your inbox."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Order your report"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to link to your first product."
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "See a sample report"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link",
      "info": "Leave empty to jump to the sample report section."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image (optional)"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
