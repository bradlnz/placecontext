{%- comment -%}
  FAQ — accessible accordion built on native <details> elements (works
  without JavaScript; theme.js adds close-others behaviour). Ships with
  default questions until blocks are added in the theme editor.
{%- endcomment -%}

<section class="section faq" id="faq">
  <div class="container faq__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="faq__list">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <details class="faq__item" {{ block.shopify_attributes }}>
            <summary class="faq__question">{{ block.settings.question }}</summary>
            <div class="faq__answer">{{ block.settings.answer | newline_to_br }}</div>
          </details>
        {%- endfor -%}
      {%- else -%}
        <details class="faq__item">
          <summary class="faq__question">How long does a report take?</summary>
          <div class="faq__answer">Standard reports are delivered by email within 5 business days of payment. If we need anything extra from you about the site, we'll get in touch first — the delivery window starts once we have what we need.</div>
        </details>
        <details class="faq__item">
          <summary class="faq__question">What do you need from me?</summary>
          <div class="faq__answer">Just the site address and a short description, which you enter on the product page before checkout. Surveys, plans or photos help — paste a share link in the order form or email them to us afterwards.</div>
        </details>
        <details class="faq__item">
          <summary class="faq__question">What format is the report?</summary>
          <div class="faq__answer">A decision-ready PDF you can forward to partners, lenders or council. Source data and references are included in the appendix.</div>
        </details>
        <details class="faq__item">
          <summary class="faq__question">What if the site turns out not to be feasible?</summary>
          <div class="faq__answer">That's a valid — and valuable — result. The report states the findings plainly and outlines next steps either way. See our refund policy for the details.</div>
        </details>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked questions"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question text"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Answer text."
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        {
          "type": "question",
          "settings": {
            "question": "How long does a report take?",
            "answer": "Standard reports are delivered by email within 5 business days of payment."
          }
        },
        {
          "type": "question",
          "settings": {
            "question": "What do you need from me?",
            "answer": "Just the site address and a short description at checkout. Documents can be shared via a link or email afterwards."
          }
        }
      ]
    }
  ]
}
{% endschema %}
