FROM python:3.12-slim
WORKDIR /app
COPY --chown=65534:65534 requirements.txt /app/requirements.txt
COPY --chown=65534:65534 . /app
USER 65534:65534
ENV PYTHONPATH=/app/vendor PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1
RUN pip install --no-cache-dir --target /app/vendor -r requirements.txt
EXPOSE 8080
CMD ["python", "-u", "app.py"]
