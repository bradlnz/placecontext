#!/usr/bin/env bash
#
# pctl — PlaceContext control CLI.
#
# One tool to manage the whole lifecycle, on a laptop or across a fleet:
#
#   • Local dev cluster (k3d: k3s-in-Docker) — a real 1-server + 2-agent cluster on this box.
#   • Production cluster (k3s) — a server node plus worker nodes across multiple machines.
#   • Image build/import, manifest deploy, status, logs.
#
# It is self-contained (bash + the tools it orchestrates) and safe to re-run: every
# command is idempotent. Run `pctl help` for the command list, `pctl doctor` to check deps.
#
set -euo pipefail

# ── Config (override via environment) ────────────────────────────────────────────────────────────
PCTL_CLUSTER="${PCTL_CLUSTER:-placecontext}"          # k3d cluster name (dev)
PCTL_NAMESPACE="${PCTL_NAMESPACE:-placecontext}"       # kubernetes namespace
PCTL_IMAGE="${PCTL_IMAGE:-ghcr.io/bradlnz/placecontext:local}"
PCTL_IMAGE_TAR="${PCTL_IMAGE_TAR:-deploy/placecontext-local.tar}"
PCTL_PORT="${PCTL_PORT:-7700}"                         # host port → ingress :80 (dev)
PCTL_AGENTS="${PCTL_AGENTS:-2}"                         # dev worker nodes
PCTL_SERVERS="${PCTL_SERVERS:-1}"                       # dev server nodes
PCTL_DB_CONTAINERS="${PCTL_DB_CONTAINERS:-placecontext-db devcontext-db}"  # dev docker pg to clean

# Resolve repo root (this script lives in <root>/deploy). Follow symlinks first so
# `ln -s <root>/deploy/pctl /usr/local/bin/pctl` still lands on the real tree.
SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in /*) SELF="$link";; *) SELF="$(dirname "$SELF")/$link";; esac
done
SELF="$(cd "$(dirname "$SELF")" && pwd)/$(basename "$SELF")"
# tools/pctl lives in <root>/tools — repo root is parent of tools/
if [ "$(basename "$(dirname "$SELF")")" = "tools" ]; then
  ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
else
  ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
fi
cd "$ROOT"
K3S_DIR="deploy/k3s"

# ── Pretty output ────────────────────────────────────────────────────────────────────────────────
if [ -t 1 ]; then
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_CYAN=$'\033[1;36m'; C_GREEN=$'\033[1;32m'; C_YELLOW=$'\033[1;33m'; C_RED=$'\033[1;31m'
else
  C_RESET=""; C_DIM=""; C_BOLD=""; C_CYAN=""; C_GREEN=""; C_YELLOW=""; C_RED=""
fi
say()  { printf '%s==>%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }
ok()   { printf '%s✓%s %s\n'  "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s!%s %s\n'  "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()  { printf '%s✗%s %s\n'  "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# kubectl wrapper — honours PCTL_KUBECTL (e.g. set to "k3s kubectl" or a context flag).
KUBECTL="${PCTL_KUBECTL:-kubectl}"
kube() { $KUBECTL "$@"; }

# Point kubectl at the k3d cluster's own kubeconfig, isolated from any system-wide
# KUBECONFIG (e.g. a root-owned /etc/rancher/k3s/k3s.yaml from a prod k3s install).
use_dev_kubeconfig() {
  # `|| true` so a k3d failure reaches the die below with a real message, instead of set -e
  # killing the script silently mid-substitution.
  local kcfg; kcfg="$(k3d kubeconfig write "$PCTL_CLUSTER" 2>/dev/null || true)"
  [ -n "$kcfg" ] || die "could not obtain kubeconfig for cluster '$PCTL_CLUSTER'"
  export KUBECONFIG="$kcfg"
  KUBECTL="kubectl --context k3d-$PCTL_CLUSTER"
}

# Portable base64url encode (stdin→stdout) / decode (arg→stdout) — GNU + macOS/BSD.
b64url_encode() {
  local raw b64
  raw="$(cat)"
  if b64="$(printf '%s' "$raw" | base64 -w0 2>/dev/null)"; then :; else
    b64="$(printf '%s' "$raw" | base64 2>/dev/null | tr -d '\n\r')" || return 1
  fi
  printf '%s' "$b64" | sed 'y#+/#-_#' | tr -d '=\n\r'
}
b64url_decode() {
  local b64="$1" decoded
  b64="$(printf '%s' "$b64" | sed 'y#-_#+/#')"
  while [ $((${#b64} % 4)) -ne 0 ]; do b64="${b64}="; done
  if decoded="$(printf '%s' "$b64" | base64 -d 2>/dev/null)"; then printf '%s' "$decoded"; return 0; fi
  if decoded="$(printf '%s' "$b64" | base64 -D 2>/dev/null)"; then printf '%s' "$decoded"; return 0; fi
  if decoded="$(printf '%s' "$b64" | base64 --decode 2>/dev/null)"; then printf '%s' "$decoded"; return 0; fi
  return 1
}

# k3s node-token from host path or k3d server container (Mac/docker master).
resolve_node_token() {
  local tok="" c="k3d-${PCTL_CLUSTER}-server-0"
  if [ -r /var/lib/rancher/k3s/server/node-token ]; then
    tok="$(tr -d '[:space:]' < /var/lib/rancher/k3s/server/node-token)"
    [ -n "$tok" ] && { printf '%s\n' "$tok"; return 0; }
  fi
  if have docker && docker inspect "$c" >/dev/null 2>&1; then
    tok="$(docker exec "$c" cat /var/lib/rancher/k3s/server/node-token 2>/dev/null | tr -d '[:space:]')"
    [ -n "$tok" ] && { printf '%s\n' "$tok"; return 0; }
  fi
  return 1
}

mesh_ipv4() {
  local c ip
  for c in tailscale /usr/bin/tailscale /usr/local/bin/tailscale /opt/homebrew/bin/tailscale; do
    if [ -x "$c" ] || command -v "$c" >/dev/null 2>&1; then
      ip="$("$c" ip -4 2>/dev/null | head -1 | tr -d '[:space:]')"
      case "${ip:-}" in 100.*) printf '%s\n' "$ip"; return 0;; esac
    fi
  done
  return 1
}

k3d_api_is_public() {
  local name line
  for name in "k3d-${PCTL_CLUSTER}-serverlb" "k3d-${PCTL_CLUSTER}-server-0"; do
    line="$(docker port "$name" 6443 2>/dev/null | head -1 || true)"
    case "$line" in
      127.0.0.1:*|\[::1\]:*) continue;;
      0.0.0.0:*|\[::\]:*|[0-9]*.*.*.*:*) return 0;;
    esac
  done
  return 1
}

k3d_api_host_port() {
  local name port
  for name in "k3d-${PCTL_CLUSTER}-serverlb" "k3d-${PCTL_CLUSTER}-server-0"; do
    port="$(docker port "$name" 6443 2>/dev/null | head -1 | sed -E 's/.*://')"
    [ -n "$port" ] && { printf '%s\n' "$port"; return 0; }
  done
  return 1
}

ensure_k3d_tls_san() {
  local mesh="${1:-}" c="k3d-${PCTL_CLUSTER}-server-0"
  [ -n "$mesh" ] || return 0
  have docker || return 0
  docker inspect "$c" >/dev/null 2>&1 || return 0
  if docker exec "$c" sh -c "grep -qE '^[[:space:]]*-[[:space:]]*${mesh}[[:space:]]*\$' /etc/rancher/k3s/config.yaml 2>/dev/null"; then
    return 0
  fi
  say "Adding tls-san ${mesh} to k3d server…"
  docker exec "$c" sh -c "
    mkdir -p /etc/rancher/k3s
    if [ ! -f /etc/rancher/k3s/config.yaml ]; then
      printf 'tls-san:\\n  - %s\\n' '$mesh' > /etc/rancher/k3s/config.yaml
    elif grep -q '^tls-san:' /etc/rancher/k3s/config.yaml; then
      grep -qE '^[[:space:]]*-[[:space:]]*${mesh}[[:space:]]*\$' /etc/rancher/k3s/config.yaml \
        || printf '  - %s\\n' '$mesh' >> /etc/rancher/k3s/config.yaml
    else
      printf '\\ntls-san:\\n  - %s\\n' '$mesh' >> /etc/rancher/k3s/config.yaml
    fi
  " || true
  docker restart "$c" >/dev/null 2>&1 || true
  local i=0
  until docker exec "$c" kubectl get nodes >/dev/null 2>&1; do
    i=$((i + 1)); [ "$i" -lt 45 ] || break; sleep 2
  done
}

# Substitute manifest placeholders and apply.  $1=image
apply_manifests() {
  local image="$1"
  say "Namespace…"
  kube create namespace "$PCTL_NAMESPACE" --dry-run=client -o yaml | kube apply -f -

  # HMAC key for portal sign-in tokens. Generated once and preserved across re-runs so the key the TUI
  # reads to mint tokens stays stable; only created if absent.
  if ! kube -n "$PCTL_NAMESPACE" get secret placecontext-portal >/dev/null 2>&1; then
    local signing_key
    signing_key="$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    kube -n "$PCTL_NAMESPACE" create secret generic placecontext-portal \
      --from-literal=signing-key="$signing_key" --dry-run=client -o yaml | kube apply -f -
  fi

  # Shared RSA key for signing OAuth/MCP access tokens — generated once so every replica (and restart)
  # signs with the same key id. Requires openssl; only created if absent.
  if ! kube -n "$PCTL_NAMESPACE" get secret placecontext-oauth >/dev/null 2>&1; then
    if command -v openssl >/dev/null 2>&1; then
      local pem; pem="$(openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 2>/dev/null)"
      kube -n "$PCTL_NAMESPACE" create secret generic placecontext-oauth \
        --from-literal=key.pem="$pem" --dry-run=client -o yaml | kube apply -f -
    else
      warn "openssl not found — OAuth signing key not created; MCP tokens won't validate across replicas."
    fi
  fi

  # Data Protection passphrase — encrypts the key ring (vault secrets + cookies) at rest in Postgres.
  if ! kube -n "$PCTL_NAMESPACE" get secret placecontext-dp >/dev/null 2>&1; then
    local dp_key
    dp_key="$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    kube -n "$PCTL_NAMESPACE" create secret generic placecontext-dp \
      --from-literal=key="$dp_key" --dry-run=client -o yaml | kube apply -f -
  fi

  # Postgres superuser password + app connection string (never committed as plaintext).
  if ! kube -n "$PCTL_NAMESPACE" get secret placecontext-db >/dev/null 2>&1; then
    local pg_pass
    pg_pass="$(openssl rand -hex 24 2>/dev/null || head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    local conn
    conn="Host=placecontext-db;Port=5432;Database=placecontext;Username=postgres;Password=${pg_pass}"
    kube -n "$PCTL_NAMESPACE" create secret generic placecontext-db \
      --from-literal=password="$pg_pass" \
      --from-literal=connection-string="$conn" \
      --dry-run=client -o yaml | kube apply -f -
  fi

  # MinIO root credentials (generated once).
  if ! kube -n "$PCTL_NAMESPACE" get secret placecontext-minio >/dev/null 2>&1; then
    local minio_user minio_secret
    minio_user="pc$(openssl rand -hex 4 2>/dev/null || echo user)"
    minio_secret="$(openssl rand -hex 24 2>/dev/null || head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    kube -n "$PCTL_NAMESPACE" create secret generic placecontext-minio \
      --from-literal=ACCESS_KEY_ID="$minio_user" \
      --from-literal=ACCESS_SECRET_KEY="$minio_secret" \
      --dry-run=client -o yaml | kube apply -f -
  fi

  # Cluster page join codes: seed k3s node-token (+ Tailscale API URL only — never LAN IP).
  # Token from native k3s or k3d server container (Mac/docker master).
  local jtok jip jurl="" jport=6443
  jtok="$(resolve_node_token 2>/dev/null || true)"
  if [ -n "$jtok" ]; then
    jip="$(mesh_ipv4 2>/dev/null || true)"
    if have k3d && k3d cluster list 2>/dev/null | grep -q "$PCTL_CLUSTER"; then
      jport="$(k3d_api_host_port 2>/dev/null || echo 6443)"
    fi
    case "${jip:-}" in 100.*) jurl="https://${jip}:${jport}";; esac
    say "Seeding placecontext-cluster-join secret…${jurl:+ server-url=$jurl}"
    kube -n "$PCTL_NAMESPACE" create secret generic placecontext-cluster-join \
      --from-literal=node-token="$jtok" \
      ${jurl:+--from-literal=server-url="$jurl"} \
      --dry-run=client -o yaml | kube apply -f -
  fi

  say "PostgreSQL (pgvector)…"
  kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/postgres.yaml"

  say "MinIO (reports/artifacts + DB dumps)…"
  kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/minio.yaml"

  say "Nightly DB dump (retention-pruned)…"
  kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/pg-backup.yaml"

  say "PlaceContext Host (image: $image)…"
  sed -e "s|__IMAGE__|${image}|g" -e "s|__NAMESPACE__|${PCTL_NAMESPACE}|g" \
    "$K3S_DIR/placecontext.yaml" | kube -n "$PCTL_NAMESPACE" apply -f -

  apply_platform_keys
}

# ── platform keys overlay (feature keys survive every redeploy) ─────────────────────────────────
# `pctl setup` (or an operator, by hand) writes KEY=VALUE lines of PlaceContext__… env into this
# file; applying the manifests would otherwise reset the deployment env and silently disable the
# ingest/SMS gateways, so every apply re-applies the overlay on top.
PLATFORM_KEYS_FILE_ROOT="/etc/placecontext/platform-keys.env"
PLATFORM_KEYS_FILE_USER="${XDG_CONFIG_HOME:-$HOME/.config}/placecontext/platform-keys.env"

platform_keys_file() {
  if [ "$(id -u)" = 0 ]; then printf '%s' "$PLATFORM_KEYS_FILE_ROOT"
  elif [ -r "$PLATFORM_KEYS_FILE_ROOT" ]; then printf '%s' "$PLATFORM_KEYS_FILE_ROOT"
  else printf '%s' "$PLATFORM_KEYS_FILE_USER"; fi
}

apply_platform_keys() {
  local f; f="$(platform_keys_file)"
  [ -r "$f" ] || return 0
  local -a pairs=()
  while IFS= read -r line; do
    case "$line" in ''|\#*) continue;; esac
    pairs+=("$line")
  done < "$f"
  [ ${#pairs[@]} -gt 0 ] || return 0
  say "Applying platform keys overlay (${#pairs[@]} key(s) from $f)…"
  kube -n "$PCTL_NAMESPACE" set env deploy/placecontext "${pairs[@]}" >/dev/null
}

save_platform_key() {
  local f; f="$(platform_keys_file)"
  mkdir -p "$(dirname "$f")"
  umask 077
  touch "$f"
  # replace-or-append so re-running setup rotates cleanly
  grep -v "^${1}=" "$f" > "${f}.tmp" 2>/dev/null || true
  printf '%s=%s\n' "$1" "$2" >> "${f}.tmp"
  mv "${f}.tmp" "$f"
}

wait_rollout() {
  say "Waiting for rollout…"
  kube -n "$PCTL_NAMESPACE" rollout status deploy/placecontext-db --timeout=180s || true
  kube -n "$PCTL_NAMESPACE" rollout status deploy/placecontext --timeout=300s
}

# ── doctor ─────────────────────────────────────────────────────────────────────────────────────
# Runtime registry — mirrors WorkloadRunnerOptions.Runtimes defaults (src/.../Workload/WorkloadRunnerOptions.cs).
# Each entry: "<runtimeId>|<image>|<trivial in-container command that must exit 0>".
# Keep in sync with the C# defaults; the smoke test runs each as a sandboxed Job, exactly how real
# jobs run — so it catches sandbox regressions (memory units, image pull, egress) before go-live.
# Use single quotes in the commands: they sit inside the JSON-style "command" array (double-quoted),
# so single quotes keep the YAML valid while still quoting the runtime's inline program.
PCTL_RUNTIMES=(
  "node|node:22-slim|node -e 'process.exit(0)'"
  "python|python:3.12-slim|python -c 'import sys; sys.exit(0)'"
)

# Smoke-test one runtime: run a trivial workload as a sandboxed Job (256Mi/1cpu, no egress) and assert
# it reaches Complete. Returns 0 on pass. Cleans up the Job either way.
smoke_runtime() {
  local rid="$1" image="$2" cmd="$3" job="pcdoctor-$rid"
  kube -n "$PCTL_NAMESPACE" delete job "$job" >/dev/null 2>&1 || true
  if ! cat <<EOF | kube -n "$PCTL_NAMESPACE" apply -f - >/dev/null 2>&1
apiVersion: batch/v1
kind: Job
metadata:
  name: $job
  labels: { placecontext-doctor: "true" }
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 30
  activeDeadlineSeconds: 150
  template:
    metadata:
      labels: { placecontext-doctor: "true" }
    spec:
      restartPolicy: Never
      containers:
        - name: run
          image: $image
          command: ["sh","-c","$cmd"]
          resources:
            limits: { memory: "256Mi", cpu: "1" }
EOF
  then
    warn "runtime '$rid' ($image) — could not create smoke-test job"; return 1
  fi
  local i
  for i in $(seq 1 120); do
    if kube -n "$PCTL_NAMESPACE" wait --for=condition=complete "job/$job" --timeout=1s >/dev/null 2>&1; then
      ok "runtime '$rid' ($image) — smoke test passed"
      kube -n "$PCTL_NAMESPACE" delete job "$job" >/dev/null 2>&1 || true; return 0
    fi
    if kube -n "$PCTL_NAMESPACE" wait --for=condition=failed "job/$job" --timeout=1s >/dev/null 2>&1; then
      warn "runtime '$rid' ($image) — smoke test FAILED:"
      kube -n "$PCTL_NAMESPACE" get pods -l "job-name=$job" \
        -o jsonpath='{range .items[*]}    run: {.status.containerStatuses[0].state}{"\n"}{end}' 2>/dev/null >&2 || true
      kube -n "$PCTL_NAMESPACE" delete job "$job" >/dev/null 2>&1 || true; return 1
    fi
    sleep 1
  done
  warn "runtime '$rid' ($image) — TIMED OUT (slow image pull on a fresh node, or sandbox blocked)"
  kube -n "$PCTL_NAMESPACE" delete job "$job" >/dev/null 2>&1 || true; return 1
}

# Latest EF migration id in the source tree (excludes *.Designer.cs / snapshot). Same logic as the TUI build.
latest_source_migration() {
  ls src/PlaceContext.Infrastructure/Migrations/[0-9]*_*.cs 2>/dev/null \
    | grep -vi '\.designer\.cs$' | sed 's#.*/##; s#\.cs$##' | sort | tail -1
}

# Go-live / initialisation checklist. Verifies the cluster is actually ready to serve: secrets present,
# DB migrated to the code's level, host replicas ready, and every runtime executes in the sandbox.
golive_checklist() {
  echo; say "Go-live checklist (ns: $PCTL_NAMESPACE):"
  resolve_ctx
  local fail=0

  if ! kube get nodes >/dev/null 2>&1; then
    warn "no cluster reachable — bring one up (pctl dev up / pctl server up) before go-live."
    return 1
  fi
  ok "cluster reachable ($(kube get nodes --no-headers 2>/dev/null | grep -c Ready) node(s) Ready)"

  kube get ns "$PCTL_NAMESPACE" >/dev/null 2>&1 && ok "namespace '$PCTL_NAMESPACE' exists" \
    || { warn "namespace '$PCTL_NAMESPACE' missing — run pctl deploy"; fail=1; }

  # Secrets — portal/MCP signing, DB password, MinIO, Data Protection passphrase.
  for s in placecontext-portal placecontext-oauth placecontext-db placecontext-minio placecontext-dp; do
    kube -n "$PCTL_NAMESPACE" get secret "$s" >/dev/null 2>&1 && ok "secret '$s' present" \
      || { warn "secret '$s' MISSING — run pctl deploy (auto-generates it)"; fail=1; }
  done

  # Database ready + schema migrated to the code's level.
  if kube -n "$PCTL_NAMESPACE" exec deploy/placecontext-db -- psql -U postgres -d placecontext -At -c 'SELECT 1' >/dev/null 2>&1; then
    ok "database reachable"
    local want have_mig
    want="$(latest_source_migration)"
    have_mig="$(kube -n "$PCTL_NAMESPACE" exec deploy/placecontext-db -- psql -U postgres -d placecontext -At -c 'SELECT coalesce(max("MigrationId"),$$$$) FROM "__EFMigrationsHistory"' 2>/dev/null | tr -d '\r')"
    if [ -n "$want" ] && [ -n "$have_mig" ] && [ "$have_mig" \< "$want" ]; then
      warn "DB schema behind code (applied ${have_mig#*_}, expected ${want#*_}) — redeploy to migrate"; fail=1
    else
      ok "DB schema up to date (${have_mig#*_})"
    fi
  else
    warn "database not reachable — run pctl deploy"; fail=1
  fi

  # Host replicas ready.
  local ready desired
  ready="$(kube -n "$PCTL_NAMESPACE" get deploy placecontext -o jsonpath='{.status.readyReplicas}' 2>/dev/null)"
  desired="$(kube -n "$PCTL_NAMESPACE" get deploy placecontext -o jsonpath='{.spec.replicas}' 2>/dev/null)"
  if [ -n "$ready" ] && [ "$ready" = "${desired:-0}" ]; then
    ok "host replicas ready ($ready/$desired)"
  else
    warn "host replicas not ready (${ready:-0}/${desired:-?}) — check pctl status"; fail=1
  fi

  # Every runtime must execute in the sandbox (the 'all runtimes need to be checked' requirement).
  say "Runtime smoke tests:"
  local entry rid image cmd
  for entry in "${PCTL_RUNTIMES[@]}"; do
    IFS='|' read -r rid image cmd <<<"$entry"
    smoke_runtime "$rid" "$image" "$cmd" || fail=1
  done

  echo
  [ "$fail" = 0 ] && ok "Go-live checklist passed — ready to serve." \
    || { warn "Go-live checklist has issues (above) — resolve before going live."; return 1; }
}

cmd_doctor() {
  local golive=0
  while [ $# -gt 0 ]; do case "$1" in --go-live|--golive) golive=1; shift;; *) shift;; esac; done

  say "Checking dependencies…"
  local miss=0
  for t in docker k3d kubectl; do
    if have "$t"; then ok "$t — $(command -v "$t")"; else warn "$t — MISSING"; miss=1; fi
  done
  have k3s && ok "k3s — $(command -v k3s) (prod server/agent)" || printf '%s  k3s — not installed (only needed for prod nodes)%s\n' "$C_DIM" "$C_RESET"
  printf '%s  ~/.local/bin on PATH? %s%s\n' "$C_DIM" "$(case ":$PATH:" in *":$HOME/.local/bin:"*) echo yes;; *) echo no — add it;; esac)" "$C_RESET"
  [ "$miss" = 0 ] && ok "Core dev deps present." || die "Install the missing tools above (see README)."

  # The go-live checklist creates throwaway Jobs, so only run it on request or when a cluster is up.
  if [ "$golive" = 1 ] || { have kubectl && resolve_ctx && kube get nodes >/dev/null 2>&1; }; then
    golive_checklist || true
  else
    printf '%s  (run `pctl doctor --go-live` against a running cluster for the full readiness checklist)%s\n' "$C_DIM" "$C_RESET"
  fi
}

# ── dev: local k3d cluster ─────────────────────────────────────────────────────────────────────
cmd_dev_clean() {
  have docker || { warn "docker not found — nothing to clean."; return 0; }
  say "Removing dev Docker Postgres containers + volumes…"
  for c in $PCTL_DB_CONTAINERS; do
    local vols; vols="$(docker inspect -f '{{range .Mounts}}{{if eq .Type "volume"}}{{.Name}} {{end}}{{end}}' "$c" 2>/dev/null || true)"
    docker rm -f "$c" >/dev/null 2>&1 && ok "removed container $c" || true
    for v in $vols; do docker volume rm "$v" >/dev/null 2>&1 && ok "removed volume $v" || true; done
  done
}

dev_cluster_exists() { k3d cluster list -o json 2>/dev/null | grep -q "\"name\":\"$PCTL_CLUSTER\""; }

# Start a stopped dev cluster, repairing the damage a docker prune / daemon reset leaves behind
# (missing cluster network, vanished tools helper). Dies with k3d's real error — never silently —
# if the cluster still won't start, and refuses early when it is damaged beyond starting.
dev_cluster_start() {
  # A dev cluster is always created with a loadbalancer (-p …@loadbalancer). If that container is
  # gone, its host port mappings are unrecoverable — only a recreate brings the portal back.
  if ! docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "k3d-$PCTL_CLUSTER-serverlb"; then
    die "dev cluster '$PCTL_CLUSTER' is damaged (loadbalancer container is gone — likely a docker prune). Recreate it: pctl dev down && pctl dev up"
  fi

  local out
  if out="$(k3d cluster start "$PCTL_CLUSTER" 2>&1)"; then return 0; fi

  if grep -q "network k3d-$PCTL_CLUSTER not found" <<<"$out"; then
    warn "Cluster network is missing (docker prune?) — recreating it and retrying…"
    docker network create "k3d-$PCTL_CLUSTER" >/dev/null 2>&1 || true
    docker rm -f "k3d-$PCTL_CLUSTER-tools" >/dev/null 2>&1 || true
    if out="$(k3d cluster start "$PCTL_CLUSTER" 2>&1)"; then return 0; fi
    # The ephemeral tools helper often can't restart after this repair; if the actual cluster
    # nodes made it up, that is good enough.
    if grep -qi "helper" <<<"$out" \
       && docker ps --format '{{.Names}}' | grep -qx "k3d-$PCTL_CLUSTER-server-0"; then
      warn "k3d tools helper failed to start, but the cluster nodes are up — continuing."
      return 0
    fi
  fi

  printf '%s\n' "$out" >&2
  die "could not start dev cluster '$PCTL_CLUSTER'. If it stays broken, recreate it: pctl dev down && pctl dev up"
}

# Block until the cluster API answers, or die — continuing silently just moves the failure into a
# confusing kubectl error later.
dev_wait_api() {
  say "Waiting for the cluster API…"
  local i
  for i in $(seq 1 60); do kube get nodes >/dev/null 2>&1 && return 0; sleep 2; done
  die "cluster API did not come up within 120s — check: docker ps | grep k3d, k3d cluster list"
}

cmd_dev_up() {
  local rebuild=0
  for a in "$@"; do [ "$a" = "--rebuild" ] && rebuild=1; done
  have k3d   || die "k3d not installed — run: pctl doctor"
  have docker|| die "docker is required for the k3d dev cluster."

  [ "$rebuild" = 1 ] && cmd_build
  cmd_dev_clean

  if dev_cluster_exists; then
    ok "k3d cluster '$PCTL_CLUSTER' already exists."
    if ! k3d_api_is_public; then
      warn "k3d API is localhost-only — Mac→Linux join codes need a recreate:
  k3d cluster delete ${PCTL_CLUSTER} && pctl dev up"
    fi
  else
    say "Creating k3d cluster '$PCTL_CLUSTER' ($PCTL_SERVERS server + $PCTL_AGENTS agents, API :6443)…"
    # Publish API on 0.0.0.0:6443 so remote Linux workers can join a Mac/docker master over Tailscale.
    local -a k3d_extra=(--api-port "0.0.0.0:6443")
    local mesh=""
    mesh="$(mesh_ipv4 2>/dev/null || true)"
    [ -n "$mesh" ] && k3d_extra+=(--k3s-arg "--tls-san=${mesh}@server:*")
    k3d cluster create "$PCTL_CLUSTER" \
      --servers "$PCTL_SERVERS" --agents "$PCTL_AGENTS" \
      -p "${PCTL_PORT}:80@loadbalancer" \
      "${k3d_extra[@]}" \
      --wait
  fi

  use_dev_kubeconfig
  mesh="$(mesh_ipv4 2>/dev/null || true)"
  [ -n "${mesh:-}" ] && ensure_k3d_tls_san "$mesh"
  cmd_image_import
  apply_manifests "$PCTL_IMAGE"
  wait_rollout
  ok "Dev cluster ready."
  cmd_url
}

cmd_dev_add_node() {
  local role="agent" name=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --role) role="$2"; shift 2;;
      --name) name="$2"; shift 2;;
      *) die "dev add-node: unknown arg $1";;
    esac
  done
  case "$role" in agent|server) ;; *) die "dev add-node: --role must be 'agent' or 'server'";; esac
  have k3d || die "k3d not installed — run: pctl doctor"
  dev_cluster_exists || die "no dev cluster '$PCTL_CLUSTER' — run: pctl dev up"
  # auto-name: pc-<role>-<n> using the current node count
  if [ -z "$name" ]; then
    local n; n="$(k3d node list -o json 2>/dev/null | grep -c "\"role\":\"$role\"" || echo 0)"
    name="pc-${role}-${n}"
  fi
  say "Adding $role node '$name' to cluster '$PCTL_CLUSTER'…"
  k3d node create "$name" --cluster "$PCTL_CLUSTER" --role "$role" --wait
  fix_host_dns
  # The new node needs the local image before anything schedules onto it (no registry fallback).
  [ -s "$PCTL_IMAGE_TAR" ] && cmd_image_import
  ok "Node '$name' joined."
}

# k3s regenerates the CoreDNS NodeHosts configmap whenever nodes change, dropping the
# host.k3d.internal entry k3d injected at cluster create — and with it any pod's ability to
# reach services on this machine (e.g. a job's Postgres on the host). Re-inject it.
fix_host_dns() {
  use_dev_kubeconfig
  local gw hosts
  gw="$(docker network inspect "k3d-$PCTL_CLUSTER" --format '{{(index .IPAM.Config 0).Gateway}}' 2>/dev/null)" || return 0
  [ -n "$gw" ] || return 0
  hosts="$(kube -n kube-system get cm coredns -o jsonpath='{.data.NodeHosts}' 2>/dev/null)" || return 0
  if ! printf '%s' "$hosts" | grep -q "host.k3d.internal"; then
    say "Re-adding host.k3d.internal ($gw) to CoreDNS NodeHosts…"
    kube -n kube-system patch cm coredns --type merge \
      -p "{\"data\":{\"NodeHosts\":\"$(printf '%s\\n%s host.k3d.internal' "$hosts" "$gw" | sed ':a;N;$!ba;s/\n/\\n/g')\"}}" >/dev/null
    kube -n kube-system rollout restart deploy/coredns >/dev/null 2>&1 || true
  fi
}

cmd_dev_down() {
  have k3d || die "k3d not installed."
  if dev_cluster_exists; then
    say "Deleting k3d cluster '$PCTL_CLUSTER'…"
    k3d cluster delete "$PCTL_CLUSTER"
    ok "Deleted."
  else
    warn "No k3d cluster named '$PCTL_CLUSTER'."
  fi
}

cmd_image_import() {
  # k3d (dev) when the dev cluster exists; plain k3s (prod node) otherwise. Either way the goal
  # is the same: the bundled tarball is THE image source — installs must never depend on a
  # registry pull of the :local tag.
  if have k3d && dev_cluster_exists; then
    # -s: a truncated/empty tar (crashed build, disk event) must not be treated as an image.
    if [ -s "$PCTL_IMAGE_TAR" ]; then
      say "Importing image from $PCTL_IMAGE_TAR into '$PCTL_CLUSTER'…"
      k3d image import "$PCTL_IMAGE_TAR" -c "$PCTL_CLUSTER"
    else
      say "Importing image $PCTL_IMAGE into '$PCTL_CLUSTER'…"
      k3d image import "$PCTL_IMAGE" -c "$PCTL_CLUSTER"
    fi
    ok "Image available in cluster."
  elif have k3s; then
    image_import_k3s
  else
    die "no k3d dev cluster and no k3s — nothing to import into."
  fi
}

# Load the bundled image into this k3s node's containerd (server or agent). Run on every node:
# pods schedule anywhere, and with the :local tag there is no registry to fall back to.
image_import_k3s() {
  [ -s "$PCTL_IMAGE_TAR" ] || { warn "no image tarball at $PCTL_IMAGE_TAR — skipping k3s import."; return 0; }
  [ "$(id -u)" = 0 ] || die "importing into k3s containerd needs root — rerun with sudo."
  say "Importing image from $PCTL_IMAGE_TAR into this node's containerd…"
  # -n k8s.io: kubelet only sees the k8s.io containerd namespace — an import into ctr's default
  # namespace looks successful but pods still can't find the image (→ pull backoff).
  k3s ctr -n k8s.io images import "$PCTL_IMAGE_TAR"
  ok "Image available on this node."
}

# ── autostart (boot persistence) ───────────────────────────────────────────────────────────────
# Dev (k3d/Docker): a systemd *user* service runs `k3d cluster start` at boot.
# Prod (k3s): k3s already installs its own systemd service, so this is a no-op note.
cmd_autostart() {
  local disable=0
  [ "${1:-}" = "--disable" ] && disable=1

  # Only treat this as prod when there's no local k3d dev cluster — a box can have BOTH k3s installed and
  # the k3d dev cluster (which is where PlaceContext actually runs), so prefer the k3d unit when present.
  if ! dev_cluster_exists && have k3s && systemctl is-enabled k3s >/dev/null 2>&1; then
    ok "Prod k3s already auto-starts via its systemd service (nothing to do)."
    return 0
  fi
  have k3d || die "autostart supports the k3d dev cluster (k3d not found)."
  local k3dbin unit; k3dbin="$(command -v k3d)"
  unit="$HOME/.config/systemd/user/placecontext.service"

  if [ "$disable" = 1 ]; then
    systemctl --user disable --now placecontext.service >/dev/null 2>&1 || true
    rm -f "$unit"; systemctl --user daemon-reload >/dev/null 2>&1 || true
    ok "Autostart disabled."; return 0
  fi

  command -v systemctl >/dev/null 2>&1 || die "systemd not available — cannot configure autostart."
  local self localbin
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  localbin="$HOME/.local/bin"
  mkdir -p "$(dirname "$unit")"
  # ExecStart runs `pctl ensure` (not bare `k3d cluster start`) so boot brings up the cluster AND applies
  # the manifests + waits for the Host rollout — i.e. PlaceContext is actually serving, not just the API.
  cat > "$unit" <<EOF
[Unit]
Description=PlaceContext dev cluster (k3d) + Host
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=${localbin}:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash ${self} ensure
ExecStop=${k3dbin} cluster stop ${PCTL_CLUSTER}
TimeoutStartSec=600

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload >/dev/null 2>&1 || die "systemd --user unavailable."
  systemctl --user enable placecontext.service >/dev/null 2>&1 || true
  if ! loginctl enable-linger "$USER" >/dev/null 2>&1; then
    warn "Could not enable linger — cluster will start on login, not at boot. Run: sudo loginctl enable-linger $USER"
  fi
  ok "Autostart enabled (systemd user service 'placecontext')."
}

# ── ensure (idempotent bring-up) ─────────────────────────────────────────────────────────────────
# Make the whole dev stack running: create the cluster if missing (full dev up), else start it and
# (re)apply the manifests, then wait for the Host rollout. Safe to run repeatedly; used at boot by the
# autostart unit and handy by hand ("is everything up?").
cmd_ensure() {
  have k3d   || die "ensure supports the k3d dev cluster (k3d not found)."
  have docker|| die "docker is required for the k3d dev cluster."

  if ! dev_cluster_exists; then
    say "No dev cluster yet — creating it…"
    cmd_dev_up
    return 0
  fi

  say "Ensuring cluster '$PCTL_CLUSTER' is started…"
  dev_cluster_start
  use_dev_kubeconfig
  dev_wait_api
  # Re-import before applying: a rollout onto a node that missed the image (added later, wiped
  # containerd, …) must find it locally, never reach for a registry.
  [ -s "$PCTL_IMAGE_TAR" ] && cmd_image_import
  apply_manifests "$PCTL_IMAGE"
  wait_rollout
  ok "PlaceContext is up."
  cmd_url
}

# ── db (replicated Postgres via CloudNativePG) ────────────────────────────────────────────────────
PCTL_CNPG_MANIFEST="${PCTL_CNPG_MANIFEST:-https://raw.githubusercontent.com/cloudnative-pg/cloudnative-pg/release-1.24/releases/cnpg-1.24.1.yaml}"

cmd_db() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    ha)           cmd_db_ha "$@";;
    ha-join)      cmd_db_ha_join "$@";;
    backup-now)   cmd_db_backup "$@";;
    backups)      cmd_db_backups "$@";;
    restore)      cmd_db_restore "$@";;
    minio)        cmd_db_minio "$@";;
    *) die "unknown 'db' subcommand: '$sub' (try: ha | ha-join | backup-now | backups | restore [--dump KEY] | minio)";;
  esac
}

# Join THIS local node to the cross-site HA cluster as a hot-standby (etcd member #2 + Patroni replica
# streaming async from the DO primary over the mesh). The DO primary + witness are provisioned by
# deploy/terraform-app/; this is the local side. Pass the passwords from its outputs, e.g.:
#   REPLICATION_PASSWORD=$(terraform -chdir=deploy/terraform-app output -raw replication_password) \
#   SUPERUSER_PASSWORD=$(terraform -chdir=deploy/terraform-app output -raw superuser_password) \
#   sudo -E ./deploy/pctl db-ha-join
# See deploy/ha/README.md for the full runbook.
cmd_db_ha_join() {
  local script="deploy/ha/join-local-replica.sh"
  [ -f "$script" ] || die "missing $script (run from the repo root)."
  say "Bringing this node up as a local Patroni hot-standby (see deploy/ha/README.md)…"
  bash "$script" "$@"
  ok "Local standby launched. Verify with patronictl list (printed above)."
}

# Run the nightly dump CronJob right now (a gzipped pg_dumpall of every database → MinIO).
cmd_db_backup() {
  resolve_ctx
  local name="pg-dump-manual-$(date +%s 2>/dev/null || echo now)"
  say "Triggering an on-demand DB dump…"
  kube -n "$PCTL_NAMESPACE" create job --from=cronjob/placecontext-pg-dump "$name"
  ok "Job '$name' running — logs: kubectl -n $PCTL_NAMESPACE logs -f job/$name --all-containers"
}

# List the dumps currently held in MinIO (newest last; names are timestamped so they sort).
cmd_db_backups() {
  resolve_ctx
  kube -n "$PCTL_NAMESPACE" exec deploy/minio -- sh -c \
    'mc alias set s http://localhost:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null 2>&1; mc ls s/placecontext-backups/' \
    || die "could not list dumps (is MinIO up? has a dump run yet?)"
}

# Restore the databases from a dump (latest by default). DESTRUCTIVE: drops + recreates the DBs,
# so the app is scaled down for the duration and scaled back afterwards.
cmd_db_restore() {
  local dump="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dump) dump="$2"; shift 2;;
      --yes)  yes=1; shift;;
      *) die "db restore: unknown arg $1 (usage: db restore [--dump KEY] [--yes])";;
    esac
  done
  resolve_ctx

  if [ -z "$dump" ]; then
    dump="$(kube -n "$PCTL_NAMESPACE" exec deploy/minio -- sh -c \
      'mc alias set s http://localhost:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null 2>&1; mc ls s/placecontext-backups/' \
      2>/dev/null | awk '{print $NF}' | grep '\.sql\.gz$' | sort | tail -1)"
    [ -n "$dump" ] || die "no dumps found — run: pctl db backup-now"
    say "Latest dump: ${dump}"
  fi

  if [ "$yes" != 1 ]; then
    printf 'This DROPS and recreates the databases from %s. Type yes to continue: ' "$dump"
    local answer; read -r answer
    [ "$answer" = "yes" ] || die "aborted."
  fi

  local replicas
  replicas="$(kube -n "$PCTL_NAMESPACE" get deploy/placecontext -o jsonpath='{.spec.replicas}' 2>/dev/null || echo 1)"
  say "Scaling the app down for the restore…"
  kube -n "$PCTL_NAMESPACE" scale deploy/placecontext --replicas=0
  kube -n "$PCTL_NAMESPACE" rollout status deploy/placecontext --timeout=120s || true

  say "Restoring ${dump}…"
  kube -n "$PCTL_NAMESPACE" exec deploy/minio -- sh -c \
    'mc alias set s http://localhost:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null 2>&1; mc cat "s/placecontext-backups/'"$dump"'"' | \
    kube -n "$PCTL_NAMESPACE" run "pctl-pg-restore-$$" --rm -i --restart=Never \
      --image=pgvector/pgvector:pg16 --env=PGPASSWORD=postgres --command -- sh -c '
        if pg_isready -h placecontext-pg-rw -U postgres >/dev/null 2>&1; then HOST=placecontext-pg-rw; else HOST=placecontext-db; fi
        echo "restoring into ${HOST}…"
        gunzip -c | psql -q -h "$HOST" -U postgres -d postgres' \
    || { kube -n "$PCTL_NAMESPACE" scale deploy/placecontext --replicas="${replicas:-1}"; die "restore failed — app scaled back up."; }

  say "Scaling the app back up…"
  kube -n "$PCTL_NAMESPACE" scale deploy/placecontext --replicas="${replicas:-1}"
  kube -n "$PCTL_NAMESPACE" rollout status deploy/placecontext --timeout=240s
  ok "Databases restored from ${dump}."
}

# Download a MinIO object to a temp file and open it (e.g. a rendered report HTML).
cmd_minio_open() {
  local path="${1:-}"
  [ -n "$path" ] || die "usage: pctl minio open <bucket/key>"
  resolve_ctx
  local base; base="$(basename "$path")"
  local dst="${TMPDIR:-/tmp}/pctl-${base}"
  say "Fetching ${path}…"
  kube -n "$PCTL_NAMESPACE" exec deploy/minio -- sh -c \
    'mc alias set s http://localhost:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null 2>&1; mc cat "s/'"$path"'"' > "$dst" 2>/dev/null
  [ -s "$dst" ] || die "could not fetch '$path' (does it exist?)"
  if command -v xdg-open >/dev/null 2>&1; then xdg-open "$dst" >/dev/null 2>&1 &
  elif command -v open >/dev/null 2>&1; then open "$dst";
  else echo "saved to $dst"; fi
  ok "Opened ${dst}"
}

# Expose the in-cluster MinIO (run reports/artifacts store) on localhost so you can browse it.
cmd_db_minio() {
  resolve_ctx
  local creds; creds="$(kube -n "$PCTL_NAMESPACE" get secret placecontext-minio -o jsonpath='{.data.ACCESS_KEY_ID}' 2>/dev/null | base64 -d 2>/dev/null || true)"
  say "Forwarding MinIO → console http://localhost:9001, API http://localhost:9000  (Ctrl-C to stop)"
  [ -n "$creds" ] && echo "  login: ${creds} / (ACCESS_SECRET_KEY from the placecontext-minio secret)"
  kube -n "$PCTL_NAMESPACE" port-forward svc/minio 9001:9001 9000:9000
}

# Stand up replicated Postgres (1 primary + 2 replicas), and point the app at it.
cmd_db_ha() {
  resolve_ctx
  say "Installing the CloudNativePG operator…"
  kube apply --server-side -f "$PCTL_CNPG_MANIFEST" >/dev/null
  kube -n cnpg-system rollout status deploy/cnpg-controller-manager --timeout=180s

  say "Object store (MinIO) for run reports/artifacts…"
  kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/minio.yaml"
  kube -n "$PCTL_NAMESPACE" rollout status deploy/minio --timeout=180s

  say "Superuser secret (keeps the app's postgres/postgres credentials)…"
  kube -n "$PCTL_NAMESPACE" create secret generic placecontext-pg-superuser \
    --type=kubernetes.io/basic-auth --from-literal=username=postgres --from-literal=password=postgres \
    --dry-run=client -o yaml | kube apply -f -

  say "Replicated cluster…"
  kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/postgres-ha.yaml"

  say "Nightly DB dump (retention-pruned)…"
  kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/pg-backup.yaml"
  say "Waiting for the cluster to become healthy (3 instances)…"
  local i ready
  for i in $(seq 1 60); do
    ready="$(kube -n "$PCTL_NAMESPACE" get cluster placecontext-pg -o jsonpath='{.status.readyInstances}' 2>/dev/null || true)"
    [ "$ready" = "3" ] && break
    sleep 5
  done
  [ "$ready" = "3" ] || die "cluster did not reach 3 ready instances (got '${ready:-0}')."

  say "Pointing the app at the primary (placecontext-pg-rw)…"
  kube -n "$PCTL_NAMESPACE" set env deploy/placecontext \
    "PlaceContext__ConnectionString=Host=placecontext-pg-rw;Port=5432;Database=placecontext;Username=postgres;Password=postgres"
  kube -n "$PCTL_NAMESPACE" rollout status deploy/placecontext --timeout=240s
  ok "Replicated Postgres active. Reads can also use placecontext-pg-ro."
}

# ── mesh (self-hosted WireGuard control plane via Headscale) ──────────────────────────────────────
# Run these on the DigitalOcean droplet that hosts the mesh control server.
cmd_mesh() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    up)      cmd_mesh_up "$@";;
    tenant)  cmd_mesh_tenant "$@";;
    authkey) cmd_mesh_authkey "$@";;
    down)    cmd_mesh_down "$@";;
    *) die "unknown 'mesh' subcommand: '$sub' (try: up --domain FQDN | tenant add|rm ID | authkey --tenant ID | down)";;
  esac
}

dc() { if docker compose version >/dev/null 2>&1; then docker compose "$@"; else docker-compose "$@"; fi; }
hs() { ( cd deploy/headscale && dc -f docker-compose.live.yml exec -T headscale headscale "$@" ); }
MESH_DIR="deploy/headscale"
MESH_TENANTS="$MESH_DIR/tenants.list"

cmd_mesh_up() {
  local domain=""
  while [ $# -gt 0 ]; do case "$1" in --domain) domain="$2"; shift 2;; *) die "mesh up: unknown arg $1";; esac; done
  [ -n "$domain" ] || die "mesh up needs --domain <fqdn> (DNS A record → this droplet)"
  have docker || die "docker is required to run Headscale."
  say "Templating Headscale config for ${domain}…"
  sed "s|__DOMAIN__|${domain}|g" "$MESH_DIR/config.yaml" > "$MESH_DIR/config.live.yaml"
  [ -f "$MESH_TENANTS" ] || : > "$MESH_TENANTS"
  mesh_render_acl
  ( cd "$MESH_DIR" && sed 's|config.yaml|config.live.yaml|' docker-compose.yml > docker-compose.live.yml && dc -f docker-compose.live.yml up -d )
  ok "Headscale up at https://${domain}  — add a customer: pctl mesh tenant add <id>"
}

# Regenerate the default-deny, per-tenant ACL from the tenant registry. Each tenant only sees itself.
mesh_render_acl() {
  local owners="" acls="" id first_o=1 first_a=1
  while IFS= read -r id; do
    [ -z "$id" ] && continue
    [ "$first_o" = 1 ] && first_o=0 || owners+=","
    owners+="\"tag:cust-${id}\":[\"cust-${id}\"]"
    [ "$first_a" = 1 ] && first_a=0 || acls+=","
    acls+="{\"action\":\"accept\",\"src\":[\"tag:cust-${id}\"],\"dst\":[\"tag:cust-${id}:*\"]}"
  done < "$MESH_TENANTS"
  cat > "$MESH_DIR/acl.json" <<EOF
{ "tagOwners": { ${owners} }, "acls": [ ${acls} ] }
EOF
}

cmd_mesh_tenant() {
  local action="${1:-}" id="${2:-}"
  [ -n "$id" ] || die "usage: pctl mesh tenant add|rm <tenant-id>"
  [ -f "$MESH_TENANTS" ] || : > "$MESH_TENANTS"
  case "$action" in
    add)
      grep -qxF "$id" "$MESH_TENANTS" || echo "$id" >> "$MESH_TENANTS"
      hs users create "cust-${id}" >/dev/null 2>&1 || true
      mesh_render_acl
      ( cd "$MESH_DIR" && dc -f docker-compose.live.yml restart headscale >/dev/null )
      ok "Tenant '${id}' added (isolated network tag:cust-${id}). Key: pctl mesh authkey --tenant ${id}"
      ;;
    rm)
      grep -vxF "$id" "$MESH_TENANTS" > "$MESH_TENANTS.tmp" 2>/dev/null || true
      mv -f "$MESH_TENANTS.tmp" "$MESH_TENANTS" 2>/dev/null || true
      mesh_render_acl
      ( cd "$MESH_DIR" && dc -f docker-compose.live.yml restart headscale >/dev/null )
      ok "Tenant '${id}' removed from the ACL."
      ;;
    *) die "usage: pctl mesh tenant add|rm <tenant-id>";;
  esac
}

cmd_mesh_authkey() {
  local tenant="" ephemeral=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --tenant)    tenant="$2"; shift 2;;
      --ephemeral) ephemeral=1; shift;;   # for TUI viewers: node auto-deregisters when it disconnects
      *) die "mesh authkey: unknown arg $1";;
    esac
  done
  [ -n "$tenant" ] || die "mesh authkey needs --tenant <id> (each customer gets its own key)"
  have docker || die "docker is required."
  grep -qxF "$tenant" "$MESH_TENANTS" 2>/dev/null || die "unknown tenant '${tenant}' — add it first: pctl mesh tenant add ${tenant}"
  # Tagged pre-auth key for that tenant's isolated network. Cluster nodes use a PERSISTENT key (stay on
  # the mesh so data keeps syncing); TUI viewers use --ephemeral (auto-removed when the TUI closes).
  if [ "$ephemeral" = 1 ]; then
    hs preauthkeys create --user "cust-${tenant}" --tags "tag:cust-${tenant}" --reusable --ephemeral --expiration 1h
  else
    hs preauthkeys create --user "cust-${tenant}" --tags "tag:cust-${tenant}" --reusable --expiration 720h
  fi
}

cmd_mesh_down() {
  ( cd "$MESH_DIR" && dc -f docker-compose.live.yml down 2>/dev/null || dc down 2>/dev/null || true )
  ok "Headscale stopped."
}

# ── kill (destructive — pod | node | job) ─────────────────────────────────────────────────────────
cmd_kill() {
  local kind="${1:-}"; shift || true
  local name="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1; shift;;
      -*) die "kill: unknown flag $1";;
      *) name="$1"; shift;;
    esac
  done
  case "$kind" in pod|node|job) ;; *) die "kill: kind must be 'pod', 'node', or 'job'";; esac
  [ -n "$name" ] || die "kill: need a name — pctl kill $kind <name>"

  if [ "$yes" != 1 ]; then
    printf '%s⚠  Really kill %s "%s"? This is destructive. [y/N] %s' "$C_YELLOW" "$kind" "$name" "$C_RESET"
    read -r ans
    case "$ans" in y|Y|yes|YES) ;; *) echo "aborted."; return 1;; esac
  fi

  case "$kind" in
    pod)
      resolve_ctx
      say "Deleting pod '$name' (its controller will reschedule it)…"
      kube -n "$PCTL_NAMESPACE" delete pod "$name"
      ;;
    node)
      have k3d || die "node kill currently supports k3d dev nodes only."
      say "Removing node '$name' from cluster '$PCTL_CLUSTER'…"
      k3d node delete "$name" || true
      # Also drop the Kubernetes node registration so it doesn't linger as NotReady.
      resolve_ctx
      kube delete node "$name" --ignore-not-found >/dev/null 2>&1 || true
      ;;
    job)
      resolve_ctx
      local esc="${name//\'/\'\'}"   # escape single quotes for SQL
      say "Deleting job '$name' and its run history…"
      kube -n "$PCTL_NAMESPACE" exec deploy/placecontext-db -- psql -U postgres -d placecontext -c \
        "DELETE FROM job_runs WHERE \"JobId\" IN (SELECT \"Id\" FROM jobs WHERE \"Name\"='$esc'); \
         DELETE FROM job_triggers WHERE \"JobId\" IN (SELECT \"Id\" FROM jobs WHERE \"Name\"='$esc'); \
         DELETE FROM jobs WHERE \"Name\"='$esc';"
      ;;
  esac
  ok "Killed $kind '$name'."
}

# ── build ──────────────────────────────────────────────────────────────────────────────────────
cmd_build() {
  local tag="$PCTL_IMAGE" arch=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --tag)  tag="$2"; shift 2;;
      --arch) arch="$2"; shift 2;;
      *) shift;;
    esac
  done
  have docker || die "docker is required to build."

  # --provenance/--sbom off: buildx otherwise attaches attestation manifests, turning the saved
  # tarball into an OCI index that containerd-side imports (k3s ctr) can fail to resolve — the
  # distribution must carry a plain, directly-importable image.
  local -a flags=(-t "$tag")
  if docker build --help 2>/dev/null | grep -q -- --provenance; then
    flags+=(--provenance=false --sbom=false)
  fi
  # Cross-build (e.g. --arch arm64 for an ARM fleet) — needs binfmt/qemu on this machine.
  [ -n "$arch" ] && flags+=(--platform "linux/${arch}")

  say "Building image $tag${arch:+ (linux/$arch)}…"
  docker build "${flags[@]}" .
  say "Exporting to $PCTL_IMAGE_TAR…"
  docker save "$tag" -o "$PCTL_IMAGE_TAR"
  ok "Built and saved."
}

# ── deploy (any current kube context) ────────────────────────────────────────────────────────────
cmd_deploy() {
  local image="$PCTL_IMAGE"
  while [ $# -gt 0 ]; do
    case "$1" in
      --image)          image="$2"; shift 2;;
      --context)        KUBECTL="kubectl --context $2"; shift 2;;
      *) die "deploy: unknown arg $1";;
    esac
  done
  resolve_ctx  # default to the k3d dev cluster's kubeconfig when one exists and none was forced
  apply_manifests "$image"
  # The image tag is constant (:local), so an unchanged Deployment spec would leave the old pods
  # running the old image — force a restart so freshly imported code actually rolls out.
  kube -n "$PCTL_NAMESPACE" rollout restart deploy/placecontext >/dev/null 2>&1 || true
  wait_rollout
  ok "Deployed."
}

# ── package (one tarball that runs anywhere) ─────────────────────────────────────────────────────
# Client release only (NOT internal tools/pctl build tooling):
# placecontext CLI + install/upgrade/connect TUI + k8s manifests + image + install.sh.
cmd_package() {
  local with_image=1 arch="" os=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --no-image) with_image=0; shift;;
      --arch)     arch="$2"; shift 2;;
      --os)       os="$2"; shift 2;;
      *) die "package: unknown arg $1";;
    esac
  done

  local ver host_os host_arch name stage
  ver="${RELEASE_VERSION:-$(git describe --tags --always 2>/dev/null || date +%Y%m%d)}"
  host_os="$(uname -s | tr '[:upper:]' '[:lower:]')"
  host_arch="$(uname -m)"; [ "$host_arch" = x86_64 ] && host_arch=amd64; [ "$host_arch" = aarch64 ] && host_arch=arm64
  os="${os:-$host_os}"
  arch="${arch:-$host_arch}"
  case "$os" in linux|darwin) ;; *) die "package: --os must be linux or darwin";; esac
  name="placecontext-${os}-${arch}"   # release asset name
  ver_stamp="$ver"
  stage="dist/$name"

  say "Packaging $name…"
  # Client release layout (see deploy/install.sh):
  #   placecontext                 Go TUI/CLI binary
  #   placecontext-engine          bash engine (install/upgrade/connect cluster ops)
  #   lib/k3s/*.yaml               manifests
  #   lib/placecontext-local.tar   app image (optional)
  #   VERSION
  rm -rf "$stage"; mkdir -p "$stage/lib/k3s"

  have go || die "the Go toolchain is required to package the client binary (make -C deploy/tui)."
  if [ "$os" = "$host_os" ] && [ "$arch" = "$host_arch" ]; then
    make -s -C deploy/tui build BIN=placecontext || die "client binary build failed."
    install -m755 deploy/tui/placecontext "$stage/placecontext"
  else
    say "Cross-compiling placecontext for ${os}/${arch}…"
    ( cd deploy/tui && CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" \
        go build -trimpath -ldflags "-s -w" -o "placecontext-${os}-${arch}" . ) || die "cross-build failed."
    install -m755 "deploy/tui/placecontext-${os}-${arch}" "$stage/placecontext"
    rm -f "deploy/tui/placecontext-${os}-${arch}"
  fi

  # Engine for TUI-driven install/upgrade/connect — never tools/pctl.
  install -m755 deploy/placecontext "$stage/placecontext-engine"
  install -m755 deploy/placecontext "$stage/lib/placecontext-engine"
  cp deploy/k3s/*.yaml "$stage/lib/k3s/"

  # The application image is ALWAYS linux/<arch>.
  if [ "$with_image" = 1 ]; then
    # The bundled tarball's arch MUST match the target. A prior cross-build (e.g. a linux/arm64
    # target) overwrites deploy/placecontext-local.tar, so a bare "reuse if the file exists" check
    # would silently ship that stale arm64 image inside every same-host-arch package (amd64 server
    # → won't run). Reuse only when the already-built image reports the arch we're packaging;
    # otherwise rebuild for this arch.
    local have_arch=""
    [ -s "$PCTL_IMAGE_TAR" ] && have_arch="$(docker inspect "$PCTL_IMAGE" --format '{{.Architecture}}' 2>/dev/null || true)"
    if [ "$have_arch" = "$arch" ]; then
      say "Reusing $PCTL_IMAGE_TAR (linux/$arch already built)."
    elif [ "$arch" = "$host_arch" ]; then
      cmd_build
    else
      cmd_build --arch "$arch"
    fi
    cp "$PCTL_IMAGE_TAR" "$stage/lib/placecontext-local.tar"
  fi

  printf '%s\n' "$ver" > "$stage/VERSION"

  say "Compressing…"
  tar -C dist -czf "dist/$name.tar.gz" "$name"
  # Also publish-friendly copy under dist/latest naming (same bytes).
  mkdir -p dist/latest dist/"$ver"
  cp -f "dist/$name.tar.gz" "dist/latest/$name.tar.gz"
  cp -f "dist/$name.tar.gz" "dist/$ver/$name.tar.gz"
  printf '%s\n' "$ver" > dist/latest/VERSION
  printf '%s\n' "$ver" > "dist/$ver/VERSION"
  cp -f deploy/install.sh dist/install.sh
  chmod +x dist/install.sh
  rm -rf "$stage"
  ok "Packaged → dist/$name.tar.gz ($(du -h "dist/$name.tar.gz" | cut -f1))"
  cat <<EOF

Publish dist/ to the release host (public-read):

  dist/install.sh
  dist/latest/VERSION
  dist/latest/$name.tar.gz
  dist/$ver/$name.tar.gz

Client install:
  curl -fsSL https://get.placecontext.ai/install.sh | bash
EOF
}

# ── update (pull the latest source from git) ───────────────────────────────────────────────────────
# Fast-forwards the repo at ROOT to its upstream. Pull only by default; --deploy also rebuilds the
# image and rolls it out, bringing the dev cluster up first if it isn't running. Used by the TUI's [u] key.
# The GitHub repo releases are published from — override for forks.
PCTL_REPO="${PCTL_REPO:-bradlnz/placecontext}"

# Update a packaged (non-git) install from the latest GitHub release: compare the stamped VERSION,
# download the matching platform tarball, lay it over ROOT, then optionally roll the new image out.
update_from_release() {
  local do_deploy="$1"
  have curl || die "curl is required to update from releases."
  local current="" latest os arch name url tmp src
  [ -f "$ROOT/VERSION" ] && current="$(tr -d '[:space:]' < "$ROOT/VERSION")"

  say "Checking the latest release of ${PCTL_REPO}…"
  latest="$(curl -fsSL "https://api.github.com/repos/${PCTL_REPO}/releases/latest" 2>/dev/null \
    | sed -n 's/.*"tag_name"[: ]*"\([^"]*\)".*/\1/p')"
  [ -n "$latest" ] || die "could not resolve the latest release of ${PCTL_REPO} (offline? no releases yet?)"
  if [ "$latest" = "$current" ]; then
    ok "Already on the latest release ($current)."
    return 0
  fi

  os="$(uname -s | tr '[:upper:]' '[:lower:]')"
  arch="$(uname -m)"; [ "$arch" = x86_64 ] && arch=amd64; [ "$arch" = aarch64 ] && arch=arm64
  name="placecontext-${latest}-${os}-${arch}.tar.gz"
  url="https://github.com/${PCTL_REPO}/releases/download/${latest}/${name}"
  tmp="$(mktemp -d)"
  say "Downloading ${name}…"
  curl -fL --progress-bar "$url" -o "$tmp/pkg.tar.gz" || { rm -rf "$tmp"; die "download failed: $url"; }
  tar -xzf "$tmp/pkg.tar.gz" -C "$tmp" || { rm -rf "$tmp"; die "could not extract the package."; }
  src="$(find "$tmp" -maxdepth 1 -mindepth 1 -type d | head -1)"
  [ -n "$src" ] || { rm -rf "$tmp"; die "unexpected package layout."; }

  say "Installing ${latest} over ${ROOT}…"
  cp -a "$src"/. "$ROOT"/
  rm -rf "$tmp"
  ok "Updated ${current:-?} → $latest."

  if [ "$do_deploy" = 1 ]; then
    # Re-exec the NEW engine so the roll-out runs the code we just installed.
    exec "$ROOT/deploy/pctl" release-apply
  else
    warn "Run '$ROOT/deploy/pctl release-apply' to roll the new image into the cluster."
  fi
}

# Roll the currently-installed release into whatever cluster this machine runs: the bundled image
# tarball is imported (k3s prod or k3d dev) and the manifests re-applied.
cmd_release_apply() {
  local ver=""; [ -f "$ROOT/VERSION" ] && ver="$(tr -d '[:space:]' < "$ROOT/VERSION")"
  say "Rolling ${ver:-current} into the cluster…"
  # Prefer the k3d dev cluster when one exists — a dev box can have the k3s binary installed
  # too, and the k3s path needs root; only take it when this machine actually serves k3s.
  if have k3d && dev_cluster_exists; then
    dev_cluster_start
    use_dev_kubeconfig
    dev_wait_api
    cmd_image_import
  elif have k3s && [ -d /etc/rancher/k3s ]; then
    KUBECTL="k3s kubectl"
    image_import_k3s
  else
    warn "no cluster on this machine — run ./install.sh (dev) or 'sudo ./deploy/pctl server up' (prod) first."
    return 0
  fi
  cmd_deploy
  # Same-tag images don't change the pod spec, so an apply alone never rolls the pods — force it.
  kube -n "$PCTL_NAMESPACE" rollout restart deploy/placecontext >/dev/null 2>&1 || true
  kube -n "$PCTL_NAMESPACE" rollout status deploy/placecontext --timeout=300s || true
}

cmd_update() {
  local do_deploy=0
  while [ $# -gt 0 ]; do case "$1" in --deploy) do_deploy=1; shift;; *) die "update: unknown arg $1";; esac; done
  # Packaged installs (no git checkout) update from GitHub releases instead of git.
  if [ ! -d .git ]; then
    update_from_release "$do_deploy"
    return
  fi
  have git || die "git is required to update."
  local before after branch
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
  before="$(git rev-parse HEAD 2>/dev/null || echo '')"
  say "Updating $branch from git…"
  git pull --ff-only || die "git pull failed — resolve local changes / diverged history manually."
  after="$(git rev-parse HEAD 2>/dev/null || echo '')"
  if [ "$before" = "$after" ]; then
    ok "Already up to date ($branch @ ${after:0:8})."
    if [ "$do_deploy" = 1 ] && have k3d && have docker; then
      cmd_ensure
    fi
    return 0
  fi
  ok "Updated $branch: ${before:0:8} → ${after:0:8}."
  git --no-pager log --oneline "${before}..${after}" 2>/dev/null | sed 's/^/  /'
  if [ "$do_deploy" = 1 ]; then
    say "Rebuilding + deploying…"
    cmd_build
    if have k3d && have docker; then
      # Dev (k3d): bring the cluster up if needed, then get the fresh image into it.
      if ! dev_cluster_exists; then
        say "No dev cluster yet — creating it…"
        cmd_dev_up
        return 0
      fi
      dev_cluster_start
      use_dev_kubeconfig
      dev_wait_api
      cmd_image_import
    fi
    cmd_deploy
  else
    warn "Run 'pctl deploy' (or 'pctl update --deploy') to roll the new code into the cluster."
  fi
}

# ── prod: k3s server / agent across machines ─────────────────────────────────────────────────────
# Mint a short-lived, ephemeral, pre-authorized, tagged Tailscale auth key from an OAuth client, so
# k3s can join the tailnet without a hand-managed key. Echoes the key.  Needs: id, secret (+ optional tag).
ts_mint_authkey() {
  local id="$1" secret="$2" tag="${3:-tag:k8s}"
  have curl || die "curl is required for Tailscale OAuth."
  local tok
  tok="$(curl -fsSL https://api.tailscale.com/api/v2/oauth/token \
    -d "client_id=${id}" -d "client_secret=${secret}" \
    | sed -n 's/.*"access_token"[: ]*"\([^"]*\)".*/\1/p')"
  [ -n "$tok" ] || die "Tailscale OAuth token request failed (check --ts-oauth-client-id/secret)."
  local body key
  # ephemeral:false — fleet nodes are durable devices; an ephemeral registration would drop off
  # the tailnet after an outage and the single-use key could not re-register it. The KEY expiring
  # (1h) only bounds how long a join code stays usable, not the node's tailnet membership.
  body="{\"capabilities\":{\"devices\":{\"create\":{\"reusable\":false,\"ephemeral\":false,\"preauthorized\":true,\"tags\":[\"${tag}\"]}}},\"expirySeconds\":3600}"
  key="$(curl -fsSL -H "Authorization: Bearer ${tok}" -H 'Content-Type: application/json' \
    -d "$body" https://api.tailscale.com/api/v2/tailnet/-/keys \
    | sed -n 's/.*"key"[: ]*"\([^"]*\)".*/\1/p')"
  [ -n "$key" ] || die "Tailscale auth key minting failed (does the OAuth client have the '${tag}' tag + key write scope?)."
  printf '%s' "$key"
}

# ── Tailscale OAuth client (nodes join the tailnet via OAuth; a fresh key is minted per join) ────
# Saved once with `pctl ts-oauth --client-id X --secret Y`; join-code / server up / agent join /
# join then mint their own short-lived, single-use, preauthorized keys — no key handling at all.
TS_OAUTH_FILE_ROOT="/etc/placecontext/ts-oauth.env"
TS_OAUTH_FILE_USER="${XDG_CONFIG_HOME:-$HOME/.config}/placecontext/ts-oauth.env"

# Populate PCTL_TS_OAUTH_ID/SECRET from the saved client unless the environment already has them.
load_ts_oauth() {
  { [ -n "${PCTL_TS_OAUTH_ID:-}" ] && [ -n "${PCTL_TS_OAUTH_SECRET:-}" ]; } && return 0
  local f
  for f in "$TS_OAUTH_FILE_ROOT" "$TS_OAUTH_FILE_USER"; do
    # shellcheck disable=SC1090
    if [ -r "$f" ]; then . "$f"; return 0; fi
  done
  return 0
}

cmd_ts_oauth() {
  local id="" secret="" status=0 clear=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --client-id) id="$2"; shift 2;;
      --secret)    secret="$2"; shift 2;;
      --status)    status=1; shift;;
      --clear)     clear=1; shift;;
      *) die "ts-oauth: unknown arg $1";;
    esac
  done
  local f="$TS_OAUTH_FILE_USER"; [ "$(id -u)" = 0 ] && f="$TS_OAUTH_FILE_ROOT"
  if [ "$status" = 1 ]; then
    load_ts_oauth
    if [ -n "${PCTL_TS_OAUTH_ID:-}" ]; then ok "Tailscale OAuth client configured (id: ${PCTL_TS_OAUTH_ID%????}****)."
    else warn "No Tailscale OAuth client configured — joins need --ts-authkey or an already-joined tailnet."; fi
    return 0
  fi
  if [ "$clear" = 1 ]; then rm -f "$TS_OAUTH_FILE_ROOT" "$TS_OAUTH_FILE_USER" 2>/dev/null; ok "Tailscale OAuth client cleared."; return 0; fi
  [ -n "$id" ] && [ -n "$secret" ] || die "usage: pctl ts-oauth --client-id ID --secret SECRET  (or --status / --clear)"
  mkdir -p "$(dirname "$f")"
  umask 077
  printf 'PCTL_TS_OAUTH_ID=%q\nPCTL_TS_OAUTH_SECRET=%q\n' "$id" "$secret" > "$f"
  ok "Tailscale OAuth client saved to $f — joins now mint their own keys."
}

# Build the k3s --vpn-auth exec arg into the named array, from either a Tailscale OAuth client
# (managed tailscale.com) or a self-hosted control server (Headscale) + pre-auth key. No-op if neither.
# Args: <array-name> <ts_id> <ts_secret> <ts_tag> <vpn_control> <vpn_authkey>
build_vpn_arg() {
  local __arr="$1" ts_id="$2" ts_secret="$3" ts_tag="$4" ctrl="$5" authkey="$6"
  if [ -n "$ctrl" ] && [ -n "$authkey" ]; then
    say "Joining the self-hosted mesh control server ${ctrl}…"
    eval "${__arr}+=(\"--vpn-auth=name=tailscale,joinKey=${authkey},controlServerURL=${ctrl}\")"
  elif [ -n "$ts_id" ] && [ -n "$ts_secret" ]; then
    say "Minting a Tailscale auth key from the OAuth client…"
    local tskey; tskey="$(ts_mint_authkey "$ts_id" "$ts_secret" "$ts_tag")"
    eval "${__arr}+=(\"--vpn-auth=name=tailscale,joinKey=${tskey}\")"
  fi
}

cmd_server_up() {
  local image="$PCTL_IMAGE" ts_id="" ts_secret="" ts_tag="tag:k8s" vpn_ctrl="" vpn_key=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --image)              image="$2"; shift 2;;
      --ts-oauth-client-id) ts_id="$2"; shift 2;;
      --ts-oauth-secret)    ts_secret="$2"; shift 2;;
      --ts-tag)             ts_tag="$2"; shift 2;;
      --vpn-control)        vpn_ctrl="$2"; shift 2;;
      --vpn-authkey)        vpn_key="$2"; shift 2;;
      *) die "server up: unknown arg $1";;
    esac
  done
  [ "$(id -u)" = 0 ] || die "server up installs a systemd service — run with sudo."

  # OAuth-first: use the saved client when no explicit mesh flags were given.
  if [ -z "$ts_id" ] && [ -z "$vpn_key" ]; then
    load_ts_oauth
    ts_id="${PCTL_TS_OAUTH_ID:-}"; ts_secret="${PCTL_TS_OAUTH_SECRET:-}"
  fi

  local -a exec_args=()
  build_vpn_arg exec_args "$ts_id" "$ts_secret" "$ts_tag" "$vpn_ctrl" "$vpn_key"

  say "Installing k3s (server)…"
  if have k3s; then ok "k3s already installed."; else curl -sfL https://get.k3s.io | sh -s - server "${exec_args[@]}"; fi
  KUBECTL="k3s kubectl"
  say "Waiting for the control plane…"
  until kube get nodes >/dev/null 2>&1; do sleep 2; done

  # The bundled tarball is the image source — never a ghcr pull of the :local tag.
  image_import_k3s

  apply_manifests "$image"
  wait_rollout
  ok "Server node up. PlaceContext deploying to namespace '$PCTL_NAMESPACE'."
  echo
  cmd_join_cmd
}

cmd_agent_join() {
  local url="" token="" ts_id="" ts_secret="" ts_tag="tag:k8s" ts_key="" vpn_ctrl="" vpn_key=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --server-url)         url="$2"; shift 2;;
      --node-token)         token="$2"; shift 2;;
      --ts-oauth-client-id) ts_id="$2"; shift 2;;
      --ts-oauth-secret)    ts_secret="$2"; shift 2;;
      --ts-tag)             ts_tag="$2"; shift 2;;
      --ts-authkey)         ts_key="$2"; shift 2;;
      --vpn-control)        vpn_ctrl="$2"; shift 2;;
      --vpn-authkey)        vpn_key="$2"; shift 2;;
      *) die "agent join: unknown arg $1";;
    esac
  done
  [ -n "$url" ] && [ -n "$token" ] || die "agent join needs --server-url and --node-token"
  [ "$(id -u)" = 0 ] || die "agent join installs a systemd service — run with sudo."

  # OAuth-first: fall back to the saved OAuth client so a machine with `pctl ts-oauth` configured
  # joins the tailnet with a freshly minted key and zero extra flags.
  if [ -z "$ts_id" ] && [ -z "$ts_key" ] && [ -z "$vpn_key" ]; then
    load_ts_oauth
    ts_id="${PCTL_TS_OAUTH_ID:-}"; ts_secret="${PCTL_TS_OAUTH_SECRET:-}"
  fi

  local -a exec_args=()
  # A ready-made Tailscale auth key (join code / --ts-authkey) wins; else OAuth minting / Headscale.
  if [ -n "$ts_key" ]; then
    say "Node will connect over Tailscale (k3s --vpn-auth)…"
    exec_args+=("--vpn-auth=name=tailscale,joinKey=${ts_key}")
  else
    build_vpn_arg exec_args "$ts_id" "$ts_secret" "$ts_tag" "$vpn_ctrl" "$vpn_key"
  fi

  # Fail fast instead of hanging: a tailnet address (100.64.0.0/10) is unreachable unless this
  # machine is already on the tailnet or the join brings Tailscale up itself.
  case "$url" in
    https://100.*)
      if [ ${#exec_args[@]} -eq 0 ] && ! tailscale status >/dev/null 2>&1; then
        die "the server address ($url) is a Tailscale address, but this machine is not on the tailnet.
Pass --ts-authkey (or use a join code generated with one), or bring Tailscale up first."
      fi;;
  esac

  say "Joining this machine to $url as a worker…"
  curl -sfL https://get.k3s.io | K3S_URL="$url" K3S_TOKEN="$token" sh -s - agent "${exec_args[@]}"
  # Pods schedule onto workers too — this node needs the local image just like the server.
  image_import_k3s
  ok "Worker joined."
}

# ── join code (one compact string that lets a new computer join as a worker) ────────────────────
# Nodes connect over Tailscale: the code carries the master's TAILNET address (stable across
# NAT/locations), and — when a Tailscale auth key is provided or mintable — that key too, so a
# fresh machine lands on the tailnet and in the cluster from one string.
#   PC1.<b64url("url token")>            (legacy, still accepted by `join`)
#   PC2.<b64url("url token [tskey]")>    (what this prints)
cmd_join_code() {
  load_ts_oauth
  local ts_key="" ts_id="${PCTL_TS_OAUTH_ID:-}" ts_secret="${PCTL_TS_OAUTH_SECRET:-}" ts_tag="tag:k8s"
  while [ $# -gt 0 ]; do
    case "$1" in
      --ts-authkey) ts_key="$2"; shift 2;;
      --ts-tag)     ts_tag="$2"; shift 2;;
      *) die "join-code: unknown arg $1";;
    esac
  done
  local tok
  if ! tok="$(resolve_node_token)"; then
    die "no k3s node-token — run on the master (k3s server or k3d cluster with placecontext installed)"
  fi
  # Prefer Tailscale mesh IP — never fall back to LAN unless no mesh address exists (and warn).
  local ip="" api_port=6443
  ip="$(mesh_ipv4 2>/dev/null || true)"
  if [ -z "$ip" ]; then
    ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
    [ -n "$ip" ] || ip="$(ipconfig getifaddr en0 2>/dev/null || true)"
    [ -n "$ip" ] || die "could not determine this machine's IP"
    warn "No Tailscale IPv4 — join code will use LAN IP ${ip} (remote sites cannot join)."
  else
    ok "Join code will use Tailscale mesh IP ${ip}"
  fi

  if have k3d && dev_cluster_exists; then
    if ! k3d_api_is_public; then
      die "k3d API is localhost-only — remote Linux workers cannot join this Mac master.
Recreate: k3d cluster delete ${PCTL_CLUSTER} && pctl dev up"
    fi
    api_port="$(k3d_api_host_port 2>/dev/null || echo 6443)"
    case "${ip}" in 100.*) ensure_k3d_tls_san "$ip";; esac
  fi

  # No key passed but OAuth creds are in the environment → mint one, so the code is self-sufficient.
  if [ -z "$ts_key" ] && [ -n "$ts_id" ] && [ -n "$ts_secret" ]; then
    say "Minting a Tailscale auth key for the join code…"
    ts_key="$(ts_mint_authkey "$ts_id" "$ts_secret" "$ts_tag")"
  fi
  if [ -z "$ts_key" ]; then
    warn "No Tailscale auth key embedded (pass --ts-authkey, or set PCTL_TS_OAUTH_ID/SECRET);"
    warn "the joining machine must already be on the tailnet to reach https://${ip}:${api_port}."
  fi

  local code payload
  payload="$(printf 'https://%s:%s %s %s' "$ip" "$api_port" "$tok" "$ts_key" | sed 's/ *$//')"
  code="PC2.$(printf '%s' "$payload" | b64url_encode)"
  printf '%sJoin code — master API https://%s:%s%s\n\n  %s\n\n' "$C_BOLD" "$ip" "$api_port" "$C_RESET" "$code"
  printf 'On the new computer (Linux): sudo placecontext connect --code <code>\n'
}

cmd_join() {
  local code=""
  while [ $# -gt 0 ]; do case "$1" in --code) code="$2"; shift 2;; *) die "join: unknown arg $1";; esac; done
  [ -n "$code" ] || die "join needs --code <code> — generate it on the master: pctl join-code"
  code="$(printf '%s' "$code" | tr -d '[:space:]')"
  case "$code" in PC1.*|PC2.*) ;; *) die "unrecognised join code (expected PC1.… or PC2.…)";; esac
  local b64="${code#PC?.}"
  local decoded
  decoded="$(b64url_decode "$b64")" || die "join code is corrupted"
  # Fields: url token [tskey] — PC1 codes simply have no third field.
  local url token tskey rest
  url="${decoded%% *}"
  rest="${decoded#"$url"}"; rest="${rest# }"
  token="${rest%% *}"
  tskey="${rest#"$token"}"; tskey="${tskey# }"
  [ -n "$url" ] && [ -n "$token" ] || die "join code is incomplete"
  local -a extra=()
  [ -n "${tskey:-}" ] && extra=(--ts-authkey "$tskey")
  if [ "$(id -u)" != 0 ]; then
    # The TUI can't prompt for a sudo password — self-elevate when passwordless sudo exists,
    # otherwise hand the operator the exact command to run.
    if sudo -n true 2>/dev/null; then
      say "Joining $url as a worker (via sudo)…"
      exec sudo -n "$0" agent join --server-url "$url" --node-token "$token" "${extra[@]}"
    fi
    die "joining installs k3s (needs root) — run: sudo $0 join --code '$code'"
  fi
  cmd_agent_join --server-url "$url" --node-token "$token" "${extra[@]}"
}

cmd_join_cmd() {
  local tok ip api_port=6443
  tok="$(resolve_node_token 2>/dev/null || true)"
  [ -n "$tok" ] || tok="<run on server: resolve node-token>"
  ip="$(mesh_ipv4 2>/dev/null || true)"
  [ -n "$ip" ] || ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  [ -n "$ip" ] || ip="$(ipconfig getifaddr en0 2>/dev/null || true)"
  if have k3d && dev_cluster_exists; then
    api_port="$(k3d_api_host_port 2>/dev/null || echo 6443)"
  fi
  printf '%sAdd a worker node — run on the other machine (Linux):%s\n' "$C_BOLD" "$C_RESET"
  printf '  sudo ./deploy/pctl agent join \\\n    --server-url https://%s:%s \\\n    --node-token %s \\\n    [--ts-oauth-client-id ID --ts-oauth-secret SECRET]\n' "${ip:-<server-ip>}" "$api_port" "$tok"
  printf '  # or: sudo placecontext connect --code $(pctl join-code | …)\n'
}

# ── status / logs / url ──────────────────────────────────────────────────────────────────────────
resolve_ctx() {
  # For dev convenience, default to the k3d context if it exists and none was forced.
  if [ "$KUBECTL" = "kubectl" ] && have k3d && dev_cluster_exists; then
    use_dev_kubeconfig
  fi
}
cmd_status() {
  resolve_ctx
  say "Nodes:"; kube get nodes -o wide || die "no cluster reachable (is one up?)"
  echo; say "Workloads (ns: $PCTL_NAMESPACE):"
  kube -n "$PCTL_NAMESPACE" get deploy,pods,svc,ingress 2>/dev/null || warn "namespace not deployed yet"
}
cmd_logs() {
  resolve_ctx
  local follow=""; [ "${1:-}" = "-f" ] && follow="-f"
  kube -n "$PCTL_NAMESPACE" logs $follow -l app=placecontext --tail=100
}
cmd_url() {
  printf '%sPortal + MCP:%s  http://localhost:%s/   (MCP at /mcp)\n' "$C_BOLD" "$C_RESET" "$PCTL_PORT"
}

# Launch the reactive Go TUI dashboard (builds it on first run, or when the source is newer —
# e.g. right after `pctl update` pulled new TUI code).
cmd_tui() {
  local bin="$ROOT/deploy/tui/placecontext-tui"
  if [ ! -d "$ROOT/deploy/tui" ]; then
    # pctl was copied out of its tree (e.g. straight into /usr/local/bin): use a pctl-tui
    # installed alongside it instead of building from source.
    bin="$(command -v pctl-tui || true)"
    [ -n "$bin" ] || die "placecontext-tui not found — copy deploy/tui/pctl-tui next to pctl, or symlink pctl instead: ln -s <tree>/deploy/pctl /usr/local/bin/pctl"
  elif [ ! -x "$bin" ] || [ -n "$(find "$ROOT/deploy/tui" -name '*.go' -newer "$bin" 2>/dev/null)" ]; then
    have go || die "Go toolchain not found — install Go, then: make -C deploy/tui"
    say "Building the TUI…"
    ( cd "$ROOT/deploy/tui" && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o placecontext-tui . ) || die "TUI build failed."
  fi
  PCTL_BIN="$SELF" exec "$bin"
}

# ── help ─────────────────────────────────────────────────────────────────────────────────────────
# ── setup (guided, interactive) ──────────────────────────────────────────────────────────────────
# The hermes idea applied to the platform itself: one command that walks every setup step in
# order — doctor → mode → Tailscale OAuth → platform keys → bring-up → next steps. Every step
# maps 1:1 to a plain pctl command, so nothing here is magic; docs/SETUP.md is the long form.
cmd_setup() {
  [ -t 0 ] || die "setup is interactive — run it in a terminal (see docs/SETUP.md for scripted installs)."

  printf '\n%sPlaceContext setup%s — a context platform for AI\n' "$C_BOLD" "$C_RESET"
  printf '%sEach step maps to a plain pctl command; docs/SETUP.md is the long form.%s\n\n' "$C_DIM" "$C_RESET"

  # 1) tooling
  say "Step 1/5 — checking tooling (pctl doctor)…"
  cmd_doctor

  # 2) mode
  printf '\n'
  say "Step 2/5 — what should this machine be?"
  printf '  1) dev        — everything on this machine (k3d cluster)\n'
  printf '  2) server     — production master of a new fleet (k3s; nodes connect via Tailscale)\n'
  printf '  3) join       — worker joining an existing fleet (needs a join code from the master)\n'
  local mode
  while :; do
    printf '%schoice [1-3]: %s' "$C_BOLD" "$C_RESET"; read -r mode
    case "$mode" in 1|2|3) break;; *) warn "pick 1, 2 or 3";; esac
  done

  # 3) Tailscale OAuth (fleet modes) — saved once, every join mints its own key
  if [ "$mode" != 1 ]; then
    printf '\n'
    say "Step 3/5 — Tailscale (nodes connect via Tailscale)…"
    load_ts_oauth
    if [ -n "${PCTL_TS_OAUTH_ID:-}" ]; then
      ok "Tailscale OAuth client already configured (id: ${PCTL_TS_OAUTH_ID%????}****)."
    else
      printf 'Create an OAuth client in the Tailscale admin console (auth_keys write scope,\n'
      printf 'device tag tag:k8s) and paste it here — or leave blank to skip for now.\n'
      local tsid tssec
      printf '%sclient id: %s' "$C_BOLD" "$C_RESET"; read -r tsid
      if [ -n "$tsid" ]; then
        printf '%sclient secret: %s' "$C_BOLD" "$C_RESET"; read -rs tssec; printf '\n'
        [ -n "$tssec" ] || die "a client secret is required with a client id"
        cmd_ts_oauth --client-id "$tsid" --secret "$tssec"
        load_ts_oauth
      else
        warn "Skipped — joins will need --ts-authkey, or run: pctl ts-oauth --client-id … --secret …"
      fi
    fi
  else
    printf '\n'; say "Step 3/5 — Tailscale: not needed for a single-machine dev cluster (skipped)."
  fi

  # 4) platform feature keys (stored in the overlay; re-applied on every deploy)
  printf '\n'
  say "Step 4/5 — platform features…"
  local yn key
  printf '%sEnable the event-ingest webhook (POST /ingest/{event})? [Y/n]: %s' "$C_BOLD" "$C_RESET"; read -r yn
  if [ "${yn:-y}" != "n" ] && [ "${yn:-y}" != "N" ]; then
    key="$(openssl rand -hex 24 2>/dev/null || head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    save_platform_key "PlaceContext__Ingest__Key" "$key"
    ok "Ingest key generated — callers send it as X-Ingest-Key:"
    printf '    %s\n' "$key"
  fi
  printf '%sEnable the inbound SMS gateway (POST /sms/inbound)? [y/N]: %s' "$C_BOLD" "$C_RESET"; read -r yn
  if [ "${yn:-n}" = "y" ] || [ "${yn:-n}" = "Y" ]; then
    key="$(openssl rand -hex 24 2>/dev/null || head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    save_platform_key "PlaceContext__Sms__InboundKey" "$key"
    ok "SMS inbound key generated — point your provider's webhook at /sms/inbound?key=…:"
    printf '    %s\n' "$key"
  fi
  printf '%s  (GitHub import + Anthropic LLM keys are also overlay keys — see docs/SETUP.md §7.)%s\n' "$C_DIM" "$C_RESET"

  # 5) bring-up
  printf '\n'
  say "Step 5/5 — bringing the platform up…"
  case "$mode" in
    1)
      [ -s "$PCTL_IMAGE_TAR" ] || cmd_build
      cmd_dev_up
      ;;
    2)
      [ "$(id -u)" = 0 ] || die "a production master installs k3s + systemd — rerun as: sudo $0 setup"
      cmd_server_up
      ;;
    3)
      local code
      printf 'On the master run: sudo pctl join-code — then paste the code here.\n'
      printf '%sjoin code: %s' "$C_BOLD" "$C_RESET"; read -r code
      [ -n "$code" ] || die "no join code given"
      cmd_join --code "$code"
      ;;
  esac

  # next steps
  printf '\n%sSetup complete.%s\n\n' "$C_BOLD" "$C_RESET"
  [ "$mode" = 1 ] && printf '  Portal + MCP:  http://localhost:%s  (MCP at /mcp)\n' "$PCTL_PORT"
  [ "$mode" = 2 ] && printf '  Portal + MCP:  http://<this-machine>:%s — add workers with: sudo pctl join-code\n' "$PCTL_PORT"
  printf '  Dashboard:     pctl tui\n'
  printf '  First project: portal → Onboarding, or import from GitHub / an Obsidian vault (/import)\n'
  printf '  Agents:        connect MCP, then call setup_hermes for the job-orchestration skill\n'
  printf '  Guide:         docs/SETUP.md\n'
}

cmd_help() {
  cat <<EOF
${C_BOLD}pctl${C_RESET} — PlaceContext control CLI

${C_BOLD}USAGE${C_RESET}
  pctl <command> [options]

${C_BOLD}LOCAL DEV${C_RESET} ${C_DIM}(k3d: a 1-server + ${PCTL_AGENTS}-agent k3s cluster on this machine)${C_RESET}
  dev up [--rebuild]     Clean dev Docker, create cluster, import image, deploy
  dev down               Delete the local k3d cluster
  dev clean              Remove the dev Docker Postgres containers + volumes
  dev add-node [--role agent|server] [--name N]   Add a node to the dev cluster
  image import           (Re)import the local image into the dev cluster

${C_BOLD}PRODUCTION${C_RESET} ${C_DIM}(k3s across multiple machines)${C_RESET}
  server up [--image IMG] [--ts-oauth-client-id ID --ts-oauth-secret SECRET]
                         Install k3s server here + deploy (sudo); Tailscale meshes the fleet (sudo)
  agent join --server-url URL --node-token TOK [--ts-oauth-client-id ID --ts-oauth-secret SECRET]
                         Join this machine as a worker (sudo)
                         (self-hosted mesh: --vpn-control https://headscale --vpn-authkey KEY)
  join-cmd                                        Print the worker-join command (run on server)
  ts-oauth --client-id ID --secret SECRET   Save the Tailscale OAuth client once (root:
                         /etc/placecontext, else ~/.config/placecontext); joins then mint their
                         own single-use tailnet keys — no key handling (--status / --clear)
  join-code [--ts-authkey KEY]   Print a one-string join code (run on the master). Nodes connect
                         over Tailscale: the code carries the master's tailnet address, plus a
                         key minted from the saved OAuth client (or --ts-authkey), so a fresh
                         machine joins the tailnet and the cluster from one string
  join --code CODE       Join this computer to the cluster using a join code (TUI: press [j]);
                         with a saved ts-oauth client a keyless code still joins via OAuth

${C_BOLD}MESH${C_RESET} ${C_DIM}(self-hosted WireGuard control plane via Headscale, on a DO droplet)${C_RESET}
  mesh up --domain FQDN  Start Headscale (your own Tailscale) for the fleet
  mesh tenant add|rm ID  Add/remove a customer — an isolated private network (tag:cust-ID, ACL-enforced)
  mesh authkey --tenant ID  Mint that customer's pre-auth key (use as --vpn-authkey on their nodes)
  mesh down              Stop Headscale

${C_BOLD}ANYWHERE${C_RESET}
  setup                  Guided interactive setup: doctor → mode (dev/server/join) → Tailscale
                         OAuth → platform keys → bring-up → next steps (see docs/SETUP.md)
  tui                    Launch the reactive full-screen dashboard (Go TUI)
  build [--tag TAG]      Build the container image and export it to the tarball
  deploy [--image IMG] [--context CTX]
                         Apply the manifests to the current (or given) kube context
  update [--deploy]      Git checkout: pull + optionally rebuild/roll out. Packaged install: fetch
                         the latest GitHub release, lay it over this install, and (--deploy) roll it in
  release-apply          Import the bundled image into the local cluster (k3s or k3d) and re-deploy
  package [--no-image] [--arch amd64|arm64] [--os linux|darwin]
                         Build a self-contained release tarball (pctl + TUI + manifests + image)
                         in dist/; --arch/--os cross-build for the target machine (a darwin
                         package still carries a linux image — k3d nodes run in the Docker VM)
  kill pod|node|job NAME [--yes]   Delete a pod / k3d node / job (prompts unless --yes)
  db ha                  Replicated Postgres (1 primary + 2 replicas) via CloudNativePG (single-cluster)
  db ha-join             Join this node as a cross-site Patroni hot-standby (DO primary; see deploy/ha/README.md)
  db backup-now          Dump all databases to MinIO right now (nightly CronJob does this at 03:00)
  db backups             List the dumps currently held (7-day retention)
  db restore [--dump KEY] [--yes]   Restore the databases from a dump (latest by default)
  db minio               Port-forward the MinIO store to localhost (console :9001)
  minio open BUCKET/KEY  Download a MinIO object and open it (e.g. a report's HTML)
  ensure                 Bring the whole stack up idempotently (start/create cluster + apply + wait)
  autostart [--disable]  Run 'ensure' on boot (k3d → systemd user service; k3s → already a service)
  status                 Show nodes + workloads
  logs [-f]              Tail the PlaceContext Host logs
  url                    Print the portal / MCP URL
  doctor                 Check required tools
  help                   This help

${C_BOLD}CONFIG${C_RESET} ${C_DIM}(environment overrides)${C_RESET}
  PCTL_CLUSTER=$PCTL_CLUSTER  PCTL_NAMESPACE=$PCTL_NAMESPACE  PCTL_PORT=$PCTL_PORT  PCTL_AGENTS=$PCTL_AGENTS
  PCTL_IMAGE=$PCTL_IMAGE
EOF
}

# ── dispatch ───────────────────────────────────────────────────────────────────────────────────
main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    dev)
      local sub="${1:-}"; shift || true
      case "$sub" in
        up)        cmd_dev_up "$@";;
        down)      cmd_dev_down "$@";;
        clean)     cmd_dev_clean "$@";;
        add-node)  cmd_dev_add_node "$@";;
        *) die "unknown 'dev' subcommand: '$sub' (try: up | down | clean | add-node)";;
      esac;;
    image)
      local sub="${1:-}"; shift || true
      case "$sub" in
        import) cmd_image_import "$@";;
        *) die "unknown 'image' subcommand: '$sub' (try: import)";;
      esac;;
    server)
      local sub="${1:-}"; shift || true
      case "$sub" in
        up) cmd_server_up "$@";;
        *) die "unknown 'server' subcommand: '$sub' (try: up)";;
      esac;;
    agent)
      local sub="${1:-}"; shift || true
      case "$sub" in
        join) cmd_agent_join "$@";;
        *) die "unknown 'agent' subcommand: '$sub' (try: join)";;
      esac;;
    kill)         cmd_kill "$@";;
    db)           cmd_db "$@";;
    mesh)         cmd_mesh "$@";;
    minio)        case "${1:-}" in open) shift; cmd_minio_open "$@";; *) die "usage: pctl minio open <bucket/key>";; esac;;
    autostart)    cmd_autostart "$@";;
    ensure)       cmd_ensure "$@";;
    tui|ui)       cmd_tui "$@";;
    build)        cmd_build "$@";;
    deploy)       cmd_deploy "$@";;
    update)       cmd_update "$@";;
    release-apply) cmd_release_apply "$@";;
    package)      cmd_package "$@";;
    status)       cmd_status "$@";;
    logs)         cmd_logs "$@";;
    url)          cmd_url "$@";;
    join-cmd)     cmd_join_cmd "$@";;
    join-code)    cmd_join_code "$@";;
    join)         cmd_join "$@";;
    ts-oauth)     cmd_ts_oauth "$@";;
    setup)        cmd_setup "$@";;
    doctor)       cmd_doctor "$@";;
    help|-h|--help) cmd_help;;
    version|--version)
      if [ -f "$ROOT/VERSION" ]; then echo "pctl $(tr -d '[:space:]' < "$ROOT/VERSION")"
      else echo "pctl $(git -C "$ROOT" describe --tags --always 2>/dev/null || echo dev)"; fi;;
    *) warn "unknown command: $cmd"; echo; cmd_help; exit 2;;
  esac
}
main "$@"
