<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PlaceContext.Desktop"
             x:Class="PlaceContext.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter" />
            <Setter Property="Background" Value="#0B0E10" />
            <Setter Property="Foreground" Value="#EEF2F3" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#89959B" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="Foreground" Value="#46DF7B" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.4" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#111518" />
            <Setter Property="BorderBrush" Value="#283035" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#46DF7B" />
            <Setter Property="Foreground" Value="#071009" />
            <Setter Property="BorderBrush" Value="#69F397" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,11" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#69F397" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#151A1D" />
            <Setter Property="Foreground" Value="#D9DFE1" />
            <Setter Property="BorderBrush" Value="#303A3F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="14,9" />
        </Style>
        <Style Selector="TextBox.endpoint">
            <Setter Property="Background" Value="#0C1012" />
            <Setter Property="Foreground" Value="#EEF2F3" />
            <Setter Property="BorderBrush" Value="#303A3F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9AA5AA" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="0,1" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#171D20" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="#173120" />
            <Setter Property="Foreground" Value="#76EF9E" />
        </Style>
        <Style Selector="Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background" Value="#173120" />
        </Style>
        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.avatar">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>
    </Application.Styles>
</Application>
