<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PlaceContext.Desktop.Views.ConnectionView" x:CompileBindings="False">
    <Grid Background="#0B0E10">
        <Ellipse Width="520" Height="520" Fill="#101C15" Opacity="0.65" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-260,-280,0,0" />
        <Grid ColumnDefinitions="*,480,*" RowDefinitions="*,Auto,*">
            <StackPanel Grid.Column="1" Grid.Row="1" Spacing="22">
                <StackPanel HorizontalAlignment="Center" Spacing="10">
                    <Border Width="52" Height="52" CornerRadius="13" Background="#46DF7B">
                        <TextBlock Text="P" Foreground="#08110A" FontWeight="Bold" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PLACECONTEXT" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="12" LetterSpacing="2" />
                    <TextBlock Text="Connect your workspace" HorizontalAlignment="Center" FontSize="28" FontWeight="SemiBold" Margin="0,13,0,0" />
                    <TextBlock Text="Sign in through your PlaceContext instance to load live workspace data." Classes="muted" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="390" />
                </StackPanel>
                <Border Classes="card" Padding="24">
                    <StackPanel Spacing="11">
                        <TextBlock Text="PLACECONTEXT ENDPOINT" Classes="eyebrow" />
                        <TextBox Classes="endpoint" Text="{Binding Endpoint}" PlaceholderText="https://placecontext.example.com" />
                        <TextBlock Text="A browser window will open for OAuth authorization. Tokens remain in memory; only this endpoint is saved." Classes="muted" FontSize="11" TextWrapping="Wrap" />
                        <Border IsVisible="{Binding HasConnectionError}" Background="#34191B" BorderBrush="#6A3034" BorderThickness="1" CornerRadius="6" Padding="10">
                            <TextBlock Text="{Binding ConnectionError}" Foreground="#FF9EA3" FontSize="11" TextWrapping="Wrap" />
                        </Border>
                        <Grid ColumnDefinitions="*,Auto" Margin="0,5,0,0">
                            <Button Classes="secondary" Command="{Binding UseLocalCommand}" Content="Use localhost" HorizontalAlignment="Left" />
                            <Button Grid.Column="1" Classes="primary" Command="{Binding ConnectCommand}" Content="{Binding ConnectButtonText}" />
                        </Grid>
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding ConnectionStatus}" Classes="muted" FontSize="10" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
