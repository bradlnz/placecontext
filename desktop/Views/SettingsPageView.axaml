<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PlaceContext.Desktop.Views.SettingsPageView"
             x:CompileBindings="False">
    <ScrollViewer>
        <StackPanel Margin="34" Spacing="24" MaxWidth="920" HorizontalAlignment="Left">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" Classes="pageTitle" />
                    <TextBlock Text="{Binding Subtitle}" Classes="muted" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Classes="secondary" Command="{Binding ReconnectCommand}"
                        Content="Change endpoint" VerticalAlignment="Center" />
            </Grid>

            <Border Classes="card" Padding="22">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <StackPanel>
                        <TextBlock Text="CONNECTION" Classes="eyebrow" />
                        <TextBlock Text="{Binding ConnectedEndpoint}" FontSize="16" FontWeight="SemiBold" Margin="0,11,0,0" />
                        <TextBlock Text="{Binding ConnectionDetail}" Foreground="#76EF9E" FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="21" Background="#173120">
                        <TextBlock Text="✓" Foreground="#76EF9E" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="#283035" Margin="0,20,0,16" />
                    <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,*">
                        <StackPanel>
                            <TextBlock Text="HEALTH CHECK" Classes="eyebrow" />
                            <TextBlock Text="/api/desktop/health" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11" Margin="0,7,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="AUTHENTICATION" Classes="eyebrow" />
                            <TextBlock Text="OAuth 2.1 + PKCE" FontSize="11" Margin="0,7,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Classes="card" Padding="22">
                <StackPanel Spacing="18">
                    <TextBlock Text="APPLICATION" Classes="eyebrow" />
                    <Grid ColumnDefinitions="180,*">
                        <TextBlock Text="Desktop client" Classes="muted" />
                        <TextBlock Grid.Column="1" Text="{Binding ClientVersion, StringFormat=Version {0}}" />
                    </Grid>
                    <Grid ColumnDefinitions="180,*">
                        <TextBlock Text="Runtime" Classes="muted" />
                        <TextBlock Grid.Column="1" Text="{Binding RuntimeVersion}" />
                    </Grid>
                    <Grid ColumnDefinitions="180,*">
                        <TextBlock Text="Platform" Classes="muted" />
                        <TextBlock Grid.Column="1" Text="{Binding Platform}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="#101A14" BorderBrush="#244B30" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid ColumnDefinitions="22,*">
                    <TextBlock Text="i" Foreground="#76EF9E" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Classes="muted" TextWrapping="Wrap"
                               Text="The desktop client loads projects, jobs, and recent runs as the signed-in PlaceContext user. Existing role permissions are enforced by every desktop API endpoint." />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
