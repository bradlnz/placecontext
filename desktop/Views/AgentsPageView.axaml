<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PlaceContext.Desktop.Views.AgentsPageView" x:CompileBindings="False">
    <ScrollViewer><StackPanel Margin="34" Spacing="24">
        <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Title}" Classes="pageTitle" /><TextBlock Text="{Binding Subtitle}" Classes="muted" Margin="0,5,0,0" /></StackPanel>
            <Button Grid.Column="1" Classes="primary" Content="New agent team" VerticalAlignment="Center" /></Grid>
        <Grid ColumnDefinitions="3*,2*" ColumnSpacing="16">
            <Border Classes="card" Padding="20"><StackPanel Spacing="16"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="LAUNCH TEAM" Classes="eyebrow" /><TextBlock Text="4 agents" Classes="muted" FontSize="10" Margin="0,4,0,0" /></StackPanel><Button Grid.Column="1" Classes="secondary" Content="Open team chat" /></Grid>
                <ItemsControl ItemsSource="{Binding Members}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Grid ColumnDefinitions="48,*,Auto" Margin="0,8"><Border Classes="avatar" Background="{Binding Accent}"><TextBlock Text="{Binding Initials}" Foreground="#071009" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Role}" Classes="muted" FontSize="10" /></StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"><Ellipse Width="7" Height="7" Fill="#46DF7B" /><TextBlock Text="{Binding Status}" Classes="muted" FontSize="10" /></StackPanel></Grid>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></Border>
            <Border Grid.Column="1" Classes="card" Padding="20"><StackPanel Spacing="17"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="TEAM GOALS" Classes="eyebrow" /><Button Grid.Column="1" Classes="secondary" Content="Add goal" Padding="9,5" /></Grid>
                <ItemsControl ItemsSource="{Binding Goals}"><ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Spacing="7" Margin="0,7"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12" /><TextBlock Grid.Column="1" Text="{Binding Status}" Foreground="#76EF9E" FontSize="9" /></Grid>
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="5" Foreground="#46DF7B" /><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Owner}" Classes="muted" FontSize="9" /><TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0}%}" Classes="muted" FontSize="9" /></Grid></StackPanel>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></Border>
        </Grid>
    </StackPanel></ScrollViewer>
</UserControl>
