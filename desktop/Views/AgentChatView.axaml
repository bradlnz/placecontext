<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PlaceContext.Desktop.Views.AgentChatView" x:CompileBindings="False">
    <Grid RowDefinitions="Auto,*" Margin="34,26,34,30">
        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20"><StackPanel><TextBlock Text="{Binding Title}" Classes="pageTitle" /><TextBlock Text="{Binding Subtitle}" Classes="muted" Margin="0,5,0,0" /></StackPanel><Button Grid.Column="1" Classes="primary" Content="New channel" VerticalAlignment="Center" /></Grid>
        <Grid Grid.Row="1" ColumnDefinitions="210,*,210">
            <Border Classes="card" CornerRadius="10,0,0,10" Padding="13"><StackPanel><TextBlock Text="CHANNELS" Classes="eyebrow" Margin="7,5,0,10" />
                <ItemsControl ItemsSource="{Binding Channels}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#151D19" CornerRadius="6" Padding="10" Margin="0,2"><Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="{Binding Name, StringFormat=\#{0}}" FontWeight="SemiBold" FontSize="11" /><TextBlock Text="{Binding Description}" Classes="muted" TextTrimming="CharacterEllipsis" FontSize="9" /></StackPanel><Border Grid.Column="1" Background="#46DF7B" CornerRadius="8" Padding="6,2" IsVisible="{Binding Unread}"><TextBlock Text="{Binding Unread}" Foreground="#071009" FontSize="9" /></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></Border>
            <Border Grid.Column="1" Background="#0E1214" BorderBrush="#283035" BorderThickness="0,1"><Grid RowDefinitions="Auto,*,Auto">
                <Border Padding="18,14" BorderBrush="#283035" BorderThickness="0,0,0,1"><StackPanel><TextBlock Text="# launch-team" FontWeight="SemiBold" /><TextBlock Text="Product launch coordination · 4 agents" Classes="muted" FontSize="9" /></StackPanel></Border>
                <ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding Messages}" Margin="18,12"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="42,*" Margin="0,8"><Border Classes="avatar" Background="{Binding Accent}"><TextBlock Text="{Binding Initials}" Foreground="#071009" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" /></Border><StackPanel Grid.Column="1"><StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="{Binding Author}" FontWeight="SemiBold" FontSize="11" /><TextBlock Text="{Binding Time}" Classes="muted" FontSize="9" VerticalAlignment="Center" /></StackPanel><TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="11" LineHeight="17" Margin="0,4,0,0" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                <Border Grid.Row="2" Padding="14" BorderBrush="#283035" BorderThickness="0,1,0,0"><Grid ColumnDefinitions="*,Auto"><TextBox Classes="endpoint" PlaceholderText="Message the agent team…" /><Button Grid.Column="1" Classes="primary" Content="Send" Margin="8,0,0,0" /></Grid></Border>
            </Grid></Border>
            <Border Grid.Column="2" Classes="card" CornerRadius="0,10,10,0" Padding="15"><StackPanel><TextBlock Text="TEAM" Classes="eyebrow" Margin="4,5,0,10" /><ItemsControl ItemsSource="{Binding Team}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="34,*" Margin="0,7"><Border Width="28" Height="28" CornerRadius="14" Background="{Binding Accent}"><TextBlock Text="{Binding Initials}" Foreground="#071009" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" /></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontSize="10" /><TextBlock Text="{Binding Status}" Foreground="#76EF9E" FontSize="8" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        </Grid>
    </Grid>
</UserControl>
