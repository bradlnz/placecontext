<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PlaceContext.Desktop.Views.DataPageView" x:CompileBindings="False">
    <Grid Margin="34" RowDefinitions="Auto,Auto,*" RowSpacing="20">
        <StackPanel>
            <TextBlock Text="{Binding Title}" Classes="pageTitle" />
            <TextBlock Text="{Binding Subtitle}" Classes="muted" Margin="0,5,0,0" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="280,*" ColumnSpacing="20">
            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="PROJECT" Classes="eyebrow" />
                    <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="DATA RESOURCES" Classes="eyebrow" Margin="0,8,0,0" />
                    <ScrollViewer MaxHeight="185"><ItemsControl ItemsSource="{Binding Resources}"><ItemsControl.ItemTemplate><DataTemplate>
                        <StackPanel Margin="0,6"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" /><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="9" /></StackPanel>
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card" Padding="18">
                <Grid RowDefinitions="Auto,130,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="SQL EDITOR" Classes="eyebrow" /><TextBlock Grid.Column="1" Text="SELECT only" Classes="muted" FontSize="10" /></Grid>
                    <TextBox Grid.Row="1" Text="{Binding Sql}" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
                    <Button Grid.Row="2" Classes="primary" Content="Run query" Command="{Binding RunQueryCommand}" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Classes="card" Padding="18">
            <Grid RowDefinitions="Auto,*" RowSpacing="12">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="RESULTS" Classes="eyebrow" /><TextBlock Grid.Column="1" Text="{Binding ResultSummary}" Classes="muted" FontSize="10" /></Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11" Margin="0,4" />
                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
