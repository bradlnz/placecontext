<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PlaceContext.Desktop.Views.AgentChatPageView" x:CompileBindings="False">
    <Grid Margin="34" RowDefinitions="Auto,*" RowSpacing="20">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel><TextBlock Text="{Binding Title}" Classes="pageTitle" /><TextBlock Text="{Binding Subtitle}" Classes="muted" Margin="0,5,0,0" /></StackPanel>
            <Button Grid.Column="1" Classes="secondary" Content="New conversation" Command="{Binding NewConversationCommand}" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="230,*" ColumnSpacing="16">
            <Border Classes="card" Padding="15">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
                    <TextBlock Text="PROJECT" Classes="eyebrow" />
                    <ComboBox Grid.Row="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <ListBox Grid.Row="2" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel Margin="5,8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="11" /><TextBlock Text="{Binding Meta}" Classes="muted" FontSize="9" /></StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="1" Classes="card">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Margin="20,17"><TextBlock Text="{Binding ConversationTitle}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding Status}" Classes="muted" FontSize="10" Margin="0,4,0,0" /></StackPanel>
                    <Border Grid.Row="1" BorderBrush="#283035" BorderThickness="0,1,0,1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding Messages}" Margin="20,10"><ItemsControl.ItemTemplate><DataTemplate>
                            <Border Background="#151A1D" CornerRadius="8" Padding="13,10" Margin="0,6" MaxWidth="680" HorizontalAlignment="Left">
                                <StackPanel><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Author}" Foreground="#76EF9E" FontWeight="SemiBold" FontSize="10" /><TextBlock Grid.Column="1" Text="{Binding Time}" Classes="muted" FontSize="9" /></Grid><TextBlock Text="{Binding Content}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" LineHeight="18" /></StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                    </Border>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="16">
                        <TextBox Text="{Binding Message}" PlaceholderText="Message the workspace agent…" AcceptsReturn="True" MaxHeight="110" />
                        <Button Grid.Column="1" Classes="primary" Content="Send" Command="{Binding SendCommand}" VerticalAlignment="Bottom" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
