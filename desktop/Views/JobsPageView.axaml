<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PlaceContext.Desktop.Views.JobsPageView" x:CompileBindings="False">
    <Grid Margin="26" RowDefinitions="Auto,*" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <StackPanel><TextBlock Text="{Binding Title}" Classes="pageTitle" /><TextBlock Text="{Binding Subtitle}" Classes="muted" Margin="0,4,0,0" /></StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" FontSize="10" VerticalAlignment="Center" MaxWidth="390" TextWrapping="Wrap" />
            <Button Grid.Column="2" Classes="primary" Content="Deploy" Command="{Binding SaveCommand}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="210,*,285" ColumnSpacing="12">
            <Border Classes="card" Padding="13">
                <Grid RowDefinitions="Auto,Auto,Auto,170,Auto,*,Auto" RowSpacing="9">
                    <TextBlock Text="PROJECT" Classes="eyebrow" />
                    <ComboBox Grid.Row="1" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto"><TextBlock Text="JOBS" Classes="eyebrow" VerticalAlignment="Center" /><Button Grid.Column="1" Content="+" Command="{Binding NewJobCommand}" Padding="9,4" /></Grid>
                    <ListBox Grid.Row="3" ItemsSource="{Binding Jobs}" SelectedItem="{Binding SelectedJob}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4,7"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" /><TextBlock Text="{Binding MapSourceKind}" Classes="muted" FontSize="9" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" IsVisible="{Binding HasDefinition}"><TextBlock Text="FILES" Classes="eyebrow" VerticalAlignment="Center" /><Button Grid.Column="1" Content="+" Command="{Binding AddFileCommand}" Padding="9,4" /></Grid>
                    <ListBox Grid.Row="5" ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}" Background="Transparent" BorderThickness="0" IsVisible="{Binding HasDefinition}">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Path}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="10" Margin="4,7" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Button Grid.Row="6" Classes="secondary" Content="Delete file" Command="{Binding DeleteFileCommand}" IsVisible="{Binding HasDefinition}" />
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card" IsVisible="{Binding HasDefinition}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <Grid Margin="14,11" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Text="CODE" Classes="eyebrow" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding SelectedFile.Path}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="10" IsVisible="{Binding IsCodeJob}" />
                        <TextBlock Grid.Column="2" Text="{Binding RuntimeId}" Foreground="#76EF9E" FontSize="10" VerticalAlignment="Center" />
                    </Grid>
                    <TextBox Grid.Row="1" Text="{Binding SelectedFile.Content}" AcceptsReturn="True" TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" Padding="16"
                             IsVisible="{Binding IsCodeJob}" />
                    <StackPanel Grid.Row="1" Margin="24" Spacing="8" IsVisible="{Binding !IsCodeJob}">
                        <TextBlock Text="Container image job" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="This job uses a pre-built image. Configure its image and execution settings in the inspector." Classes="muted" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Row="2" BorderBrush="#283035" BorderThickness="0,1,0,0" IsVisible="{Binding HasRunResults}" MaxHeight="190">
                        <ScrollViewer><StackPanel Margin="14,10" Spacing="8">
                            <TextBlock Text="EXECUTION RESULTS" Classes="eyebrow" />
                            <ItemsControl ItemsSource="{Binding RunResults}"><ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="#0C1012" CornerRadius="6" Padding="10" Margin="0,3">
                                    <StackPanel><TextBlock Text="{Binding Header}" Foreground="#76EF9E" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="{Binding Output}" FontFamily="Cascadia Mono,Consolas,monospace" TextWrapping="Wrap" FontSize="10" Margin="0,6,0,0" /><TextBlock Text="{Binding Log}" FontFamily="Cascadia Mono,Consolas,monospace" Classes="muted" TextWrapping="Wrap" FontSize="9" Margin="0,5,0,0" /></StackPanel>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel></ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="card" Padding="15" IsVisible="{Binding HasDefinition}">
                <ScrollViewer><StackPanel Spacing="10">
                    <TextBlock Text="JOB SETTINGS" Classes="eyebrow" />
                    <TextBlock Text="Name" Classes="muted" FontSize="9" /><TextBox Text="{Binding Name}" />
                    <TextBlock Text="Description" Classes="muted" FontSize="9" /><TextBox Text="{Binding Description}" AcceptsReturn="True" MaxHeight="70" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsCodeJob}">
                        <StackPanel><TextBlock Text="Runtime" Classes="muted" FontSize="9" /><ComboBox ItemsSource="{Binding Runtimes}" SelectedItem="{Binding RuntimeId}" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Entrypoint" Classes="muted" FontSize="9" /><TextBox Text="{Binding Entrypoint}" /></StackPanel>
                    </Grid>
                    <StackPanel IsVisible="{Binding !IsCodeJob}"><TextBlock Text="Container image" Classes="muted" FontSize="9" /><TextBox Text="{Binding MapImage}" /></StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel><TextBlock Text="Concurrency" Classes="muted" FontSize="9" /><NumericUpDown Value="{Binding ConcurrencyLimit}" Minimum="1" Maximum="1000" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Return type" Classes="muted" FontSize="9" /><ComboBox ItemsSource="{Binding ReturnTypes}" SelectedItem="{Binding ReturnType}" /></StackPanel>
                    </Grid>
                    <TextBlock Text="Input payloads (one per line)" Classes="muted" FontSize="9" /><TextBox Text="{Binding InputPayloads}" AcceptsReturn="True" FontFamily="Cascadia Mono,Consolas,monospace" MinHeight="62" />
                    <TextBlock Text="Environment (NAME=value)" Classes="muted" FontSize="9" /><TextBox Text="{Binding Environment}" AcceptsReturn="True" FontFamily="Cascadia Mono,Consolas,monospace" MinHeight="52" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <StackPanel><TextBlock Text="Success codes" Classes="muted" FontSize="9" /><TextBox Text="{Binding SuccessExitCodes}" /></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="Partial codes" Classes="muted" FontSize="9" /><TextBox Text="{Binding PartialExitCodes}" /></StackPanel>
                    </Grid>
                    <CheckBox Content="Allow network egress" IsChecked="{Binding AllowNetworkEgress}" />
                    <CheckBox Content="Allow API invocation" IsChecked="{Binding AllowApiInvocation}" />
                    <TextBlock Text="TEST RUN" Classes="eyebrow" Margin="0,8,0,0" />
                    <TextBox Text="{Binding RunInput}" AcceptsReturn="True" FontFamily="Cascadia Mono,Consolas,monospace" MinHeight="62" />
                    <Button Classes="primary" Content="Deploy and run" Command="{Binding RunCommand}" />
                </StackPanel></ScrollViewer>
            </Border>

            <Border Grid.Column="1" Grid.ColumnSpan="2" Classes="card" Padding="30" IsVisible="{Binding !HasDefinition}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><TextBlock Text="Open a job" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="Choose a job from the native list, or create one." Classes="muted" /></StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
