<% page_title "Portal logins" %>

<div class="page-intro">
  <div>
    <span class="eyebrow">Access management</span>
    <h2>Portal logins</h2>
    <p>Control who can enter this customer workspace and what they can manage.</p>
  </div>
  <%= link_to new_portal_user_path, class: "btn btn-primary" do %>
    <%= icon :plus %>
    Add user
  <% end %>
</div>

<div class="access-overview">
  <div class="access-overview-icon"><%= icon :users %></div>
  <div><strong>Customer access is isolated</strong><span>Every login is restricted to this tenant and its permitted customer records.</span></div>
  <span class="connection-pill"><span class="connection-dot"></span>Protected</span>
</div>

<div class="card card-flush">
  <div class="card-header">
    <div><span class="eyebrow">Workspace members</span><h2 class="card-title card-title-lg">People with access</h2></div>
    <span class="page-intro-badge"><%= pluralize(@portal_users.size, "user") %></span>
  </div>

  <% if @portal_users.any? %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Added</th>
          </tr>
        </thead>
        <tbody>
          <% @portal_users.each do |user| %>
            <tr>
              <td><div class="person-cell"><span class="person-avatar"><%= user.email.first.upcase %></span><span><strong><%= user.email %></strong><small>Portal user</small></span></div></td>
              <td><span class="role-pill"><%= user.role.capitalize %></span></td>
              <td>
                <% if user.enabled? %>
                  <span class="badge badge-succeeded">Enabled</span>
                <% else %>
                  <span class="badge badge-failed">Disabled</span>
                <% end %>
              </td>
              <td class="table-muted"><%= user.created_at.to_date.to_fs(:long) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state empty-state-rich">
      <div class="empty-state-icon"><%= icon :users %></div>
      <div class="empty-state-title">No portal users yet</div>
      <p>Add the first portal login to let a teammate access this workspace.</p>
      <%= link_to new_portal_user_path, class: "btn btn-primary" do %>
        <%= icon :plus %>
        Add user
      <% end %>
    </div>
  <% end %>
</div>
