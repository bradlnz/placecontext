<% page_title "Automations" %>

<div class="page-header">
  <div>
    <div class="breadcrumbs">
      <%= link_to "Dashboard", root_path %> · Automations
    </div>
  </div>
</div>

<%= form_with url: automations_path, method: :get, local: true, class: "project-selector" do |form| %>
  <%= form.label :project_id, "CRM project" %>
  <%= form.select :project_id, @projects.map { |project| [project["name"], project["id"]] }, { selected: @project_id }, { onchange: "this.form.submit()" } %>
<% end %>

<div class="card">
  <div class="card-header">
    <div>
      <h2 class="card-title">Available automations</h2>
      <p class="card-subtitle">Choose an automation to configure and run on your data.</p>
    </div>
  </div>

  <% if @project_id && @chains.any? %>
    <div class="automation-grid">
      <% @chains.each do |chain| %>
        <%= link_to automation_path(chain["id"], project_id: @project_id), class: "automation-card" do %>
          <h3 class="automation-card-title"><%= chain["name"] %></h3>
          <% if chain["description"].present? %>
            <p class="automation-card-desc"><%= chain["description"] %></p>
          <% else %>
            <p class="automation-card-desc">Run this PlaceContext automation on your project.</p>
          <% end %>
          <span class="automation-card-meta"><%= chain["steps"]&.size || 0 %> steps · Configure & run →</span>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-title">No automations available</div>
      <p>There are no automations configured for this project yet.</p>
    </div>
  <% end %>
</div>
