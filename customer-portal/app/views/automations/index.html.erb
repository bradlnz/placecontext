<% page_title "Automations" %>

<div class="page-intro">
  <div>
    <span class="eyebrow">Customer workflows</span>
    <h2>Automations</h2>
    <p>Purpose-built workflows enabled for this customer by your PlaceContext team.</p>
  </div>
  <div class="page-intro-badge"><%= @chains.size %> available</div>
</div>

<%= form_with url: automations_path, method: :get, local: true, class: "filter-bar" do |form| %>
  <% if @projects.many? %>
    <div class="filter-control">
      <%= form.label :project_id, "Project" %>
      <%= form.select :project_id, @projects.map { |project| [project["name"], project["id"]] }, { selected: @project_id }, { onchange: "this.form.submit()" } %>
    </div>
  <% else %>
    <%= form.hidden_field :project_id, value: @project_id %>
  <% end %>
  <% if current_portal_user&.can_manage_client_access? && @portal_clients.many? %>
    <div class="filter-control">
      <%= form.label :client_id, "Customer" %>
      <%= form.select :client_id, @portal_clients.map { |client| [client["name"], client["id"]] }, { selected: @client&.dig("id") }, { onchange: "this.form.submit()" } %>
    </div>
  <% end %>
  <% if @client %>
    <div class="filter-context"><span>Configured for</span><strong><%= @client["name"] %></strong></div>
  <% end %>
<% end %>

<% if @project_id && @client && @chains.any? %>
  <div class="automation-grid">
      <% @chains.each do |chain| %>
        <%= link_to automation_path(chain["id"], project_id: @project_id, client_id: @client["id"]), class: "automation-card" do %>
          <div class="automation-card-top">
            <span class="automation-icon"><%= icon :automations %></span>
            <span class="automation-available"><i></i> Available</span>
          </div>
          <h3 class="automation-card-title"><%= chain["name"] %></h3>
          <% if chain["description"].present? %>
            <p class="automation-card-desc"><%= chain["description"] %></p>
          <% else %>
            <p class="automation-card-desc">Run this PlaceContext automation on your project.</p>
          <% end %>
          <div class="automation-card-footer">
            <span class="automation-card-meta"><strong><%= chain["steps"]&.size || 0 %></strong> workflow steps</span>
            <span class="automation-card-action">Configure <b>→</b></span>
          </div>
        <% end %>
      <% end %>
  </div>
<% else %>
  <div class="card">
    <div class="empty-state empty-state-rich">
      <div class="empty-state-icon"><%= icon :automations %></div>
      <div class="empty-state-title"><%= @client ? "No automations assigned" : "No customer workspace found" %></div>
      <p><%= @client ? "Your PlaceContext team controls which automations appear here for this customer." : "A customer record must be connected before automations can be shown." %></p>
    </div>
  </div>
<% end %>
