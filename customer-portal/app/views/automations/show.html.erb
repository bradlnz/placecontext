<% page_title @chain["name"] %>

<div class="page-header automation-detail-header">
  <div>
    <div class="breadcrumbs">
      <%= link_to "Automations", automations_path(project_id: @project_id, client_id: @client["id"]) %>
      <span>›</span> Configure workflow
    </div>
    <span class="eyebrow">Running for <%= @client["name"] %></span>
    <h1><%= @chain["name"] %></h1>
  </div>
  <span class="automation-available"><i></i> Ready to run</span>
</div>

<% if @chain["description"].present? %>
  <p class="automation-detail-description"><%= @chain["description"] %></p>
<% end %>

<%= form_with url: run_automation_path(@chain["id"], project_id: @project_id), method: :post, local: true do %>
  <%= hidden_field_tag :client_id, @client["id"] %>

  <div class="workflow-steps">
  <% @chain["steps"].each_with_index do |step, index| %>
    <fieldset class="step-card">
      <legend><span class="step-number"><%= step["index"] + 1 %></span><span><small>Workflow step</small><%= step["jobName"] %></span></legend>

      <% if step["conditionExpression"].present? %>
        <div class="step-condition">
          <strong>Condition:</strong> <%= step["conditionExpression"] %>
        </div>
      <% end %>

      <div class="form-grid">
        <% step["parameters"].each do |param| %>
          <% field_name = "steps[#{step["index"]}][params][#{param["name"]}]" %>
          <div class="form-group <%= "full-width" if param["type"] == "textarea" %>">
            <%= label_tag field_name, param["label"].presence || param["name"] %>
            <% case param["type"] %>
            <% when "select" %>
              <%= select_tag field_name, options_for_select(param["options"] || []), include_blank: !param["required"], required: param["required"] %>
            <% when "checkbox" %>
              <%= check_box_tag field_name, "true", false %>
            <% when "number" %>
              <%= number_field_tag field_name, nil, required: param["required"] %>
            <% when "file" %>
              <%= text_field_tag field_name, nil, required: param["required"], placeholder: "File URL or identifier" %>
              <small class="form-help">File uploads are not supported in this preview.</small>
            <% when "textarea" %>
              <%= text_area_tag field_name, nil, required: param["required"] %>
            <% else %>
              <%= text_field_tag field_name, nil, required: param["required"] %>
            <% end %>
          </div>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  </div>

  <div class="run-toolbar">
    <div><strong>Ready to start?</strong><span>PlaceContext will run this workflow for <%= @client["name"] %>.</span></div>
    <div class="btn-toolbar">
      <%= link_to "Cancel", automations_path(project_id: @project_id, client_id: @client["id"]), class: "btn btn-secondary" %>
      <%= submit_tag "Run automation →", class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
