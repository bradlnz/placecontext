<% page_title "Automation run" %>

<div class="page-header">
  <div>
    <div class="breadcrumbs">
      <%= link_to "Dashboard", root_path %> ·
      <%= link_to "Automations", automations_path(project_id: @project_id) %> ·
      Run status
    </div>
    <h1>Automation run</h1>
  </div>
  <div>
    <%= run_status_badge(@run["status"]) %>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">Step timeline</h2>
  </div>

  <% if @run["steps"].present? && @run["steps"].any? %>
    <ul class="run-timeline">
      <% @run["steps"].each_with_index do |step, index| %>
        <li class="run-step" data-status="<%= step["status"] %>">
          <div class="run-step-marker"><%= index + 1 %></div>
          <div class="run-step-body">
            <div class="run-step-name"><%= step["jobName"] %></div>
            <div class="run-step-status"><%= step["status"] %></div>
            <% if step["error"].present? %>
              <div class="run-step-error"><%= step["error"] %></div>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <div class="empty-state">
      <p>No step details available yet.</p>
    </div>
  <% end %>
</div>

<% if @run["finalOutput"].present? %>
  <div class="card">
    <div class="card-header">
      <h2 class="card-title">Final output</h2>
    </div>
    <div class="output-panel">
      <pre><%= @run["finalOutput"] %></pre>
    </div>
  </div>
<% end %>

<div class="btn-toolbar">
  <%= link_to "Back to automations", automations_path(project_id: @project_id), class: "btn btn-secondary" %>
</div>

<% unless %w[Succeeded Failed Cancelled Partial].include?(@run["status"]) %>
  <script>
    setTimeout(function () { location.reload(); }, 3000);
  </script>
<% end %>
