<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for?(:page_title) ? "#{yield(:page_title)} · #{portal_brand_name}" : portal_brand_name %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body>
    <header class="workspace-bar">
      <div class="workspace-switcher">
        <span class="workspace-switcher-mark"><%= portal_brand_name.first.upcase %></span>
        <strong><%= portal_brand_name %></strong>
        <span aria-hidden="true">⌄</span>
      </div>
      <div class="workspace-bar-context">
        <span class="connection-dot"></span>
        Customer portal
      </div>
    </header>

    <div class="app-shell">
      <aside class="workspace-rail" aria-label="Workspace shortcuts">
        <%= link_to portal_relative_path(root_path), class: "rail-brand", aria: { label: portal_brand_name } do %>
          <% if portal_brand_logo_url %>
            <img src="<%= portal_brand_logo_url %>" alt="" />
          <% else %>
            <span><%= portal_brand_name.first.upcase %></span>
          <% end %>
        <% end %>
        <nav class="rail-nav">
          <%= link_to portal_relative_path(root_path), class: "rail-link", aria: { label: "Home" }, title: "Home" do %><%= icon :dashboard %><% end %>
          <%= link_to portal_relative_path(clients_path), class: "rail-link", aria: { label: "Clients" }, title: "Clients" do %><%= icon :clients %><% end %>
          <%= link_to portal_relative_path(automations_path), class: "rail-link", aria: { label: "Automations" }, title: "Automations" do %><%= icon :automations %><% end %>
          <%= link_to portal_relative_path(artifacts_path), class: "rail-link", aria: { label: "Artifacts" }, title: "Artifacts" do %><%= icon :artifacts %><% end %>
        </nav>
        <div class="rail-footer"><span><%= current_portal_user.email.first.upcase if current_portal_user %></span></div>
      </aside>

      <aside class="sidebar" aria-label="Main navigation">
        <div class="sidebar-heading">
          <strong>Home</strong>
          <%= link_to portal_relative_path(root_path), class: "sidebar-add", aria: { label: "Open home" } do %>＋<% end %>
        </div>

        <nav class="sidebar-nav">
          <%= nav_link_to "Overview", root_path, icon: :dashboard %>
          <span class="nav-section-label nav-section-label-spaced">Customers</span>
          <%= nav_link_to "Clients", clients_path, icon: :clients %>
          <%= nav_link_to "Leads", leads_path, icon: :leads %>
          <span class="nav-section-label nav-section-label-spaced">Work</span>
          <%= nav_link_to "Automations", automations_path, icon: :automations %>
          <%= nav_link_to "Artifacts", artifacts_path, icon: :artifacts %>
          <% if current_portal_user&.can_manage_portal_users? %>
            <span class="nav-section-label nav-section-label-spaced">Manage</span>
            <%= nav_link_to "Portal logins", portal_users_path, icon: :users %>
          <% end %>
        </nav>

        <div class="sidebar-footer">
          <%= button_to destroy_portal_user_session_path, method: :delete, class: "sidebar-signout" do %>
            <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M9 21H5C4.46957 21 3.96086 20.7893 3.58579 20.4142C3.21071 20.0391 3 19.5304 3 19V5C3 4.46957 3.21071 3.96086 3.58579 3.58579C3.96086 3.21071 4.46957 3 5 3H9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 17L21 12L16 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M21 12H9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Sign out
          <% end %>
        </div>
      </aside>

      <div class="app-body">
        <header class="topbar">
          <div class="topbar-main">
            <div class="topbar-section">
              <div class="mobile-brand-mark"><%= portal_brand_name.first.upcase %></div>
              <div class="page-heading-wrap">
                <span class="page-heading-icon"><%= icon :dashboard %></span>
                <h1 class="page-heading"><%= content_for?(:page_title) ? yield(:page_title) : "Dashboard" %></h1>
                <span class="page-heading-chevron" aria-hidden="true">⌄</span>
              </div>
            </div>
            <div class="topbar-section">
              <% if current_portal_user %>
                <div class="topbar-user"><span class="topbar-avatar"><%= current_portal_user.email.first.upcase %></span><%= current_portal_user.email %></div>
              <% end %>
            </div>
          </div>
          <nav class="content-tabs" aria-label="Workspace views">
            <%= nav_link_to "Overview", root_path, icon: :dashboard %>
            <%= nav_link_to "Clients", clients_path, icon: :clients %>
            <%= nav_link_to "Leads", leads_path, icon: :leads %>
            <%= nav_link_to "Automations", automations_path, icon: :automations %>
            <%= nav_link_to "Artifacts", artifacts_path, icon: :artifacts %>
          </nav>
        </header>

        <main class="main-content">
          <% if alert %>
            <div class="flash flash-alert" role="alert"><%= alert %></div>
          <% end %>
          <% if notice %>
            <div class="flash flash-notice" role="status"><%= notice %></div>
          <% end %>

          <%= yield %>
        </main>
      </div>
    </div>

    <nav class="mobile-nav" aria-label="Mobile navigation">
      <%= nav_link_to "Home", root_path, icon: :dashboard %>
      <%= nav_link_to "Clients", clients_path, icon: :clients %>
      <%= nav_link_to "Automations", automations_path, icon: :automations %>
      <%= nav_link_to "Artifacts", artifacts_path, icon: :artifacts %>
    </nav>
  </body>
</html>
