<% page_title @client["name"] %>

<div class="page-header">
  <div>
    <div class="breadcrumbs">
      <%= link_to "Clients", clients_path(project_id: @project_id) %> <span>›</span>
      <%= @client["name"] %>
    </div>
    <span class="eyebrow">Customer profile</span>
    <h1 class="profile-heading"><%= @client["name"] %></h1>
    <p class="profile-subheading"><%= @client["company"].presence || "Individual customer" %></p>
  </div>
  <div class="btn-toolbar">
    <% if current_portal_user&.can_manage_client_access? %>
      <%= link_to "Edit", edit_client_path(@client["id"], project_id: @project_id), class: "btn btn-secondary" %>
      <%= button_to "Delete", client_path(@client["id"], project_id: @project_id), method: :delete, data: { turbo_confirm: "Delete this client?" }, class: "btn btn-danger" %>
    <% end %>
  </div>
</div>

<div class="profile-layout">
<div class="card profile-card">
  <div class="profile-identity">
    <div class="profile-avatar"><%= @client["name"].to_s.first.upcase %></div>
    <div><strong><%= @client["name"] %></strong><span><%= @client["email"].presence || "No email added" %></span></div>
    <%= status_badge(@client["lifecycle_stage"]) %>
  </div>
  <div class="profile-grid">
    <div>
      <div class="profile-label">Company</div>
      <div class="profile-value"><%= @client["company"].presence || "—" %></div>
    </div>
    <div>
      <div class="profile-label">Stage</div>
      <div class="profile-value"><%= status_badge(@client["lifecycle_stage"]) %></div>
    </div>
    <div>
      <div class="profile-label">Email</div>
      <div class="profile-value"><%= @client["email"].presence || "—" %></div>
    </div>
    <div>
      <div class="profile-label">Phone</div>
      <div class="profile-value"><%= @client["phone"].presence || "—" %></div>
    </div>
    <div class="full-width profile-notes">
      <div class="profile-label">Notes</div>
      <div class="profile-value"><%= simple_format(@client["notes"].presence || "—") %></div>
    </div>
  </div>
</div>
<aside class="card profile-actions-card">
  <span class="eyebrow">Quick links</span>
  <h2>Customer workspace</h2>
  <%= link_to automations_path(project_id: @project_id), class: "profile-action-link" do %><span class="stat-icon-purple"><%= icon :automations %></span><div><strong>Automations</strong><small>View assigned workflows</small></div><b>→</b><% end %>
  <%= link_to artifacts_path(project_id: @project_id), class: "profile-action-link" do %><span class="stat-icon-green"><%= icon :artifacts %></span><div><strong>Artifacts</strong><small>Open customer deliverables</small></div><b>→</b><% end %>
</aside>
</div>
