<% page_title "Clients" %>

<div class="page-intro">
  <div>
    <span class="eyebrow">Customer directory</span>
    <h2>Clients</h2>
    <p>Customer records, contact details, and current lifecycle stage.</p>
  </div>
  <% if current_portal_user&.can_manage_client_access? && @project_id %>
    <%= link_to new_client_path(project_id: @project_id), class: "btn btn-primary" do %>
      <%= icon :plus %>
      Add client
    <% end %>
  <% end %>
</div>

<%= form_with url: clients_path, method: :get, local: true, class: "filter-bar" do |form| %>
  <div class="filter-control">
    <%= form.label :project_id, "Project" %>
    <%= form.select :project_id, @projects.map { |project| [project["name"], project["id"]] }, { selected: @project_id }, { onchange: "this.form.submit()" } %>
  </div>
  <div class="filter-context"><span>Directory</span><strong><%= pluralize(@clients.size, "client") %></strong></div>
<% end %>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">All clients</h2>
    <span class="page-intro-badge"><%= pluralize(@clients.size, "record") %></span>
  </div>

  <% if @clients.any? %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Company</th>
            <th>Email</th>
            <th>Stage</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @clients.each do |client| %>
            <tr>
              <td><%= link_to client["name"], client_path(client["id"], project_id: @project_id) %></td>
              <td><%= client["company"].presence || "—" %></td>
              <td><%= client["email"].presence || "—" %></td>
              <td><%= status_badge(client["lifecycle_stage"]) %></td>
              <td>
                <%= link_to "View", client_path(client["id"], project_id: @project_id), class: "btn btn-sm btn-secondary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-title">No clients yet</div>
      <p>This project doesn't have any clients. Add your first client to get started.</p>
      <% if current_portal_user&.can_manage_client_access? && @project_id %>
        <div class="empty-state-actions">
          <%= link_to "Add client", new_client_path(project_id: @project_id), class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
