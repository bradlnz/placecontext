<% page_title "Clients" %>

<div class="page-header">
  <div>
    <div class="breadcrumbs">
      <%= link_to "Dashboard", root_path %> · Clients
    </div>
  </div>
  <% if current_portal_user.manager? && @project_id %>
    <%= link_to new_client_path(project_id: @project_id), class: "btn btn-primary" do %>
      <%= icon :plus %>
      Add client
    <% end %>
  <% end %>
</div>

<%= form_with url: clients_path, method: :get, local: true, class: "project-selector" do |form| %>
  <%= form.label :project_id, "CRM project" %>
  <%= form.select :project_id, @projects.map { |project| [project["name"], project["id"]] }, { selected: @project_id }, { onchange: "this.form.submit()" } %>
<% end %>

<div class="card">
  <div class="card-header">
    <h2 class="card-title">All clients</h2>
    <span class="card-subtitle"><%= pluralize(@clients.size, "client") %> in this project</span>
  </div>

  <% if @clients.any? %>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Company</th>
            <th>Email</th>
            <th>Stage</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @clients.each do |client| %>
            <tr>
              <td><%= link_to client["name"], client_path(client["id"], project_id: @project_id) %></td>
              <td><%= client["company"].presence || "—" %></td>
              <td><%= client["email"].presence || "—" %></td>
              <td><%= status_badge(client["lifecycleStage"]) %></td>
              <td>
                <%= link_to "View", client_path(client["id"], project_id: @project_id), class: "btn btn-sm btn-secondary" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="empty-state">
      <div class="empty-state-title">No clients yet</div>
      <p>This project doesn't have any clients. Add your first client to get started.</p>
      <% if current_portal_user.manager? && @project_id %>
        <div style="margin-top: 16px;">
          <%= link_to "Add client", new_client_path(project_id: @project_id), class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
