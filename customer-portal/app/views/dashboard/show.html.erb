<% page_title "Dashboard" %>

<section class="welcome-panel">
  <div class="welcome-copy">
    <span class="eyebrow">Your shared workspace</span>
    <h2>Good to see you, <%= current_portal_user.email.split("@").first.titleize %>.</h2>
    <p>Track your work, run the automations assigned by your PlaceContext team, and collect every output in one place.</p>
    <div class="welcome-actions">
      <%= link_to automations_path(client_id: @client&.dig("id")), class: "btn btn-primary btn-lg" do %>
        <%= icon :automations %> Browse automations
      <% end %>
      <%= link_to artifacts_path(client_id: @client&.dig("id")), class: "btn btn-quiet btn-lg" do %>
        View artifacts <span aria-hidden="true">→</span>
      <% end %>
    </div>
  </div>
  <div class="welcome-orbit" aria-hidden="true">
    <div class="orbit-card orbit-card-one"><%= icon :automations %><span>Automate</span></div>
    <div class="orbit-card orbit-card-two"><%= icon :artifacts %><span>Deliver</span></div>
    <div class="orbit-core"><span></span></div>
  </div>
</section>

<div class="stats-grid stats-grid-four">
  <%= link_to clients_path, class: "stat-card stat-card-link" do %>
    <div class="stat-icon stat-icon-blue"><%= icon :clients %></div>
    <div><div class="stat-value"><%= @clients_count %></div><div class="stat-label">Clients</div></div>
    <span class="stat-arrow">→</span>
  <% end %>
  <%= link_to leads_path, class: "stat-card stat-card-link" do %>
    <div class="stat-icon stat-icon-amber"><%= icon :leads %></div>
    <div><div class="stat-value"><%= @leads_count %></div><div class="stat-label">Open leads</div></div>
    <span class="stat-arrow">→</span>
  <% end %>
  <%= link_to automations_path(client_id: @client&.dig("id")), class: "stat-card stat-card-link" do %>
    <div class="stat-icon stat-icon-purple"><%= icon :automations %></div>
    <div><div class="stat-value"><%= @automations_count %></div><div class="stat-label">Assigned automations</div></div>
    <span class="stat-arrow">→</span>
  <% end %>
  <%= link_to artifacts_path(client_id: @client&.dig("id")), class: "stat-card stat-card-link" do %>
    <div class="stat-icon stat-icon-green"><%= icon :artifacts %></div>
    <div><div class="stat-value"><%= @artifacts_count %></div><div class="stat-label">Artifacts</div></div>
    <span class="stat-arrow">→</span>
  <% end %>
</div>

<section class="dashboard-grid">
  <div class="card card-flush">
    <div class="card-header card-header-padded">
      <div>
        <span class="eyebrow">Get things done</span>
        <h2 class="card-title card-title-lg">Your workspace</h2>
      </div>
    </div>
    <div class="workspace-list">
      <%= link_to automations_path(client_id: @client&.dig("id")), class: "workspace-row" do %>
        <span class="workspace-row-icon stat-icon-purple"><%= icon :automations %></span>
        <span class="workspace-row-copy"><strong>Run an automation</strong><small>Launch a workflow enabled for your customer account.</small></span>
        <span class="workspace-row-action">Open →</span>
      <% end %>
      <%= link_to artifacts_path(client_id: @client&.dig("id")), class: "workspace-row" do %>
        <span class="workspace-row-icon stat-icon-green"><%= icon :artifacts %></span>
        <span class="workspace-row-copy"><strong>Review deliverables</strong><small>Open reports, documents, and data from completed work.</small></span>
        <span class="workspace-row-action">Open →</span>
      <% end %>
      <%= link_to clients_path, class: "workspace-row" do %>
        <span class="workspace-row-icon stat-icon-blue"><%= icon :clients %></span>
        <span class="workspace-row-copy"><strong>Customer details</strong><small>Keep contact and project information up to date.</small></span>
        <span class="workspace-row-action">Open →</span>
      <% end %>
    </div>
  </div>

  <aside class="card workspace-health">
    <div class="health-icon"><span></span></div>
    <span class="eyebrow">Workspace status</span>
    <h2 class="card-title card-title-lg">Everything is connected</h2>
    <p>Your portal is synced with PlaceContext. Automation access and artifacts are managed securely for each customer.</p>
    <div class="health-row"><span>PlaceContext connection</span><strong><i></i> Online</strong></div>
    <div class="health-row"><span>Customer access</span><strong>Scoped</strong></div>
  </aside>
</section>
