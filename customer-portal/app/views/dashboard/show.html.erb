<% page_title "Dashboard" %>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-label">Total Clients</div>
    <div class="stat-value"><%= @clients_count %></div>
    <%= link_to "View clients", clients_path, class: "stat-link" %>
  </div>

  <div class="stat-card">
    <div class="stat-label">Leads</div>
    <div class="stat-value"><%= @leads_count %></div>
    <%= link_to "View leads", leads_path, class: "stat-link" %>
  </div>

  <div class="stat-card">
    <div class="stat-label">Automations</div>
    <div class="stat-value"><%= @automations_count %></div>
    <%= link_to "View automations", automations_path, class: "stat-link" %>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <h2 class="card-title">Welcome back</h2>
      <p class="card-subtitle">Manage your workspace, clients, leads, and automations from one place.</p>
    </div>
  </div>

  <div class="automation-grid" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));">
    <%= link_to clients_path, class: "automation-card" do %>
      <h3 class="automation-card-title">Clients</h3>
      <p class="automation-card-desc">View and manage all your clients and their lifecycle stages.</p>
      <span class="automation-card-meta">Go to clients →</span>
    <% end %>

    <%= link_to leads_path, class: "automation-card" do %>
      <h3 class="automation-card-title">Leads</h3>
      <p class="automation-card-desc">Track prospects and follow up on open opportunities.</p>
      <span class="automation-card-meta">Go to leads →</span>
    <% end %>

    <%= link_to automations_path, class: "automation-card" do %>
      <h3 class="automation-card-title">Automations</h3>
      <p class="automation-card-desc">Run PlaceContext automations and review their results.</p>
      <span class="automation-card-meta">Go to automations →</span>
    <% end %>
  </div>
</div>
