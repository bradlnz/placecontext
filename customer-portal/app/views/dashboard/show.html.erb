<% page_title "Dashboard" %>

<section class="dashboard-intro">
  <div>
    <span class="dashboard-kicker">Home / Overview</span>
    <h2>Workspace overview</h2>
    <p>Clients, active work, and completed deliverables in one place.</p>
  </div>
  <%= link_to automations_path(client_id: @client&.dig("id")), class: "btn btn-primary" do %>
    <%= icon :plus %> Run automation
  <% end %>
</section>

<section class="dashboard-layout">
  <div class="work-list" aria-label="Workspace summary">
    <div class="work-list-columns" aria-hidden="true">
      <span>Name</span>
      <span>Items</span>
    </div>

    <section class="work-group">
      <header class="work-group-heading">
        <span class="work-group-toggle" aria-hidden="true">⌄</span>
        <span class="work-group-label work-group-label-green"><i>✓</i> Customers</span>
        <span class="work-group-count">2</span>
      </header>
      <%= link_to clients_path, class: "work-row" do %>
        <span class="work-row-status work-row-status-green">✓</span>
        <span class="work-row-copy"><strong>Client records</strong><small>Manage customer contacts and project details</small></span>
        <span class="work-row-value"><%= @clients_count %></span>
        <span class="work-row-arrow">›</span>
      <% end %>
      <%= link_to leads_path, class: "work-row" do %>
        <span class="work-row-status work-row-status-green">✓</span>
        <span class="work-row-copy"><strong>Open leads</strong><small>Review prospects that need attention</small></span>
        <span class="work-row-value"><%= @leads_count %></span>
        <span class="work-row-arrow">›</span>
      <% end %>
    </section>

    <section class="work-group">
      <header class="work-group-heading">
        <span class="work-group-toggle" aria-hidden="true">⌄</span>
        <span class="work-group-label work-group-label-blue"><i>◷</i> Delivery</span>
        <span class="work-group-count">2</span>
      </header>
      <%= link_to automations_path(client_id: @client&.dig("id")), class: "work-row" do %>
        <span class="work-row-status work-row-status-blue"><%= icon :automations %></span>
        <span class="work-row-copy"><strong>Assigned automations</strong><small>Workflows available for this account</small></span>
        <span class="work-row-value"><%= @automations_count %></span>
        <span class="work-row-arrow">›</span>
      <% end %>
      <%= link_to artifacts_path(client_id: @client&.dig("id")), class: "work-row" do %>
        <span class="work-row-status work-row-status-blue"><%= icon :artifacts %></span>
        <span class="work-row-copy"><strong>Artifacts</strong><small>Reports and files ready to review</small></span>
        <span class="work-row-value"><%= @artifacts_count %></span>
        <span class="work-row-arrow">›</span>
      <% end %>
      <%= link_to automations_path(client_id: @client&.dig("id")), class: "work-row work-row-add" do %>
        <span class="work-row-status">＋</span>
        <span class="work-row-copy"><strong>Start new work</strong></span>
      <% end %>
    </section>
  </div>

  <aside class="dashboard-side-panel">
    <section class="side-panel-section">
      <span class="side-panel-label">Workspace status</span>
      <div class="sync-status"><i></i><strong>Connected</strong></div>
      <p>Data and deliverables are synced with PlaceContext.</p>
    </section>
    <section class="side-panel-section">
      <div class="side-panel-heading">
        <span class="side-panel-label">Quick access</span>
      </div>
      <%= link_to automations_path(client_id: @client&.dig("id")), class: "quick-link" do %>
        <span class="quick-link-icon quick-link-purple"><%= icon :automations %></span>
        <span><strong>Automations</strong><small>Run assigned workflows</small></span>
        <b>›</b>
      <% end %>
      <%= link_to artifacts_path(client_id: @client&.dig("id")), class: "quick-link" do %>
        <span class="quick-link-icon quick-link-blue"><%= icon :artifacts %></span>
        <span><strong>Artifacts</strong><small>Open completed outputs</small></span>
        <b>›</b>
      <% end %>
    </section>
  </aside>
</section>
