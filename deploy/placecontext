#!/usr/bin/env bash
#
# placecontext — client operator CLI (shipped to customers).
#
#   placecontext              # launch the install/upgrade/connect TUI
#   placecontext install      # install (asks mode if interactive)
#   placecontext upgrade      # pull/apply newer package or git update
#   placecontext connect      # join an existing cluster
#   placecontext status|logs|url|doctor
#
# Build / package / k3d dev / mesh tooling lives in tools/pctl and is NOT delivered.
#
set -euo pipefail

SELF="${BASH_SOURCE[0]}"
while [ -L "$SELF" ]; do
  link="$(readlink "$SELF")"
  case "$link" in /*) SELF="$link";; *) SELF="$(dirname "$SELF")/$link";; esac
done
SELF="$(cd "$(dirname "$SELF")" && pwd)/$(basename "$SELF")"

# Installed layout: $PLACECONTEXT_HOME/{bin,lib,VERSION,BUCKET_URL}
# Dev layout: repo root with deploy/ + tools/
if [ -n "${PLACECONTEXT_HOME:-}" ] && [ -d "${PLACECONTEXT_HOME}/lib" ]; then
  ROOT="$PLACECONTEXT_HOME"
elif [ -d "$(cd "$(dirname "$SELF")/.." && pwd)/lib" ]; then
  ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
else
  ROOT="$(cd "$(dirname "$SELF")/.." && pwd)"
fi
cd "$ROOT" 2>/dev/null || true

PCTL_NAMESPACE="${PCTL_NAMESPACE:-placecontext}"
PCTL_CLUSTER="${PCTL_CLUSTER:-placecontext}"
PCTL_PORT="${PCTL_PORT:-7700}"
PCTL_IMAGE="${PCTL_IMAGE:-ghcr.io/bradlnz/placecontext:local}"
# Prefer assets under PLACECONTEXT_HOME/lib when present.
if [ -f "$ROOT/lib/placecontext-local.tar" ]; then
  PCTL_IMAGE_TAR="${PCTL_IMAGE_TAR:-$ROOT/lib/placecontext-local.tar}"
  K3S_DIR="${K3S_DIR:-$ROOT/lib/k3s}"
else
  PCTL_IMAGE_TAR="${PCTL_IMAGE_TAR:-deploy/placecontext-local.tar}"
  K3S_DIR="${K3S_DIR:-deploy/k3s}"
fi
PCTL_AGENTS="${PCTL_AGENTS:-2}"
BASE_URL="${PLACECONTEXT_BASE_URL:-${PLACECONTEXT_BUCKET_URL:-}}"
[ -z "$BASE_URL" ] && [ -f "$ROOT/BASE_URL" ] && BASE_URL="$(tr -d '[:space:]' < "$ROOT/BASE_URL")"
[ -z "$BASE_URL" ] && [ -f "$ROOT/BUCKET_URL" ] && BASE_URL="$(tr -d '[:space:]' < "$ROOT/BUCKET_URL")"
BASE_URL="${BASE_URL:-https://placecontext.syd1.cdn.digitaloceanspaces.com}"
KUBECTL="${PCTL_KUBECTL:-kubectl}"
# 0 = normal (step-by-step progress), 1 = -v (tool stdout), 2 = -vv (extra diagnostics)
VERBOSE="${PLACECONTEXT_VERBOSE:-${PCTL_VERBOSE:-0}}"
case "$VERBOSE" in true|yes|on) VERBOSE=1;; false|no|off|'') VERBOSE=0;; esac

if [ -t 1 ]; then
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_CYAN=$'\033[1;36m'; C_GREEN=$'\033[1;32m'; C_YELLOW=$'\033[1;33m'; C_RED=$'\033[1;31m'
else
  C_RESET=""; C_DIM=""; C_BOLD=""; C_CYAN=""; C_GREEN=""; C_YELLOW=""; C_RED=""
fi
say()  { printf '%s==>%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }
ok()   { printf '%s✓%s %s\n'  "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s!%s %s\n'  "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()  { printf '%s✗%s %s\n'  "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
# Secondary progress (always on — keeps long installs from looking stuck).
# stderr so helpers that print structured data on stdout (e.g. decode_join_code) stay clean.
info() { printf '    %s%s%s\n' "$C_DIM" "$*" "$C_RESET" >&2; }
# Verbose-only detail (-v / -vv / PLACECONTEXT_VERBOSE).
vlog() { [ "${VERBOSE:-0}" -ge 1 ] && printf '    %s·%s %s\n' "$C_DIM" "$C_RESET" "$*" >&2 || true; }
vvlog(){ [ "${VERBOSE:-0}" -ge 2 ] && printf '    %s··%s %s\n' "$C_DIM" "$C_RESET" "$*" >&2 || true; }
have() { command -v "$1" >/dev/null 2>&1; }
kube() { $KUBECTL "$@"; }

# Run a command; at -v stream its output, otherwise keep quiet (errors still surface via set -e).
run_quiet() {
  if [ "${VERBOSE:-0}" -ge 1 ]; then
    "$@"
  else
    "$@" >/dev/null
  fi
}

banner() {
  say "placecontext $( [ -f "$ROOT/VERSION" ] && tr -d '[:space:]' < "$ROOT/VERSION" || echo dev )"
  info "home     $ROOT"
  info "base     $BASE_URL"
  info "image    $PCTL_IMAGE"
  info "imageTar ${PCTL_IMAGE_TAR:-none}$( [ -s "${PCTL_IMAGE_TAR:-}" ] && echo " ($(du -h "$PCTL_IMAGE_TAR" | cut -f1))" || true )"
  info "k3s dir  ${K3S_DIR}"
  info "namespace $PCTL_NAMESPACE  cluster=$PCTL_CLUSTER  port=$PCTL_PORT"
  info "verbose  $VERBOSE  kubectl=$KUBECTL"
  vlog "uid=$(id -u) host=$(hostname 2>/dev/null || echo unknown) path=$PATH"
}

use_dev_kubeconfig() {
  local kcfg; kcfg="$(k3d kubeconfig write "$PCTL_CLUSTER" 2>/dev/null || true)"
  [ -n "$kcfg" ] || die "could not obtain kubeconfig for cluster '$PCTL_CLUSTER'"
  export KUBECONFIG="$kcfg"
  KUBECTL="kubectl --context k3d-$PCTL_CLUSTER"
}

# Resolve the Tailscale binary even under sudo (secure_path often omits /usr/local/bin).
tailscale_cmd() {
  if [ -n "${PLACECONTEXT_TAILSCALE:-}" ] && [ -x "${PLACECONTEXT_TAILSCALE}" ]; then
    printf '%s\n' "$PLACECONTEXT_TAILSCALE"
    return 0
  fi
  local c
  for c in tailscale /usr/bin/tailscale /usr/sbin/tailscale /usr/local/bin/tailscale \
           /opt/homebrew/bin/tailscale; do
    if [ -x "$c" ]; then printf '%s\n' "$c"; return 0; fi
    if command -v "$c" >/dev/null 2>&1; then command -v "$c"; return 0; fi
  done
  return 1
}

# This host's Tailscale IPv4 (100.x mesh), or empty if offline / not installed.
mesh_ipv4() {
  local ts ip
  ts="$(tailscale_cmd 2>/dev/null)" || return 1
  ip="$("$ts" ip -4 2>/dev/null | head -1 | tr -d '[:space:]')"
  [ -n "$ip" ] || return 1
  case "$ip" in
    100.*) printf '%s\n' "$ip"; return 0 ;;
  esac
  return 1
}

is_mesh_host() {
  case "$1" in
    100.*|fd7a:*|fd[0-9a-fA-F]*) return 0 ;;
    *) return 1 ;;
  esac
}

# Host part of https://IP:6443 or https://[v6]:6443
url_host() {
  printf '%s' "$1" | sed -E 's#^https?://##; s#/.*$##; s#:.*$##; s/^\[//; s/\]$//'
}

# Port part of https://host:port (default 6443).
url_port() {
  local s
  s="$(printf '%s' "$1" | sed -E 's#^https?://##; s#/.*$##')"
  case "$s" in
    \[*\]:*) printf '%s\n' "${s##*]:}";;
    *:*)     printf '%s\n' "${s##*:}";;
    *)       printf '6443\n';;
  esac
}

# Portable base64url (GNU + BSD / macOS). stdin → stdout.
b64url_encode() {
  local raw b64
  raw="$(cat)"
  # Prefer GNU -w0; on macOS/BSD base64 that flag fails — do not consume stdin twice.
  if b64="$(printf '%s' "$raw" | base64 -w0 2>/dev/null)"; then
    :
  else
    b64="$(printf '%s' "$raw" | base64 2>/dev/null | tr -d '\n\r')" || return 1
  fi
  # y### avoids '/' delimiter clash with base64 alphabet
  printf '%s' "$b64" | sed 'y#+/#-_#' | tr -d '=\n\r'
}

# Decode base64url string (arg) → stdout. Works on Linux and macOS.
b64url_decode() {
  local b64="$1" decoded
  b64="$(printf '%s' "$b64" | sed 'y#-_#+/#')"
  while [ $((${#b64} % 4)) -ne 0 ]; do b64="${b64}="; done
  if decoded="$(printf '%s' "$b64" | base64 -d 2>/dev/null)"; then
    printf '%s' "$decoded"; return 0
  fi
  if decoded="$(printf '%s' "$b64" | base64 -D 2>/dev/null)"; then
    printf '%s' "$decoded"; return 0
  fi
  if decoded="$(printf '%s' "$b64" | base64 --decode 2>/dev/null)"; then
    printf '%s' "$decoded"; return 0
  fi
  return 1
}

# Primary LAN IPv4 (Linux hostname -I, macOS en0/en1).
local_ipv4() {
  local ip
  ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  [ -n "$ip" ] && { printf '%s\n' "$ip"; return 0; }
  for iface in en0 en1 eth0; do
    ip="$(ipconfig getifaddr "$iface" 2>/dev/null || true)"
    [ -n "$ip" ] && { printf '%s\n' "$ip"; return 0; }
  done
  ip="$(ifconfig 2>/dev/null | awk '/inet / && $2 != "127.0.0.1" {print $2; exit}')"
  [ -n "$ip" ] && { printf '%s\n' "$ip"; return 0; }
  return 1
}

# Prefer mesh IP for join codes / server advertise. Use --local only for pure LAN tests.
resolve_advertise_ip() {
  local allow_local="${1:-0}"
  local ip
  if ip="$(mesh_ipv4)"; then
    info "advertise IP: ${ip} (Tailscale mesh)"
    printf '%s\n' "$ip"
    return 0
  fi
  if [ "$allow_local" = 1 ]; then
    ip="$(local_ipv4)" || return 1
    warn "No Tailscale IPv4 — using local IP ${ip} (LAN only; remote sites cannot reach this)"
    printf '%s\n' "$ip"
    return 0
  fi
  return 1
}

# ── k3d master support (macOS / Docker laptops as fleet control plane) ───────────────────────────
# Mac cannot run k3s natively; the master is k3d. Linux workers join over Tailscale when:
#   • API is published on 0.0.0.0:6443 (not 127.0.0.1-only)
#   • server TLS SAN includes the Tailscale mesh IP
#   • join code embeds https://MESH_IP:6443 + full node-token from the k3d server container

k3d_server_container() {
  local name="k3d-${PCTL_CLUSTER}-server-0"
  if have docker && docker inspect "$name" >/dev/null 2>&1; then
    printf '%s\n' "$name"
    return 0
  fi
  return 1
}

k3d_cluster_running() {
  have k3d || return 1
  k3d cluster list 2>/dev/null | grep -q "$PCTL_CLUSTER"
}

# Read k3s node-token from native k3s or the k3d server container (Mac/docker master).
resolve_node_token() {
  local tok="" c
  if [ -r /var/lib/rancher/k3s/server/node-token ]; then
    tok="$(tr -d '[:space:]' < /var/lib/rancher/k3s/server/node-token)"
    [ -n "$tok" ] && { printf '%s\n' "$tok"; return 0; }
  fi
  c="$(k3d_server_container 2>/dev/null || true)"
  if [ -n "$c" ]; then
    tok="$(docker exec "$c" cat /var/lib/rancher/k3s/server/node-token 2>/dev/null | tr -d '[:space:]')"
    [ -n "$tok" ] && { printf '%s\n' "$tok"; return 0; }
  fi
  return 1
}

# Host port where k3d publishes the Kubernetes API (empty if unknown).
k3d_api_host_port() {
  local c port
  c="$(k3d_server_container 2>/dev/null || true)"
  # Prefer serverlb mapping (k3d routes API through the load balancer).
  if have docker; then
    for name in "k3d-${PCTL_CLUSTER}-serverlb" "$c"; do
      [ -n "$name" ] || continue
      port="$(docker port "$name" 6443 2>/dev/null | head -1 | sed -E 's/.*://')"
      if [ -n "$port" ]; then
        printf '%s\n' "$port"
        return 0
      fi
    done
  fi
  # Fall back to kubeconfig server URL.
  if have k3d; then
    local url
    url="$(k3d kubeconfig get "$PCTL_CLUSTER" 2>/dev/null | awk '/server:/{print $2; exit}')"
    if [ -n "$url" ]; then
      url_port "$url"
      return 0
    fi
  fi
  return 1
}

# Whether the API mapping listens on all interfaces (remote join needs this).
k3d_api_is_public() {
  local c line
  c="$(k3d_server_container 2>/dev/null || true)"
  if have docker; then
    for name in "k3d-${PCTL_CLUSTER}-serverlb" "$c"; do
      [ -n "$name" ] || continue
      line="$(docker port "$name" 6443 2>/dev/null | head -1 || true)"
      case "$line" in
        0.0.0.0:*|\[::\]:*|*:*)
          case "$line" in
            127.0.0.1:*|\[::1\]:*) continue;;
            *) return 0;;
          esac
          ;;
      esac
    done
  fi
  return 1
}

# Ensure k3d server cert trusts the mesh (or LAN) IP used in join codes.
ensure_k3d_tls_san() {
  local mesh="${1:-}" c cfg_snip
  [ -n "$mesh" ] || return 0
  c="$(k3d_server_container 2>/dev/null || true)"
  [ -n "$c" ] || return 0
  if docker exec "$c" sh -c "grep -qE '^[[:space:]]*-[[:space:]]*${mesh}[[:space:]]*\$' /etc/rancher/k3s/config.yaml 2>/dev/null"; then
    info "k3d tls-san already includes ${mesh}"
    return 0
  fi
  say "Adding tls-san ${mesh} to k3d server (required for Mac→Linux join codes)…"
  docker exec "$c" sh -c "
    mkdir -p /etc/rancher/k3s
    if [ ! -f /etc/rancher/k3s/config.yaml ]; then
      printf 'tls-san:\\n  - %s\\n' '$mesh' > /etc/rancher/k3s/config.yaml
    elif grep -q '^tls-san:' /etc/rancher/k3s/config.yaml; then
      grep -qE '^[[:space:]]*-[[:space:]]*${mesh}[[:space:]]*\$' /etc/rancher/k3s/config.yaml \
        || printf '  - %s\\n' '$mesh' >> /etc/rancher/k3s/config.yaml
    else
      printf '\\ntls-san:\\n  - %s\\n' '$mesh' >> /etc/rancher/k3s/config.yaml
    fi
  " || warn "could not write k3d tls-san (join may fail TLS verify)"
  # Restart server so cert regenerates with the new SAN.
  docker restart "$c" >/dev/null 2>&1 || true
  info "waiting for k3d server after tls-san restart…"
  local i=0
  until docker exec "$c" kubectl get nodes >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -lt 45 ] || { warn "k3d server slow after restart — continue anyway"; break; }
    sleep 2
  done
}

# Args for `k3d cluster create` so a laptop master can hand out join codes to remote Linux workers.
k3d_create_join_args() {
  # Publish API on all interfaces:6443 so Tailscale peers reach the Mac/docker master.
  printf '%s\n' --api-port "0.0.0.0:6443"
  local mesh=""
  mesh="$(mesh_ipv4 2>/dev/null || true)"
  if [ -n "$mesh" ]; then
    printf '%s\n' --k3s-arg "--tls-san=${mesh}@server:*"
    info "k3d create will tls-san ${mesh} (Tailscale)"
  fi
}

image_import_k3s() {
  local tar="${PCTL_IMAGE_TAR:-}"
  [ -n "$tar" ] && [ -s "$tar" ] || { warn "no image tarball — skipping import."; return 0; }
  [ "$(id -u)" = 0 ] || die "importing the image needs root"
  say "Importing image from ${tar} ($(du -h "$tar" | cut -f1))…"
  info "k3s ctr -n k8s.io images import (this can take a minute)…"
  if [ "${VERBOSE:-0}" -ge 1 ]; then
    k3s ctr -n k8s.io images import "$tar"
  else
    k3s ctr -n k8s.io images import "$tar" >/dev/null
  fi
  ok "Image imported into containerd (k8s.io)."
}

ensure_secret() {
  # ensure_secret <name> --from-literal=k=v ...
  local name="$1"; shift
  if kube -n "$PCTL_NAMESPACE" get secret "$name" >/dev/null 2>&1; then
    info "secret ${name} already present — keeping existing values"
    return 0
  fi
  info "creating secret ${name}…"
  if [ "${VERBOSE:-0}" -ge 1 ]; then
    kube -n "$PCTL_NAMESPACE" create secret generic "$name" "$@" --dry-run=client -o yaml | kube apply -f -
  else
    kube -n "$PCTL_NAMESPACE" create secret generic "$name" "$@" --dry-run=client -o yaml | kube apply -f - >/dev/null
  fi
  ok "secret ${name} created"
}

# Publish k3s node-token (+ optional mesh API URL) so the portal can mint Tailscale join codes
# and promote a fleet master without root on the Host pod.
# Works for native k3s and k3d (Mac/docker master — token lives in the server container).
seed_cluster_join_secret() {
  local tok=""
  tok="$(resolve_node_token 2>/dev/null || true)"
  [ -n "$tok" ] || return 0

  # Prefer Tailscale mesh IP so portal join codes never embed a LAN-only address.
  local ip url="" api_port=6443
  ip="$(mesh_ipv4 2>/dev/null || true)"
  if k3d_cluster_running 2>/dev/null; then
    api_port="$(k3d_api_host_port 2>/dev/null || echo 6443)"
  fi
  if [ -z "$ip" ]; then
    warn "No Tailscale IPv4 when seeding join secret — skipping server-url (run join-code after Tailscale is up)"
  else
    url="https://${ip}:${api_port}"
  fi

  say "Seeding cluster join secret (for portal join codes)…"
  info "server-url=${url:-unset} (token length ${#tok})"
  # Always refresh so a Tailscale IP change after mesh join is picked up on next deploy.
  if [ "${VERBOSE:-0}" -ge 1 ]; then
    kube -n "$PCTL_NAMESPACE" create secret generic placecontext-cluster-join \
      --from-literal=node-token="$tok" \
      ${url:+--from-literal=server-url="$url"} \
      --dry-run=client -o yaml | kube apply -f -
  else
    kube -n "$PCTL_NAMESPACE" create secret generic placecontext-cluster-join \
      --from-literal=node-token="$tok" \
      ${url:+--from-literal=server-url="$url"} \
      --dry-run=client -o yaml | kube apply -f - >/dev/null
  fi
  ok "placecontext-cluster-join ready"
}

apply_manifests() {
  local image="$1"
  say "Deploying manifests (image=${image})…"
  # Prefer the full internal engine when developing from a source tree.
  if [ -x "$ROOT/tools/pctl" ]; then
    info "using tools/pctl deploy (source tree)"
    PCTL_IMAGE="$image" "$ROOT/tools/pctl" deploy --image "$image" || true
    return 0
  fi

  say "Namespace ${PCTL_NAMESPACE}…"
  if [ "${VERBOSE:-0}" -ge 1 ]; then
    kube create namespace "$PCTL_NAMESPACE" --dry-run=client -o yaml | kube apply -f -
  else
    kube create namespace "$PCTL_NAMESPACE" --dry-run=client -o yaml | kube apply -f - >/dev/null
  fi
  ok "namespace ready"

  say "Secrets…"
  local signing_key dp_key pg_pass minio_user minio_secret conn pem
  signing_key="$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  ensure_secret placecontext-portal --from-literal=signing-key="$signing_key"

  if ! kube -n "$PCTL_NAMESPACE" get secret placecontext-oauth >/dev/null 2>&1; then
    if have openssl; then
      pem="$(openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 2>/dev/null)"
      ensure_secret placecontext-oauth --from-literal=key.pem="$pem"
    else
      warn "openssl missing — OAuth signing key not created."
    fi
  else
    info "secret placecontext-oauth already present — keeping existing values"
  fi

  dp_key="$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  ensure_secret placecontext-dp --from-literal=key="$dp_key"

  pg_pass="$(openssl rand -hex 24 2>/dev/null || head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  conn="Host=placecontext-db;Port=5432;Database=placecontext;Username=postgres;Password=${pg_pass}"
  ensure_secret placecontext-db \
    --from-literal=password="$pg_pass" \
    --from-literal=connection-string="$conn"

  minio_user="pc$(openssl rand -hex 4 2>/dev/null || echo user)"
  minio_secret="$(openssl rand -hex 24 2>/dev/null || head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n')"
  ensure_secret placecontext-minio \
    --from-literal=ACCESS_KEY_ID="$minio_user" \
    --from-literal=ACCESS_SECRET_KEY="$minio_secret"

  # Seed join material for the Cluster page (promote master / add node over Tailscale).
  seed_cluster_join_secret

  [ -d "$K3S_DIR" ] || die "manifests not found at $K3S_DIR — reinstall placecontext"
  info "manifests from $K3S_DIR"

  say "PostgreSQL…"
  if [ -f "$K3S_DIR/postgres.yaml" ]; then
    run_quiet kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/postgres.yaml"
    ok "postgres applied"
  else
    warn "postgres.yaml missing"
  fi
  say "Object store (MinIO)…"
  if [ -f "$K3S_DIR/minio.yaml" ]; then
    run_quiet kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/minio.yaml"
    ok "minio applied"
  fi
  if [ -f "$K3S_DIR/pg-backup.yaml" ]; then
    info "applying pg-backup cron…"
    run_quiet kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/pg-backup.yaml"
  fi
  say "PlaceContext Host…"
  if [ -f "$K3S_DIR/placecontext.yaml" ]; then
    if [ "${VERBOSE:-0}" -ge 1 ]; then
      sed -e "s|__IMAGE__|${image}|g" -e "s|__NAMESPACE__|${PCTL_NAMESPACE}|g" \
        "$K3S_DIR/placecontext.yaml" | kube -n "$PCTL_NAMESPACE" apply -f -
    else
      sed -e "s|__IMAGE__|${image}|g" -e "s|__NAMESPACE__|${PCTL_NAMESPACE}|g" \
        "$K3S_DIR/placecontext.yaml" | kube -n "$PCTL_NAMESPACE" apply -f - >/dev/null
    fi
    ok "host deployment applied (image=${image})"
  else
    die "placecontext.yaml missing under $K3S_DIR"
  fi
  info "workloads now:"
  kube -n "$PCTL_NAMESPACE" get pods -o wide 2>/dev/null || true
}

wait_rollout() {
  say "Waiting for deploy/placecontext rollout (up to 5m)…"
  if kube -n "$PCTL_NAMESPACE" rollout status deploy/placecontext --timeout=300s; then
    ok "rollout complete"
  else
    warn "rollout did not finish cleanly — current pods:"
    kube -n "$PCTL_NAMESPACE" get pods -o wide 2>/dev/null || true
    kube -n "$PCTL_NAMESPACE" describe deploy/placecontext 2>/dev/null | tail -40 || true
  fi
}

# Portal base URL for post-install admin setup (k3s Traefik :80, k3d often :7700).
portal_base() {
  printf '%s' "${PLACECONTEXT_PORTAL_URL:-http://127.0.0.1:${PCTL_PORT}}"
}

wait_for_portal() {
  local base; base="$(portal_base)"
  say "Waiting for the portal at ${base}…"
  local i=0 code
  while [ "$i" -lt 90 ]; do
    if curl -fsS --max-time 3 "${base}/healthz" >/dev/null 2>&1 \
      || curl -fsS --max-time 3 "${base}/auth/setup/status" >/dev/null 2>&1; then
      ok "Portal is up (${base})"
      return 0
    fi
    i=$((i + 1))
    if [ $((i % 5)) -eq 0 ]; then
      code="$(curl -sS -o /dev/null -w '%{http_code}' --max-time 2 "${base}/" 2>/dev/null || echo 000)"
      info "still waiting… (${i}/90) http=${code}"
      vlog "pods: $(kube -n "$PCTL_NAMESPACE" get pods --no-headers 2>/dev/null | tr '\n' '; ' || echo n/a)"
    fi
    sleep 2
  done
  warn "Portal did not become ready in time — you can finish admin setup at ${base}/setup"
  return 1
}

# Prompt (or use env) for the default Owner admin after a fresh install.
# Env (non-interactive / Terraform): PLACECONTEXT_ADMIN_EMAIL, PLACECONTEXT_ADMIN_PASSWORD,
# optional PLACECONTEXT_ADMIN_NAME. Confirm password only when prompting.
setup_default_admin() {
  local base; base="$(portal_base)"
  wait_for_portal || return 0

  local status_json needs
  status_json="$(curl -fsS --max-time 5 "${base}/auth/setup/status" 2>/dev/null || true)"
  needs="$(printf '%s' "$status_json" | sed -n 's/.*"needsAdmin"[[:space:]]*:[[:space:]]*\(true\|false\).*/\1/p' | head -1)"
  if [ "$needs" = "false" ]; then
    ok "Admin already configured — skipping setup."
    return 0
  fi

  local email name pass confirm
  email="${PLACECONTEXT_ADMIN_EMAIL:-}"
  name="${PLACECONTEXT_ADMIN_NAME:-}"
  pass="${PLACECONTEXT_ADMIN_PASSWORD:-}"

  if [ -z "$email" ] || [ -z "$pass" ]; then
    if [ ! -t 0 ]; then
      warn "No admin credentials supplied (non-interactive). Open ${base}/setup to create the default admin."
      return 0
    fi
    printf '\n%sSet up the default admin account%s\n' "$C_BOLD" "$C_RESET"
    printf 'This is the Owner login for the portal (email + password).\n\n'
    while [ -z "$email" ]; do
      printf '%semail: %s' "$C_BOLD" "$C_RESET"; read -r email
      case "$email" in *@*) ;; *) email=""; warn "Enter a valid email address.";; esac
    done
    printf '%sdisplay name (optional): %s' "$C_BOLD" "$C_RESET"; read -r name
    while :; do
      printf '%spassword (min 12 chars): %s' "$C_BOLD" "$C_RESET"; read -rs pass; printf '\n'
      printf '%sconfirm password: %s' "$C_BOLD" "$C_RESET"; read -rs confirm; printf '\n'
      if [ "${#pass}" -lt 12 ]; then warn "Password must be at least 12 characters."; continue; fi
      if [ "$pass" != "$confirm" ]; then warn "Passwords do not match."; continue; fi
      break
    done
  fi
  [ -n "$name" ] || name="${email%%@*}"

  say "Creating admin…"
  # JSON via python when available (safe escaping); else crude escape.
  local body code
  if have python3; then
    body="$(ADMIN_EMAIL="$email" ADMIN_NAME="$name" ADMIN_PASS="$pass" python3 - <<'PY'
import json, os
print(json.dumps({
  "email": os.environ["ADMIN_EMAIL"],
  "displayName": os.environ.get("ADMIN_NAME") or "",
  "password": os.environ["ADMIN_PASS"],
  "confirmPassword": os.environ["ADMIN_PASS"],
}))
PY
)"
  else
    body="$(printf '{"email":"%s","displayName":"%s","password":"%s","confirmPassword":"%s"}' \
      "${email//\"/\\\"}" "${name//\"/\\\"}" "${pass//\"/\\\"}" "${pass//\"/\\\"}")"
  fi

  code="$(curl -sS -o /tmp/pc-setup-out.$$ -w '%{http_code}' --max-time 30 \
    -X POST "${base}/auth/setup/cli" \
    -H 'Content-Type: application/json' \
    -d "$body" 2>/dev/null || echo 000)"
  local resp; resp="$(cat /tmp/pc-setup-out.$$ 2>/dev/null || true)"; rm -f /tmp/pc-setup-out.$$

  case "$code" in
    200) ok "Admin created: $email — sign in at ${base}/login";;
    409) ok "Admin already configured.";;
    *)
      warn "Could not create admin (HTTP ${code}). ${resp:-Open ${base}/setup in a browser.}"
      ;;
  esac
}

# Ensure k3s server cert accepts the mesh IP (required for DO → Mac joins via Tailscale).
ensure_k3s_tls_san() {
  local mesh="${1:-}"
  [ -n "$mesh" ] || return 0
  local cfg="/etc/rancher/k3s/config.yaml"
  mkdir -p /etc/rancher/k3s
  if [ -f "$cfg" ] && grep -qE "^\s*-\s*${mesh}\s*$" "$cfg" 2>/dev/null; then
    info "tls-san already includes ${mesh}"
    return 0
  fi
  # Merge tls-san into config (idempotent-ish append).
  if [ ! -f "$cfg" ]; then
    printf 'tls-san:\n  - %s\n' "$mesh" >"$cfg"
  elif grep -q '^tls-san:' "$cfg" 2>/dev/null; then
    grep -qE "^\s*-\s*${mesh}\s*$" "$cfg" || printf '  - %s\n' "$mesh" >>"$cfg"
  else
    printf '\ntls-san:\n  - %s\n' "$mesh" >>"$cfg"
  fi
  info "added tls-san ${mesh} — restarting k3s to reload certs…"
  systemctl restart k3s 2>/dev/null || true
}

# Install k3s as a systemd service, import the bundled image, deploy PlaceContext.
install_service() {
  [ "$(id -u)" = 0 ] || die "service install needs root (sudo)"
  banner
  local mesh=""
  mesh="$(mesh_ipv4 2>/dev/null || true)"
  [ -n "$mesh" ] && info "Tailscale mesh IP detected: ${mesh}"

  say "Installing k3s (systemd)…"
  local -a server_args=(server)
  if [ -n "$mesh" ]; then
    # Advertise/SAN the mesh IP so join codes using https://100.x.x.x:6443 validate TLS.
    server_args+=(--tls-san="$mesh")
  fi
  if have k3s; then
    ok "k3s already installed ($(k3s --version 2>/dev/null | head -1 || echo present))"
    ensure_k3s_tls_san "$mesh"
  else
    info "downloading https://get.k3s.io …"
    info "k3s ${server_args[*]}"
    curl -sfL https://get.k3s.io | sh -s - "${server_args[@]}"
    ok "k3s installed"
    ensure_k3s_tls_san "$mesh"
  fi
  info "enabling k3s unit…"
  systemctl enable --now k3s
  export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
  KUBECTL="k3s kubectl"
  say "Waiting for the control plane…"
  local i=0
  until kube get nodes >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -lt 90 ] || die "k3s control plane did not become ready"
    [ $((i % 5)) -eq 0 ] && info "waiting for API… (${i}/90)"
    sleep 2
  done
  ok "k3s ready"
  info "nodes:"
  kube get nodes -o wide 2>/dev/null || true
  image_import_k3s
  apply_manifests "$PCTL_IMAGE"
  wait_rollout
  # Ensure the cluster comes back on reboot (k3s unit is already enabled above).
  systemctl is-enabled k3s >/dev/null 2>&1 || systemctl enable k3s
  ok "PlaceContext installed (k3s + systemd). Portal: $(portal_base)/"
  setup_default_admin
}

cmd_doctor() {
  say "Checking tooling…"
  if have kubectl; then
    ok "kubectl  $(kubectl version --client -o yaml 2>/dev/null | awk '/gitVersion:/{print $2; exit}' || kubectl version --client 2>/dev/null | head -1)"
  else
    warn "kubectl missing"
  fi
  if have docker; then
    ok "docker   $(docker version --format '{{.Client.Version}} / server {{.Server.Version}}' 2>/dev/null || echo present)"
  else
    warn "docker missing (needed for --docker install)"
  fi
  if have k3d; then
    ok "k3d      $(k3d version 2>/dev/null | head -1 || echo present)"
  else
    warn "k3d missing (needed for --docker install)"
  fi
  if have k3s; then
    ok "k3s      $(k3s --version 2>/dev/null | head -1 || echo present)"
  else
    info "k3s — not installed (only for --service)"
  fi
  have openssl && ok "openssl  $(openssl version 2>/dev/null | head -1)" || warn "openssl missing"
  have curl && ok "curl     $(curl --version 2>/dev/null | head -1)" || warn "curl missing"
  have tailscale && ok "tailscale $(tailscale version 2>/dev/null | head -1)" || info "tailscale — not installed (optional; mesh joins)"
  info "PLACECONTEXT_HOME=${PLACECONTEXT_HOME:-$ROOT}"
  info "BASE_URL=${BASE_URL}"
  info "PCTL_IMAGE_TAR=${PCTL_IMAGE_TAR:-} exists=$([ -s "${PCTL_IMAGE_TAR:-}" ] && echo yes || echo no)"
  info "K3S_DIR=${K3S_DIR} exists=$([ -d "${K3S_DIR:-}" ] && echo yes || echo no)"
  if k3d cluster list 2>/dev/null | grep -q "$PCTL_CLUSTER"; then
    ok "k3d cluster '${PCTL_CLUSTER}' present"
    vlog "$(k3d cluster list 2>/dev/null | tr '\n' ' ')"
  fi
  if kube get ns "$PCTL_NAMESPACE" >/dev/null 2>&1; then
    ok "namespace ${PCTL_NAMESPACE} reachable"
    info "pods:"
    kube -n "$PCTL_NAMESPACE" get pods -o wide 2>/dev/null || true
  else
    info "namespace ${PCTL_NAMESPACE} not reachable (no cluster or wrong kubeconfig)"
  fi
  ok "doctor complete"
}

cmd_install() {
  local mode=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --docker|--dev) mode=docker; shift;;
      --service|--prod) mode=service; shift;;
      -v|--verbose) VERBOSE=$((VERBOSE + 1)); export PLACECONTEXT_VERBOSE="$VERBOSE"; shift;;
      -vv) VERBOSE=2; export PLACECONTEXT_VERBOSE=2; shift;;
      *) die "install: unknown arg $1";;
    esac
  done
  if [ -z "$mode" ]; then
    if [ -t 0 ]; then
      printf '\n%sPlaceContext%s — how do you want to install?\n\n' "$C_BOLD" "$C_RESET"
      printf '  1) In Docker (k3d) — laptops / single machine\n'
      printf '  2) As a system service (k3s) — servers / fleet masters (sudo)\n\n'
      while :; do
        printf '%schoice [1-2]: %s' "$C_BOLD" "$C_RESET"; read -r pick
        case "$pick" in 1) mode=docker; break;; 2) mode=service; break;; *) warn "pick 1 or 2";; esac
      done
    else
      mode=docker
    fi
  fi

  banner
  say "Install mode: ${mode}"
  cmd_doctor
  if [ "$mode" = docker ]; then
    have docker || die "Docker is required for --docker install"
    have k3d || die "k3d is required — install k3d or re-run deploy/install.sh"
    have kubectl || die "kubectl is required"
    # Prefer full engine when developing from the source tree.
    if [ -x "$ROOT/tools/pctl" ]; then
      say "Bringing up local cluster via tools/pctl dev up…"
      "$ROOT/tools/pctl" dev up
      setup_default_admin
      return 0
    fi
    # Keep Traefik enabled — manifests expose the portal via Ingress on :80 (mapped to PCTL_PORT).
    # API on 0.0.0.0:6443 so Mac/docker masters can hand join codes to remote Linux k3s agents.
    say "Creating k3d cluster '$PCTL_CLUSTER' (agents=${PCTL_AGENTS}, port ${PCTL_PORT}→80, API :6443)…"
    info "k3d cluster create ${PCTL_CLUSTER} — first pull of k3s images can take several minutes"
    if k3d cluster list 2>/dev/null | grep -q "$PCTL_CLUSTER"; then
      info "cluster already exists — starting…"
      k3d cluster start "$PCTL_CLUSTER" || true
      if ! k3d_api_is_public; then
        warn "Existing k3d API is localhost-only — Mac→Linux join codes will not work until you recreate:
  k3d cluster delete ${PCTL_CLUSTER} && placecontext install --docker"
      fi
    else
      local -a k3d_extra=()
      # shellcheck disable=SC2207
      k3d_extra=($(k3d_create_join_args))
      k3d cluster create "$PCTL_CLUSTER" --agents "$PCTL_AGENTS" \
        --port "${PCTL_PORT}:80@loadbalancer" \
        "${k3d_extra[@]+"${k3d_extra[@]}"}" \
        --wait \
        || k3d cluster start "$PCTL_CLUSTER" || true
    fi
    ok "k3d cluster '${PCTL_CLUSTER}' available"
    use_dev_kubeconfig
    info "kubeconfig context k3d-${PCTL_CLUSTER}"
    kube get nodes -o wide 2>/dev/null || true
    local mesh=""
    mesh="$(mesh_ipv4 2>/dev/null || true)"
    [ -n "$mesh" ] && ensure_k3d_tls_san "$mesh"
    if [ -s "$PCTL_IMAGE_TAR" ]; then
      say "Importing image tarball ($(du -h "$PCTL_IMAGE_TAR" | cut -f1))…"
      if [ "${VERBOSE:-0}" -ge 1 ]; then
        k3d image import -c "$PCTL_CLUSTER" "$PCTL_IMAGE_TAR" || warn "image import failed"
      else
        k3d image import -c "$PCTL_CLUSTER" "$PCTL_IMAGE_TAR" || warn "image import failed"
      fi
      ok "image import finished (or skipped on error)"
    else
      warn "no image tarball at ${PCTL_IMAGE_TAR:-unset}"
    fi
    apply_manifests "$PCTL_IMAGE"
    wait_rollout
    seed_cluster_join_secret || true
    ok "Installed (Docker / k3d). Portal: $(portal_base)/"
    if k3d_api_is_public; then
      ok "k3d API published for remote joins (placecontext join-code → Linux workers)"
    fi
    setup_default_admin
  else
    if [ -x "$ROOT/tools/pctl" ] && [ "$(id -u)" = 0 ]; then
      say "Starting k3s server via tools/pctl server up…"
      "$ROOT/tools/pctl" server up
      setup_default_admin
      return 0
    fi
    if [ "$(id -u)" != 0 ]; then
      have sudo || die "--service needs root (sudo)"
      info "re-exec with sudo (preserving PLACECONTEXT_* / PCTL_* env)…"
      # Preserve admin env for non-interactive setup after elevation.
      exec sudo -E env \
        PLACECONTEXT_HOME="${PLACECONTEXT_HOME:-}" \
        PLACECONTEXT_PORTAL_URL="${PLACECONTEXT_PORTAL_URL:-}" \
        PLACECONTEXT_ADMIN_EMAIL="${PLACECONTEXT_ADMIN_EMAIL:-}" \
        PLACECONTEXT_ADMIN_NAME="${PLACECONTEXT_ADMIN_NAME:-}" \
        PLACECONTEXT_ADMIN_PASSWORD="${PLACECONTEXT_ADMIN_PASSWORD:-}" \
        PLACECONTEXT_VERBOSE="${VERBOSE}" \
        PCTL_IMAGE_TAR="${PCTL_IMAGE_TAR:-}" \
        K3S_DIR="${K3S_DIR:-}" \
        PATH="$PATH" \
        "$SELF" install --service $( [ "${VERBOSE:-0}" -ge 1 ] && printf '%s' '-v' )
    fi
    install_service
  fi
}

cmd_upgrade() {
  banner
  say "Upgrading PlaceContext…"
  local home="${PLACECONTEXT_HOME:-$HOME/.placecontext}"
  if have curl; then
    say "Downloading update from ${BASE_URL}…"
    info "curl install.sh | bash --no-launch --dir ${home}"
    curl -fsSL "${BASE_URL}/install.sh" | bash -s -- --no-launch --base "$BASE_URL" --dir "$home" \
      || die "upgrade failed"
    export PLACECONTEXT_HOME="$home"
    ROOT="$home"
    if [ -f "$home/lib/placecontext-local.tar" ]; then
      PCTL_IMAGE_TAR="$home/lib/placecontext-local.tar"
      K3S_DIR="$home/lib/k3s"
      info "refreshed assets: imageTar=$(du -h "$PCTL_IMAGE_TAR" | cut -f1) k3sDir=$K3S_DIR"
    fi
    info "version now: $(tr -d '[:space:]' < "$home/VERSION" 2>/dev/null || echo unknown)"
  elif [ -x "${ROOT}/tools/pctl" ] && [ -d "${ROOT}/.git" ]; then
    exec "${ROOT}/tools/pctl" update --deploy
  fi
  # Roll cluster with the new image/manifests when a cluster is present.
  if k3d cluster list 2>/dev/null | grep -q "$PCTL_CLUSTER"; then
    say "Rolling k3d cluster '${PCTL_CLUSTER}'…"
    use_dev_kubeconfig
    if [ -s "$PCTL_IMAGE_TAR" ]; then
      info "importing image…"
      k3d image import -c "$PCTL_CLUSTER" "$PCTL_IMAGE_TAR" || warn "image import failed"
    fi
    apply_manifests "$PCTL_IMAGE"
    wait_rollout
  elif kube get ns "$PCTL_NAMESPACE" >/dev/null 2>&1; then
    say "Rolling in-cluster deployment…"
    apply_manifests "$PCTL_IMAGE"
    wait_rollout
  else
    warn "No cluster found — CLI upgraded. Open the TUI and choose Install to bring a stack up."
  fi
  ok "Upgrade applied."
}

# Join this machine as a k3s agent to an existing master (no tools/pctl required).
# PC1.<b64url("url token")>  |  PC2.<b64url("url token [tskey]")>
# The server URL from the join code is used as-is — never rewritten to a local/LAN address.
agent_join() {
  local url="$1" token="$2" ts_key="${3:-}"
  [ -n "$url" ] && [ -n "$token" ] || die "agent join needs server URL and node token"
  [ "$(id -u)" = 0 ] || die "joining installs k3s agent — re-run with sudo (or use passwordless sudo)"

  # Normalize URL; refuse empty host.
  case "$url" in
    https://*|http://*) ;;
    *) url="https://${url}";;
  esac
  local server_host; server_host="$(url_host "$url")"
  [ -n "$server_host" ] || die "join code server URL has no host: $url"
  say "Join target (from join code): ${url}"
  info "server host=${server_host}  (will NOT substitute a local IP)"

  local -a exec_args=()
  if [ -n "$ts_key" ]; then
    say "Bringing up Tailscale via k3s --vpn-auth (embedded auth key)…"
    exec_args+=(--vpn-auth="name=tailscale,joinKey=${ts_key}")
  fi

  if is_mesh_host "$server_host"; then
    if [ ${#exec_args[@]} -eq 0 ]; then
      # Need Tailscale already up to reach a 100.x master.
      if ! mesh_ipv4 >/dev/null 2>&1; then
        die "server is on the Tailscale mesh (${server_host}), but this machine has no Tailscale IPv4
and the join code has no auth key.
  • Start Tailscale here, then re-run connect, or
  • Regenerate the join code with --ts-authkey KEY"
      fi
      ok "local mesh IP $(mesh_ipv4)"
    fi
  fi

  # Prefer this node's mesh address for kubelet ↔ API traffic when available.
  local my_mesh=""
  my_mesh="$(mesh_ipv4 2>/dev/null || true)"
  if [ -n "$my_mesh" ]; then
    exec_args+=(--node-ip="$my_mesh")
    info "agent --node-ip=${my_mesh}"
    if ip link show tailscale0 >/dev/null 2>&1; then
      exec_args+=(--flannel-iface=tailscale0)
      info "agent --flannel-iface=tailscale0"
    fi
  fi

  # After vpn-auth install, wait until the *coded* server host is reachable before declaring success.
  say "Installing k3s agent → ${url}…"
  info "K3S_URL=${url}  token length=${#token}  extra_args=${exec_args[*]:-none}"
  # Pass --server explicitly so the installer cannot invent another endpoint.
  # shellcheck disable=SC2086
  curl -sfL https://get.k3s.io | \
    K3S_URL="$url" \
    K3S_TOKEN="$token" \
    INSTALL_K3S_EXEC="agent --server ${url}" \
    sh -s - agent "${exec_args[@]+"${exec_args[@]}"}"
  ok "k3s agent installed (server=${url})"

  # Verify we are talking to the IP from the join code, not a rewritten local address.
  if [ -f /etc/systemd/system/k3s-agent.service ]; then
    local svc_url
    svc_url="$(grep -oE 'https://[^ ]+:6443' /etc/systemd/system/k3s-agent.service.env 2>/dev/null | head -1 || true)"
    [ -z "$svc_url" ] && svc_url="$(tr '\0' '\n' < /proc/$(pgrep -f 'k3s agent' | head -1)/environ 2>/dev/null | grep '^K3S_URL=' | cut -d= -f2- || true)"
    if [ -n "$svc_url" ] && [ "$svc_url" != "$url" ]; then
      warn "k3s agent K3S_URL is ${svc_url} (expected ${url}) — fixing service env…"
      mkdir -p /etc/systemd/system/k3s-agent.service.d
      printf '[Service]\nEnvironment=K3S_URL=%s\nEnvironment=K3S_TOKEN=%s\n' "$url" "$token" \
        > /etc/systemd/system/k3s-agent.service.d/10-placecontext-server.conf
      systemctl daemon-reload
      systemctl restart k3s-agent
    fi
  fi
  # Also pin via k3s config if present
  if [ -d /etc/rancher/k3s ]; then
    printf 'server: %s\n' "$url" > /etc/rancher/k3s/config.yaml.join-tmp 2>/dev/null || true
  fi

  say "Checking reachability of join-code host ${server_host}…"
  local i=0
  until curl -sk --connect-timeout 3 "${url}/ping" >/dev/null 2>&1 \
     || curl -sk --connect-timeout 3 "${url}/version" >/dev/null 2>&1 \
     || timeout 2 bash -c "echo >/dev/tcp/${server_host}/6443" 2>/dev/null; do
    i=$((i + 1))
    [ "$i" -lt 30 ] || warn "still cannot reach ${url} — check Tailscale on both sides"
    [ $((i % 5)) -eq 0 ] && info "waiting for ${server_host}:6443… (${i}/30)"
    sleep 2
    [ "$i" -ge 30 ] && break
  done
  [ "$i" -lt 30 ] && ok "API host ${server_host}:6443 is reachable"

  # Workers need the app image so jobs can schedule here.
  if [ -s "${PCTL_IMAGE_TAR:-}" ]; then
    image_import_k3s || warn "image import failed — import later with: sudo k3s ctr -n k8s.io images import ${PCTL_IMAGE_TAR}"
  else
    info "no local image tarball — master already has the image; jobs may pull or use shared import"
  fi

  export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
  KUBECTL="k3s kubectl"
  say "Waiting for this node to register with ${url}…"
  i=0
  until kube get nodes >/dev/null 2>&1; do
    i=$((i + 1))
    [ "$i" -lt 60 ] || { warn "API not ready yet — check: sudo systemctl status k3s-agent"; break; }
    [ $((i % 5)) -eq 0 ] && info "waiting for cluster API… (${i}/60)"
    sleep 2
  done
  kube get nodes -o wide 2>/dev/null || true
  ok "Worker joined ${url}"
}

# Decode PC1/PC2 join code → url, token, optional tskey (stdout: three fields).
# Tolerates whitespace/newlines from copy-paste (Mac Terminal wrap → Linux paste).
decode_join_code() {
  local code="$1"
  # Strip whitespace so multi-line paste still works.
  code="$(printf '%s' "$code" | tr -d '[:space:]')"
  case "$code" in PC1.*|PC2.*) ;; *) die "unrecognised join code (expected PC1.… or PC2.…)";; esac
  local b64="${code#PC?.}"
  local decoded
  decoded="$(b64url_decode "$b64")" || die "join code is corrupted (base64 decode failed)"
  vvlog "join payload: ${decoded}"
  # Fields: url token [tskey] — token is K10…::server:… (no spaces); split on first two words carefully.
  local url token rest tskey
  url="${decoded%% *}"
  rest="${decoded#"$url"}"
  rest="${rest# }"
  token="${rest%% *}"
  tskey="${rest#"$token"}"
  tskey="${tskey# }"
  [ -n "$url" ] && [ -n "$token" ] || die "join code is incomplete (need url + token)"
  # Validate URL embeds a host (IP or name) — this is the address we join, never replaced.
  local h; h="$(url_host "$url")"
  [ -n "$h" ] || die "join code URL missing host: $url"
  info "decoded join host=${h} port=$(url_port "$url")"
  printf '%s\n' "$url" "$token" "${tskey:-}"
}

cmd_connect() {
  local code="" force_url=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --code) code="$2"; shift 2;;
      --server-url) force_url="$2"; shift 2;; # override (debug); default is join-code URL only
      -v|--verbose) VERBOSE=$((VERBOSE + 1)); export PLACECONTEXT_VERBOSE="$VERBOSE"; shift;;
      *) die "connect: unknown arg $1 (usage: placecontext connect --code PC2.…)";;
    esac
  done
  [ -n "$code" ] || die "usage: placecontext connect --code PC1.…|PC2.…"
  banner
  say "Connecting with join code (${#code} chars, prefix ${code%%.*})…"

  local url token tskey
  {
    read -r url
    read -r token
    read -r tskey || true
  } < <(decode_join_code "$code")

  if [ -n "$force_url" ]; then
    warn "overriding join-code URL with --server-url ${force_url}"
    url="$force_url"
  fi

  info "server  ${url}  (host=$(url_host "$url"))"
  info "token   ${#token} chars"
  info "ts-key  $([ -n "${tskey:-}" ] && echo present || echo none)"

  if is_mesh_host "$(url_host "$url")"; then
    ok "join code points at Tailscale mesh address $(url_host "$url")"
  else
    warn "join code host $(url_host "$url") is not a Tailscale 100.x address — remote sites may be unreachable.
Regenerate on the master with Tailscale up: sudo placecontext join-code"
  fi

  if [ "$(id -u)" != 0 ]; then
    if sudo -n true 2>/dev/null; then
      say "Elevating with sudo to install k3s agent…"
      # Preserve PATH so tailscale is still found if it lives outside secure_path... use full env
      exec sudo -n -E env \
        PATH="/usr/local/bin:/usr/bin:/bin:${PATH}" \
        PLACECONTEXT_HOME="${PLACECONTEXT_HOME:-$ROOT}" \
        PLACECONTEXT_VERBOSE="${VERBOSE}" \
        PLACECONTEXT_TAILSCALE="$(tailscale_cmd 2>/dev/null || true)" \
        PCTL_IMAGE_TAR="${PCTL_IMAGE_TAR:-}" \
        K3S_DIR="${K3S_DIR:-}" \
        "$SELF" connect --code "$code" ${force_url:+--server-url "$force_url"} $( [ "${VERBOSE:-0}" -ge 1 ] && printf '%s' '-v' )
    fi
    die "joining installs k3s (needs root). Run:
  sudo env PATH=\"/usr/local/bin:/usr/bin:\$PATH\" PLACECONTEXT_HOME=${PLACECONTEXT_HOME:-$ROOT} $SELF connect --code '$code'"
  fi

  agent_join "$url" "$token" "${tskey:-}"
}

# Run on the master: print a join code for workers.
# Always embeds the Tailscale mesh IP when available (never a LAN IP unless --local).
# Supports native k3s (Linux) and k3d (macOS / Docker laptop masters) so Mac→Linux joins work.
cmd_join_code() {
  local ts_key="" allow_local=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --ts-authkey) ts_key="$2"; shift 2;;
      --local) allow_local=1; shift;;
      -v|--verbose) VERBOSE=$((VERBOSE + 1)); export PLACECONTEXT_VERBOSE="$VERBOSE"; shift;;
      *) die "join-code: unknown arg $1 (try: join-code [--ts-authkey KEY] [--local])";;
    esac
  done

  local tok
  if ! tok="$(resolve_node_token)"; then
    die "no k3s node-token found.
  • Linux master (k3s): run on the master after install --service (sudo).
  • Mac/docker master (k3d): install with --docker first (placecontext install --docker),
    then re-run join-code. Token is read from the k3d server container."
  fi
  info "node-token length ${#tok}"

  local ip
  if ! ip="$(resolve_advertise_ip "$allow_local")"; then
    die "No Tailscale IPv4 on this host — mesh join codes must use the Tailscale address.
  1) Install/start Tailscale and join the same tailnet as the worker
  2) Re-run:  placecontext join-code
  LAN-only test:   placecontext join-code --local"
  fi

  local api_port=6443
  if k3d_cluster_running 2>/dev/null; then
    # Mac / docker master: API lives in k3d — must be published for remote Linux agents.
    if ! k3d_api_is_public; then
      die "k3d API is only on localhost — remote Linux workers cannot reach this Mac.
Recreate the cluster so the API is public on :6443:

  k3d cluster delete ${PCTL_CLUSTER}
  placecontext install --docker

(New installs publish --api-port 0.0.0.0:6443 and tls-san the Tailscale IP.)"
    fi
    api_port="$(k3d_api_host_port 2>/dev/null || echo 6443)"
    [ -n "$api_port" ] || api_port=6443
    if is_mesh_host "$ip"; then
      ensure_k3d_tls_san "$ip"
    fi
    # Refresh portal join secret while we have the token.
    if kube get ns "$PCTL_NAMESPACE" >/dev/null 2>&1; then
      seed_cluster_join_secret || true
    fi
  else
    # Ensure API cert is valid for this mesh IP before handing out codes (native k3s).
    if [ "$(id -u)" = 0 ] && is_mesh_host "$ip"; then
      ensure_k3s_tls_san "$ip"
    fi
  fi

  if [ -z "$ts_key" ]; then
    warn "No --ts-authkey — joining machines must already be on the same tailnet to reach https://${ip}:${api_port}."
  else
    info "embedding Tailscale auth key in join code"
  fi

  # PC2.<base64url("https://MESH_IP:PORT token [tskey]")>
  local payload code
  payload="$(printf 'https://%s:%s %s %s' "$ip" "$api_port" "$tok" "$ts_key" | sed 's/ *$//')"
  code="PC2.$(printf '%s' "$payload" | b64url_encode)"

  printf '\n%sJoin code — master API is the mesh address below (not a LAN IP):%s\n\n' "$C_BOLD" "$C_RESET"
  printf '  server:  https://%s:%s\n' "$ip" "$api_port"
  printf '  code:    %s\n\n' "$code"
  printf 'On the new computer (Linux):\n'
  printf '  curl -fsSL https://get.placecontext.ai/install.sh | bash\n'
  printf '  sudo placecontext connect --code %s\n\n' "$code"
  if is_mesh_host "$ip"; then
    ok "join code uses Tailscale IP ${ip}:${api_port}"
  else
    warn "join code uses non-mesh IP ${ip}:${api_port} (--local)"
  fi
}

cmd_status() {
  if k3d cluster list 2>/dev/null | grep -q "$PCTL_CLUSTER"; then
    info "using k3d kubeconfig for '${PCTL_CLUSTER}'"
    use_dev_kubeconfig
  fi
  say "Nodes"
  kube get nodes -o wide 2>/dev/null || warn "no cluster"
  say "Workloads (ns=${PCTL_NAMESPACE})"
  kube -n "$PCTL_NAMESPACE" get pods,svc,ingress -o wide 2>/dev/null || true
  vlog "events (last 10):"
  [ "${VERBOSE:-0}" -ge 1 ] && kube -n "$PCTL_NAMESPACE" get events --sort-by=.lastTimestamp 2>/dev/null | tail -10 || true
}

cmd_logs() {
  local follow=""
  [ "${1:-}" = "-f" ] && follow="-f"
  if k3d cluster list 2>/dev/null | grep -q "$PCTL_CLUSTER"; then use_dev_kubeconfig; fi
  kube -n "$PCTL_NAMESPACE" logs $follow -l app=placecontext --tail=100
}

cmd_url() {
  printf '%sPortal + MCP:%s  http://localhost:%s/   (MCP at /mcp)\n' "$C_BOLD" "$C_RESET" "$PCTL_PORT"
}

cmd_tui() {
  local bin="$ROOT/deploy/tui/placecontext-tui"
  if [ ! -x "$bin" ]; then
    bin="$ROOT/deploy/tui/pctl-tui"
  fi
  if [ ! -x "$bin" ] && [ -d "$ROOT/deploy/tui" ] && have go; then
    say "Building operator TUI…"
    ( cd "$ROOT/deploy/tui" && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o placecontext-tui . ) \
      || die "TUI build failed"
    bin="$ROOT/deploy/tui/placecontext-tui"
  fi
  [ -x "$bin" ] || die "placecontext-tui not found — build with: make -C deploy/tui"
  PLACECONTEXT_BIN="$SELF" exec "$bin"
}

cmd_help() {
  cat <<EOF
placecontext — PlaceContext client operator

USAGE
  placecontext [-v|-vv] <command> …

  placecontext                 Launch the install / upgrade / connect TUI
  placecontext install [--docker|--service] [-v]
  placecontext upgrade [-v]
  placecontext connect --code CODE [-v]
  placecontext join-code [--ts-authkey KEY]   (on the master — print a join code)
  placecontext status | logs [-f] | url | doctor [-v]
  placecontext help

Install modes
  --docker    k3s-in-Docker (k3d) — laptops / single machines
  --service   k3s systemd — servers / fleet masters (sudo)

Connect (no tools/pctl required) — join code always uses the master's Tailscale IP
  On the master (Tailscale up):  sudo placecontext join-code
  On the new host:
    curl -fsSL https://get.placecontext.ai/install.sh | bash
    sudo placecontext connect --code PC2.…
  LAN-only test:  sudo placecontext join-code --local

Verbosity
  -v, --verbose   stream kubectl/k3d/import output; extra diagnostics
  -vv             more diagnostics (env, events)
  PLACECONTEXT_VERBOSE=1|2   same as -v / -vv

  Normal runs always print step progress (secrets, manifests, waits, pods).

After install, you are prompted for the default admin (Owner) account.
Non-interactive: set PLACECONTEXT_ADMIN_EMAIL and PLACECONTEXT_ADMIN_PASSWORD
(optional PLACECONTEXT_ADMIN_NAME).

Internal build/package tooling is not included. Developers use tools/pctl.
EOF
}

# Strip global flags (-v, -vv, --verbose) from "$@"; leave remaining args in GLOBAL_ARGS.
GLOBAL_ARGS=()
parse_global_flags() {
  GLOBAL_ARGS=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -v|--verbose) VERBOSE=$(( ${VERBOSE:-0} + 1 )); shift;;
      -vv) VERBOSE=2; shift;;
      --) shift; GLOBAL_ARGS+=("$@"); break;;
      *) GLOBAL_ARGS+=("$1"); shift;;
    esac
  done
  export PLACECONTEXT_VERBOSE="$VERBOSE"
}

main() {
  parse_global_flags "$@"
  if [ ${#GLOBAL_ARGS[@]} -gt 0 ]; then
    set -- "${GLOBAL_ARGS[@]}"
  else
    set --
  fi

  local cmd="${1:-}"
  if [ -z "$cmd" ]; then
    # Default: TUI when interactive, help otherwise.
    if [ -t 0 ] && [ -t 1 ]; then cmd_tui; else cmd_help; fi
    return
  fi
  shift || true
  vlog "command=${cmd} verbose=${VERBOSE} args=$*"
  case "$cmd" in
    install)   cmd_install "$@";;
    upgrade)   cmd_upgrade "$@";;
    connect)   cmd_connect "$@";;
    join-code) cmd_join_code "$@";;
    status)    cmd_status "$@";;
    logs)      cmd_logs "$@";;
    url)       cmd_url "$@";;
    doctor)    cmd_doctor "$@";;
    tui)       cmd_tui "$@";;
    help|-h|--help) cmd_help;;
    *) die "unknown command: $cmd (try: placecontext help)";;
  esac
}

main "$@"
