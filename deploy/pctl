#!/usr/bin/env bash
#
# pctl — PlaceContext control CLI.
#
# One tool to manage the whole lifecycle, on a laptop or across a fleet:
#
#   • Local dev cluster (k3d: k3s-in-Docker) — a real 1-server + 2-agent cluster on this box.
#   • Production cluster (k3s) — a server node plus worker nodes across multiple machines.
#   • Image build/import, manifest deploy, status, logs.
#
# It is self-contained (bash + the tools it orchestrates) and safe to re-run: every
# command is idempotent. Run `pctl help` for the command list, `pctl doctor` to check deps.
#
set -euo pipefail

# ── Config (override via environment) ────────────────────────────────────────────────────────────
PCTL_CLUSTER="${PCTL_CLUSTER:-placecontext}"          # k3d cluster name (dev)
PCTL_NAMESPACE="${PCTL_NAMESPACE:-placecontext}"       # kubernetes namespace
PCTL_IMAGE="${PCTL_IMAGE:-ghcr.io/bradlnz/placecontext:local}"
PCTL_IMAGE_TAR="${PCTL_IMAGE_TAR:-deploy/placecontext-local.tar}"
PCTL_PORT="${PCTL_PORT:-7700}"                         # host port → ingress :80 (dev)
PCTL_AGENTS="${PCTL_AGENTS:-2}"                         # dev worker nodes
PCTL_SERVERS="${PCTL_SERVERS:-1}"                       # dev server nodes
PCTL_DB_CONTAINERS="${PCTL_DB_CONTAINERS:-placecontext-db devcontext-db}"  # dev docker pg to clean

# Resolve repo root (this script lives in <root>/deploy).
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
K3S_DIR="deploy/k3s"

# ── Pretty output ────────────────────────────────────────────────────────────────────────────────
if [ -t 1 ]; then
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_CYAN=$'\033[1;36m'; C_GREEN=$'\033[1;32m'; C_YELLOW=$'\033[1;33m'; C_RED=$'\033[1;31m'
else
  C_RESET=""; C_DIM=""; C_BOLD=""; C_CYAN=""; C_GREEN=""; C_YELLOW=""; C_RED=""
fi
say()  { printf '%s==>%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }
ok()   { printf '%s✓%s %s\n'  "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s!%s %s\n'  "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()  { printf '%s✗%s %s\n'  "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# kubectl wrapper — honours PCTL_KUBECTL (e.g. set to "k3s kubectl" or a context flag).
KUBECTL="${PCTL_KUBECTL:-kubectl}"
kube() { $KUBECTL "$@"; }

# Point kubectl at the k3d cluster's own kubeconfig, isolated from any system-wide
# KUBECONFIG (e.g. a root-owned /etc/rancher/k3s/k3s.yaml from a prod k3s install).
use_dev_kubeconfig() {
  local kcfg; kcfg="$(k3d kubeconfig write "$PCTL_CLUSTER" 2>/dev/null)"
  [ -n "$kcfg" ] || die "could not obtain kubeconfig for cluster '$PCTL_CLUSTER'"
  export KUBECONFIG="$kcfg"
  KUBECTL="kubectl --context k3d-$PCTL_CLUSTER"
}

# Substitute manifest placeholders and apply.  $1=enforce(true|false)  $2=image
apply_manifests() {
  local enforce="$1" image="$2"
  say "Namespace + activation secret…"
  kube create namespace "$PCTL_NAMESPACE" --dry-run=client -o yaml | kube apply -f -
  # The deployment always references the activation secret; create a placeholder for dev.
  local key="${PCTL_ACTIVATION_KEY:-dev-local-unenforced}"
  kube -n "$PCTL_NAMESPACE" create secret generic placecontext-activation \
    --from-literal=key="$key" --dry-run=client -o yaml | kube apply -f -

  # HMAC key for portal sign-in tokens. Generated once and preserved across re-runs so the key the TUI
  # reads to mint tokens stays stable; only created if absent.
  if ! kube -n "$PCTL_NAMESPACE" get secret placecontext-portal >/dev/null 2>&1; then
    local signing_key
    signing_key="$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    kube -n "$PCTL_NAMESPACE" create secret generic placecontext-portal \
      --from-literal=signing-key="$signing_key" --dry-run=client -o yaml | kube apply -f -
  fi

  say "PostgreSQL (pgvector)…"
  kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/postgres.yaml"

  say "PlaceContext Host (image: $image, activation enforce: $enforce)…"
  sed -e "s|__IMAGE__|${image}|g" -e "s|__ENFORCE__|${enforce}|g" \
    "$K3S_DIR/placecontext.yaml" | kube -n "$PCTL_NAMESPACE" apply -f -
}

wait_rollout() {
  say "Waiting for rollout…"
  kube -n "$PCTL_NAMESPACE" rollout status deploy/placecontext-db --timeout=180s || true
  kube -n "$PCTL_NAMESPACE" rollout status deploy/placecontext --timeout=300s
}

# ── doctor ─────────────────────────────────────────────────────────────────────────────────────
cmd_doctor() {
  say "Checking dependencies…"
  local miss=0
  for t in docker k3d kubectl; do
    if have "$t"; then ok "$t — $(command -v "$t")"; else warn "$t — MISSING"; miss=1; fi
  done
  have k3s && ok "k3s — $(command -v k3s) (prod server/agent)" || printf '%s  k3s — not installed (only needed for prod nodes)%s\n' "$C_DIM" "$C_RESET"
  printf '%s  ~/.local/bin on PATH? %s%s\n' "$C_DIM" "$(case ":$PATH:" in *":$HOME/.local/bin:"*) echo yes;; *) echo no — add it;; esac)" "$C_RESET"
  [ "$miss" = 0 ] && ok "Core dev deps present." || die "Install the missing tools above (see README)."
}

# ── dev: local k3d cluster ─────────────────────────────────────────────────────────────────────
cmd_dev_clean() {
  have docker || { warn "docker not found — nothing to clean."; return 0; }
  say "Removing dev Docker Postgres containers + volumes…"
  for c in $PCTL_DB_CONTAINERS; do
    local vols; vols="$(docker inspect -f '{{range .Mounts}}{{if eq .Type "volume"}}{{.Name}} {{end}}{{end}}' "$c" 2>/dev/null || true)"
    docker rm -f "$c" >/dev/null 2>&1 && ok "removed container $c" || true
    for v in $vols; do docker volume rm "$v" >/dev/null 2>&1 && ok "removed volume $v" || true; done
  done
}

dev_cluster_exists() { k3d cluster list -o json 2>/dev/null | grep -q "\"name\":\"$PCTL_CLUSTER\""; }

cmd_dev_up() {
  local rebuild=0
  for a in "$@"; do [ "$a" = "--rebuild" ] && rebuild=1; done
  have k3d   || die "k3d not installed — run: pctl doctor"
  have docker|| die "docker is required for the k3d dev cluster."

  [ "$rebuild" = 1 ] && cmd_build
  cmd_dev_clean

  if dev_cluster_exists; then
    ok "k3d cluster '$PCTL_CLUSTER' already exists."
  else
    say "Creating k3d cluster '$PCTL_CLUSTER' ($PCTL_SERVERS server + $PCTL_AGENTS agents)…"
    k3d cluster create "$PCTL_CLUSTER" \
      --servers "$PCTL_SERVERS" --agents "$PCTL_AGENTS" \
      -p "${PCTL_PORT}:80@loadbalancer" \
      --wait
  fi

  use_dev_kubeconfig
  cmd_image_import
  apply_manifests "false" "$PCTL_IMAGE"
  wait_rollout
  ok "Dev cluster ready."
  cmd_url
}

cmd_dev_add_node() {
  local role="agent" name=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --role) role="$2"; shift 2;;
      --name) name="$2"; shift 2;;
      *) die "dev add-node: unknown arg $1";;
    esac
  done
  case "$role" in agent|server) ;; *) die "dev add-node: --role must be 'agent' or 'server'";; esac
  have k3d || die "k3d not installed — run: pctl doctor"
  dev_cluster_exists || die "no dev cluster '$PCTL_CLUSTER' — run: pctl dev up"
  # auto-name: pc-<role>-<n> using the current node count
  if [ -z "$name" ]; then
    local n; n="$(k3d node list -o json 2>/dev/null | grep -c "\"role\":\"$role\"" || echo 0)"
    name="pc-${role}-${n}"
  fi
  say "Adding $role node '$name' to cluster '$PCTL_CLUSTER'…"
  k3d node create "$name" --cluster "$PCTL_CLUSTER" --role "$role" --wait
  ok "Node '$name' joined."
}

cmd_dev_down() {
  have k3d || die "k3d not installed."
  if dev_cluster_exists; then
    say "Deleting k3d cluster '$PCTL_CLUSTER'…"
    k3d cluster delete "$PCTL_CLUSTER"
    ok "Deleted."
  else
    warn "No k3d cluster named '$PCTL_CLUSTER'."
  fi
}

cmd_image_import() {
  have k3d || die "k3d not installed."
  if [ -f "$PCTL_IMAGE_TAR" ]; then
    say "Importing image from $PCTL_IMAGE_TAR into '$PCTL_CLUSTER'…"
    k3d image import "$PCTL_IMAGE_TAR" -c "$PCTL_CLUSTER"
  else
    say "Importing image $PCTL_IMAGE into '$PCTL_CLUSTER'…"
    k3d image import "$PCTL_IMAGE" -c "$PCTL_CLUSTER"
  fi
  ok "Image available in cluster."
}

# ── kill (destructive — pod | node | job) ─────────────────────────────────────────────────────────
cmd_kill() {
  local kind="${1:-}"; shift || true
  local name="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1; shift;;
      -*) die "kill: unknown flag $1";;
      *) name="$1"; shift;;
    esac
  done
  case "$kind" in pod|node|job) ;; *) die "kill: kind must be 'pod', 'node', or 'job'";; esac
  [ -n "$name" ] || die "kill: need a name — pctl kill $kind <name>"

  if [ "$yes" != 1 ]; then
    printf '%s⚠  Really kill %s "%s"? This is destructive. [y/N] %s' "$C_YELLOW" "$kind" "$name" "$C_RESET"
    read -r ans
    case "$ans" in y|Y|yes|YES) ;; *) echo "aborted."; return 1;; esac
  fi

  case "$kind" in
    pod)
      resolve_ctx
      say "Deleting pod '$name' (its controller will reschedule it)…"
      kube -n "$PCTL_NAMESPACE" delete pod "$name"
      ;;
    node)
      have k3d || die "node kill currently supports k3d dev nodes only."
      say "Removing node '$name' from cluster '$PCTL_CLUSTER'…"
      k3d node delete "$name"
      ;;
    job)
      resolve_ctx
      local esc="${name//\'/\'\'}"   # escape single quotes for SQL
      say "Deleting job '$name' and its run history…"
      kube -n "$PCTL_NAMESPACE" exec deploy/placecontext-db -- psql -U postgres -d placecontext -c \
        "DELETE FROM job_runs WHERE \"JobId\" IN (SELECT \"Id\" FROM jobs WHERE \"Name\"='$esc'); \
         DELETE FROM job_triggers WHERE \"JobId\" IN (SELECT \"Id\" FROM jobs WHERE \"Name\"='$esc'); \
         DELETE FROM jobs WHERE \"Name\"='$esc';"
      ;;
  esac
  ok "Killed $kind '$name'."
}

# ── build ──────────────────────────────────────────────────────────────────────────────────────
cmd_build() {
  local tag="$PCTL_IMAGE"
  while [ $# -gt 0 ]; do case "$1" in --tag) tag="$2"; shift 2;; *) shift;; esac; done
  have docker || die "docker is required to build."
  say "Building image $tag…"
  docker build -t "$tag" .
  say "Exporting to $PCTL_IMAGE_TAR…"
  docker save "$tag" -o "$PCTL_IMAGE_TAR"
  ok "Built and saved."
}

# ── deploy (any current kube context) ────────────────────────────────────────────────────────────
cmd_deploy() {
  local enforce="true" image="$PCTL_IMAGE"
  while [ $# -gt 0 ]; do
    case "$1" in
      --enforce)        enforce="$2"; shift 2;;
      --image)          image="$2"; shift 2;;
      --activation-key) PCTL_ACTIVATION_KEY="$2"; shift 2;;
      --context)        KUBECTL="kubectl --context $2"; shift 2;;
      *) die "deploy: unknown arg $1";;
    esac
  done
  apply_manifests "$enforce" "$image"
  wait_rollout
  ok "Deployed."
}

# ── prod: k3s server / agent across machines ─────────────────────────────────────────────────────
cmd_server_up() {
  local key="" image="$PCTL_IMAGE"
  while [ $# -gt 0 ]; do
    case "$1" in
      --activation-key) key="$2"; shift 2;;
      --image)          image="$2"; shift 2;;
      *) die "server up: unknown arg $1";;
    esac
  done
  [ -n "$key" ] || die "server up needs --activation-key <KEY>"
  [ "$(id -u)" = 0 ] || die "server up installs a systemd service — run with sudo."

  say "Installing k3s (server)…"
  if have k3s; then ok "k3s already installed."; else curl -sfL https://get.k3s.io | sh -; fi
  KUBECTL="k3s kubectl"
  say "Waiting for the control plane…"
  until kube get nodes >/dev/null 2>&1; do sleep 2; done

  PCTL_ACTIVATION_KEY="$key"
  apply_manifests "true" "$image"
  wait_rollout
  ok "Server node up. PlaceContext deploying to namespace '$PCTL_NAMESPACE'."
  echo
  cmd_join_cmd
}

cmd_agent_join() {
  local url="" token=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --server-url) url="$2"; shift 2;;
      --node-token) token="$2"; shift 2;;
      *) die "agent join: unknown arg $1";;
    esac
  done
  [ -n "$url" ] && [ -n "$token" ] || die "agent join needs --server-url and --node-token"
  [ "$(id -u)" = 0 ] || die "agent join installs a systemd service — run with sudo."
  say "Joining this machine to $url as a worker…"
  curl -sfL https://get.k3s.io | K3S_URL="$url" K3S_TOKEN="$token" sh -
  ok "Worker joined."
}

cmd_join_cmd() {
  local tok_file="/var/lib/rancher/k3s/server/node-token"
  local ip; ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  local tok="<run on server: sudo cat $tok_file>"
  [ -r "$tok_file" ] && tok="$(cat "$tok_file")"
  printf '%sAdd a worker node — run on the other machine:%s\n' "$C_BOLD" "$C_RESET"
  printf '  sudo ./deploy/pctl agent join \\\n    --server-url https://%s:6443 \\\n    --node-token %s\n' "${ip:-<server-ip>}" "$tok"
}

# ── status / logs / url ──────────────────────────────────────────────────────────────────────────
resolve_ctx() {
  # For dev convenience, default to the k3d context if it exists and none was forced.
  if [ "$KUBECTL" = "kubectl" ] && have k3d && dev_cluster_exists; then
    use_dev_kubeconfig
  fi
}
cmd_status() {
  resolve_ctx
  say "Nodes:"; kube get nodes -o wide || die "no cluster reachable (is one up?)"
  echo; say "Workloads (ns: $PCTL_NAMESPACE):"
  kube -n "$PCTL_NAMESPACE" get deploy,pods,svc,ingress 2>/dev/null || warn "namespace not deployed yet"
}
cmd_logs() {
  resolve_ctx
  local follow=""; [ "${1:-}" = "-f" ] && follow="-f"
  kube -n "$PCTL_NAMESPACE" logs $follow -l app=placecontext --tail=100
}
cmd_url() {
  printf '%sPortal + MCP:%s  http://localhost:%s/   (MCP at /mcp)\n' "$C_BOLD" "$C_RESET" "$PCTL_PORT"
}

# Launch the reactive Go TUI dashboard (builds it on first run if needed).
cmd_tui() {
  local bin="deploy/tui/pctl-tui"
  if [ ! -x "$bin" ]; then
    have go || die "Go toolchain not found — install Go, then: make -C deploy/tui"
    say "Building the TUI (first run)…"
    ( cd deploy/tui && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o pctl-tui . ) || die "TUI build failed."
  fi
  PCTL_BIN="$ROOT/deploy/pctl" exec "$bin"
}

# ── help ─────────────────────────────────────────────────────────────────────────────────────────
cmd_help() {
  cat <<EOF
${C_BOLD}pctl${C_RESET} — PlaceContext control CLI

${C_BOLD}USAGE${C_RESET}
  pctl <command> [options]

${C_BOLD}LOCAL DEV${C_RESET} ${C_DIM}(k3d: a 1-server + ${PCTL_AGENTS}-agent k3s cluster on this machine)${C_RESET}
  dev up [--rebuild]     Clean dev Docker, create cluster, import image, deploy (activation off)
  dev down               Delete the local k3d cluster
  dev clean              Remove the dev Docker Postgres containers + volumes
  dev add-node [--role agent|server] [--name N]   Add a node to the dev cluster
  image import           (Re)import the local image into the dev cluster

${C_BOLD}PRODUCTION${C_RESET} ${C_DIM}(k3s across multiple machines)${C_RESET}
  server up --activation-key KEY [--image IMG]    Install k3s server here + deploy (sudo)
  agent join --server-url URL --node-token TOK    Join this machine as a worker (sudo)
  join-cmd                                        Print the worker-join command (run on server)

${C_BOLD}ANYWHERE${C_RESET}
  tui                    Launch the reactive full-screen dashboard (Go TUI)
  build [--tag TAG]      Build the container image and export it to the tarball
  deploy [--enforce true|false] [--image IMG] [--activation-key KEY] [--context CTX]
                         Apply the manifests to the current (or given) kube context
  kill pod|node|job NAME [--yes]   Delete a pod / k3d node / job (prompts unless --yes)
  status                 Show nodes + workloads
  logs [-f]              Tail the PlaceContext Host logs
  url                    Print the portal / MCP URL
  doctor                 Check required tools
  help                   This help

${C_BOLD}CONFIG${C_RESET} ${C_DIM}(environment overrides)${C_RESET}
  PCTL_CLUSTER=$PCTL_CLUSTER  PCTL_NAMESPACE=$PCTL_NAMESPACE  PCTL_PORT=$PCTL_PORT  PCTL_AGENTS=$PCTL_AGENTS
  PCTL_IMAGE=$PCTL_IMAGE
EOF
}

# ── dispatch ───────────────────────────────────────────────────────────────────────────────────
main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    dev)
      local sub="${1:-}"; shift || true
      case "$sub" in
        up)        cmd_dev_up "$@";;
        down)      cmd_dev_down "$@";;
        clean)     cmd_dev_clean "$@";;
        add-node)  cmd_dev_add_node "$@";;
        *) die "unknown 'dev' subcommand: '$sub' (try: up | down | clean | add-node)";;
      esac;;
    image)
      local sub="${1:-}"; shift || true
      case "$sub" in
        import) cmd_image_import "$@";;
        *) die "unknown 'image' subcommand: '$sub' (try: import)";;
      esac;;
    server)
      local sub="${1:-}"; shift || true
      case "$sub" in
        up) cmd_server_up "$@";;
        *) die "unknown 'server' subcommand: '$sub' (try: up)";;
      esac;;
    agent)
      local sub="${1:-}"; shift || true
      case "$sub" in
        join) cmd_agent_join "$@";;
        *) die "unknown 'agent' subcommand: '$sub' (try: join)";;
      esac;;
    kill)         cmd_kill "$@";;
    tui|ui)       cmd_tui "$@";;
    build)        cmd_build "$@";;
    deploy)       cmd_deploy "$@";;
    status)       cmd_status "$@";;
    logs)         cmd_logs "$@";;
    url)          cmd_url "$@";;
    join-cmd)     cmd_join_cmd "$@";;
    doctor)       cmd_doctor "$@";;
    help|-h|--help) cmd_help;;
    version|--version) echo "pctl 0.1.0";;
    *) warn "unknown command: $cmd"; echo; cmd_help; exit 2;;
  esac
}
main "$@"
