#!/usr/bin/env bash
#
# pctl — PlaceContext control CLI.
#
# One tool to manage the whole lifecycle, on a laptop or across a fleet:
#
#   • Local dev cluster (k3d: k3s-in-Docker) — a real 1-server + 2-agent cluster on this box.
#   • Production cluster (k3s) — a server node plus worker nodes across multiple machines.
#   • Image build/import, manifest deploy, status, logs.
#
# It is self-contained (bash + the tools it orchestrates) and safe to re-run: every
# command is idempotent. Run `pctl help` for the command list, `pctl doctor` to check deps.
#
set -euo pipefail

# ── Config (override via environment) ────────────────────────────────────────────────────────────
PCTL_CLUSTER="${PCTL_CLUSTER:-placecontext}"          # k3d cluster name (dev)
PCTL_NAMESPACE="${PCTL_NAMESPACE:-placecontext}"       # kubernetes namespace
PCTL_IMAGE="${PCTL_IMAGE:-ghcr.io/bradlnz/placecontext:local}"
PCTL_IMAGE_TAR="${PCTL_IMAGE_TAR:-deploy/placecontext-local.tar}"
PCTL_PORT="${PCTL_PORT:-7700}"                         # host port → ingress :80 (dev)
PCTL_AGENTS="${PCTL_AGENTS:-2}"                         # dev worker nodes
PCTL_SERVERS="${PCTL_SERVERS:-1}"                       # dev server nodes
PCTL_DB_CONTAINERS="${PCTL_DB_CONTAINERS:-placecontext-db devcontext-db}"  # dev docker pg to clean

# Resolve repo root (this script lives in <root>/deploy).
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
K3S_DIR="deploy/k3s"

# ── Pretty output ────────────────────────────────────────────────────────────────────────────────
if [ -t 1 ]; then
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_CYAN=$'\033[1;36m'; C_GREEN=$'\033[1;32m'; C_YELLOW=$'\033[1;33m'; C_RED=$'\033[1;31m'
else
  C_RESET=""; C_DIM=""; C_BOLD=""; C_CYAN=""; C_GREEN=""; C_YELLOW=""; C_RED=""
fi
say()  { printf '%s==>%s %s\n' "$C_CYAN" "$C_RESET" "$*"; }
ok()   { printf '%s✓%s %s\n'  "$C_GREEN" "$C_RESET" "$*"; }
warn() { printf '%s!%s %s\n'  "$C_YELLOW" "$C_RESET" "$*" >&2; }
die()  { printf '%s✗%s %s\n'  "$C_RED" "$C_RESET" "$*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

# kubectl wrapper — honours PCTL_KUBECTL (e.g. set to "k3s kubectl" or a context flag).
KUBECTL="${PCTL_KUBECTL:-kubectl}"
kube() { $KUBECTL "$@"; }

# Point kubectl at the k3d cluster's own kubeconfig, isolated from any system-wide
# KUBECONFIG (e.g. a root-owned /etc/rancher/k3s/k3s.yaml from a prod k3s install).
use_dev_kubeconfig() {
  # `|| true` so a k3d failure reaches the die below with a real message, instead of set -e
  # killing the script silently mid-substitution.
  local kcfg; kcfg="$(k3d kubeconfig write "$PCTL_CLUSTER" 2>/dev/null || true)"
  [ -n "$kcfg" ] || die "could not obtain kubeconfig for cluster '$PCTL_CLUSTER'"
  export KUBECONFIG="$kcfg"
  KUBECTL="kubectl --context k3d-$PCTL_CLUSTER"
}

# Substitute manifest placeholders and apply.  $1=image
apply_manifests() {
  local image="$1"
  say "Namespace…"
  kube create namespace "$PCTL_NAMESPACE" --dry-run=client -o yaml | kube apply -f -

  # HMAC key for portal sign-in tokens. Generated once and preserved across re-runs so the key the TUI
  # reads to mint tokens stays stable; only created if absent.
  if ! kube -n "$PCTL_NAMESPACE" get secret placecontext-portal >/dev/null 2>&1; then
    local signing_key
    signing_key="$(openssl rand -hex 32 2>/dev/null || head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')"
    kube -n "$PCTL_NAMESPACE" create secret generic placecontext-portal \
      --from-literal=signing-key="$signing_key" --dry-run=client -o yaml | kube apply -f -
  fi

  # Shared RSA key for signing OAuth/MCP access tokens — generated once so every replica (and restart)
  # signs with the same key id. Requires openssl; only created if absent.
  if ! kube -n "$PCTL_NAMESPACE" get secret placecontext-oauth >/dev/null 2>&1; then
    if command -v openssl >/dev/null 2>&1; then
      local pem; pem="$(openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 2>/dev/null)"
      kube -n "$PCTL_NAMESPACE" create secret generic placecontext-oauth \
        --from-literal=key.pem="$pem" --dry-run=client -o yaml | kube apply -f -
    else
      warn "openssl not found — OAuth signing key not created; MCP tokens won't validate across replicas."
    fi
  fi

  say "PostgreSQL (pgvector)…"
  kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/postgres.yaml"

  say "MinIO (reports/artifacts + DB dumps)…"
  kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/minio.yaml"

  say "Nightly DB dump (retention-pruned)…"
  kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/pg-backup.yaml"

  say "Ollama + Gemma (local LLM)…"
  kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/ollama.yaml"

  say "PlaceContext Host (image: $image)…"
  sed -e "s|__IMAGE__|${image}|g" \
    "$K3S_DIR/placecontext.yaml" | kube -n "$PCTL_NAMESPACE" apply -f -
}

wait_rollout() {
  say "Waiting for rollout…"
  kube -n "$PCTL_NAMESPACE" rollout status deploy/placecontext-db --timeout=180s || true
  kube -n "$PCTL_NAMESPACE" rollout status deploy/placecontext --timeout=300s
}

# ── doctor ─────────────────────────────────────────────────────────────────────────────────────
# Runtime registry — mirrors WorkloadRunnerOptions.Runtimes defaults (src/.../Workload/WorkloadRunnerOptions.cs).
# Each entry: "<runtimeId>|<image>|<trivial in-container command that must exit 0>".
# Keep in sync with the C# defaults; the smoke test runs each as a sandboxed Job, exactly how real
# jobs run — so it catches sandbox regressions (memory units, image pull, egress) before go-live.
# Use single quotes in the commands: they sit inside the JSON-style "command" array (double-quoted),
# so single quotes keep the YAML valid while still quoting the runtime's inline program.
PCTL_RUNTIMES=(
  "node|node:22-slim|node -e 'process.exit(0)'"
  "python|python:3.12-slim|python -c 'import sys; sys.exit(0)'"
)

# Smoke-test one runtime: run a trivial workload as a sandboxed Job (256Mi/1cpu, no egress) and assert
# it reaches Complete. Returns 0 on pass. Cleans up the Job either way.
smoke_runtime() {
  local rid="$1" image="$2" cmd="$3" job="pcdoctor-$rid"
  kube -n "$PCTL_NAMESPACE" delete job "$job" >/dev/null 2>&1 || true
  if ! cat <<EOF | kube -n "$PCTL_NAMESPACE" apply -f - >/dev/null 2>&1
apiVersion: batch/v1
kind: Job
metadata:
  name: $job
  labels: { placecontext-doctor: "true" }
spec:
  backoffLimit: 0
  ttlSecondsAfterFinished: 30
  activeDeadlineSeconds: 150
  template:
    metadata:
      labels: { placecontext-doctor: "true" }
    spec:
      restartPolicy: Never
      containers:
        - name: run
          image: $image
          command: ["sh","-c","$cmd"]
          resources:
            limits: { memory: "256Mi", cpu: "1" }
EOF
  then
    warn "runtime '$rid' ($image) — could not create smoke-test job"; return 1
  fi
  local i
  for i in $(seq 1 120); do
    if kube -n "$PCTL_NAMESPACE" wait --for=condition=complete "job/$job" --timeout=1s >/dev/null 2>&1; then
      ok "runtime '$rid' ($image) — smoke test passed"
      kube -n "$PCTL_NAMESPACE" delete job "$job" >/dev/null 2>&1 || true; return 0
    fi
    if kube -n "$PCTL_NAMESPACE" wait --for=condition=failed "job/$job" --timeout=1s >/dev/null 2>&1; then
      warn "runtime '$rid' ($image) — smoke test FAILED:"
      kube -n "$PCTL_NAMESPACE" get pods -l "job-name=$job" \
        -o jsonpath='{range .items[*]}    run: {.status.containerStatuses[0].state}{"\n"}{end}' 2>/dev/null >&2 || true
      kube -n "$PCTL_NAMESPACE" delete job "$job" >/dev/null 2>&1 || true; return 1
    fi
    sleep 1
  done
  warn "runtime '$rid' ($image) — TIMED OUT (slow image pull on a fresh node, or sandbox blocked)"
  kube -n "$PCTL_NAMESPACE" delete job "$job" >/dev/null 2>&1 || true; return 1
}

# Latest EF migration id in the source tree (excludes *.Designer.cs / snapshot). Same logic as the TUI build.
latest_source_migration() {
  ls src/PlaceContext.Infrastructure/Migrations/[0-9]*_*.cs 2>/dev/null \
    | grep -vi '\.designer\.cs$' | sed 's#.*/##; s#\.cs$##' | sort | tail -1
}

# Go-live / initialisation checklist. Verifies the cluster is actually ready to serve: secrets present,
# DB migrated to the code's level, host replicas ready, and every runtime executes in the sandbox.
golive_checklist() {
  echo; say "Go-live checklist (ns: $PCTL_NAMESPACE):"
  resolve_ctx
  local fail=0

  if ! kube get nodes >/dev/null 2>&1; then
    warn "no cluster reachable — bring one up (pctl dev up / pctl server up) before go-live."
    return 1
  fi
  ok "cluster reachable ($(kube get nodes --no-headers 2>/dev/null | grep -c Ready) node(s) Ready)"

  kube get ns "$PCTL_NAMESPACE" >/dev/null 2>&1 && ok "namespace '$PCTL_NAMESPACE' exists" \
    || { warn "namespace '$PCTL_NAMESPACE' missing — run pctl deploy"; fail=1; }

  # Signing secrets — without these, portal sign-in and MCP tokens break across replicas.
  for s in placecontext-portal placecontext-oauth; do
    kube -n "$PCTL_NAMESPACE" get secret "$s" >/dev/null 2>&1 && ok "secret '$s' present" \
      || { warn "secret '$s' MISSING — run pctl deploy (auto-generates it)"; fail=1; }
  done

  # Database ready + schema migrated to the code's level.
  if kube -n "$PCTL_NAMESPACE" exec deploy/placecontext-db -- psql -U postgres -d placecontext -At -c 'SELECT 1' >/dev/null 2>&1; then
    ok "database reachable"
    local want have_mig
    want="$(latest_source_migration)"
    have_mig="$(kube -n "$PCTL_NAMESPACE" exec deploy/placecontext-db -- psql -U postgres -d placecontext -At -c 'SELECT coalesce(max("MigrationId"),$$$$) FROM "__EFMigrationsHistory"' 2>/dev/null | tr -d '\r')"
    if [ -n "$want" ] && [ -n "$have_mig" ] && [ "$have_mig" \< "$want" ]; then
      warn "DB schema behind code (applied ${have_mig#*_}, expected ${want#*_}) — redeploy to migrate"; fail=1
    else
      ok "DB schema up to date (${have_mig#*_})"
    fi
  else
    warn "database not reachable — run pctl deploy"; fail=1
  fi

  # Host replicas ready.
  local ready desired
  ready="$(kube -n "$PCTL_NAMESPACE" get deploy placecontext -o jsonpath='{.status.readyReplicas}' 2>/dev/null)"
  desired="$(kube -n "$PCTL_NAMESPACE" get deploy placecontext -o jsonpath='{.spec.replicas}' 2>/dev/null)"
  if [ -n "$ready" ] && [ "$ready" = "${desired:-0}" ]; then
    ok "host replicas ready ($ready/$desired)"
  else
    warn "host replicas not ready (${ready:-0}/${desired:-?}) — check pctl status"; fail=1
  fi

  # Every runtime must execute in the sandbox (the 'all runtimes need to be checked' requirement).
  say "Runtime smoke tests:"
  local entry rid image cmd
  for entry in "${PCTL_RUNTIMES[@]}"; do
    IFS='|' read -r rid image cmd <<<"$entry"
    smoke_runtime "$rid" "$image" "$cmd" || fail=1
  done

  echo
  [ "$fail" = 0 ] && ok "Go-live checklist passed — ready to serve." \
    || { warn "Go-live checklist has issues (above) — resolve before going live."; return 1; }
}

cmd_doctor() {
  local golive=0
  while [ $# -gt 0 ]; do case "$1" in --go-live|--golive) golive=1; shift;; *) shift;; esac; done

  say "Checking dependencies…"
  local miss=0
  for t in docker k3d kubectl; do
    if have "$t"; then ok "$t — $(command -v "$t")"; else warn "$t — MISSING"; miss=1; fi
  done
  have k3s && ok "k3s — $(command -v k3s) (prod server/agent)" || printf '%s  k3s — not installed (only needed for prod nodes)%s\n' "$C_DIM" "$C_RESET"
  printf '%s  ~/.local/bin on PATH? %s%s\n' "$C_DIM" "$(case ":$PATH:" in *":$HOME/.local/bin:"*) echo yes;; *) echo no — add it;; esac)" "$C_RESET"
  [ "$miss" = 0 ] && ok "Core dev deps present." || die "Install the missing tools above (see README)."

  # The go-live checklist creates throwaway Jobs, so only run it on request or when a cluster is up.
  if [ "$golive" = 1 ] || { have kubectl && resolve_ctx && kube get nodes >/dev/null 2>&1; }; then
    golive_checklist || true
  else
    printf '%s  (run `pctl doctor --go-live` against a running cluster for the full readiness checklist)%s\n' "$C_DIM" "$C_RESET"
  fi
}

# ── dev: local k3d cluster ─────────────────────────────────────────────────────────────────────
cmd_dev_clean() {
  have docker || { warn "docker not found — nothing to clean."; return 0; }
  say "Removing dev Docker Postgres containers + volumes…"
  for c in $PCTL_DB_CONTAINERS; do
    local vols; vols="$(docker inspect -f '{{range .Mounts}}{{if eq .Type "volume"}}{{.Name}} {{end}}{{end}}' "$c" 2>/dev/null || true)"
    docker rm -f "$c" >/dev/null 2>&1 && ok "removed container $c" || true
    for v in $vols; do docker volume rm "$v" >/dev/null 2>&1 && ok "removed volume $v" || true; done
  done
}

dev_cluster_exists() { k3d cluster list -o json 2>/dev/null | grep -q "\"name\":\"$PCTL_CLUSTER\""; }

# Start a stopped dev cluster, repairing the damage a docker prune / daemon reset leaves behind
# (missing cluster network, vanished tools helper). Dies with k3d's real error — never silently —
# if the cluster still won't start, and refuses early when it is damaged beyond starting.
dev_cluster_start() {
  # A dev cluster is always created with a loadbalancer (-p …@loadbalancer). If that container is
  # gone, its host port mappings are unrecoverable — only a recreate brings the portal back.
  if ! docker ps -a --format '{{.Names}}' 2>/dev/null | grep -qx "k3d-$PCTL_CLUSTER-serverlb"; then
    die "dev cluster '$PCTL_CLUSTER' is damaged (loadbalancer container is gone — likely a docker prune). Recreate it: pctl dev down && pctl dev up"
  fi

  local out
  if out="$(k3d cluster start "$PCTL_CLUSTER" 2>&1)"; then return 0; fi

  if grep -q "network k3d-$PCTL_CLUSTER not found" <<<"$out"; then
    warn "Cluster network is missing (docker prune?) — recreating it and retrying…"
    docker network create "k3d-$PCTL_CLUSTER" >/dev/null 2>&1 || true
    docker rm -f "k3d-$PCTL_CLUSTER-tools" >/dev/null 2>&1 || true
    if out="$(k3d cluster start "$PCTL_CLUSTER" 2>&1)"; then return 0; fi
    # The ephemeral tools helper often can't restart after this repair; if the actual cluster
    # nodes made it up, that is good enough.
    if grep -qi "helper" <<<"$out" \
       && docker ps --format '{{.Names}}' | grep -qx "k3d-$PCTL_CLUSTER-server-0"; then
      warn "k3d tools helper failed to start, but the cluster nodes are up — continuing."
      return 0
    fi
  fi

  printf '%s\n' "$out" >&2
  die "could not start dev cluster '$PCTL_CLUSTER'. If it stays broken, recreate it: pctl dev down && pctl dev up"
}

# Block until the cluster API answers, or die — continuing silently just moves the failure into a
# confusing kubectl error later.
dev_wait_api() {
  say "Waiting for the cluster API…"
  local i
  for i in $(seq 1 60); do kube get nodes >/dev/null 2>&1 && return 0; sleep 2; done
  die "cluster API did not come up within 120s — check: docker ps | grep k3d, k3d cluster list"
}

cmd_dev_up() {
  local rebuild=0
  for a in "$@"; do [ "$a" = "--rebuild" ] && rebuild=1; done
  have k3d   || die "k3d not installed — run: pctl doctor"
  have docker|| die "docker is required for the k3d dev cluster."

  [ "$rebuild" = 1 ] && cmd_build
  cmd_dev_clean

  if dev_cluster_exists; then
    ok "k3d cluster '$PCTL_CLUSTER' already exists."
  else
    say "Creating k3d cluster '$PCTL_CLUSTER' ($PCTL_SERVERS server + $PCTL_AGENTS agents)…"
    k3d cluster create "$PCTL_CLUSTER" \
      --servers "$PCTL_SERVERS" --agents "$PCTL_AGENTS" \
      -p "${PCTL_PORT}:80@loadbalancer" \
      --wait
  fi

  use_dev_kubeconfig
  cmd_image_import
  apply_manifests "$PCTL_IMAGE"
  wait_rollout
  ok "Dev cluster ready."
  cmd_url
}

cmd_dev_add_node() {
  local role="agent" name=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --role) role="$2"; shift 2;;
      --name) name="$2"; shift 2;;
      *) die "dev add-node: unknown arg $1";;
    esac
  done
  case "$role" in agent|server) ;; *) die "dev add-node: --role must be 'agent' or 'server'";; esac
  have k3d || die "k3d not installed — run: pctl doctor"
  dev_cluster_exists || die "no dev cluster '$PCTL_CLUSTER' — run: pctl dev up"
  # auto-name: pc-<role>-<n> using the current node count
  if [ -z "$name" ]; then
    local n; n="$(k3d node list -o json 2>/dev/null | grep -c "\"role\":\"$role\"" || echo 0)"
    name="pc-${role}-${n}"
  fi
  say "Adding $role node '$name' to cluster '$PCTL_CLUSTER'…"
  k3d node create "$name" --cluster "$PCTL_CLUSTER" --role "$role" --wait
  ok "Node '$name' joined."
}

cmd_dev_down() {
  have k3d || die "k3d not installed."
  if dev_cluster_exists; then
    say "Deleting k3d cluster '$PCTL_CLUSTER'…"
    k3d cluster delete "$PCTL_CLUSTER"
    ok "Deleted."
  else
    warn "No k3d cluster named '$PCTL_CLUSTER'."
  fi
}

cmd_image_import() {
  have k3d || die "k3d not installed."
  # -s: a truncated/empty tar (crashed build, disk event) must not be treated as an image.
  if [ -s "$PCTL_IMAGE_TAR" ]; then
    say "Importing image from $PCTL_IMAGE_TAR into '$PCTL_CLUSTER'…"
    k3d image import "$PCTL_IMAGE_TAR" -c "$PCTL_CLUSTER"
  else
    say "Importing image $PCTL_IMAGE into '$PCTL_CLUSTER'…"
    k3d image import "$PCTL_IMAGE" -c "$PCTL_CLUSTER"
  fi
  ok "Image available in cluster."
}

# ── autostart (boot persistence) ───────────────────────────────────────────────────────────────
# Dev (k3d/Docker): a systemd *user* service runs `k3d cluster start` at boot.
# Prod (k3s): k3s already installs its own systemd service, so this is a no-op note.
cmd_autostart() {
  local disable=0
  [ "${1:-}" = "--disable" ] && disable=1

  # Only treat this as prod when there's no local k3d dev cluster — a box can have BOTH k3s installed and
  # the k3d dev cluster (which is where PlaceContext actually runs), so prefer the k3d unit when present.
  if ! dev_cluster_exists && have k3s && systemctl is-enabled k3s >/dev/null 2>&1; then
    ok "Prod k3s already auto-starts via its systemd service (nothing to do)."
    return 0
  fi
  have k3d || die "autostart supports the k3d dev cluster (k3d not found)."
  local k3dbin unit; k3dbin="$(command -v k3d)"
  unit="$HOME/.config/systemd/user/placecontext.service"

  if [ "$disable" = 1 ]; then
    systemctl --user disable --now placecontext.service >/dev/null 2>&1 || true
    rm -f "$unit"; systemctl --user daemon-reload >/dev/null 2>&1 || true
    ok "Autostart disabled."; return 0
  fi

  command -v systemctl >/dev/null 2>&1 || die "systemd not available — cannot configure autostart."
  local self localbin
  self="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
  localbin="$HOME/.local/bin"
  mkdir -p "$(dirname "$unit")"
  # ExecStart runs `pctl ensure` (not bare `k3d cluster start`) so boot brings up the cluster AND applies
  # the manifests + waits for the Host rollout — i.e. PlaceContext is actually serving, not just the API.
  cat > "$unit" <<EOF
[Unit]
Description=PlaceContext dev cluster (k3d) + Host
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PATH=${localbin}:/usr/local/bin:/usr/bin:/bin
ExecStart=/bin/bash ${self} ensure
ExecStop=${k3dbin} cluster stop ${PCTL_CLUSTER}
TimeoutStartSec=600

[Install]
WantedBy=default.target
EOF
  systemctl --user daemon-reload >/dev/null 2>&1 || die "systemd --user unavailable."
  systemctl --user enable placecontext.service >/dev/null 2>&1 || true
  if ! loginctl enable-linger "$USER" >/dev/null 2>&1; then
    warn "Could not enable linger — cluster will start on login, not at boot. Run: sudo loginctl enable-linger $USER"
  fi
  ok "Autostart enabled (systemd user service 'placecontext')."
}

# ── ensure (idempotent bring-up) ─────────────────────────────────────────────────────────────────
# Make the whole dev stack running: create the cluster if missing (full dev up), else start it and
# (re)apply the manifests, then wait for the Host rollout. Safe to run repeatedly; used at boot by the
# autostart unit and handy by hand ("is everything up?").
cmd_ensure() {
  have k3d   || die "ensure supports the k3d dev cluster (k3d not found)."
  have docker|| die "docker is required for the k3d dev cluster."

  if ! dev_cluster_exists; then
    say "No dev cluster yet — creating it…"
    cmd_dev_up
    return 0
  fi

  say "Ensuring cluster '$PCTL_CLUSTER' is started…"
  dev_cluster_start
  use_dev_kubeconfig
  dev_wait_api
  apply_manifests "$PCTL_IMAGE"
  wait_rollout
  ok "PlaceContext is up."
  cmd_url
}

# ── db (replicated Postgres via CloudNativePG) ────────────────────────────────────────────────────
PCTL_CNPG_MANIFEST="${PCTL_CNPG_MANIFEST:-https://raw.githubusercontent.com/cloudnative-pg/cloudnative-pg/release-1.24/releases/cnpg-1.24.1.yaml}"

cmd_db() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    ha)           cmd_db_ha "$@";;
    backup-now)   cmd_db_backup "$@";;
    backups)      cmd_db_backups "$@";;
    restore)      cmd_db_restore "$@";;
    minio)        cmd_db_minio "$@";;
    *) die "unknown 'db' subcommand: '$sub' (try: ha | backup-now | backups | restore [--dump KEY] | minio)";;
  esac
}

# Run the nightly dump CronJob right now (a gzipped pg_dumpall of every database → MinIO).
cmd_db_backup() {
  resolve_ctx
  local name="pg-dump-manual-$(date +%s 2>/dev/null || echo now)"
  say "Triggering an on-demand DB dump…"
  kube -n "$PCTL_NAMESPACE" create job --from=cronjob/placecontext-pg-dump "$name"
  ok "Job '$name' running — logs: kubectl -n $PCTL_NAMESPACE logs -f job/$name --all-containers"
}

# List the dumps currently held in MinIO (newest last; names are timestamped so they sort).
cmd_db_backups() {
  resolve_ctx
  kube -n "$PCTL_NAMESPACE" exec deploy/minio -- sh -c \
    'mc alias set s http://localhost:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null 2>&1; mc ls s/placecontext-backups/' \
    || die "could not list dumps (is MinIO up? has a dump run yet?)"
}

# Restore the databases from a dump (latest by default). DESTRUCTIVE: drops + recreates the DBs,
# so the app is scaled down for the duration and scaled back afterwards.
cmd_db_restore() {
  local dump="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dump) dump="$2"; shift 2;;
      --yes)  yes=1; shift;;
      *) die "db restore: unknown arg $1 (usage: db restore [--dump KEY] [--yes])";;
    esac
  done
  resolve_ctx

  if [ -z "$dump" ]; then
    dump="$(kube -n "$PCTL_NAMESPACE" exec deploy/minio -- sh -c \
      'mc alias set s http://localhost:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null 2>&1; mc ls s/placecontext-backups/' \
      2>/dev/null | awk '{print $NF}' | grep '\.sql\.gz$' | sort | tail -1)"
    [ -n "$dump" ] || die "no dumps found — run: pctl db backup-now"
    say "Latest dump: ${dump}"
  fi

  if [ "$yes" != 1 ]; then
    printf 'This DROPS and recreates the databases from %s. Type yes to continue: ' "$dump"
    local answer; read -r answer
    [ "$answer" = "yes" ] || die "aborted."
  fi

  local replicas
  replicas="$(kube -n "$PCTL_NAMESPACE" get deploy/placecontext -o jsonpath='{.spec.replicas}' 2>/dev/null || echo 1)"
  say "Scaling the app down for the restore…"
  kube -n "$PCTL_NAMESPACE" scale deploy/placecontext --replicas=0
  kube -n "$PCTL_NAMESPACE" rollout status deploy/placecontext --timeout=120s || true

  say "Restoring ${dump}…"
  kube -n "$PCTL_NAMESPACE" exec deploy/minio -- sh -c \
    'mc alias set s http://localhost:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null 2>&1; mc cat "s/placecontext-backups/'"$dump"'"' | \
    kube -n "$PCTL_NAMESPACE" run "pctl-pg-restore-$$" --rm -i --restart=Never \
      --image=pgvector/pgvector:pg16 --env=PGPASSWORD=postgres --command -- sh -c '
        if pg_isready -h placecontext-pg-rw -U postgres >/dev/null 2>&1; then HOST=placecontext-pg-rw; else HOST=placecontext-db; fi
        echo "restoring into ${HOST}…"
        gunzip -c | psql -q -h "$HOST" -U postgres -d postgres' \
    || { kube -n "$PCTL_NAMESPACE" scale deploy/placecontext --replicas="${replicas:-1}"; die "restore failed — app scaled back up."; }

  say "Scaling the app back up…"
  kube -n "$PCTL_NAMESPACE" scale deploy/placecontext --replicas="${replicas:-1}"
  kube -n "$PCTL_NAMESPACE" rollout status deploy/placecontext --timeout=240s
  ok "Databases restored from ${dump}."
}

# Download a MinIO object to a temp file and open it (e.g. a rendered report HTML).
cmd_minio_open() {
  local path="${1:-}"
  [ -n "$path" ] || die "usage: pctl minio open <bucket/key>"
  resolve_ctx
  local base; base="$(basename "$path")"
  local dst="${TMPDIR:-/tmp}/pctl-${base}"
  say "Fetching ${path}…"
  kube -n "$PCTL_NAMESPACE" exec deploy/minio -- sh -c \
    'mc alias set s http://localhost:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD" >/dev/null 2>&1; mc cat "s/'"$path"'"' > "$dst" 2>/dev/null
  [ -s "$dst" ] || die "could not fetch '$path' (does it exist?)"
  if command -v xdg-open >/dev/null 2>&1; then xdg-open "$dst" >/dev/null 2>&1 &
  elif command -v open >/dev/null 2>&1; then open "$dst";
  else echo "saved to $dst"; fi
  ok "Opened ${dst}"
}

# Expose the in-cluster MinIO (run reports/artifacts store) on localhost so you can browse it.
cmd_db_minio() {
  resolve_ctx
  local creds; creds="$(kube -n "$PCTL_NAMESPACE" get secret placecontext-minio -o jsonpath='{.data.ACCESS_KEY_ID}' 2>/dev/null | base64 -d 2>/dev/null || true)"
  say "Forwarding MinIO → console http://localhost:9001, API http://localhost:9000  (Ctrl-C to stop)"
  [ -n "$creds" ] && echo "  login: ${creds} / (ACCESS_SECRET_KEY from the placecontext-minio secret)"
  kube -n "$PCTL_NAMESPACE" port-forward svc/minio 9001:9001 9000:9000
}

# Stand up replicated Postgres (1 primary + 2 replicas), and point the app at it.
cmd_db_ha() {
  resolve_ctx
  say "Installing the CloudNativePG operator…"
  kube apply --server-side -f "$PCTL_CNPG_MANIFEST" >/dev/null
  kube -n cnpg-system rollout status deploy/cnpg-controller-manager --timeout=180s

  say "Object store (MinIO) for run reports/artifacts…"
  kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/minio.yaml"
  kube -n "$PCTL_NAMESPACE" rollout status deploy/minio --timeout=180s

  say "Superuser secret (keeps the app's postgres/postgres credentials)…"
  kube -n "$PCTL_NAMESPACE" create secret generic placecontext-pg-superuser \
    --type=kubernetes.io/basic-auth --from-literal=username=postgres --from-literal=password=postgres \
    --dry-run=client -o yaml | kube apply -f -

  say "Replicated cluster…"
  kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/postgres-ha.yaml"

  say "Nightly DB dump (retention-pruned)…"
  kube -n "$PCTL_NAMESPACE" apply -f "$K3S_DIR/pg-backup.yaml"
  say "Waiting for the cluster to become healthy (3 instances)…"
  local i ready
  for i in $(seq 1 60); do
    ready="$(kube -n "$PCTL_NAMESPACE" get cluster placecontext-pg -o jsonpath='{.status.readyInstances}' 2>/dev/null || true)"
    [ "$ready" = "3" ] && break
    sleep 5
  done
  [ "$ready" = "3" ] || die "cluster did not reach 3 ready instances (got '${ready:-0}')."

  say "Pointing the app at the primary (placecontext-pg-rw)…"
  kube -n "$PCTL_NAMESPACE" set env deploy/placecontext \
    "PlaceContext__ConnectionString=Host=placecontext-pg-rw;Port=5432;Database=placecontext;Username=postgres;Password=postgres"
  kube -n "$PCTL_NAMESPACE" rollout status deploy/placecontext --timeout=240s
  ok "Replicated Postgres active. Reads can also use placecontext-pg-ro."
}

# ── mesh (self-hosted WireGuard control plane via Headscale) ──────────────────────────────────────
# Run these on the DigitalOcean droplet that hosts the mesh control server.
cmd_mesh() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    up)      cmd_mesh_up "$@";;
    tenant)  cmd_mesh_tenant "$@";;
    authkey) cmd_mesh_authkey "$@";;
    down)    cmd_mesh_down "$@";;
    *) die "unknown 'mesh' subcommand: '$sub' (try: up --domain FQDN | tenant add|rm ID | authkey --tenant ID | down)";;
  esac
}

dc() { if docker compose version >/dev/null 2>&1; then docker compose "$@"; else docker-compose "$@"; fi; }
hs() { ( cd deploy/headscale && dc -f docker-compose.live.yml exec -T headscale headscale "$@" ); }
MESH_DIR="deploy/headscale"
MESH_TENANTS="$MESH_DIR/tenants.list"

cmd_mesh_up() {
  local domain=""
  while [ $# -gt 0 ]; do case "$1" in --domain) domain="$2"; shift 2;; *) die "mesh up: unknown arg $1";; esac; done
  [ -n "$domain" ] || die "mesh up needs --domain <fqdn> (DNS A record → this droplet)"
  have docker || die "docker is required to run Headscale."
  say "Templating Headscale config for ${domain}…"
  sed "s|__DOMAIN__|${domain}|g" "$MESH_DIR/config.yaml" > "$MESH_DIR/config.live.yaml"
  [ -f "$MESH_TENANTS" ] || : > "$MESH_TENANTS"
  mesh_render_acl
  ( cd "$MESH_DIR" && sed 's|config.yaml|config.live.yaml|' docker-compose.yml > docker-compose.live.yml && dc -f docker-compose.live.yml up -d )
  ok "Headscale up at https://${domain}  — add a customer: pctl mesh tenant add <id>"
}

# Regenerate the default-deny, per-tenant ACL from the tenant registry. Each tenant only sees itself.
mesh_render_acl() {
  local owners="" acls="" id first_o=1 first_a=1
  while IFS= read -r id; do
    [ -z "$id" ] && continue
    [ "$first_o" = 1 ] && first_o=0 || owners+=","
    owners+="\"tag:cust-${id}\":[\"cust-${id}\"]"
    [ "$first_a" = 1 ] && first_a=0 || acls+=","
    acls+="{\"action\":\"accept\",\"src\":[\"tag:cust-${id}\"],\"dst\":[\"tag:cust-${id}:*\"]}"
  done < "$MESH_TENANTS"
  cat > "$MESH_DIR/acl.json" <<EOF
{ "tagOwners": { ${owners} }, "acls": [ ${acls} ] }
EOF
}

cmd_mesh_tenant() {
  local action="${1:-}" id="${2:-}"
  [ -n "$id" ] || die "usage: pctl mesh tenant add|rm <tenant-id>"
  [ -f "$MESH_TENANTS" ] || : > "$MESH_TENANTS"
  case "$action" in
    add)
      grep -qxF "$id" "$MESH_TENANTS" || echo "$id" >> "$MESH_TENANTS"
      hs users create "cust-${id}" >/dev/null 2>&1 || true
      mesh_render_acl
      ( cd "$MESH_DIR" && dc -f docker-compose.live.yml restart headscale >/dev/null )
      ok "Tenant '${id}' added (isolated network tag:cust-${id}). Key: pctl mesh authkey --tenant ${id}"
      ;;
    rm)
      grep -vxF "$id" "$MESH_TENANTS" > "$MESH_TENANTS.tmp" 2>/dev/null || true
      mv -f "$MESH_TENANTS.tmp" "$MESH_TENANTS" 2>/dev/null || true
      mesh_render_acl
      ( cd "$MESH_DIR" && dc -f docker-compose.live.yml restart headscale >/dev/null )
      ok "Tenant '${id}' removed from the ACL."
      ;;
    *) die "usage: pctl mesh tenant add|rm <tenant-id>";;
  esac
}

cmd_mesh_authkey() {
  local tenant="" ephemeral=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --tenant)    tenant="$2"; shift 2;;
      --ephemeral) ephemeral=1; shift;;   # for TUI viewers: node auto-deregisters when it disconnects
      *) die "mesh authkey: unknown arg $1";;
    esac
  done
  [ -n "$tenant" ] || die "mesh authkey needs --tenant <id> (each customer gets its own key)"
  have docker || die "docker is required."
  grep -qxF "$tenant" "$MESH_TENANTS" 2>/dev/null || die "unknown tenant '${tenant}' — add it first: pctl mesh tenant add ${tenant}"
  # Tagged pre-auth key for that tenant's isolated network. Cluster nodes use a PERSISTENT key (stay on
  # the mesh so data keeps syncing); TUI viewers use --ephemeral (auto-removed when the TUI closes).
  if [ "$ephemeral" = 1 ]; then
    hs preauthkeys create --user "cust-${tenant}" --tags "tag:cust-${tenant}" --reusable --ephemeral --expiration 1h
  else
    hs preauthkeys create --user "cust-${tenant}" --tags "tag:cust-${tenant}" --reusable --expiration 720h
  fi
}

cmd_mesh_down() {
  ( cd "$MESH_DIR" && dc -f docker-compose.live.yml down 2>/dev/null || dc down 2>/dev/null || true )
  ok "Headscale stopped."
}

# ── kill (destructive — pod | node | job) ─────────────────────────────────────────────────────────
cmd_kill() {
  local kind="${1:-}"; shift || true
  local name="" yes=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes|-y) yes=1; shift;;
      -*) die "kill: unknown flag $1";;
      *) name="$1"; shift;;
    esac
  done
  case "$kind" in pod|node|job) ;; *) die "kill: kind must be 'pod', 'node', or 'job'";; esac
  [ -n "$name" ] || die "kill: need a name — pctl kill $kind <name>"

  if [ "$yes" != 1 ]; then
    printf '%s⚠  Really kill %s "%s"? This is destructive. [y/N] %s' "$C_YELLOW" "$kind" "$name" "$C_RESET"
    read -r ans
    case "$ans" in y|Y|yes|YES) ;; *) echo "aborted."; return 1;; esac
  fi

  case "$kind" in
    pod)
      resolve_ctx
      say "Deleting pod '$name' (its controller will reschedule it)…"
      kube -n "$PCTL_NAMESPACE" delete pod "$name"
      ;;
    node)
      have k3d || die "node kill currently supports k3d dev nodes only."
      say "Removing node '$name' from cluster '$PCTL_CLUSTER'…"
      k3d node delete "$name" || true
      # Also drop the Kubernetes node registration so it doesn't linger as NotReady.
      resolve_ctx
      kube delete node "$name" --ignore-not-found >/dev/null 2>&1 || true
      ;;
    job)
      resolve_ctx
      local esc="${name//\'/\'\'}"   # escape single quotes for SQL
      say "Deleting job '$name' and its run history…"
      kube -n "$PCTL_NAMESPACE" exec deploy/placecontext-db -- psql -U postgres -d placecontext -c \
        "DELETE FROM job_runs WHERE \"JobId\" IN (SELECT \"Id\" FROM jobs WHERE \"Name\"='$esc'); \
         DELETE FROM job_triggers WHERE \"JobId\" IN (SELECT \"Id\" FROM jobs WHERE \"Name\"='$esc'); \
         DELETE FROM jobs WHERE \"Name\"='$esc';"
      ;;
  esac
  ok "Killed $kind '$name'."
}

# ── build ──────────────────────────────────────────────────────────────────────────────────────
cmd_build() {
  local tag="$PCTL_IMAGE"
  while [ $# -gt 0 ]; do case "$1" in --tag) tag="$2"; shift 2;; *) shift;; esac; done
  have docker || die "docker is required to build."
  say "Building image $tag…"
  docker build -t "$tag" .
  say "Exporting to $PCTL_IMAGE_TAR…"
  docker save "$tag" -o "$PCTL_IMAGE_TAR"
  ok "Built and saved."
}

# ── deploy (any current kube context) ────────────────────────────────────────────────────────────
cmd_deploy() {
  local image="$PCTL_IMAGE"
  while [ $# -gt 0 ]; do
    case "$1" in
      --image)          image="$2"; shift 2;;
      --context)        KUBECTL="kubectl --context $2"; shift 2;;
      *) die "deploy: unknown arg $1";;
    esac
  done
  resolve_ctx  # default to the k3d dev cluster's kubeconfig when one exists and none was forced
  apply_manifests "$image"
  # The image tag is constant (:local), so an unchanged Deployment spec would leave the old pods
  # running the old image — force a restart so freshly imported code actually rolls out.
  kube -n "$PCTL_NAMESPACE" rollout restart deploy/placecontext >/dev/null 2>&1 || true
  wait_rollout
  ok "Deployed."
}

# ── update (pull the latest source from git) ───────────────────────────────────────────────────────
# Fast-forwards the repo at ROOT to its upstream. Pull only by default; --deploy also rebuilds the
# image and rolls it out, bringing the dev cluster up first if it isn't running. Used by the TUI's [u] key.
cmd_update() {
  local do_deploy=0
  while [ $# -gt 0 ]; do case "$1" in --deploy) do_deploy=1; shift;; *) die "update: unknown arg $1";; esac; done
  have git || die "git is required to update."
  [ -d .git ] || die "not a git repository: $ROOT"
  local before after branch
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '?')"
  before="$(git rev-parse HEAD 2>/dev/null || echo '')"
  say "Updating $branch from git…"
  git pull --ff-only || die "git pull failed — resolve local changes / diverged history manually."
  after="$(git rev-parse HEAD 2>/dev/null || echo '')"
  if [ "$before" = "$after" ]; then
    ok "Already up to date ($branch @ ${after:0:8})."
    if [ "$do_deploy" = 1 ] && have k3d && have docker; then
      cmd_ensure
    fi
    return 0
  fi
  ok "Updated $branch: ${before:0:8} → ${after:0:8}."
  git --no-pager log --oneline "${before}..${after}" 2>/dev/null | sed 's/^/  /'
  if [ "$do_deploy" = 1 ]; then
    say "Rebuilding + deploying…"
    cmd_build
    if have k3d && have docker; then
      # Dev (k3d): bring the cluster up if needed, then get the fresh image into it.
      if ! dev_cluster_exists; then
        say "No dev cluster yet — creating it…"
        cmd_dev_up
        return 0
      fi
      dev_cluster_start
      use_dev_kubeconfig
      dev_wait_api
      cmd_image_import
    fi
    cmd_deploy
  else
    warn "Run 'pctl deploy' (or 'pctl update --deploy') to roll the new code into the cluster."
  fi
}

# ── prod: k3s server / agent across machines ─────────────────────────────────────────────────────
# Mint a short-lived, ephemeral, pre-authorized, tagged Tailscale auth key from an OAuth client, so
# k3s can join the tailnet without a hand-managed key. Echoes the key.  Needs: id, secret (+ optional tag).
ts_mint_authkey() {
  local id="$1" secret="$2" tag="${3:-tag:k8s}"
  have curl || die "curl is required for Tailscale OAuth."
  local tok
  tok="$(curl -fsSL https://api.tailscale.com/api/v2/oauth/token \
    -d "client_id=${id}" -d "client_secret=${secret}" \
    | sed -n 's/.*"access_token"[: ]*"\([^"]*\)".*/\1/p')"
  [ -n "$tok" ] || die "Tailscale OAuth token request failed (check --ts-oauth-client-id/secret)."
  local body key
  body="{\"capabilities\":{\"devices\":{\"create\":{\"reusable\":false,\"ephemeral\":true,\"preauthorized\":true,\"tags\":[\"${tag}\"]}}},\"expirySeconds\":900}"
  key="$(curl -fsSL -H "Authorization: Bearer ${tok}" -H 'Content-Type: application/json' \
    -d "$body" https://api.tailscale.com/api/v2/tailnet/-/keys \
    | sed -n 's/.*"key"[: ]*"\([^"]*\)".*/\1/p')"
  [ -n "$key" ] || die "Tailscale auth key minting failed (does the OAuth client have the '${tag}' tag + key write scope?)."
  printf '%s' "$key"
}

# Build the k3s --vpn-auth exec arg into the named array, from either a Tailscale OAuth client
# (managed tailscale.com) or a self-hosted control server (Headscale) + pre-auth key. No-op if neither.
# Args: <array-name> <ts_id> <ts_secret> <ts_tag> <vpn_control> <vpn_authkey>
build_vpn_arg() {
  local __arr="$1" ts_id="$2" ts_secret="$3" ts_tag="$4" ctrl="$5" authkey="$6"
  if [ -n "$ctrl" ] && [ -n "$authkey" ]; then
    say "Joining the self-hosted mesh control server ${ctrl}…"
    eval "${__arr}+=(\"--vpn-auth=name=tailscale,joinKey=${authkey},controlServerURL=${ctrl}\")"
  elif [ -n "$ts_id" ] && [ -n "$ts_secret" ]; then
    say "Minting a Tailscale auth key from the OAuth client…"
    local tskey; tskey="$(ts_mint_authkey "$ts_id" "$ts_secret" "$ts_tag")"
    eval "${__arr}+=(\"--vpn-auth=name=tailscale,joinKey=${tskey}\")"
  fi
}

cmd_server_up() {
  local image="$PCTL_IMAGE" ts_id="" ts_secret="" ts_tag="tag:k8s" vpn_ctrl="" vpn_key=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --image)              image="$2"; shift 2;;
      --ts-oauth-client-id) ts_id="$2"; shift 2;;
      --ts-oauth-secret)    ts_secret="$2"; shift 2;;
      --ts-tag)             ts_tag="$2"; shift 2;;
      --vpn-control)        vpn_ctrl="$2"; shift 2;;
      --vpn-authkey)        vpn_key="$2"; shift 2;;
      *) die "server up: unknown arg $1";;
    esac
  done
  [ "$(id -u)" = 0 ] || die "server up installs a systemd service — run with sudo."

  local -a exec_args=()
  build_vpn_arg exec_args "$ts_id" "$ts_secret" "$ts_tag" "$vpn_ctrl" "$vpn_key"

  say "Installing k3s (server)…"
  if have k3s; then ok "k3s already installed."; else curl -sfL https://get.k3s.io | sh -s - server "${exec_args[@]}"; fi
  KUBECTL="k3s kubectl"
  say "Waiting for the control plane…"
  until kube get nodes >/dev/null 2>&1; do sleep 2; done

  apply_manifests "$image"
  wait_rollout
  ok "Server node up. PlaceContext deploying to namespace '$PCTL_NAMESPACE'."
  echo
  cmd_join_cmd
}

cmd_agent_join() {
  local url="" token="" ts_id="" ts_secret="" ts_tag="tag:k8s" vpn_ctrl="" vpn_key=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --server-url)         url="$2"; shift 2;;
      --node-token)         token="$2"; shift 2;;
      --ts-oauth-client-id) ts_id="$2"; shift 2;;
      --ts-oauth-secret)    ts_secret="$2"; shift 2;;
      --ts-tag)             ts_tag="$2"; shift 2;;
      --vpn-control)        vpn_ctrl="$2"; shift 2;;
      --vpn-authkey)        vpn_key="$2"; shift 2;;
      *) die "agent join: unknown arg $1";;
    esac
  done
  [ -n "$url" ] && [ -n "$token" ] || die "agent join needs --server-url and --node-token"
  [ "$(id -u)" = 0 ] || die "agent join installs a systemd service — run with sudo."

  local -a exec_args=()
  build_vpn_arg exec_args "$ts_id" "$ts_secret" "$ts_tag" "$vpn_ctrl" "$vpn_key"
  say "Joining this machine to $url as a worker…"
  curl -sfL https://get.k3s.io | K3S_URL="$url" K3S_TOKEN="$token" sh -s - agent "${exec_args[@]}"
  ok "Worker joined."
}

# ── join code (one compact string that lets a new computer join as a worker) ────────────────────
# Master: `pctl join-code` prints PC1.<base64url("https://ip:6443 <token>")>. New computer: the
# TUI's [j] screen (or `pctl join --code …`) decodes it and runs the agent join.
cmd_join_code() {
  local tok_file="/var/lib/rancher/k3s/server/node-token"
  [ -r "$tok_file" ] || die "no k3s server token readable here — run on the master (or: sudo pctl join-code)"
  local ip; ip="$(tailscale ip -4 2>/dev/null | head -1)"
  [ -n "$ip" ] || ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  [ -n "$ip" ] || die "could not determine this machine's IP"
  local code
  code="PC1.$(printf 'https://%s:6443 %s' "$ip" "$(cat "$tok_file")" | base64 -w0 | tr '+/' '-_' | tr -d '=')"
  printf '%sJoin code — give this to the new computer:%s\n\n  %s\n\n' "$C_BOLD" "$C_RESET" "$code"
  printf 'On the new computer: run the TUI and press [j], or: sudo ./deploy/pctl join --code <code>\n'
}

cmd_join() {
  local code=""
  while [ $# -gt 0 ]; do case "$1" in --code) code="$2"; shift 2;; *) die "join: unknown arg $1";; esac; done
  [ -n "$code" ] || die "join needs --code <code> — generate it on the master: pctl join-code"
  case "$code" in PC1.*) ;; *) die "unrecognised join code (expected PC1.…)";; esac
  local b64="${code#PC1.}"
  b64="$(printf '%s' "$b64" | tr -- '-_' '+/')"
  while [ $((${#b64} % 4)) -ne 0 ]; do b64="${b64}="; done
  local decoded; decoded="$(printf '%s' "$b64" | base64 -d 2>/dev/null)" || die "join code is corrupted"
  local url="${decoded%% *}" token="${decoded#* }"
  [ -n "$url" ] && [ -n "$token" ] && [ "$url" != "$decoded" ] || die "join code is incomplete"
  if [ "$(id -u)" != 0 ]; then
    # The TUI can't prompt for a sudo password — self-elevate when passwordless sudo exists,
    # otherwise hand the operator the exact command to run.
    if sudo -n true 2>/dev/null; then
      say "Joining $url as a worker (via sudo)…"
      exec sudo -n "$0" agent join --server-url "$url" --node-token "$token"
    fi
    die "joining installs k3s (needs root) — run: sudo $0 join --code '$code'"
  fi
  cmd_agent_join --server-url "$url" --node-token "$token"
}

cmd_join_cmd() {
  local tok_file="/var/lib/rancher/k3s/server/node-token"
  # Prefer the tailnet IP (stable across NAT/locations) when this server is on Tailscale.
  local ip; ip="$(tailscale ip -4 2>/dev/null | head -1)"
  [ -n "$ip" ] || ip="$(hostname -I 2>/dev/null | awk '{print $1}')"
  local tok="<run on server: sudo cat $tok_file>"
  [ -r "$tok_file" ] && tok="$(cat "$tok_file")"
  printf '%sAdd a worker node — run on the other machine:%s\n' "$C_BOLD" "$C_RESET"
  printf '  sudo ./deploy/pctl agent join \\\n    --server-url https://%s:6443 \\\n    --node-token %s \\\n    [--ts-oauth-client-id ID --ts-oauth-secret SECRET]\n' "${ip:-<server-ip>}" "$tok"
}

# ── status / logs / url ──────────────────────────────────────────────────────────────────────────
resolve_ctx() {
  # For dev convenience, default to the k3d context if it exists and none was forced.
  if [ "$KUBECTL" = "kubectl" ] && have k3d && dev_cluster_exists; then
    use_dev_kubeconfig
  fi
}
cmd_status() {
  resolve_ctx
  say "Nodes:"; kube get nodes -o wide || die "no cluster reachable (is one up?)"
  echo; say "Workloads (ns: $PCTL_NAMESPACE):"
  kube -n "$PCTL_NAMESPACE" get deploy,pods,svc,ingress 2>/dev/null || warn "namespace not deployed yet"
}
cmd_logs() {
  resolve_ctx
  local follow=""; [ "${1:-}" = "-f" ] && follow="-f"
  kube -n "$PCTL_NAMESPACE" logs $follow -l app=placecontext --tail=100
}
cmd_url() {
  printf '%sPortal + MCP:%s  http://localhost:%s/   (MCP at /mcp)\n' "$C_BOLD" "$C_RESET" "$PCTL_PORT"
}

# Launch the reactive Go TUI dashboard (builds it on first run, or when the source is newer —
# e.g. right after `pctl update` pulled new TUI code).
cmd_tui() {
  local bin="deploy/tui/pctl-tui"
  if [ ! -x "$bin" ] || [ -n "$(find deploy/tui -name '*.go' -newer "$bin" 2>/dev/null)" ]; then
    have go || die "Go toolchain not found — install Go, then: make -C deploy/tui"
    say "Building the TUI…"
    ( cd deploy/tui && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w" -o pctl-tui . ) || die "TUI build failed."
  fi
  PCTL_BIN="$ROOT/deploy/pctl" exec "$bin"
}

# ── help ─────────────────────────────────────────────────────────────────────────────────────────
cmd_help() {
  cat <<EOF
${C_BOLD}pctl${C_RESET} — PlaceContext control CLI

${C_BOLD}USAGE${C_RESET}
  pctl <command> [options]

${C_BOLD}LOCAL DEV${C_RESET} ${C_DIM}(k3d: a 1-server + ${PCTL_AGENTS}-agent k3s cluster on this machine)${C_RESET}
  dev up [--rebuild]     Clean dev Docker, create cluster, import image, deploy
  dev down               Delete the local k3d cluster
  dev clean              Remove the dev Docker Postgres containers + volumes
  dev add-node [--role agent|server] [--name N]   Add a node to the dev cluster
  image import           (Re)import the local image into the dev cluster

${C_BOLD}PRODUCTION${C_RESET} ${C_DIM}(k3s across multiple machines)${C_RESET}
  server up [--image IMG] [--ts-oauth-client-id ID --ts-oauth-secret SECRET]
                         Install k3s server here + deploy (sudo); Tailscale meshes the fleet (sudo)
  agent join --server-url URL --node-token TOK [--ts-oauth-client-id ID --ts-oauth-secret SECRET]
                         Join this machine as a worker (sudo)
                         (self-hosted mesh: --vpn-control https://headscale --vpn-authkey KEY)
  join-cmd                                        Print the worker-join command (run on server)
  join-code              Print a one-string join code (run on the master; give it to a new computer)
  join --code CODE       Join this computer to the cluster using a join code (TUI: press [j])

${C_BOLD}MESH${C_RESET} ${C_DIM}(self-hosted WireGuard control plane via Headscale, on a DO droplet)${C_RESET}
  mesh up --domain FQDN  Start Headscale (your own Tailscale) for the fleet
  mesh tenant add|rm ID  Add/remove a customer — an isolated private network (tag:cust-ID, ACL-enforced)
  mesh authkey --tenant ID  Mint that customer's pre-auth key (use as --vpn-authkey on their nodes)
  mesh down              Stop Headscale

${C_BOLD}ANYWHERE${C_RESET}
  tui                    Launch the reactive full-screen dashboard (Go TUI)
  build [--tag TAG]      Build the container image and export it to the tarball
  deploy [--image IMG] [--context CTX]
                         Apply the manifests to the current (or given) kube context
  update [--deploy]      Pull the latest source from git (fast-forward); --deploy also rebuilds + rolls out (starts the dev cluster if needed)
  kill pod|node|job NAME [--yes]   Delete a pod / k3d node / job (prompts unless --yes)
  db ha                  Replicated Postgres (1 primary + 2 replicas) via CloudNativePG
  db backup-now          Dump all databases to MinIO right now (nightly CronJob does this at 03:00)
  db backups             List the dumps currently held (7-day retention)
  db restore [--dump KEY] [--yes]   Restore the databases from a dump (latest by default)
  db minio               Port-forward the MinIO store to localhost (console :9001)
  minio open BUCKET/KEY  Download a MinIO object and open it (e.g. a report's HTML)
  ensure                 Bring the whole stack up idempotently (start/create cluster + apply + wait)
  autostart [--disable]  Run 'ensure' on boot (k3d → systemd user service; k3s → already a service)
  status                 Show nodes + workloads
  logs [-f]              Tail the PlaceContext Host logs
  url                    Print the portal / MCP URL
  doctor                 Check required tools
  help                   This help

${C_BOLD}CONFIG${C_RESET} ${C_DIM}(environment overrides)${C_RESET}
  PCTL_CLUSTER=$PCTL_CLUSTER  PCTL_NAMESPACE=$PCTL_NAMESPACE  PCTL_PORT=$PCTL_PORT  PCTL_AGENTS=$PCTL_AGENTS
  PCTL_IMAGE=$PCTL_IMAGE
EOF
}

# ── dispatch ───────────────────────────────────────────────────────────────────────────────────
main() {
  local cmd="${1:-help}"; shift || true
  case "$cmd" in
    dev)
      local sub="${1:-}"; shift || true
      case "$sub" in
        up)        cmd_dev_up "$@";;
        down)      cmd_dev_down "$@";;
        clean)     cmd_dev_clean "$@";;
        add-node)  cmd_dev_add_node "$@";;
        *) die "unknown 'dev' subcommand: '$sub' (try: up | down | clean | add-node)";;
      esac;;
    image)
      local sub="${1:-}"; shift || true
      case "$sub" in
        import) cmd_image_import "$@";;
        *) die "unknown 'image' subcommand: '$sub' (try: import)";;
      esac;;
    server)
      local sub="${1:-}"; shift || true
      case "$sub" in
        up) cmd_server_up "$@";;
        *) die "unknown 'server' subcommand: '$sub' (try: up)";;
      esac;;
    agent)
      local sub="${1:-}"; shift || true
      case "$sub" in
        join) cmd_agent_join "$@";;
        *) die "unknown 'agent' subcommand: '$sub' (try: join)";;
      esac;;
    kill)         cmd_kill "$@";;
    db)           cmd_db "$@";;
    mesh)         cmd_mesh "$@";;
    minio)        case "${1:-}" in open) shift; cmd_minio_open "$@";; *) die "usage: pctl minio open <bucket/key>";; esac;;
    autostart)    cmd_autostart "$@";;
    ensure)       cmd_ensure "$@";;
    tui|ui)       cmd_tui "$@";;
    build)        cmd_build "$@";;
    deploy)       cmd_deploy "$@";;
    update)       cmd_update "$@";;
    status)       cmd_status "$@";;
    logs)         cmd_logs "$@";;
    url)          cmd_url "$@";;
    join-cmd)     cmd_join_cmd "$@";;
    join-code)    cmd_join_code "$@";;
    join)         cmd_join "$@";;
    doctor)       cmd_doctor "$@";;
    help|-h|--help) cmd_help;;
    version|--version) echo "pctl 0.1.0";;
    *) warn "unknown command: $cmd"; echo; cmd_help; exit 2;;
  esac
}
main "$@"
