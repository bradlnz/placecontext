#cloud-config
# Bootstraps the Headscale mesh control plane on first boot.
# Rendered by Terraform (templatefile) — ${domain}, ${repo_url}, ${repo_ref}, ${headscale_image}
# are substituted in. The droplet ends up running exactly what `pctl mesh up` produces, so every
# `pctl mesh tenant|authkey` command works natively here afterward.

package_update: true
package_upgrade: true

packages:
  - git
  - curl
  - ca-certificates
  - ufw

write_files:
  # Pin the Headscale image the repo's compose uses, in case the default in-repo tag drifts.
  - path: /etc/placecontext-mesh.env
    permissions: "0644"
    content: |
      MESH_DOMAIN=${domain}
      HEADSCALE_IMAGE=${headscale_image}

  # First-boot bring-up. Idempotent: safe to re-run.
  - path: /usr/local/sbin/placecontext-mesh-bootstrap.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      DOMAIN="${domain}"
      REPO_URL="${repo_url}"
      REPO_REF="${repo_ref}"
      DEST=/opt/placecontext

      echo "[mesh] installing Docker engine + compose plugin…"
      if ! command -v docker >/dev/null 2>&1; then
        curl -fsSL https://get.docker.com | sh
      fi
      systemctl enable --now docker

      echo "[mesh] fetching PlaceContext repo ($REPO_REF) from $REPO_URL…"
      if [ -d "$DEST/.git" ]; then
        git -C "$DEST" fetch --depth 1 origin "$REPO_REF" && git -C "$DEST" checkout -f FETCH_HEAD
      else
        git clone --depth 1 --branch "$REPO_REF" "$REPO_URL" "$DEST" \
          || git clone --depth 1 "$REPO_URL" "$DEST"
      fi

      echo "[mesh] bringing the Headscale control server up for $DOMAIN…"
      cd "$DEST"
      ./deploy/pctl mesh up --domain "$DOMAIN"
      echo "[mesh] done — control server live at https://$DOMAIN"

runcmd:
  # Host firewall mirrors the cloud firewall (defence in depth): SSH + Headscale's ports.
  - [ ufw, allow, "22/tcp" ]
  - [ ufw, allow, "80/tcp" ]
  - [ ufw, allow, "443/tcp" ]
  - [ ufw, allow, "3478/udp" ]
  - [ ufw, "--force", enable ]
  - [ bash, /usr/local/sbin/placecontext-mesh-bootstrap.sh ]
