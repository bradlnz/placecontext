#cloud-config
# Bootstraps the PlaceContext public EDGE on first boot: join the Headscale mesh + run a Caddy TLS
# reverse proxy to the app on the LOCAL cluster over the tailnet. This droplet runs NO app/DB/jobs.
#
# Rendered by Terraform (templatefile). ONLY these are Terraform template vars, substituted at apply:
#   $${domain}, $${mesh_control_url}, $${mesh_authkey}, $${mesh_hostname}, $${app_upstream}
# Shell variables use the brace-less $VAR / $(...) forms, which templatefile leaves untouched.
#
# NOTE: no host ufw here — the DigitalOcean cloud firewall is the enforcement layer, and ufw would
# fight Docker's iptables chains.

package_update: true
package_upgrade: true

packages:
  - curl
  - ca-certificates

write_files:
  # ── The edge: a single Caddy container terminating public TLS and proxying over the tailnet ──────
  # network_mode: host so Caddy binds the droplet's :80/:443 directly AND can reach tailnet (100.x)
  # upstreams via the host's tailscale0 interface. The Caddyfile is generated by the bootstrap script
  # (it needs the domain/upstream values and a conditional for the no-domain case).
  - path: /opt/placecontext-edge/docker-compose.yml
    permissions: "0644"
    content: |
      services:
        caddy:
          image: caddy:2
          restart: unless-stopped
          network_mode: host
          volumes:
            - /opt/placecontext-edge/Caddyfile:/etc/caddy/Caddyfile:ro
            - caddydata:/data
            - caddyconfig:/config
      volumes:
        caddydata:
        caddyconfig:

  # ── First-boot bring-up: install Docker + Tailscale, join the mesh, write Caddyfile, start Caddy ──
  # Idempotent: safe to re-run.
  - path: /usr/local/sbin/placecontext-edge-bootstrap.sh
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      DEST=/opt/placecontext-edge
      mkdir -p "$DEST"

      echo "[edge] installing Docker engine + compose plugin…"
      if ! command -v docker >/dev/null 2>&1; then
        curl -fsSL https://get.docker.com | sh
      fi
      systemctl enable --now docker

      echo "[edge] installing Tailscale…"
      if ! command -v tailscale >/dev/null 2>&1; then
        curl -fsSL https://tailscale.com/install.sh | sh
      fi
      systemctl enable --now tailscaled

      echo "[edge] joining the Headscale mesh (${mesh_control_url}) as ${mesh_hostname}…"
      # Same control server + pre-auth-key model the local cluster nodes use (pctl mesh authkey).
      # --accept-routes so subnet-advertised cluster routes (if any) are usable from the edge.
      tailscale up \
        --login-server "${mesh_control_url}" \
        --authkey "${mesh_authkey}" \
        --hostname "${mesh_hostname}" \
        --accept-routes

      echo "[edge] writing Caddyfile…"
      if [ -n "${domain}" ]; then
        cat > "$DEST/Caddyfile" <<EOF
      ${domain} {
          encode gzip zstd
          # reverse_proxy passes WebSocket/SignalR upgrades (Blazor Server circuits) through by default.
          # Upstream is the app on the LOCAL cluster, reached over the tailnet.
          reverse_proxy ${app_upstream}
      }
      EOF
      else
        cat > "$DEST/Caddyfile" <<EOF
      :80 {
          encode gzip zstd
          # No domain set → plain HTTP on :80. reverse_proxy still passes WebSocket upgrades.
          reverse_proxy ${app_upstream}
      }
      EOF
      fi

      echo "[edge] starting Caddy…"
      cd "$DEST"
      docker compose pull || true
      docker compose up -d
      echo "[edge] up — public entrypoint live; forwarding to ${app_upstream} over the mesh."

runcmd:
  - [ bash, /usr/local/sbin/placecontext-edge-bootstrap.sh ]
