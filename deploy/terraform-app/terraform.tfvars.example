# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored (it holds the API token, the
# mesh pre-auth keys, and — if you set them explicitly — the DB/replication passwords).

# DigitalOcean API token (or export DIGITALOCEAN_TOKEN and leave this unset).
# do_token = "dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Public keys granted root on the droplets (operate the DB with patronictl/etcdctl over SSH).
ssh_public_keys = [
  "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... you@laptop",
]

# ── Mesh join (Headscale) ─────────────────────────────────────────────────────────────────────────
# The control server provisioned by deploy/terraform/ (its `domain`), plus one pre-auth key per node
# minted there with:  pctl mesh authkey --tenant <id>
mesh_control_url     = "https://mesh.example.com"
mesh_authkey         = "REPLACE_WITH_pctl_mesh_authkey_OUTPUT_for_primary"
witness_mesh_authkey = "REPLACE_WITH_pctl_mesh_authkey_OUTPUT_for_witness"

# ── DCS topology (MagicDNS names — must match what each node registers under) ─────────────────────
# These three names form the etcd cluster; all must resolve on the tailnet for the DCS to reach quorum.
# mesh_hostname         = "placecontext-db-primary"   # this droplet (primary)
# witness_mesh_hostname = "placecontext-db-witness"   # the witness droplet
# replica_mesh_hostname = "placecontext-db-local"     # the LOCAL k3s node (brought up by deploy/ha/)

# ── Witness (third etcd member — split-brain guard; keep enabled) ─────────────────────────────────
# enable_witness = true
# witness_region = "fra1"          # DIFFERENT region than `region` below so one region outage != no quorum
# witness_size   = "s-1vcpu-1gb"

# ── Primary sizing / region ───────────────────────────────────────────────────────────────────────
# region       = "nyc3"
# droplet_size = "s-2vcpu-4gb"     # ≈ $24/mo; Postgres + etcd + Patroni

# ── Patroni image (MUST bundle pgvector) ──────────────────────────────────────────────────────────
# Build + push deploy/postgres/Dockerfile.patroni, then set it here.
# patroni_image = "ghcr.io/bradlnz/placecontext-patroni:16-pgvector"

# ── Credentials (leave unset to auto-generate; read back with `terraform output -raw ...`) ────────
# superuser_username   = "postgres"
# superuser_password   = "set-me-or-leave-unset-to-generate"     # sensitive
# replication_username = "replicator"
# replication_password = "set-me-or-leave-unset-to-generate"     # sensitive

# ── Optional: publish a round-robin DB DNS name over the node tailnet IPs (ops convenience) ────────
# The reliable leader-finding path is the Npgsql multi-host string above; this is just a single name.
# db_rr_dns_name   = "db.example.com"
# db_rr_dns_values = ["100.64.0.10", "100.64.0.20"]   # primary + local replica tailnet IPs

# ── Optional public edge on this droplet (80/443). Not needed for a pure DB host. ─────────────────
# domain     = "app.example.com"
# manage_dns = false

# ── Optional overrides (defaults shown) ───────────────────────────────────────────────────────────
# name              = "placecontext-db"
# patroni_scope     = "placecontext"
# ssh_allowed_cidrs = ["0.0.0.0/0", "::/0"]   # tighten to your admin IPs
# monitoring        = true
