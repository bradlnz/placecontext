[Unit]
Description=PlaceContext authenticated OpenSearch sync trigger
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=/etc/placecontext/opensearch-sync-trigger.env
ExecStart=/usr/bin/python3 /opt/placecontext/opensearch-sync-trigger/server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/systemd

[Install]
WantedBy=multi-user.target
