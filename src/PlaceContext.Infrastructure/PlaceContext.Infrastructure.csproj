<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PlaceContext.Application\PlaceContext.Application.csproj" />
    <ProjectReference Include="..\PlaceContext.Domain\PlaceContext.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="3.7.405.4" />
    <PackageReference Include="KubernetesClient" Version="19.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.14" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="Cronos" Version="0.10.0" />
    <PackageReference Include="PdfPig" Version="0.1.15" />
  </ItemGroup>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Workload\Scripts\**\*" />
    <Content Include="$(MSBuildThisFileDirectory)../../dist/qemu-agent-build/x86_64-unknown-linux-gnu/release/pc-jev"
             Link="pc-jev" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
             Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
  </ItemGroup>

  <Target Name="BuildQemuGuestAgent" BeforeTargets="PrepareForBuild"
          Condition="$([MSBuild]::IsOSPlatform('Linux')) and '$(QemuAgentPrebuilt)' != 'true'"
          Inputs="../PlaceContext.QemuAgent/Cargo.toml;../PlaceContext.QemuAgent/Cargo.lock;../PlaceContext.QemuAgent/src/agent.rs;../PlaceContext.QemuAgent/src/bridge.rs;../PlaceContext.QemuAgent/src/browser.rs;../PlaceContext.QemuAgent/src/main.rs"
          Outputs="$(MSBuildThisFileDirectory)../../dist/qemu-agent-build/x86_64-unknown-linux-gnu/release/pc-jev">
    <Exec WorkingDirectory="../PlaceContext.QemuAgent"
          Command="cargo rustc --locked --release --target x86_64-unknown-linux-gnu --target-dir ../../dist/qemu-agent-build -- -C target-feature=+crt-static" />
  </Target>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
