@* Authentication has a consistent light appearance independent of the saved workspace theme. *@
@inherits LayoutComponentBase

<div id="dcshell" data-theme="light" class="auth-shell">
    <header class="auth-header">
        <a class="auth-brand" href="/login" aria-label="PlaceContext sign in">
            <span class="corgi-mark" aria-hidden="true"></span>
            <span>PlaceContext</span>
        </a>
        <span class="auth-header-note">Your work. Connected.</span>
    </header>
    <div class="auth-wrap">
        @Body
    </div>
    <footer class="auth-footer">
        <span>PlaceContext</span>
        <span>Build, run, and manage your workflows.</span>
    </footer>
</div>
