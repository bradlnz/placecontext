@inherits LayoutComponentBase
@layout MainLayout
@implements IDisposable
@inject NavigationManager Nav
@inject IPlaceContextService Svc
@inject PlaceContext.Application.Ports.IMenuConfigService MenuCfg

@* Project secondary nav — structure from tenant menu config; filtered by permissions. *@
<div class="shell">
    <nav class="side">
        <div class="side-head">Project</div>
        @{
            string? lastSection = null;
        }
        @foreach (var item in _menu)
        {
            if (item.Kind == "entities")
            {
                if (_entities.Count == 0) continue;
                var sec = item.Section ?? item.Label;
                if (sec != lastSection)
                {
                    lastSection = sec;
                    <div class="side-head-2">@sec</div>
                }
                @foreach (var e in _entities)
                {
                    var entityPath = $"/project/{ProjectId()}/entity/{Uri.EscapeDataString(e)}";
                    <button class="dcnav nav-btn @(IsEntityActive(e) ? "active" : "")"
                            @onclick="@(() => Nav.NavigateTo(entityPath))">
                        <span class="bar"></span>@e
                    </button>
                }
                continue;
            }

            if (!string.IsNullOrEmpty(item.Section) && item.Section != lastSection)
            {
                lastSection = item.Section;
                <div class="side-head-2">@item.Section</div>
            }

            <button class="dcnav nav-btn @(IsActive(item) ? "active" : "")"
                    @onclick="@(() => Nav.NavigateTo(item.Href ?? "/"))">
                <span class="bar"></span>@item.Label
            </button>
        }
    </nav>
    <div class="body">
        @Body
    </div>
</div>

@code {
    private IReadOnlyList<ResolvedMenuItem> _menu = Array.Empty<ResolvedMenuItem>();
    private IReadOnlyList<string> _entities = Array.Empty<string>();
    private Guid? _entitiesFor;

    private Guid? ProjectId()
    {
        var m = System.Text.RegularExpressions.Regex.Match(Nav.Uri, @"/project/([0-9a-fA-F-]{36})");
        return m.Success && Guid.TryParse(m.Groups[1].Value, out var id) ? id : null;
    }

    private bool IsActive(ResolvedMenuItem item)
    {
        if (string.IsNullOrEmpty(item.Href)) return false;
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        var target = item.Href.TrimEnd('/');
        if (path.Equals(target, StringComparison.OrdinalIgnoreCase)) return true;
        // Data parent owns analytics/datamap/entities registry.
        if (item.Id == "project.data" && (path.Contains("/analytics", StringComparison.OrdinalIgnoreCase)
            || path.Contains("/datamap", StringComparison.OrdinalIgnoreCase)
            || path.Contains("/entities", StringComparison.OrdinalIgnoreCase)))
            return true;
        return false;
    }

    private bool IsEntityActive(string entityName)
    {
        var path = Uri.UnescapeDataString(new Uri(Nav.Uri).AbsolutePath);
        // /project/{guid}/entity/{name}
        var marker = "/entity/";
        var i = path.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
        if (i < 0) return false;
        var segment = path[(i + marker.Length)..].TrimEnd('/');
        // Drop any further segments if present
        var slash = segment.IndexOf('/');
        if (slash >= 0) segment = segment[..slash];
        return segment.Equals(entityName, StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnMoved;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        var pid = ProjectId();
        if (pid is null)
        {
            // Keep last menu if URI briefly unparseable — avoid flash-empty nav on entity routes.
            return;
        }
        try
        {
            var menu = await MenuCfg.GetProjectMenuAsync(pid.Value);
            // Every project item is permission-gated, so an unresolved ambient user (circuit
            // reconnect / prerender→interactive handoff) yields an empty set — deny-by-default —
            // which is transient, not "the user has no items". Keep the previous menu rather than
            // overwriting it with empty, or the Project nav flickers away and back.
            if (menu.Count > 0) _menu = menu;
        }
        catch
        {
            // Keep previous _menu on transient failures so the Project nav does not vanish.
        }

        if (_menu.Any(m => m.Kind == "entities"))
        {
            if (pid != _entitiesFor || _entities.Count == 0)
            {
                _entitiesFor = pid;
                try { _entities = (await Svc.ListDataEntitiesAsync(pid.Value)).Select(e => e.Name).ToList(); }
                catch { /* keep previous entity list */ }
            }
        }
    }

    private void OnMoved(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(async () => { await ReloadAsync(); StateHasChanged(); });

    public void Dispose() => Nav.LocationChanged -= OnMoved;
}
