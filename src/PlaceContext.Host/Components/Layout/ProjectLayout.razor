@inherits LayoutComponentBase
@layout MainLayout
@implements IDisposable
@inject NavigationManager Nav
@inject IPlaceContextService Svc

@* The project area: a vertical menu on the left (replacing the old horizontal tab strip),
   second-level strips (like Data's Tables | Analytics | Data map) stay inside the pages. *@
<div class="shell">
    <nav class="side">
        <div class="side-head">Project</div>
        @foreach (var item in Items)
        {
            <button class="dcnav nav-btn @(IsActive(item) ? "active" : "")"
                    @onclick="@(() => Nav.NavigateTo(UrlFor(item)))">
                <span class="bar"></span>@item.Label
            </button>
        }
        @if (_entities.Count > 0)
        {
            <div class="side-head-2">Business</div>
            @foreach (var e in _entities)
            {
                <button class="dcnav nav-btn @(Nav.Uri.Contains($"/entity/{Uri.EscapeDataString(e)}", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                        @onclick="@(() => Nav.NavigateTo($"/project/{ProjectId()}/entity/{Uri.EscapeDataString(e)}"))">
                    <span class="bar"></span>@e
                </button>
            }
        }
    </nav>
    <div class="body">
        @Body
    </div>
</div>

@code {
    private sealed record Item(string Label, string Key, string Path);

    // Overview/Knowledge/Activity are the project page's own tabs (carried in ?tab=); the rest
    // are sub-pages. "data" is the parent of the Tables | Analytics | Data map strip.
    private static readonly Item[] Items =
    {
        new("Overview", "overview", ""),
        new("Jobs", "jobs", "jobs"),
        new("Chains", "chains", "chains"),
        new("Schedules", "schedules", "schedules"),
        new("Data", "data", "data"),
        new("Vault", "vault", "secrets"),
        new("Events", "events", "events"),
    };

    private Guid? ProjectId()
    {
        var m = System.Text.RegularExpressions.Regex.Match(Nav.Uri, @"/project/([0-9a-fA-F-]{36})");
        return m.Success && Guid.TryParse(m.Groups[1].Value, out var id) ? id : null;
    }

    private string UrlFor(Item item)
    {
        var pid = ProjectId();
        if (pid is null) return "/";
        return item.Path.Length == 0
            ? $"/project/{pid}?tab={item.Key}"
            : $"/project/{pid}/{item.Path}";
    }

    private bool IsActive(Item item)
    {
        var uri = new Uri(Nav.Uri);
        var path = uri.AbsolutePath.TrimEnd('/');
        var afterProject = System.Text.RegularExpressions.Regex.Match(path, @"/project/[0-9a-fA-F-]{36}(?:/([a-z]+))?").Groups[1].Value;
        if (item.Path.Length > 0)
        {
            // Analytics + Data map live under the Data parent.
            if (item.Key == "data" && afterProject is "analytics" or "datamap") return true;
            return afterProject == item.Path;
        }
        // The single Overview item owns the project page (its Overview/Knowledge/Activity
        // tabs are an in-page strip).
        return afterProject.Length == 0;
    }

    // Tagged entities surface as custom menu items — the business views of ingested data.
    private IReadOnlyList<string> _entities = Array.Empty<string>();
    private Guid? _entitiesFor;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnMoved;
        await LoadEntitiesAsync();
    }

    private async Task LoadEntitiesAsync()
    {
        var pid = ProjectId();
        if (pid is null || pid == _entitiesFor) return;
        _entitiesFor = pid;
        try { _entities = (await Svc.ListDataEntitiesAsync(pid.Value)).Select(e => e.Name).ToList(); }
        catch { _entities = Array.Empty<string>(); }
    }

    private void OnMoved(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(async () => { await LoadEntitiesAsync(); StateHasChanged(); });

    public void Dispose() => Nav.LocationChanged -= OnMoved;
}
