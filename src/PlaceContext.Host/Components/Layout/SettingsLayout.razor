@inherits LayoutComponentBase
@layout MainLayout
@using Microsoft.Extensions.DependencyInjection
@inject SettingsLayoutViewModel Vm
@implements IDisposable

<div class="shell">
    <button type="button" class="settings-toggle"
            aria-controls="settings-sections" aria-expanded="@Vm.NavigationOpen"
            @onclick="Vm.ToggleNavigation">
        <span>Settings</span>
        <span class="settings-current">@Vm.ActiveLabel</span>
        <span aria-hidden="true">@(Vm.NavigationOpen ? "−" : "+")</span>
    </button>

    <nav id="settings-sections" class="settings-nav @(Vm.NavigationOpen ? "open" : null)"
         aria-label="Settings sections">
        <div class="settings-nav-head">Settings</div>
        @foreach (var (label, path) in Vm.VisibleItems)
        {
            var active = Vm.IsActive(path);
            <a href="@(Vm.Href(path))" class="settings-link"
               aria-current="@(active ? "page" : null)" @onclick="Vm.CloseNavigation"
               style="color:@(active ? "var(--text)" : "var(--text-2)");
                      background:@(active ? "var(--hover)" : "transparent");
                      border-left:2px solid @(active ? "var(--brand)" : "transparent")">
                @label
            </a>
        }
    </nav>

    <div class="body">
        @Body
    </div>
</div>

@code {
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override Task OnInitializedAsync() => Vm.InitializeAsync();
    public void Dispose() => Vm.Detach();
}
