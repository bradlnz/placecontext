@inherits LayoutComponentBase
@layout MainLayout
@using Microsoft.Extensions.DependencyInjection
@inject NavigationManager Nav
@inject IServiceScopeFactory ScopeFactory
@inject ICurrentUser CurrentUser

<div class="shell">
    <button type="button" class="settings-toggle"
            aria-controls="settings-sections" aria-expanded="@_navOpen"
            @onclick="ToggleNav">
        <span>Settings</span>
        <span class="settings-current">@ActiveLabel</span>
        <span aria-hidden="true">@(_navOpen ? "−" : "+")</span>
    </button>

    <nav id="settings-sections" class="settings-nav @(_navOpen ? "open" : null)"
         aria-label="Settings sections">
        <div class="settings-nav-head">Settings</div>
        @foreach (var (label, path) in VisibleItems)
        {
            var active = IsActive(path);
            <a href="@($"/settings/{path}")" class="settings-link"
               aria-current="@(active ? "page" : null)" @onclick="CloseNav"
               style="color:@(active ? "var(--text)" : "var(--text-2)");
                      background:@(active ? "var(--hover)" : "transparent");
                      border-left:2px solid @(active ? "var(--brand)" : "transparent")">
                @label
            </a>
        }
    </nav>

    <div class="body">
        @Body
    </div>
</div>

@code {
    private bool _navOpen;
    private bool _isDefaultAdmin;

    private void ToggleNav() => _navOpen = !_navOpen;
    private void CloseNav() => _navOpen = false;

    private bool IsActive(string path) =>
        new Uri(Nav.Uri).AbsolutePath.Equals($"/settings/{path}", StringComparison.OrdinalIgnoreCase);

    private string ActiveLabel =>
        VisibleItems.FirstOrDefault(item => IsActive(item.Path)).Label ?? "Choose a section";

    protected override async Task OnInitializedAsync()
    {
        // /settings/* is default-admin-only except the self-service API tokens page. The nav mirrors
        // that policy so members only see entries they can actually open.
        if (CurrentUser.IsAuthenticated)
        {
            await using var scope = ScopeFactory.CreateAsyncScope();
            _isDefaultAdmin = await scope.ServiceProvider
                .GetRequiredService<IMembershipService>()
                .IsDefaultAdminAsync(CurrentUser.UserId);
        }
    }

    private IEnumerable<(string Label, string Path)> VisibleItems =>
        _isDefaultAdmin ? Items : Items.Where(i => i.Path == "api-tokens");

    private static readonly (string Label, string Path)[] Items =
    {
        ("Branding", "branding"),
        ("Menu", "menu"),
        ("Artifacts", "artifacts"),
        ("Communications", "communications"),
        ("MCP servers", "mcp"),
        ("Locality", "locality"),
        ("Backup", "backup"),
        ("Access", "access"),
        ("API tokens", "api-tokens"),
    };
}
