@inherits LayoutComponentBase
@layout MainLayout
@using Microsoft.Extensions.DependencyInjection
@inject SettingsLayoutViewModel Vm
@implements IDisposable

<div class="shell">
    <header class="settings-page-head">
        <div>
            <h2>Settings</h2>
            <p>Configure workspace access, providers, execution and maintenance.</p>
        </div>
    </header>
    <button type="button" class="dcbtn settings-toggle" aria-controls="settings-sections" aria-expanded="@(Vm.NavigationOpen ? "true" : "false")" @onclick="Vm.ToggleNavigation">@Vm.ActiveLabel · Browse settings</button>
    <div class="settings-content-shell">
        <nav id="settings-sections" class="settings-nav @(Vm.NavigationOpen ? "open" : null)" aria-label="Settings sections">
            <input type="search" class="dcinput" aria-label="Find a setting" placeholder="Find a setting…" @bind="Vm.Search" @bind:event="oninput" />
            @foreach (var group in Vm.VisibleGroups)
            {
                <section><h3>@group.Key</h3>
                    @foreach (var item in group)
                    {
                        <a href="@Vm.Href(item.Path)" class="settings-subtab" aria-current="@(Vm.IsActive(item.Path) ? "page" : null)" @onclick="Vm.CloseNavigation">@item.Label</a>
                    }
                </section>
            }
            @if (!Vm.VisibleGroups.Any()) { <p role="status">No matching settings.</p> }
        </nav>
        <div class="body">
            @Body
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override Task OnInitializedAsync() => Vm.InitializeAsync();
    public void Dispose() => Vm.Detach();
}
