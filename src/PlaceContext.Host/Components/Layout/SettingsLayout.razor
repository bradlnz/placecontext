@inherits LayoutComponentBase
@layout MainLayout
@inject NavigationManager Nav

@* The settings area mirrors the project area: a vertical menu, tabs inside the pages. *@
<div class="shell">
    <nav class="side">
        <div class="side-head">Settings</div>
        @foreach (var (label, path) in Items)
        {
            <button class="dcnav nav-btn @(Nav.Uri.Contains($"/settings/{path}") ? "active" : "")"
                    @onclick="@(() => Nav.NavigateTo($"/settings/{path}"))">
                <span class="bar"></span>@label
            </button>
        }
    </nav>
    <div class="body">
        @Body
    </div>
</div>

@code {
    private static readonly (string Label, string Path)[] Items =
    {
        ("Branding", "branding"),
        ("Locality", "locality"),
        ("GitHub", "github"),
        ("Backup", "backup"),
        ("Access", "access"),
        ("API tokens", "api-tokens"),
    };
}
