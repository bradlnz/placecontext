@inherits LayoutComponentBase
@layout MainLayout
@using Microsoft.Extensions.DependencyInjection
@inject SettingsLayoutViewModel Vm
@implements IDisposable

<div class="shell">
    <header class="settings-page-head">
        <div>
            <h2>Settings</h2>
            <p>Configure workspace access, providers, execution and maintenance.</p>
        </div>
    </header>
    <nav class="settings-tabs" role="tablist" aria-label="Settings sections">
        @foreach (var group in Vm.VisibleGroups)
        {
            var active = group.Any(item => Vm.IsActive(item.Path));
            <a href="@(Vm.Href(group.First().Path))" class="dctab @(active ? "active" : null)"
               role="tab" aria-selected="@active">
                @group.Key
            </a>
        }
    </nav>
    <div class="settings-content-shell">
        @foreach (var group in Vm.VisibleGroups.Where(group => group.Any(item => Vm.IsActive(item.Path))))
        {
            <nav class="settings-subtabs" aria-label="@group.Key settings">
                @foreach (var item in group)
                {
                    <a href="@(Vm.Href(item.Path))" class="settings-subtab @(Vm.IsActive(item.Path) ? "active" : null)"
                       aria-current="@(Vm.IsActive(item.Path) ? "page" : null)">@item.Label</a>
                }
            </nav>
        }
        <div class="body">
            @Body
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override Task OnInitializedAsync() => Vm.InitializeAsync();
    public void Dispose() => Vm.Detach();
}
