@inherits LayoutComponentBase
@layout MainLayout
@using Microsoft.Extensions.DependencyInjection
@inject SettingsLayoutViewModel Vm
@implements IDisposable

<div class="shell">
    <button type="button" class="settings-toggle"
            aria-controls="settings-sections" aria-expanded="@(Vm.NavigationOpen ? "true" : "false")"
            @onclick="Vm.ToggleNavigation">
        <span>Settings</span>
        <span class="settings-current">@Vm.ActiveLabel</span>
        <span aria-hidden="true">@(Vm.NavigationOpen ? "−" : "+")</span>
    </button>

    <nav id="settings-sections" class="settings-nav @(Vm.NavigationOpen ? "open" : null)"
         aria-label="Settings sections">
        <div class="settings-nav-head">Settings</div>
        @foreach (var group in Vm.VisibleGroups)
        {
            <section class="settings-group" aria-label="@group.Key">
                <h2>@group.Key</h2>
                @foreach (var item in group)
                {
                    <a href="@(Vm.Href(item.Path))" class="settings-link"
                       aria-current="@(Vm.IsActive(item.Path) ? "page" : null)" @onclick="Vm.CloseNavigation">
                        @item.Label
                    </a>
                }
            </section>
        }
    </nav>

    <div class="body">
        @Body
    </div>
</div>

@code {
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override Task OnInitializedAsync() => Vm.InitializeAsync();
    public void Dispose() => Vm.Detach();
}
