@inherits LayoutComponentBase
@layout MainLayout
@implements IDisposable
@inject NavigationManager Nav
@inject PortalUiState Ui

@* The settings area mirrors the project area: a vertical menu, tabs inside the pages. *@
<div class="shell">
    <nav class="side @(_navOpen ? "open" : null)">
        <button class="main-menu-back" @onclick="OpenMainMenu" title="Open main menu">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M19 12H5"></path><path d="M12 19l-7-7 7-7"></path></svg>
            Main menu
        </button>
        <div class="side-head">Settings</div>
        @foreach (var (label, path) in Items)
        {
            <button class="dcnav nav-btn @(Nav.Uri.Contains($"/settings/{path}") ? "active" : "")"
                    @onclick="@(() => GoTo($"/settings/{path}"))">
                <span class="bar"></span>@label
            </button>
        }
    </nav>

    @if (_navOpen)
    {
        <div class="subnav-backdrop" @onclick="CloseNav"></div>
    }

    <div class="body">
        @Body
    </div>
</div>

@code {
    private bool _navOpen;

    private void ToggleNav() => _navOpen = !_navOpen;
    private void CloseNav() => _navOpen = false;

    private void GoTo(string href)
    {
        _navOpen = false;
        Nav.NavigateTo(href);
    }

    private void OpenMainMenu()
    {
        _navOpen = false;
        Ui.OpenMainNav?.Invoke();
    }

    protected override void OnInitialized()
    {
        Ui.SetSubNav(true, ToggleNav);
    }

    public void Dispose()
    {
        Ui.SetSubNav(false, null);
    }

    private static readonly (string Label, string Path)[] Items =
    {
        ("Branding", "branding"),
        ("Menu", "menu"),
        ("Locality", "locality"),
        ("Backup", "backup"),
        ("Access", "access"),
        ("Security", "security"),
        ("API tokens", "api-tokens"),
    };
}
