@inherits LayoutComponentBase
@implements IDisposable
@inject PortalUiState Ui
@inject IConfiguration Config
@inject IPlaceContextService Svc
@inject PlaceContext.Application.Ports.ICurrentTenant Tenant
@inject PlaceContext.Infrastructure.Operations.OperationCenter OpCenter
@inject PlaceContext.Host.Branding.BrandingService Branding
@inject IJSRuntime JS
@inject NavigationManager Nav

<div id="dcshell" data-theme="dark" style="display:flex; height:100vh; width:100%; overflow:hidden; background:var(--bg); @_brand.CssOverrides()">

    <!-- SIDEBAR -->
    <aside style="width:236px; flex:none; display:flex; flex-direction:column; background:var(--panel); border-right:1px solid var(--border)">
        <div style="display:flex; align-items:center; gap:10px; padding:18px 18px 16px">
            @if (_brand.LogoDataUri is { } logo)
            {
                <img src="@logo" alt="logo" style="width:28px; height:28px; flex:none; border-radius:7px; object-fit:contain; background:var(--card-2)" />
            }
            else
            {
                <div style="width:28px; height:28px; flex:none; border-radius:7px; background:var(--brand); display:flex; align-items:center; justify-content:center">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8l3.5 4L5 16"></path><path d="M13 16h6"></path></svg>
                </div>
            }
            <div style="display:flex; flex-direction:column; line-height:1.15">
                <span style="font-size:14px; font-weight:600; letter-spacing:-.2px">@(_brand.ProductName ?? "placecontext")</span>
                <span style="font-size:9.5px; color:var(--text-3); font-family:'IBM Plex Mono',monospace; letter-spacing:.06em">@OrgName</span>
            </div>
        </div>

        <div style="padding:6px 12px; display:flex; flex-direction:column; gap:2px; flex:1; overflow-y:auto">
            <NavLink class="dcnav" href="/" Match="NavLinkMatch.All"><span class="bar"></span>@Icon("grid")<span style="flex:1">Dashboard</span></NavLink>

            @if (Ui.CurrentProjectId is { } pid)
            {
                <NavLink class="dcnav" href="@($"project/{pid}/jobs")"><span class="bar"></span>@Icon("box")<span style="flex:1">Jobs</span></NavLink>
                <NavLink class="dcnav" href="@($"project/{pid}/chains")"><span class="bar"></span>@Icon("chain")<span style="flex:1">Chains</span></NavLink>
                <NavLink class="dcnav" href="@($"project/{pid}/schedules")"><span class="bar"></span>@Icon("clock")<span style="flex:1">Schedules</span></NavLink>
                <NavLink class="dcnav" href="@($"project/{pid}/data")"><span class="bar"></span>@Icon("map")<span style="flex:1">Data</span></NavLink>
                <NavLink class="dcnav" href="@($"project/{pid}/secrets")"><span class="bar"></span>@Icon("key")<span style="flex:1">Vault</span></NavLink>
            }
            <NavLink class="dcnav" href="artifacts"><span class="bar"></span>@Icon("file")<span style="flex:1">Artifacts</span></NavLink>
            <NavLink class="dcnav" href="observability"><span class="bar"></span>@Icon("pulse")<span style="flex:1">Runs</span></NavLink>
            <NavLink class="dcnav" href="inspector"><span class="bar"></span>@Icon("inspector")<span style="flex:1">MCP Server</span><span style="width:7px; height:7px; border-radius:50%; background:var(--good); animation:dcpulse 1.8s ease-in-out infinite"></span></NavLink>

            <div style="font-size:10px; font-weight:600; letter-spacing:.7px; color:var(--text-3); padding:14px 10px 6px; text-transform:uppercase">Workspace</div>
            <NavLink class="dcnav" href="overview"><span class="bar"></span>@Icon("pulse")<span style="flex:1">Projects overview</span></NavLink>
            <NavLink class="dcnav" href="onboarding"><span class="bar"></span>@Icon("rocket")<span style="flex:1">Onboarding</span></NavLink>
            <NavLink class="dcnav" href="wiki"><span class="bar"></span>@Icon("ledger")<span style="flex:1">Wiki</span></NavLink>
            <NavLink class="dcnav" href="settings/github"><span class="bar"></span>@Icon("github")<span style="flex:1">GitHub</span></NavLink>
            <NavLink class="dcnav" href="settings/branding"><span class="bar"></span>@Icon("key")<span style="flex:1">Settings</span></NavLink>
            <NavLink class="dcnav" href="about"><span class="bar"></span>@Icon("grid")<span style="flex:1">About</span></NavLink>
        </div>

        @* ── Project switcher — the design's context pill; nav above scopes to this project ── *@
        <div style="padding:12px 10px 6px; border-top:1px solid var(--border); position:relative">
            <div @onclick="ToggleSwitcher"
                 style="display:flex; align-items:center; gap:8px; padding:8px 10px; border-radius:6px; background:var(--card); border:1px solid var(--border-2); cursor:pointer">
                <span style="width:7px; height:7px; flex:none; border-radius:50%; background:var(--good); box-shadow:0 0 8px rgba(67,214,117,.6)"></span>
                <span style="font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--text-2); flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">
                    @(Ui.CurrentProjectName ?? "select project")
                </span>
                <span style="color:var(--text-3); font-size:10px">▾</span>
            </div>
            @if (_switcherOpen)
            {
                <div style="position:absolute; left:10px; right:10px; bottom:calc(100% + 4px); max-height:260px; overflow-y:auto; background:var(--card); border:1px solid var(--border-2); border-radius:8px; box-shadow:var(--shadow); z-index:60; padding:4px">
                    @foreach (var p in _projects)
                    {
                        <div @onclick="@(() => SwitchProject(p))"
                             style="display:flex; align-items:center; gap:8px; padding:7px 9px; border-radius:6px; cursor:pointer; background:@(p.Id == Ui.CurrentProjectId ? "var(--card-2)" : "transparent")">
                            <span style="width:6px; height:6px; flex:none; border-radius:50%; background:@(p.Id == Ui.CurrentProjectId ? "var(--good)" : "var(--border-2)")"></span>
                            <span style="font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--text-2); white-space:nowrap; overflow:hidden; text-overflow:ellipsis">@p.Name</span>
                        </div>
                    }
                    @if (_projects.Count == 0)
                    {
                        <div style="padding:8px 10px; font-size:11.5px; color:var(--text-3)">No projects yet — start with Onboarding.</div>
                    }
                </div>
            }
        </div>

        <div style="padding:8px 12px 12px; display:flex; align-items:center; justify-content:space-between">
            <AuthorizeView>
                <Authorized>
                    <div style="display:flex; align-items:center; gap:8px; min-width:0">
                        <div style="width:26px; height:26px; flex:none; border-radius:6px; background:var(--card-2); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:600; color:var(--text-2); font-family:'IBM Plex Mono',monospace">@Initials(context.User.Identity?.Name)</div>
                        <div style="min-width:0">
                            <div style="font-size:12px; color:var(--text-2); white-space:nowrap; overflow:hidden; text-overflow:ellipsis">@context.User.Identity?.Name</div>
                            <div style="font-size:10px; color:var(--text-3)">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <span style="font-size:12px; color:var(--text-3)">Not signed in</span>
                </NotAuthorized>
            </AuthorizeView>
            <div style="display:flex; align-items:center; gap:6px; flex:none">
                <form method="post" action="/auth/logout" style="margin:0">
                    <button type="submit" title="Sign out" style="width:30px; height:30px; border-radius:7px; border:1px solid var(--border); background:var(--card); cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--text-2)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><path d="M16 17l5-5-5-5"></path><path d="M21 12H9"></path></svg>
                    </button>
                </form>
                <button @onclick="ToggleTheme" title="Toggle theme" style="width:30px; height:30px; border-radius:7px; border:1px solid var(--border); background:var(--card); cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--text-2)">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19"></path></svg>
                </button>
            </div>
        </div>
    </aside>

    <!-- MAIN -->
    <main style="flex:1; min-width:0; display:flex; flex-direction:column; overflow:hidden">
        <header style="height:54px; flex:none; display:flex; align-items:center; justify-content:space-between; padding:0 24px; border-bottom:1px solid var(--border); background:var(--panel)">
            <div style="display:flex; align-items:center; gap:10px; min-width:0">
                <span style="font-size:14px; font-weight:600; letter-spacing:-.2px">@Ui.Title</span>
                <span style="font-size:12px; color:var(--text-3); font-family:'IBM Plex Mono',monospace; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">@Ui.Sub</span>
            </div>
            <div style="display:flex; align-items:center; gap:10px; flex:none">
                <button class="dcsearch-trigger" @onclick="OpenSearch">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
                    Search context, files, changes
                    <kbd>/</kbd>
                </button>
                <div style="display:flex; align-items:center; gap:7px; padding:6px 11px; background:var(--good-bg); border-radius:7px; color:var(--good); font-size:11.5px; font-weight:500; font-family:'IBM Plex Mono',monospace">
                    <span style="width:6px; height:6px; border-radius:50%; background:var(--good); animation:dcpulse 1.6s ease-in-out infinite"></span>
                    @_runningCount running
                </div>
                <NotificationsBell />
            </div>
        </header>


        <div style="flex:1; overflow-y:auto; overflow-x:hidden">
            @Body
        </div>
    </main>

    @if (_searchOpen)
    {
        <div class="dcsearch-overlay" @onclick="CloseSearch">
            <div class="dcsearch-modal" @onclick:stopPropagation="true">
                <input class="dcsearch-input" placeholder="Search projects, changes, context, decisions…"
                       value="@_term" @oninput="OnSearchInput" @onkeydown="OnSearchKey" @ref="_searchInput" />
                <div class="dcsearch-results">
                    @if (_searching)
                    {
                        <div class="dcsearch-empty">Searching…</div>
                    }
                    else if (_results is { Hits.Count: > 0 })
                    {
                        @foreach (var h in _results.Hits)
                        {
                            <button class="dcsearch-hit" @onclick="@(() => Go(h))">
                                <span class="dcsearch-kind">@h.Kind</span>
                                <span class="dcsearch-title">
                                    <div class="t">@h.Title</div>
                                    <div class="s">@h.Subtitle</div>
                                </span>
                            </button>
                        }
                    }
                    else if (!string.IsNullOrWhiteSpace(_term) && _term.Trim().Length >= 2)
                    {
                        <div class="dcsearch-empty">No matches for “@_term”.</div>
                    }
                    else
                    {
                        <div class="dcsearch-empty">Type at least 2 characters to search this workspace.</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private IReadOnlyList<ProjectSummaryView> _projects = Array.Empty<ProjectSummaryView>();
    private bool _switcherOpen;
    private int _runningCount;
    private string OrgName => string.IsNullOrEmpty(Tenant.Slug) ? "organisation" : Tenant.Slug;
    private string RootPath => Config["PlaceContext:RootPath"] ?? "/home/brad/code";

    protected override void OnInitialized()
    {
        Ui.OnChanged += OnUiChanged;
        OpCenter.Changed += OnOpsChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    private PlaceContext.Host.Branding.TenantBranding _brand = new();

    protected override async Task OnInitializedAsync()
    {
        try { _brand = await Branding.GetAsync(); } catch { }
        try { _projects = await Svc.GetProjectsAsync(); } catch { _projects = Array.Empty<ProjectSummaryView>(); }
        // Default the switcher: the project in the current URL, else the first project.
        SyncProjectFromUrl(Nav.Uri);
        if (Ui.CurrentProjectId is null && _projects.Count > 0)
            Ui.SetProject(_projects[0].Id, _projects[0].Name);
        RefreshRunningCount();
    }

    private void ToggleSwitcher() => _switcherOpen = !_switcherOpen;

    private void SwitchProject(ProjectSummaryView p)
    {
        _switcherOpen = false;
        Ui.SetProject(p.Id, p.Name);
        Nav.NavigateTo($"/project/{p.Id}/jobs");
    }

    // Navigating into any /project/{id}/… page moves the switcher with you.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => SyncProjectFromUrl(e.Location);

    private void SyncProjectFromUrl(string uri)
    {
        var m = System.Text.RegularExpressions.Regex.Match(uri, @"/project/([0-9a-fA-F-]{36})");
        if (!m.Success || !Guid.TryParse(m.Groups[1].Value, out var id)) return;
        var p = _projects.FirstOrDefault(x => x.Id == id);
        if (p is not null) Ui.SetProject(p.Id, p.Name);
    }

    private void OnOpsChanged() => _ = InvokeAsync(() => { RefreshRunningCount(); StateHasChanged(); });

    private void RefreshRunningCount()
        => _runningCount = Tenant.IsResolved ? OpCenter.ActiveCount(Tenant.TenantId) : 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("placecontext.initTheme");
        await JS.InvokeVoidAsync("placecontext.animateMeters");

        if (_focusSearch)
        {
            _focusSearch = false;
            try { await _searchInput.FocusAsync(); } catch { /* element not ready */ }
        }
    }

    private async Task ToggleTheme() => await JS.InvokeVoidAsync("placecontext.toggleTheme");

    // ---- Workspace search ----
    private bool _searchOpen;
    private bool _focusSearch;
    private bool _searching;
    private string _term = "";
    private SearchResultsView? _results;
    private ElementReference _searchInput;

    private void OpenSearch()
    {
        _searchOpen = true;
        _focusSearch = true;
        _term = "";
        _results = null;
    }

    private void CloseSearch() => _searchOpen = false;

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _term = e.Value?.ToString() ?? "";
        var term = _term.Trim();
        if (term.Length < 2) { _results = null; return; }

        _searching = true;
        try { _results = await Svc.SearchAsync(term); }
        catch { _results = null; }
        finally { _searching = false; }
    }

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseSearch();
    }

    private void Go(SearchHit hit)
    {
        CloseSearch();
        Nav.NavigateTo(hit.Url);
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(new[] { ' ', '.', '@', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => string.Concat(parts[0][0], parts[1][0]).ToUpperInvariant()
        };
    }

    private void OnUiChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Ui.OnChanged -= OnUiChanged;
        OpCenter.Changed -= OnOpsChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private RenderFragment Icon(string kind) => builder =>
    {
        var path = kind switch
        {
            "grid" => "<rect x='3' y='3' width='7' height='7' rx='1.5'></rect><rect x='14' y='3' width='7' height='7' rx='1.5'></rect><rect x='14' y='14' width='7' height='7' rx='1.5'></rect><rect x='3' y='14' width='7' height='7' rx='1.5'></rect>",
            "risk" => "<path d='M12 3.5L21.5 20H2.5z'></path><path d='M12 10v4'></path><path d='M12 17.2v.01'></path>",
            "ledger" => "<circle cx='6' cy='6' r='2.4'></circle><circle cx='6' cy='18' r='2.4'></circle><path d='M6 8.5v7'></path><path d='M18 8.5a3.5 3.5 0 0 1-3.5 3.5H10'></path><circle cx='18' cy='6' r='2.4'></circle>",
            "rocket" => "<path d='M5 13c-1.5 1.3-2 5-2 5s3.7-.5 5-2'></path><path d='M9 11a14 14 0 0 1 7-8c2.6 0 4 1.4 4 4a14 14 0 0 1-8 7l-3-3z'></path><circle cx='14.5' cy='9.5' r='1.4'></circle>",
            "github" => "<path d='M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.3 2.1 5.3 2.4 5.3 2.4a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 3.9 8.8c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21'></path>",
            "pulse" => "<path d='M3 12h4l2.5-6 4 12L16 12h5'></path>",
            "box" => "<path d='M12 2.5 21 7v10l-9 4.5L3 17V7l9-4.5Z'></path><path d='M3 7l9 4.5L21 7M12 11.5V21.5'></path>",
            "chain" => "<path d='M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7'></path><path d='M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7'></path>",
            "clock" => "<circle cx='12' cy='12' r='9'></circle><path d='M12 7v5l3.5 2'></path>",
            "map" => "<path d='M9 4 3 6.5v13L9 17l6 2.5 6-2.5v-13L15 6.5 9 4Z'></path><path d='M9 4v13M15 6.5v13'></path>",
            "key" => "<circle cx='8' cy='15' r='4.5'></circle><path d='M11.5 11.5 20 3M16 7l3 3M13 10l2 2'></path>",
            "file" => "<path d='M6 2h8l5 5v15H6V2Z'></path><path d='M14 2v5h5'></path>",
            _ => "<rect x='3' y='4' width='18' height='16' rx='2'></rect><path d='M7 9l3 2.5L7 14'></path><path d='M13 14.5h4'></path>"
        };
        builder.AddMarkupContent(0, $"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'>{path}</svg>");
    };
}
