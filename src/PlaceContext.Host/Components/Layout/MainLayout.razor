@inherits LayoutComponentBase
@implements IDisposable
@using Microsoft.Extensions.DependencyInjection
@inject MainLayoutViewModel Vm


<div id="dcshell" data-theme="@Vm.Theme" class="shell" style="@Vm.BrandCssOverrides">

    <!-- SIDEBAR — structure from tenant menu config; still filtered by effective permissions. -->
    <aside class="sidebar @(Vm.NavOpen ? "open" : null)" aria-label="Primary navigation">
        <div class="brand-row">
            @if (Vm.Brand.LogoDataUri is { } logo)
            {
                <img src="@logo" alt="logo" class="brand-logo" />
            }
            else
            {
                <div class="brand-mark">
                    <svg class="shell-brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 7.5 9 12l-4 4.5M13 17h6" /></svg>
                </div>
            }
            <div class="brand-text">
                <span class="title-14">@Vm.ProductName</span>
                <span class="org-name">@Vm.OrganizationName</span>
            </div>
            <button class="sidebar-close" @onclick="Vm.CloseNavigation" aria-label="Close navigation">×</button>
        </div>

        <div class="nav-list">
            @{
                string? lastSection = null;
            }
            @foreach (var item in Vm.TopLevel)
            {
                if (Vm.IsSection(item))
                {
                    lastSection = item.Label;
                    <div class="nav-section">@item.Label</div>
                    continue;
                }
                var children = Vm.ChildrenOf(item.Id);
                var isGroup = Vm.IsGroup(item);
                // Accordion groups are their own visual grouping — no section header above them.
                if (!isGroup && !string.IsNullOrEmpty(item.Section) && item.Section != lastSection)
                {
                    lastSection = item.Section;
                    <div class="nav-section">@item.Section</div>
                }
                @* Keep a leading '/' so links stay absolute. Relative hrefs break under deep
                   routes like /project/{id}/entity/{name} (resolve under the entity segment). *@
                var href = Vm.AbsoluteHref(item.Href);
                if (!isGroup)
                {
                <NavLink class="dcnav" href="@(href ?? "/")" Match="@Vm.MatchFor(href)" title="@item.Label">
                    <span class="bar"></span>@((MarkupString)Vm.IconMarkup(string.IsNullOrWhiteSpace(item.Icon) ? item.Id : item.Icon))<span class="nav-label">@item.Label</span>
                        @if (Vm.IsMcp(item))
                        {
                            <span class="mcp-dot"></span>
                        }
                    </NavLink>
                    continue;
                }
                var expanded = Vm.IsExpanded(item.Id);
                var groupActive = href is not null && Vm.PathMatches(href);
                <div class="nav-group">
            <button class="dcnav nav-group-toggle@(groupActive ? " active" : null)"
                            @onclick="@(() => Vm.ToggleGroup(item.Id))" title="@item.Label">
                <span class="bar"></span>@((MarkupString)Vm.IconMarkup(string.IsNullOrWhiteSpace(item.Icon) ? item.Id : item.Icon))<span class="nav-label">@item.Label</span>
                        <span class="nav-caret-icon @(expanded ? "open" : null)">@((MarkupString)MainLayoutViewModel.CaretMarkup)</span>
                    </button>
                    @if (expanded)
                    {
                        <div class="nav-children">
                            @foreach (var child in children)
                            {
                                var childHref = Vm.AbsoluteHref(child.Href) ?? "/";
                                    <NavLink class="dcnav nav-child" href="@childHref" Match="NavLinkMatch.Prefix" title="@child.Label">
                                    <span class="bar"></span><span class="nav-label">@child.Label</span>
                                </NavLink>
                            }
                            @if (Vm.IsEntitiesGroup(item))
                            {
                                @foreach (var e in Vm.Entities)
                                {
                                    var entityPath = $"/project/{Vm.CurrentProjectId}/entity/{Uri.EscapeDataString(e)}";
                                        <button class="dcnav nav-child @(Vm.IsEntityActive(e) ? "active" : "")"
                                            @onclick="@(() => Vm.GoTo(entityPath))" title="@e">
                                        <span class="bar"></span><span class="nav-label">@e</span>
                                    </button>
                                }
                            }
                        </div>
                    }
                </div>
            }
        </div>

        <div class="user-bar">
            <AuthorizeView>
                <Authorized>
                    <div class="user-info">
                        <div class="user-avatar">@Vm.Initials(context.User.Identity?.Name)</div>
                        <div class="user-detail">
                            <div class="user-name">@context.User.Identity?.Name</div>
                            <div class="user-role">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <span class="not-signed-in">Not signed in</span>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </aside>

    @* Mobile nav backdrop — click anywhere outside the sidebar to close it. *@
    @if (Vm.NavOpen)
    {
        <div class="nav-backdrop" @onclick="Vm.CloseNavigation"></div>
    }

    <!-- MAIN -->
    <main class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="nav-toggle" @onclick="Vm.ToggleNavigation" title="Menu" aria-label="Toggle navigation">
                    <svg class="shell-control-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
                </button>
                <span class="title-14">@Vm.Title</span>
                <span class="topbar-sub">@Vm.Subtitle</span>
            </div>
            <div class="topbar-right">
                <button class="dcsearch-trigger" @onclick="Vm.OpenSearch">
                    <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
                    <span class="dcsearch-text">Search context, files, changes</span>
                    <kbd>/</kbd>
                </button>
                <div class="running-badge">
                    <span class="running-dot"></span>
                    @Vm.RunningCount running
                </div>
                <NotificationsBell />
                <AuthorizeView>
                    <Authorized>
                        <div class="topbar-switcher-wrap switcher-wrap">
                            <div @onclick="Vm.ToggleSwitcher"
                                 class="topbar-switcher-pill switcher-pill">
                                <span class="switcher-dot"></span>
                                <span class="topbar-switcher-name switcher-name">
                                    @(Vm.CurrentProjectName ?? "select project")
                                </span>
                                <span class="topbar-switcher-caret switcher-caret">▾</span>
                            </div>
                            @if (Vm.SwitcherOpen)
                            {
                                <div class="switcher-menu">
                                    @foreach (var p in Vm.Projects)
                                    {
                                        <div @onclick="@(() => Vm.SwitchProjectAsync(p))"
                                             class="switcher-item" style="background:@(p.Id == Vm.CurrentProjectId ? "var(--card-2)" : "transparent")">
                                            <span class="switcher-item-dot" style="background:@(p.Id == Vm.CurrentProjectId ? "var(--good)" : "var(--border-2)")"></span>
                                            <span class="switcher-item-name">@p.Name</span>
                                        </div>
                                    }
                                    @if (Vm.Projects.Count == 0)
                                    {
                                        <div class="switcher-empty">No projects yet — <a href="/wiki/getting-started">open the getting-started guide</a>.</div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="user-actions topbar-user-actions">
                            <form method="post" action="/auth/logout" class="logout-form">
                                <AntiforgeryToken />
                                <button type="submit" title="Sign out" class="icon-btn">
                                    <svg class="shell-control-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" /></svg>
                                </button>
                            </form>
                            <button @onclick="ToggleTheme" title="Switch to @Vm.ThemeSwitchLabel mode"
                                    aria-label="Switch to @Vm.ThemeSwitchLabel mode"
                                    aria-pressed="@Vm.IsThemeLightPressed" class="icon-btn">
                                @((MarkupString)Vm.ThemeIcon)
                            </button>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>


        <div class="body-scroll">
            @Body
        </div>
    </main>

    @if (Vm.SearchOpen)
    {
        <div class="dcsearch-overlay" @onclick="Vm.CloseSearch">
            <div class="dcsearch-modal" role="dialog" aria-modal="true" aria-label="Search workspace"
                 @onclick:stopPropagation="true">
                <input class="dcsearch-input" placeholder="Search projects, changes, context, decisions…"
                       value="@Vm.SearchTerm" @oninput="OnSearchInput" @onkeydown="OnSearchKey" @ref="_searchInput" />
                <div class="dcsearch-results">
                    @if (Vm.Searching)
                    {
                        <div class="dcsearch-empty">Searching…</div>
                    }
                    else if (Vm.SearchResults is { Hits.Count: > 0 })
                    {
                        @foreach (var h in Vm.SearchResults.Hits)
                        {
                            <button class="dcsearch-hit" @onclick="@(() => Vm.GoToSearchResult(h))">
                                <span class="dcsearch-kind">@h.Kind</span>
                                <span class="dcsearch-title">
                                    <div class="t">@h.Title</div>
                                    <div class="s">@h.Subtitle</div>
                                </span>
                            </button>
                        }
                    }
                    else if (!string.IsNullOrWhiteSpace(Vm.SearchTerm) && Vm.SearchTerm.Trim().Length >= 2)
                    {
                        <div class="dcsearch-empty">No matches for “@Vm.SearchTerm”.</div>
                    }
                    else
                    {
                        <div class="dcsearch-empty">Type at least 2 characters to search this workspace.</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private ElementReference _searchInput;
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override Task OnInitializedAsync() => Vm.InitializeAsync();
    protected override Task OnAfterRenderAsync(bool firstRender) => Vm.AfterRenderAsync(firstRender, _searchInput);
    private Task OnSearchInput(ChangeEventArgs args) => Vm.SearchAsync(args.Value?.ToString());
    private void OnSearchKey(KeyboardEventArgs args) => Vm.HandleSearchKey(args.Key);
    private Task ToggleTheme() => Vm.ToggleThemeAsync();
    public void Dispose() => Vm.Dispose();
}
