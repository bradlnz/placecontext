@inherits LayoutComponentBase
@implements IDisposable
@inject PortalUiState Ui
@inject IConfiguration Config
@inject IPlaceContextService Svc
@inject PlaceContext.Application.Ports.ICurrentTenant Tenant
@inject IJSRuntime JS
@inject NavigationManager Nav

<div id="dcshell" data-theme="dark" style="display:flex; height:100vh; width:100%; overflow:hidden; background:var(--bg)">

    <!-- SIDEBAR -->
    <aside style="width:236px; flex:none; display:flex; flex-direction:column; background:var(--panel); border-right:1px solid var(--border)">
        <div style="display:flex; align-items:center; gap:10px; padding:18px 18px 16px">
            <div style="width:28px; height:28px; flex:none; border-radius:7px; background:var(--brand); display:flex; align-items:center; justify-content:center">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8l3.5 4L5 16"></path><path d="M13 16h6"></path></svg>
            </div>
            <div style="display:flex; flex-direction:column; line-height:1.15">
                <span style="font-size:14px; font-weight:600; letter-spacing:-.2px">PlaceContext</span>
                <span style="font-size:10.5px; color:var(--text-3); font-family:'Geist Mono',monospace">@OrgName</span>
            </div>
        </div>

        <div style="padding:6px 12px; display:flex; flex-direction:column; gap:2px">
            <NavLink class="dcnav" href="onboarding"><span class="bar"></span>@Icon("rocket")<span style="flex:1">Onboarding</span></NavLink>

            <div style="font-size:10px; font-weight:600; letter-spacing:.7px; color:var(--text-3); padding:14px 10px 6px; text-transform:uppercase">Workspace</div>
            <NavLink class="dcnav" href="/" Match="NavLinkMatch.All"><span class="bar"></span>@Icon("grid") Overview</NavLink>
            <NavLink class="dcnav" href="debt"><span class="bar"></span>@Icon("debt")<span style="flex:1">Debt &amp; Trust</span></NavLink>
            <NavLink class="dcnav" href="cost"><span class="bar"></span>@Icon("debt")<span style="flex:1">Tokens &amp; Cost</span></NavLink>
            <NavLink class="dcnav" href="ledger"><span class="bar"></span>@Icon("ledger") Change Ledger</NavLink>
            <NavLink class="dcnav" href="requirements"><span class="bar"></span>@Icon("debt")<span style="flex:1">Code Requirements</span></NavLink>
            <NavLink class="dcnav" href="inspector"><span class="bar"></span>@Icon("inspector")<span style="flex:1">MCP Inspector</span><span style="width:7px; height:7px; border-radius:50%; background:var(--good); animation:dcpulse 1.8s ease-in-out infinite"></span></NavLink>

            <div style="font-size:10px; font-weight:600; letter-spacing:.7px; color:var(--text-3); padding:14px 10px 6px; text-transform:uppercase">Settings</div>
            <NavLink class="dcnav" href="settings/github"><span class="bar"></span>@Icon("github")<span style="flex:1">GitHub</span></NavLink>
            <AuthorizeView Roles="Owner,Admin" Context="adminCtx">
                <NavLink class="dcnav" href="settings/members"><span class="bar"></span>@Icon("grid")<span style="flex:1">Members</span></NavLink>
            </AuthorizeView>
        </div>

        <div style="margin:14px 12px 6px; padding:10px 10px 4px; border-top:1px solid var(--border)">
            <div style="display:flex; align-items:center; gap:6px; padding:4px 2px 2px; font-size:11px; color:var(--text-3)">
                <span style="width:6px; height:6px; border-radius:50%; background:var(--good)"></span>
                @_projectCount @(_projectCount == 1 ? "project" : "projects") in this workspace
            </div>
        </div>

        <div style="margin-top:auto; padding:12px; border-top:1px solid var(--border); display:flex; align-items:center; justify-content:space-between">
            <AuthorizeView>
                <Authorized>
                    <div style="display:flex; align-items:center; gap:8px; min-width:0">
                        <div style="width:26px; height:26px; flex:none; border-radius:6px; background:var(--card-2); border:1px solid var(--border); display:flex; align-items:center; justify-content:center; font-size:11px; font-weight:600; color:var(--text-2); font-family:'Geist Mono',monospace">@Initials(context.User.Identity?.Name)</div>
                        <div style="min-width:0">
                            <div style="font-size:12px; color:var(--text-2); white-space:nowrap; overflow:hidden; text-overflow:ellipsis">@context.User.Identity?.Name</div>
                            <div style="font-size:10px; color:var(--text-3)">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a href="/login" style="font-size:12px; color:var(--text-2); text-decoration:none">Sign in</a>
                </NotAuthorized>
            </AuthorizeView>
            <div style="display:flex; align-items:center; gap:6px; flex:none">
                <form method="post" action="/auth/logout" style="margin:0">
                    <button type="submit" title="Sign out" style="width:30px; height:30px; border-radius:7px; border:1px solid var(--border); background:var(--card); cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--text-2)">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><path d="M16 17l5-5-5-5"></path><path d="M21 12H9"></path></svg>
                    </button>
                </form>
                <button @onclick="ToggleTheme" title="Toggle theme" style="width:30px; height:30px; border-radius:7px; border:1px solid var(--border); background:var(--card); cursor:pointer; display:flex; align-items:center; justify-content:center; color:var(--text-2)">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.5 1.5M17.5 17.5L19 19M19 5l-1.5 1.5M6.5 17.5L5 19"></path></svg>
                </button>
            </div>
        </div>
    </aside>

    <!-- MAIN -->
    <main style="flex:1; min-width:0; display:flex; flex-direction:column; overflow:hidden">
        <header style="height:54px; flex:none; display:flex; align-items:center; justify-content:space-between; padding:0 24px; border-bottom:1px solid var(--border); background:var(--panel)">
            <div style="display:flex; align-items:center; gap:10px; min-width:0">
                <span style="font-size:14px; font-weight:600; letter-spacing:-.2px">@Ui.Title</span>
                <span style="font-size:12px; color:var(--text-3); font-family:'Geist Mono',monospace; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">@Ui.Sub</span>
            </div>
            <div style="display:flex; align-items:center; gap:10px; flex:none">
                <button class="dcsearch-trigger" @onclick="OpenSearch">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path></svg>
                    Search context, files, changes
                    <kbd>/</kbd>
                </button>
                <div style="display:flex; align-items:center; gap:6px; padding:6px 11px; background:var(--good-bg); border-radius:7px; color:var(--good); font-size:12px; font-weight:500">
                    <span style="width:6px; height:6px; border-radius:50%; background:var(--good); animation:dcpulse 1.8s ease-in-out infinite"></span>
                    MCP @(_mcpLabel)
                </div>
            </div>
        </header>

        <div style="flex:1; overflow-y:auto; overflow-x:hidden">
            @Body
        </div>
    </main>

    @if (_searchOpen)
    {
        <div class="dcsearch-overlay" @onclick="CloseSearch">
            <div class="dcsearch-modal" @onclick:stopPropagation="true">
                <input class="dcsearch-input" placeholder="Search projects, changes, context, decisions…"
                       value="@_term" @oninput="OnSearchInput" @onkeydown="OnSearchKey" @ref="_searchInput" />
                <div class="dcsearch-results">
                    @if (_searching)
                    {
                        <div class="dcsearch-empty">Searching…</div>
                    }
                    else if (_results is { Hits.Count: > 0 })
                    {
                        @foreach (var h in _results.Hits)
                        {
                            <button class="dcsearch-hit" @onclick="@(() => Go(h))">
                                <span class="dcsearch-kind">@h.Kind</span>
                                <span class="dcsearch-title">
                                    <div class="t">@h.Title</div>
                                    <div class="s">@h.Subtitle</div>
                                </span>
                            </button>
                        }
                    }
                    else if (!string.IsNullOrWhiteSpace(_term) && _term.Trim().Length >= 2)
                    {
                        <div class="dcsearch-empty">No matches for “@_term”.</div>
                    }
                    else
                    {
                        <div class="dcsearch-empty">Type at least 2 characters to search this workspace.</div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private int _projectCount;
    private string _mcpLabel = "live";
    private string OrgName => string.IsNullOrEmpty(Tenant.Slug) ? "organisation" : Tenant.Slug;
    private string RootPath => Config["PlaceContext:RootPath"] ?? "/home/brad/code";

    protected override void OnInitialized() => Ui.OnChanged += OnUiChanged;

    protected override async Task OnInitializedAsync()
    {
        try { _projectCount = (await Svc.GetProjectsAsync()).Count; } catch { _projectCount = 0; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("placecontext.initTheme");
        await JS.InvokeVoidAsync("placecontext.animateMeters");

        if (_focusSearch)
        {
            _focusSearch = false;
            try { await _searchInput.FocusAsync(); } catch { /* element not ready */ }
        }
    }

    private async Task ToggleTheme() => await JS.InvokeVoidAsync("placecontext.toggleTheme");

    // ---- Workspace search ----
    private bool _searchOpen;
    private bool _focusSearch;
    private bool _searching;
    private string _term = "";
    private SearchResultsView? _results;
    private ElementReference _searchInput;

    private void OpenSearch()
    {
        _searchOpen = true;
        _focusSearch = true;
        _term = "";
        _results = null;
    }

    private void CloseSearch() => _searchOpen = false;

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _term = e.Value?.ToString() ?? "";
        var term = _term.Trim();
        if (term.Length < 2) { _results = null; return; }

        _searching = true;
        try { _results = await Svc.SearchAsync(term); }
        catch { _results = null; }
        finally { _searching = false; }
    }

    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseSearch();
    }

    private void Go(SearchHit hit)
    {
        CloseSearch();
        Nav.NavigateTo(hit.Url);
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(new[] { ' ', '.', '@', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => string.Concat(parts[0][0], parts[1][0]).ToUpperInvariant()
        };
    }

    private void OnUiChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Ui.OnChanged -= OnUiChanged;

    private RenderFragment Icon(string kind) => builder =>
    {
        var path = kind switch
        {
            "grid" => "<rect x='3' y='3' width='7' height='7' rx='1.5'></rect><rect x='14' y='3' width='7' height='7' rx='1.5'></rect><rect x='14' y='14' width='7' height='7' rx='1.5'></rect><rect x='3' y='14' width='7' height='7' rx='1.5'></rect>",
            "debt" => "<path d='M12 3.5L21.5 20H2.5z'></path><path d='M12 10v4'></path><path d='M12 17.2v.01'></path>",
            "ledger" => "<circle cx='6' cy='6' r='2.4'></circle><circle cx='6' cy='18' r='2.4'></circle><path d='M6 8.5v7'></path><path d='M18 8.5a3.5 3.5 0 0 1-3.5 3.5H10'></path><circle cx='18' cy='6' r='2.4'></circle>",
            "rocket" => "<path d='M5 13c-1.5 1.3-2 5-2 5s3.7-.5 5-2'></path><path d='M9 11a14 14 0 0 1 7-8c2.6 0 4 1.4 4 4a14 14 0 0 1-8 7l-3-3z'></path><circle cx='14.5' cy='9.5' r='1.4'></circle>",
            "github" => "<path d='M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.3 2.1 5.3 2.4 5.3 2.4a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 3.9 8.8c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21'></path>",
            _ => "<rect x='3' y='4' width='18' height='16' rx='2'></rect><path d='M7 9l3 2.5L7 14'></path><path d='M13 14.5h4'></path>"
        };
        builder.AddMarkupContent(0, $"<svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'>{path}</svg>");
    };
}
