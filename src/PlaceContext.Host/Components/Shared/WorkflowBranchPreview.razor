@using PlaceContext.Application.Dtos

<ol class="branch-steps">
    @foreach (var (stage, index) in Stages.Select((stage, index) => (stage, index)))
    {
        var path = $"{PathPrefix}/{index}";
        <li>
            @if (stage.Gate is ConditionGateView condition)
            {
                <div class="branch-condition"><AppIcon Kind="split" /> @(condition.ReviewQuestion is null ? "If" : "Determine") <code>@(condition.ReviewQuestion ?? condition.Expression)</code></div>
            }
            else if (stage.Gate is WaitGateView wait)
            {
                <div><AppIcon Kind="clock" /> Wait @wait.DurationSeconds seconds</div>
            }
            <div class="@(stage.Gate is ConditionGateView ? "nested-paths" : null)">
            <div class="nested-path">
            @if (stage.Gate is ConditionGateView) { <div class="branch-condition">True</div> }
            @if (RunSteps is not null)
            {
                @foreach (var step in RunSteps.GetValueOrDefault(path) ?? [])
                {
                    <WorkflowRunStep Step="step" OnStepClick="OnStepClick" OnStepCancel="OnStepCancel" InspectActions="InspectActions" />
                }
            }
            else
            {
            @if (stage.Action is { } action)
            {
                <div class="branch-action"><AppIcon Kind="@ChainCanvasViewModel.StageIcon(stage)" /><span>@action.DisplayName</span></div>
                @if (action is ParallelWorkflowsChainActionView parallel && Depth < 8)
                {
                    <WorkflowPaths Action="parallel" Workflows="Workflows" Depth="@(Depth + 1)" />
                }
                else if (action is SubWorkflowChainActionView child && Depth < 8 && Workflows.FirstOrDefault(workflow => workflow.Id == child.WorkflowId) is { } childWorkflow)
                {
                    <WorkflowBranchPreview Stages="childWorkflow.Stages" Workflows="Workflows" Depth="@(Depth + 1)" />
                }
            }
            @foreach (var job in stage.Jobs)
            {
                @if (OnOpenJob.HasDelegate)
                { <button class="branch-job" @onclick="() => OnOpenJob.InvokeAsync(job.JobId)"><AppIcon Kind="code" /> @job.JobName</button> }
                else { <div class="branch-job"><AppIcon Kind="code" /> @job.JobName</div> }
                <JobCodeLink Job="@Jobs.FirstOrDefault(candidate => candidate.Id == job.JobId)" OnEdit="OnEditCode" />
            }
            }
            @if (stage.IsParallel)
            {
                <small><AppIcon Kind="parallel" /> Run together</small>
            }
            @if (stage.Gate is ConditionGateView) { <span class="nested-return" aria-hidden="true"></span> }
            </div>
            @if (stage.Gate is ConditionGateView)
            {
                <div class="nested-path">
                    <div class="branch-condition">False</div>
                    @if ((stage.ElseBranch ?? (stage.Gate as ConditionGateView)?.ElseBranch) is { Count: > 0 } other)
                    {
                        <WorkflowBranchPreview Jobs="Jobs" Workflows="Workflows" Depth="@(Depth + 1)" OnOpenJob="OnOpenJob" OnEditCode="OnEditCode" Stages="other" RunSteps="RunSteps" PathPrefix="@($"{path}/else")" OnStepClick="OnStepClick" OnStepCancel="OnStepCancel" InspectActions="InspectActions" />
                    }
                    else { <small>Continue without running this step</small> }
                    <span class="nested-return" aria-hidden="true"></span>
                </div>
            }
            </div>
            @if (stage.Gate is ConditionGateView) { <div class="nested-join"><AppIcon Kind="branch" /> Rejoin</div> }
        </li>
    }
</ol>

@code {
    [Parameter] public IReadOnlyList<JobView> Jobs { get; set; } = [];
    [Parameter] public IReadOnlyList<JobChainView> Workflows { get; set; } = [];
    [Parameter] public int Depth { get; set; }
    [Parameter] public EventCallback<Guid> OnOpenJob { get; set; }
    [Parameter] public EventCallback<JobView> OnEditCode { get; set; }
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<ChainStepRunView>>? RunSteps { get; set; }
    [Parameter] public string PathPrefix { get; set; } = "";
    [Parameter] public bool InspectActions { get; set; }
    [Parameter] public EventCallback<ChainStepRunView> OnStepClick { get; set; }
    [Parameter] public EventCallback<ChainStepRunView> OnStepCancel { get; set; }
    [Parameter, EditorRequired] public IReadOnlyList<JobChainStageView> Stages { get; set; } = [];
}
