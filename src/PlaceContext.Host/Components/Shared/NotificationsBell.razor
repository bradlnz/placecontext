@implements IDisposable
@inject NotificationsViewModel Vm
@using PlaceContext.Infrastructure.Operations
@using PlaceContext.Host.Components.ViewModels

@* Azure-style notifications: the bell shows how many background operations are live; the pane
   lists recent operations for this tenant. Operations run server-side in OperationCenter, so
   navigating between pages (or closing the pane) never interrupts them. *@

<button title="Notifications" @onclick="Vm.Toggle" class="bell-btn">
    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.7 21a2 2 0 0 1-3.4 0"></path>
    </svg>
    @if (Vm.ActiveCount > 0)
    {
        <span class="bell-badge">@Vm.ActiveCount</span>
    }
</button>

@if (Vm.IsOpen)
{
    <div class="overlay" @onclick="Vm.Close"></div>
    <div class="dccard pane">
        <div class="pane-head">
            <span class="pane-title">Notifications</span>
            <span class="pane-status">@Vm.ActiveSummary</span>
        </div>
        @if (Vm.Operations.Count == 0)
        {
            <div class="pane-empty">
                Nothing yet — background work (job runs, chart sweeps, rebuilds) shows up here.
            </div>
        }
        @foreach (var op in Vm.Operations)
        {
            <div class="op">
                <span class="op-icon">
                    <span class="@Vm.StatusClass(op.Status)">@Vm.StatusIcon(op.Status)</span>
                </span>
                <div class="op-body">
                    <div class="op-title">@op.Title</div>
                    <div class="op-meta">
                        @NotificationsViewModel.StatusLine(op)
                    </div>
                    @if (op.Outcome is { Length: > 0 })
                    {
                        <div class="op-outcome" style="color:@Vm.OutcomeStyle(op.Status)">@op.Outcome</div>
                    }
                </div>
                @if (op.Link is not null)
                {
                    <button class="dcbtn op-view"
                            @onclick="@(() => Vm.Open(op.Link))">view</button>
                }
            </div>
        }
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Vm.Attach(() => InvokeAsync(StateHasChanged));
        Vm.Initialize();
    }

    public void Dispose() => Vm.Dispose();
}
