@* Second-level navigation within the project's Data area. This component is intentionally
   presentational: its typed model and route catalog are supplied by Components.Models. *@
<div class="dctabs tabs-strip">
    @foreach (var item in DataSectionNavigation.Items)
    {
        <a class="dctab @(Active == item.Section ? "active" : string.Empty)"
           href="@DataSectionNavigation.Route(ProjectId, item)">
            @item.Label
        </a>
    }
</div>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    [Parameter]
    public DataSection Active { get; set; } = DataSection.Tables;
}
