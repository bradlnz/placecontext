@using PlaceContext.Application.Ports
@inject QemuDesktopViewModel Vm
@implements IAsyncDisposable

@if (Vm.Status is { } status)
{
    <section class="desktop-panel" aria-label="Live QEMU desktop">
        <div class="desktop-head">
            <div><h3>Live preview <span class="desktop-lock">@(status.State == "Human" ? "Control unlocked" : "View only")</span></h3><p role="status">@(status.State switch {
                "Starting" => "Starting the browser…", "Pausing" => "Waiting for the agent to reach a safe pause…",
                "Human" => "You have control. The agent and replay capture are paused.", "Saving" => "Saving your private browser session…",
                _ => "Automation is running. Take control to unlock the desktop." })</p></div>
            @if (status.State == "Human")
            {
                <button class="dcbtn primary" disabled="@Vm.Busy" @onclick="Vm.ResumeAsync">Resume automation</button>
            }
            else if (status.State == "Running")
            {
                <button class="dcbtn primary" disabled="@Vm.Busy" @onclick="Vm.TakeControlAsync">Take control</button>
            }
            <button class="dcbtn" disabled="@(status.State == "Starting")" @onclick="Vm.ReconnectAsync">Reconnect</button>
        </div>
        @if (Vm.Error is not null) { <p role="alert">@Vm.Error</p> }
        @if (status.Message is not null) { <p role="status">@status.Message</p> }
        <div id="@Vm.ElementId" class="desktop-screen" role="region" aria-label="@(status.State == "Human" ? "Interactive virtual desktop" : "Live desktop preview, input locked")" tabindex="@(status.State == "Human" ? 0 : -1)"></div>
        @if (status.State == "Human")
        {
            <div class="desktop-save">
                <div><label for="@(Vm.ElementId + "-name")">Save login for future tests</label><input id="@(Vm.ElementId + "-name")" class="dcinput" maxlength="80" @bind="Vm.LoginName" placeholder="My staging account" /></div>
                <button class="dcbtn" disabled="@(Vm.Busy || string.IsNullOrWhiteSpace(Vm.LoginName))" @onclick="Vm.SaveLoginAsync">Save login</button>
            </div>
            <p class="desktop-note">Private to you in this project. Saving briefly restarts Chromium. Finish login before saving or resuming; closing this pane leaves the agent paused until the step times out.</p>
        }
    </section>
}
@code {
    [Parameter, EditorRequired] public QemuRunContext Run { get; set; } = default!;
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override Task OnParametersSetAsync() => Vm.SetRunAsync(Run);
    protected override Task OnAfterRenderAsync(bool firstRender) => Vm.AfterRenderAsync();
    public ValueTask DisposeAsync() => Vm.DisposeAsync();
}
