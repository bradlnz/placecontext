@using PlaceContext.Application.Build
<div class="agent-panel">
    @if (ShowNavigation)
    {
    <nav aria-label="Agent settings" class="agent-tabs">
        @foreach (var tab in new[] { "Instructions", "Context & tools", "Sub-agents", "Dashboard" })
        {
            <button type="button" class="dcbtn" aria-pressed="@(Vm.AgentTab == tab ? "true" : "false")" @onclick="() => Vm.AgentTab = tab">@tab</button>
        }
    </nav>
    }
    <p class="hint">Private to you in this project. The agent uses your permissions; these settings cannot grant access or expose vault credentials.</p>
    <a class="dcbtn" href="/project/@Vm.Conversation.ProjectId/agents">Manage project agents</a>
    @if (Vm.AgentLoading)
    {
        <Skeleton Kind="list" Rows="3" />
    }
    else if (Vm.AgentTab == "Instructions")
    {
        <label for="agent-profile">Configure agent</label>
        <select id="agent-profile" @bind="Vm.AgentEditId" disabled="@Vm.Locked">@foreach (var profile in Vm.AgentDraft.Agents) { <option value="@profile.Id">@profile.DisplayName</option> }</select>
        <button type="button" class="dcbtn" disabled="@(Vm.Locked || Vm.AgentDraft.Agents.Count >= 8)" @onclick="Vm.AddAgent">Add agent</button>
        @if (Vm.EditedAgent is { } edited)
        {
            <label for="agent-name">Agent name</label><input id="agent-name" maxlength="60" @bind="edited.Name" disabled="@Vm.Locked" />
            <label for="agent-connection">Model connection</label>
            <select id="agent-connection" value="@edited.ConnectionId" @onchange="e => Vm.SelectAgentConnection(e.Value?.ToString())" disabled="@Vm.Locked"><option value="@Guid.Empty">Select connection</option>@foreach (var connection in Vm.Connections) { <option value="@connection.Id">@connection.Name</option> }</select>
            <label for="agent-model">Model</label><select id="agent-model" @bind="edited.Model" disabled="@Vm.Locked"><option value="">Select model</option>@foreach (var model in Vm.AgentModels) { <option>@model</option> }</select>
            <a href="/settings/models">Manage model connections</a>
            <label for="agent-profile-instructions">Agent instructions</label><textarea id="agent-profile-instructions" rows="5" maxlength="8000" @bind="edited.Instructions" disabled="@Vm.Locked"></textarea>
            <fieldset class="agent-mcp"><legend>MCP connections</legend>
                <p class="hint">Only assigned, enabled connections are available to this agent. MCP tools can read or change external systems; assign trusted connections only. Credentials stay in the vault.</p>
                @foreach (var connection in Vm.AgentMcpConnections)
                {
                    <label><input type="checkbox" checked="@edited.McpConnectionIds.Contains(connection.Id)" disabled="@(Vm.Locked || (!connection.Enabled && !edited.McpConnectionIds.Contains(connection.Id)))" @onchange="e => Vm.ToggleAgentMcp(connection.Id, e.Value is true)" /> @connection.Name @(!connection.Enabled ? "(disabled)" : "")</label>
                }
                @foreach (var missing in edited.McpConnectionIds.Where(id => !Vm.AgentMcpConnections.Any(c => c.Id == id)).ToArray())
                {
                    <label><input type="checkbox" checked disabled="@Vm.Locked" @onchange="e => Vm.ToggleAgentMcp(missing, false)" /> Unavailable connection · @missing</label>
                }
                @if (Vm.AgentMcpConnections.Count == 0) { <p class="hint">No MCP connections are configured in this project.</p> }
                <a href="/settings/mcp">Manage MCP connections</a>
            </fieldset>
        }
        <label for="agent-instructions">Shared project instructions</label>
        <textarea id="agent-instructions" rows="6" maxlength="8000" @bind="Vm.AgentDraft.Instructions" disabled="@Vm.Locked" placeholder="How should the agent work with you?"></textarea>
        <button class="dcbtn primary" disabled="@Vm.Locked" @onclick="Vm.SaveAgentAsync">Save agents</button>
        <details open><summary>Current chat agent system prompt</summary><p class="hint">Rendered for the agent selected in the chat header, using the same template as execution, current project context and saved preferences. Unsaved edits are not included.</p><RunOutput Value="@Vm.AgentPrompt" Language="plaintext" Label="Current agent system prompt" /></details>
        <details><summary>Jev dashboard routing</summary><p class="hint">The Run a workflow tile opens the picker directly, without AI. For a short first chat message, Jev can open the same picker at confidence ≥ 0.85. A two-second timeout, unavailable Jev, or an uncertain decision falls back to normal chat. Follow-ups use the chat model. Routing never starts a run.</p><RunOutput Value="@BuildChatAgent.WorkflowPickerQuestion" Language="plaintext" Label="Jev routing instructions" /></details>
        @if (Vm.Conversation.SystemPrompt is { } lastPrompt)
        {
            <details><summary>Last recorded prompt used in this conversation</summary><RunOutput Value="@lastPrompt" Language="plaintext" Label="Recorded system prompt" /></details>
        }
    }
    else if (Vm.AgentTab == "Context & tools")
    {
        <h3>Project context</h3>
        <p>The agent starts with jobs, workflows, schedules and recent run summaries that you can access. It retrieves approved source records, artifacts and detailed output through tools when needed—not every record is sent with every message.</p>
        <p>Chat messages, tool calls and results are visible in the conversation. Credentials and private model reasoning are not shown.</p>
        <label for="agent-memory">Saved project memory</label>
        <textarea id="agent-memory" rows="6" maxlength="8000" @bind="Vm.AgentMemory" disabled="@Vm.Locked"></textarea>
        <button class="dcbtn" disabled="@Vm.Locked" @onclick="Vm.SaveAgentMemoryAsync">Save memory</button>
        <details><summary>Available tools and input schemas</summary><p class="hint">Each call is checked against your permissions and this project. A listed tool does not grant permission to use it.</p><RunOutput Value="@Vm.Presentation.Json(Vm.AgentTools)" Label="Agent tools" /></details>
        @if (Vm.Conversation.ToolSchema is { } lastTools)
        {
            <details><summary>Last recorded tool schemas</summary><RunOutput Value="@Vm.Presentation.Json(lastTools)" Label="Recorded tool schemas" /></details>
        }
    }
    else if (Vm.AgentTab == "Sub-agents")
    {
        <h3>Workflow agents</h3>
        <p>Delegate work using automatic agent steps in workflows. Each has its own task and model, runs with bounded project tools, and records activity and output on the run.</p>
        <details><summary>Shared sub-agent system prompt</summary><RunOutput Value="@WorkflowAgentRunner.SystemPrompt" Language="plaintext" Label="Workflow agent system prompt" /></details>
        @foreach (var workflow in Vm.AgentWorkflows.Where(w => BuildChatViewModel.SubAgents(w.Stages).Any()))
        {
            <section class="agent-card">
                <h3>@workflow.Name</h3>
                @foreach (var subAgent in BuildChatViewModel.SubAgents(workflow.Stages))
                {
                    <p><strong>@subAgent.Model</strong> · Output: @subAgent.ResponseField</p>
                    <RunOutput Value="@subAgent.Instructions" Language="plaintext" Label="Sub-agent task instructions" />
                }
                <a href="@($"/project/{Vm.Conversation.ProjectId}/workflows/{workflow.Id}")">Manage workflow agents <AppIcon Kind="arrow-right" /></a>
            </section>
        }
        @if (!Vm.AgentWorkflows.Any(w => BuildChatViewModel.SubAgents(w.Stages).Any()))
        {
            <p class="hint">No automatic agent steps are configured in the workflows you can access.</p>
        }
        <a class="dcbtn" href="@($"/project/{Vm.Conversation.ProjectId}/workflows")">Open workflows</a>
    }
    else if (Vm.AgentTab == "Dashboard")
    {
        <h3>Quick actions</h3>
        <p>Run a workflow opens the picker immediately, without waiting for AI. It only lists workflows the selected agent can run. Custom tiles send a visible request to chat. The agent can ask follow-up questions before acting.</p>
        <div class="agent-card"><strong>Run a workflow</strong><span class="hint">System tile · always available · cannot be removed</span></div>
        @foreach (var action in Vm.AgentDraft.Actions.ToArray())
        {
            <div class="agent-card" @key="action.Id">
                <label for="@($"tile-title-{action.Id}")">Tile title</label>
                <input id="@($"tile-title-{action.Id}")" maxlength="60" value="@action.Title" @onchange="@(e => Vm.EditDashboardAction(action.Id, e.Value?.ToString() ?? "", action.Prompt))" disabled="@(Vm.Locked || Vm.AgentLoading)" />
                <label for="@($"tile-prompt-{action.Id}")">Request sent to chat</label>
                <textarea id="@($"tile-prompt-{action.Id}")" rows="4" maxlength="2000" value="@action.Prompt" @onchange="@(e => Vm.EditDashboardAction(action.Id, action.Title, e.Value?.ToString() ?? ""))" disabled="@(Vm.Locked || Vm.AgentLoading)"></textarea>
                <button class="dcbtn" disabled="@(Vm.Locked || Vm.AgentLoading)" @onclick="() => Vm.RemoveDashboardAction(action)">Remove @action.Title</button>
            </div>
        }
        <label for="dashboard-action-title">Tile title</label><input id="dashboard-action-title" maxlength="60" @bind="Vm.NewActionTitle" disabled="@Vm.Locked" />
        <label for="dashboard-action-prompt">Request sent to chat</label><textarea id="dashboard-action-prompt" rows="3" maxlength="2000" @bind="Vm.NewActionPrompt" disabled="@Vm.Locked"></textarea>
        <button class="dcbtn" disabled="@(Vm.Locked || Vm.AgentLoading || Vm.AgentDraft.Actions.Count >= 8)" @onclick="Vm.AddDashboardAction">Add tile</button>
        <h3>Pinned charts</h3>
        <p>Ask the assistant for a live chart, then choose Pin to dashboard. Charts query current project data when opened and every 10 seconds.</p>
        @foreach (var chart in Vm.AgentDraft.Charts.ToArray())
        {
            <div class="agent-card" @key="chart.Id">
                <strong>@(PlaceContext.Application.Features.ChartSpec.TryParse(chart.ChartJson)?.Title ?? "Chart")</strong><p>@chart.Source</p>
                <button class="dcbtn" disabled="@(Vm.Locked || Vm.AgentLoading)" @onclick="() => Vm.RemoveDashboardChart(chart)">Remove chart</button>
            </div>
        }
        <button class="dcbtn primary" disabled="@(Vm.Locked || Vm.AgentLoading)" @onclick="Vm.SaveAgentAsync">Save dashboard</button>
    }
    @if (Vm.AgentError is { } error) { <p role="alert">@error</p> }
    @if (Vm.AgentNotice is { } notice) { <p role="status">@notice</p> }
    <button type="button" class="dcbtn" disabled="@Vm.AgentLoading" @onclick="Vm.OpenAgentAsync">Refresh configuration</button>
</div>
@code {
    [Parameter] public bool ShowNavigation { get; set; } = true;
    [Parameter, EditorRequired] public BuildChatViewModel Vm { get; set; } = null!;
}
