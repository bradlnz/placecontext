@using PlaceContext.Application.Dtos
@inject IJSRuntime JS
@implements IAsyncDisposable

<div style="@(_fullscreen ? "position:fixed; inset:0; z-index:200; background:var(--bg); padding:14px; display:flex; flex-direction:column" : "position:relative")">
    @if (Searchable || AllowFullscreen)
    {
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px; @(_fullscreen ? "" : "position:absolute; top:8px; left:10px; right:10px; z-index:5")">
            @if (Searchable)
            {
                <div style="position:relative; width:280px">
                    <input class="dcinput" style="width:100%; padding:5px 10px; font-size:12px" placeholder="search nodes…"
                           value="@_search" @oninput="OnSearchInput" />
                    @if (_matches.Count > 0)
                    {
                        <div style="position:absolute; top:calc(100% + 4px); left:0; right:0; background:var(--card); border:1px solid var(--border-2); border-radius:8px; box-shadow:var(--shadow); z-index:10; padding:4px; max-height:260px; overflow-y:auto">
                            @foreach (var m in _matches)
                            {
                                <div @onclick="@(() => JumpAsync(m.Id))"
                                     style="padding:6px 9px; border-radius:6px; cursor:pointer; font-size:12px" class="dcdash-row">
                                    <div style="font-family:'IBM Plex Mono',monospace; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">@ShortLabel(m.Label)</div>
                                    @if (!string.IsNullOrWhiteSpace(m.Content))
                                    {
                                        <div style="font-size:10.5px; color:var(--text-3); white-space:nowrap; overflow:hidden; text-overflow:ellipsis">@m.Content</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            <span style="flex:1"></span>
            @if (AllowFullscreen)
            {
                <button class="dcbtn" style="padding:4px 11px; font-size:11.5px" @onclick="ToggleFullscreenAsync">
                    @(_fullscreen ? "✕ Exit full screen" : "⛶ Full screen")
                </button>
            }
        </div>
    }
    <canvas id="@_id" style="display:block; width:100%; @(_fullscreen ? "flex:1; min-height:0" : $"height:{Height}px")"></canvas>

    @* Details for the clicked node: computed from the graph data already on the circuit, no extra
       queries. Clicking a connection re-selects in the canvas too (pcgraph.select). *@
    @if (_selected is { } sel)
    {
        <div class="dccard" style="position:absolute; top:10px; right:10px; width:280px; max-height:@(Height - 20)px; overflow-y:auto; padding:12px 14px; box-shadow:0 8px 24px rgba(0,0,0,.35)">
            <div style="display:flex; align-items:start; gap:8px">
                <div style="flex:1; min-width:0">
                    <div style="font-size:12.5px; font-weight:600; word-break:break-all">@ShortLabel(sel.Label)</div>
                    <div style="font-size:10.5px; color:var(--text-3); font-family:'IBM Plex Mono',monospace; word-break:break-all; margin-top:2px">@sel.Id</div>
                </div>
                <button class="dcbtn" style="padding:1px 7px; font-size:11px; flex:none" @onclick="ClearAsync">×</button>
            </div>
            @if (NodeUrl?.Invoke(sel) is { Length: > 0 } url)
            {
                <a class="dcbtn" href="@url" style="display:inline-flex; margin-top:8px; padding:4px 11px; font-size:11.5px; text-decoration:none">Open ↗</a>
            }
            <div style="display:flex; gap:6px; margin-top:8px; flex-wrap:wrap">
                @if (sel.IsGod)
                {
                    <span style="font-size:10px; padding:2px 7px; border-radius:4px; background:var(--brand); color:#fff">project hub</span>
                }
                <span style="font-size:10px; padding:2px 7px; border-radius:4px; background:var(--card-2); color:var(--text-3)">@sel.Degree connection(s)</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(sel.Content))
            {
                @* The note behind the node — decision rationale, a change's why, or run-output text. *@
                <div style="margin-top:10px; padding:9px 11px; background:var(--bg); border:1px solid var(--border); border-radius:7px; font-size:11.5px; color:var(--text-2); line-height:1.55; white-space:pre-wrap; word-break:break-word; max-height:160px; overflow-y:auto">@sel.Content</div>
            }
            @if (_selectedNeighbors.Any(x => x.Node.Kind == "good"))
            {
                @* Related artifacts lead — highlighted in the canvas, openable from here. *@
                <div style="font-size:10.5px; color:var(--text-3); margin:10px 0 4px; text-transform:uppercase; letter-spacing:.5px">Related artifacts</div>
                <div style="display:flex; flex-direction:column; gap:4px">
                    @foreach (var (node, _) in _selectedNeighbors.Where(x => x.Node.Kind == "good"))
                    {
                        <a href="@(NodeUrl?.Invoke(node) ?? "#")"
                           style="display:flex; align-items:center; gap:8px; padding:5px 9px; border:1px solid var(--good); border-radius:7px; background:var(--good-bg); font-size:11.5px; font-family:'IBM Plex Mono',monospace; color:var(--good); text-decoration:none">
                            <span style="flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap">@ShortLabel(node.Label)</span>
                            <span style="flex:none">↗</span>
                        </a>
                    }
                </div>
            }
            @if (_selectedNeighbors.Any(x => x.Node.Kind != "good"))
            {
                <div style="font-size:10.5px; color:var(--text-3); margin:10px 0 4px; text-transform:uppercase; letter-spacing:.5px">Connected to</div>
                <div style="display:flex; flex-direction:column; gap:3px">
                    @foreach (var (node, ambiguous) in _selectedNeighbors.Where(x => x.Node.Kind != "good"))
                    {
                        <div style="display:flex; align-items:center; gap:6px">
                            <button style="border:none; background:none; padding:2px 0; cursor:pointer; text-align:left; font-size:11.5px; font-family:'IBM Plex Mono',monospace; color:var(--brand-2); word-break:break-all; flex:1; min-width:0"
                                    title="@node.Id" @onclick="@(() => SelectAsync(node.Id))">
                                @ShortLabel(node.Label)@(ambiguous ? " ⇢" : "")
                            </button>
                            @if (NodeUrl?.Invoke(node) is { Length: > 0 } nurl)
                            {
                                <a href="@nurl" style="flex:none; font-size:11px; color:var(--text-3); text-decoration:none" title="Open">↗</a>
                            }
                        </div>
                    }
                </div>
                @if (_selectedNeighbors.Any(n => n.Ambiguous))
                {
                    <div style="font-size:10px; color:var(--warn); margin-top:6px">⇢ ambiguous link (low confidence)</div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public GraphVizView? Graph { get; set; }
    [Parameter] public int Height { get; set; } = 340;

    /// <summary>Optional: resolves a node to a destination — the details card then offers Open ↗.</summary>
    [Parameter] public Func<GraphNodeView, string?>? NodeUrl { get; set; }

    /// <summary>Show the node-search box (matches labels and content, jump-selects).</summary>
    [Parameter] public bool Searchable { get; set; }

    /// <summary>Offer the full-screen toggle.</summary>
    [Parameter] public bool AllowFullscreen { get; set; }

    private readonly string _id = "pcgraph-" + Guid.NewGuid().ToString("N");
    private GraphVizView? _rendered;
    private bool _needsInit;
    private DotNetObjectReference<GraphCanvas>? _selfRef;

    private GraphNodeView? _selected;
    private List<(GraphNodeView Node, bool Ambiguous)> _selectedNeighbors = new();

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_rendered, Graph)) { _rendered = Graph; _needsInit = true; _selected = null; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_needsInit || Graph is null || Graph.Nodes.Count == 0) return;
        _needsInit = false;

        var payload = new
        {
            nodes = Graph.Nodes.Take(180).Select(n => new { id = n.Id, label = n.Label, degree = n.Degree, god = n.IsGod, kind = n.Kind, labeled = n.Labeled }),
            links = Graph.Links.Take(500).Select(l => new { source = l.Source, target = l.Target, confidence = l.Confidence }),
        };
        _selfRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("pcgraph.init", _id, payload, _selfRef);
    }

    [JSInvokable]
    public Task OnNodeClick(string? nodeId)
    {
        _selected = nodeId is null ? null : Graph?.Nodes.FirstOrDefault(n => n.Id == nodeId);
        _selectedNeighbors = _selected is null || Graph is null
            ? new()
            : Graph.Links
                .Where(l => l.Source == _selected.Id || l.Target == _selected.Id)
                .Select(l => (Other: l.Source == _selected.Id ? l.Target : l.Source, Ambiguous: l.Confidence == "Ambiguous"))
                .Select(x => (Node: Graph.Nodes.FirstOrDefault(n => n.Id == x.Other), x.Ambiguous))
                .Where(x => x.Node is not null)
                .Select(x => (x.Node!, x.Ambiguous))
                .DistinctBy(x => x.Item1.Id)
                .OrderByDescending(x => x.Item1.Kind == "good")
                .ThenByDescending(x => x.Item1.Degree)
                .ToList();
        return InvokeAsync(StateHasChanged);
    }

    private Task SelectAsync(string nodeId) => JS.InvokeVoidAsync("pcgraph.select", _id, nodeId).AsTask();

    // ── Search + fullscreen chrome ────────────────────────────────────────────────────────────────
    private bool _fullscreen;
    private string _search = "";
    private List<GraphNodeView> _matches = new();

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        var term = _search.Trim();
        _matches = term.Length < 2 || Graph is null
            ? new List<GraphNodeView>()
            : Graph.Nodes
                .Where(n => n.Label.Contains(term, StringComparison.OrdinalIgnoreCase)
                         || (n.Content?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
                .OrderByDescending(n => n.Label.Contains(term, StringComparison.OrdinalIgnoreCase))
                .ThenByDescending(n => n.Degree)
                .Take(8)
                .ToList();
    }

    private async Task JumpAsync(string nodeId)
    {
        _matches.Clear();
        _search = "";
        await SelectAsync(nodeId); // centres the view and opens the connections card
    }

    private async Task ToggleFullscreenAsync()
    {
        _fullscreen = !_fullscreen;
        // The canvas element resizes with the container; pcgraph's ResizeObserver re-fits, and a
        // nudge keeps the selected node centred in the new viewport.
        await Task.Yield();
        if (_selected is { } sel) await SelectAsync(sel.Id);
    }
    private Task ClearAsync() => JS.InvokeVoidAsync("pcgraph.select", _id, null).AsTask();

    private static string ShortLabel(string s)
    {
        var i = s.LastIndexOf('/');
        var name = i >= 0 ? s[(i + 1)..] : s;
        return name.Length > 40 ? name[..39] + "…" : name;
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("pcgraph.destroy", _id); } catch { /* circuit gone */ }
        _selfRef?.Dispose();
    }
}
