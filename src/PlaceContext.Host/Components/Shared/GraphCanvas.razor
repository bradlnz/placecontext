@using PlaceContext.Application.Dtos
@inject IJSRuntime JS
@implements IAsyncDisposable

<div style="@(_fullscreen ? "position:fixed; inset:0; z-index:200; background:var(--bg); padding:14px; display:flex; flex-direction:column" : "position:relative")">
    @if (Searchable || AllowFullscreen)
    {
        <div class="chrome-bar" style="@(_fullscreen ? "" : "position:absolute; top:8px; left:10px; right:10px; z-index:5")">
            @if (Searchable)
            {
                <div class="search-wrap">
                    <input class="dcinput search-input" placeholder="search nodes…"
                           value="@_search" @oninput="OnSearchInput" />
                    @if (_matches.Count > 0)
                    {
                        <div class="search-drop">
                            @foreach (var m in _matches)
                            {
                                <div @onclick="@(() => JumpAsync(m.Id))"
                                     class="dcdash-row search-item">
                                    <div class="search-item-label">@ShortLabel(m.Label)</div>
                                    @if (!string.IsNullOrWhiteSpace(m.Content))
                                    {
                                        <div class="search-item-sub">@m.Content</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            <span class="flex-1"></span>
            @if (AllowFullscreen)
            {
                <button class="dcbtn btn-fs" @onclick="ToggleFullscreenAsync">
                    @(_fullscreen ? "✕ Exit full screen" : "⛶ Full screen")
                </button>
            }
        </div>
    }
    <canvas id="@_id" class="graph-canvas" style="@(_fullscreen ? "flex:1; min-height:0" : $"height:{Height}px")"></canvas>

    @* Details for the clicked node: computed from the graph data already on the circuit, no extra
       queries. Clicking a connection re-selects in the canvas too (pcgraph.select). *@
    @if (_selected is { } sel)
    {
        <div class="dccard detail-card" style="max-height:@(Height - 20)px">
            <div class="card-head">
                <div class="flex-min">
                    <div class="sel-label">@ShortLabel(sel.Label)</div>
                    <div class="sel-id">@sel.Id</div>
                </div>
                <button class="dcbtn card-x" @onclick="ClearAsync">×</button>
            </div>
            @if (NodeUrl?.Invoke(sel) is { Length: > 0 } url)
            {
                <a class="dcbtn open-link" href="@url">Open ↗</a>
            }
            <div class="badge-row">
                @if (sel.IsGod)
                {
                    <span class="badge-hub">project hub</span>
                }
                <span class="badge-deg">@sel.Degree connection(s)</span>
            </div>
            @if (!string.IsNullOrWhiteSpace(sel.Content))
            {
                @* The note behind the node — decision rationale, a change's why, or run-output text. *@
                <div class="sel-content">@sel.Content</div>
            }
            @if (_reachableArtifacts.Count > 0)
            {
                @* Related artifacts — including ones reached by stepping UP the tree from an
                   outer node (record → run → artifact), with the hop distance shown. *@
                <div class="section-cap">Related artifacts</div>
                <div class="col-4">
                    @foreach (var (node, hops) in _reachableArtifacts)
                    {
                        <a href="@(NodeUrl?.Invoke(node) ?? "#")"
                           class="artifact-link">
                            <span class="ellipsis-flex">@ShortLabel(node.Label)</span>
                            @if (hops > 1)
                            {
                                <span class="hops">@hops hops</span>
                            }
                            <span class="flex-none">↗</span>
                        </a>
                    }
                </div>
            }
            @if (_selectedNeighbors.Any(x => x.Node.Kind != "good"))
            {
                <div class="section-cap">Connected to</div>
                <div class="col-3">
                    @foreach (var (node, ambiguous) in _selectedNeighbors.Where(x => x.Node.Kind != "good"))
                    {
                        <div class="neighbor-row">
                            <button class="neighbor-btn"
                                    title="@node.Id" @onclick="@(() => SelectAsync(node.Id))">
                                @ShortLabel(node.Label)@(ambiguous ? " ⇢" : "")
                            </button>
                            @if (NodeUrl?.Invoke(node) is { Length: > 0 } nurl)
                            {
                                <a href="@nurl" class="neighbor-link" title="Open">↗</a>
                            }
                        </div>
                    }
                </div>
                @if (_selectedNeighbors.Any(n => n.Ambiguous))
                {
                    <div class="ambiguous-note">⇢ ambiguous link (low confidence)</div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public GraphVizView? Graph { get; set; }
    [Parameter] public int Height { get; set; } = 340;

    /// <summary>Optional: resolves a node to a destination — the details card then offers Open ↗.</summary>
    [Parameter] public Func<GraphNodeView, string?>? NodeUrl { get; set; }

    /// <summary>Show the node-search box (matches labels and content, jump-selects).</summary>
    [Parameter] public bool Searchable { get; set; }

    /// <summary>Offer the full-screen toggle.</summary>
    [Parameter] public bool AllowFullscreen { get; set; }

    private readonly string _id = "pcgraph-" + Guid.NewGuid().ToString("N");
    private GraphVizView? _rendered;
    private bool _needsInit;
    private DotNetObjectReference<GraphCanvas>? _selfRef;

    private GraphNodeView? _selected;
    private List<(GraphNodeView Node, bool Ambiguous)> _selectedNeighbors = new();

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_rendered, Graph)) { _rendered = Graph; _needsInit = true; _selected = null; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_needsInit || Graph is null || Graph.Nodes.Count == 0) return;
        _needsInit = false;

        var payload = new
        {
            nodes = Graph.Nodes.Take(180).Select(n => new { id = n.Id, label = n.Label, degree = n.Degree, god = n.IsGod, kind = n.Kind, labeled = n.Labeled }),
            links = Graph.Links.Take(500).Select(l => new { source = l.Source, target = l.Target, confidence = l.Confidence }),
        };
        _selfRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("pcgraph.init", _id, payload, _selfRef);
    }

    private List<(GraphNodeView Node, int Hops)> _reachableArtifacts = new();

    // Step up the tree from the selected node: breadth-first over the links, collecting every
    // artifact within a few hops (an outer record reaches its runs' artifacts transitively).
    private List<(GraphNodeView, int)> WalkToArtifacts(string fromId)
    {
        if (Graph is null) return new();
        var adjacency = new Dictionary<string, List<string>>();
        foreach (var l in Graph.Links)
        {
            (adjacency.TryGetValue(l.Source, out var a) ? a : adjacency[l.Source] = new()).Add(l.Target);
            (adjacency.TryGetValue(l.Target, out var b) ? b : adjacency[l.Target] = new()).Add(l.Source);
        }
        var byId = Graph.Nodes.ToDictionary(n => n.Id);
        var found = new List<(GraphNodeView, int)>();
        var visited = new HashSet<string> { fromId };
        var frontier = new Queue<(string Id, int Hops)>();
        frontier.Enqueue((fromId, 0));
        while (frontier.Count > 0 && found.Count < 10)
        {
            var (id, hops) = frontier.Dequeue();
            if (hops >= 4) continue;
            foreach (var next in adjacency.GetValueOrDefault(id) ?? new List<string>())
            {
                if (!visited.Add(next)) continue;
                if (byId.TryGetValue(next, out var node) && node.Kind == "good")
                    found.Add((node, hops + 1));
                frontier.Enqueue((next, hops + 1));
            }
        }
        return found.OrderBy(x => x.Item2).ToList();
    }

    [JSInvokable]
    public Task OnNodeClick(string? nodeId)
    {
        _selected = nodeId is null ? null : Graph?.Nodes.FirstOrDefault(n => n.Id == nodeId);
        _reachableArtifacts = _selected is null || _selected.Kind == "good"
            ? new List<(GraphNodeView, int)>()
            : WalkToArtifacts(_selected.Id);
        _selectedNeighbors = _selected is null || Graph is null
            ? new()
            : Graph.Links
                .Where(l => l.Source == _selected.Id || l.Target == _selected.Id)
                .Select(l => (Other: l.Source == _selected.Id ? l.Target : l.Source, Ambiguous: l.Confidence == "Ambiguous"))
                .Select(x => (Node: Graph.Nodes.FirstOrDefault(n => n.Id == x.Other), x.Ambiguous))
                .Where(x => x.Node is not null)
                .Select(x => (x.Node!, x.Ambiguous))
                .DistinctBy(x => x.Item1.Id)
                .OrderByDescending(x => x.Item1.Kind == "good")
                .ThenByDescending(x => x.Item1.Degree)
                .ToList();
        return InvokeAsync(StateHasChanged);
    }

    private Task SelectAsync(string nodeId) => JS.InvokeVoidAsync("pcgraph.select", _id, nodeId).AsTask();

    // ── Search + fullscreen chrome ────────────────────────────────────────────────────────────────
    private bool _fullscreen;
    private string _search = "";
    private List<GraphNodeView> _matches = new();

    private void OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        var term = _search.Trim();
        _matches = term.Length < 2 || Graph is null
            ? new List<GraphNodeView>()
            : Graph.Nodes
                .Where(n => n.Label.Contains(term, StringComparison.OrdinalIgnoreCase)
                         || (n.Content?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
                .OrderByDescending(n => n.Label.Contains(term, StringComparison.OrdinalIgnoreCase))
                .ThenByDescending(n => n.Degree)
                .Take(8)
                .ToList();
    }

    private async Task JumpAsync(string nodeId)
    {
        _matches.Clear();
        _search = "";
        await SelectAsync(nodeId); // centres the view and opens the connections card
    }

    private async Task ToggleFullscreenAsync()
    {
        _fullscreen = !_fullscreen;
        // The canvas element resizes with the container; pcgraph's ResizeObserver re-fits, and a
        // nudge keeps the selected node centred in the new viewport.
        await Task.Yield();
        if (_selected is { } sel) await SelectAsync(sel.Id);
    }
    private Task ClearAsync() => JS.InvokeVoidAsync("pcgraph.select", _id, null).AsTask();

    private static string ShortLabel(string s)
    {
        var i = s.LastIndexOf('/');
        var name = i >= 0 ? s[(i + 1)..] : s;
        return name.Length > 40 ? name[..39] + "…" : name;
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("pcgraph.destroy", _id); } catch { /* circuit gone */ }
        _selfRef?.Dispose();
    }
}
