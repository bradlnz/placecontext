@using PlaceContext.Application.Dtos
@using PlaceContext.Application.Ports
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Headers
@using System.Text.Json
@inject ParamInputViewModel Vm
@implements IDisposable

@* One declared job input, rendered by its type — the same control everywhere a run form appears. *@
@switch (Vm.InputType)
{
    case ParameterInputType.Select:
        <select class="dcinput" value="@Vm.Value" @onchange="OnValueChanged">
            <option value="">— pick —</option>
            @foreach (var o in Vm.Parameter.Options ?? Array.Empty<string>())
            {
                <option value="@o">@o</option>
            }
        </select>
        break;
    case ParameterInputType.Number:
        <input class="dcinput number-input" type="number" value="@Vm.Value"
               @oninput="OnValueChanged" />
        break;
    case ParameterInputType.Checkbox:
        <label class="checkbox-field">
            <input type="checkbox" checked="@Vm.CheckboxChecked" class="checkbox-box"
                   @onchange="OnCheckboxChanged" />
            @(Vm.Parameter.Label ?? Vm.Parameter.Name)
        </label>
        break;
    case ParameterInputType.File:
        <div class="file-input-field">
            <InputFile OnChange="OnFileSelected" accept="@Vm.Accept" disabled="@Vm.Uploading" />
            @if (Vm.Uploading)
            {
                <small>Uploading to private storage…</small>
            }
            else if (Vm.UploadError is not null)
            {
                <small class="error">@Vm.UploadError</small>
            }
            else if (Vm.SelectedFileName is { } selected)
            {
                <small>Uploaded: @selected</small>
            }
        </div>
        break;
    default:
        <input class="dcinput" value="@Vm.Value" @oninput="OnValueChanged" />
        break;
}

@code {
    [Parameter, EditorRequired] public JobParameterDto Parameter { get; set; } = default!;
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override void OnParametersSet() => Vm.SetParameters(Parameter, ProjectId, Value);
    private Task OnFileSelected(InputFileChangeEventArgs args) => Vm.UploadAsync(args, ValueChanged);
    private Task OnValueChanged(ChangeEventArgs args) => ForwardValueAsync(args.Value?.ToString());
    private Task OnCheckboxChanged(ChangeEventArgs args) => ForwardValueAsync(Vm.CheckboxValue(args));
    private Task ForwardValueAsync(string? value)
    {
        Vm.SetValue(value);
        return ValueChanged.InvokeAsync(Vm.Value);
    }
    public void Dispose() => Vm.Detach();
}
