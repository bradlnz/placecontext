@using PlaceContext.Application.Dtos

@* One declared job input, rendered by its type — the same control everywhere a run form appears. *@
@switch (Parameter.Type)
{
    case "select":
        <select class="dcinput" value="@Value" @onchange="@(e => ValueChanged.InvokeAsync(e.Value?.ToString() ?? ""))">
            <option value="">— pick —</option>
            @foreach (var o in Parameter.Options ?? Array.Empty<string>())
            {
                <option value="@o">@o</option>
            }
        </select>
        break;
    case "number":
        <input class="dcinput number-input" type="number" value="@Value"
               @oninput="@(e => ValueChanged.InvokeAsync(e.Value?.ToString() ?? ""))" />
        break;
    case "checkbox":
        <label class="checkbox-field">
            <input type="checkbox" checked="@(Value == "true")" class="checkbox-box"
                   @onchange="@(e => ValueChanged.InvokeAsync(e.Value is true ? "true" : "false"))" />
            @(Parameter.Label ?? Parameter.Name)
        </label>
        break;
    default:
        <input class="dcinput" value="@Value"
               @oninput="@(e => ValueChanged.InvokeAsync(e.Value?.ToString() ?? ""))" />
        break;
}

@code {
    [Parameter, EditorRequired] public JobParameterDto Parameter { get; set; } = default!;
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
}
