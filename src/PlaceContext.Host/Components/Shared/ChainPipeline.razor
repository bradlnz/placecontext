@* Shared run visualization for workflows, Observability, and queue messages. *@
@inject ChainPipelineViewModel Vm
@implements IDisposable

@if (Vm.Layout is { } layout)
{
    <p class="run-layout-note">@(Vm.UsesRecordedLayout
        ? "Recorded execution order · select a job to inspect its output. Historical conditions are not recorded."
        : "Current workflow layout · recorded results from this run. Select a job to inspect its output.")</p>
    <ChainCanvas Stages="layout" RunSteps="Vm.RunSteps" OnStepClick="OnStepClick" OnStepCancel="OnStepCancel" />
}

@code {
    [Parameter, EditorRequired] public ChainRunView Run { get; set; } = null!;
    [Parameter] public EventCallback<ChainStepRunView> OnStepClick { get; set; }
    [Parameter] public EventCallback<ChainStepRunView> OnStepCancel { get; set; }

    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override Task OnParametersSetAsync() => Vm.LoadAsync(Run);
    public void Dispose() => Vm.Dispose();
}
