@* Interactive pipeline canvas. Stages can be reordered, job paths can be dragged between stages,
   and the + path action adds another parallel branch to a stage. *@
@using PlaceContext.Application.Dtos
@inject ChainCanvasViewModel Vm
@implements IDisposable

<div class="chain-canvas @(RunSteps is null ? "" : "run-canvas")">
    <div class="canvas-toolbar">
        <div>
            <div class="toolbar-title">@(RunSteps is null ? "Workflow canvas" : "Workflow run") <span class="step-count">@Vm.Stages.Count steps</span></div>
            <div class="canvas-hint">@(RunSteps is null ? "Drag stages to reorder. Select a step to configure it." : "Step colours show what ran, what failed, and what was skipped.")</div>
        </div>
        @if (RunSteps is null)
        {
        <div class="canvas-add-stage">
            <button class="canvas-button primary" @onclick="@(() => OnAddGate.InvokeAsync(Vm.Stages.Count))">
                <span><AppIcon Kind="plus" /></span> Add step
            </button>
        </div>
        }
    </div>

    <div class="canvas-viewport" tabindex="0" role="region" aria-label="Workflow canvas. Scroll horizontally to see all steps.">
        <div class="canvas-pipeline">
            <div class="start-node">
                <AppIcon Kind="play" />
                <span>Start</span>
            </div>

            @if (Vm.Stages.Count == 0 && RunSteps is null)
            {
                <div class="empty-canvas">
                    <span class="empty-icon"><AppIcon Kind="plus" /></span>
                    <strong>Your workflow starts here</strong>
                    <span>Add a job, a human, or an agent step.</span>
                    <button class="canvas-button primary" @onclick="@(() => OnAddGate.InvokeAsync(0))"><AppIcon Kind="plus" /> Add first step</button>
                </div>
            }

            @for (var i = 0; i < Vm.Stages.Count; i++)
            {
                var stageIndex = i;
                var stage = Vm.Stages[stageIndex];
                var gate = Vm.Gates.GetValueOrDefault(stageIndex) ?? stage.Gate;

                <div class="flow-group">
                    <div class="connector">
                        <span class="connector-line"></span>
                        @if (RunSteps is not null && gate is not null)
                        {
                            <span class="gate-node @Vm.GateClass(gate)" title="@Vm.GateTooltip(gate)">
                                <span class="gate-content"><AppIcon Kind="@Vm.GateIcon(gate)" /><span class="gate-label">@Vm.GateLabel(gate)</span></span>
                            </span>
                        }
                        else if (gate is not null)
                        {
                            <button class="gate-node @Vm.GateClass(gate)"
                                    title="@Vm.GateTooltip(gate)"
                                    @onclick="@(() => OnEditGate.InvokeAsync((stageIndex, gate)))">
                                <span class="gate-content"><AppIcon Kind="@Vm.GateIcon(gate)" /><span class="gate-label">@Vm.GateLabel(gate)</span></span>
                            </button>
                        }
                        else if (RunSteps is null)
                        {
                            <button class="gate-node gate-none" @onclick="@(() => OnAddGate.InvokeAsync(stageIndex))"
                                    title="Add a condition or delay before this stage" aria-label="Add condition">
                                <span class="gate-icon"><AppIcon Kind="plus" /></span>
                            </button>
                        }
                        <span class="connector-line"></span><span class="connector-arrow"><AppIcon Kind="chevron-right" /></span>
                    </div>

                    <div class="stage-routes @(gate is ConditionGateView ? "conditional-routes" : "")">
                    <div class="stage-route">
                    @if (gate is ConditionGateView)
                    {
                        <div class="route-label">True</div>
                    }
                    <div class="canvas-stage @(Vm.DragOverStage == stageIndex ? "drag-over" : "")"
                         @ondragover="@(e => DragOver(stageIndex))"
                         @ondragover:preventDefault="true"
                         @ondragleave="@(() => DragLeave(stageIndex))"
                         @ondrop="@(() => DropOnStageAsync(stageIndex))"
                         @ondrop:preventDefault="true">
                        <div class="stage-head" draggable="@(RunSteps is null)"
                             @ondragstart="@(() => BeginStageDrag(stageIndex))"
                             @ondragend="EndDrag">
                            @if (RunSteps is null) { <span class="drag-handle" title="Drag to reorder"><AppIcon Kind="grip" /></span> }
                            <span class="stage-num">@(stageIndex + 1)</span>
                            <AppIcon Kind="@ChainCanvasViewModel.StageIcon(stage)" />
                            <span class="stage-label">@(stage.Action is LoopChainActionView loopKind ? (loopKind.Kind == "humanInput" ? "Human" : "Agent") : stage.Action is null ? (RunSteps is null ? "Job" : "Step") : "Action")</span>
                            @if (stage.IsParallel)
                            {
                                <span class="parallel-badge"><AppIcon Kind="parallel" /> @stage.Jobs.Count parallel jobs</span>
                            }
                            @if (RunSteps is null)
                            {
                            <button class="stage-menu" title="Remove stage" aria-label="Remove stage"
                                    @onclick="@(() => OnRemoveStage.InvokeAsync(stageIndex))"><AppIcon Kind="close" /></button>
                            }
                        </div>

                        <div class="stage-paths">
                            @if (RunSteps is not null)
                            {
                                @foreach (var step in RunSteps.GetValueOrDefault(stageIndex.ToString()) ?? [])
                                {
                                    <WorkflowRunStep Step="step" OnStepClick="OnStepClick" OnStepCancel="OnStepCancel" />
                                }
                            }
                            else
                            {
                            @if (stage.Action is SendEmailChainActionView email)
                            {
                                <button class="job-path" title="Edit Send Email action"
                                        @onclick="@(() => OnEditEmailAction.InvokeAsync(stageIndex))">
                                    <span class="job-icon"><AppIcon Kind="mail" /></span>
                                    <span class="node-copy"><strong>Send email</strong><small>@email.Recipient</small></span>
                                </button>
                            }
                            else if (stage.Action is SendSmsChainActionView sms)
                            {
                                <button class="job-path" title="Edit Send SMS action"
                                        @onclick="@(() => OnEditSmsAction.InvokeAsync(stageIndex))">
                                    <span class="job-icon"><AppIcon Kind="message" /></span>
                                    <span class="node-copy"><strong>Send SMS</strong><small>@sms.Recipient</small></span>
                                </button>
                            }
                            else if (stage.Action is QemuChainActionView vm)
                            {
                                <button class="job-path" title="Edit QEMU environment" @onclick="@(() => OnEditQemuAction.InvokeAsync(stageIndex))">
                                    <span class="job-icon"><AppIcon Kind="vm" /></span>
                                    <span class="node-copy"><strong>QEMU environment</strong><small>@vm.ImageProfile · @vm.MemoryMb MiB · @vm.Cpus CPU(s)</small></span>
                                </button>
                                <div class="node-output"><span>Result</span><code>@vm.OutputField</code></div>
                            }
                            else if (stage.Action is LoopChainActionView loop)
                            {
                                <button class="job-path loop-path @(loop.Kind == "humanInput" ? "human-path" : "agent-path")"
                                        title="Edit step instructions" @onclick="@(() => OnEditLoopAction.InvokeAsync(stageIndex))">
                                    <span class="job-icon" aria-hidden="true"><AppIcon Kind="@(loop.Kind == "humanInput" ? "human" : "agent")" /></span>
                                    <span class="node-copy"><strong>@loop.DisplayName</strong><small>@loop.Instructions</small></span>
                                </button>
                                <div class="node-output"><span>Response</span><code>@loop.ResponseField</code></div>
                                <span class="handoff-badge">Waits for a response</span>
                            }
                            @foreach (var (job, branchIndex) in stage.Jobs.Select((job, index) => (job, index)))
                            {
                                <div class="job-path" draggable="true"
                                     @ondragstart="@(() => BeginPathDrag(stageIndex, branchIndex))"
                                     @ondragstart:stopPropagation="true"
                                     @ondragend="EndDrag">
                                    <span class="job-icon"><AppIcon Kind="code" /></span>
                                    <span class="job-name" title="@job.JobName">@job.JobName</span>
                                    <button class="path-remove" title="Remove path"
                                            @onclick="@(() => OnRemovePath.InvokeAsync((stageIndex, branchIndex)))"><AppIcon Kind="close" /></button>
                                </div>
                            }
                            }
                        </div>

                        @if (RunSteps is null && stage.Action is null && Vm.PathPickerStage == stageIndex)
                        {
                            <div class="path-picker">
                                    <select class="canvas-select" value="@Vm.PathJobId" @onchange="OnPathJobChanged" aria-label="Job for new path">
                                    <option value="">Choose a job…</option>
                                    @foreach (var job in Jobs)
                                    {
                                        <option value="@job.Id">@job.Name</option>
                                    }
                                </select>
                                <button class="picker-confirm" disabled="@(!Vm.IsPathEnabled)"
                                        @onclick="@(() => ConfirmPathAsync(stageIndex))">Add</button>
                                <button aria-label="Close" class="picker-cancel" @onclick="ClosePathPicker"><AppIcon Kind="close" /></button>
                            </div>
                        }
                        else if (RunSteps is null && stage.Action is null)
                        {
                            <button class="add-path" @onclick="@(() => OpenPathPicker(stageIndex))">
                                <span class="plus-ring"><AppIcon Kind="plus" /></span>
                                <span>Add parallel job</span>
                            </button>
                        }

                        @if (gate is ConditionGateView cg)
                        {
                            <div class="condition-strip" title="@cg.Expression">
                                <span>IF</span>
                                <code>@cg.Expression</code>
                            </div>
                        }
                        else if (gate is WaitGateView wg)
                        {
                            <div class="wait-strip">Wait @wg.DurationSeconds.ToString("0.#") seconds</div>
                        }
                    </div>
                    </div>
                    @if (gate is ConditionGateView condition)
                    {
                        <div class="stage-route">
                            <div class="route-label">False</div>
                            <div class="canvas-stage false-route">
                                @if ((stage.ElseBranch ?? condition.ElseBranch) is { Count: > 0 } other)
                                {
                                    <WorkflowBranchPreview Stages="other" RunSteps="RunSteps" PathPrefix="@($"{stageIndex}/else")" OnStepClick="OnStepClick" OnStepCancel="OnStepCancel" />
                                }
                                else
                                {
                                    <p>Continue without running this step.</p>
                                }
                                @if (RunSteps is null)
                                {
                                    <button class="canvas-button" @onclick="@(() => OnEditGate.InvokeAsync((stageIndex, condition)))">Edit false path</button>
                                }
                            </div>
                        </div>
                        <span class="route-join"><AppIcon Kind="branch" /> Rejoin</span>
                    }
                    </div>
                </div>
            }

            @if (Vm.Stages.Count > 0)
            {
                <div class="finish-connector"><span></span><span class="connector-arrow"><AppIcon Kind="chevron-right" /></span></div>
                <div class="finish-node"><AppIcon Kind="file" /> Output</div>
            }
        </div>
    </div>

    <div class="canvas-legend">
        <span><AppIcon Kind="code" /> job stage</span>
        <span><AppIcon Kind="human" /> human</span>
        <span><AppIcon Kind="agent" /> agent</span>
        <span><AppIcon Kind="split" /> condition</span>
        <span><AppIcon Kind="clock" /> delay</span>
        <span class="legend-help">Parallel jobs run together. Conditions select the true or false path, then rejoin.</span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<JobChainStageView> Stages { get; set; } = Array.Empty<JobChainStageView>();
    [Parameter] public IReadOnlyList<JobView> Jobs { get; set; } = Array.Empty<JobView>();
    [Parameter] public IReadOnlyDictionary<string, IReadOnlyList<ChainStepRunView>>? RunSteps { get; set; }
    [Parameter] public EventCallback<ChainStepRunView> OnStepClick { get; set; }
    [Parameter] public EventCallback<ChainStepRunView> OnStepCancel { get; set; }
    [Parameter] public Dictionary<int, ChainGateView> Gates { get; set; } = new();
    [Parameter] public EventCallback<int> OnAddGate { get; set; }
    [Parameter] public EventCallback<(int StageIndex, ChainGateView Gate)> OnEditGate { get; set; }
    [Parameter] public EventCallback<int> OnEditEmailAction { get; set; }
    [Parameter] public EventCallback<int> OnEditSmsAction { get; set; }
    [Parameter] public EventCallback<int> OnEditLoopAction { get; set; }
    [Parameter] public EventCallback<int> OnEditQemuAction { get; set; }
    [Parameter] public EventCallback<(int StageIndex, Guid JobId)> OnAddPath { get; set; }
    [Parameter] public EventCallback<(int SourceIndex, int TargetIndex)> OnMoveStage { get; set; }
    [Parameter] public EventCallback<(int SourceStage, int SourceBranch, int TargetStage)> OnMovePath { get; set; }
    [Parameter] public EventCallback<(int StageIndex, int BranchIndex)> OnRemovePath { get; set; }
    [Parameter] public EventCallback<int> OnRemoveStage { get; set; }

    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override void OnParametersSet() => Vm.SetParameters(Stages, Jobs, Gates);
    private void OnPathJobChanged(ChangeEventArgs args) => Vm.SetPathJobId(args.Value?.ToString());
    private void OpenPathPicker(int stageIndex) => Vm.OpenPathPicker(stageIndex);
    private void ClosePathPicker() => Vm.ClosePathPicker();
    private async Task ConfirmPathAsync(int stageIndex)
    {
        if (Vm.ConsumePathJob() is { } jobId) await OnAddPath.InvokeAsync((stageIndex, jobId));
    }
    private void BeginStageDrag(int stageIndex) => Vm.BeginStageDrag(stageIndex);
    private void BeginPathDrag(int stageIndex, int branchIndex) => Vm.BeginPathDrag(stageIndex, branchIndex);
    private void DragOver(int stageIndex) => Vm.DragOver(stageIndex);
    private void DragLeave(int stageIndex) => Vm.DragLeave(stageIndex);
    private async Task DropOnStageAsync(int targetStage)
    {
        if (RunSteps is not null) return;
        if (Vm.ConsumePathDrop(targetStage) is { } path)
            await OnMovePath.InvokeAsync(path);
        else if (Vm.ConsumeStageDrop(targetStage) is { } stage)
            await OnMoveStage.InvokeAsync(stage);
    }
    private void EndDrag() => Vm.EndDrag();
    public void Dispose() => Vm.Dispose();
}
