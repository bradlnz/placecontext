<svg class="crm-svg-icon @Class" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "search": <><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></>; break;
        case "mail": <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></>; break;
        case "message": <><path d="M4 5h16v12H8l-4 4z" /><path d="M8 9h8M8 13h5" /></>; break;
        case "note": <><path d="M5 3h11l3 3v15H5z" /><path d="M15 3v4h4M8 11h8M8 15h6" /></>; break;
        case "phone": <path d="M6.6 3h3l1.5 4-2 1.6a15 15 0 0 0 6.3 6.3l1.6-2 4 1.5v3A2.6 2.6 0 0 1 18.4 21C9.9 20.5 3.5 14.1 3 5.6A2.6 2.6 0 0 1 5.6 3z" />; break;
        case "calendar": <><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M7 3v4M17 3v4M3 10h18" /></>; break;
        case "workflow": <><rect x="8" y="3" width="8" height="5" rx="1" /><rect x="3" y="16" width="7" height="5" rx="1" /><rect x="14" y="16" width="7" height="5" rx="1" /><path d="M12 8v4M6.5 16v-4h11v4" /></>; break;
        case "refresh": <><path d="M20 7v5h-5" /><path d="M19 12a7 7 0 1 0-2 5" /></>; break;
        case "upload": <><path d="M12 16V4M7 9l5-5 5 5" /><path d="M4 15v5h16v-5" /></>; break;
        case "arrow-right": <><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></>; break;
        case "arrow-left": <><path d="M19 12H5" /><path d="m11 6-6 6 6 6" /></>; break;
        case "chevron-left": <path d="m15 6-6 6 6 6" />; break;
        case "chevron-right": <path d="m9 6 6 6-6 6" />; break;
        case "edit": <><path d="m14 5 5 5M4 20l4.5-1L19 8l-4-4L5 15.5z" /></>; break;
        case "trash": <><path d="M4 7h16M9 7V4h6v3M7 7l1 14h8l1-14" /><path d="M10 11v6M14 11v6" /></>; break;
        case "chevron-up": <path d="m6 15 6-6 6 6" />; break;
        case "chevron-down": <path d="m6 9 6 6 6-6" />; break;
        case "close": <><path d="M6 6l12 12M18 6 6 18" /></>; break;
        default: <><circle cx="12" cy="12" r="8" /><path d="M12 8v8M8 12h8" /></>; break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public string? Class { get; set; }
}
