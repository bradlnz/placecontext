@using PlaceContext.Domain.ValueObjects
@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="agent-activity" aria-label="Agent activity">
    <div class="agent-terminal" tabindex="0" role="log" aria-label="Agent terminal output" aria-live="off" @ref="_terminal">
        @if (Step.AgentActivity is not { Count: > 0 })
        {
            <div class="terminal-line system"><span class="terminal-tag">[system]</span> @(Step.Status == "Running" ? "Waiting for the first agent update…" : "No agent activity was recorded for this run.")</div>
        }
        @if (Step.AgentActivity?.Count >= AgentActivity.RetainedEvents)
        {
            <div class="terminal-line system"><span class="terminal-tag">[system]</span> Showing the latest @AgentActivity.RetainedEvents events, including earlier attempts.</div>
        }
        @foreach (var entry in Step.AgentActivity ?? [])
        {
            <div class="terminal-line @entry.Kind"><time datetime="@entry.At.ToString("O")">[@entry.At.ToString("HH:mm:ss") UTC]</time> <span class="terminal-tag">[@(entry.Kind == "update" ? "agent" : entry.Tool ?? entry.Kind)]</span> <span class="terminal-message">@entry.Message.TrimEnd()</span>@if (entry.Turn is { } turn) { <span class="terminal-meta"> · turn @turn</span> }@if (entry.DurationSeconds is { } duration) { <span class="terminal-meta"> · @(duration.ToString("0.0"))s</span> }@if (entry.RunId is { } runId) { <button type="button" class="terminal-link" @onclick="() => OnRunClick.InvokeAsync(runId)">View logs · @runId.ToString()[..8]</button> }</div>
        }
        @if (Step.Error is not null)
        {
            <div class="terminal-line failed" role="alert"><span class="terminal-tag">[error]</span> @Step.Error</div>
        }
        <div class="terminal-line system" role="status"><span class="terminal-tag">[status]</span> @Step.Status@if (Step.Status == "Running" && Step.AgentActivity?.LastOrDefault() is { } latest) { <span> · @Math.Max(0, (int)(DateTimeOffset.UtcNow - latest.At).TotalSeconds)s since last update</span> }@if (Step.Status == "Running") { <span class="terminal-cursor" aria-hidden="true">▍</span> }</div>
    </div>
    <div class="terminal-footer"><span>Scroll up to pause following output.</span><button type="button" class="terminal-link" @onclick="JumpToLatestAsync">Jump to latest ↓</button></div>
</section>

@code {
    [Parameter, EditorRequired] public ChainStepRunView Step { get; set; } = null!;
    [Parameter] public EventCallback<Guid> OnRunClick { get; set; }
    private ElementReference _terminal;
    private IJSObjectReference? _module;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/WorkflowAgentActivity.razor.js");
        if (_disposed) { await module.DisposeAsync(); return; }
        _module = module;
        await module.InvokeVoidAsync("attach", _terminal);
    }

    private async Task JumpToLatestAsync()
    {
        if (_module is not null) await _module.InvokeVoidAsync("jumpToLatest", _terminal);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try
        {
            await _module.InvokeVoidAsync("detach", _terminal);
            await _module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
}
