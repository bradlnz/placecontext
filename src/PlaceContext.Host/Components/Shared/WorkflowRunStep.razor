@inject ChainPipelineViewModel Vm

<div class="run-step" data-status="@Step.Status" style="border-color:@Vm.Border(Step.Status); background:@Vm.Background(Step.Status)">
    <button class="run-step-link" disabled="@(!OnStepClick.HasDelegate || (!Vm.HasRun(Step) && !InspectActions))" @onclick="@(() => OnStepClick.InvokeAsync(Step))"
            aria-label="@($"{Step.JobName}: {Vm.Summary(Step)}")">
        <span class="run-step-title" style="color:@Vm.Color(Step.Status)"><AppIcon Kind="@Vm.Icon(Step.Status)" /> @Step.JobName</span>
        <span class="run-step-status">@Vm.Summary(Step)</span>
    </button>
    @if (Step.ActionType == PlaceContext.Domain.ValueObjects.ParallelWorkflowsChainAction.ActionType)
    {
        <SubWorkflowRunLink Step="Step" Compact="true" />
    }
    @if (!string.IsNullOrWhiteSpace(Step.Provider))
    {
        <div class="run-step-detail">@Step.Provider@(string.IsNullOrWhiteSpace(Step.ExternalId) ? "" : $" · {Step.ExternalId}")</div>
    }
    @if (!string.IsNullOrWhiteSpace(Step.Error))
    {
        <div class="run-step-detail" title="@Step.Error">@Step.Error</div>
    }
    @if (OnStepCancel.HasDelegate && Vm.CanCancel(Step))
    {
        <button class="dcbtn btn-2-8 text-bad" @onclick="@(() => OnStepCancel.InvokeAsync(Step))">Cancel</button>
    }
</div>

@code {
    [Parameter] public bool InspectActions { get; set; }
    [Parameter, EditorRequired] public ChainStepRunView Step { get; set; } = null!;
    [Parameter] public EventCallback<ChainStepRunView> OnStepClick { get; set; }
    [Parameter] public EventCallback<ChainStepRunView> OnStepCancel { get; set; }
}
