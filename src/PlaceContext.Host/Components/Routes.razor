@inject RoutesViewModel Vm
@implements IDisposable

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        <StableAuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <Authorizing>
                <LayoutView Layout="@typeof(MainLayout)">
                    <div role="status" aria-label="Loading view" aria-busy="true">
                        <Skeleton Kind="detail" Rows="6" Padded />
                    </div>
                </LayoutView>
            </Authorizing>
            <NotAuthorized>
                @{ Vm.NavigateToLocked(); }
            </NotAuthorized>
        </StableAuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(MainLayout)">
            <p class="muted">Page not found.</p>
        </LayoutView>
    </NotFound>
</Router>

@code {
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    public void Dispose() => Vm.Dispose();
}
