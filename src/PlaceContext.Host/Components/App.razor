<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <style>
        html, body { margin:0; min-height:100%; background:#000; color-scheme:dark; }
        html[data-pc-theme="light"], html[data-pc-theme="light"] body { background:#f5f8fa; color-scheme:light; }
    </style>
    <script>
        (() => {
            let theme = 'dark';
            try { theme = localStorage.getItem('placecontext-theme') === 'light' ? 'light' : 'dark'; } catch { }
            document.documentElement.dataset.pcTheme = theme;
        })();
    </script>
    <base href="/" />
    <title>PlaceContext — codebase visibility</title>
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
          rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet" /></noscript>
    <link rel="stylesheet" href="@Assets["vendor/workspace-daisyui.css"]" />
    @* Blazor scoped-CSS bundle: per-component <Name>.razor.css files compile into this. Component
       classes resolve --var() values from the #dcshell ancestor's cascade below. *@
    <link rel="stylesheet" href="@Assets["PlaceContext.Host.styles.css"]" />
    <link rel="stylesheet" href="@Assets["resource-catalogue.css"]" />
    @* prerender:false — with prerender on, every page ran its whole data load twice (once for
       the throwaway static render, again when the circuit connects). One load, one render. *@
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
</head>
<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script defer src="@Assets["placecontext.js"]"></script>
    <script defer src="@Assets["pcchart.js"]" data-chart-src="@Assets["vendor/chart.umd.min.js"]"></script>
    <script defer src="@Assets["pcmodules.js"]"
            data-pcgraph="@Assets["pcgraph.js"]"
            data-pcmonaco="@Assets["pcmonaco.js"]"
            data-pcstudio="@Assets["pcstudio.js"]"
            data-pcmap="@Assets["pcmap.js"]"></script>
    @* Start Blazor after the deferred interop modules have registered their window APIs. Otherwise a
       fast circuit can make its only first-render call before pcchart/pcgraph exists. *@
    <script defer src="_framework/blazor.web.js"></script>
</body>
</html>
