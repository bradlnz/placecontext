<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <title>PlaceContext — codebase visibility</title>
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    @* Blazor scoped-CSS bundle: per-component <Name>.razor.css files compile into this. Component
       classes resolve --var() values from the #dcshell ancestor's cascade below. *@
    <link rel="stylesheet" href="PlaceContext.Host.styles.css" />
    @* prerender:false — with prerender on, every page ran its whole data load twice (once for
       the throwaway static render, again when the circuit connects). One load, one render. *@
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <style>
        #dcshell {
            --bg:var(--tenant-bg,#182026); --panel:var(--tenant-panel,#202b33); --card:var(--tenant-panel,#202b33); --card-2:#293742; --hover:#30404d;
            --border:#30404d; --border-2:#394b59;
            --text:var(--tenant-text,#f5f8fa); --text-2:#bfccd6; --text-3:#8a9ba8; --text-4:#738694;
            --brand:var(--tenant-accent,#137cbd); --brand-2:var(--tenant-accent,#48aff0); --brand-bg:rgba(19,124,189,0.18); --brand-fg:#fff;
            --good:#0f9960; --good-bg:rgba(15,153,96,0.16);
            --warn:#d9822b; --warn-bg:rgba(217,130,43,0.16);
            --bad:#db3737; --bad-bg:rgba(219,55,55,0.15);
            --human:#48aff0; --human-bg:rgba(72,175,240,0.16);
            --shadow:0 2px 6px rgba(16,22,26,.38), 0 8px 24px rgba(16,22,26,.28);
            --font-sans:'Inter',system-ui,-apple-system,sans-serif;
            --font-mono:'JetBrains Mono',ui-monospace,'SFMono-Regular',Menlo,monospace;
        }
        #dcshell[data-theme="light"] {
            --bg:#f5f8fa; --panel:#ffffff; --card:#ffffff; --card-2:#ebf1f5; --hover:#e1e8ed;
            --border:#d8e1e8; --border-2:#bfccd6;
            --text:#182026; --text-2:#5c7080; --text-3:#738694; --text-4:#8a9ba8;
            --brand:var(--tenant-accent,#137cbd); --brand-2:var(--tenant-accent,#106ba3); --brand-bg:rgba(19,124,189,0.11); --brand-fg:#ffffff;
            --good:#0d8050; --good-bg:rgba(15,153,96,0.11);
            --warn:#bf7326; --warn-bg:rgba(217,130,43,0.12);
            --bad:#c23030; --bad-bg:rgba(219,55,55,0.10);
            --human:#137cbd; --human-bg:rgba(19,124,189,0.11);
            --shadow:0 1px 3px rgba(16,22,26,.16), 0 8px 20px rgba(16,22,26,.08);
        }
        * { box-sizing:border-box; }
        html, body { margin:0; padding:0; height:100%; }
        html.pc-focus-layer-open, html.pc-focus-layer-open body { overflow:hidden; overscroll-behavior:none; }
        body { font-family:var(--font-sans); background:#182026; -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; }
        #dcshell { font-family:var(--font-sans); color:var(--text); font-variant-numeric:tabular-nums; letter-spacing:-0.006em; }
        a { color:inherit; text-decoration:none; }
        button, a, [role="button"] { touch-action: manipulation; }
        ::selection { background:var(--brand-bg); }
        ::-webkit-scrollbar { width:10px; height:10px; }
        ::-webkit-scrollbar-thumb { background:var(--border-2); border-radius:8px; border:3px solid var(--bg); }
        ::-webkit-scrollbar-track { background:transparent; }
        @@keyframes dcpulse { 0%,100% { opacity:1; transform:scale(1); } 50% { opacity:.35; transform:scale(.82); } }
        @@keyframes dcgrow { from { transform:scaleX(0); } to { transform:scaleX(1); } }
        /* ── Skeleton loaders: a shimmering placeholder block. .dcskel is the primitive; the shape
           helpers below compose it into the page's real layout so the swap to content is seamless. */
        @@keyframes dcshimmer { 100% { background-position:-200% 0; } }
        .dcskel { position:relative; border-radius:6px; background:linear-gradient(90deg,
            var(--card-2) 25%, var(--hover) 37%, var(--card-2) 63%); background-size:200% 100%;
            animation:dcshimmer 1.25s ease-in-out infinite; }
        .dcskel.circle { border-radius:50%; }
        .dcskel-line { height:11px; }
        .dcskel-line.sm { height:9px; }
        .dcskel-line.lg { height:15px; }
        .dcskel-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:14px; }
        .dcskel-card { padding:16px; display:flex; flex-direction:column; gap:11px; }
        .dcskel-tile { display:flex; flex-direction:column; }
        .dcskel-tile-head { display:flex; align-items:flex-start; gap:10px; padding:14px; }
        .dcskel-tile-lines { flex:1; min-width:0; display:flex; flex-direction:column; gap:7px; }
        .skel-tile-icon { width:32px; height:32px; flex:none; }
        .dcskel-tile-actions { display:flex; gap:0; border-top:1px solid var(--border); padding:9px 0; }
        .skel-tile-action { flex:1; height:9px; margin:0 8px; border-radius:4px; }
        .dcskel-rows { display:flex; flex-direction:column; }
        .dcskel-row { display:flex; align-items:center; gap:12px; padding:12px 4px; border-bottom:1px solid var(--border); }
        @@media (prefers-reduced-motion: reduce) { .dcskel { animation-duration:2.4s; } }
        .dcbar { height:100%; width:0; border-radius:99px; transition:width .6s cubic-bezier(.4,0,.2,1); }
        .dcnav { position:relative; display:flex; align-items:center; gap:9px; padding:7px 9px; border:none; cursor:pointer;
            border-radius:3px; font-size:12.5px; font-weight:500; font-family:inherit; text-align:left; transition:background .12s;
            color:var(--text-2); background:transparent; width:100%; }
        .dcnav:hover { background:var(--hover); color:var(--text); }
        .dcnav.active { color:var(--text); background:var(--brand-bg); }
        .dcnav .bar { position:absolute; left:-12px; top:9px; bottom:9px; width:2.5px; border-radius:2px; background:var(--brand); opacity:0; }
        .dcnav.active .bar { opacity:1; }
        .dcbtn { background:var(--card-2); color:var(--text-2); border:1px solid var(--border-2); border-radius:3px;
            padding:6px 11px; cursor:pointer; font-size:12px; font-family:inherit; font-weight:600; }
        .dcbtn:hover { background:var(--hover); border-color:var(--text-3); color:var(--text); }
        .dcbtn.primary { background:var(--brand); border-color:var(--brand); color:var(--brand-fg,#fff); font-weight:600; }
        .dcbtn.danger { background:var(--bad); border-color:var(--bad); color:#fff; font-weight:600; }
        .dcbtn.danger:hover { filter:brightness(1.1); }
        .dccard { background:var(--card); border:1px solid var(--border); border-radius:3px; }
        .dclink { background:none; border:none; color:var(--text-2); padding:0; cursor:pointer; font-size:inherit; font-family:inherit; font-weight:500; text-decoration:underline; text-decoration-color:transparent; transition:text-decoration-color .12s; }
        .dclink:hover { text-decoration-color:currentColor; }

        .dcsearch-trigger { display:flex; align-items:center; gap:7px; padding:6px 10px; background:var(--card-2); border:1px solid var(--border); border-radius:3px; color:var(--text-3); font-size:12px; min-width:220px; cursor:pointer; }
        .dcsearch-trigger:hover { border-color:var(--border-2); color:var(--text-2); }
        .dcsearch-trigger kbd { margin-left:auto; font-family:var(--font-sans); font-size:10.5px; color:var(--text-3); border:1px solid var(--border); border-radius:4px; padding:0 4px; }
        .dcsearch-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.5); display:flex; align-items:flex-start; justify-content:center; padding-top:12vh; z-index:50; }
        .dcsearch-modal { width:560px; max-width:92vw; background:var(--panel); border:1px solid var(--border-2); border-radius:14px; overflow:hidden; overscroll-behavior:contain; box-shadow:0 24px 70px rgba(0,0,0,.55); }
        .dcsearch-input { width:100%; border:none; border-bottom:1px solid var(--border); background:transparent; color:var(--text); font-size:15px; padding:16px 18px; outline:none; }
        .dcsearch-results { max-height:52vh; overflow-y:auto; }
        .dcsearch-hit { display:flex; align-items:center; gap:12px; padding:11px 18px; cursor:pointer; border-bottom:1px solid var(--border); text-align:left; width:100%; background:transparent; border-left:none; border-right:none; border-top:none; }
        .dcsearch-hit:hover { background:var(--card-2); }
        .dcsearch-kind { font-size:9px; font-weight:700; letter-spacing:.4px; text-transform:uppercase; color:var(--brand-2); background:var(--brand-bg); padding:2px 6px; border-radius:5px; flex:none; width:60px; text-align:center; }
        .dcsearch-title { flex:1; min-width:0; overflow:hidden; }
        .dcsearch-title .t { font-size:13px; color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .dcsearch-title .s { font-size:11px; color:var(--text-3); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .dcsearch-empty { padding:22px 18px; color:var(--text-3); font-size:13px; text-align:center; }

        .dcfocus-row { display:flex; align-items:flex-start; gap:11px; padding:11px 16px; border-bottom:1px solid var(--border); cursor:pointer; text-align:left; width:100%; background:transparent; border-left:none; border-right:none; border-top:none; }
        .dcfocus-row:last-child { border-bottom:none; }
        .dcfocus-row:hover { background:var(--card-2); }
        .dcfocus-box { flex:none; width:15px; height:15px; margin-top:1px; border-radius:4px; border:1.5px solid var(--border-2); }
        .dcfocus-row:hover .dcfocus-box { border-color:var(--brand); }
        .dcfocus-row.sev-high .dcfocus-box { border-color:var(--bad); }
        .dcfocus-row.sev-medium .dcfocus-box { border-color:var(--warn); }
        .dcfocus-title { font-size:13px; color:var(--text); font-weight:500; }
        .dcfocus-detail { font-size:11.5px; color:var(--text-3); margin-top:2px; }
        .dcfocus-proj { margin-left:auto; flex:none; font-size:11px; color:var(--text-3); font-family:var(--font-sans); padding-top:1px; }
        .dcfocus-clear { padding:22px 16px; text-align:center; color:var(--good); font-size:13px; }

        .dctabs { display:flex; gap:4px; border-bottom:1px solid var(--border); margin-bottom:18px; }
        .dctab { appearance:none; background:transparent; border:none; border-bottom:2px solid transparent; color:var(--text-3); font-size:13px; font-weight:500; padding:9px 13px; cursor:pointer; margin-bottom:-1px; }
        .dctab:hover { color:var(--text-2); }
        .dctab.active { color:var(--text); border-bottom-color:var(--brand); }
        .dctab .n { font-family:var(--font-sans); font-size:11px; color:var(--text-3); margin-left:6px; }
        .dcslide-scrim { position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:40; }
        .dcslide { position:fixed; top:0; right:0; height:100vh; height:100dvh; width:420px; max-width:92vw; background:var(--panel); border-left:1px solid var(--border-2); box-shadow:-16px 0 50px rgba(0,0,0,.4); z-index:41; display:flex; flex-direction:column; overscroll-behavior:contain; }
        .dcslide-head { display:flex; align-items:center; gap:10px; padding:16px 18px; border-bottom:1px solid var(--border); }
        .dcslide-body { padding:18px; overflow-y:auto; }
        .dcslide-x { appearance:none; background:transparent; border:none; color:var(--text-3); font-size:18px; cursor:pointer; line-height:1; }
        .dcslide-x:hover { color:var(--text); }
        .dcslide-label { font-size:10px; font-weight:600; letter-spacing:.5px; text-transform:uppercase; color:var(--text-3); margin:16px 0 6px; }
        .dcslide-foot { display:flex; align-items:center; gap:8px; justify-content:flex-end; padding:13px 18px; border-top:1px solid var(--border); background:var(--panel); flex:none; }

        .dcinput { appearance:none; background:var(--bg); color:var(--text); border:1px solid var(--border-2); border-radius:3px;
            padding:7px 9px; font-size:12.5px; font-family:inherit; outline:none; transition:border-color .12s, background .12s, box-shadow .12s; }
        .dcinput:hover { border-color:var(--border-2); }
        .dcinput:focus { border-color:var(--brand); background:var(--card); box-shadow:0 0 0 1px var(--brand); }
        .dcinput::placeholder { color:var(--text-3); }
        select.dcinput { cursor:pointer; }
        textarea.dcinput { line-height:1.55; }

        .dcfield { display:flex; flex-direction:column; gap:5px; min-width:0; }
        .dcfield > label { font-size:11.5px; font-weight:500; color:var(--text-2); }
        .dcfield .req { color:var(--bad); }
        .dcfield .code { font-family:var(--font-sans); font-size:10.5px; color:var(--text-3); }
        .dchint { font-size:11px; color:var(--text-3); line-height:1.5; }
        .dcform-section { border-top:1px solid var(--border); padding-top:14px; display:flex; flex-direction:column; gap:11px; }
        .dcform-title { font-size:10px; font-weight:700; letter-spacing:.6px; text-transform:uppercase; color:var(--text-3); }
        .dcseg { display:inline-flex; background:var(--card-2); border:1px solid var(--border); border-radius:8px; padding:3px; gap:2px; }
        .dcseg button { appearance:none; border:none; background:transparent; color:var(--text-3); font-family:inherit; font-size:12px;
            font-weight:500; padding:5px 12px; border-radius:6px; cursor:pointer; }
        .dcseg button:hover { color:var(--text-2); }
        .dcseg button.on { background:var(--panel); color:var(--text); box-shadow:0 1px 2px rgba(0,0,0,.25); }

        .dcmodal-overlay { position:fixed; inset:0; background:rgba(0,0,0,.5); display:flex; align-items:center; justify-content:center; padding:20px; z-index:50; }
        .dcmodal { width:480px; max-width:94vw; max-height:86vh; max-height:86dvh; background:var(--panel); border:1px solid var(--border-2); border-radius:14px;
            box-shadow:0 24px 70px rgba(0,0,0,.55); display:flex; flex-direction:column; overflow:hidden; }
        .dcmodal-head { display:flex; align-items:flex-start; gap:10px; padding:15px 18px; border-bottom:1px solid var(--border); flex:none; }
        .dcmodal-body { padding:18px; overflow-y:auto; display:flex; flex-direction:column; gap:13px; }
        .dcmodal-foot { display:flex; align-items:center; gap:8px; justify-content:flex-end; padding:13px 18px; border-top:1px solid var(--border); background:var(--card); flex:none; }

        @@keyframes dcflashkf { 0% { background:var(--brand-bg); } 100% { background:transparent; } }
        .dcflash { animation:dcflashkf 1.6s ease-out; }
        #decisions.dcflash { box-shadow:0 0 0 1.5px var(--brand); }

        /* Shared mobile overlay contract: dialogs and editors become full-screen task surfaces. */
        @@media (max-width: 700px) {
            .dcmodal-overlay { align-items:stretch; justify-content:stretch; padding:0; }
            .dcmodal { width:100vw; max-width:none; height:100vh; height:100dvh; max-height:none; border:0; border-radius:0; box-shadow:none; }
            .dcslide { inset:0; width:100vw !important; max-width:none; height:100vh; height:100dvh; border:0; box-shadow:none; }
            .dcmodal-body, .dcslide-body { flex:1; min-height:0; overscroll-behavior:contain; }
            .dcmodal-head, .dcslide-head { padding-top:max(15px, env(safe-area-inset-top)); padding-right:max(12px, env(safe-area-inset-right)); }
            .dcmodal-foot, .dcslide-foot { padding-bottom:max(13px, env(safe-area-inset-bottom)); }
            .dcmodal-head > .dcslide-x, .dcslide-head > .dcslide-x { display:inline-flex; align-items:center; justify-content:center; min-width:44px; min-height:44px; margin:-8px -8px -8px auto; border-radius:8px; }
            .dcmodal-head > .dcslide-x:hover, .dcslide-head > .dcslide-x:hover { background:var(--hover); }
        }

        @@media (max-width: 950px) {
            .dctabs { overflow-x:auto; }
            .dcbtn.sm { min-height:40px; }
        }
    </style>
</head>
<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="_framework/blazor.web.js"></script>
    <script src="placecontext.js?v=6"></script>
    <script src="pcgraph.js?v=2"></script>
    <script src="pcmonaco.js?v=2"></script>
    <script src="vendor/chart.umd.min.js"></script>
    <script src="pcchart.js?v=2"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script src="pcmap.js?v=2"></script>
</body>
</html>
