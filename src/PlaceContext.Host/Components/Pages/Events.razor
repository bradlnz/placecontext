@page "/project/{ProjectId:guid}/events"
@attribute [Authorize(Policy = Permission.EventsManage)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject NavigationManager Nav

<PageTitle>PlaceContext — Events</PageTitle>

@if (_loading)
{
    <Skeleton Kind="card-grid" Cards="4" Padded />
}
else
{
    <div class="page">


        <h2 class="page-title">Events</h2>
        <div class="page-sub">
            Define event types, emit them, and watch the log. Event triggers on a job fire whenever a matching event is emitted.
        </div>

        @if (_message is not null)
        {
            <div class="message-bar">@_message</div>
        }

        <div class="columns">

            @* ── Event types ─────────────────────────────────────────────── *@
            <div class="column">
                <div class="column-title">Event types</div>

                <div class="stack">
                    @foreach (var e in _types ?? Array.Empty<EventTypeView>())
                    {
                        <div class="dccard type-card">
                            <div class="card-row">
                                <span class="type-name">@e.Name</span>
                                @if (e.IsBuiltIn)
                                {
                                    <span class="builtin-badge">built-in</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(e.Description))
                            {
                                <div class="type-desc">@e.Description</div>
                            }
                            <button class="dcbtn btn-emit"
                                    @onclick="@(() => Emit(e.Name))">Emit</button>
                        </div>
                    }
                </div>

                <div class="dccard define-card">
                    <div class="define-title">Define event type</div>
                    <input class="dcinput" @bind="_defName" placeholder="deploy.finished" />
                    <input class="dcinput" @bind="_defDescription" placeholder="Description (optional)" />
                    <textarea class="dcinput va-textarea" rows="2"
                              @bind="_defSchema" placeholder="Payload fields (optional freetext/JSON)"></textarea>
                    @if (_defError is not null)
                    {
                        <div class="error-inline">@_defError</div>
                    }
                    <button class="dcbtn primary btn-self-start" disabled="@_defBusy" @onclick="Define">Define</button>
                </div>
            </div>

            @* ── Event log ───────────────────────────────────────────────── *@
            <div class="column">
                <div class="column-title">Recent events</div>

                @if (_log is null || _log.Count == 0)
                {
                    <div class="hint">No events emitted yet.</div>
                }
                else
                {
                    <div class="stack">
                        @foreach (var o in _log)
                        {
                            <div class="dccard log-card">
                                <div class="card-row">
                                    <span class="log-name">@o.Name</span>
                                    <span class="source-badge"
                                          style="color:@(o.Source == "Domain" ? "var(--brand-2)" : "var(--text-2)")">@o.Source</span>
                                    <span class="log-time">@o.OccurredAt.ToWorkspaceTime().ToString("MM-dd HH:mm:ss")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(o.Payload))
                                {
                                    <pre class="payload-pre">@o.Payload</pre>
                                }
                            </div>
                        }
                    </div>
                }

            </div>
        </div>
    </div>
}

@* ── Emit modal ──────────────────────────────────────────────────────────────────────── *@
@if (_emitName is not null)
{
    <div class="dcslide-scrim" @onclick="@(() => _emitName = null)"></div>
    <div class="dcslide emit-slide">
        <div class="dcslide-head">
            <span class="emit-title">Emit @_emitName</span>
            <button class="dcslide-x" @onclick="@(() => _emitName = null)">×</button>
        </div>
        <div class="dcslide-body emit-body">
            <div class="hint">
                Every enabled event trigger subscribed to <code>@_emitName</code> will fire; the payload is passed through as run parameters.
            </div>
            <label class="hint">Payload (optional JSON)</label>
            <textarea class="dcinput va-textarea" rows="6"
                      @bind="_emitPayload" placeholder="{&quot;customerEmail&quot;: &quot;a@b.com&quot;}"></textarea>
            @if (_emitError is not null)
            {
                <div class="error-inline">@_emitError</div>
            }
            <div class="emit-actions">
                <button class="dcbtn" @onclick="@(() => _emitName = null)">Cancel</button>
                <button class="dcbtn primary" disabled="@_emitBusy" @onclick="DoEmit">Emit</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private IReadOnlyList<EventTypeView>? _types;
    private IReadOnlyList<EventOccurrenceView>? _log;
    private bool _loading = true;
    private string? _message;

    private string _defName = "";
    private string _defDescription = "";
    private string _defSchema = "";
    private bool _defBusy;
    private string? _defError;

    private string? _emitName;
    private string _emitPayload = "";
    private bool _emitBusy;
    private string? _emitError;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _message = null;
        try
        {
            await ReloadAsync();
            Ui.Set("Events", "workspace event log + types");
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _loading = false; }
    }

    private async Task ReloadAsync()
    {
        _types = await Svc.ListEventTypesAsync();
        _log = await Svc.ListEventOccurrencesAsync(50);
    }

    private async Task Define()
    {
        _defError = null;
        if (string.IsNullOrWhiteSpace(_defName)) { _defError = "Name is required."; return; }
        _defBusy = true;
        try
        {
            await Svc.DefineEventTypeAsync(_defName.Trim(),
                string.IsNullOrWhiteSpace(_defDescription) ? null : _defDescription.Trim(),
                string.IsNullOrWhiteSpace(_defSchema) ? null : _defSchema.Trim());
            _defName = ""; _defDescription = ""; _defSchema = "";
            await ReloadAsync();
        }
        catch (Exception ex) { _defError = ex.Message; }
        finally { _defBusy = false; }
    }

    private void Emit(string name)
    {
        _emitName = name;
        _emitPayload = "";
        _emitError = null;
    }

    private async Task DoEmit()
    {
        if (_emitName is null) return;
        _emitError = null;
        _emitBusy = true;
        try
        {
            var result = await Svc.EmitEventAsync(_emitName,
                ProjectId, string.IsNullOrWhiteSpace(_emitPayload) ? null : _emitPayload);
            _message = $"Emitted '{_emitName}' — {result.TriggeredRuns} trigger(s) fired.";
            _emitName = null;
            await ReloadAsync();
        }
        catch (Exception ex) { _emitError = ex.Message; }
        finally { _emitBusy = false; }
    }
}
