@page "/project/{ProjectId:guid}/events"
@attribute [Authorize(Policy = Permission.EventsManage)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject NavigationManager Nav

<PageTitle>PlaceContext — Events</PageTitle>

<div class="events-page">
    <header class="events-head">
        <div>
            <h2>Events</h2>
            <p>See what happened in the workspace and manage the event types that can start Jobs automatically.</p>
        </div>
        <div class="head-actions">
            <button class="dcbtn" @onclick="@(() => Nav.NavigateTo($"/project/{ProjectId}/jobs"))">Manage triggers</button>
            <button class="dcbtn primary" @onclick="BeginDefine">+ New event type</button>
        </div>
    </header>

    @if (_message is not null)
    {
        <div class="event-message @(_messageIsError ? "error" : null)">@_message</div>
    }

    @if (_loading)
    {
        <Skeleton Kind="list" Rows="5" />
    }
    else
    {
        <section class="summary-strip" aria-label="Event summary">
            <div class="summary-count"><strong>@(_types?.Count ?? 0)</strong><span>event types</span></div>
            <div class="summary-count"><strong>@CustomTypeCount</strong><span>custom</span></div>
            <div class="summary-count active"><strong>@ActiveSubscriptionCount</strong><span>active triggers</span></div>
            <div class="summary-count"><strong>@(_log?.Count ?? 0)</strong><span>recent events</span></div>
            <div class="summary-progress" title="@SubscriptionPercent% of event types have an active trigger">
                <span style="width:@SubscriptionPercent%"></span>
            </div>
        </section>

        <div class="event-layout">
            <section class="dccard event-panel type-panel">
                <header class="panel-head">
                    <div>
                        <span class="panel-caret">⌄</span>
                        <strong>Event types</strong>
                        <span>Choose one to emit it manually</span>
                    </div>
                    <span>@(_types?.Count ?? 0) available</span>
                </header>

                @if (_types is null or { Count: 0 })
                {
                    <div class="panel-empty">
                        <span class="empty-icon">◇</span>
                        <strong>No event types yet</strong>
                        <span>Create one to connect external activity to a Job.</span>
                        <button class="dcbtn primary" @onclick="BeginDefine">Create event type</button>
                    </div>
                }
                else
                {
                    <div class="type-rows">
                        @foreach (var eventType in _types)
                        {
                            var subscriberCount = SubscriberCount(eventType.Name);
                            <article class="type-row">
                                <div class="type-icon" aria-hidden="true">@(eventType.IsBuiltIn ? "◆" : "◇")</div>
                                <div class="type-copy">
                                    <div class="type-title">
                                        <strong>@eventType.Name</strong>
                                        <span class="type-chip">@(eventType.IsBuiltIn ? "built-in" : "custom")</span>
                                        @if (subscriberCount > 0)
                                        {
                                            <span class="type-chip subscribed">@subscriberCount active trigger@(subscriberCount == 1 ? "" : "s")</span>
                                        }
                                    </div>
                                    <p>@(string.IsNullOrWhiteSpace(eventType.Description) ? "No description provided." : eventType.Description)</p>
                                    @if (!string.IsNullOrWhiteSpace(eventType.PayloadSchema))
                                    {
                                        <details class="schema-details">
                                            <summary>Payload guidance</summary>
                                            <pre>@eventType.PayloadSchema</pre>
                                        </details>
                                    }
                                </div>
                                <button class="dcbtn emit-button" @onclick="@(() => Emit(eventType.Name))">Emit</button>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="dccard event-panel activity-panel">
                <header class="panel-head">
                    <div>
                        <span class="activity-mark" aria-hidden="true">●</span>
                        <strong>Recent activity</strong>
                        <span>Newest first</span>
                    </div>
                    <span>latest 50</span>
                </header>

                @if (_log is null or { Count: 0 })
                {
                    <div class="panel-empty">
                        <span class="empty-icon">↯</span>
                        <strong>No events emitted yet</strong>
                        <span>Emitted events will appear here with their source, time, and payload.</span>
                    </div>
                }
                else
                {
                    <div class="activity-rows">
                        @foreach (var occurrence in _log)
                        {
                            <article class="activity-row">
                                <div class="timeline">
                                    <span class="timeline-dot @SourceClass(occurrence.Source)"></span>
                                </div>
                                <div class="activity-copy">
                                    <div class="activity-title">
                                        <strong>@occurrence.Name</strong>
                                        <span class="source-chip @SourceClass(occurrence.Source)">@SourceLabel(occurrence.Source)</span>
                                    </div>
                                    <time datetime="@occurrence.OccurredAt.ToString("O")">
                                        @occurrence.OccurredAt.ToWorkspaceTime().ToString("yyyy-MM-dd · HH:mm:ss")
                                    </time>
                                    @if (!string.IsNullOrWhiteSpace(occurrence.Payload))
                                    {
                                        <details class="payload-details">
                                            <summary>View payload</summary>
                                            <pre>@occurrence.Payload</pre>
                                        </details>
                                    }
                                    else
                                    {
                                        <span class="no-payload">No payload</span>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    }
</div>

@if (_showDefinition)
{
    <div class="editor-backdrop" @onclick="CloseDefinition">
        <aside class="event-editor" @onclick:stopPropagation="true" role="dialog" aria-modal="true"
               aria-labelledby="event-definition-title">
            <header>
                <div>
                    <span class="eyebrow">EVENT TYPE</span>
                    <h3 id="event-definition-title">Define an event</h3>
                    <p>Name an activity that Jobs can listen for.</p>
                </div>
                <button class="close-button" aria-label="Close" @onclick="CloseDefinition">×</button>
            </header>
            <div class="editor-body">
                <label class="field">
                    <span>Name</span>
                    <input class="dcinput" @bind="_defName" placeholder="deploy.finished" />
                    <small>Use a short, stable name such as customer.created or invoice.paid.</small>
                </label>
                <label class="field">
                    <span>Description <small>optional</small></span>
                    <input class="dcinput" @bind="_defDescription" placeholder="What does this event mean?" />
                </label>
                <label class="field">
                    <span>Payload guidance <small>optional</small></span>
                    <textarea class="dcinput code-input" rows="8" @bind="_defSchema"
                              placeholder="Describe the fields people should include, or paste a JSON example."></textarea>
                    <small>This helps people prepare the event payload; it does not expose the event publicly.</small>
                </label>
                @if (_defError is not null)
                {
                    <div class="error-inline">@_defError</div>
                }
            </div>
            <footer>
                <button class="dcbtn" @onclick="CloseDefinition">Cancel</button>
                <button class="dcbtn primary" disabled="@_defBusy" @onclick="Define">
                    @(_defBusy ? "Creating…" : "Create event type")
                </button>
            </footer>
        </aside>
    </div>
}

@if (_emitName is not null)
{
    <div class="editor-backdrop" @onclick="CloseEmit">
        <aside class="event-editor emit-editor" @onclick:stopPropagation="true" role="dialog" aria-modal="true"
               aria-labelledby="emit-event-title">
            <header>
                <div>
                    <span class="eyebrow">EMIT EVENT</span>
                    <h3 id="emit-event-title">@_emitName</h3>
                    <p>Every enabled Job trigger listening for this name will start.</p>
                </div>
                <button class="close-button" aria-label="Close" @onclick="CloseEmit">×</button>
            </header>
            <div class="editor-body">
                <div class="impact-note">
                    <strong>@SubscriberCount(_emitName) active trigger@(SubscriberCount(_emitName) == 1 ? "" : "s")</strong>
                    <span>The payload becomes the input for each triggered Job.</span>
                </div>
                <label class="field">
                    <span>Payload <small>optional JSON</small></span>
                    <textarea class="dcinput code-input" rows="10" @bind="_emitPayload"
                              placeholder="{&quot;customerEmail&quot;: &quot;a@b.com&quot;}"></textarea>
                </label>
                @if (_emitError is not null)
                {
                    <div class="error-inline">@_emitError</div>
                }
            </div>
            <footer>
                <button class="dcbtn" @onclick="CloseEmit">Cancel</button>
                <button class="dcbtn primary" disabled="@_emitBusy" @onclick="DoEmit">
                    @(_emitBusy ? "Emitting…" : "Emit event")
                </button>
            </footer>
        </aside>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private IReadOnlyList<EventTypeView>? _types;
    private IReadOnlyList<EventOccurrenceView>? _log;
    private IReadOnlyList<TriggerView>? _triggers;
    private bool _loading = true;
    private string? _message;
    private bool _messageIsError;

    private bool _showDefinition;
    private string _defName = "";
    private string _defDescription = "";
    private string _defSchema = "";
    private bool _defBusy;
    private string? _defError;

    private string? _emitName;
    private string _emitPayload = "";
    private bool _emitBusy;
    private string? _emitError;

    private int CustomTypeCount => _types?.Count(eventType => !eventType.IsBuiltIn) ?? 0;
    private int ActiveSubscriptionCount => _triggers?.Count(trigger => trigger.Enabled && trigger.Kind == "Event") ?? 0;
    private int SubscribedTypeCount => _types?.Count(eventType => SubscriberCount(eventType.Name) > 0) ?? 0;
    private int SubscriptionPercent => _types is not { Count: > 0 }
        ? 0
        : (int)Math.Round(SubscribedTypeCount * 100d / _types.Count);

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _message = null;
        _messageIsError = false;
        try
        {
            await ReloadAsync();
            Ui.Set("Events", "workspace activity and event types");
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally { _loading = false; }
    }

    private async Task ReloadAsync()
    {
        var typesTask = Svc.ListEventTypesAsync();
        var logTask = Svc.ListEventOccurrencesAsync(50);
        var triggersTask = Svc.ListTriggersAsync(ProjectId);
        await Task.WhenAll(typesTask, logTask, triggersTask);
        _types = await typesTask;
        _log = await logTask;
        _triggers = await triggersTask;
    }

    private int SubscriberCount(string? eventName) => string.IsNullOrWhiteSpace(eventName)
        ? 0
        : _triggers?.Count(trigger => trigger.Enabled && trigger.Kind == "Event" &&
            string.Equals(trigger.EventName, eventName, StringComparison.OrdinalIgnoreCase)) ?? 0;

    private static string SourceClass(string source) =>
        string.Equals(source, "Domain", StringComparison.OrdinalIgnoreCase) ? "domain" : "user";

    private static string SourceLabel(string source) =>
        string.Equals(source, "Domain", StringComparison.OrdinalIgnoreCase) ? "system" : "manual";

    private void BeginDefine()
    {
        _defName = "";
        _defDescription = "";
        _defSchema = "";
        _defError = null;
        _showDefinition = true;
    }

    private void CloseDefinition()
    {
        if (!_defBusy) _showDefinition = false;
    }

    private async Task Define()
    {
        _defError = null;
        if (string.IsNullOrWhiteSpace(_defName))
        {
            _defError = "Name is required.";
            return;
        }

        _defBusy = true;
        try
        {
            var eventName = _defName.Trim();
            await Svc.DefineEventTypeAsync(eventName,
                string.IsNullOrWhiteSpace(_defDescription) ? null : _defDescription.Trim(),
                string.IsNullOrWhiteSpace(_defSchema) ? null : _defSchema.Trim());
            await ReloadAsync();
            _showDefinition = false;
            _messageIsError = false;
            _message = $"Created event type '{eventName}'.";
        }
        catch (Exception ex) { _defError = ex.Message; }
        finally { _defBusy = false; }
    }

    private void Emit(string name)
    {
        _emitName = name;
        _emitPayload = "";
        _emitError = null;
    }

    private void CloseEmit()
    {
        if (!_emitBusy) _emitName = null;
    }

    private async Task DoEmit()
    {
        if (_emitName is null) return;
        _emitError = null;
        _emitBusy = true;
        try
        {
            var eventName = _emitName;
            var result = await Svc.EmitEventAsync(eventName,
                ProjectId, string.IsNullOrWhiteSpace(_emitPayload) ? null : _emitPayload);
            await ReloadAsync();
            _emitName = null;
            _messageIsError = false;
            _message = $"Emitted '{eventName}' — {result.TriggeredRuns} trigger(s) fired.";
        }
        catch (Exception ex) { _emitError = ex.Message; }
        finally { _emitBusy = false; }
    }
}
