@page "/project/{ProjectId:guid}/events"
@attribute [Authorize(Policy = Permission.EventsManage)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@inject EventsViewModel Vm
@using PlaceContext.Host.Components.ViewModels

<PageTitle>PlaceContext — Events</PageTitle>

<div class="events-page">
    <header class="events-head">
        <div>
            <h2>Events</h2>
            <p>See what happened in the workspace and manage the event types that can start Jobs automatically.</p>
        </div>
        <div class="head-actions">
            <button class="dcbtn" @onclick="@(() => Vm.OpenJobs())">Manage triggers</button>
            <button class="dcbtn primary" @onclick="Vm.BeginDefine">+ New event type</button>
        </div>
    </header>

    @if (Vm.Message is not null)
    {
        <div class="event-message @(Vm.MessageIsError ? "error" : null)">@Vm.Message</div>
    }

    @if (Vm.Loading)
    {
        <Skeleton Kind="list" Rows="5" />
    }
    else
    {
        <section class="summary-strip" aria-label="Event summary">
            <div class="summary-count"><strong>@(Vm.Types?.Count ?? 0)</strong><span>event types</span></div>
            <div class="summary-count"><strong>@Vm.CustomTypeCount</strong><span>custom</span></div>
            <div class="summary-count active"><strong>@Vm.ActiveSubscriptionCount</strong><span>active triggers</span></div>
            <div class="summary-count"><strong>@(Vm.Log?.Count ?? 0)</strong><span>recent events</span></div>
            <div class="summary-progress" title="@Vm.SubscriptionPercent% of event types have an active trigger">
                <span style="width:@Vm.SubscriptionPercent%"></span>
            </div>
        </section>

        <div class="event-layout">
            <section class="dccard event-panel type-panel">
                <header class="panel-head">
                    <div>
                        <span class="panel-caret">⌄</span>
                        <strong>Event types</strong>
                        <span>Choose one to emit it manually</span>
                    </div>
                    <span>@(Vm.Types?.Count ?? 0) available</span>
                </header>

                @if (Vm.Types is null or { Count: 0 })
                {
                    <div class="panel-empty">
                        <span class="empty-icon">◇</span>
                        <strong>No event types yet</strong>
                        <span>Create one to connect external activity to a Job.</span>
                        <button class="dcbtn primary" @onclick="Vm.BeginDefine">Create event type</button>
                    </div>
                }
                else
                {
                    <div class="type-rows">
                        @foreach (var eventType in Vm.Types)
                        {
                            var subscriberCount = Vm.SubscriberCount(eventType.Name);
                            <article class="type-row">
                                <div class="type-icon" aria-hidden="true">@(eventType.IsBuiltIn ? "◆" : "◇")</div>
                                <div class="type-copy">
                                    <div class="type-title">
                                        <strong>@eventType.Name</strong>
                                        <span class="type-chip">@(eventType.IsBuiltIn ? "built-in" : "custom")</span>
                                        @if (subscriberCount > 0)
                                        {
                                            <span class="type-chip subscribed">@subscriberCount active trigger@(subscriberCount == 1 ? "" : "s")</span>
                                        }
                                    </div>
                                    <p>@(string.IsNullOrWhiteSpace(eventType.Description) ? "No description provided." : eventType.Description)</p>
                                    @if (!string.IsNullOrWhiteSpace(eventType.PayloadSchema))
                                    {
                                        <details class="schema-details">
                                            <summary>Payload guidance</summary>
                                            <pre>@eventType.PayloadSchema</pre>
                                        </details>
                                    }
                                </div>
                                <button class="dcbtn emit-button" @onclick="@(() => Vm.Emit(eventType.Name))">Emit</button>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="dccard event-panel activity-panel">
                <header class="panel-head">
                    <div>
                        <span class="activity-mark" aria-hidden="true">●</span>
                        <strong>Recent activity</strong>
                        <span>Newest first</span>
                    </div>
                    <span>latest 50</span>
                </header>

                @if (Vm.Log is null or { Count: 0 })
                {
                    <div class="panel-empty">
                        <span class="empty-icon">↯</span>
                        <strong>No events emitted yet</strong>
                        <span>Emitted events will appear here with their source, time, and payload.</span>
                    </div>
                }
                else
                {
                    <div class="activity-rows">
                        @foreach (var occurrence in Vm.Log)
                        {
                            <article class="activity-row">
                                <div class="timeline">
                                    <span class="timeline-dot @EventsViewModel.SourceClass(occurrence.Source)"></span>
                                </div>
                                <div class="activity-copy">
                                    <div class="activity-title">
                                        <strong>@occurrence.Name</strong>
                                        <span class="source-chip @EventsViewModel.SourceClass(occurrence.Source)">@EventsViewModel.SourceLabel(occurrence.Source)</span>
                                    </div>
                                    <time datetime="@Vm.Presentation.Iso(occurrence.OccurredAt)">
                                        @Vm.Presentation.Date(occurrence.OccurredAt) · @Vm.Presentation.Time(occurrence.OccurredAt)
                                    </time>
                                    @if (!string.IsNullOrWhiteSpace(occurrence.Payload))
                                    {
                                        <details class="payload-details">
                                            <summary>View payload</summary>
                                            <pre>@occurrence.Payload</pre>
                                        </details>
                                    }
                                    else
                                    {
                                        <span class="no-payload">No payload</span>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    }
</div>

@if (Vm.ShowDefinition)
{
    <div class="editor-backdrop" @onclick="Vm.CloseDefinition">
        <aside class="event-editor" @onclick:stopPropagation="true" role="dialog" aria-modal="true"
               aria-labelledby="event-definition-title">
            <header>
                <div>
                    <span class="eyebrow">EVENT TYPE</span>
                    <h3 id="event-definition-title">Vm.DefineAsync an event</h3>
                    <p>Name an activity that Jobs can listen for.</p>
                </div>
                <button class="close-button" aria-label="Close" @onclick="Vm.CloseDefinition">×</button>
            </header>
            <div class="editor-body">
                <label class="field">
                    <span>Name</span>
                    <input class="dcinput" @bind="Vm.DefinitionName" placeholder="deploy.finished" />
                    <small>Use a short, stable name such as customer.created or invoice.paid.</small>
                </label>
                <label class="field">
                    <span>Description <small>optional</small></span>
                    <input class="dcinput" @bind="Vm.DefinitionDescription" placeholder="What does this event mean?" />
                </label>
                <label class="field">
                    <span>Payload guidance <small>optional</small></span>
                    <textarea class="dcinput code-input" rows="8" @bind="Vm.DefinitionSchema"
                              placeholder="Describe the fields people should include, or paste a JSON example."></textarea>
                    <small>This helps people prepare the event payload; it does not expose the event publicly.</small>
                </label>
                @if (Vm.DefinitionError is not null)
                {
                    <div class="error-inline">@Vm.DefinitionError</div>
                }
            </div>
            <footer>
                <button class="dcbtn" @onclick="Vm.CloseDefinition">Cancel</button>
                <button class="dcbtn primary" disabled="@Vm.DefinitionBusy" @onclick="Vm.DefineAsync">
                    @(Vm.DefinitionBusy ? "Creating…" : "Create event type")
                </button>
            </footer>
        </aside>
    </div>
}

@if (Vm.EmitName is not null)
{
    <div class="editor-backdrop" @onclick="Vm.CloseEmit">
        <aside class="event-editor emit-editor" @onclick:stopPropagation="true" role="dialog" aria-modal="true"
               aria-labelledby="emit-event-title">
            <header>
                <div>
                    <span class="eyebrow">EMIT EVENT</span>
                    <h3 id="emit-event-title">@Vm.EmitName</h3>
                    <p>Every enabled Job trigger listening for this name will start.</p>
                </div>
                <button class="close-button" aria-label="Close" @onclick="Vm.CloseEmit">×</button>
            </header>
            <div class="editor-body">
                <div class="impact-note">
                    <strong>@Vm.SubscriberCount(Vm.EmitName) active trigger@(Vm.SubscriberCount(Vm.EmitName) == 1 ? "" : "s")</strong>
                    <span>The payload becomes the input for each triggered Job.</span>
                </div>
                <label class="field">
                    <span>Payload <small>optional JSON</small></span>
                    <textarea class="dcinput code-input" rows="10" @bind="Vm.EmitPayload"
                              placeholder="{&quot;customerEmail&quot;: &quot;a@b.com&quot;}"></textarea>
                </label>
                @if (Vm.EmitError is not null)
                {
                    <div class="error-inline">@Vm.EmitError</div>
                }
            </div>
            <footer>
                <button class="dcbtn" @onclick="Vm.CloseEmit">Cancel</button>
                <button class="dcbtn primary" disabled="@Vm.EmitBusy" @onclick="Vm.EmitAsync">
                    @(Vm.EmitBusy ? "Emitting…" : "Emit event")
                </button>
            </footer>
        </aside>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    protected override async Task OnParametersSetAsync() { Vm.Attach(() => InvokeAsync(StateHasChanged)); await Vm.LoadAsync(ProjectId); }
    public void Dispose() { Vm.Detach(); }
}
