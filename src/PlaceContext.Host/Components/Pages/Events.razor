@using PlaceContext.Application.Access.Models
@page "/project/{ProjectId:guid}/events"
@attribute [Authorize(Policy = Permission.EventsManage)]
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@implements IDisposable
@inject EventsViewModel Vm
@using PlaceContext.Host.Components.ViewModels

<PageTitle>PlaceContext — Events</PageTitle>

<div class="events-page">
    <header class="events-head">
        <div>
            <h2>Events</h2>
            <p>Investigate activity, define event contracts, and see which jobs respond to them.</p>
        </div>
        <div class="head-actions">
            <button class="dcbtn" @onclick="Vm.RefreshAsync"><AppIcon Kind="refresh" /> Refresh</button>
            <button class="dcbtn primary" @onclick="Vm.BeginDefine"><AppIcon Kind="plus" /> New event type</button>
        </div>
    </header>

    @if (Vm.Message is not null)
    {
        <div class="event-message @(Vm.MessageIsError ? "error" : null)">@Vm.Message</div>
    }

    @if (Vm.Loading)
    {
        <Skeleton Kind="list" Rows="5" />
    }
    else
    {
        <section class="summary-strip" aria-label="Event summary">
            <div class="summary-count"><strong>@(Vm.Types?.Count ?? 0)</strong><span>event types</span></div>
            <div class="summary-count"><strong>@Vm.CustomTypeCount</strong><span>custom</span></div>
            <div class="summary-count active"><strong>@Vm.ActiveSubscriptionCount</strong><span>active triggers</span></div>
            <div class="summary-count"><strong>@(Vm.Log?.Count ?? 0)</strong><span>recent events</span></div>
            <div class="summary-progress" title="@Vm.SubscriptionPercent% of event types have an active trigger">
                <span style="width:@Vm.SubscriptionPercent%"></span>
            </div>
        </section>

        <div class="dctabs event-tabs" aria-label="Event views">
            <button class="dctab @(Vm.IsActivityTab ? "active" : "")" @onclick="Vm.SelectActivityTab"><AppIcon Kind="pulse" /> Activity</button>
            <button class="dctab @(Vm.IsTypesTab ? "active" : "")" @onclick="Vm.SelectTypesTab"><AppIcon Kind="event" /> Event types</button>
            <button class="dctab @(Vm.IsSubscriptionsTab ? "active" : "")" @onclick="Vm.SelectSubscriptionsTab"><AppIcon Kind="chain" /> Subscriptions</button>
        </div>
        <div class="event-layout">
            @if (Vm.IsTypesTab)
            {
            <section class="dccard event-panel type-panel">
                <header class="panel-head">
                    <div>
                        <AppIcon Kind="event" />
                        <strong>Event types</strong>
                        <span>Workspace contracts that jobs can subscribe to</span>
                    </div>
                    <span>@(Vm.Types?.Count ?? 0) available</span>
                </header>

                @if (Vm.Types is null or { Count: 0 })
                {
                    <div class="panel-empty">
                        <span class="empty-icon"><AppIcon Kind="event" /></span>
                        <strong>No event types yet</strong>
                        <span>Create one to connect external activity to a Job.</span>
                        <button class="dcbtn primary" @onclick="Vm.BeginDefine">Create event type</button>
                    </div>
                }
                else
                {
                    <div class="type-rows">
                        @foreach (var eventType in Vm.Types)
                        {
                            var subscriberCount = Vm.SubscriberCount(eventType.Name);
                            <article class="type-row">
                                <div class="type-icon" aria-hidden="true"><AppIcon Kind="@(eventType.IsBuiltIn ? "settings" : "event")" /></div>
                                <div class="type-copy">
                                    <div class="type-title">
                                        <strong>@eventType.Name</strong>
                                        <span class="type-chip">@(eventType.IsBuiltIn ? "built-in" : "custom")</span>
                                        @if (subscriberCount > 0)
                                        {
                                            <span class="type-chip subscribed">@subscriberCount active trigger@(subscriberCount == 1 ? "" : "s")</span>
                                        }
                                    </div>
                                    <p>@(string.IsNullOrWhiteSpace(eventType.Description) ? "No description provided." : eventType.Description)</p>
                                    @if (!string.IsNullOrWhiteSpace(eventType.PayloadSchema))
                                    {
                                        <details class="schema-details">
                                            <summary>Payload guidance</summary>
                                            <RunOutput Value="@eventType.PayloadSchema" Label="Event payload schema JSON" />
                                        </details>
                                    }
                                </div>
                                <div class="type-actions">
                                    <button class="dcbtn" @onclick="() => Vm.ShowSubscriptions(eventType.Name)"><AppIcon Kind="chain" /> Subscriptions</button>
                                    @if (!eventType.IsBuiltIn) { <button class="dcbtn" @onclick="() => Vm.Emit(eventType.Name)"><AppIcon Kind="play" /> Emit event</button> }
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            }
            @if (Vm.IsActivityTab)
            {
            <div class="event-filters">
                <input class="dcinput" type="search" aria-label="Search events" placeholder="Search event names and payloads…" @bind="Vm.Search" @bind:event="oninput" />
                <select class="dcinput" aria-label="Event scope" @bind="Vm.Scope"><option value="project">This project</option><option value="workspace">Workspace</option></select>
                <select class="dcinput" aria-label="Event source" @bind="Vm.Source"><option value="">All sources</option><option value="Domain">System</option><option value="User">Manual</option></select>
            </div>
            <section class="dccard event-panel activity-panel">
                <header class="panel-head">
                    <div>
                        <AppIcon Kind="pulse" />
                        <strong>Activity timeline</strong>
                        <span>Newest first</span>
                    </div>
                    <span>@Vm.FilteredLog.Count() of latest 100 workspace events</span>
                </header>

                @if (!Vm.FilteredLog.Any())
                {
                    <div class="panel-empty">
                        <span class="empty-icon"><AppIcon Kind="pulse" /></span>
                        <strong>No matching activity</strong>
                        <span>Run a job or emit a custom event to see activity. Adjust the scope or filters to find other events.</span>
                    </div>
                }
                else
                {
                    <div class="activity-rows">
                        @foreach (var occurrence in Vm.FilteredLog)
                        {
                            <article class="activity-row">
                                <div class="timeline">
                                    <span class="timeline-dot @EventsViewModel.SourceClass(occurrence.Source)"></span>
                                </div>
                                <div class="activity-copy">
                                    <div class="activity-title">
                                        <strong>@occurrence.Name</strong>
                                        <span class="source-chip @EventsViewModel.SourceClass(occurrence.Source)">@EventsViewModel.SourceLabel(occurrence.Source)</span>
                                    </div>
                                    @if (EventsViewModel.Outcome(occurrence) is { } outcome) { <span class="event-outcome">@outcome</span> }
                                    @if (EventsViewModel.OriginRunId(occurrence) is { } runId)
                                    {
                                        <a class="event-run-link" href="@($"/observability?run={runId}")"><AppIcon Kind="logs" /> Inspect run and logs <AppIcon Kind="arrow-right" /></a>
                                    }
                                    <time datetime="@Vm.Presentation.Iso(occurrence.OccurredAt)">
                                        @Vm.Presentation.Date(occurrence.OccurredAt) · @Vm.Presentation.Time(occurrence.OccurredAt)
                                    </time>
                                    @if (!string.IsNullOrWhiteSpace(occurrence.Payload))
                                    {
                                        <details class="payload-details">
                                            <summary>View payload</summary>
                                            <RunOutput Value="@occurrence.Payload" Label="Event payload JSON" />
                                        </details>
                                    }
                                    else
                                    {
                                        <span class="no-payload">No payload</span>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
            }
            @if (Vm.IsSubscriptionsTab)
            {
                <div class="subscription-intro"><h3>What happens when an event arrives?</h3><p>Enabled subscriptions start their job when the event name matches. These subscriptions belong to this project; event names are shared across the workspace.</p></div>
                <div class="event-filters">
                    <label for="subscription-event">Event type</label>
                    <select id="subscription-event" class="dcinput" @bind="Vm.SubscriptionEvent"><option value="">All event types</option>@foreach (var type in Vm.Types ?? []) { <option value="@type.Name">@type.Name</option> }</select>
                    <button class="dcbtn" @onclick="Vm.OpenJobs"><AppIcon Kind="plus" /> Manage job triggers</button>
                </div>
                <section class="dccard event-panel" aria-label="Event subscriptions">
                    @foreach (var trigger in Vm.EventSubscriptions)
                    {
                        <article class="subscription-row">
                            <AppIcon Kind="chain" />
                            <div><strong>@trigger.Name</strong><p><code>@trigger.EventName</code> <AppIcon Kind="arrow-right" /> Job trigger</p><small>Last fired: @(trigger.LastFiredAt is { } fired ? Vm.Presentation.DateTime(fired) : "Never")</small></div>
                            <span class="type-chip @(trigger.Enabled ? "subscribed" : "")">@(trigger.Enabled ? "Enabled" : "Paused")</span>
                            <button class="dcbtn" @onclick="() => Vm.OpenSubscription(trigger)">Manage <AppIcon Kind="arrow-right" /></button>
                        </article>
                    }
                    @if (!Vm.EventSubscriptions.Any())
                    {
                        <div class="panel-empty"><span class="empty-icon"><AppIcon Kind="chain" /></span><strong>No subscriptions here yet</strong><span>Open a job's Triggers tab, choose Event, and select the event name that should start it.</span><button class="dcbtn primary" @onclick="Vm.OpenJobs">Choose a job</button></div>
                    }
                </section>
            }
        </div>
    }
</div>

@if (Vm.ShowDefinition)
{
    <div class="editor-backdrop" @onclick="Vm.CloseDefinition">
        <aside class="event-editor" @onclick:stopPropagation="true" role="dialog" aria-modal="true"
               aria-labelledby="event-definition-title">
            <header>
                <div>
                    <span class="eyebrow">EVENT TYPE</span>
                    <h3 id="event-definition-title">Define an event</h3>
                    <p>Name an activity that Jobs can listen for.</p>
                </div>
                <button class="close-button" aria-label="Close" @onclick="Vm.CloseDefinition"><AppIcon Kind="close" /></button>
            </header>
            <div class="editor-body">
                <label class="field">
                    <span>Name</span>
                    <input class="dcinput" @bind="Vm.DefinitionName" placeholder="deploy.finished" />
                    <small>Use a short, stable name such as customer.created or invoice.paid.</small>
                </label>
                <label class="field">
                    <span>Description <small>optional</small></span>
                    <input class="dcinput" @bind="Vm.DefinitionDescription" placeholder="What does this event mean?" />
                </label>
                <label class="field">
                    <span>Payload guidance <small>optional</small></span>
                    <textarea class="dcinput code-input" rows="8" @bind="Vm.DefinitionSchema"
                              placeholder="Describe the fields people should include, or paste a JSON example."></textarea>
                    <small>This helps people prepare the event payload; it does not expose the event publicly.</small>
                </label>
                @if (Vm.DefinitionError is not null)
                {
                    <div class="error-inline">@Vm.DefinitionError</div>
                }
            </div>
            <footer>
                <button class="dcbtn" @onclick="Vm.CloseDefinition">Cancel</button>
                <button class="dcbtn primary" disabled="@Vm.DefinitionBusy" @onclick="Vm.DefineAsync">
                    @(Vm.DefinitionBusy ? "Creating…" : "Create event type")
                </button>
            </footer>
        </aside>
    </div>
}

@if (Vm.EmitName is not null)
{
    <div class="editor-backdrop" @onclick="Vm.CloseEmit">
        <aside class="event-editor emit-editor" @onclick:stopPropagation="true" role="dialog" aria-modal="true"
               aria-labelledby="emit-event-title">
            <header>
                <div>
                    <span class="eyebrow">EMIT EVENT</span>
                    <h3 id="emit-event-title">@Vm.EmitName</h3>
                    <p>Matching enabled subscriptions across the workspace will start their jobs.</p>
                </div>
                <button class="close-button" aria-label="Close" @onclick="Vm.CloseEmit"><AppIcon Kind="close" /></button>
            </header>
            <div class="editor-body">
                <div class="impact-note">
                    <strong>@Vm.SubscriberCount(Vm.EmitName) active subscription@(Vm.SubscriberCount(Vm.EmitName) == 1 ? "" : "s") in this project</strong>
                    <span>The payload becomes the input for each triggered Job.</span>
                </div>
                <label class="field">
                    <span>Payload <small>optional JSON</small></span>
                    <textarea class="dcinput code-input" rows="10" @bind="Vm.EmitPayload"
                              placeholder="{&quot;customerEmail&quot;: &quot;a@b.com&quot;}"></textarea>
                </label>
                @if (Vm.EmitError is not null)
                {
                    <div class="error-inline">@Vm.EmitError</div>
                }
            </div>
            <footer>
                <button class="dcbtn" @onclick="Vm.CloseEmit">Cancel</button>
                <button class="dcbtn primary" disabled="@Vm.EmitBusy" @onclick="Vm.EmitAsync">
                    @(Vm.EmitBusy ? "Emitting…" : "Emit event")
                </button>
            </footer>
        </aside>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    protected override async Task OnParametersSetAsync() { Vm.Attach(() => InvokeAsync(StateHasChanged)); await Vm.LoadAsync(ProjectId); }
    public void Dispose() { Vm.Detach(); }
}
