@page "/settings/billing"
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@attribute [Authorize(Policy = Policies.DefaultAdmin)]
@using PlaceContext.Application.Billing
@inject BillingSettingsViewModel Vm
@implements IDisposable

<PageTitle>PlaceContext — Billing and usage</PageTitle>
<div class="page">
    <div class="page-head">
        <div>
            <h1 class="page-title">Billing &amp; usage</h1>
            <p class="page-sub">Manage this workspace's plan, usage, invoices and payment details.
                Job execution is configured separately in <a href="@PageRoutes.ClusterSettings">Cluster settings</a>.</p>
        </div>
        <button class="dcbtn" disabled="@Vm.Busy" @onclick="Vm.LoadAsync"><AppIcon Kind="refresh" /> Refresh</button>
    </div>
    @if (Vm.Welcome)
    {
        <section class="dccard" aria-label="Welcome to PlaceContext"
                 style="padding:20px 24px; margin:16px 0; border-color:var(--brand)">
            <strong>Workspace billing</strong>
            <p class="text-3-12">Your account and default project are created.
                Review your subscription below. Execution becomes available after payment is confirmed.</p>
            @if (Vm.StartPlan is not null)
            {
                <p class="text-3-12">You selected <strong>@Vm.SelectedPlanName</strong>.
                    Review its features and proceed with secure checkout.</p>
            }
        </section>
    }
    @if (Vm.CheckoutNotice is { } notice)
    {
        <div class="dccard" role="status" style="padding:16px">@notice</div>
    }
    @if (!Vm.ManagedHosting)
    {
        <div class="dccard" style="padding:16px; margin:16px 0">
            <strong>Self-hosted workspace</strong>
            <p class="text-3-12">Your infrastructure costs are managed with your hosting providers.
                Developer Edition does not require a managed subscription.</p>
        </div>
    }
    @if (Vm.Error is { } error)
    {
        <div class="dccard" role="alert" style="padding:16px; color:var(--bad)">@error</div>
    }
    @if (Vm.Current is not null)
    {
        <section class="dccard" style="padding:24px; margin:16px 0" aria-label="Current plan">
            <span class="text-3-12">Current plan</span>
            <h2 style="font-size:22px; margin:6px 0">
                @Vm.PlanName · @Vm.StatusLabel
            </h2>
            <div style="font-size:30px; font-weight:700">
                @(Vm.SubscriptionRequired ? "Choose a managed plan" : "Unlimited runs")
            </div>
            <p class="text-3-12">
                @Vm.UsageLabel reserved this period. Period: @Vm.PeriodLabel.
            </p>
            <p class="text-3-12">
                @Vm.StartRateLabel
            </p>
            @if (Vm.SubscriptionRequired)
            {
                <p role="alert">Developer Edition is self-hosted only.
                    Choose a managed plan to run workflows on hosted PlaceContext.</p>
            }
            else if (Vm.RunsUnavailable)
            {
                <p role="alert">New runs cannot start because the subscription is inactive,
                    expired or unconfigured. Existing run history remains available.</p>
            }
        </section>
        <section class="dccard" style="padding:24px; margin:16px 0" aria-label="Payment details and invoices">
            <h2 class="title-16">Payment details &amp; invoices</h2>
            <p class="text-3-12">Manage payment methods, billing details, invoices and subscription changes in the secure billing portal.</p>
            @if (Vm.CanManage)
            {
                <button class="dcbtn" disabled="@Vm.Busy" @onclick="Vm.ManageAsync">Open billing portal</button>
            }
            else
            {
                <p class="text-3-12">Billing management becomes available once this workspace has a billing account.</p>
            }
        </section>
        <h2 class="title-16" style="margin:24px 0 12px">Plans</h2>
        <p class="text-3-12">Proposed prices in USD, excluding taxes. Checkout or a signed
            Enterprise agreement confirms prices, SLAs and terms.</p>
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:12px">
            @foreach (var tier in RunPlans.Tiers)
            {
                <section class="dccard" id="@("plan-" + tier.Code)"
                         style="padding:20px; @(Vm.StartPlan == tier.Code ? "border-color:var(--brand);" : "")" @key="tier.Code">
                    <h3>@tier.Name</h3>
                    <div style="font-size:20px; font-weight:700">@tier.PriceLabel</div>
                    <strong>Unlimited workflow &amp; job runs</strong>
                    <p class="text-3-12">@tier.Description</p>
                    <p class="text-3-12">
                        @(tier.StartsPerMinute is { } tierRate
                            ? $"Up to {tierRate:N0} new starts per minute"
                            : tier.Code == RunPlans.Developer
                                ? "Limited by your own infrastructure"
                                : "Start rate agreed by contract")
                    </p>
                    @if (tier.Code is RunPlans.Basic or RunPlans.Standard)
                    {
                        <p class="text-3-12">Up to @RunPlans.ConcurrentRuns(tier.Code) concurrent
                            top-level executions across the cluster</p>
                    }
                    <p class="text-3-12">@tier.Availability</p>
                    <p class="text-3-12">@tier.Support</p>
                    <ul class="text-3-12">
                        @foreach (var feature in tier.Features)
                        {
                            <li>@feature</li>
                        }
                    </ul>
                    @if (tier.SelfService && Vm.ManagedHosting)
                    {
                        @if (Vm.HasActiveSubscription)
                        {
                            <p class="text-3-12">Use the billing portal above to change plans.</p>
                        }
                        else
                        {
                            <button class="dcbtn primary" disabled="@(!Vm.CanChoosePlan)"
                                    @onclick="() => Vm.CheckoutAsync(tier.Code)">Choose @tier.Name</button>
                        }
                    }
                    else if (tier.Code == RunPlans.Enterprise)
                    {
                        @if (Vm.EnterpriseSalesUrl is { } salesUrl)
                        {
                            <a class="dcbtn" href="@salesUrl.AbsoluteUri"
                               rel="noopener noreferrer">Discuss Enterprise</a>
                        }
                        else
                        {
                            <p class="text-3-12">Contact PlaceContext for a custom contract.</p>
                        }
                    }
                    else if (tier.Code == RunPlans.Developer)
                    {
                        <p class="text-3-12">Available for self-hosted development installations.</p>
                    }
                    else
                    {
                        <p class="text-3-12">Available in a managed workspace.</p>
                    }
                </section>
            }
        </div>
        <p class="text-3-12" style="margin-top:18px">
            Usage is metered for reporting, never volume caps. Start pacing is shared across
            replicas. Concurrent top-level runs share a cluster-wide capacity limit,
            not a monthly run cap; dedicated CPU/memory still requires an agreement.
            SLAs and resource terms require separate service agreements.
        </p>
    }
</div>
@code {
    [SupplyParameterFromQuery(Name = "start")]
    public string? StartPlan { get; set; }

    [SupplyParameterFromQuery(Name = "welcome")]
    public string? Welcome { get; set; }

    [SupplyParameterFromQuery(Name = "checkout")]
    public string? Checkout { get; set; }

    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override void OnParametersSet() => Vm.SetParameters(StartPlan, Welcome, Checkout);
    protected override Task OnInitializedAsync() => Vm.LoadAsync();
    public void Dispose() => Vm.Detach();
}
