@page "/settings/billing"
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@attribute [Authorize(Policy = Policies.DefaultAdmin)]
@using PlaceContext.Application.Billing
@inject BillingSettingsViewModel Vm
@implements IDisposable

<PageTitle>PlaceContext — Billing and usage</PageTitle>
<div class="page">
    <div class="page-head">
        <div>
            <h1 class="page-title">Billing &amp; usage</h1>
            <p class="page-sub">Unlimited workflow and standalone job starts on every edition.
                Managed tiers pace new starts rather than charging per execution.
                Child jobs, retries and resumptions do not add usage.</p>
        </div>
        <button class="dcbtn" disabled="@Vm.Busy" @onclick="Vm.LoadAsync"><AppIcon Kind="refresh" /> Refresh</button>
    </div>
    @if (Vm.Error is { } error)
    {
        <div class="dccard" role="alert" style="padding:16px; color:var(--bad)">@error</div>
    }
    @if (Vm.Current is { } plan)
    {
        var activePaid = plan.Plan != RunPlans.Developer
            && (plan.Status == "active" || plan.Status == "trialing");
        <section class="dccard" style="padding:24px; margin:16px 0" aria-label="Current plan">
            <span class="text-3-12">Current plan</span>
            <h2 style="font-size:22px; margin:6px 0">@RunPlans.NameFor(plan.Plan) · @plan.Status</h2>
            <div style="font-size:30px; font-weight:700">Unlimited runs</div>
            <p class="text-3-12">
                @plan.UsedRuns.ToString("N0") top-level starts reserved this period.
                Period: @plan.PeriodStart.ToLocalTime().ToString("d") to @plan.PeriodEnd.ToLocalTime().ToString("d").
            </p>
            <p class="text-3-12">
                @(plan.StartsPerMinute is { } rate
                    ? $"Up to {rate:N0} workflow/job starts per minute (admission rate)"
                    : "No application-imposed start pacing on this edition")
            </p>
            @if (plan.Status == "self_hosted_only")
            {
                <p role="alert">Developer Edition is self-hosted only.
                    Choose a managed plan to run workflows on hosted PlaceContext.</p>
            }
            else if (!plan.CanRun)
            {
                <p role="alert">New runs cannot start because the subscription is inactive,
                    expired or unconfigured. Existing run history remains available.</p>
            }
            @if (activePaid)
            {
                <button class="dcbtn" disabled="@Vm.Busy" @onclick="Vm.ManageAsync">Manage subscription at Stripe</button>
            }
        </section>
        <h2 class="title-16" style="margin:24px 0 12px">Plans</h2>
        <p class="text-3-12">Proposed prices in USD, excluding taxes. Stripe Checkout or a signed
            Enterprise agreement confirms prices, SLAs and terms.</p>
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:12px">
            @foreach (var tier in RunPlans.Tiers)
            {
                <section class="dccard" style="padding:20px" @key="tier.Code">
                    <h3>@tier.Name</h3>
                    <div style="font-size:20px; font-weight:700">@tier.PriceLabel</div>
                    <strong>Unlimited workflow &amp; job runs</strong>
                    <p class="text-3-12">@tier.Description</p>
                    <p class="text-3-12">
                        @(tier.StartsPerMinute is { } tierRate
                            ? $"Up to {tierRate:N0} new starts per minute"
                            : tier.Code == RunPlans.Developer
                                ? "Limited by your own infrastructure"
                                : "Start rate agreed by contract")
                    </p>
                    @if (tier.Code is RunPlans.Basic or RunPlans.Standard)
                    {
                        <p class="text-3-12">Up to @RunPlans.ConcurrentRuns(tier.Code) concurrent
                            top-level executions across the cluster</p>
                    }
                    <p class="text-3-12">@tier.Availability</p>
                    <p class="text-3-12">@tier.Support</p>
                    <ul class="text-3-12">
                        @foreach (var feature in tier.Features)
                        {
                            <li>@feature</li>
                        }
                    </ul>
                    @if (tier.SelfService)
                    {
                        @if (activePaid)
                        {
                            <p class="text-3-12">Use Manage subscription above to change plans.</p>
                        }
                        else
                        {
                            <button class="dcbtn primary" disabled="@Vm.Busy"
                                    @onclick="() => Vm.CheckoutAsync(tier.Code)">Choose @tier.Name</button>
                        }
                    }
                    else if (tier.Code == RunPlans.Enterprise)
                    {
                        @if (Vm.EnterpriseSalesUrl is { } salesUrl)
                        {
                            <a class="dcbtn" href="@salesUrl.AbsoluteUri"
                               rel="noopener noreferrer">Discuss Enterprise</a>
                        }
                        else
                        {
                            <p class="text-3-12">Contact PlaceContext for a custom contract.</p>
                        }
                    }
                    else
                    {
                        <p class="text-3-12">Available for self-hosted development installations.</p>
                    }
                </section>
            }
        </div>
        <p class="text-3-12" style="margin-top:18px">
            Usage is metered for reporting, never volume caps. Start pacing is shared across
            replicas. Concurrent top-level runs share a cluster-wide capacity limit,
            not a monthly run cap; dedicated CPU/memory still requires an agreement.
            SLAs and resource terms require separate service agreements.
        </p>
    }
</div>
@code {
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override Task OnInitializedAsync() => Vm.LoadAsync();
    public void Dispose() => Vm.Detach();
}
