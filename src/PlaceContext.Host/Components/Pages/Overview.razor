@page "/overview"
@attribute [Authorize(Policy = Permission.ProjectsView)]
@implements IDisposable
@inject OverviewViewModel Vm
@using PlaceContext.Host.Components.ViewModels

<PageTitle>PlaceContext — Overview</PageTitle>

<div class="page">

    <!-- root stat strip -->
    <div class="stat-strip">
        @foreach (var s in Vm.Stats)
        {
            <div class="stat-cell">
                <div class="stat-label">@s.Label</div>
                <div class="stat-value" style="color:@s.Color">@s.Value</div>
                <div class="stat-sub">@s.Sub</div>
            </div>
        }
    </div>

    <!-- current focus checklist -->
    <div class="dccard focus-card">
        <div class="focus-head">
            <span class="section-title">Current focus</span>
            <span class="section-hint">what needs attention across your workspace</span>
            @if (Vm.Focus is { Items.Count: > 0 })
            {
                <span class="focus-count">@Vm.Focus.Items.Count</span>
            }
        </div>
        @if (Vm.Focus is null)
        {
            <div class="focus-skeleton"><Skeleton Kind="list" Rows="3" /></div>
        }
        else if (Vm.Focus.Items.Count == 0)
        {
            <div class="dcfocus-clear">✓ All clear — nothing needs attention right now.</div>
        }
        else
        {
            @foreach (var f in Vm.Focus.Items)
            {
                <button class="dcfocus-row sev-@f.Severity" @onclick="@(() => Vm.OpenFocus(f.Url))">
                    <span class="dcfocus-box"></span>
                    <span class="min-w-0">
                        <span class="dcfocus-title">@f.Title</span>
                        <div class="dcfocus-detail">@f.Detail</div>
                    </span>
                    <span class="dcfocus-proj">@f.Project</span>
                </button>
            }
        }
    </div>

    <div class="projects-head">
        <div class="projects-title-group">
            <h2 class="projects-title">Projects</h2>
            <span class="projects-count">@(Vm.Projects?.Count ?? 0)</span>
        </div>
        <div class="projects-actions">
            <button class="dcbtn primary" @onclick="Vm.RefreshAsync" disabled="@Vm.Busy">@(Vm.Busy ? "Refreshing…" : "Vm.RefreshAsync")</button>
        </div>
    </div>

    @if (Vm.Projects is null)
    {
        <Skeleton Kind="card-grid" Cards="6" />
    }
    else if (Vm.Projects.Count == 0)
    {
        <div class="dccard empty-card">
            No projects yet. Projects register themselves through the MCP <code>create_project</code> tool when an agent starts working in a repo.
        </div>
    }
    else
    {
        <div class="projects-grid">
            @foreach (var p in Vm.Projects)
            {
                <div class="dccard project-card" @onclick="@(() => Vm.Open(p.Id))">
                    <div class="project-card-head">
                        <div class="min-w-0">
                            <div class="project-name-row">
                                <span class="lang-dot" style="background:@OverviewViewModel.LanguageColor(p.Path)"></span>
                                <span class="project-name">@p.Name</span>
                            </div>
                            <div class="project-path">@p.Path</div>
                        </div>
                        <div class="status-badge">
                            <span class="status-dot"></span>
                            @p.Status
                        </div>
                    </div>

                    <div class="map-row">
                        <div class="minimap">
                            <svg viewBox="0 0 100 76" width="100%" height="100%" preserveAspectRatio="xMidYMid slice">
                                @foreach (var (x, y, god) in OverviewViewModel.MiniNodes(p))
                                {
                                    <circle cx="@OverviewViewModel.Number(x)" cy="@OverviewViewModel.Number(y)" r="@(god ? "3" : "1.3")" fill="@(god ? "var(--brand)" : "var(--text-3)")"></circle>
                                }
                            </svg>
                            <span class="minimap-badge">@p.GodNodeCount god</span>
                        </div>
                    </div>

                    <div class="project-foot">
                        <span class="foot-graphified">@(p.IsGraphified ? "graphified" : "not graphified")</span>
                        <div class="foot-stats">
                            <span>@p.NodeCount nodes</span>
                            <span class="foot-sep">·</span>
                            <span>@p.LinkCount links</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    protected override async Task OnInitializedAsync() { Vm.Attach(() => InvokeAsync(StateHasChanged)); await Vm.LoadAsync(); }
    public void Dispose() { Vm.Detach(); }
}
