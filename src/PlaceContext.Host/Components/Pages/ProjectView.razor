@page "/project/{Id:guid}"
@attribute [Authorize(Policy = Permission.ProjectsView)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@inject ProjectViewModel Vm
@using PlaceContext.Host.Components.ViewModels
@using PlaceContext.Application.Dtos

<PageTitle>PlaceContext — Project</PageTitle>

@if (Vm.Overview is null)
{
    <Skeleton Kind="detail" Rows="6" Padded />
}
else
{
    <div class="page">
        <button class="dcbtn back-btn" @onclick="@(() => Vm.BackToProjects())">← All projects</button>

        <div class="header-row">
            <div>
                <div class="title-row">
                    <span class="lang-dot" style="background:@ProjectViewModel.LanguageColor(Vm.Overview.Path)"></span>
                    <h1 class="project-title">@Vm.Overview.Name</h1>
                    <span class="status-pill">@Vm.Overview.Status</span>
                </div>
                <div class="project-path">@Vm.Overview.Path</div>
            </div>
        </div>

        @if (Vm.Message is not null) { <div class="message">@Vm.Message</div> }


        <div class="dctabs tabs">
            @foreach (var (key, label) in ProjectViewModel.TabItems)
            {
                <button class="dctab @(Vm.Tab == key ? "active" : "")" @onclick="@(() => Vm.SwitchTab(key))">@label</button>
            }
        </div>

        @if (Vm.Tab == ProjectViewModel.Tabs.Overview)
        {
        <!-- god-nodes -->
        <div class="dccard section-card pad-card">
                <div class="god-head">
                    <span class="card-title">God-nodes</span>
                    <span class="meta-mono">top degree</span>
                </div>
                @if (Vm.Overview.GodNodes.Count == 0)
                {
                    <div class="muted-note">None detected.</div>
                }
                else
                {
                    <div class="god-list">
                        @foreach (var g in Vm.Overview.GodNodes)
                        {
                            <div class="god-row">
                                <span class="god-dot"></span>
                                <span class="god-label">@g.Label</span>
                                <span class="god-degree">@g.Degree edges</span>
                            </div>
                        }
                    </div>
                }
        </div>
        }

        @if (Vm.Tab == ProjectViewModel.Tabs.Requirements)
        {
        <!-- project requirements -->
        <div class="dccard section-card">
            <div class="card-head">
                <div class="head-title-group">
                    <span class="card-title">Requirements</span>
                    <span class="meta-mono">project-specific · added on top of the global requirements</span>
                </div>
                <div class="head-actions">
                    @if (Vm.Requirements?.UpdatedAt is { } rts)
                    {
                        <span class="meta-mono">updated @Vm.RequirementUpdated(rts)</span>
                    }
                    <button class="dcbtn primary" @onclick="Vm.SaveRequirementsAsync" disabled="@(Vm.SavingRequirements || !Vm.RequirementsDirty)">@(Vm.SavingRequirements ? "saving…" : "Save requirements")</button>
                </div>
            </div>
            <div class="card-body">
                @if (Vm.Requirements is null)
                {
                    <Skeleton Kind="text" Rows="4" />
                }
                else
                {
                    <textarea @bind="Vm.RequirementsDraft" spellcheck="false"
                        placeholder="Requirements specific to this project (Markdown) — frameworks, patterns, constraints the review &amp; skill prompts should enforce here."
                        class="editor editor-req"></textarea>
                }
            </div>
        </div>
        }

        @if (Vm.Tab == ProjectViewModel.Tabs.Activity)
        {
        <!-- decisions -->
        <div id="decisions" class="dccard section-card">
            <div class="card-head-title">Decisions</div>
            @if (Vm.Decisions is null)
            {
                <div class="section-loading"><Skeleton Kind="list" Rows="3" /></div>
            }
            else if (Vm.Decisions.Count == 0)
            {
                <div class="empty-note">No decisions recorded yet — they flow in through the <code>add_decision</code> MCP tool.</div>
            }
            else
            {
                @foreach (var d in Vm.Decisions)
                {
                    <div id="@($"decision-{d.Id}")" class="dcflashable decision-row">
                        <div class="decision-head">
                            <span class="decision-q">@d.Question</span>
                            <span class="meta-mono">@Vm.DecisionDate(d.DecidedAt)</span>
                        </div>
                        <div class="decision-choice">→ @d.Choice</div>
                        @if (Vm.HasDecisionRationale(d))
                        {
                            <div class="decision-rationale">@d.Rationale</div>
                        }
                    </div>
                }
            }
        </div>
        }

        @if (Vm.Tab == ProjectViewModel.Tabs.Activity)
        {
        <!-- recent changes -->
        <div id="changes" class="dccard section-card">
            <div class="card-head-title">Recent changes</div>
            @if (Vm.Timeline is null)
            {
                <div class="section-loading"><Skeleton Kind="list" Rows="4" /></div>
            }
            else if (Vm.Timeline.Changes.Count == 0)
            {
                <div class="empty-note">No changes recorded yet — they flow in through the <code>record_activity</code> MCP tool.</div>
            }
            else
            {
                @foreach (var c in Vm.Timeline.Changes)
                {
                    <div class="change-row">
                        <span class="change-seq">#@c.Sequence</span>
                            <span class="change-kind" style="color:@Vm.ChangeColor(c.Kind); background:@Vm.ChangeBackground(c.Kind)">@Vm.ChangeLabel(c.Kind)</span>
                        <span class="change-title">@c.Title</span>
                        <span class="meta-mono">@(c.Commit ?? "—")</span>
                    </div>
                }
            }
        </div>
        }

    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    protected override async Task OnParametersSetAsync() { Vm.Attach(() => InvokeAsync(StateHasChanged)); await Vm.LoadAsync(Id); }
    protected override async Task OnAfterRenderAsync(bool firstRender) { await Vm.AfterRenderAsync(); }
    public void Dispose() { Vm.Detach(); }
}
