@page "/project/{Id:guid}"
@attribute [Authorize]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PlaceContext.Infrastructure.Operations.OperationCenter OpCenter
@using Microsoft.Extensions.DependencyInjection
@using PlaceContext.Application.Dtos

<PageTitle>PlaceContext — Project</PageTitle>

@if (_overview is null)
{
    <Skeleton Kind="detail" Rows="6" Padded />
}
else
{
    <div class="page">
        <button class="dcbtn back-btn" @onclick="@(() => Nav.NavigateTo("/"))">← All projects</button>

        <div class="header-row">
            <div>
                <div class="title-row">
                    <span class="lang-dot" style="background:@Viz.LangColor(_overview.Path)"></span>
                    <h1 class="project-title">@_overview.Name</h1>
                    <span class="status-pill">@_overview.Status</span>
                </div>
                <div class="project-path">@_overview.Path</div>
            </div>
            <button class="dcbtn" @onclick="Rebuild" disabled="@_busy">@(_busy ? "running…" : "rebuild tree")</button>
        </div>

        @if (_message is not null) { <div class="message">@_message</div> }


        <div class="dctabs tabs">
            @foreach (var (key, label) in new[] { ("overview", "Overview"), ("requirements", "Requirements"), ("activity", "Activity"), ("mcp", "MCP") })
            {
                <button class="dctab @(_tab == key ? "active" : "")" @onclick="@(() => SwitchTab(key))">@label</button>
            }
        </div>

        @if (_tab == "overview")
        {
        <!-- graph (full width) -->
        <div class="dccard graph-card">
                <div class="card-head">
                    <div class="head-title-group">
                        <span class="card-title">Dependency graph</span>
                        <span class="meta-mono">@(_graph?.NodeCount ?? 0) nodes · @(_graph?.LinkCount ?? 0) links</span>
                    </div>
                    <div class="graph-legend">
                        <span class="legend-item"><span class="legend-dot"></span>god-node</span>
                        <span class="legend-item"><span class="legend-dash"></span>ambiguous</span>
                    </div>
                </div>
                <div class="graph-body">
                    @if (_graph is null)
                    {
                        <div class="graph-loading">
                            <Skeleton Kind="detail" Rows="4" />
                        </div>
                    }
                    else if (_graph.NodeCount == 0)
                    {
                        <div class="graph-empty">
                            No tree yet — click <code class="inline-code">rebuild tree</code> to build it from logged activity.
                        </div>
                    }
                    else
                    {
                        <GraphCanvas Graph="_graph" Height="420" Searchable="true" AllowFullscreen="true" NodeUrl="OverviewNodeUrl" />
                    }
                </div>
        </div>

        <!-- god-nodes -->
        <div class="dccard section-card pad-card">
                <div class="god-head">
                    <span class="card-title">God-nodes</span>
                    <span class="meta-mono">top degree</span>
                </div>
                @if (_overview.GodNodes.Count == 0)
                {
                    <div class="muted-note">None detected.</div>
                }
                else
                {
                    <div class="god-list">
                        @foreach (var g in _overview.GodNodes)
                        {
                            <div class="god-row">
                                <span class="god-dot"></span>
                                <span class="god-label">@g.Label</span>
                                <span class="god-degree">@g.Degree edges</span>
                            </div>
                        }
                    </div>
                }
        </div>
        }

        @if (_tab == "requirements")
        {
        <!-- project requirements -->
        <div class="dccard section-card">
            <div class="card-head">
                <div class="head-title-group">
                    <span class="card-title">Requirements</span>
                    <span class="meta-mono">project-specific · added on top of the global requirements</span>
                </div>
                <div class="head-actions">
                    @if (_requirements?.UpdatedAt is { } rts)
                    {
                        <span class="meta-mono">updated @rts.ToWorkspaceTime().ToString("yyyy-MM-dd HH:mm")</span>
                    }
                    <button class="dcbtn primary" @onclick="SaveRequirements" disabled="@(_savingReq || !RequirementsDirty)">@(_savingReq ? "saving…" : "Save requirements")</button>
                </div>
            </div>
            <div class="card-body">
                @if (_requirements is null)
                {
                    <Skeleton Kind="text" Rows="4" />
                }
                else
                {
                    <textarea @bind="_reqDraft" spellcheck="false"
                        placeholder="Requirements specific to this project (Markdown) — frameworks, patterns, constraints the review &amp; skill prompts should enforce here."
                        class="editor editor-req"></textarea>
                }
            </div>
        </div>
        }

        @if (_tab == "activity")
        {
        <!-- decisions -->
        <div id="decisions" class="dccard section-card">
            <div class="card-head-title">Decisions</div>
            @if (_decisions is null)
            {
                <div class="section-loading"><Skeleton Kind="list" Rows="3" /></div>
            }
            else if (_decisions.Count == 0)
            {
                <div class="empty-note">No decisions recorded yet — they flow in through the <code>add_decision</code> MCP tool.</div>
            }
            else
            {
                @foreach (var d in _decisions)
                {
                    <div id="@($"decision-{d.Id}")" class="dcflashable decision-row">
                        <div class="decision-head">
                            <span class="decision-q">@d.Question</span>
                            <span class="meta-mono">@d.DecidedAt.ToWorkspaceTime().ToString("yyyy-MM-dd")</span>
                        </div>
                        <div class="decision-choice">→ @d.Choice</div>
                        @if (!string.IsNullOrWhiteSpace(d.Rationale) && d.Rationale != "(none)")
                        {
                            <div class="decision-rationale">@d.Rationale</div>
                        }
                    </div>
                }
            }
        </div>
        }

        @if (_tab == "activity")
        {
        <!-- recent changes -->
        <div id="changes" class="dccard section-card">
            <div class="card-head-title">Recent changes</div>
            @if (_timeline is null)
            {
                <div class="section-loading"><Skeleton Kind="list" Rows="4" /></div>
            }
            else if (_timeline.Changes.Count == 0)
            {
                <div class="empty-note">No changes recorded yet — they flow in through the <code>record_activity</code> MCP tool.</div>
            }
            else
            {
                @foreach (var c in _timeline.Changes)
                {
                    <div class="change-row">
                        <span class="change-seq">#@c.Sequence</span>
                        <span class="change-kind" style="color:@Viz.AuthorColor(c.Kind); background:@Viz.AuthorBg(c.Kind)">@c.Kind.ToLower()</span>
                        <span class="change-title">@c.Title</span>
                        <span class="meta-mono">@(c.Commit ?? "—")</span>
                    </div>
                }
            }
        </div>
        }

        @if (_tab == "mcp")
        {
        <div class="dccard section-card">
            <div class="card-head">
                <div class="head-title-group">
                    <span class="card-title">MCP Servers</span>
                    <span class="meta-mono">external tool servers available to jobs in this project</span>
                </div>
                <button class="dcbtn primary" @onclick="ShowAddMcp">+ Add MCP Server</button>
            </div>
            <div class="mcp-list">
                @if (_mcpConnections is null)
                {
                    <Skeleton Kind="list" Rows="3" />
                }
                else if (_mcpConnections.Count == 0)
                {
                    <div class="empty-note">No MCP servers configured yet. Add one to make it available to jobs.</div>
                }
                else
                {
                    @foreach (var mcp in _mcpConnections)
                    {
                        var isExpired = mcp.OAuthTokenExpiresAt.HasValue && mcp.OAuthTokenExpiresAt.Value <= DateTimeOffset.UtcNow;
                        var isConnected = mcp.LastStatus?.StartsWith("oauth:connected") == true;
                        <div class="mcp-item @(mcp.Enabled ? "" : "disabled")">
                            <div class="mcp-info">
                                <span class="mcp-name">@mcp.Name</span>
                                <span class="mcp-badge">@mcp.Transport</span>
                                @if (mcp.AuthType == "oauth")
                                {
                                    <span class="mcp-badge oauth @(isExpired ? "expired" : isConnected ? "active" : "")">
                                        @(isExpired ? "token expired" : isConnected ? "oauth connected" : "oauth")
                                    </span>
                                }
                                @if (!string.IsNullOrEmpty(mcp.LastStatus))
                                {
                                    <span class="mcp-status @(mcp.LastStatus.StartsWith("connected") || mcp.LastStatus.StartsWith("http:2") || mcp.LastStatus.StartsWith("oauth:connected") ? "ok" : "err")">@mcp.LastStatus</span>
                                }
                            </div>
                            <div class="mcp-actions">
                                @if (mcp.AuthType == "oauth")
                                {
                                    <button class="dcbtn xs" @onclick="@(() => StartOAuthFlow(mcp.Id))">@(isExpired ? "Reconnect" : "Auth")</button>
                                }
                                <button class="dcbtn xs" @onclick="@(() => TestMcpConnectionAsync(mcp.Id))">Test</button>
                                <button class="dcbtn xs danger" @onclick="@(() => DeleteMcpConnectionAsync(mcp.Id))">×</button>
                            </div>
                        </div>
                    }
                }
            </div>
            @if (_showAddMcp)
            {
                <div class="mcp-form">
                    <div class="mcp-form-title">New MCP Server</div>
                    <div class="dcfield">
                        <label>Name</label>
                        <input class="dcinput" @bind="_newMcpName" placeholder="My MCP Server" />
                    </div>
                    <div class="dcfield">
                        <label>Transport</label>
                        <select class="dcinput" @bind="_newMcpTransport">
                            <option value="http">HTTP</option>
                            <option value="sse">SSE</option>
                            <option value="stdio">Stdio</option>
                        </select>
                    </div>
                    @if (_newMcpTransport != "stdio")
                    {
                        <div class="dcfield">
                            <label>Endpoint URL</label>
                            <input class="dcinput" @bind="_newMcpEndpoint" placeholder="https://mcp.example.com/mcp" />
                        </div>
                    }
                    else
                    {
                        <div class="dcfield">
                            <label>Command</label>
                            <input class="dcinput" @bind="_newMcpCommand" placeholder="npx" />
                        </div>
                        <div class="dcfield">
                            <label>Args (JSON array)</label>
                            <input class="dcinput" @bind="_newMcpArgs" placeholder='["-y", "server"]' />
                        </div>
                    }
                    <div class="mcp-auth-section">
                        <div class="mcp-auth-header" @onclick="@(() => _showMcpAuthFields = !_showMcpAuthFields)">
                            <span>Authentication</span>
                            <span class="mcp-auth-chevron">@(_showMcpAuthFields ? "▾" : "▸")</span>
                        </div>
                        @if (_showMcpAuthFields)
                        {
                            <div class="dcfield">
                                <label>Auth Type</label>
                                <select class="dcinput" @bind="_newMcpAuthType">
                                    <option value="none">None</option>
                                    <option value="bearer">Bearer Token</option>
                                    <option value="apikey">API Key</option>
                                    <option value="header">Custom Header</option>
                                    <option value="oauth">OAuth 2.1</option>
                                </select>
                            </div>
                            @if (_newMcpAuthType == "bearer" || _newMcpAuthType == "apikey")
                            {
                                <div class="dcfield">
                                    <label>Token</label>
                                    <input class="dcinput" type="password" @bind="_newMcpAuthToken" placeholder="token" />
                                </div>
                            }
                            else if (_newMcpAuthType == "header")
                            {
                                <div class="dcfield">
                                    <label>Header Name</label>
                                    <input class="dcinput" @bind="_newMcpAuthHeader" placeholder="X-API-Key" />
                                </div>
                                <div class="dcfield">
                                    <label>Header Value</label>
                                    <input class="dcinput" type="password" @bind="_newMcpAuthToken" placeholder="value" />
                                </div>
                            }
                            else if (_newMcpAuthType == "oauth")
                            {
                                <div class="dcfield">
                                    <label>Scopes (optional)</label>
                                    <input class="dcinput" @bind="_newMcpOAuthScopes" placeholder="openid profile" />
                                </div>
                                <div class="dchint">The OAuth flow will open in a popup.</div>
                            }
                        }
                    </div>
                    <div class="mcp-form-actions">
                        <button class="dcbtn xs" @onclick="@(() => _showAddMcp = false)">Cancel</button>
                        <button class="dcbtn xs primary" @onclick="AddMcpConnectionAsync">Add</button>
                    </div>
                </div>
            }
        </div>
        }

    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private ProjectOverviewView? _overview;
    private GraphVizView? _graph;

    // The dependency graph carries ALL the related data: on top of the knowledge graph, every
    // entity joins as a hub with sampled records, entity↔entity relations, tagged runs, and the
    // latest version of each artifact — one brain for the whole project.
    private readonly Dictionary<string, string> _overviewNodeUrls = new();

    private string? OverviewNodeUrl(GraphNodeView node) => _overviewNodeUrls.GetValueOrDefault(node.Id);

    private async Task<GraphVizView?> MergeDataGraphAsync(GraphVizView? graph)
    {
        _overviewNodeUrls.Clear();
        try
        {
            var entities = await Svc.ListDataEntitiesAsync(Id);
            if (entities.Count == 0) return graph;

            var nodes = new List<GraphNodeView>(graph?.Nodes ?? Array.Empty<GraphNodeView>());
            var links = new List<GraphLinkView>(graph?.Links ?? Array.Empty<GraphLinkView>());
            // Membership by id — the run/artifact dedup checks below were O(nodes) list scans
            // inside nested loops, which crawled once the graph grew.
            var nodeIds = new HashSet<string>(nodes.Select(n => n.Id), StringComparer.Ordinal);
            var degree = new Dictionary<string, int>();
            void Link(string a, string b)
            {
                links.Add(new GraphLinkView(a, b, "Direct"));
                degree[a] = degree.GetValueOrDefault(a) + 1;
                degree[b] = degree.GetValueOrDefault(b) + 1;
            }

            // Each entity costs a live SQL sample + tagged-run + artifact lookups, all sequential
            // on the circuit — bound the fan-out so the overview stays snappy on data-heavy projects.
            foreach (var entity in entities.Take(12))
            {
                var eId = $"entity:{entity.Id}";
                nodes.Add(new GraphNodeView(eId, entity.Name, 0, IsGod: true,
                    Content: $"business entity · {entity.TableName}"));
                _overviewNodeUrls[eId] = $"/project/{Id}/entity/{Uri.EscapeDataString(entity.Name)}";

                foreach (var rel in entity.Relations)
                {
                    var target = entities.FirstOrDefault(x => string.Equals(x.Name, rel.TargetEntity, StringComparison.OrdinalIgnoreCase));
                    if (target is not null) Link(eId, $"entity:{target.Id}");
                }

                // A sample of records under each entity hub (first text-looking column labels them).
                try
                {
                    var rows = await Svc.ExecuteProjectDataAsync(Id, $"SELECT * FROM \"{entity.TableName.Replace("\"", "")}\" LIMIT 8");
                    var labelIdx = 0;
                    for (var c = 0; c < rows.Columns.Count; c++)
                    {
                        var v = rows.Rows.FirstOrDefault() is { } fr && c < fr.Count ? fr[c] : null;
                        if (!string.Equals(rows.Columns[c], "id", StringComparison.OrdinalIgnoreCase)
                            && v is not null && !double.TryParse(v, out _)) { labelIdx = c; break; }
                    }
                    for (var r = 0; r < rows.Rows.Count; r++)
                    {
                        var label = labelIdx < rows.Rows[r].Count ? rows.Rows[r][labelIdx] ?? "—" : "—";
                        var rid = $"record:{entity.Id}:{r}";
                        nodes.Add(new GraphNodeView(rid, label, 0, false, Content: $"{entity.Name} record", Kind: "human"));
                        _overviewNodeUrls[rid] = $"/project/{Id}/entity/{Uri.EscapeDataString(entity.Name)}?record={Uri.EscapeDataString(label ?? "")}";
                        Link(eId, rid);
                    }
                }
                catch { }

                // Tagged runs + the latest version of each artifact.
                try
                {
                    var runIds = (await Svc.ListEntityRunsAsync(entity.Id)).Take(5).ToList();
                    var arts = new List<PlaceContext.Application.Features.RunArtifactLinkView>();
                    foreach (var runId in runIds)
                    {
                        var rid = $"run:{runId}";
                        if (nodeIds.Add(rid))
                        {
                            nodes.Add(new GraphNodeView(rid, $"run {runId.ToString("N")[..8]}", 0, false, Content: "tagged job run"));
                            _overviewNodeUrls[rid] = $"/observability?run={runId}";
                        }
                        Link(eId, rid);
                        try { arts.AddRange(await Svc.ListRunArtifactsAsync(runId)); } catch { }
                    }
                    foreach (var g in arts.GroupBy(a => (a.Kind, a.Title)))
                    {
                        var latest = g.OrderByDescending(a => a.CreatedAt).First();
                        var aid = $"art:{latest.Id}";
                        var label = g.Count() > 1 ? $"{latest.Title} · v{g.Count()}" : latest.Title;
                        if (nodeIds.Add(aid))
                        {
                            nodes.Add(new GraphNodeView(aid, label, 0, false,
                                Content: $"artifact · {latest.Kind}", Kind: "good", Labeled: true));
                            _overviewNodeUrls[aid] = $"/artifacts?artifact={latest.Id}";
                        }
                        Link($"run:{latest.RunId}", aid);
                    }
                }
                catch { }
            }

            nodes = nodes.Select(n => degree.TryGetValue(n.Id, out var d) ? n with { Degree = n.Degree + d } : n).ToList();
            return new GraphVizView(Id, nodes.Count, links.Count, nodes, links);
        }
        catch
        {
            return graph; // the knowledge graph alone is still a fine overview
        }
    }
    private ActivityTimelineView? _timeline;
    private IReadOnlyList<DecisionView>? _decisions;

    private string _tab = "overview";

    private string? _message;
    private bool _busy;

    private RequirementsView? _requirements;
    private string _reqDraft = string.Empty;
    private string _reqSaved = string.Empty;
    private bool _savingReq;
    private bool RequirementsDirty => !string.Equals(_reqDraft, _reqSaved, StringComparison.Ordinal);

    private bool _scrollPending;

    // ── MCP state ─────────────────────────────────────────────────────────────
    private IReadOnlyList<McpConnectionView>? _mcpConnections;
    private bool _showAddMcp;
    private bool _showMcpAuthFields;
    private string _newMcpName = "";
    private string _newMcpTransport = "http";
    private string _newMcpEndpoint = "";
    private string _newMcpCommand = "";
    private string _newMcpArgs = "";
    private string _newMcpAuthType = "none";
    private string _newMcpAuthToken = "";
    private string _newMcpAuthHeader = "";
    private string _newMcpOAuthScopes = "";

    // OnParametersSet (not OnInitialized) so navigating between projects reloads the data.
    protected override async Task OnParametersSetAsync()
    {
        // Sub-pages link back here with ?tab= so their tab strip can open a project-local tab.
        var query = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        // Unknown/retired tab values in old deep links (e.g. "board", "knowledge") fall back to overview.
        if (query["tab"] is { Length: > 0 } tab)
            _tab = tab is "overview" or "requirements" or "activity" or "mcp" ? tab : "overview";
        await Load();
    }

    private async Task Load()
    {
        await LoadOverviewAsync();
        _ = LoadDetailsAsync();
    }

    private async Task LoadOverviewAsync()
    {
        _overview = await Svc.GetProjectOverviewAsync(Id);
        Ui.Set(_overview.Name, $"{_overview.Path} · {_overview.Status}");
        _scrollPending = true; // arrived (often from a search hit) — scroll to the URL fragment once loaded
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadDetailsAsync()
    {
        var graphTask = LoadGraphAsync();
        var timelineTask = LoadTimelineAsync();
        var requirementsTask = LoadRequirementsAsync();
        var decisionsTask = LoadDecisionsAsync();

        await Task.WhenAll(graphTask, timelineTask, requirementsTask, decisionsTask);
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadMcpConnectionsAsync()
    {
        try { _mcpConnections = await Svc.ListMcpConnectionsAsync(Id); }
        catch (Exception ex) { _message = $"Could not load MCP connections: {ex.Message}"; }
    }

    private async Task LoadGraphAsync()
    {
        try
        {
            var graph = await Svc.GetGraphVizAsync(Id);
            _graph = await MergeDataGraphAsync(graph);
        }
        catch (Exception ex)
        {
            _message = $"Could not load dependency graph: {ex.Message}";
        }
    }

    private async Task LoadTimelineAsync()
    {
        try { _timeline = await Svc.GetTimelineAsync(Id, 8); }
        catch (Exception ex) { _message = $"Could not load timeline: {ex.Message}"; }
    }

    private async Task LoadRequirementsAsync()
    {
        try
        {
            _requirements = await Svc.GetProjectRequirementsAsync(Id);
            _reqDraft = _reqSaved = _requirements.Markdown;
        }
        catch (Exception ex) { _message = $"Could not load requirements: {ex.Message}"; }
    }

    private async Task LoadDecisionsAsync()
    {
        try { _decisions = await Svc.GetDecisionsAsync(Id); }
        catch (Exception ex) { _message = $"Could not load decisions: {ex.Message}"; }
    }

    protected override void OnInitialized()
    {
        ProjectMcpOAuthCompleted += async (_, _) =>
        {
            await LoadMcpConnectionsAsync();
            await InvokeAsync(StateHasChanged);
        };
    }

    // After the loaded page renders, scroll to (and flash) the section/decision named in the URL
    // fragment — e.g. /project/{id}#changes or #decision-{id} from a search hit.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("eval", @"
if (!window.__projectMcpOAuthListener) {
    window.__projectMcpOAuthListener = function(e) {
        if (e.data && e.data.startsWith && e.data.startsWith('mcp-oauth-')) {
            DotNet.invokeMethodAsync('PlaceContext.Host', 'OnProjectMcpOAuthCallback', e.data);
        }
    };
    window.addEventListener('message', window.__projectMcpOAuthListener);
}");
        }
        if (_scrollPending && _overview is not null)
        {
            _scrollPending = false;
            await JS.InvokeVoidAsync("placecontext.scrollToHash");
        }
    }

    private async Task SaveRequirements()
    {
        _savingReq = true; _message = null;
        try
        {
            _requirements = await Svc.SetProjectRequirementsAsync(Id, _reqDraft);
            _reqDraft = _reqSaved = _requirements.Markdown;
            _message = "Project requirements saved.";
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _savingReq = false; }
    }

    private async Task SwitchTab(string key)
    {
        _tab = key;
        if (key == "mcp" && _mcpConnections is null)
        {
            await LoadMcpConnectionsAsync();
        }
        StateHasChanged();
    }

    private void ShowAddMcp()
    {
        _showAddMcp = true;
        _showMcpAuthFields = false;
        _newMcpName = "";
        _newMcpTransport = "http";
        _newMcpEndpoint = "";
        _newMcpCommand = "";
        _newMcpArgs = "";
        _newMcpAuthType = "none";
        _newMcpAuthToken = "";
        _newMcpAuthHeader = "";
        _newMcpOAuthScopes = "";
    }

    private async Task AddMcpConnectionAsync()
    {
        _message = null;
        try
        {
            await Svc.CreateMcpConnectionAsync(new(
                Id, _newMcpName, _newMcpTransport, _newMcpEndpoint, _newMcpCommand, _newMcpArgs,
                _newMcpAuthType, _newMcpAuthToken, _newMcpAuthHeader, null, _newMcpOAuthScopes));
            _showAddMcp = false;
            _message = "MCP server added.";
            await LoadMcpConnectionsAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task TestMcpConnectionAsync(Guid connectionId)
    {
        _message = null;
        try
        {
            var result = await Svc.TestMcpConnectionAsync(connectionId);
            _message = $"{result.Name}: {result.LastStatus ?? "unknown"}";
            await LoadMcpConnectionsAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task DeleteMcpConnectionAsync(Guid connectionId)
    {
        _message = null;
        try
        {
            await Svc.DeleteMcpConnectionAsync(connectionId);
            _message = "MCP server deleted.";
            await LoadMcpConnectionsAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task StartOAuthFlow(Guid connectionId)
    {
        await JS.InvokeVoidAsync("open", $"/mcp-oauth/start?connectionId={connectionId}", "_blank");
    }

    [JSInvokable]
    public static async Task OnProjectMcpOAuthCallback(string message)
    {
        ProjectMcpOAuthCompleted?.Invoke(null, EventArgs.Empty);
    }

    private static event EventHandler? ProjectMcpOAuthCompleted;

    private Task Rebuild()
    {
        _message = null;
        _busy = true;
        var tenant = PlaceContext.Infrastructure.Tenancy.CurrentTenant.Current;
        if (tenant is null) { _message = "No tenant resolved — sign in again."; _busy = false; return Task.CompletedTask; }
        // Background portal operation: navigating away doesn't interrupt the rebuild; the
        // notifications bell carries the outcome.
        OpCenter.Run(tenant, Id, $"Rebuild dependency graph — {_overview?.Name ?? "project"}", $"/project/{Id}",
            async (sp, ct) =>
            {
                await sp.GetRequiredService<IPlaceContextService>().RebuildGraphAsync(Id, ct: ct);
                return "graph rebuilt";
            });
        _busy = false;
        _message = "Rebuild started in the background — follow it in the notifications bell.";
        return Task.CompletedTask;
    }
}
