@page "/project/{ProjectId:guid}/agents"
@page "/project/{ProjectId:guid}/agents/{Section}"
@using PlaceContext.Application.Access.Models
@using PlaceContext.Application.Build
@using PlaceContext.Host.Components.ViewModels
@attribute [Authorize(Policy = Permission.ProjectsView)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@inject ProjectAgentsViewModel Vm
@implements IDisposable
<AssistantPageContext ReadContext="Vm.AssistantContextAsync" />

<PageTitle>PlaceContext — @(Vm.Agent is { Id: var agentId } selected ? agentId == DashboardSettings.DefaultAgentId ? "Master agent" : selected.Name : "Agents")</PageTitle>

@if (Vm.Loading)
{
    <Skeleton Kind="list" Rows="5" Padded />
}
else
{
    <div class="chains-page" inert="@Vm.EditorOpen">
        <WorkflowTabs ProjectId="ProjectId" Active="agents" />
        <header class="chains-head">
            <div>
                <h2>Agents</h2>
                <p>Define how agents work across this project.</p>
            </div>
            <div class="head-actions">
                <button class="dcbtn" disabled="@Vm.Busy" @onclick="() => Vm.LoadPageAsync(ProjectId, Section)">Refresh</button>
                @if (Vm.CanManage)
                {
                    <button class="dcbtn primary" @onclick="Vm.CreateAgent"><AppIcon Kind="plus" /> New agent</button>
                }
            </div>
        </header>

        @if (Vm.Error is { } error) { <div class="status-message" role="alert">@error</div> }
        @if (Vm.Notice is { } notice) { <div class="status-message" role="status">@notice</div> }

        @if (!Vm.Agents.Any())
        {
            <div class="dccard empty-state">
                <div class="empty-icon"><AppIcon Kind="agent" /></div>
                <strong>No agents yet</strong>
                <span>Choose instructions, workflow capabilities, data access and MCP connections.</span>
            </div>
        }
        else
        {
            <section class="summary-strip" aria-label="Agent summary">
                <div class="summary-count"><strong>@Vm.Agents.Count()</strong><span>agents</span></div>
                <div class="summary-count"><strong>@Vm.Catalog.Agents.Count</strong><span>shared</span></div>
                <div class="summary-count"><strong>@Vm.Agents.Sum(a => a.WorkflowIds.Count)</strong><span>workflow links</span></div>
                <div class="summary-count"><strong>@Vm.Mcps.Count</strong><span>MCP connections</span></div>
            </section>

            <section class="agent-catalogue dccard" aria-label="Agent catalogue">
                <header class="catalogue-head"><strong>Agent hierarchy</strong><span>@Vm.Agents.Count() agents</span></header>
                @AgentBranch(Vm.RootAgents)
            </section>
        }
    </div>
}

@if (Vm.EditorOpen && Vm.Agent is { } agent)
{
    <div class="dcmodal-overlay">
    <section class="dcmodal agent-workspace" role="dialog" aria-modal="false" aria-labelledby="agent-workspace-title" tabindex="-1" @onkeydown="OnKeyDown">
        <div class="dcmodal-head">
            <div class="flex-min">
                <div id="agent-workspace-title" class="title-14">@(agent.Id == DashboardSettings.DefaultAgentId ? "Master agent" : Vm.Existing ? agent.Name : "New agent")</div>
                <div class="sub-115">@(Vm.EditingPrivateAgent ? "Private dashboard agent. Changes apply to your dashboard conversations." : "Shared project agent. Changes apply to new runs and session turns.")</div>
            </div>
            @if (Vm.Existing) { <a class="dcbtn" href="/project/@ProjectId/dashboard?agent=@agent.Id"><AppIcon Kind="play" /> Use agent</a> }
            <button aria-label="Close agent" disabled="@Vm.Busy" class="dcslide-x" @onclick="() => Vm.CloseEditor(Section)"><AppIcon Kind="close" /></button>
        </div>

        <div class="dctabs editor-tabs" aria-label="Agent settings sections">
            @foreach (var tab in new[] { "Overview", "System prompt", "Workflows", "Observability", "Markup", "Data", "MCPs" })
            {
                <button type="button" class="dctab @(Vm.AgentTab == tab ? "active" : "")" aria-pressed="@(Vm.AgentTab == tab ? "true" : "false")" disabled="@Vm.Busy" @onclick="() => SetTabAsync(tab)">@(tab == "System prompt" ? "Instructions" : tab == "MCPs" ? "Connected tools" : tab)</button>
            }
        </div>

        <div class="dcmodal-body editor-body">
            @if (agent.Id == DashboardSettings.DefaultAgentId && Vm.AgentTab == "Overview")
            {
                <p>The master agent coordinates workflows and the project agents assigned to their steps. Its instructions are private to you; its permissions still apply.</p>
            }

            <div class="agent-tab-panel" hidden="@(Vm.AgentTab != "Overview")">
                <label for="project-agent-name">Agent name</label><input id="project-agent-name" class="dcinput" maxlength="60" @bind="agent.Name" disabled="@(!Vm.CanEdit || Vm.Busy)" />
                @if (agent.Id != DashboardSettings.DefaultAgentId)
                {
                    <label for="project-agent-parent">Parent agent</label>
                    <select id="project-agent-parent" class="dcinput" @bind="agent.ParentAgentId" disabled="@(!Vm.CanEdit || Vm.Busy)">
                        <option value="">Master agent</option>
                        @foreach (var parent in Vm.ParentAgents.OrderBy(a => a.Name)) { <option value="@parent.Id">@parent.DisplayName</option> }
                    </select>
                    <p>The parent approves this agent's work and handles its automatic workflow approval gates. Shared agents can report to other shared agents; private agents to your private agents.</p>
                }
                <label for="project-agent-connection">Model connection</label>
                <select id="project-agent-connection" class="dcinput" value="@agent.ConnectionId" @onchange="e => Vm.SelectConnection(e.Value?.ToString())" disabled="@(!Vm.CanEdit || Vm.Busy)"><option value="@Guid.Empty">Runner's default model</option>@foreach (var connection in Vm.Connections) { <option value="@connection.Id">@connection.Name</option> }</select>
                @if (agent.ConnectionId != Guid.Empty)
                {
                    <label for="project-agent-model">Model</label><select id="project-agent-model" class="dcinput" @bind="agent.Model" disabled="@(!Vm.CanEdit || Vm.Busy)"><option value="">Select model</option>@foreach (var model in Vm.Models) { <option>@model</option> }</select>
                }
            </div>

            @if (Vm.AgentTab == "System prompt")
            {
            <div class="agent-tab-panel">
                <label>Agent instructions</label>
                <p>Define this agent's role, behavior and response style for chats and workflow steps. Changes apply on the next turn or run. Up to 8,000 characters.</p>
                @if (Vm.CanEdit) { <div class="instructions-editor"><WorkflowInstructionsEditor @key="agent.Id" @ref="_instructions" Value="@agent.Instructions" Label="Agent system prompt" /></div> }
                else { <RunOutput Value="@agent.Instructions" Language="markdown" Label="Agent system prompt" /> }
            </div>

            }

            <div class="agent-tab-panel" hidden="@(Vm.AgentTab != "Workflows")">
                <label for="agent-workflows">Workflow capabilities</label><select id="agent-workflows" class="dcinput" @bind="agent.WorkflowAccess" disabled="@(!Vm.CanEdit || Vm.Busy)"><option value="none">No access</option><option value="read">Inspect workflows, jobs and run output</option><option value="run">Inspect and run workflows and jobs</option><option value="manage">Create, edit, run and schedule</option></select>
                <p>Limit the agent's workflow tools within your permissions. Workflow agent steps also apply their own tool limits.</p>
                <fieldset disabled="@(!Vm.CanEdit || Vm.Busy || !Vm.CanViewWorkflows)"><legend>Linked workflows</legend>
                    <p>Give this agent workflows to use as context. Links do not restrict access to other project workflows; the capabilities above still apply.</p>
                    @if (!Vm.CanViewWorkflows) { <p>Workflow access is required to view and change links.</p> }
                    else
                    {
                        @foreach (var workflow in Vm.Workflows.OrderBy(w => w.Name))
                        {
                            <div class="linked-workflow">
                                <label class="check"><input type="checkbox" checked="@agent.WorkflowIds.Contains(workflow.Id)" @onchange="e => Vm.ToggleWorkflow(workflow.Id, e.Value is true)" />@workflow.Name</label>
                                <a class="dcbtn" href="/project/@ProjectId/workflows/@workflow.Id">Open workflow</a>
                                <a class="dcbtn" href="/project/@ProjectId/workflows/@workflow.Id/runs">Runs</a>
                            </div>
                        }
                        @foreach (var missing in agent.WorkflowIds.Where(id => !Vm.Workflows.Any(w => w.Id == id)).ToArray())
                        {
                            <label class="check"><input type="checkbox" checked @onchange="e => Vm.ToggleWorkflow(missing, false)" />Unavailable workflow — remove link</label>
                        }
                        @if (Vm.Workflows.Count == 0) { <p>No workflows in this project yet.</p> }
                    }
                </fieldset>
            </div>

            @if (Vm.AgentTab == "Observability")
            {
                <section class="agent-tab-panel" aria-label="Agent observability">
                    <div class="panel-heading"><div><h3>Session activity</h3><p>Your sessions for this agent, within your 100 most recent project sessions.</p></div><button class="dcbtn" disabled="@Vm.ActivityLoading" @onclick="Vm.LoadActivityAsync"><AppIcon Kind="refresh" /> Refresh</button></div>
                    @if (Vm.ActivityLoading) { <Skeleton Kind="list" Rows="3" /> }
                    else if (Vm.ActivityError is { } activityError) { <p role="alert">@activityError</p> }
                    else
                    {
                        <div class="summary-strip" aria-label="Session summary">
                            <div class="summary-count"><strong>@Vm.Sessions.Count</strong><span>sessions</span></div>
                            <div class="summary-count"><strong>@Vm.Sessions.Count(s => s.Status is BuildRunStatus.Running or BuildRunStatus.Queued)</strong><span>active</span></div>
                            <div class="summary-count"><strong>@Vm.Sessions.Count(s => s.Status == BuildRunStatus.Completed)</strong><span>completed</span></div>
                            <div class="summary-count"><strong>@Vm.Sessions.Count(s => s.Status == BuildRunStatus.Failed)</strong><span>failed</span></div>
                        </div>
                        @foreach (var session in Vm.Sessions)
                        {
                            <a class="activity-row" href="/project/@ProjectId/dashboard?conversation=@session.Id&amp;agent=@agent.Id">
                                <strong>@session.Title</strong><span class="session-status @session.Status.ToString().ToLowerInvariant()">@session.Status</span><time datetime="@session.UpdatedAt.ToString("O")">@Vm.Presentation.Date(session.UpdatedAt)</time><span>View session →</span>
                            </a>
                        }
                        @if (Vm.Sessions.Count == 0) { <p class="panel-empty">No recent sessions for this agent. Use the agent to start a conversation.</p> }
                    }
                    <h3>Linked workflow activity</h3>
                    <p>Execution history for linked workflows. These runs may involve other agents.</p>
                    @foreach (var workflow in Vm.Workflows.Where(w => agent.WorkflowIds.Contains(w.Id)))
                    {
                        <a class="activity-row" href="/project/@ProjectId/workflows/@workflow.Id/runs"><strong>@workflow.Name</strong><span>View runs and logs →</span></a>
                    }
                    @if (!Vm.CanViewWorkflows) { <p>Workflow access is required to view execution history.</p> }
                    else if (!Vm.Workflows.Any(w => agent.WorkflowIds.Contains(w.Id))) { <p>No linked workflows. Add them in the Workflows tab.</p> }
                </section>
            }

            @if (Vm.AgentTab == "Markup")
            {
                <section class="agent-tab-panel markup-panel" aria-label="Agent YAML configuration">
                    <div class="panel-heading"><div><h3>Agent configuration</h3><p>Edit this agent as YAML. Save agent applies the configuration to new turns and runs.</p></div></div>
                    @if (Vm.CanEdit)
                    {
                        <div class="markup-editor"><WorkflowInstructionsEditor @key="Vm.MarkupRevision" @ref="_markup" Value="@Vm.MarkupText" Language="yaml" FileName="agent.yaml" Label="Agent configuration in YAML" /></div>
                    }
                    else { <RunOutput Value="@Vm.MarkupText" Language="yaml" Label="Agent configuration in YAML" /> }
                </section>
            }

            <div class="agent-tab-panel" hidden="@(Vm.AgentTab != "Data")">
                <label for="agent-tables">Tables and charts</label><select id="agent-tables" class="dcinput" @bind="agent.TableAccess" disabled="@(!Vm.CanEdit || Vm.Busy)"><option value="none">No access</option><option value="read">Inspect tables and query data for charts</option></select>
                <fieldset disabled="@(!Vm.CanEdit || Vm.Busy)"><legend>Data source permissions</legend>
                    <p>Choose each capability independently. These apply to connected sources in this project, within the user's permissions.</p>
                    @foreach (var (capability, title, description) in SourceCapabilities)
                    {
                        <label class="check source-permission"><input type="checkbox" checked="@agent.EffectiveSourceCapabilities.Contains(capability)" @onchange="e => Vm.ToggleSourceCapability(capability, e.Value is true)" /><span><strong>@title</strong><small>@description</small></span></label>
                    }
                    @if (agent.EffectiveSourceCapabilities.Contains("pipeline") && agent.WorkflowAccess != "manage")
                    {
                        <p>Creating pipelines also needs “Create, edit, run and schedule” in the Workflows tab.</p>
                    }
                </fieldset>
                <label for="agent-artifacts">Artifacts</label><select id="agent-artifacts" class="dcinput" @bind="agent.ArtifactAccess" disabled="@(!Vm.CanEdit || Vm.Busy)"><option value="none">No access</option><option value="read">List project artifacts</option></select>
                <p>These permissions control the agent's data tools within your access. Workflow execution, run output and MCP tools have their own access settings.</p>
            </div>

            <div class="agent-tab-panel" hidden="@(Vm.AgentTab != "MCPs")">
                <p>Assign the connections this agent can use. MCP tools have their own external access.</p>
                <fieldset disabled="@(!Vm.CanEdit || Vm.Busy)"><legend>MCP connections</legend>
                    @foreach (var connection in Vm.Mcps)
                    {
                        <label class="check"><input type="checkbox" checked="@agent.McpConnectionIds.Contains(connection.Id)" disabled="@(!connection.Enabled && !agent.McpConnectionIds.Contains(connection.Id))" @onchange="e => Vm.ToggleMcp(connection.Id, e.Value is true)" />@connection.Name @(!connection.Enabled ? "(disabled)" : "")</label>
                    }
                    @foreach (var missing in agent.McpConnectionIds.Where(id => !Vm.Mcps.Any(c => c.Id == id)).ToArray()) { <label class="check"><input type="checkbox" checked @onchange="e => Vm.ToggleMcp(missing, false)" />Unavailable connection</label> }
                    @if (Vm.Mcps.Count == 0) { <p>No MCP connections in this project.</p> }
                    <a href="/settings/mcp">Manage MCP connections</a>
                </fieldset>
            </div>
        </div>

        <div class="dcmodal-foot">
            @if (Vm.Error is { } editorError) { <div class="editor-err" role="alert">@editorError</div> }
            @if (Vm.Notice is { } savedNotice) { <span role="status">@savedNotice</span> }
            <button class="dcbtn" disabled="@Vm.Busy" @onclick="() => Vm.CloseEditor(Section)">Close</button>
            @if (Vm.CanEdit)
            {
                <button class="dcbtn primary" disabled="@Vm.Busy" @onclick="SaveAsync">@(Vm.Busy ? "Saving…" : "Save agent")</button>
            }
        </div>
    </section>
    </div>
}

@code {
    private static readonly (string Capability, string Title, string Description)[] SourceCapabilities =
    [
        ("metadata", "View source details", "See source names, approved fields and sync status, without reading record contents."),
        ("search", "Search source content", "Retrieve matching records and send their content to the model to answer questions."),
        ("connect", "Prepare new connections", "Offer the secure connection form. You enter credentials and approve fields yourself."),
        ("pipeline", "Create source pipelines", "Create an import workflow for a connected source. Does not run or schedule it.")
    ];
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public string? Section { get; set; }
    private RenderFragment AgentBranch(IEnumerable<DashboardAgentProfile> agents) => @<ul class="agent-branch">
        @foreach (var profile in agents)
        {
            <li @key="profile.Id">
                @AgentCard(profile)
                @if (Vm.ChildAgents(profile.Id).Any())
                {
                    @AgentBranch(Vm.ChildAgents(profile.Id))
                }
            </li>
        }
    </ul>;
    private RenderFragment AgentCard(DashboardAgentProfile profile) => @<article class="agent-node @(profile.Id == DashboardSettings.DefaultAgentId ? "master-node" : "")" data-agent-id="@profile.Id">
        <button class="agent-node-main" @onclick="() => Vm.OpenAgent(profile.Id)" aria-label="@($"Open {profile.DisplayName}")">
            <span class="node-icon"><AppIcon Kind="agent" /></span>
            <span class="node-copy">
                <span class="node-heading"><strong>@profile.DisplayName</strong>
                    <span class="node-chip">@(profile.Id == DashboardSettings.DefaultAgentId ? "Coordinator" : Vm.Dashboard?.Agents.Any(a => a.Id == profile.Id) == true ? "Private" : "Project")</span>
                    <span class="node-chip">@profile.WorkflowIds.Count workflows</span><span class="node-chip">@profile.McpConnectionIds.Count MCPs</span>
                </span>
                <span class="node-description">@(string.IsNullOrWhiteSpace(profile.Instructions) ? "Configure its system prompt and capabilities." : profile.Instructions)</span>
                @if (profile.EffectiveParentAgentId is { } parentId)
                {
                    <span class="node-parent">Reports to @(Vm.Agents.FirstOrDefault(a => a.Id == parentId)?.DisplayName ?? "Unavailable agent")</span>
                }
            </span>
        </button>
        <footer class="node-actions">
            <a class="icon-action" href="/project/@ProjectId/dashboard?agent=@profile.Id" aria-label="@($"Use {profile.DisplayName}")" title="Use agent"><AppIcon Kind="play" /></a>
            <button class="icon-action" aria-label="@($"{(Vm.CanEditAgent(profile) ? "Edit" : "View")} {profile.DisplayName}")" @onclick="() => Vm.OpenAgent(profile.Id)"><AppIcon Kind="edit" /></button>
            @if (Vm.CanDeleteAgent(profile))
            {
                @if (Vm.ConfirmDeleteId == profile.Id)
                {
                    <button class="dcbtn" @onclick="() => Vm.DeleteAgentAsync(profile.Id, Section)">Delete</button>
                    <button class="dcbtn" @onclick="() => Vm.ConfirmDeleteId = null">Keep</button>
                }
                else
                {
                    <button class="icon-action" aria-label="@($"Delete {profile.DisplayName}")" @onclick="() => Vm.ConfirmDeleteId = profile.Id"><AppIcon Kind="trash" /></button>
                }
            }
        </footer>
    </article>;
    private WorkflowInstructionsEditor? _instructions;
    private WorkflowInstructionsEditor? _markup;
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override Task OnParametersSetAsync() => Vm.LoadPageAsync(ProjectId, Section);
    private async Task<bool> ReadDraftAsync()
    {
        if (Vm.Agent is null) return false;
        if (Vm.AgentTab == "System prompt" && _instructions is not null) Vm.Agent.Instructions = await _instructions.ReadAsync();
        if (Vm.AgentTab == "Markup" && Vm.CanEdit && _markup is not null) return Vm.ApplyMarkup(await _markup.ReadAsync());
        return true;
    }
    private async Task SetTabAsync(string tab)
    {
        if (tab == Vm.AgentTab || !await ReadDraftAsync()) return;
        _instructions = _markup = null;
        Vm.AgentTab = tab;
        if (tab == "Markup") Vm.ReloadMarkup();
        if (tab == "Observability") await Vm.LoadActivityAsync();
    }
    private async Task SaveAsync()
    {
        if (await ReadDraftAsync() && Vm.Agent is { } agent) await Vm.SaveAgentAsync(agent.Instructions, Section);
    }
    private void OnKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") Vm.CloseEditor(Section); }
    public void Dispose() => Vm.Detach();
}
