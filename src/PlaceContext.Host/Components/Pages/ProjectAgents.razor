@page "/project/{ProjectId:guid}/agents"
@page "/project/{ProjectId:guid}/agents/{Section}"
@using PlaceContext.Application.Access.Models
@using PlaceContext.Application.Build
@using PlaceContext.Host.Components.ViewModels
@attribute [Authorize(Policy = Permission.ProjectsView)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@inject ProjectAgentsViewModel Vm
@implements IDisposable

<PageTitle>PlaceContext — @(Vm.Agent is { Id: var agentId } selected ? agentId == DashboardSettings.DefaultAgentId ? "Dashboard agent" : selected.Name : "Agents")</PageTitle>

@if (Vm.Loading)
{
    <Skeleton Kind="list" Rows="5" Padded />
}
else
{
    <div class="chains-page">
        <header class="chains-head">
            <div>
                <h2>Agents</h2>
                <p>Define how agents work across this project.</p>
            </div>
            <div class="head-actions">
                <button class="dcbtn" disabled="@Vm.Busy" @onclick="() => Vm.LoadPageAsync(ProjectId, Section)">Refresh</button>
                @if (Vm.CanManage)
                {
                    <button class="dcbtn primary" @onclick="Vm.CreateAgent"><AppIcon Kind="plus" /> New agent</button>
                }
            </div>
        </header>

        @if (Vm.Error is { } error) { <div class="status-message" role="alert">@error</div> }
        @if (Vm.Notice is { } notice) { <div class="status-message" role="status">@notice</div> }

        @if (!Vm.Agents.Any())
        {
            <div class="dccard empty-state">
                <div class="empty-icon"><AppIcon Kind="agent" /></div>
                <strong>No agents yet</strong>
                <span>Choose instructions, workflow capabilities, data access and MCP connections.</span>
            </div>
        }
        else
        {
            <section class="summary-strip" aria-label="Agent summary">
                <div class="summary-count"><strong>@Vm.Agents.Count()</strong><span>agents</span></div>
                <div class="summary-count"><strong>@Vm.Catalog.Agents.Count</strong><span>shared</span></div>
                <div class="summary-count"><strong>@Vm.Agents.Sum(a => a.WorkflowIds.Count)</strong><span>workflow links</span></div>
                <div class="summary-count"><strong>@Vm.Mcps.Count</strong><span>MCP connections</span></div>
            </section>

            <section class="dccard chain-suite" aria-label="Agent catalogue">
                <header class="suite-head">
                    <div>
                        <span class="suite-caret"><AppIcon Kind="chevron-down" /></span>
                        <strong>Agent catalogue</strong>
                        <span>@Vm.Agents.Count() agent@(Vm.Agents.Count() == 1 ? "" : "s")</span>
                    </div>
                    <span class="suite-result">@Vm.Catalog.Agents.Count shared</span>
                </header>

                <div class="chain-rows">
                    @foreach (var listedAgent in Vm.Agents.OrderBy(a => a.Id != DashboardSettings.DefaultAgentId).ThenBy(a => a.Name))
                    {
                        var isPrivate = Vm.Dashboard?.Agents.Any(a => a.Id == listedAgent.Id) == true;
                        var isMaster = listedAgent.Id == DashboardSettings.DefaultAgentId;
                        <article class="chain-row" @onclick="() => Vm.OpenAgent(listedAgent.Id)">
                            <div class="status-icon"><AppIcon Kind="agent" /></div>
                            <div class="chain-copy">
                                <div class="chain-title">
                                    <strong>@(isMaster ? "Dashboard agent" : listedAgent.Name)</strong>
                                    @if (isMaster) { <span class="chain-chip brand-chip">Master agent</span> }
                                    <span class="chain-chip">@(isPrivate ? "Private to you" : "Shared with project")</span>
                                    <span class="chain-chip">@listedAgent.WorkflowIds.Count workflow link@(listedAgent.WorkflowIds.Count == 1 ? "" : "s")</span>
                                    <span class="chain-chip">@listedAgent.McpConnectionIds.Count MCP@(listedAgent.McpConnectionIds.Count == 1 ? "" : "s")</span>
                                </div>
                                <div class="chain-detail">
                                    <span>@(string.IsNullOrWhiteSpace(listedAgent.Instructions) ? "Project assistant" : listedAgent.Instructions)</span>
                                </div>
                                <div class="step-chips">
                                    <span class="step-chip">Workflows · @listedAgent.WorkflowAccess</span>
                                    <span class="step-chip">Tables · @listedAgent.EffectiveTableAccess</span>
                                    <span class="step-chip">Sources · @listedAgent.EffectiveSourceAccess</span>
                                    <span class="step-chip">Artifacts · @listedAgent.EffectiveArtifactAccess</span>
                                </div>
                            </div>
                            <div class="chain-actions">
                                @if (Vm.ConfirmDeleteId == listedAgent.Id)
                                {
                                    <button class="dcbtn" @onclick:stopPropagation="true" @onclick="() => Vm.DeleteAgentAsync(listedAgent.Id, Section)">Delete</button>
                                    <button class="dcbtn" @onclick:stopPropagation="true" @onclick="() => Vm.ConfirmDeleteId = null">Keep</button>
                                }
                                else
                                {
                                    <a class="icon-action use-action" href="/project/@ProjectId/dashboard?agent=@listedAgent.Id" title="Use agent" aria-label="Use @listedAgent.Name" @onclick:stopPropagation="true"><AppIcon Kind="play" /></a>
                                    <button class="icon-action" title="@(Vm.CanEditAgent(listedAgent) ? "Edit agent" : "View agent")" aria-label="@(Vm.CanEditAgent(listedAgent) ? "Edit agent" : "View agent")" @onclick:stopPropagation="true" @onclick="() => Vm.OpenAgent(listedAgent.Id)"><AppIcon Kind="edit" /></button>
                                    @if (Vm.CanDeleteAgent(listedAgent))
                                    {
                                        <button class="icon-action" title="Delete agent" aria-label="Delete @listedAgent.Name" @onclick:stopPropagation="true" @onclick="() => Vm.ConfirmDeleteId = listedAgent.Id"><AppIcon Kind="trash" /></button>
                                    }
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
}

@if (Vm.EditorOpen && Vm.Agent is { } agent)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseEditor(Section)"></div>
    <div class="dcslide slide-640" tabindex="-1" @onkeydown="OnKeyDown">
        <div class="dcslide-head">
            <div class="flex-min">
                <div class="title-14">@(agent.Id == DashboardSettings.DefaultAgentId ? "Dashboard agent" : Vm.Existing ? agent.Name : "New agent")</div>
                <div class="sub-115">@(Vm.EditingPrivateAgent ? "Private dashboard agent. Changes apply to your dashboard conversations." : "Shared project agent. Changes apply to new runs and conversation turns.")</div>
            </div>
            <button aria-label="Close" class="dcslide-x" @onclick="() => Vm.CloseEditor(Section)"><AppIcon Kind="close" /></button>
        </div>

        <div class="dctabs editor-tabs" aria-label="Agent settings sections">
            @foreach (var tab in new[] { "Overview", "System prompt", "Workflows", "Data", "MCPs" })
            {
                <button type="button" class="dctab @(Vm.AgentTab == tab ? "active" : "")" aria-pressed="@(Vm.AgentTab == tab)" disabled="@Vm.Busy" @onclick="() => Vm.AgentTab = tab">@tab</button>
            }
        </div>

        <div class="dcslide-body editor-body">
            @if (agent.Id == DashboardSettings.DefaultAgentId)
            {
                <p>The dashboard master agent coordinates workflows and the project agents assigned to their steps. Its instructions are private to you; its permissions still apply.</p>
            }

            <div class="agent-tab-panel" hidden="@(Vm.AgentTab != "Overview")">
                <label for="project-agent-name">Agent name</label><input id="project-agent-name" class="dcinput" maxlength="60" @bind="agent.Name" disabled="@(!Vm.CanEdit || Vm.Busy)" />
                <label for="project-agent-connection">Model connection</label>
                <select id="project-agent-connection" class="dcinput" value="@agent.ConnectionId" @onchange="e => Vm.SelectConnection(e.Value?.ToString())" disabled="@(!Vm.CanEdit || Vm.Busy)"><option value="@Guid.Empty">Runner's default model</option>@foreach (var connection in Vm.Connections) { <option value="@connection.Id">@connection.Name</option> }</select>
                @if (agent.ConnectionId != Guid.Empty)
                {
                    <label for="project-agent-model">Model</label><select id="project-agent-model" class="dcinput" @bind="agent.Model" disabled="@(!Vm.CanEdit || Vm.Busy)"><option value="">Select model</option>@foreach (var model in Vm.Models) { <option>@model</option> }</select>
                }
            </div>

            <div class="agent-tab-panel" hidden="@(Vm.AgentTab != "System prompt")">
                <label>System prompt</label>
                <p>Define this agent's role, behavior and response style for chats and workflow steps. Changes apply on the next turn or run. Up to 8,000 characters.</p>
                @if (Vm.CanEdit) { <div class="instructions-editor"><WorkflowInstructionsEditor @key="agent.Id" @ref="_instructions" Value="@agent.Instructions" Label="Agent system prompt" /></div> }
                else { <RunOutput Value="@agent.Instructions" Language="markdown" Label="Agent system prompt" /> }
            </div>

            <div class="agent-tab-panel" hidden="@(Vm.AgentTab != "Workflows")">
                <label for="agent-workflows">Workflow capabilities</label><select id="agent-workflows" class="dcinput" @bind="agent.WorkflowAccess" disabled="@(!Vm.CanEdit || Vm.Busy)"><option value="none">No access</option><option value="read">Inspect workflows, jobs and run output</option><option value="run">Inspect and run workflows and jobs</option><option value="manage">Create, edit, run and schedule</option></select>
                <p>Limit the agent's workflow tools within your permissions. Workflow agent steps also apply their own tool limits.</p>
                <fieldset disabled="@(!Vm.CanEdit || Vm.Busy || !Vm.CanViewWorkflows)"><legend>Linked workflows</legend>
                    <p>Give this agent workflows to use as context. Links do not restrict access to other project workflows; the capabilities above still apply.</p>
                    @if (!Vm.CanViewWorkflows) { <p>Workflow access is required to view and change links.</p> }
                    else
                    {
                        @foreach (var workflow in Vm.Workflows.OrderBy(w => w.Name))
                        {
                            <label class="check"><input type="checkbox" checked="@agent.WorkflowIds.Contains(workflow.Id)" @onchange="e => Vm.ToggleWorkflow(workflow.Id, e.Value is true)" />@workflow.Name</label>
                        }
                        @foreach (var missing in agent.WorkflowIds.Where(id => !Vm.Workflows.Any(w => w.Id == id)).ToArray())
                        {
                            <label class="check"><input type="checkbox" checked @onchange="e => Vm.ToggleWorkflow(missing, false)" />Unavailable workflow — remove link</label>
                        }
                        @if (Vm.Workflows.Count == 0) { <p>No workflows in this project yet.</p> }
                    }
                </fieldset>
            </div>

            <div class="agent-tab-panel" hidden="@(Vm.AgentTab != "Data")">
                <label for="agent-tables">Tables and charts</label><select id="agent-tables" class="dcinput" @bind="agent.TableAccess" disabled="@(!Vm.CanEdit || Vm.Busy)"><option value="none">No access</option><option value="read">Inspect tables and query data for charts</option></select>
                <label for="agent-sources">Data sources</label><select id="agent-sources" class="dcinput" @bind="agent.SourceAccess" disabled="@(!Vm.CanEdit || Vm.Busy)"><option value="none">No access</option><option value="read">Read source metadata and search content</option><option value="manage">Read, search and configure sources</option></select>
                <label for="agent-artifacts">Artifacts</label><select id="agent-artifacts" class="dcinput" @bind="agent.ArtifactAccess" disabled="@(!Vm.CanEdit || Vm.Busy)"><option value="none">No access</option><option value="read">List project artifacts</option></select>
                <p>These permissions control the agent's data tools within your access. Workflow execution, run output and MCP tools have their own access settings.</p>
            </div>

            <div class="agent-tab-panel" hidden="@(Vm.AgentTab != "MCPs")">
                <p>Assign the connections this agent can use. MCP tools have their own external access.</p>
                <fieldset disabled="@(!Vm.CanEdit || Vm.Busy)"><legend>MCP connections</legend>
                    @foreach (var connection in Vm.Mcps)
                    {
                        <label class="check"><input type="checkbox" checked="@agent.McpConnectionIds.Contains(connection.Id)" disabled="@(!connection.Enabled && !agent.McpConnectionIds.Contains(connection.Id))" @onchange="e => Vm.ToggleMcp(connection.Id, e.Value is true)" />@connection.Name @(!connection.Enabled ? "(disabled)" : "")</label>
                    }
                    @foreach (var missing in agent.McpConnectionIds.Where(id => !Vm.Mcps.Any(c => c.Id == id)).ToArray()) { <label class="check"><input type="checkbox" checked @onchange="e => Vm.ToggleMcp(missing, false)" />Unavailable connection</label> }
                    @if (Vm.Mcps.Count == 0) { <p>No MCP connections in this project.</p> }
                    <a href="/settings/mcp">Manage MCP connections</a>
                </fieldset>
            </div>
        </div>

        <div class="dcslide-foot">
            @if (Vm.Error is { } editorError) { <div class="editor-err" role="alert">@editorError</div> }
            <button class="dcbtn" @onclick="() => Vm.CloseEditor(Section)">Cancel</button>
            @if (Vm.CanEdit)
            {
                <button class="dcbtn primary" disabled="@Vm.Busy" @onclick="SaveAsync">@(Vm.Busy ? "Saving…" : "Save agent")</button>
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public string? Section { get; set; }
    private WorkflowInstructionsEditor? _instructions;
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override Task OnParametersSetAsync() => Vm.LoadPageAsync(ProjectId, Section);
    private async Task SaveAsync()
    {
        await Vm.SaveAgentAsync(_instructions is null ? "" : await _instructions.ReadAsync(), Section);
    }
    private void OnKeyDown(KeyboardEventArgs e) { if (e.Key == "Escape") Vm.CloseEditor(Section); }
    public void Dispose() => Vm.Detach();
}
