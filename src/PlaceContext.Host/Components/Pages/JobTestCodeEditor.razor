@page "/project/{ProjectId:guid}/tests/{TestId:guid}"
@attribute [Authorize(Policy = Permission.JobsEdit)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IAsyncDisposable
@inject JobTestCodeEditorViewModel Vm

<PageTitle>PlaceContext — @(Vm.Test?.Name ?? "Test code")</PageTitle>

@if (Vm.Loading)
{
    <Skeleton Kind="detail" Rows="8" Padded />
}
else if (Vm.Test is null)
{
    <div class="notice">Test not found. <a href="@($"/project/{ProjectId}/tests")">Back to Tests</a></div>
}
else
{
    <div class="page">
        <header class="toolbar">
            <button class="dcbtn back-button" @onclick="Vm.NavigateBack">←</button>
            <div class="title-block">
                <strong>@Vm.Test.Name</strong>
                <span>@Vm.Test.JobName</span>
            </div>
            <select class="runtime-select" value="@Vm.RuntimeId" @onchange="Vm.RuntimeChanged">
                <option value="python">Python · pytest</option>
                <option value="node">Node.js · node:test</option>
                <option value="go">Go · testing</option>
                <option value="ruby">Ruby · Minitest</option>
            </select>
            @if (Vm.MonacoLite)
            {
                <span class="editor-warning">basic editor</span>
            }
            <span class="spacer"></span>
            @if (Vm.Message is not null)
            {
                <span class="toolbar-message">@Vm.Message</span>
            }
            <span class="mocked-badge" title="No network, Vault secrets, external services, or production Job side effects">
                Isolated
            </span>
            <button class="dcbtn" disabled="@Vm.Busy" @onclick="Vm.ResetStarterAsync">Starter</button>
            <button class="dcbtn" disabled="@Vm.Busy" @onclick="Vm.RunAsync">
                @(Vm.Running ? "Running…" : "▶ Run block")
            </button>
            <button class="dcbtn primary" disabled="@Vm.Busy" @onclick="Vm.SaveAsync">
                @(Vm.Saving ? "Saving…" : "Save code")
            </button>
        </header>

        <div class="contract-bar">
            <strong>@JobTestCodeEditorViewModel.RuntimeLabel(Vm.RuntimeId)</strong>
            <code>{ "input": …, "run": { "status": "Succeeded", "output": …, "shards": […] } }</code>
            <span>Every framework method runs against the declared mock scenario. Inline Job source is available under <code>job/</code> for imports and mocks; the selected Job is never executed.</span>
        </div>

        <main class="workspace">
            <aside class="file-tree">
                <div class="method-tree-head">
                    <span>Test methods</span>
                    <b>@Vm.Methods.Count</b>
                </div>
                <div class="method-list">
                    @if (Vm.Methods.Count == 0)
                    {
                        <span class="method-empty">Add a framework test method, then save or run the block.</span>
                    }
                    else
                    {
                        @foreach (var method in Vm.Methods)
                        {
                            <div class="method-row @method.Status.ToLowerInvariant()" title="@method.Message">
                                <span class="method-status">@JobTestCodeEditorViewModel.MethodIcon(method.Status)</span>
                                <span>@method.Name</span>
                                @if (method.DurationMs is { } methodDuration)
                                {
                                    <small>@JobTestCodeEditorViewModel.FormatDuration(methodDuration)</small>
                                }
                            </div>
                        }
                    }
                </div>

                <div class="file-tree-head">
                    <span>Test files</span>
                    <button class="add-file-button" @onclick="Vm.StartAddFile" title="Add file">+</button>
                </div>

                @if (Vm.AddingFile)
                {
                    <div class="add-file-row">
                        <input class="dcinput" placeholder="path/name.py"
                               @bind="Vm.NewFileName" @bind:event="oninput"
                               @onkeydown="Vm.AddFileKey" @ref="Vm.NewFileInput" />
                        <button @onclick="Vm.ConfirmAddFile">✓</button>
                    </div>
                }

                <div class="file-list">
                    @for (var index = 0; index < Vm.Files.Count; index++)
                    {
                        var fileIndex = index;
                        var file = Vm.Files[fileIndex];
                        <div class="file-row @(fileIndex == Vm.ActiveIndex ? "active" : null)"
                             @onclick="@(() => Vm.SwitchFileAsync(fileIndex))">
                            <span title="@file.Path">@file.Path</span>
                            @if (file.Path == Vm.Entrypoint)
                            {
                                <b title="Entrypoint">★</b>
                            }
                            else
                            {
                                <button title="Set as entrypoint" @onclick:stopPropagation="true"
                                        @onclick="@(() => Vm.SetEntry(file.Path))">☆</button>
                            }
                            @if (Vm.Files.Count > 1)
                            {
                                <button class="delete-file" title="Delete file"
                                        @onclick:stopPropagation="true"
                                        @onclick="@(() => Vm.DeleteFileAsync(fileIndex))">×</button>
                            }
                        </div>
                    }
                </div>

                <div class="file-foot">
                    <span>Entrypoint</span>
                    <code>@(Vm.Entrypoint ?? Vm.DefaultEntrypoint)</code>
                    <small>Dependency manifests are supported and use the same warm-cache path as Jobs.</small>
                </div>
            </aside>

            <section class="editor-pane">
                <div id="@Vm.EditorId" class="editor-host"></div>

                <div class="result-panel @(Vm.PanelOpen ? "open" : null)">
                    <button class="result-bar" @onclick="Vm.TogglePanel">
                    <span>Block result</span>
                        @if (Vm.LastResult is not null)
                        {
                            <b class="@Vm.LastResult.LastStatus.ToLowerInvariant()">@Vm.LastResult.LastStatus</b>
                            @if (Vm.LastResult.LastDurationMs is { } duration)
                            {
                                <small>@JobTestCodeEditorViewModel.FormatDuration(duration)</small>
                            }
                        }
                        <i></i>
                        <span>@(Vm.PanelOpen ? "▾" : "▴")</span>
                    </button>
                    @if (Vm.PanelOpen)
                    {
                        <div class="result-body">
                            @if (Vm.LastResult is null)
                            {
                                <span>Run the block to execute every discovered framework test method against the declared mock scenario.</span>
                            }
                            else
                            {
                                <strong class="@Vm.LastResult.LastStatus.ToLowerInvariant()">@Vm.LastResult.LastMessage</strong>
                                @if (!string.IsNullOrWhiteSpace(Vm.LastResult.LastActualOutput))
                                {
                                    <details>
                                        <summary>Job output</summary>
                                        <pre>@JobTestCodeEditorViewModel.PrettyJson(Vm.LastResult.LastActualOutput)</pre>
                                    </details>
                                }
                            }
                        </div>
                    }
                </div>
            </section>
        </main>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid TestId { get; set; }

    protected override void OnInitialized() =>
        Vm.Attach(() => InvokeAsync(StateHasChanged));

    protected override Task OnParametersSetAsync()
    {
        Vm.Initialize(ProjectId, TestId);
        return Task.CompletedTask;
    }

    protected override Task OnAfterRenderAsync(bool firstRender) => Vm.AfterRenderAsync();

    public async ValueTask DisposeAsync()
    {
        Vm.Detach();
        await Vm.DisposeAsync();
    }
}
