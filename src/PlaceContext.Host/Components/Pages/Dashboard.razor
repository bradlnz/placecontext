@page "/"
@attribute [Authorize(Policy = Permission.ProjectsView)]
@implements IDisposable
@inject DashboardViewModel Vm





@using PlaceContext.Host.Components.ViewModels.Helpers

<PageTitle>placecontext — Dashboard</PageTitle>

<div class="page">

    <div class="page-head">
        <div>
            <h1 class="page-title">Dashboard</h1>
            <p class="page-sub">
                Jobs across
                <span class="page-sub-project">@Vm.WorkspaceProjectName</span>
                · every run yields an artifact
            </p>
        </div>
    </div>

    @* ── Stat cards ─────────────────────────────────────────────────────────────────────── *@
    <div class="stat-grid">
        <div class="dccard stat-card">
            <div class="stat-label">RUNNING</div>
            <div class="stat-figure">
                <span class="stat-num tone-good">@Vm.Running</span>
                <span class="stat-unit">jobs</span>
            </div>
        </div>
        <div class="dccard stat-card">
            <div class="stat-label">QUEUED</div>
            <div class="stat-figure">
                <span class="stat-num tone-warn">@Vm.Queued</span>
                <span class="stat-unit">waiting to start</span>
            </div>
        </div>
        <div class="dccard stat-card">
            <div class="stat-label">FAILED · 24H</div>
            <div class="stat-figure">
                <span class="stat-num tone-bad">@Vm.Failed24</span>
                <span class="stat-unit">needs attention</span>
            </div>
        </div>
        <div class="dccard stat-card">
            <div class="stat-label">SUCCEEDED · 24H</div>
            <div class="stat-figure">
                <span class="stat-num tone-text">@Vm.Succeeded24</span>
                <span class="stat-unit">artifacts generated</span>
            </div>
        </div>
    </div>

    @* ── Chain quick actions: contextual execution without a dashboard submission CTA ─────── *@
    <section class="dccard dashboard-quick-chains" aria-labelledby="quick-chain-title">
        <div class="quick-chain-head">
            <div>
                <div class="quick-chain-kicker">QUICK ACTION</div>
                <h2 id="quick-chain-title" class="quick-chain-title">Run a job chain</h2>
                <p class="quick-chain-sub">Start a repeatable workflow from the current project.</p>
            </div>
            @if (Vm.CurrentProjectId is { } chainProjectId)
            {
                <a class="dcbtn btn-sm" href="@($"/project/{chainProjectId}/chains")">View chains</a>
            }
        </div>

        @if (Vm.CurrentProjectId is null)
        {
            <div class="quick-chain-empty">Select a project to run its job chains.</div>
        }
        else if (Vm.Chains.Count == 0)
        {
            <div class="quick-chain-empty">No job chains are configured for this project.</div>
        }
        else
        {
            <div class="quick-chain-list">
                @foreach (var chain in Vm.Chains.Take(4))
                {
                    <div class="quick-chain-row" @key="chain.Id">
                        <div class="quick-chain-copy">
                            <div class="quick-chain-name">@chain.Name</div>
                            <div class="quick-chain-meta">
                                @chain.Stages.Count stage@(chain.Stages.Count == 1 ? "" : "s") ·
                                @chain.Steps.Count job@(chain.Steps.Count == 1 ? "" : "s")
                            </div>
                        </div>
                        <button class="dcbtn primary btn-sm quick-chain-run"
                                disabled="@(Vm.RunningChainId is not null)"
                                aria-label="Run @chain.Name"
                                @onclick="@(() => Vm.PrepareQuickChainRunAsync(chain))">
                            @(Vm.RunningChainId == chain.Id ? "Starting…" : "Run")
                        </button>
                    </div>
                }
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Vm.ChainMessage))
        {
            <div class="quick-chain-message @(Vm.ChainError ? "error" : "")" role="status" aria-live="polite">
                @Vm.ChainMessage
            </div>
        }
    </section>

    @* ── Pinned entities: one-click access to the business views of tagged data ────────── *@
    @if (Vm.Entities.Count > 0)
    {
        <div class="entity-grid">
            @foreach (var e in Vm.Entities)
            {
                <a href="@($"/project/{e.ProjectId}/entity/{Uri.EscapeDataString(e.Name)}")"
                   class="dccard dcdash-row entity-card"
                   @key="e.Id">
                    <div class="entity-head">
                        <span class="entity-name">@e.Name</span>
                        <span class="entity-count">@Vm.EntityCount(e)</span>
                    </div>
                    @if (Vm.EntityCharts.TryGetValue(e.Id, out var chart) && chart.Bars.Count > 0)
                    {
                        <div class="entity-chart-label">by @chart.Column</div>
                        <div class="entity-bars">
                            @foreach (var (label, count, frac) in chart.Bars)
                            {
                                <div class="entity-bar-row" @key="label">
                                    <span class="entity-bar-label" title="@label">@label</span>
                                    <span class="entity-bar-track">
                                        <span class="entity-bar-fill" style="width:@(frac)%"></span>
                                    </span>
                                    <span class="entity-bar-count">@count</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="entity-table">@e.TableName</div>
                    }
                </a>
            }
        </div>
    }

    @* ── Charts (read-only copies from the current project's Analytics) ───────────── *@
    @if (Vm.SqlCharts() is { Count: > 0 } sqlCharts)
    {
        <div class="charts-head">
            <span class="section-title">Charts</span>
            @if (Vm.CurrentProjectId is { } chartsPid)
            {
                <a href="@($"/project/{chartsPid}/analytics")" class="charts-edit-link">edit in Analytics →</a>
            }
        </div>
        <div class="charts-grid">
            @foreach (var chart in sqlCharts)
            {
                <div class="dccard chart-card" @key="chart.TableName">
                    <div class="chart-card-head">
                        <span class="chart-title">@chart.TableName["sql:".Length..]</span>
                        <span class="spacer"></span>
                        <span class="chart-time">@Vm.ChartDate(chart.GeneratedAt)</span>
                    </div>
                    <div class="chart-canvas-wrap">
                        <canvas id="@DashboardViewModel.CanvasId(chart.TableName)"></canvas>
                    </div>
                </div>
            }
        </div>
    }

    @* ── Recent jobs table ──────────────────────────────────────────────────────────────── *@
    <div class="dccard jobs-card">
        <div class="jobs-head">
            <span class="jobs-title">Recent jobs</span>
            <div class="jobs-filters">
                @foreach (var f in Vm.FilterOptions)
                {
                    <span @onclick="@(() => Vm.SetFilter(f))"
                          class="jobs-filter"
                          style="background:@(Vm.IsFilter(f) ? "var(--card-2)" : "transparent");
                                 border:1px solid @(Vm.IsFilter(f) ? "var(--border-2)" : "transparent");
                                 color:@(Vm.IsFilter(f) ? "var(--text)" : "var(--text-3)")">@f</span>
                }
            </div>
        </div>
        <div class="jobs-scroll">
            <div class="jobs-grid-head">
                <span>STATUS</span><span>JOB</span><span>PROJECT</span><span>SHARDS</span><span>DURATION</span><span>STARTED</span><span>RETURN</span>
            </div>
            @if (!Vm.Ready)
            {
                <div class="jobs-loading"><Skeleton Kind="text" Rows="6" /></div>
            }
            else if (Vm.Filtered() is { Count: 0 })
            {
                <div class="jobs-empty">
                    No runs yet — submit a job and its run appears here live.
                </div>
            }
            else
            {
                @foreach (var rep in Vm.Filtered())
                {
                    var run = rep.Run;
                    <div @onclick="@(() => Vm.OpenRun(run.Id))"
                         class="dcdash-row jobs-row"
                         @key="run.Id">
                        <span class="job-status" style="color:@Vm.StatusTextColor(run.Status)">
                            <span class="job-status-dot" style="background:@Vm.StatusTextColor(run.Status); animation:@(Vm.IsRunningStatus(run.Status) ? "dcpulse 1.6s ease-in-out infinite" : "none")"></span>@Vm.StatusLabel(run.Status)
                        </span>
                        <span class="job-name">@rep.JobName</span>
                        <span class="job-project">@rep.ProjectName</span>
                        <span class="job-cell">
                            @Vm.ShardSummary(run)
                        </span>
                        <span class="job-cell">@DashboardViewModel.Duration(run)</span>
                        <span class="job-started">@Vm.StartedLabel(run.StartedAt)</span>
                        <span class="job-return">@(run.Snapshot.MapSourceKind)</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

@if (Vm.RunPromptChain is not null)
{
    <div class="dcmodal-overlay" @onclick="Vm.CancelQuickChainPrompt">
        <div class="dcmodal quick-chain-modal" role="dialog" aria-modal="true"
             aria-labelledby="quick-chain-prompt-title" @onclick:stopPropagation="true">
            <div class="dcmodal-head">
                <div class="quick-chain-modal-title">
                    <div id="quick-chain-prompt-title" class="title-14">Run @Vm.RunPromptChain.Name</div>
                    <div class="quick-chain-modal-sub">
                        Enter the declared inputs for each chain step. Stored job values are prefilled.
                    </div>
                </div>
                <button class="dcslide-x" aria-label="Close run input prompt"
                        disabled="@(Vm.RunningChainId is not null)" @onclick="Vm.CancelQuickChainPrompt">×</button>
            </div>
            <div class="dcmodal-body quick-chain-modal-body">
                @foreach (var step in Vm.RunPromptSteps)
                {
                    <section class="quick-chain-prompt-step">
                        <div class="quick-chain-prompt-head">
                            <span class="quick-chain-step-badge">step @(step.Index + 1)</span>
                            <strong>@step.Job.Name</strong>
                        </div>
                        @foreach (var parameter in step.Job.Parameters)
                        {
                            var key = ParameterPromptState.ChainArgKey(step.Index, parameter.Name);
                            <div class="dcfield">
                                <label>
                                    @(parameter.Label ?? parameter.Name)
                                    @if (parameter.Required)
                                    {
                                        <span class="req">*</span>
                                    }
                                    <span class="code ml-5">@parameter.Name</span>
                                </label>
                                <ParamInput Parameter="parameter" ProjectId="@Vm.RunPromptChain.ProjectId"
                                            Value="@Vm.RunPrompt.Get(key)"
                                            ValueChanged="@(value => Vm.RunPrompt.Set(key, value))" />
                            </div>
                        }
                    </section>
                }
                @if (Vm.RunPrompt.Error is not null)
                {
                    <div class="quick-chain-prompt-error" role="alert">@Vm.RunPrompt.Error</div>
                }
            </div>
            <div class="dcmodal-foot">
                <button class="dcbtn" disabled="@(Vm.RunningChainId is not null)"
                        @onclick="Vm.CancelQuickChainPrompt">Cancel</button>
                <button class="dcbtn primary" disabled="@(Vm.RunningChainId is not null)"
                        @onclick="Vm.SubmitQuickChainPromptAsync">
                    @(Vm.RunningChainId is not null ? "Starting…" : "▶ Run chain")
                </button>
            </div>
        </div>
    </div>
}

<style>.dcdash-row:hover { background:var(--hover); }</style>

@code {
    protected override async Task OnInitializedAsync()
    {
        Vm.Attach(() => InvokeAsync(StateHasChanged));
        Vm.ResetChartCache();
        Vm.Initialize();
        await Vm.LoadAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender) => Vm.RenderChartsAsync();

    public void Dispose() => Vm.Dispose();
}
