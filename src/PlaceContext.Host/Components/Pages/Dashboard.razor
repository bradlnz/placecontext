@page "/"
@implements IDisposable
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject PlaceContext.Application.Ports.ICurrentTenant Tenant
@inject PlaceContext.Infrastructure.Operations.OperationCenter OpCenter

<PageTitle>placecontext — Dashboard</PageTitle>

<div style="padding:28px 28px 40px; max-width:1320px; margin:0 auto">

    <div style="display:flex; align-items:flex-end; justify-content:space-between; margin-bottom:22px">
        <div>
            <h1 style="margin:0; font-size:20px; font-weight:600; letter-spacing:-.01em">Dashboard</h1>
            <p style="margin:4px 0 0; color:var(--text-2); font-size:13px">
                Jobs across
                <span style="font-family:'IBM Plex Mono',monospace; color:var(--text)">@(Ui.CurrentProjectName ?? "the workspace")</span>
                · every run yields an artifact
            </p>
        </div>
        <button class="dcbtn primary" style="display:flex; align-items:center; gap:8px; padding:8px 14px; font-size:13px"
                @onclick="NewJob">
            <span style="font-size:15px; line-height:1">＋</span> Submit job
        </button>
    </div>

    @* ── Stat cards ─────────────────────────────────────────────────────────────────────── *@
    <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:24px">
        <div class="dccard" style="padding:14px 16px; border-radius:8px">
            <div style="font-size:11px; color:var(--text-3); letter-spacing:.08em; font-weight:500">RUNNING</div>
            <div style="display:flex; align-items:baseline; gap:8px; margin-top:6px">
                <span style="font-family:'IBM Plex Mono',monospace; font-size:26px; font-weight:600; color:var(--good)">@_running</span>
                <span style="font-size:12px; color:var(--text-3)">jobs</span>
            </div>
        </div>
        <div class="dccard" style="padding:14px 16px; border-radius:8px">
            <div style="font-size:11px; color:var(--text-3); letter-spacing:.08em; font-weight:500">QUEUED</div>
            <div style="display:flex; align-items:baseline; gap:8px; margin-top:6px">
                <span style="font-family:'IBM Plex Mono',monospace; font-size:26px; font-weight:600; color:var(--warn)">@_queued</span>
                <span style="font-size:12px; color:var(--text-3)">waiting to start</span>
            </div>
        </div>
        <div class="dccard" style="padding:14px 16px; border-radius:8px">
            <div style="font-size:11px; color:var(--text-3); letter-spacing:.08em; font-weight:500">FAILED · 24H</div>
            <div style="display:flex; align-items:baseline; gap:8px; margin-top:6px">
                <span style="font-family:'IBM Plex Mono',monospace; font-size:26px; font-weight:600; color:var(--bad)">@_failed24</span>
                <span style="font-size:12px; color:var(--text-3)">needs attention</span>
            </div>
        </div>
        <div class="dccard" style="padding:14px 16px; border-radius:8px">
            <div style="font-size:11px; color:var(--text-3); letter-spacing:.08em; font-weight:500">SUCCEEDED · 24H</div>
            <div style="display:flex; align-items:baseline; gap:8px; margin-top:6px">
                <span style="font-family:'IBM Plex Mono',monospace; font-size:26px; font-weight:600; color:var(--text)">@_succeeded24</span>
                <span style="font-size:12px; color:var(--text-3)">artifacts generated</span>
            </div>
        </div>
    </div>

    @* ── Charts (read-only copies from the current project's Analytics) ───────────── *@
    @if (SqlCharts() is { Count: > 0 } sqlCharts)
    {
        <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:8px">
            <span style="font-size:13px; font-weight:600">Charts</span>
            @if (Ui.CurrentProjectId is { } chartsPid)
            {
                <a href="@($"/project/{chartsPid}/analytics")" style="font-size:11.5px; color:var(--human)">edit in Analytics →</a>
            }
        </div>
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(380px, 1fr)); gap:12px; margin-bottom:24px">
            @foreach (var chart in sqlCharts)
            {
                <div class="dccard" style="padding:12px 16px; border-radius:8px">
                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px">
                        <span style="font-size:12px; font-weight:600; font-family:'IBM Plex Mono',monospace">@chart.TableName["sql:".Length..]</span>
                        <span style="flex:1"></span>
                        <span style="font-size:10px; color:var(--text-3)">@chart.GeneratedAt.ToWorkspaceTime().ToString("MM-dd HH:mm")</span>
                    </div>
                    <div style="height:230px; padding:8px 6px 4px">
                        <canvas id="@CanvasId(chart.TableName)"></canvas>
                    </div>
                </div>
            }
        </div>
    }

    @* ── Recent jobs table ──────────────────────────────────────────────────────────────── *@
    <div class="dccard" style="border-radius:8px; overflow:hidden">
        <div style="display:flex; align-items:center; justify-content:space-between; padding:12px 16px; border-bottom:1px solid var(--border)">
            <span style="font-weight:600; font-size:13.5px">Recent jobs</span>
            <div style="display:flex; gap:6px">
                @foreach (var f in new[] { "all", "running", "failed" })
                {
                    <span @onclick="@(() => _filter = f)"
                          style="font-family:'IBM Plex Mono',monospace; font-size:11px; padding:3px 9px; border-radius:99px; cursor:pointer;
                                 background:@(_filter == f ? "var(--card-2)" : "transparent");
                                 border:1px solid @(_filter == f ? "var(--border-2)" : "transparent");
                                 color:@(_filter == f ? "var(--text)" : "var(--text-3)")">@f</span>
                }
            </div>
        </div>
        <div style="overflow-x:auto">
            <div style="display:grid; grid-template-columns:110px minmax(180px,1.4fr) minmax(140px,1fr) 90px 90px 130px 100px; gap:0 16px; padding:8px 16px; border-bottom:1px solid var(--border); font-size:10.5px; color:var(--text-3); letter-spacing:.08em; font-weight:500; min-width:880px">
                <span>STATUS</span><span>JOB</span><span>PROJECT</span><span>SHARDS</span><span>DURATION</span><span>STARTED</span><span>RETURN</span>
            </div>
            @if (Filtered() is { Count: 0 })
            {
                <div style="padding:24px 16px; color:var(--text-3); font-size:13px; text-align:center; min-width:880px">
                    No runs yet — submit a job and its run appears here live.
                </div>
            }
            else
            {
                @foreach (var rep in Filtered())
                {
                    var run = rep.Run;
                    <div @onclick="@(() => Nav.NavigateTo($"/observability?run={run.Id}"))"
                         class="dcdash-row"
                         style="display:grid; grid-template-columns:110px minmax(180px,1.4fr) minmax(140px,1fr) 90px 90px 130px 100px; gap:0 16px; align-items:center; padding:11px 16px; border-bottom:1px solid var(--border); cursor:pointer; min-width:880px">
                        <span style="display:flex; align-items:center; gap:8px; font-family:'IBM Plex Mono',monospace; font-size:11px; color:@StatusColor(run.Status)">
                            <span style="width:7px; height:7px; flex:none; border-radius:50%; background:@StatusColor(run.Status); animation:@(run.Status == "Running" ? "dcpulse 1.6s ease-in-out infinite" : "none")"></span>@run.Status.ToUpperInvariant()
                        </span>
                        <span style="font-family:'IBM Plex Mono',monospace; font-size:12.5px; color:var(--text); overflow:hidden; text-overflow:ellipsis; white-space:nowrap">@rep.JobName</span>
                        <span style="font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--human); overflow:hidden; text-overflow:ellipsis; white-space:nowrap">@rep.ProjectName</span>
                        <span style="font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--text-2)">
                            ✓@run.ShardResults.Count(s => s.Outcome == "Succeeded")@(run.ShardResults.Any(s => s.Outcome == "Failed") ? $" ✗{run.ShardResults.Count(s => s.Outcome == "Failed")}" : "")
                        </span>
                        <span style="font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--text-2)">@Duration(run)</span>
                        <span style="font-size:12px; color:var(--text-2)">@run.StartedAt.ToWorkspaceTime().ToString("HH:mm · MMM d")</span>
                        <span style="font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--text-3)">@(run.Snapshot.MapSourceKind)</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>.dcdash-row:hover { background:var(--hover); }</style>

@code {
    private IReadOnlyList<RunReportView> _reports = Array.Empty<RunReportView>();
    private int _running, _queued, _failed24, _succeeded24;
    private string _filter = "all";
    private bool _refreshing;

    private IReadOnlyList<ProjectChartView> _charts = Array.Empty<ProjectChartView>();
    private readonly Dictionary<string, DateTimeOffset> _rendered = new();

    protected override async Task OnInitializedAsync()
    {
        OpCenter.Changed += OnOpsChanged;
        Ui.Set("Dashboard", "jobs · runs · artifacts");
        await RefreshAsync();
    }

    private IReadOnlyList<ProjectChartView> SqlCharts()
        => _charts.Where(c => c.TableName.StartsWith("sql:", StringComparison.Ordinal)
                              && c.Html.TrimStart().StartsWith('{')).ToList();

    private static string CanvasId(string slot)
        => "pcdash-" + Convert.ToHexString(System.Security.Cryptography.MD5.HashData(
               System.Text.Encoding.UTF8.GetBytes(slot)))[..12];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        foreach (var chart in SqlCharts())
        {
            var id = CanvasId(chart.TableName);
            if (_rendered.TryGetValue(id, out var at) && at == chart.GeneratedAt) continue;
            try
            {
                await JS.InvokeVoidAsync("pcchart.render", id, chart.Html);
                _rendered[id] = chart.GeneratedAt;
            }
            catch (JSException) { /* canvas not on screen yet — the next render pass retries */ }
        }
    }

    // The run-status watcher feeds the OperationCenter on a short tick — every transition
    // (queued → running → terminal) re-renders the stats and table without a manual refresh.
    private void OnOpsChanged() => _ = InvokeAsync(async () =>
    {
        if (_refreshing) return;
        _refreshing = true;
        try { await RefreshAsync(); StateHasChanged(); }
        catch { /* live refresh is best-effort */ }
        finally { _refreshing = false; }
    });

    private async Task RefreshAsync()
    {
        try { _reports = await Svc.ListRecentRunReportsAsync(take: 50); } catch { }
        if (Ui.CurrentProjectId is { } chartPid)
        {
            try { _charts = await Svc.ListProjectChartsAsync(chartPid); } catch { }
        }

        var dayAgo = DateTimeOffset.UtcNow.AddHours(-24);
        _running = _reports.Count(r => r.Run.Status == "Running");
        _failed24 = _reports.Count(r => r.Run.Status == "Failed" && r.Run.StartedAt >= dayAgo);
        _succeeded24 = _reports.Count(r => r.Run.Status is "Succeeded" or "Partial" && r.Run.StartedAt >= dayAgo);
        _queued = Tenant.IsResolved
            ? OpCenter.ListForTenant(Tenant.TenantId).Count(o => o.Status == PlaceContext.Infrastructure.Operations.PortalOperationStatus.Queued)
            : 0;
    }

    private IReadOnlyList<RunReportView> Filtered() => _filter switch
    {
        "running" => _reports.Where(r => r.Run.Status == "Running").ToList(),
        "failed" => _reports.Where(r => r.Run.Status == "Failed").ToList(),
        _ => _reports,
    };

    private void NewJob()
    {
        if (Ui.CurrentProjectId is { } pid) Nav.NavigateTo($"/project/{pid}/jobs");
        else Nav.NavigateTo("/onboarding");
    }

    private static string Duration(JobRunDetailView run)
        => run.FinishedAt is { } f
            ? (f - run.StartedAt) is { TotalSeconds: < 60 } s ? $"{(int)s.TotalSeconds}s" : $"{(int)(f - run.StartedAt).TotalMinutes}m {(f - run.StartedAt).Seconds}s"
            : "—";

    private static string StatusColor(string status) => status switch
    {
        "Succeeded" => "var(--good)",
        "Failed" => "var(--bad)",
        "Partial" => "var(--warn)",
        "Running" => "var(--good)",
        _ => "var(--text-3)",
    };

    public void Dispose() => OpCenter.Changed -= OnOpsChanged;
}
