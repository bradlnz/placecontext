@using PlaceContext.Application.Access
@page "/"
@attribute [Authorize(Policy = Permission.ProjectsView)]
@implements IDisposable
@inject PortalUiState Ui

<PageTitle>PlaceContext — Dashboard</PageTitle>
@if (Ui.CurrentProjectId is { } projectId)
{
    <BuildChat @key="projectId" ProjectId="projectId" />
}
else
{
    <section class="page"><h1>Dashboard</h1><p>Select a project to see its activity and build with your assistant.</p></section>
}

@code {
    protected override void OnInitialized() => Ui.OnChanged += Refresh;
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    public void Dispose() => Ui.OnChanged -= Refresh;
}
