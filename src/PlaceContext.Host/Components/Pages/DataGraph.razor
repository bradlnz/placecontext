@using PlaceContext.Application.Access
@page "/project/{ProjectId:guid}/data-graph"
@attribute [Authorize(Policy = Permission.DataRead)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@using PlaceContext.Application.Features
@using PlaceContext.Application.Dtos
@using PlaceContext.Host.Components.ViewModels
@inject DataGraphViewModel Vm

<PageTitle>PlaceContext — Graph</PageTitle>

<div class="page graph-page">
    <DataTabs ProjectId="ProjectId" Active="@DataSection.Graph" />
    <header class="data-graph-heading">
        <div><h1>Data graph</h1><p>Project tables and their data mappings. Disabled mappings use dashed links.</p></div>
        <a class="dcbtn" href="@($"/project/{ProjectId}/datamap")">Manage mappings</a>
    </header>

    @if (Vm.Loading)
    {
        <Skeleton Kind="list" Rows="6" Padded />
    }
    else if (Vm.Error is not null)
    {
        <div class="error-banner">@Vm.Error</div>
    }
    else if (Vm.Graph is { Nodes.Count: 0 })
    {
        <div class="dccard empty-note">
            No data graph yet. Create a table or add a data mapping to connect source outputs to tables.
        </div>
    }
    else if (Vm.Graph is not null)
    {
        <div class="graph-studio">
            <aside class="graph-sidebar">
                <div class="graph-sidebar-head">
                    <input class="dcinput graph-search"
                           placeholder="Search tables and mappings…"
                           @bind="Vm.SearchTerm"
                           @bind:event="oninput" />
                    @if (Vm.SelectedNodeId is not null)
                    {
                        <button class="dcbtn sm" @onclick="Vm.ClearSelection">Show all</button>
                    }
                </div>
                <div class="graph-node-list">
                    @foreach (var node in Vm.FilteredNodes)
                    {
                        <button class="graph-node-item @(node.Id == Vm.SelectedNodeId ? "active" : "")"
                                @onclick="() => Vm.SelectNode(node.Id)"
                                title="@node.Label">
                            <span class="graph-node-kind @DataGraphViewModel.NodeKindClass(node.Kind)"></span>
                            <span class="graph-node-label">@Vm.ShortLabel(node.Label)</span>
                            <span class="graph-node-degree">@node.Degree</span>
                        </button>
                    }
                </div>
                <div class="graph-sidebar-foot">
                    <span>@Vm.Graph.Nodes.Count nodes</span>
                    <span>@Vm.Graph.Links.Count links</span>
                </div>
            </aside>
            <div id="data-graph-splitter"
                 class="graph-splitter"
                 role="separator"
                 aria-label="Resize node list"
                 aria-orientation="vertical"
                 aria-valuemin="220"
                 aria-valuemax="520"
                 tabindex="0"
                 title="Drag to resize the node list"></div>
            <main class="graph-main">
                <GraphCanvas @ref="_canvas"
                             Graph="Vm.Graph"
                             NodeUrl="Vm.NodeUrl"
                             Height="640"
                             Searchable="true"
                             AllowFullscreen="true"
                             DockDetails="true"
                             SinglePanel="true"
                             NodeClick="Vm.SelectNode" />
            </main>
        </div>
    }
    @if (Vm.CanViewArtifacts)
    {
        <section class="dccard artifact-catalog" aria-labelledby="artifact-catalog-title">
            <header><div><h2 id="artifact-catalog-title">Artifacts</h2><p>Stored files from this project. Map the source's primary JSON output into tables; files stay in artifact storage.</p></div></header>
            @if (Vm.ArtifactsError is not null) { <p role="alert">@Vm.ArtifactsError</p> }
            @if (Vm.Artifacts.Count > 0)
            {
                <div class="artifact-table-scroll">
                    <table>
                        <thead><tr><th>Artifact</th><th>Type</th><th>Size</th><th>Created</th><th>Data mapping</th></tr></thead>
                        <tbody>
                            @foreach (var artifact in Vm.Artifacts)
                            {
                                <tr @key="artifact.Id">
                                    <td><a href="@($"/artifacts?artifact={artifact.Id}")">@artifact.Title</a></td>
                                    <td>@artifact.ContentType</td>
                                    <td>@Vm.Presentation.Bytes(artifact.SizeBytes)</td><td>@Vm.Presentation.Format(artifact.CreatedAt, "g")</td>
                                    <td><a href="@Vm.MappingUrl(artifact.JobId)">Map source output</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (!Vm.HasMoreArtifacts) { <p>No stored artifacts in this project.</p> }
            @if (Vm.HasMoreArtifacts)
            {
                <button class="dcbtn" disabled="@Vm.ArtifactsLoading" @onclick="Vm.LoadArtifactsAsync">@(Vm.ArtifactsLoading ? "Loading…" : Vm.Artifacts.Count == 0 ? "Load artifacts" : "Load more artifacts")</button>
            }
        </section>
    }

</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private GraphCanvas _canvas = null!;

    protected override void OnInitialized()
    {
        Vm.Attach(() => InvokeAsync(StateHasChanged));
        Vm.NodeSelected += OnNodeSelected;
    }

    protected override async Task OnParametersSetAsync() => await Vm.LoadAsync(ProjectId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Vm.Graph is not null)
            await Vm.AfterRenderAsync();
    }

    private void OnNodeSelected(string? nodeId)
    {
        _ = InvokeAsync(() => _canvas.SelectNodeAsync(nodeId));
    }

    public void Dispose()
    {
        Vm.NodeSelected -= OnNodeSelected;
        Vm.Detach();
    }
}
