@page "/project/{ProjectId:guid}/data-graph"
@attribute [Authorize(Policy = Permission.DataRead)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@using PlaceContext.Application.Features
@using PlaceContext.Application.Dtos
@using PlaceContext.Host.Components.ViewModels
@inject DataGraphViewModel Vm

<PageTitle>PlaceContext — Graph</PageTitle>

<div class="page graph-page">
    <DataTabs ProjectId="ProjectId" Active="@DataSection.Graph" />

    @if (Vm.Loading)
    {
        <Skeleton Kind="list" Rows="6" Padded />
    }
    else if (Vm.Error is not null)
    {
        <div class="error-banner">@Vm.Error</div>
    }
    else if (Vm.Graph is { Nodes.Count: 0 })
    {
        <div class="dccard empty-note">
            No graph yet — record decisions, run jobs and ingest data to build the project knowledge graph.
        </div>
    }
    else if (Vm.Graph is not null)
    {
        <div class="graph-studio">
            <aside class="graph-sidebar">
                <div class="graph-sidebar-head">
                    <input class="dcinput graph-search"
                           placeholder="Search nodes…"
                           @bind="Vm.SearchTerm"
                           @bind:event="oninput" />
                    @if (Vm.SelectedNodeId is not null)
                    {
                        <button class="dcbtn sm" @onclick="Vm.ClearSelection">Show all</button>
                    }
                </div>
                <div class="graph-node-list">
                    @foreach (var node in Vm.FilteredNodes)
                    {
                        <button class="graph-node-item @(node.Id == Vm.SelectedNodeId ? "active" : "")"
                                @onclick="() => Vm.SelectNode(node.Id)"
                                title="@node.Label">
                            <span class="graph-node-kind @DataGraphViewModel.NodeKindClass(node.Kind)"></span>
                            <span class="graph-node-label">@Vm.ShortLabel(node.Label)</span>
                            <span class="graph-node-degree">@node.Degree</span>
                        </button>
                    }
                </div>
                <div class="graph-sidebar-foot">
                    <span>@Vm.Graph.Nodes.Count nodes</span>
                    <span>@Vm.Graph.Links.Count links</span>
                </div>
            </aside>
            <div id="data-graph-splitter"
                 class="graph-splitter"
                 role="separator"
                 aria-label="Resize node list"
                 aria-orientation="vertical"
                 aria-valuemin="220"
                 aria-valuemax="520"
                 tabindex="0"
                 title="Drag to resize the node list"></div>
            <main class="graph-main">
                <GraphCanvas @ref="_canvas"
                             Graph="Vm.Graph"
                             Height="640"
                             Searchable="true"
                             AllowFullscreen="true"
                             DockDetails="true"
                             SinglePanel="true"
                             NodeClick="Vm.SelectNode" />
            </main>
        </div>
    }
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private GraphCanvas _canvas = null!;

    protected override void OnInitialized()
    {
        Vm.Attach(() => InvokeAsync(StateHasChanged));
        Vm.NodeSelected += OnNodeSelected;
    }

    protected override async Task OnParametersSetAsync() => await Vm.LoadAsync(ProjectId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Vm.Graph is not null)
            await Vm.AfterRenderAsync();
    }

    private void OnNodeSelected(string? nodeId)
    {
        _ = InvokeAsync(() => _canvas.SelectNodeAsync(nodeId));
    }

    public void Dispose()
    {
        Vm.NodeSelected -= OnNodeSelected;
        Vm.Detach();
    }
}
