@using PlaceContext.Application.Access.Models
@page "/project/{ProjectId:guid}/schedules"
@attribute [Authorize(Policy = Permission.TriggersManage)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@using PlaceContext.Application.Dtos
@using PlaceContext.Application.Features
@using PlaceContext.Domain.ValueObjects
@using PlaceContext.Host.Components.ViewModels
@implements IDisposable
@inject SchedulesViewModel Vm

@if (!Embedded)
{
    <PageTitle>placecontext — Schedules</PageTitle>
}

<div class="page">
    @if (!Embedded)
    {
        <WorkflowTabs ProjectId="ProjectId" Active="schedules" />
    }
    <div class="page-head">
        <div>
            <h2 class="page-title">Schedules</h2>
            <div class="page-sub">
                @(WorkflowId.HasValue ? $"Choose when {Vm.WorkflowName ?? "this workflow"} runs." : "Choose when this project's workflows run.")
                Cron fires in <span class="tz">@Vm.TimeZoneId</span>.
            </div>
        </div>
        <button type="button" class="dcbtn primary" aria-haspopup="dialog" disabled="@(Vm.Workflows is null)" @onclick="Vm.OpenAddSchedule"><AppIcon Kind="plus" /> Add schedule</button>
    </div>

    @if (Vm.Message is not null)
    {
        <div class="message">@Vm.Message</div>
    }

    @if (!Vm.ShowAddSchedule && Vm.Error is not null)
    {
        <p class="err-text" role="alert">@Vm.Error</p>
    }

    @* ── Trigger table ────────────────────────────────────────────────────────────────── *@
    <div class="dccard table-card">
        <div class="table-scroll" tabindex="0" aria-label="Scrollable schedules table">
            <div class="trigger-grid table-head">
                <span>STATE</span><span>TRIGGER</span><span>TARGET</span><span>FIRES ON</span><span>NEXT RUN</span><span>LAST FIRED</span><span></span>
            </div>
            @if (Vm.Triggers is null)
            {
                <div class="skeleton-pad"><Skeleton Kind="text" Rows="4" /></div>
            }
            else if (Vm.Triggers.Count == 0)
            {
                <div class="empty-note">
                    No schedules yet — select Add schedule to choose when a workflow runs.
                </div>
            }
            else
            {
                @foreach (var t in Vm.Triggers)
                {
                    var isEditing = Vm.EditingId == t.Id;
                    <div class="trigger-grid trigger-row@(isEditing ? " editing" : "")">
                        @if (isEditing)
                        {
                            <span class="state-cell" style="color:@(t.Enabled ? "var(--good)" : "var(--text-3)")">
                                <span class="state-dot" style="background:@(t.Enabled ? "var(--good)" : "var(--border-2)")"></span>@(t.Enabled ? "ON" : "PAUSED")
                            </span>
                            <span class="trigger-name">
                                <input class="dcinput edit-name" @bind="Vm.EditName" />
                            </span>
                            <span class="cell-job">@Vm.TargetLabel(t)</span>
                            <span class="cell-2">
                                @if (Vm.IsEvent(t))
                                {
                                    <select class="dcinput edit-event" @bind="Vm.EditEvent">
                                        @foreach (var e in Vm.EventTypes ?? Array.Empty<EventTypeView>())
                                        {
                                            <option value="@e.Name">@e.Name</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input class="dcinput edit-cron" @bind="Vm.EditCron" placeholder="0 0 * * *" />
                                }
                            </span>
                            <span class="cell-2">@Vm.NextRunLabel(t)</span>
                            <span class="cell-3">@Vm.LastFiredLabel(t)</span>
                            <span class="row-actions">
                                @if (Vm.EditError is not null)
                                {
                                    <span class="err-text">@Vm.EditError</span>
                                }
                                <button class="dcbtn btn-sm" disabled="@Vm.EditingBusy" @onclick="@(() => Vm.SaveEditAsync(ProjectId))">Save</button>
                                <button class="dcbtn btn-sm" disabled="@Vm.EditingBusy" @onclick="Vm.CancelEdit">Cancel</button>
                            </span>
                        }
                        else
                        {
                            <span class="state-cell" style="color:@(t.Enabled ? "var(--good)" : "var(--text-3)")">
                                <span class="state-dot" style="background:@(t.Enabled ? "var(--good)" : "var(--border-2)")"></span>@(t.Enabled ? "ON" : "PAUSED")
                            </span>
                            <span class="trigger-name">@t.Name</span>
                            <span class="cell-job">@Vm.TargetLabel(t)</span>
                            <span class="cell-2">
                                @if (Vm.IsEvent(t))
                                {
                                    <text>event @t.EventName</text>
                                }
                                else
                                {
                                    <text>cron @t.CronExpression</text>
                                }
                            </span>
                        <span class="cell-2">@Vm.NextRunLabel(t)</span>
                        <span class="cell-3">@Vm.LastFiredLabel(t)</span>
                            <span class="row-actions">
                                <button class="dcbtn btn-sm" @onclick="@(() => Vm.ToggleAsync(ProjectId, t))">@(t.Enabled ? "Pause" : "Resume")</button>
                                <button class="dcbtn btn-sm" @onclick="@(() => Vm.StartEdit(t))">Edit</button>
                                <button class="dcbtn btn-sm" @onclick="@(() => Vm.RemoveAsync(ProjectId, t.Id))">Delete</button>
                            </span>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@if (Vm.ShowAddSchedule)
{
    <div class="dcmodal-overlay schedule-overlay" @onclick="Vm.CloseAddSchedule"
         @onkeydown='@(e => { if (e.Key == "Escape") Vm.CloseAddSchedule(); })'>
        <form class="dcmodal" role="dialog" aria-modal="true" aria-labelledby="add-schedule-title"
              @onclick:stopPropagation="true" @onsubmit="() => Vm.AddTriggerAsync(ProjectId)" @onsubmit:preventDefault="true">
            <div class="dcmodal-head">
                <div class="flex-min">
                    <h3 id="add-schedule-title" class="title-14">Add schedule</h3>
                    <p class="page-sub">Schedules run in @Vm.TimeZoneId.</p>
                </div>
                <button type="button" class="dcslide-x" aria-label="Close add schedule" disabled="@Vm.Busy" @onclick="Vm.CloseAddSchedule"><AppIcon Kind="close" /></button>
            </div>
            <div class="dcmodal-body">
                <div class="dcfield">
                    <label for="schedule-name">Name</label>
                    <input id="schedule-name" class="dcinput" @bind="Vm.NewName" placeholder="nightly refresh" />
                </div>
                <div class="dcfield">
                    <label for="schedule-workflow">Workflow</label>
                    <select id="schedule-workflow" class="dcinput" @bind="Vm.NewWorkflowId" disabled="@WorkflowId.HasValue">
                        <option value="@Guid.Empty">— pick a workflow —</option>
                        @foreach (var j in Vm.Workflows ?? Array.Empty<JobChainView>())
                        {
                            <option value="@j.Id">@j.Name</option>
                        }
                    </select>
                </div>
                @if (Vm.NewKind == TriggerKind.Schedule)
                {
                    @if (Vm.AdvancedCron)
                    {
                        <div class="dcfield">
                            <label for="schedule-cron">Cron <span class="code code-hint">@Vm.TimeZoneId</span></label>
                            <input id="schedule-cron" class="dcinput sans" @bind="Vm.NewCron" placeholder="0 0 * * *" />
                        </div>
                    }
                    else
                    {
                        <div class="dcfield">
                            <label for="schedule-frequency">Every</label>
                            <select id="schedule-frequency" class="dcinput" @bind="Vm.Frequency">
                                <option value="@ScheduleFrequency.Day">day</option>
                                <option value="@ScheduleFrequency.Weekday">weekday</option>
                                <option value="@ScheduleFrequency.Week">week</option>
                                <option value="@ScheduleFrequency.Month">month</option>
                                <option value="@ScheduleFrequency.Hour">hour</option>
                            </select>
                        </div>
                        @if (Vm.Frequency == ScheduleFrequency.Week)
                        {
                            <div class="dcfield">
                                <label for="schedule-weekday">On</label>
                                <select id="schedule-weekday" class="dcinput" @bind="Vm.Weekday">
                                    <option value="@((int)DayOfWeek.Monday)">Monday</option><option value="@((int)DayOfWeek.Tuesday)">Tuesday</option>
                                    <option value="@((int)DayOfWeek.Wednesday)">Wednesday</option><option value="@((int)DayOfWeek.Thursday)">Thursday</option>
                                    <option value="@((int)DayOfWeek.Friday)">Friday</option><option value="@((int)DayOfWeek.Saturday)">Saturday</option>
                                    <option value="@((int)DayOfWeek.Sunday)">Sunday</option>
                                </select>
                            </div>
                        }
                        @if (Vm.Frequency == ScheduleFrequency.Month)
                        {
                            <div class="dcfield">
                                <label for="schedule-day">Day</label>
                                <input id="schedule-day" class="dcinput" type="number" min="1" max="28" @bind="Vm.Day" />
                            </div>
                        }
                        @if (Vm.Frequency != ScheduleFrequency.Hour)
                        {
                            <div class="dcfield">
                                <label for="schedule-time">At <span class="code code-hint">@Vm.TimeZoneId</span></label>
                                <input id="schedule-time" class="dcinput" type="time" @bind="Vm.Time" />
                            </div>
                        }
                    }
                    <button type="button" class="dcbtn cron-toggle"
                            @onclick="Vm.ToggleAdvancedCron">
                        <AppIcon Kind="settings" /> @(Vm.AdvancedCron ? "Simple" : "Cron")
                    </button>
                }
                else
                {
                    <div class="dcfield">
                        <label for="schedule-event">Event</label>
                        <select id="schedule-event" class="dcinput" @bind="Vm.NewEvent">
                            @foreach (var e in Vm.EventTypes ?? Array.Empty<EventTypeView>())
                            {
                                <option value="@e.Name">@e.Name</option>
                            }
                        </select>
                    </div>
                }
                @if (Vm.Error is not null)
                {
                    <p class="err-text" role="alert">@Vm.Error</p>
                }
            </div>
            <div class="dcmodal-foot">
                <button type="button" class="dcbtn" disabled="@Vm.Busy" @onclick="Vm.CloseAddSchedule">Cancel</button>
                <button type="submit" class="dcbtn primary" disabled="@Vm.Busy">@(Vm.Busy ? "Adding…" : "Add schedule")</button>
            </div>
        </form>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid? WorkflowId { get; set; }
    [Parameter] public bool Embedded { get; set; }

    protected override void OnInitialized() =>
        Vm.Attach(() => InvokeAsync(StateHasChanged));

    protected override Task OnParametersSetAsync() => Vm.LoadAsync(ProjectId, WorkflowId);

    public void Dispose() => Vm.Detach();
}
