@page "/project/{ProjectId:guid}/schedules"
@attribute [Authorize]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@using PlaceContext.Application.Dtos
@using PlaceContext.Application.Features
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject PlaceContext.Application.Ports.ICurrentTenant Tenant

<PageTitle>placecontext — Schedules</PageTitle>

<div class="page">


    <div class="page-head">
        <div>
            <h2 class="page-title">Schedules</h2>
            <div class="page-sub">
                Every trigger across this project's jobs — cron schedules and event hooks that run jobs while you're away. Cron fires in <span class="tz">@Tenant.TimeZoneId</span> (agents set it via <code>set_workspace_timezone</code>).
            </div>
        </div>
    </div>

    @if (_message is not null)
    {
        <div class="message">@_message</div>
    }

    @* ── Add trigger ──────────────────────────────────────────────────────────────────── *@
    <div class="dccard add-bar">
        <div class="dcfield field-job">
            <label>Job</label>
            <select class="dcinput" @bind="_newJobId">
                <option value="@Guid.Empty">— pick a job —</option>
                @foreach (var j in _jobs ?? Array.Empty<JobView>())
                {
                    <option value="@j.Id">@j.Name</option>
                }
            </select>
        </div>
        <div class="dcfield field-name">
            <label>Name</label>
            <input class="dcinput" @bind="_newName" placeholder="nightly refresh" />
        </div>
        <div class="dcfield field-sm">
            <label>Kind</label>
            <select class="dcinput" @bind="_newKind">
                <option value="Schedule">Schedule</option>
                <option value="Event">Event</option>
            </select>
        </div>
        @if (_newKind == "Schedule")
        {
            @if (_advancedCron)
            {
                <div class="dcfield field-cron">
                    <label>Cron <span class="code code-hint">@Tenant.TimeZoneId</span></label>
                    <input class="dcinput sans" @bind="_newCron" placeholder="0 0 * * *" />
                </div>
            }
            else
            {
                <div class="dcfield field-sm">
                    <label>Every</label>
                    <select class="dcinput" @bind="_pickFrequency">
                        <option value="day">day</option>
                        <option value="weekday">weekday</option>
                        <option value="week">week</option>
                        <option value="month">month</option>
                        <option value="hour">hour</option>
                    </select>
                </div>
                @if (_pickFrequency == "week")
                {
                    <div class="dcfield field-sm">
                        <label>On</label>
                        <select class="dcinput" @bind="_pickWeekday">
                            <option value="1">Monday</option><option value="2">Tuesday</option>
                            <option value="3">Wednesday</option><option value="4">Thursday</option>
                            <option value="5">Friday</option><option value="6">Saturday</option>
                            <option value="0">Sunday</option>
                        </select>
                    </div>
                }
                @if (_pickFrequency == "month")
                {
                    <div class="dcfield field-day">
                        <label>Day</label>
                        <input class="dcinput" type="number" min="1" max="28" @bind="_pickDay" />
                    </div>
                }
                @if (_pickFrequency != "hour")
                {
                    <div class="dcfield field-sm">
                        <label>At <span class="code code-hint">@Tenant.TimeZoneId</span></label>
                        <input class="dcinput" type="time" @bind="_pickTime" />
                    </div>
                }
            }
            <button type="button" class="dcbtn cron-toggle"
                    @onclick="@(() => _advancedCron = !_advancedCron)">
                @(_advancedCron ? "◂ simple" : "cron ▸")
            </button>
        }
        else
        {
            <div class="dcfield field-event">
                <label>Event</label>
                <select class="dcinput" @bind="_newEvent">
                    @foreach (var e in _eventTypes ?? Array.Empty<EventTypeView>())
                    {
                        <option value="@e.Name">@e.Name</option>
                    }
                </select>
            </div>
        }
        <button class="dcbtn primary" disabled="@_busy" @onclick="AddTrigger">＋ Add trigger</button>
        @if (_error is not null)
        {
            <span class="err-text">@_error</span>
        }
    </div>

    @* ── Trigger table ────────────────────────────────────────────────────────────────── *@
    <div class="dccard table-card">
        <div class="trigger-grid table-head">
            <span>STATE</span><span>TRIGGER</span><span>JOB</span><span>FIRES ON</span><span>NEXT RUN</span><span>LAST FIRED</span><span></span>
        </div>
        @if (_triggers is null)
        {
            <div class="skeleton-pad"><Skeleton Kind="text" Rows="4" /></div>
        }
        else if (_triggers.Count == 0)
        {
            <div class="empty-note">
                No triggers yet — add a cron schedule or an event hook above.
            </div>
        }
        else
        {
            @foreach (var t in _triggers)
            {
                <div class="trigger-grid trigger-row">
                    <span class="state-cell" style="color:@(t.Enabled ? "var(--good)" : "var(--text-3)")">
                        <span class="state-dot" style="background:@(t.Enabled ? "var(--good)" : "var(--border-2)")"></span>@(t.Enabled ? "ON" : "PAUSED")
                    </span>
                    <span class="trigger-name">@t.Name</span>
                    <span class="cell-job">@JobName(t.JobId)</span>
                    <span class="cell-2">
                        @(t.Kind == "Schedule" ? $"cron {t.CronExpression}" : $"event {t.EventName}")
                    </span>
                    <span class="cell-2">@(t.NextRunAt?.ToWorkspaceTime().ToString("MMM d · HH:mm") ?? "—")</span>
                    <span class="cell-3">@(t.LastFiredAt?.ToWorkspaceTime().ToString("MMM d · HH:mm") ?? "never")</span>
                    <span class="row-actions">
                        <button class="dcbtn btn-sm" @onclick="@(() => Toggle(t))">@(t.Enabled ? "Pause" : "Resume")</button>
                        <button class="dcbtn btn-sm btn-danger" @onclick="@(() => Remove(t.Id))">Delete</button>
                    </span>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private IReadOnlyList<TriggerView>? _triggers;
    private IReadOnlyList<JobView>? _jobs;
    private IReadOnlyList<EventTypeView>? _eventTypes;
    private string? _message, _error;
    private bool _busy;

    private Guid _newJobId;
    private string _newName = "";
    private string _newKind = "Schedule";
    private string _newCron = "0 0 * * *";
    private string _newEvent = "";

    // Simple picker (the default): frequency + time compose the cron; advanced users type it raw.
    private bool _advancedCron;
    private string _pickFrequency = "day";
    private string _pickWeekday = "1";
    private int _pickDay = 1;
    private TimeOnly _pickTime = new(9, 0);

    private string ComposedCron() => _pickFrequency switch
    {
        "hour" => "0 * * * *",
        "weekday" => $"{_pickTime.Minute} {_pickTime.Hour} * * 1-5",
        "week" => $"{_pickTime.Minute} {_pickTime.Hour} * * {_pickWeekday}",
        "month" => $"{_pickTime.Minute} {_pickTime.Hour} {Math.Clamp(_pickDay, 1, 28)} * *",
        _ => $"{_pickTime.Minute} {_pickTime.Hour} * * *",
    };

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            _jobs = await Svc.ListJobsAsync(ProjectId);
            _triggers = await Svc.ListTriggersAsync(ProjectId);
            _eventTypes = await Svc.ListEventTypesAsync();
            _newEvent = _eventTypes.FirstOrDefault()?.Name ?? "";
            Ui.Set("Schedules", "cron + event triggers across this project");
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private string JobName(Guid jobId) => _jobs?.FirstOrDefault(j => j.Id == jobId)?.Name ?? "(deleted job)";

    private async Task AddTrigger()
    {
        _error = null;
        if (_newJobId == Guid.Empty) { _error = "Pick a job."; return; }
        if (string.IsNullOrWhiteSpace(_newName)) { _error = "Name is required."; return; }
        _busy = true;
        try
        {
            var cron = _newKind == "Schedule" ? (_advancedCron ? _newCron : ComposedCron()) : null;
            var evt = _newKind == "Event" ? _newEvent : null;
            await Svc.CreateTriggerAsync(new CreateTriggerCommand(_newJobId, _newName.Trim(), _newKind, cron, evt));
            _triggers = await Svc.ListTriggersAsync(ProjectId);
            _newName = "";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task Toggle(TriggerView t)
    {
        try
        {
            await Svc.SetTriggerEnabledAsync(t.Id, !t.Enabled);
            _triggers = await Svc.ListTriggersAsync(ProjectId);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task Remove(Guid id)
    {
        try
        {
            await Svc.DeleteTriggerAsync(id);
            _triggers = await Svc.ListTriggersAsync(ProjectId);
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
