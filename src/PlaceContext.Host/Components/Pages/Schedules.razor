@page "/project/{ProjectId:guid}/schedules"
@attribute [Authorize(Policy = Permission.TriggersManage)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@using PlaceContext.Application.Dtos
@using PlaceContext.Application.Features
@using PlaceContext.Domain.ValueObjects
@using PlaceContext.Host.Components.ViewModels
@implements IDisposable
@inject SchedulesViewModel Vm

<PageTitle>placecontext — Schedules</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <h2 class="page-title">Schedules</h2>
            <div class="page-sub">
                Every trigger across this project's jobs — cron schedules, event hooks, and launchpads that run an autonomous agent session on a schedule.
                Cron fires in <span class="tz">@Vm.TimeZoneId</span>.
            </div>
        </div>
    </div>

    @if (Vm.Message is not null)
    {
        <div class="message">@Vm.Message</div>
    }

    @* ── Add trigger ──────────────────────────────────────────────────────────────────── *@
    <div class="dccard add-bar">
        <div class="dcfield field-sm">
            <label>Kind</label>
            <select class="dcinput" @bind="Vm.NewKind" @bind:after="Vm.OnKindChangedAsync">
                <option value="@TriggerKind.Schedule">Schedule</option>
                <option value="@TriggerKind.Event">Event</option>
                <option value="@TriggerKind.Launchpad">Launchpad</option>
            </select>
        </div>
        <div class="dcfield field-name">
            <label>Name</label>
            <input class="dcinput" @bind="Vm.NewName" placeholder="nightly refresh" />
        </div>
        @if (Vm.NewKind == TriggerKind.Launchpad)
        {
            <div class="dcfield field-job">
                <label>Chain</label>
                <select class="dcinput" @bind="Vm.NewChainId">
                    <option value="@Guid.Empty">— pick a chain —</option>
                    @foreach (var c in Vm.Chains ?? Array.Empty<JobChainView>())
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="dcfield field-job">
                <label>Source table</label>
                <select class="dcinput" @bind="Vm.NewSourceTable">
                    <option value="">— optional —</option>
                    @foreach (var t in Vm.Tables ?? Array.Empty<ProjectTableInfo>())
                    {
                        <option value="@t.Name">@t.Name</option>
                    }
                </select>
            </div>
        }
        else
        {
            <div class="dcfield field-job">
                <label>Job</label>
                <select class="dcinput" @bind="Vm.NewJobId">
                    <option value="@Guid.Empty">— pick a job —</option>
                    @foreach (var j in Vm.Jobs ?? Array.Empty<JobView>())
                    {
                        <option value="@j.Id">@j.Name</option>
                    }
                </select>
            </div>
        }
        @if (Vm.NewKind is TriggerKind.Schedule or TriggerKind.Launchpad)
        {
            @if (Vm.AdvancedCron)
            {
                <div class="dcfield field-cron">
                    <label>Cron <span class="code code-hint">@Vm.TimeZoneId</span></label>
                    <input class="dcinput sans" @bind="Vm.NewCron" placeholder="0 0 * * *" />
                </div>
            }
            else
            {
                <div class="dcfield field-sm">
                    <label>Every</label>
                    <select class="dcinput" @bind="Vm.Frequency">
                        <option value="@ScheduleFrequency.Day">day</option>
                        <option value="@ScheduleFrequency.Weekday">weekday</option>
                        <option value="@ScheduleFrequency.Week">week</option>
                        <option value="@ScheduleFrequency.Month">month</option>
                        <option value="@ScheduleFrequency.Hour">hour</option>
                    </select>
                </div>
                @if (Vm.Frequency == ScheduleFrequency.Week)
                {
                    <div class="dcfield field-sm">
                        <label>On</label>
                        <select class="dcinput" @bind="Vm.Weekday">
                            <option value="@((int)DayOfWeek.Monday)">Monday</option><option value="@((int)DayOfWeek.Tuesday)">Tuesday</option>
                            <option value="@((int)DayOfWeek.Wednesday)">Wednesday</option><option value="@((int)DayOfWeek.Thursday)">Thursday</option>
                            <option value="@((int)DayOfWeek.Friday)">Friday</option><option value="@((int)DayOfWeek.Saturday)">Saturday</option>
                            <option value="@((int)DayOfWeek.Sunday)">Sunday</option>
                        </select>
                    </div>
                }
                @if (Vm.Frequency == ScheduleFrequency.Month)
                {
                    <div class="dcfield field-day">
                        <label>Day</label>
                        <input class="dcinput" type="number" min="1" max="28" @bind="Vm.Day" />
                    </div>
                }
                @if (Vm.Frequency != ScheduleFrequency.Hour)
                {
                    <div class="dcfield field-sm">
                        <label>At <span class="code code-hint">@Vm.TimeZoneId</span></label>
                        <input class="dcinput" type="time" @bind="Vm.Time" />
                    </div>
                }
            }
            <button type="button" class="dcbtn cron-toggle"
                    @onclick="Vm.ToggleAdvancedCron">
                @(Vm.AdvancedCron ? "◂ simple" : "cron ▸")
            </button>
        }
        else
        {
            <div class="dcfield field-event">
                <label>Event</label>
                <select class="dcinput" @bind="Vm.NewEvent">
                    @foreach (var e in Vm.EventTypes ?? Array.Empty<EventTypeView>())
                    {
                        <option value="@e.Name">@e.Name</option>
                    }
                </select>
            </div>
        }
        @if (Vm.NewKind == TriggerKind.Launchpad)
        {
            <div class="dcfield field-prompt">
                <label>Prompt</label>
                <textarea class="dcinput" rows="3" @bind="Vm.NewPrompt" placeholder="For each row, run the chain and summarize anomalies." />
            </div>
        }
        <button class="dcbtn primary" disabled="@Vm.Busy" @onclick="@(() => Vm.AddTriggerAsync(ProjectId))">＋ Add trigger</button>
        @if (Vm.Error is not null)
        {
            <span class="err-text">@Vm.Error</span>
        }
    </div>

    @* ── Trigger table ────────────────────────────────────────────────────────────────── *@
    <div class="dccard table-card">
        <div class="table-scroll" tabindex="0" aria-label="Scrollable schedules table">
            <div class="trigger-grid table-head">
                <span>STATE</span><span>TRIGGER</span><span>TARGET</span><span>FIRES ON</span><span>NEXT RUN</span><span>LAST FIRED</span><span></span>
            </div>
            @if (Vm.Triggers is null)
            {
                <div class="skeleton-pad"><Skeleton Kind="text" Rows="4" /></div>
            }
            else if (Vm.Triggers.Count == 0)
            {
                <div class="empty-note">
                    No triggers yet — add a cron schedule, an event hook, or an agent launchpad above.
                </div>
            }
            else
            {
                @foreach (var t in Vm.Triggers)
                {
                    var isEditing = Vm.EditingId == t.Id;
                    <div class="trigger-grid trigger-row@(isEditing ? " editing" : "")">
                        @if (isEditing)
                        {
                            <span class="state-cell" style="color:@(t.Enabled ? "var(--good)" : "var(--text-3)")">
                                <span class="state-dot" style="background:@(t.Enabled ? "var(--good)" : "var(--border-2)")"></span>@(t.Enabled ? "ON" : "PAUSED")
                            </span>
                            <span class="trigger-name">
                                <input class="dcinput edit-name" @bind="Vm.EditName" />
                            </span>
                            <span class="cell-job">@Vm.TargetLabel(t)</span>
                            <span class="cell-2">
                                @if (Vm.IsEvent(t))
                                {
                                    <select class="dcinput edit-event" @bind="Vm.EditEvent">
                                        @foreach (var e in Vm.EventTypes ?? Array.Empty<EventTypeView>())
                                        {
                                            <option value="@e.Name">@e.Name</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input class="dcinput edit-cron" @bind="Vm.EditCron" placeholder="0 0 * * *" />
                                }
                            </span>
                            <span class="cell-2">@Vm.NextRunLabel(t)</span>
                            <span class="cell-3">@Vm.LastFiredLabel(t)</span>
                            <span class="row-actions">
                                @if (Vm.EditError is not null)
                                {
                                    <span class="err-text">@Vm.EditError</span>
                                }
                                <button class="dcbtn btn-sm" disabled="@Vm.EditingBusy" @onclick="@(() => Vm.SaveEditAsync(ProjectId))">Save</button>
                                <button class="dcbtn btn-sm" disabled="@Vm.EditingBusy" @onclick="Vm.CancelEdit">Cancel</button>
                            </span>
                        }
                        else
                        {
                            <span class="state-cell" style="color:@(t.Enabled ? "var(--good)" : "var(--text-3)")">
                                <span class="state-dot" style="background:@(t.Enabled ? "var(--good)" : "var(--border-2)")"></span>@(t.Enabled ? "ON" : "PAUSED")
                            </span>
                            <span class="trigger-name">@t.Name</span>
                            <span class="cell-job">@Vm.TargetLabel(t)</span>
                            <span class="cell-2">
                                @if (Vm.IsEvent(t))
                                {
                                    <text>event @t.EventName</text>
                                }
                                else
                                {
                                    <text>cron @t.CronExpression</text>
                                }
                            </span>
                        <span class="cell-2">@Vm.NextRunLabel(t)</span>
                        <span class="cell-3">@Vm.LastFiredLabel(t)</span>
                            <span class="row-actions">
                                <button class="dcbtn btn-sm" @onclick="@(() => Vm.ToggleAsync(ProjectId, t))">@(t.Enabled ? "Pause" : "Resume")</button>
                                <button class="dcbtn btn-sm" @onclick="@(() => Vm.StartEdit(t))">Edit</button>
                                <button class="dcbtn btn-sm btn-danger" @onclick="@(() => Vm.RemoveAsync(ProjectId, t.Id))">Delete</button>
                            </span>
                        }
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    protected override void OnInitialized() =>
        Vm.Attach(() => InvokeAsync(StateHasChanged));

    protected override Task OnParametersSetAsync() => Vm.LoadAsync(ProjectId);

    public void Dispose() => Vm.Detach();
}
