@page "/settings/access"
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@attribute [Authorize(Policy = Policies.DefaultAdmin)]
@using PlaceContext.Host.Components.ViewModels
@using Microsoft.AspNetCore.Components.Authorization
@inject AccessSettingsViewModel Vm
@implements IDisposable


<PageTitle>PlaceContext — Access</PageTitle>

<div class="access-settings-page">
    <header class="settings-head">
        <div>
            <span class="settings-kicker">Workspace administration</span>
            <h2>Access</h2>
            <p>Manage members, roles and permission overrides. Explicit overrides take precedence over role permissions.</p>
        </div>
@if (_isImpersonating)
{
            <div class="impersonation-header">
                <div class="impersonation-banner">
                    You are impersonating <strong>@_currentDisplayName</strong>.
                    Signed in as <strong>@_impersonatorDisplay</strong>.
                </div>
                <form method="post" action="/auth/impersonate/stop" class="impersonation-stop-form">
                    <AntiforgeryToken />
                    <input type="hidden" name="returnUrl" value="/settings/access" />
                    <button class="dcbtn danger" type="submit">Stop impersonation</button>
                </form>
            </div>
        }
    </header>

    @if (Vm.Loading)
    {
        <Skeleton Kind="list" Rows="4" />
    }
    else
    {

        @if (Vm.Message is not null)
        {
            <div class="message">@Vm.Message</div>
        }

        @* ── Invite ────────────────────────────────────────────────────────────────────────── *@
        <div class="dccard invite-card">
            <div class="invite-title">Invite a member</div>
            <div class="invite-row">
                <div class="invite-email">
                    <label class="field-label">Email</label>
                    <input class="dcinput input-full-sans" @bind="Vm.InviteEmail" placeholder="name@example.com" />
                </div>
                <div class="invite-role">
                    <label class="field-label">Role</label>
                    <select class="dcinput input-full" @bind="Vm.InviteRole">
                        @foreach (var r in Vm.AssignableRoles)
                        {
                            <option value="@r.Name">@r.Name</option>
                        }
                    </select>
                </div>
                <button class="dcbtn primary" disabled="@Vm.Inviting" @onclick="Vm.InviteAsync">@(Vm.Inviting ? "Inviting…" : "Send invite")</button>
            </div>
            @if (Vm.InviteLink is not null)
            {
                <div class="dchint">Invite link (share it — single use): <span class="code">@Vm.InviteLink</span></div>
            }
            @if (Vm.InviteError is not null)
            {
                <div class="err-text">@Vm.InviteError</div>
            }
        </div>

        @* ── Members ───────────────────────────────────────────────────────────────────────── *@
        @if (Vm.Members.Count == 0)
        {
            <div class="dccard empty-note">
                No members yet — invite one above.
            </div>
        }
        else
        {
            <div class="manage-row">
                <label class="field-label">Manage member</label>
                <select class="dcinput manage-select" value="" @onchange="Vm.ManageMemberAsync">
                    <option value="">Select a member…</option>
                    @foreach (var m in Vm.Members.Where(x => !x.IsDefaultAdmin))
                    {
                        <option value="@m.Id">@m.DisplayName · @m.Email</option>
                    }
                </select>
            </div>
            <div class="member-list">
                @foreach (var m in Vm.Members)
                {
                    <div class="dccard member-card" id="member-@m.Id">
                        <div class="member-row">
                            <div class="member-info">
                                <div class="member-name">
                                    @m.DisplayName <span class="member-email">· @m.Email</span>
                                    @if (m.IsDefaultAdmin)
                                    {
                                        <span class="flag-badge default">Default admin</span>
                                    }
                                </div>
                                <div class="note-11">member since @Vm.MemberSince(m.CreatedAt)</div>
                            </div>
                            <select class="dcinput role-select" value="@m.Role" disabled="@(Vm.Busy || m.IsDefaultAdmin)"
                                    @onchange="@(e => Vm.SetRoleAsync(m.Id, e))">
                                @foreach (var r in Vm.AssignableRoles)
                                {
                                    <option value="@r.Name">@r.Name</option>
                                }
                                @* Keep the member's current role selectable when it isn't assignable
                                   (Owner, or a since-deleted custom role) so the select shows it. *@
                                @if (!Vm.AssignableRoles.Any(r => r.Name == m.Role))
                                {
                                    <option value="@m.Role">@m.Role</option>
                                }
                            </select>
                            <form method="post" action="/auth/impersonate">
                                <AntiforgeryToken />
                                <input type="hidden" name="userId" value="@m.Id" />
                                <input type="hidden" name="returnUrl" value="/settings/access" />
                                <button type="submit" class="dcbtn"
                                        disabled="@(_isImpersonating || m.Id == Vm.CurrentUserId)">Impersonate</button>
                            </form>
                            <button class="dcbtn perm-toggle" @onclick="@(() => Vm.ToggleMatrixAsync(m.Id))">
                                @(Vm.Expanded == m.Id ? "Hide permissions" : "Permissions")
                            </button>
                            @if (Vm.CanRemoveMember(m))
                            {
                                @if (Vm.ConfirmRemoveId == m.Id)
                                {
                                    <button class="dcbtn perm-toggle danger" disabled="@Vm.Busy"
                                            @onclick="@(() => Vm.RemoveMemberAsync(m.Id))">Confirm remove</button>
                                    <button class="dcbtn perm-toggle" @onclick="@(() => Vm.ConfirmRemoveId = null)">Keep</button>
                                }
                                else
                                {
                                    <button class="dcbtn perm-toggle danger" @onclick="@(() => Vm.ConfirmRemoveId = m.Id)">Remove</button>
                                }
                            }
                        </div>
                        @if (Vm.Expanded == m.Id)
                        {
                            <div class="matrix">
                                @if (Vm.Matrix is null)
                                {
                                    <div class="matrix-loading">Loading…</div>
                                }
                                else
                                {
                                    <div class="note-11">
                                        Role default shown in parentheses; Inherit clears the override and follows the role.
                                    </div>
                                    @foreach (var g in Vm.Matrix.Permissions)
                                    {
                                        <div class="perm-row">
                                            <span class="perm-name">
                                                @g.Permission <span class="muted">(default: @(g.DefaultAllowed ? "allow" : "deny"))</span>
                                            </span>
                                            <div class="perm-btns">
                                                <button class="dcbtn @(g.Override == true ? "primary" : "") perm-btn"
                                                        disabled="@Vm.Busy" @onclick="@(() => Vm.SetOverrideAsync(m.Id, g.Permission, true))">Allow</button>
                                                <button class="dcbtn perm-btn" style="@(g.Override == false ? "color:var(--bad); border-color:var(--bad)" : "")"
                                                        disabled="@Vm.Busy" @onclick="@(() => Vm.SetOverrideAsync(m.Id, g.Permission, false))">Revoke</button>
                                                <button class="dcbtn perm-btn" disabled="@(Vm.Busy || g.Override is null)"
                                                        @onclick="@(() => Vm.SetOverrideAsync(m.Id, g.Permission, null))">Inherit</button>
                                            </div>
                                            <span class="perm-status" style="color:@(g.Effective ? "var(--good)" : "var(--text-3)")">@(g.Effective ? "granted" : "denied")</span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @* ── Roles & permissions ───────────────────────────────────────────────────────────── *@
        <div class="dccard roles-card">
            <div class="invite-title">Roles &amp; permissions</div>
            <div class="note-11">
                A role is a named set of permissions. System roles ship with the workspace — you can edit
                what they grant (except Owner) but not remove them. Custom roles can be assigned to
                members and deleted while nobody holds them.
            </div>

            <div class="role-list">
                @foreach (var role in Vm.Roles)
                {
                    <div class="role-item">
                        <div class="role-row">
                            <div class="role-info">
                                <span class="role-name">@role.Name</span>
                                @if (role.IsSystem)
                                {
                                    <span class="flag-badge system">System</span>
                                }
                                <span class="note-11">@role.MemberCount @(role.MemberCount == 1 ? "member" : "members")</span>
                            </div>
                            <div class="role-actions">
                                @if (!Vm.IsOwnerRole(role))
                                {
                            <button class="dcbtn perm-toggle" @onclick="@(() => Vm.ToggleRoleEdit(role))">
                                        @(Vm.EditRoleId == role.Id ? "Close" : "Edit")
                                    </button>
                                }
                                @if (!role.IsSystem && role.MemberCount == 0)
                                {
                                    @if (Vm.ConfirmDeleteRoleId == role.Id)
                                    {
                                        <button class="dcbtn perm-toggle danger" disabled="@Vm.Busy"
                                                @onclick="@(() => Vm.DeleteRoleAsync(role.Id))">Confirm delete</button>
                                        <button class="dcbtn perm-toggle" @onclick="@(() => Vm.ConfirmDeleteRoleId = null)">Keep</button>
                                    }
                                    else
                                    {
                                        <button class="dcbtn perm-toggle danger" @onclick="@(() => Vm.ConfirmDeleteRoleId = role.Id)">Delete</button>
                                    }
                                }
                            </div>
                        </div>
                        <div class="note-11 role-perms">@Vm.PermissionSummary(role)</div>
                        @if (Vm.EditRoleId == role.Id)
                        {
                            <div class="perm-grid">
                                @foreach (var p in Vm.Permissions)
                                {
                                    <label class="perm-check">
                                        <input type="checkbox" checked="@Vm.EditRolePerms.Contains(p)"
                                               @onchange="@(e => Vm.TogglePerm(Vm.EditRolePerms, p, e.Value))" />
                                        @p
                                    </label>
                                }
                            </div>
                            <div class="role-edit-actions">
                                <button class="dcbtn primary" disabled="@Vm.Busy"
                                        @onclick="@(() => Vm.SaveRolePermissionsAsync(role.Id))">Save permissions</button>
                                <button class="dcbtn" @onclick="@(() => Vm.EditRoleId = null)">Cancel</button>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="role-create">
                <div class="invite-title">Create a role</div>
                <div class="role-create-name">
                    <label class="field-label">Name</label>
                    <input class="dcinput input-full-sans" @bind="Vm.NewRoleName" placeholder="Support" />
                </div>
                <div class="perm-grid">
                    @foreach (var p in Vm.Permissions)
                    {
                        <label class="perm-check">
                            <input type="checkbox" checked="@Vm.NewRolePerms.Contains(p)"
                                   @onchange="@(e => Vm.TogglePerm(Vm.NewRolePerms, p, e.Value))" />
                            @p
                        </label>
                    }
                </div>
                <div>
                    <button class="dcbtn primary" disabled="@(Vm.Busy || string.IsNullOrWhiteSpace(Vm.NewRoleName))"
                            @onclick="Vm.CreateRoleAsync">Create role</button>
                </div>
            </div>
        </div>
    }
</div>


@code {
    protected override void OnInitialized()
        => Vm.Attach(() => InvokeAsync(StateHasChanged));

    protected override async Task OnInitializedAsync()
    {
        await Vm.LoadAsync();
        await LoadImpersonationStateAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
        => Vm.AfterRenderAsync(firstRender);

    public void Dispose()
        => Vm.Detach();

    [CascadingParameter]
    public Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private const string ClaimImpersonating = "pc-impersonate-active";
    private const string ClaimImpersonatorName = "pc-impersonate-impersonator-name";
    private const string ClaimImpersonatorEmail = "pc-impersonate-impersonator-email";

    private bool _isImpersonating;
    private string _impersonatorDisplay = "";
    private string _currentDisplayName = "";

    private async Task LoadImpersonationStateAsync()
    {
        var auth = await AuthenticationStateTask;
        var user = auth.User;
        if (user.Identity is null || !user.Identity.IsAuthenticated)
        {
            _isImpersonating = false;
            _currentDisplayName = "";
            _impersonatorDisplay = "";
            return;
        }

        _isImpersonating = user.FindFirst(ClaimImpersonating) is not null;
        if (!_isImpersonating)
        {
            _currentDisplayName = "";
            _impersonatorDisplay = "";
            return;
        }

        _currentDisplayName = !string.IsNullOrWhiteSpace(user.Identity?.Name)
            ? user.Identity.Name
            : "this user";
        _impersonatorDisplay = user.FindFirst(ClaimImpersonatorName)?.Value
            ?? user.FindFirst(ClaimImpersonatorEmail)?.Value
            ?? "a workspace admin";
        StateHasChanged();
    }
}
