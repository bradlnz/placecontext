@page "/project/{ProjectId:guid}/datamap"
@attribute [Authorize(Policy = Permission.DataRead)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@using PlaceContext.Application.Dtos
@using PlaceContext.Application.Features
@using PlaceContext.Host.Components.ViewModels
@inject DataMapViewModel Vm
@inject PortalUiState Ui

<PageTitle>PlaceContext — Data map</PageTitle>

@if (Vm.Loading)
{
    <Skeleton Kind="list" Rows="6" Padded />
}
else
{
    <div class="data-map-page">
        <DataTabs ProjectId="ProjectId" Active="datamap" />

        <header class="data-map-head">
            <div>
                <h2>Data map</h2>
                <p>Choose which job results become queryable project tables after a completed run.</p>
            </div>
            <button class="dcbtn primary" @onclick="@(() => Vm.OpenEditor(null))">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                New mapping
            </button>
        </header>

        @if (Vm.Message is not null)
        {
            <div class="status-message">@Vm.Message</div>
        }

        <section class="summary-strip" aria-label="Data mapping summary">
            <div><strong>@JobCount</strong><span>jobs</span></div>
            <div><strong>@MappedJobCount</strong><span>mapped jobs</span></div>
            <div><strong>@EnabledMappingCount</strong><span>active mappings</span></div>
            <div class="needs-attention"><strong>@UnmappedJobCount</strong><span>need mapping</span></div>
        </section>

        <section class="dccard mapping-suite">
            <header class="suite-head">
                <div>
                    <strong>Job outputs</strong>
                    <span>Mappings run after each successful or partial job run</span>
                </div>
                <span>@(Vm.Tables?.Count ?? 0) project tables</span>
            </header>

            @if (JobCount == 0)
            {
                <div class="mapping-empty">No jobs exist in this project yet.</div>
            }
            else
            {
                <div class="mapping-rows">
                @foreach (var job in OrderedJobs)
                {
                    var mappings = MappingsFor(job.Id);
                    <article class="mapping-row @(mappings.Count == 0 ? "unmapped" : null)">
                        <div class="mapping-status @(mappings.Count == 0 ? "missing" : "configured")" aria-hidden="true">
                            @if (mappings.Count == 0)
                            {
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8" /><path d="M12 8v5M12 16.5h.01" /></svg>
                            }
                            else
                            {
                                <svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6" /></svg>
                            }
                        </div>
                        <div class="mapping-main">
                            <div class="mapping-job-title">
                                <strong>@job.Name</strong>
                                <span class="mapping-chip">@job.ReturnType output</span>
                            </div>
                            @if (mappings.Count == 0)
                            {
                                <div class="unmapped-copy">
                                    <strong>No data mapping</strong>
                                    <span>Completed runs do not populate a project table.</span>
                                </div>
                            }
                            else
                            {
                                <div class="job-mappings">
                                    @foreach (var mapping in mappings)
                                    {
                                        <button class="mapping-detail" @onclick="@(() => Vm.OpenEditor(mapping))">
                                            <span class="mapping-route">
                                                <span class="table-icon"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="8" ry="3" /><path d="M4 5v7c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12v7c0 1.7 3.6 3 8 3s8-1.3 8-3v-7" /></svg></span>
                                                <strong>@mapping.TargetTable</strong>
                                                <span>@(Vm.TableRows(mapping.TargetTable) is { } rows ? $"{rows:N0} rows" : "created on next ingest")</span>
                                            </span>
                                            <span class="mapping-facts">
                                                @(string.IsNullOrWhiteSpace(mapping.RowsPath) ? "root object" : $"rows at {mapping.RowsPath}")
                                                · @mapping.Fields.Count field@(mapping.Fields.Count == 1 ? "" : "s")
                                                · <span class="@(mapping.Enabled ? "enabled" : "disabled")">@(mapping.Enabled ? "enabled" : "paused")</span>
                                            </span>
                                            <svg class="edit-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m14 5 5 5M4 20l4.5-1L19 8l-4-4L5 15.5z" /></svg>
                                        </button>
                                    }
                                </div>
                            }
                        </div>
                        @if (mappings.Count == 0)
                        {
                            <button class="dcbtn map-action" @onclick="@(() => Vm.OpenEditorForJob(job))">Create mapping</button>
                        }
                        else
                        {
                            <button class="icon-add" title="Add another mapping" aria-label="Add another mapping for @job.Name"
                                    @onclick="@(() => Vm.OpenEditorForJob(job))">
                                <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
                            </button>
                        }
                    </article>
                }
                </div>
            }
        </section>
    </div>
}

@if (Vm.ShowEditor)
{
    <div class="dcslide-scrim" @onclick="Vm.CloseEditor"></div>
    <div class="dcslide" style="width:560px">
        <div class="dcslide-head">
            <div style="flex:1">
                <div style="font-size:14px; font-weight:600">@(Vm.EditId.HasValue ? "Edit mapping" : "New mapping")</div>
                <div style="font-size:11.5px; color:var(--text-3); margin-top:3px">Job result → project table, after every completed run.</div>
            </div>
            <button class="dcslide-x" @onclick="Vm.CloseEditor" aria-label="Close">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
        </div>
        <div class="dcslide-body" style="flex:1; overflow-y:auto; display:flex; flex-direction:column; gap:14px">

            <div class="dcfield">
                <label>Source job <span class="req">*</span></label>
                <select class="dcinput" @bind="Vm.EdJobId">
                    <option value="@Guid.Empty">— pick a job —</option>
                    @foreach (var j in Vm.Jobs ?? Array.Empty<JobView>())
                    {
                        <option value="@j.Id">@j.Name (@j.ReturnType)</option>
                    }
                </select>
            </div>

            <div style="display:flex; gap:10px">
                <div class="dcfield" style="flex:1">
                    <label>Target table <span class="req">*</span></label>
                    <input class="dcinput" @bind="Vm.EdTable" list="pc-datamap-tables" placeholder="listings" />
                    <datalist id="pc-datamap-tables">
                        @foreach (var t in Vm.Tables ?? Array.Empty<PlaceContext.Application.Ports.ProjectTableInfo>())
                        {
                            <option value="@t.Name" />
                        }
                    </datalist>
                </div>
                <div class="dcfield" style="flex:1">
                    <label>Records at <span class="code" style="margin-left:5px">dot path, blank = root</span></label>
                    <input class="dcinput" @bind="Vm.EdRowsPath" placeholder="rows" />
                </div>
            </div>

            <div class="dcfield">
                <div style="display:flex; align-items:center; justify-content:space-between">
                    <label>Fields</label>
                    <div style="display:flex; gap:6px">
                        <button class="dcbtn" style="padding:3px 9px; font-size:11px" @onclick="() => Vm.SuggestFieldsAsync()"
                                disabled="@(Vm.EdJobId == Guid.Empty)" title="Prefill from the job's latest run result">
                            @(Vm.Suggesting ? "Reading last run…" : "Suggest from last run")
                        </button>
                        <button class="dcbtn field-add" @onclick="() => Vm.AddField()">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                            Field
                        </button>
                    </div>
                </div>
                <div style="display:flex; flex-direction:column; gap:6px; margin-top:6px">
                    @for (var i = 0; i < Vm.EdFields.Count; i++)
                    {
                        var idx = i;
                        <div style="display:flex; gap:6px; align-items:center">
                            <input class="dcinput" style="flex:1.2; font-size:12px" placeholder="source path (e.g. price)"
                                   @bind="Vm.EdFields[idx].SourcePath" />
                            <svg class="field-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5" /></svg>
                            <input class="dcinput" style="flex:1; font-size:12px; font-family:var(--font-sans)" placeholder="column"
                                   @bind="Vm.EdFields[idx].Column" />
                            <select class="dcinput" style="flex:none; width:110px; font-size:12px" @bind="Vm.EdFields[idx].Type">
                                @foreach (var t in DataMapViewModel.ColumnTypes)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                            <button class="dcbtn field-remove" title="Remove field" aria-label="Remove field" @onclick="@(() => Vm.RemoveField(idx))">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                            </button>
                        </div>
                    }
                    @if (Vm.EdFields.Count == 0)
                    {
                        <div style="font-size:11.5px; color:var(--text-3)">No fields yet — add one, or suggest them from the job's latest run.</div>
                    }
                </div>
            </div>

            <label style="display:flex; align-items:center; gap:8px; font-size:12.5px; color:var(--text-2); cursor:pointer; user-select:none">
                <input type="checkbox" @bind="Vm.EdEnabled" style="width:15px; height:15px; accent-color:var(--brand-2); cursor:pointer" />
                Enabled — ingest after every completed run
            </label>

            <div class="dchint">
                The table is created on first ingest as an append-only system table with
                <code>ingested_at</code> and <code>run_id</code> provenance columns, queryable from the Data tab.
            </div>
        </div>
        <div class="dcslide-foot">
            @if (Vm.EditorError is not null)
            {
                <div style="flex:1; color:var(--bad); font-size:12px; min-width:0">@Vm.EditorError</div>
            }
            @if (Vm.EditId.HasValue)
            {
                <button class="dcbtn" style="color:var(--bad)" disabled="@Vm.Saving" @onclick="() => Vm.DeleteMappingAsync()">Delete</button>
            }
            <button class="dcbtn" @onclick="Vm.CloseEditor">Cancel</button>
            <button class="dcbtn primary" disabled="@Vm.Saving" @onclick="() => Vm.SaveMappingAsync()">
                @(Vm.Saving ? "Saving…" : Vm.EditId.HasValue ? "Save changes" : "Create mapping")
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        Vm.Initialize(ProjectId);
        await Vm.LoadAsync();
        Ui.Set("Data map", "job results → project tables");
    }

    public void Dispose() => Vm.Detach();

    private int JobCount => Vm.Jobs?.Count ?? 0;
    private int MappedJobCount => (Vm.Mappings ?? Array.Empty<DataMappingView>()).Select(mapping => mapping.JobId).Distinct().Count();
    private int EnabledMappingCount => (Vm.Mappings ?? Array.Empty<DataMappingView>()).Count(mapping => mapping.Enabled);
    private int UnmappedJobCount => Math.Max(0, JobCount - MappedJobCount);

    private IReadOnlyList<JobView> OrderedJobs => (Vm.Jobs ?? Array.Empty<JobView>())
        .OrderBy(job => MappingsFor(job.Id).Count == 0 ? 0 : 1)
        .ThenBy(job => job.Name, StringComparer.OrdinalIgnoreCase)
        .ToArray();

    private IReadOnlyList<DataMappingView> MappingsFor(Guid jobId) =>
        (Vm.Mappings ?? Array.Empty<DataMappingView>())
            .Where(mapping => mapping.JobId == jobId)
            .OrderBy(mapping => mapping.TargetTable, StringComparer.OrdinalIgnoreCase)
            .ToArray();
}
