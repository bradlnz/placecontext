@page "/project/{ProjectId:guid}/datamap"
@attribute [Authorize(Policy = Permission.DataRead)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@using PlaceContext.Application.Dtos
@using PlaceContext.Application.Features
@using PlaceContext.Host.Components.ViewModels
@inject DataMapViewModel Vm
@inject PortalUiState Ui

<PageTitle>PlaceContext — Data map</PageTitle>

@if (Vm.Loading || !Vm.PosLoaded)
{
    <Skeleton Kind="detail" Rows="5" Padded />
}
else
{
    <div style="padding:20px 24px 40px; max-width:1320px; margin:0 auto">

        <DataTabs ProjectId="ProjectId" Active="datamap" />

        <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:18px">
            <div>
                <h2 style="font-size:18px; font-weight:600; margin:0">Data map</h2>
                <div style="font-size:12px; color:var(--text-3); margin-top:3px">
                    The data flow, live: drag nodes to arrange, click an edge to edit its mapping,
                    drag a job's ＋ onto a table to connect them.
                </div>
            </div>
            <button class="dcbtn primary" @onclick="@(() => Vm.OpenEditor(null))">+ New mapping</button>
        </div>

        @if (Vm.Message is not null)
        {
            <div style="margin-bottom:12px; padding:10px 14px; border-radius:8px; background:var(--card); font-size:12.5px; color:var(--text-2)">@Vm.Message</div>
        }

        <div style="position:relative; height:65vh; min-height:480px; border:1px solid var(--border); border-radius:10px; overflow:hidden; background:var(--card); background-image:radial-gradient(var(--border-2) 1px, transparent 1px); background-size:22px 22px; background-position:@(Vm.PanX)px @(Vm.PanY)px; user-select:none; touch-action:none; cursor:@(Vm.Panning ? "grabbing" : "grab")"
             @onpointerdown="OnCanvasDown" @onpointermove="OnCanvasMove" @onpointerup="OnCanvasUp">

            <svg style="position:absolute; inset:0; width:100%; height:100%; pointer-events:none">
                <defs>
                    <marker id="pcarrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                        <path d="M0 0 L10 5 L0 10 Z" fill="var(--brand-2)" />
                    </marker>
                </defs>
                @foreach (var m in Vm.Mappings ?? Array.Empty<DataMappingView>())
                {
                    var mp = m;
                    <path d="@Vm.EdgePath(mp)" fill="none" stroke="var(--brand-2)" stroke-width="1.6"
                          stroke-dasharray="@(mp.Enabled ? "none" : "5 4")" opacity="@(mp.Enabled ? "0.9" : "0.4")"
                          marker-end="url(#pcarrow)" style="pointer-events:stroke; cursor:pointer"
                          @onclick="@(() => Vm.OpenEditor(mp))">
                        <title>@mp.JobName → @mp.TargetTable (@mp.Fields.Count field(s)) — click to edit</title>
                    </path>
                }
                @if (Vm.ConnectJob is not null || Vm.ConnectChain is not null)
                {
                    <path d="@Vm.ConnectPath()" fill="none" stroke="var(--human)" stroke-width="1.6" stroke-dasharray="5 4" marker-end="url(#pcarrow)" />
                }
            </svg>

            @foreach (var job in Vm.Jobs ?? Array.Empty<JobView>())
            {
                var j = job;
                var key = "job:" + j.Id;
                var mapped = Vm.Mappings?.Any(m => m.JobId == j.Id) ?? false;
                <div style="position:absolute; left:@(Vm.GetPos(key).X + Vm.PanX)px; top:@(Vm.GetPos(key).Y + Vm.PanY)px; width:190px; border:1px @(mapped ? "solid var(--border-2)" : "dashed var(--border-2)"); border-radius:9px; padding:8px 10px; background:var(--card-2); cursor:grab; box-shadow:var(--shadow)"
                     @onpointerdown="@(e => StartDrag(key, e))" @onpointerdown:stopPropagation="true">
                    <div style="display:flex; align-items:center; gap:7px">
                        <span style="width:7px; height:7px; border-radius:50%; flex:none; background:@(mapped ? "var(--brand-2)" : "var(--border-2)")"></span>
                        <span style="flex:1; min-width:0; font-size:12px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis" title="@j.Name">@j.Name</span>
                        <span title="Drag onto a table to map this job's output into it"
                              style="flex:none; width:18px; height:18px; border-radius:50%; background:var(--brand); color:var(--brand-fg,#07130b); display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; cursor:crosshair"
                              @onpointerdown="@(e => StartConnect(j, e))" @onpointerdown:stopPropagation="true">＋</span>
                    </div>
                    <div style="font-size:10px; color:var(--text-3); margin-top:3px; display:flex; justify-content:space-between">
                        <span>@(mapped ? "mapped" : "unmapped — drag ＋")</span>
                        <span style="font-family:var(--font-sans); color:var(--brand-2)">@j.ReturnType</span>
                    </div>
                </div>
            }

            @foreach (var chain in Vm.Chains ?? Array.Empty<JobChainView>())
            {
                var c = chain;
                var key = "chain:" + c.Id;
                var mapped = Vm.Mappings?.Any(m => m.SourceKind == "chain" && m.JobId == c.Id) ?? false;
                <div style="position:absolute; left:@(Vm.GetPos(key).X + Vm.PanX)px; top:@(Vm.GetPos(key).Y + Vm.PanY)px; width:190px; border:1px @(mapped ? "solid var(--human)" : "dashed var(--human)"); border-radius:9px; padding:8px 10px; background:var(--human-bg); cursor:grab; box-shadow:var(--shadow)"
                     @onpointerdown="@(e => StartDrag(key, e))" @onpointerdown:stopPropagation="true">
                    <div style="display:flex; align-items:center; gap:7px">
                        <span style="width:7px; height:7px; border-radius:50%; flex:none; background:var(--human)"></span>
                        <span style="flex:1; min-width:0; font-size:12px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis" title="@c.Name">@c.Name</span>
                        <span title="Drag onto a table to map this chain's final output into it"
                              style="flex:none; width:18px; height:18px; border-radius:50%; background:var(--human); color:#fff; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:700; cursor:crosshair"
                              @onpointerdown="@(e => StartConnectChain(c, e))" @onpointerdown:stopPropagation="true">＋</span>
                    </div>
                    <div style="font-size:10px; color:var(--text-3); margin-top:3px; display:flex; justify-content:space-between">
                        <span>@(mapped ? "mapped" : "unmapped — drag ＋")</span>
                        <span style="font-family:var(--font-sans); color:var(--human)">chain · @c.Steps.Count step(s)</span>
                    </div>
                </div>
            }

            @foreach (var table in Vm.TableNodes())
            {
                var t = table;
                var key = "table:" + t;
                <div style="position:absolute; left:@(Vm.GetPos(key).X + Vm.PanX)px; top:@(Vm.GetPos(key).Y + Vm.PanY)px; width:210px; border:1px solid var(--brand-2); border-radius:10px; padding:9px 12px; background:var(--brand-bg); cursor:grab; box-shadow:var(--shadow)"
                     @onpointerdown="@(e => StartDrag(key, e))" @onpointerdown:stopPropagation="true"
                     @onpointerup="@(() => OnTableUp(t))" @onpointerup:stopPropagation="true">
                    <div style="font-size:12.5px; font-weight:600; font-family:var(--font-sans); white-space:nowrap; overflow:hidden; text-overflow:ellipsis" title="@t">@t</div>
                    <div style="font-size:10px; color:var(--text-3); margin-top:2px">
                        @(Vm.TableRows(t) is { } n ? $"{n:N0} rows" : "created on first ingest") · append-only
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (Vm.ShowEditor)
{
    <div class="dcslide-scrim" @onclick="Vm.CloseEditor"></div>
    <div class="dcslide" style="width:560px">
        <div class="dcslide-head">
            <div style="flex:1">
                <div style="font-size:14px; font-weight:600">@(Vm.EditId.HasValue ? "Edit mapping" : "New mapping")</div>
                <div style="font-size:11.5px; color:var(--text-3); margin-top:3px">Job result → project table, after every completed run.</div>
            </div>
            <button class="dcslide-x" @onclick="Vm.CloseEditor">×</button>
        </div>
        <div class="dcslide-body" style="flex:1; overflow-y:auto; display:flex; flex-direction:column; gap:14px">

            <div class="dcfield">
                <label>
                    Source <span class="req">*</span>
                    <span style="margin-left:8px; display:inline-flex; gap:4px">
                        @foreach (var kind in new[] { "job", "chain" })
                        {
                            <button type="button" class="dcbtn" style="padding:1px 8px; font-size:10.5px; @(Vm.EdSourceKind == kind ? "color:var(--brand-2); border-color:var(--brand-2)" : "")"
                                    @onclick="@(() => { Vm.EdSourceKind = kind; Vm.EdJobId = Guid.Empty; })">@kind</button>
                        }
                    </span>
                </label>
                @if (Vm.EdSourceKind == "chain")
                {
                    <select class="dcinput" @bind="Vm.EdJobId">
                        <option value="@Guid.Empty">— pick a chain (its final output ingests) —</option>
                        @foreach (var c in Vm.Chains ?? Array.Empty<JobChainView>())
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                }
                else
                {
                <select class="dcinput" @bind="Vm.EdJobId">
                    <option value="@Guid.Empty">— pick a job —</option>
                    @foreach (var j in Vm.Jobs ?? Array.Empty<JobView>())
                    {
                        <option value="@j.Id">@j.Name (@j.ReturnType)</option>
                    }
                </select>
                }
            </div>

            <div style="display:flex; gap:10px">
                <div class="dcfield" style="flex:1">
                    <label>Target table <span class="req">*</span></label>
                    <input class="dcinput" @bind="Vm.EdTable" list="pc-datamap-tables" placeholder="listings" />
                    <datalist id="pc-datamap-tables">
                        @foreach (var t in Vm.Tables ?? Array.Empty<PlaceContext.Application.Ports.ProjectTableInfo>())
                        {
                            <option value="@t.Name" />
                        }
                    </datalist>
                </div>
                <div class="dcfield" style="flex:1">
                    <label>Records at <span class="code" style="margin-left:5px">dot path, blank = root</span></label>
                    <input class="dcinput" @bind="Vm.EdRowsPath" placeholder="rows" />
                </div>
            </div>

            <div class="dcfield">
                <div style="display:flex; align-items:center; justify-content:space-between">
                    <label>Fields</label>
                    <div style="display:flex; gap:6px">
                        <button class="dcbtn" style="padding:3px 9px; font-size:11px" @onclick="() => Vm.SuggestFieldsAsync()"
                                disabled="@(Vm.EdJobId == Guid.Empty || Vm.EdSourceKind == "chain")" title="Prefill from the job's latest run result (jobs only)">
                            @(Vm.Suggesting ? "Reading last run…" : "Suggest from last run")
                        </button>
                        <button class="dcbtn" style="padding:3px 9px; font-size:11px" @onclick="() => Vm.AddField()">+ field</button>
                    </div>
                </div>
                <div style="display:flex; flex-direction:column; gap:6px; margin-top:6px">
                    @for (var i = 0; i < Vm.EdFields.Count; i++)
                    {
                        var idx = i;
                        <div style="display:flex; gap:6px; align-items:center">
                            <input class="dcinput" style="flex:1.2; font-size:12px" placeholder="source path (e.g. price)"
                                   @bind="Vm.EdFields[idx].SourcePath" />
                            <span style="color:var(--text-3); flex:none">→</span>
                            <input class="dcinput" style="flex:1; font-size:12px; font-family:var(--font-sans)" placeholder="column"
                                   @bind="Vm.EdFields[idx].Column" />
                            <select class="dcinput" style="flex:none; width:110px; font-size:12px" @bind="Vm.EdFields[idx].Type">
                                @foreach (var t in DataMapViewModel.ColumnTypes)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                            <button class="dcbtn" style="padding:3px 8px; flex:none" title="Remove field" @onclick="@(() => Vm.RemoveField(idx))">×</button>
                        </div>
                    }
                    @if (Vm.EdFields.Count == 0)
                    {
                        <div style="font-size:11.5px; color:var(--text-3)">No fields yet — add one, or suggest them from the job's latest run.</div>
                    }
                </div>
            </div>

            <label style="display:flex; align-items:center; gap:8px; font-size:12.5px; color:var(--text-2); cursor:pointer; user-select:none">
                <input type="checkbox" @bind="Vm.EdEnabled" style="width:15px; height:15px; accent-color:var(--brand-2); cursor:pointer" />
                Enabled — ingest after every completed run
            </label>

            <div class="dchint">
                The table is created on first ingest as an append-only system table with
                <code>ingested_at</code> and <code>run_id</code> provenance columns, queryable from the Data tab.
            </div>
        </div>
        <div class="dcslide-foot">
            @if (Vm.EditorError is not null)
            {
                <div style="flex:1; color:var(--bad); font-size:12px; min-width:0">@Vm.EditorError</div>
            }
            @if (Vm.EditId.HasValue)
            {
                <button class="dcbtn" style="color:var(--bad)" disabled="@Vm.Saving" @onclick="() => Vm.DeleteMappingAsync()">Delete</button>
            }
            <button class="dcbtn" @onclick="Vm.CloseEditor">Cancel</button>
            <button class="dcbtn primary" disabled="@Vm.Saving" @onclick="() => Vm.SaveMappingAsync()">
                @(Vm.Saving ? "Saving…" : Vm.EditId.HasValue ? "Save changes" : "Create mapping")
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        Vm.Initialize(ProjectId);
        await Vm.LoadAsync();
        Ui.Set("Data map", "job results → project tables");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await Vm.EnsureLayoutAsync();
    }

    public void Dispose() => Vm.Detach();

    private void StartDrag(string key, PointerEventArgs e) => Vm.StartDrag(key, e.ClientX, e.ClientY);
    private void OnCanvasDown(PointerEventArgs e) => Vm.OnCanvasDown(e.ClientX, e.ClientY);
    private void StartConnect(JobView job, PointerEventArgs e) => Vm.StartConnect(job, e.ClientX, e.ClientY);
    private void StartConnectChain(JobChainView chain, PointerEventArgs e) => Vm.StartConnectChain(chain, e.ClientX, e.ClientY);
    private void OnCanvasMove(PointerEventArgs e) => Vm.OnCanvasMove(e.ClientX, e.ClientY);
    private async Task OnCanvasUp() => await Vm.OnCanvasUpAsync();
    private async Task OnTableUp(string table) => await Vm.OnTableUpAsync(table);
}
