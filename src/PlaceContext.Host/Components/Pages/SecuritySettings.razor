@page "/settings/security"
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@attribute [Authorize]
@inject HttpClient Http
@inject PortalUiState Ui

<PageTitle>placecontext — Security</PageTitle>

<div class="page">
    <h2 class="page-title">Security</h2>
    <div class="page-sub">
        Email two-factor authentication adds a second layer of security after your password.
        Verification codes are delivered by the transactional Postmark provider.
    </div>

    @if (_loading)
    {
        <div class="dccard"><p class="note-11">Loading…</p></div>
    }
    else if (_error is not null)
    {
        <div class="dccard"><p class="err-text">@_error</p></div>
    }
    else if (_enabled)
    {
        <div class="dccard">
            <div class="card-title">Email two-factor authentication is enabled</div>
            <p class="note-11" style="margin:6px 0 14px">
                After a valid password, PlaceContext sends a single-use 6-digit code through Postmark.
            </p>
            @if (_showDisable)
            {
                <div class="field-group">
                    <label class="field-label">Code sent to @_codeSentTo</label>
                    <input class="dcinput" @bind="_disableCode" placeholder="000000" maxlength="6"
                           inputmode="numeric" autocomplete="one-time-code" style="max-width:180px" />
                    <button class="dcbtn" style="color:var(--bad);border-color:var(--bad);margin-top:8px"
                            disabled="@(_busy || string.IsNullOrWhiteSpace(_disableCode))"
                            @onclick="DisableAsync">@(_busy ? "Disabling…" : "Confirm and disable")</button>
                    @if (_msg is not null)
                    {
                        <div class="note-11" style="color:var(--bad);margin-top:6px">@_msg</div>
                    }
                </div>
            }
            else
            {
                <button class="dcbtn" disabled="@_busy" @onclick="StartDisableAsync">
                    @(_busy ? "Sending code…" : "Disable 2FA")
                </button>
                @if (_msg is not null)
                {
                    <div class="note-11" style="color:var(--bad);margin-top:6px">@_msg</div>
                }
            }
        </div>
    }
    else
    {
        <div class="dccard">
            <div class="card-title">Enable email two-factor authentication</div>
            <p class="note-11" style="margin:6px 0 14px">
                Postmark must be connected in Settings → Communications. We will send a code to your account email to confirm delivery.
            </p>
            @if (!_setupStarted)
            {
                <button class="dcbtn primary" disabled="@_busy" @onclick="StartSetupAsync">
                    @(_busy ? "Sending code…" : "Send verification code")
                </button>
            }
            else
            {
                <div class="field-group">
                    <label class="field-label">Code sent to @_codeSentTo</label>
                    <input class="dcinput" @bind="_confirmCode" placeholder="000000" maxlength="6"
                           inputmode="numeric" autocomplete="one-time-code" style="max-width:180px" />
                    <button class="dcbtn primary" style="margin-top:8px"
                            disabled="@(_busy || string.IsNullOrWhiteSpace(_confirmCode))"
                            @onclick="ConfirmAsync">
                        @(_busy ? "Verifying…" : "Confirm and enable")
                    </button>
                    @if (_confirmError is not null)
                    {
                        <div class="note-11" style="color:var(--bad);margin-top:6px">@_confirmError</div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private bool _loading = true;
    private bool _busy;
    private bool _enabled;
    private string? _error;
    private bool _setupStarted;
    private string? _confirmCode;
    private string? _confirmError;
    private bool _showDisable;
    private string? _disableCode;
    private string? _codeSentTo;
    private string? _msg;

    protected override async Task OnInitializedAsync()
    {
        Ui.Set("Settings", "Security");
        try
        {
            var response = await Http.GetAsync("/api/2fa/status");
            response.EnsureSuccessStatusCode();
            _enabled = (await response.Content.ReadFromJsonAsync<TwoFactorStatus>())?.Enabled ?? false;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task StartSetupAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var response = await Http.PostAsync("/api/2fa/setup", null);
            if (!response.IsSuccessStatusCode)
            {
                _error = (await response.Content.ReadFromJsonAsync<ErrorResponse>())?.Error ?? "Could not send the code.";
                return;
            }
            var result = await response.Content.ReadFromJsonAsync<ChallengeResponse>();
            _codeSentTo = result?.Email;
            _setupStarted = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ConfirmAsync()
    {
        _busy = true;
        _confirmError = null;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/2fa/confirm", new { Code = _confirmCode });
            if (!response.IsSuccessStatusCode)
            {
                _confirmError = (await response.Content.ReadFromJsonAsync<ErrorResponse>())?.Error ?? "Invalid code.";
                return;
            }
            _enabled = true;
            _setupStarted = false;
        }
        catch (Exception ex) { _confirmError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task StartDisableAsync()
    {
        _busy = true;
        _msg = null;
        try
        {
            var response = await Http.PostAsync("/api/2fa/code", null);
            if (!response.IsSuccessStatusCode)
            {
                _msg = (await response.Content.ReadFromJsonAsync<ErrorResponse>())?.Error ?? "Could not send the code.";
                return;
            }
            var result = await response.Content.ReadFromJsonAsync<ChallengeResponse>();
            _codeSentTo = result?.Email;
            _showDisable = true;
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DisableAsync()
    {
        _busy = true;
        _msg = null;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/2fa/disable", new { Code = _disableCode });
            if (!response.IsSuccessStatusCode)
            {
                _msg = (await response.Content.ReadFromJsonAsync<ErrorResponse>())?.Error ?? "Invalid code.";
                return;
            }
            _enabled = false;
            _showDisable = false;
            _disableCode = null;
        }
        catch (Exception ex) { _msg = ex.Message; }
        finally { _busy = false; }
    }

    private sealed class TwoFactorStatus { public bool Enabled { get; set; } }
    private sealed class ChallengeResponse { public string? Email { get; set; } }
    private sealed class ErrorResponse { public string? Error { get; set; } }
}
