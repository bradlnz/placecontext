@page "/settings/security"
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@attribute [Authorize]
@inject HttpClient Http
@inject PortalUiState Ui

<PageTitle>placecontext — Security</PageTitle>

<div class="page">
    <h2 class="page-title">Security</h2>
    <div class="page-sub">
        Two-factor authentication is managed workspace-wide in Settings → Communications: flag an
        email or SMS provider for 2FA and every member is asked for a verification code after their
        password. Here you choose how your own codes reach you.
    </div>

    @if (_loading)
    {
        <div class="dccard"><p class="note-11">Loading…</p></div>
    }
    else if (_error is not null)
    {
        <div class="dccard"><p class="err-text">@_error</p></div>
    }
    else
    {
        <div class="dccard">
            <div class="card-title">
                @( _required
                    ? "Two-factor authentication is on for everyone"
                    : "Two-factor authentication is off" )
            </div>
            <p class="note-11" style="margin:6px 0 0">
                @( _required
                    ? "After a valid password, PlaceContext sends you a single-use 6-digit verification code."
                    : "No provider is flagged for 2FA, so sign-in only needs a password. An owner can flag one in Settings → Communications." )
            </p>
        </div>

        <div class="dccard">
            <div class="card-title">Your phone number</div>
            <p class="note-11" style="margin:6px 0 14px">
                Used for verification codes delivered by SMS. E.164 format, e.g. +15551234567.
            </p>
            <div class="field-group">
                <input class="dcinput" @bind="_phone" placeholder="+15551234567" autocomplete="tel"
                       style="max-width:240px" />
                <div style="display:flex;gap:8px;margin-top:8px">
                    <button class="dcbtn primary" disabled="@_busyPhone" @onclick="SavePhoneAsync">
                        @(_busyPhone ? "Saving…" : "Save number")
                    </button>
                    @if (!string.IsNullOrEmpty(_savedPhone))
                    {
                        <button class="dcbtn" disabled="@_busyPhone" @onclick="ClearPhoneAsync">Remove</button>
                    }
                </div>
                @if (_phoneMsg is not null)
                {
                    <div class="note-11" style="color:@(_phoneOk ? "var(--ok,#7bd88f)" : "var(--bad)");margin-top:6px">@_phoneMsg</div>
                }
            </div>
        </div>

        @if (_emailAvailable && _smsAvailable)
        {
            <div class="dccard">
                <div class="card-title">Preferred code delivery</div>
                <p class="note-11" style="margin:6px 0 14px">
                    Both email and SMS providers are flagged for 2FA — pick where your codes go.
                    SMS delivery uses the phone number above.
                </p>
                <div class="field-group">
                    <select class="dcinput" @bind="_channel" style="max-width:240px">
                        <option value="email">Email</option>
                        <option value="sms">SMS</option>
                    </select>
                    <button class="dcbtn primary" style="margin-top:8px"
                            disabled="@(_busyChannel || (_channel != "email" && _channel != "sms"))"
                            @onclick="SaveChannelAsync">
                        @(_busyChannel ? "Saving…" : "Save preference")
                    </button>
                    @if (_channelMsg is not null)
                    {
                        <div class="note-11" style="color:@(_channelOk ? "var(--ok,#7bd88f)" : "var(--bad)");margin-top:6px">@_channelMsg</div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private bool _loading = true;
    private string? _error;

    private bool _required;
    private bool _emailAvailable;
    private bool _smsAvailable;

    private string? _phone;
    private string? _savedPhone;
    private bool _busyPhone;
    private string? _phoneMsg;
    private bool _phoneOk;

    private string? _channel;
    private bool _busyChannel;
    private string? _channelMsg;
    private bool _channelOk;

    protected override async Task OnInitializedAsync()
    {
        Ui.Set("Settings", "Security");
        try
        {
            var response = await Http.GetAsync("/api/2fa/status");
            response.EnsureSuccessStatusCode();
            var status = await response.Content.ReadFromJsonAsync<TwoFactorStatus>();
            _required = status?.Required ?? false;
            _emailAvailable = status?.EmailAvailable ?? false;
            _smsAvailable = status?.SmsAvailable ?? false;
            _phone = status?.PhoneNumber;
            _savedPhone = status?.PhoneNumber;
            _channel = status?.Channel ?? "email";
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }

    private async Task SavePhoneAsync()
    {
        _busyPhone = true;
        _phoneMsg = null;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/2fa/phone", new { PhoneNumber = _phone });
            if (!response.IsSuccessStatusCode)
            {
                _phoneOk = false;
                _phoneMsg = (await response.Content.ReadFromJsonAsync<ErrorResponse>())?.Error
                    ?? "Could not save the number.";
                return;
            }
            _savedPhone = string.IsNullOrWhiteSpace(_phone) ? null : _phone!.Trim();
            _phoneOk = true;
            _phoneMsg = _savedPhone is null ? "Number removed." : "Number saved — SMS is now your preferred channel.";
            if (_savedPhone is not null) _channel = "sms";
        }
        catch (Exception ex) { _phoneOk = false; _phoneMsg = ex.Message; }
        finally { _busyPhone = false; }
    }

    private Task ClearPhoneAsync()
    {
        _phone = "";
        return SavePhoneAsync();
    }

    private async Task SaveChannelAsync()
    {
        _busyChannel = true;
        _channelMsg = null;
        try
        {
            var response = await Http.PostAsJsonAsync("/api/2fa/channel", new { Channel = _channel });
            if (!response.IsSuccessStatusCode)
            {
                _channelOk = false;
                _channelMsg = (await response.Content.ReadFromJsonAsync<ErrorResponse>())?.Error
                    ?? "Could not save the preference.";
                return;
            }
            _channelOk = true;
            _channelMsg = "Preference saved.";
        }
        catch (Exception ex) { _channelOk = false; _channelMsg = ex.Message; }
        finally { _busyChannel = false; }
    }

    private sealed class TwoFactorStatus
    {
        public bool Required { get; set; }
        public string? Channel { get; set; }
        public string? PhoneNumber { get; set; }
        public bool EmailAvailable { get; set; }
        public bool SmsAvailable { get; set; }
    }
    private sealed class ErrorResponse { public string? Error { get; set; } }
}
