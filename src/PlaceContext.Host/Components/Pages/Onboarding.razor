@using PlaceContext.Application.Access.Models
@page "/onboarding"
@attribute [Authorize(Policy = Permission.SettingsManage)]
@inject OnboardingViewModel Vm
@implements IDisposable

<PageTitle>PlaceContext — Cluster setup</PageTitle>

<main class="setup-guide">
    <header class="guide-head">
        <div class="guide-kicker">WORKSPACE SETUP</div>
        <h1>Choose where your jobs run</h1>
        <p>Set up cloud or local workers, check your cluster, then run your first job.</p>
    </header>

    <ol class="guide-steps" aria-label="Setup progress">
        <li class="@(Vm.Step == SetupGuideStep.Location ? "active" : "done")"><span>1</span>Execution location</li>
        <li class="@(Vm.Step == SetupGuideStep.Cluster ? "active" : null)"><span>2</span>Cluster setup</li>
    </ol>

    @if (Vm.Step == SetupGuideStep.Location)
    {
        <section class="dccard guide-card">
            <div class="guide-section-head">
                <div>
                    <h2>Cloud or local?</h2>
                    <p>Choose a setup path for the machines that execute your jobs. The portal can be hosted separately.</p>
                </div>
            </div>
            <div class="choice-list">
                <button type="button" class="choice-row @(Vm.IsCloud ? "selected" : null)"
                        aria-pressed="@Vm.IsCloud" @onclick="() => Vm.SelectLocation(ExecutionLocation.Cloud)">
                    <span class="choice-radio" aria-hidden="true"></span>
                    <span><strong>Cloud</strong><small>Use managed execution or workers deployed on your cloud infrastructure.</small></span>
                </button>
                <button type="button" class="choice-row @(Vm.IsLocal ? "selected" : null)"
                        aria-pressed="@Vm.IsLocal" @onclick="() => Vm.SelectLocation(ExecutionLocation.Local)">
                    <span class="choice-radio" aria-hidden="true"></span>
                    <span><strong>Local</strong><small>Run jobs on your own computers, servers or on-premises virtual machines.</small></span>
                </button>
            </div>
            <div class="guide-actions">
                <button class="dcbtn quiet" @onclick="Vm.SkipGuide">Set up later</button>
                <button class="dcbtn primary" disabled="@(!Vm.CanContinue)" @onclick="Vm.Continue">Continue</button>
            </div>
        </section>
    }
    @if (Vm.Step == SetupGuideStep.Cluster)
    {
        <section class="dccard guide-card">
            <div class="guide-section-head"><div><h2>@Vm.LocationLabel execution</h2>
                <p>Connect the workers that will run your jobs and verify they are ready.</p></div></div>
            @if (Vm.Loading)
            {
                <Skeleton Kind="list" Rows="2" />
            }
            @if (Vm.Error is not null)
            {
                <div class="guide-notice" role="alert">@Vm.Error</div>
            }
            @if (!Vm.Loading)
            {
                <div class="detected-box"><strong>Current cluster</strong><span>@Vm.ClusterSummary</span></div>
                <button class="dcbtn" @onclick="Vm.LoadAsync">Refresh cluster</button>
            }
            @if (Vm.IsLocal)
            {
                <ol class="setup-checklist">
                    <li>Install a local cluster, or open Cluster and use <strong>Add node</strong> to join your own machines.</li>
                    <li>Configure job placement on those workers. A cloud-hosted portal can still use local workers.</li>
                    <li>Run a small job and confirm its worker, logs and output before adding production workloads.</li>
                </ol>
            }
            @if (Vm.IsCloud)
            {
                <ol class="setup-checklist">
                    <li>Use your managed execution cluster, or deploy cloud workers and join them from <strong>Add node</strong>.</li>
                    <li>Check worker readiness and configure job placement on the intended cloud machines.</li>
                    <li>Run a small job and confirm its worker, logs and output.</li>
                </ol>
            }
            <p class="guide-notice">This guide does not move workloads. Job placement is controlled by the cluster deployment.
                <a href="/wiki/cluster-and-nodes#job-placement">Configure job placement</a></p>
            <div class="guide-links">
                <a class="dcbtn" href="@Vm.SetupUrl">Installation instructions</a>
            </div>
            <div class="guide-actions">
                <button class="dcbtn quiet" @onclick="Vm.Back">Back</button>
                <button class="dcbtn primary" @onclick="Vm.OpenCluster">Open cluster settings</button>
            </div>
        </section>
    }
</main>

@code {
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override Task OnInitializedAsync() => Vm.LoadAsync();
    public void Dispose() => Vm.Detach();
}
