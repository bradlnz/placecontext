@inject CrmViewModel Vm
@using PlaceContext.Host.Components.ViewModels.Crm
@using PlaceContext.Application.Features
@using PlaceContext.Domain.ValueObjects
@using PlaceContext.Infrastructure.Crm
@page "/project/{ProjectId:guid}/crm"
@attribute [Authorize(Policy = Permission.CrmView)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout

<PageTitle>PlaceContext — CRM</PageTitle>

@if (Vm.Loading)
{
    <div class="crm-page">
        <Skeleton Kind="card-grid" Cards="6" />
    </div>
}
else
{
    <div class="crm-page">
        <div class="crm-header">
            <div class="crm-header-copy">
                <div class="crm-eyebrow">
                    <span class="eyebrow-mark">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                            <circle cx="9" cy="7" r="4"></circle>
                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                        </svg>
                    </span>
                    Customer operations
                </div>
                <h2>@Vm.CurrentSectionPresentation.Title</h2>
                <p>@Vm.CurrentSectionPresentation.Description</p>
            </div>
            @if (Vm.HasPrimaryAction)
            {
            <button class="dcbtn primary add-client-btn"
                    @onclick="Vm.NewPrimary">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 5v14M5 12h14"></path>
                </svg>
                @Vm.PrimaryActionLabel
            </button>
            }
        </div>

        <div class="crm-shell">
            <button type="button" class="crm-nav-toggle"
                    aria-controls="crm-sections" aria-expanded="@Vm.CrmNavOpen"
                    @onclick="Vm.ToggleCrmNavigation">
                <span>Customer operations</span>
                <span class="crm-nav-current">@Vm.CurrentSectionPresentation.Title</span>
                <span aria-hidden="true"><CrmIcon Name="@(Vm.CrmNavOpen ? "chevron-up" : "chevron-down")" /></span>
            </button>

            <nav id="crm-sections"
                 class="@($"crm-section-nav {(Vm.CrmNavOpen ? "open" : string.Empty)}")"
                 aria-label="CRM sections" role="tablist">
                <div class="crm-nav-head">Customer operations</div>
            <button class="@(Vm.CurrentSection == CrmSection.Conversations ? "active" : "")"
                        role="tab" aria-selected="@(Vm.CurrentSection == CrmSection.Conversations)"
                        @onclick="@(() => Vm.OpenCrmSection(CrmSection.Conversations))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M4 5h16v11H8l-4 4z"></path><path d="M8 9h8M8 12h5"></path>
                    </svg>
                    <span>Conversations</span>
                </button>
                <button class="@(Vm.CurrentSection == CrmSection.Calendars ? "active" : "")"
                        role="tab" aria-selected="@(Vm.CurrentSection == CrmSection.Calendars)"
                        @onclick="@(() => Vm.OpenCrmSection(CrmSection.Calendars))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M7 3v4M17 3v4M3 10h18"></path>
                    </svg>
                    <span>Calendars</span>
                </button>
                <button class="@(Vm.CurrentSection == CrmSection.Contacts ? "active" : "")"
                        role="tab" aria-selected="@(Vm.CurrentSection == CrmSection.Contacts)"
                        @onclick="@(() => Vm.OpenCrmSection(CrmSection.Contacts))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="9" cy="7" r="4"></circle><path d="M3 21v-2a6 6 0 0 1 12 0v2M17 8h4M19 6v4"></path>
                    </svg>
                    <span>Contacts</span><small>@Vm.Clients.Count</small>
                </button>
                <button class="@(Vm.CurrentSection == CrmSection.Opportunities ? "active" : "")"
                        role="tab" aria-selected="@(Vm.CurrentSection == CrmSection.Opportunities)"
                        @onclick="@(() => Vm.OpenCrmSection(CrmSection.Opportunities))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M4 19V9M10 19V5M16 19v-7M22 19H2"></path>
                    </svg>
                    <span>Opportunities</span><small>@Vm.Clients.Count</small>
                </button>
                <button class="@(Vm.CurrentSection == CrmSection.Automations ? "active" : "")"
                        role="tab" aria-selected="@(Vm.CurrentSection == CrmSection.Automations)"
                        @onclick="@(() => Vm.OpenCrmSection(CrmSection.Automations))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M8 4h8v5H8zM4 15h6v5H4zM14 15h6v5h-6z"></path>
                        <path d="M12 9v3M7 12h10M7 12v3M17 12v3"></path>
                    </svg>
                    <span>Automations</span><small>@Vm.AutomationRules.Count</small>
                </button>
                <button class="@(Vm.CurrentSection == CrmSection.Portals ? "active" : "")"
                        role="tab" aria-selected="@(Vm.CurrentSection == CrmSection.Portals)"
                        @onclick="@(() => Vm.OpenCrmSection(CrmSection.Portals))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M12 3v4M12 17v4M4 10h16" />
                        <path d="M8 6h8M8 9h8M8 13h8M8 16h8" />
                    </svg>
                    <span>Customer portals</span><small>@Vm.Clients.Count(x => x.CustomerPortalEnabled)</small>
                </button>
                <button class="@(Vm.CurrentSection == CrmSection.Settings ? "active" : "")"
                        role="tab" aria-selected="@(Vm.CurrentSection == CrmSection.Settings)"
                        @onclick="@(() => Vm.OpenCrmSection(CrmSection.Settings))">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.6v-.2h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1z"></path>
                    </svg>
                    <span>Settings</span>
                </button>
            </nav>

            <div class="crm-workspace">
                @if (Vm.CurrentSection is CrmSection.Contacts or CrmSection.Opportunities or CrmSection.Portals)
                {
                    <div class="crm-toolbar">
                        <div class="crm-search">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
                            </svg>
                            <input class="dcinput" @bind="Vm.Search" @bind:event="oninput"
                                   placeholder="Search name, company, email, or phone…" />
                        </div>
                        @if ((Vm.CurrentSection is CrmSection.Contacts or CrmSection.Opportunities) && Vm.StageFilter is not null)
                        {
                            <button class="dcbtn xs clear-filter" @onclick="@(() => Vm.StageFilter = null)">
                                Clear filter <span><CrmIcon Name="close" /></span>
                            </button>
                        }
                        else if (Vm.CurrentSection == CrmSection.Portals && !string.IsNullOrWhiteSpace(Vm.Search))
                        {
                            <button class="dcbtn xs clear-filter" @onclick="@(() => Vm.Search = string.Empty)">
                                Clear search <span><CrmIcon Name="close" /></span>
                            </button>
                        }
                    </div>
                }

        @if (Vm.Message is not null)
        {
            <div class="crm-message">@Vm.Message</div>
        }

        @if (Vm.CurrentSection is CrmSection.Contacts or CrmSection.Opportunities)
        {
        @if (Vm.CurrentSection == CrmSection.Opportunities)
        {
        <section class="dccard lifecycle-panel">
            <div class="lifecycle-head">
                <div>
                    <span class="section-kicker">Lifecycle overview</span>
                    <span class="section-caption">Select a stage to filter the client directory</span>
                </div>
                <span class="total-clients">
                    <strong>@Vm.Clients.Count</strong>
                    total
                </span>
            </div>
            <div class="lifecycle-strip" aria-label="Customer lifecycle">
                @foreach (var stage in CrmViewModel.Stages)
                {
                    var count = Vm.Count(stage);
                    <button class="lifecycle-step @CrmViewModel.StageClass(stage) @(Vm.StageFilter == stage ? "selected" : "")"
                            @onclick="@(() => Vm.ToggleStageFilter(stage))">
                        <span class="stage-dot"></span>
                        <span class="stage-copy">
                            <span class="stage-label">@CrmViewModel.StageLabel(stage)</span>
                            <span class="stage-description">@CrmViewModel.StageDescription(stage)</span>
                        </span>
                        <span class="stage-count">@count</span>
                    </button>
                }
            </div>
        </section>
        }

        <section class="client-directory">
            <div class="directory-head">
                <div>
                    <span class="directory-title">Client directory</span>
                    <span class="directory-subtitle">
                        @if (Vm.StageFilter is { } filteredStage)
                        {
                            <text>Showing @Vm.StageFilterLabel clients</text>
                        }
                        else
                        {
                            <text>All customer relationships in this project</text>
                        }
                    </span>
                </div>
                <span class="result-count">@Vm.FilteredClients.Count() result@(Vm.FilteredClients.Count() == 1 ? "" : "s")</span>
            </div>

            @if (!Vm.FilteredClients.Any())
            {
                <div class="dccard crm-empty">
                    <div class="empty-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                            <circle cx="9" cy="8" r="4"></circle>
                            <path d="M3 21v-2a6 6 0 0 1 12 0v2M17 8h5M19.5 5.5v5"></path>
                        </svg>
                    </div>
                    <strong>@(Vm.Clients.Count == 0 ? "Add your first client" : "No clients match this view")</strong>
                    <span>@(Vm.Clients.Count == 0
                        ? "Build your customer pipeline, track each relationship, and run work in context."
                        : "Try a different search or clear the lifecycle filter.")</span>
                    @if (Vm.Clients.Count == 0)
                    {
                        <button class="dcbtn primary" @onclick="Vm.NewClient">Add a client</button>
                    }
                </div>
            }
            else
            {
                <div class="client-table" role="table" aria-label="Client directory">
                    <div class="client-table-head" role="row">
                        <span role="columnheader">Account</span>
                        <span role="columnheader">Contact</span>
                        <span role="columnheader">Lifecycle</span>
                        <span role="columnheader" class="visually-hidden">Open</span>
                    </div>
                    <div class="client-table-body" role="rowgroup">
                        <Virtualize Items="Vm.FilteredClients" TItem="CrmClientView" Context="client" ItemSize="58" OverscanCount="4">
                            @{ var stage = CrmViewModel.ParseStage(client.LifecycleStage); }
                            <article class="client-row @CrmViewModel.StageClass(stage)" role="row"
                                     @onclick="@(() => Vm.OpenClient(client))">
                            <div class="client-row-identity" role="cell">
                                <span class="client-avatar @CrmViewModel.StageClass(stage)">@CrmViewModel.Initials(client.Name)</span>
                                <button class="client-row-link" @onclick:stopPropagation="true"
                                        @onclick="@(() => Vm.OpenClient(client))">
                                    <strong>@client.Name</strong>
                                    <small>@(client.Company ?? "Individual client")</small>
                                </button>
                            </div>
                            <div class="client-row-contact" role="cell">
                                <span class="client-row-field-label">Contact</span>
                                @if (client.Email is not null)
                                {
                                    <span title="@client.Email">@client.Email</span>
                                }
                                @if (client.Phone is not null)
                                {
                                    <small>@client.Phone</small>
                                }
                                @if (client.Email is null && client.Phone is null)
                                {
                                    <span class="contact-missing">No contact details yet</span>
                                }
                            </div>
                            <div class="client-row-stage" role="cell" @onclick:stopPropagation="true">
                                <span class="client-row-field-label">Lifecycle</span>
                                <span class="stage-dot"></span>
                                <select class="dcinput stage-select"
                                        value="@client.LifecycleStage"
                                        @onchange="@(e => Vm.MoveClient(client, e))"
                                        aria-label="Lifecycle stage for @client.Name">
                                    @foreach (var option in CrmViewModel.Stages)
                                    {
                                        <option value="@Vm.StageOption(option)">@CrmViewModel.StageLabel(option)</option>
                                    }
                                </select>
                            </div>
                            <button class="open-client" @onclick:stopPropagation="true"
                                    @onclick="@(() => Vm.OpenClient(client))" aria-label="Open @client.Name">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9">
                                    <path d="M5 12h14M13 6l6 6-6 6"></path>
                                </svg>
                            </button>
                        </article>
                        </Virtualize>
                    </div>
                </div>
            }
        </section>
        }
        else if (Vm.CurrentSection == CrmSection.Conversations)
        {
            <section class="conversation-inbox dccard">
                <aside class="conversation-sidebar">
                    <div class="conversation-sidebar-head">
                        <strong>Customers</strong><span>@Vm.Clients.Count</span>
                    </div>
                    <label class="conversation-search">
                        <span aria-hidden="true"><CrmIcon Name="search" /></span>
                        <input @bind="Vm.ConversationSearch" @bind:event="oninput" placeholder="Search customers…" />
                    </label>
                @if (Vm.Clients.Count == 0)
                {
                    <div class="conversation-list-empty">Add a contact to start a conversation.</div>
                }
                else
                {
                    <div class="conversation-customer-list">
                        @foreach (var client in Vm.FilteredConversationClients)
                        {
                            <button class="conversation-customer @(Vm.Selected?.Id == client.Id ? "active" : "")"
                                    @key="client.Id"
                                    @onclick="@(() => Vm.OpenConversation(client))">
                                <span class="client-avatar @CrmViewModel.StageClass(CrmViewModel.ParseStage(client.LifecycleStage))">@CrmViewModel.Initials(client.Name)</span>
                                <span class="conversation-customer-copy">
                                    <strong>@client.Name</strong>
                                    <small>@(client.Email ?? client.Phone ?? "No contact details")</small>
                                </span>
                                <span class="conversation-stage-dot @CrmViewModel.StageClass(CrmViewModel.ParseStage(client.LifecycleStage))"></span>
                            </button>
                        }
                    </div>
                }
                </aside>

                <div class="conversation-main">
                    @if (Vm.Selected is null)
                    {
                        <div class="conversation-no-selection">
                            <span class="crm-channel-icon"><CrmIcon Name="mail" /></span>
                            <strong>Select a customer</strong>
                            <span>Choose a customer from the sidebar to open their conversation.</span>
                        </div>
                    }
                    else
                    {
                        <header class="conversation-main-head">
                            <span class="client-avatar @CrmViewModel.StageClass(CrmViewModel.ParseStage(Vm.Selected.LifecycleStage))">@CrmViewModel.Initials(Vm.Selected.Name)</span>
                            <span><strong>@Vm.Selected.Name</strong><small>@(Vm.Selected.Email ?? Vm.Selected.Phone ?? "No contact details")</small></span>
                            <button class="dcbtn xs" @onclick="@(() => Vm.EditClient(Vm.Selected))">Contact details</button>
                        </header>
                        <div class="conversation-thread">
                            @if (Vm.LoadingComms)
                            {
                                <div class="comms-empty">Loading conversation…</div>
                            }
                            else if (Vm.Communications.Count == 0)
                            {
                                <div class="comms-empty">
                                    <span class="comms-empty-icon"><CrmIcon Name="message" /></span>
                                    <strong>Start the conversation</strong>
                                    <span>Add an internal note, or contact @Vm.Selected.Name by email or SMS.</span>
                                </div>
                            }
                            else
                            {
                                <div class="comms-timeline">
                                    @foreach (var item in Vm.Communications.Reverse())
                                    {
                                        <article class="message-row @Vm.ChannelCss(item) @Vm.StatusCss(item)"
                                                 @key="item.Id">
                                            <div class="message-bubble">
                                                <div class="message-meta">
                                                    <span class="channel-mark"><CrmIcon Name="@Vm.ChannelIcon(item)" /></span>
                                                    <strong>@Vm.ChannelLabel(item)</strong>
                                                    @if (Vm.IsFailed(item)) { <span class="delivery-state failed">Failed</span> }
                                                    else if (Vm.IsSent(item)) { <span class="delivery-state">Sent</span> }
                                                </div>
                                                @if (item.Subject is not null) { <div class="message-subject">@item.Subject</div> }
                                                <div class="message-body">@item.Body</div>
                                                @if (item.Error is not null) { <div class="message-error">@item.Error</div> }
                                                <time>@Vm.ArtifactDate(item.CreatedAt)</time>
                                            </div>
                                        </article>
                                    }
                                </div>
                            }
                        </div>
                        <div class="conversation-composer">
                            <div class="channel-picker" role="tablist" aria-label="Communication type">
                                @foreach (var channel in CrmViewModel.CommsChannels)
                                {
                                    <button class="@(Vm.CurrentComposeChannel == channel ? "active" : "")" disabled="@(!Vm.ChannelAvailable(channel))"
                                            title="@Vm.ChannelHelp(channel)" @onclick="@(() => Vm.SelectChannel(channel))">
                                        <span><CrmIcon Name="@CrmViewModel.ChannelIconName(channel)" /></span>@CrmViewModel.ChannelLabel(channel)
                                    </button>
                                }
                            </div>
                            @if (Vm.IsEmailComposer)
                            {
                                <input class="dcinput composer-subject" @bind="Vm.ComposeSubject" placeholder="Email subject" />
                            }
                            <textarea class="dcinput composer-body" rows="3" @bind="Vm.ComposeBody"
                                      placeholder="@Vm.ComposerPlaceholder()" aria-label="Message"></textarea>
                            @if (Vm.CommsError is not null) { <div class="form-error">@Vm.CommsError</div> }
                            <div class="composer-foot">
                                <span class="recipient-hint">@Vm.RecipientHint()</span>
                                <button class="dcbtn primary send-comms" disabled="@(!Vm.CanSubmitComms)" @onclick="Vm.SubmitCommunication">
                                    @(Vm.SendingComms ? "Sending…" : Vm.SubmitLabel())
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </section>
        }
        else if (Vm.CurrentSection == CrmSection.Calendars)
        {
            <section class="crm-channel-workspace">
                @if (Vm.OpenCalendarId is null)
                {
                    <div class="crm-calendar-head dccard">
                        <div><span class="section-kicker">Calendar catalogue</span><strong>@(Vm.Calendars.Count + 1) calendar@(Vm.Calendars.Count == 0 ? "" : "s")</strong></div>
                        <button class="dcbtn primary" @onclick="@(() => Vm.OpenCalendarEditor())"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg>New calendar</button>
                    </div>
                    <div class="dccard calendar-catalogue">
                        <button class="calendar-catalogue-row" @onclick="@(() => Vm.OpenCalendar(Guid.Empty))">
                            <span class="calendar-swatch" style="background:#4f7cff"></span>
                            <span><strong>General</strong><small>Default CRM calendar · @Vm.Appointments.Count(x => x.CalendarId is null) event@(Vm.Appointments.Count(x => x.CalendarId is null) == 1 ? "" : "s")</small></span>
                            <CrmIcon Name="arrow-right" />
                        </button>
                        @foreach (var calendar in Vm.Calendars)
                        {
                            <div class="calendar-catalogue-row" role="button" tabindex="0" @onclick="@(() => Vm.OpenCalendar(calendar.Id))">
                                <span class="calendar-swatch" style="background:@calendar.Color"></span>
                                <span><strong>@calendar.Name</strong><small>@Vm.Appointments.Count(x => x.CalendarId == calendar.Id) event@(Vm.Appointments.Count(x => x.CalendarId == calendar.Id) == 1 ? "" : "s")</small></span>
                                <span class="calendar-row-actions">
                                    <button class="icon-action" title="Edit calendar" @onclick:stopPropagation="true" @onclick="@(() => Vm.OpenCalendarEditor(calendar))"><CrmIcon Name="edit" /></button>
                                    <button class="icon-action danger" title="Delete calendar" @onclick:stopPropagation="true" @onclick="@(() => Vm.DeleteCalendar(calendar.Id))"><CrmIcon Name="trash" /></button>
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="crm-calendar-head dccard calendar-view-head">
                        <button class="dcbtn" @onclick="Vm.CloseCalendar"><CrmIcon Name="arrow-left" />Calendars</button>
                        <div><span class="section-kicker">@Vm.OpenCalendarName</span><strong>@Vm.CalendarMonthLabel</strong></div>
                        <div class="calendar-head-actions">
                            <button class="icon-action" title="Previous month" @onclick="@(() => Vm.ChangeCalendarMonth(-1))"><CrmIcon Name="chevron-left" /></button>
                            <button class="dcbtn xs" @onclick="Vm.GoToCurrentMonth">Today</button>
                            <button class="icon-action" title="Next month" @onclick="@(() => Vm.ChangeCalendarMonth(1))"><CrmIcon Name="chevron-right" /></button>
                            <button class="dcbtn primary" @onclick="@(() => Vm.OpenAppointmentEditor())"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"></path></svg>Add event</button>
                        </div>
                    </div>
                    <div class="dccard calendar-month">
                        <div class="calendar-weekdays">@foreach (var dayName in CrmViewModel.CalendarWeekdays) { <span>@dayName</span> }</div>
                        <div class="calendar-grid">
                            @foreach (var day in Vm.CalendarDays)
                            {
                                var events = Vm.AppointmentsFor(day);
                                <div class="calendar-day @(day.Month != Vm.CalendarMonth.Month ? "outside" : "") @(day == DateOnly.FromDateTime(DateTime.Now) ? "today" : "")" @ondblclick="@(() => Vm.OpenAppointmentEditor(day))">
                                    <span class="calendar-day-number">@day.Day</span>
                                    <div class="calendar-day-events">
                                        @foreach (var appointment in events.Take(3))
                                        {
                                            <button class="calendar-event" style="--event-color:@Vm.OpenCalendarColor" @onclick="@(() => Vm.OpenAppointmentEditor(appointment))">
                                                <time>@Vm.AppointmentTime(appointment.StartsAt)</time><span>@appointment.Title</span>
                                            </button>
                                        }
                                        @if (events.Count > 3) { <small>+@(events.Count - 3) more</small> }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </section>
        }
        else if (Vm.CurrentSection == CrmSection.Automations)
        {
            <section class="automations-workspace">
                <div class="automation-overview dccard">
                    <div class="automation-overview-copy">
                        <span class="automation-mark">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                <path d="M12 3v4M12 17v4M3 12h4M17 12h4"></path>
                                <circle cx="12" cy="12" r="5"></circle><circle cx="12" cy="12" r="1.5"></circle>
                            </svg>
                        </span>
                        <span>
                            <strong>CRM workflow rules</strong>
                            <small>When a CRM event matches, its job chain is queued with client context or the ingestion payload.</small>
                        </span>
                    </div>
                    <div class="automation-stats">
                        <span><strong>@Vm.AutomationRules.Count(rule => rule.Enabled)</strong> active</span>
                        <span><strong>@Vm.AutomationRules.Select(rule => rule.EventType).Distinct().Count()</strong> events</span>
                        <span><strong>@Vm.Chains.Count</strong> chains</span>
                    </div>
                </div>

                @if (Vm.AutomationRules.Count == 0)
                {
                    <div class="dccard automation-empty">
                        <span class="automation-empty-icon"><CrmIcon Name="workflow" /></span>
                        <strong>Turn CRM events into workflows</strong>
                        <span>Run a job chain from client lifecycle events or any JSON submitted to the CRM ingestion endpoint.</span>
                        <button class="dcbtn primary" @onclick="Vm.NewAutomation">Create automation</button>
                    </div>
                }
                else
                {
                    <div class="automation-list-head">
                        <div>
                            <strong>Rules</strong>
                            <span>@Vm.AutomationRules.Count workflow@(Vm.AutomationRules.Count == 1 ? "" : "s") configured</span>
                        </div>
                        <button class="dcbtn primary" @onclick="Vm.NewAutomation">Add automation</button>
                    </div>
                    <div class="automation-rule-grid">
                        @foreach (var rule in Vm.AutomationRules)
                        {
                            <article class="dccard automation-rule-card @(!rule.Enabled ? "disabled" : "")">
                                <div class="automation-card-head">
                                    <span class="automation-event-icon"><CrmIcon Name="@CrmViewModel.AutomationEventIconName(rule.EventType)" /></span>
                                    <span class="automation-card-title">
                                        <strong>@rule.Name</strong>
                                        <small>Updated @Vm.UpdatedDate(rule.UpdatedAt)</small>
                                    </span>
                                    <button class="rule-toggle @(rule.Enabled ? "on" : "")"
                                            title="@(rule.Enabled ? "Disable automation" : "Enable automation")"
                                            @onclick="@(() => Vm.ToggleAutomation(rule))">
                                        <span></span>
                                    </button>
                                </div>
                                <div class="automation-flow">
                                    <span class="flow-node event">
                                        <small>When</small>
                                        <strong>@CrmViewModel.AutomationEventLabel(rule.EventType)</strong>
                                        <em>@(rule.EventType == nameof(CrmAutomationEventType.IngestionReceived) ? "Raw JSON payload" : CrmViewModel.AutomationStageLabel(rule.LifecycleStage))</em>
                                    </span>
                                    <span class="flow-arrow">
                                        <span></span>
                                        <svg viewBox="0 0 20 10"><path d="M1 5h16M13 1l4 4-4 4"></path></svg>
                                    </span>
                                    <span class="flow-node chain">
                                        <small>Run chain</small>
                                        <strong>@rule.ChainName</strong>
                                        <em>@rule.ChainSteps step@(rule.ChainSteps == 1 ? "" : "s")</em>
                                    </span>
                                </div>
                                <div class="automation-card-foot">
                                    <span class="rule-status @(rule.Enabled ? "active" : "")">
                                        <span></span>@(rule.Enabled ? "Listening" : "Paused")
                                    </span>
                                    <div>
                                        <button class="rule-action" @onclick="@(() => Vm.EditAutomation(rule))">Edit</button>
                                        @if (Vm.ConfirmAutomationDeleteId == rule.Id)
                                        {
                                            <button class="rule-action delete confirm"
                                                    @onclick="@(() => Vm.DeleteAutomation(rule))">Confirm delete</button>
                                            <button class="rule-action"
                                                    @onclick="@(() => Vm.ConfirmAutomationDeleteId = null)">Keep</button>
                                        }
                                        else
                                        {
                                            <button class="rule-action delete"
                                                    @onclick="@(() => Vm.ConfirmAutomationDeleteId = rule.Id)">Delete</button>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        }
        else if (Vm.CurrentSection == CrmSection.Portals)
        {
            <section class="crm-portals">
                <div class="crm-portals-head">
                    <div>
                        <span class="section-kicker">Portal access</span>
                        <strong>@Vm.Clients.Count(c => c.CustomerPortalEnabled) of @Vm.Clients.Count portal@(Vm.Clients.Count == 1 ? "" : "s") configured</strong>
                    </div>
                </div>

                @if (Vm.Clients.Count == 0)
                {
                    <div class="dccard crm-empty">
                        <div class="empty-icon">
                            <CrmIcon Name="globe" />
                        </div>
                        <strong>No clients yet</strong>
                        <span>Add clients first, then provision customer portals from this tab.</span>
                        <button class="dcbtn primary" @onclick="Vm.NewClient">Add a client</button>
                    </div>
                }
                else if (!Vm.PortalClients.Any())
                {
                    <div class="dccard crm-empty">
                        <strong>No matches</strong>
                        <span>No customers match this search in the portals list.</span>
                    </div>
                }
                else
                {
                    <div class="portal-table" role="table" aria-label="Customer portal directory">
                        <div class="portal-table-head" role="row">
                            <span role="columnheader">Customer</span>
                            <span role="columnheader">Portal</span>
                            <span role="columnheader">Status</span>
                            <span role="columnheader" class="visually-hidden">Actions</span>
                        </div>
                        <div class="portal-table-body" role="rowgroup">
                            <Virtualize Items="Vm.PortalClients.ToList()" TItem="CrmClientView" Context="client" ItemSize="66" OverscanCount="4">
                                @{ var stage = CrmViewModel.ParseStage(client.LifecycleStage); }
                                @{
                                    var portalEnabled = client.CustomerPortalEnabled;
                                    var portalHost = Vm.ClientPortalHost(client);
                                }
                                <article class="portal-row @(portalEnabled ? "portal-row-enabled" : "portal-row-disabled")" role="row">
                                    <div class="portal-row-customer" role="cell">
                                        <span class="client-avatar @CrmViewModel.StageClass(stage)">@CrmViewModel.Initials(client.Name)</span>
                                        <span class="portal-row-copy">
                                            <strong>@client.Name</strong>
                                            <small>@(client.Email ?? client.Phone ?? "No contact details")</small>
                                        </span>
                                    </div>
                                    <div class="portal-row-host" role="cell">
                                        @if (portalEnabled)
                                        {
                                            <a class="portal-host-link" href="@portalHost" target="_blank" rel="noopener noreferrer">
                                                @portalHost
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="portal-host-placeholder">Not provisioned</span>
                                        }
                                    </div>
                                    <div class="portal-row-status" role="cell">
                                        <span class="portal-status-pill @(portalEnabled ? "on" : "off")">
                                            @(portalEnabled ? "Enabled" : "Not enabled")
                                        </span>
                                    </div>
                                    <div class="portal-row-actions" role="cell">
                                        @if (Vm.CanManagePortal)
                                        {
                                            <button class="dcbtn @(portalEnabled ? "" : "primary")" @onclick="@(() => Vm.OpenPortalProvisioningFor(client))">
                                                @if (portalEnabled)
                                                {
                                                    <span><CrmIcon Name="edit" /></span>
                                                    <text>Configure</text>
                                                }
                                                else
                                                {
                                                    <span><CrmIcon Name="globe" /></span>
                                                    <text>Create portal</text>
                                                }
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="field-help">No permission</span>
                                        }
                                    </div>
                                </article>
                            </Virtualize>
                        </div>
                    </div>

                    @if (!Vm.CanManagePortal)
                    {
                        <div class="portal-permission-note">
                            <span class="field-help">The settings.manage permission is required to provision or update customer portals.</span>
                        </div>
                    }
                }
            </section>
        }
        else
        {
            <section class="crm-ingestion-settings">
                <div class="dccard ingestion-card">
                    <div class="ingestion-card-head">
                        <span class="ingestion-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M5 12h14M13 6l6 6-6 6"></path><path d="M4 5v14"></path>
                            </svg>
                        </span>
                        <div>
                            <strong>CRM ingestion API</strong>
                            <span>Accept JSON payloads and pass them into CRM automation job chains using a scoped header token.</span>
                        </div>
                        <span class="ingestion-status @(Vm.IngestionSettings?.Enabled == true ? "enabled" : "")">
                            @(Vm.IngestionSettings?.Enabled == true ? "Enabled" : "Disabled")
                        </span>
                    </div>

                    @if (Vm.LoadingIngestionSettings)
                    {
                        <div class="ingestion-loading">Loading CRM ingestion settings…</div>
                    }
                    else
                    {
                        <div class="ingestion-form-grid">
                            <div class="dcfield">
                                <label>Allowed contact-form origin</label>
                                <input class="dcinput" @bind="Vm.IngestionOrigin" placeholder="https://www.example.com" />
                                <small>Exact HTTPS origin only. Requests from any other browser origin are rejected.</small>
                            </div>
                            <div class="dcfield">
                                <label>Endpoint</label>
                                <div class="ingestion-copy-field">
                                    <code>@Vm.IngestionEndpoint</code>
                                    <button @onclick="() => Vm.CopyAsync(Vm.IngestionEndpoint)">Copy</button>
                                </div>
                            </div>
                        </div>

                        <div class="ingestion-token-row">
                            <span>
                                <small>Header</small>
                                <code>@CrmIngestionSettingsService.TokenHeader</code>
                            </span>
                            <span>
                                <small>Current token</small>
                                <code>@(Vm.IngestionSettings?.TokenPrefix ?? "Not generated")</code>
                            </span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Vm.NewIngestionToken))
                        {
                            <div class="ingestion-token-once">
                                <div><strong>Copy this token now</strong><span>It is shown once and stored only as a hash.</span></div>
                                <div class="ingestion-copy-field secret">
                                    <code>@Vm.NewIngestionToken</code>
                                    <button @onclick="() => Vm.CopyAsync(Vm.NewIngestionToken!)">Copy token</button>
                                </div>
                            </div>
                        }

                        <details class="ingestion-example">
                            <summary>Contact-form request example</summary>
                            <pre>@Vm.IngestionExample()</pre>
                        </details>

                        @if (Vm.IngestionError is not null)
                        {
                            <div class="form-error">@Vm.IngestionError</div>
                        }
                        @if (Vm.IngestionMessage is not null)
                        {
                            <div class="ingestion-message">@Vm.IngestionMessage</div>
                        }

                        <div class="ingestion-actions">
                            <button class="dcbtn" disabled="@Vm.SavingIngestion" @onclick="Vm.SaveIngestionOrigin">
                                @(Vm.SavingIngestion ? "Saving…" : "Save origin")
                            </button>
                            <button class="dcbtn primary" disabled="@Vm.SavingIngestion" @onclick="Vm.RotateIngestionToken">
                                @(Vm.IngestionSettings?.Enabled == true ? "Rotate token" : "Generate token")
                            </button>
                            @if (Vm.IngestionSettings?.Enabled == true)
                            {
                                <button class="dcbtn ingestion-disable" disabled="@Vm.SavingIngestion" @onclick="Vm.DisableIngestion">
                                    Disable endpoint
                                </button>
                            }
                        </div>
                    }
                </div>
                <div class="ingestion-security-note">
                    <strong>Write-only automation input</strong>
                    <span>
                        The token can submit JSON to enabled ingestion automations. Recognized contact-form payloads also create or update Lead records; the token grants no CRM reads or other API access. The configured origin is checked on every request.
                    </span>
                </div>
            </section>
        }
            </div>
        </div>
    </div>
}

@if (Vm.ShowAppointmentEditor)
{
    <div class="dcslide-scrim" @onclick="Vm.CloseAppointmentEditor"></div>
    <div class="dcslide appointment-editor">
        <div class="dcslide-head">
            <div><div class="title-14">@(Vm.EditAppointmentId is null ? "Add event" : "Edit event")</div><div class="subtitle-11-5">Schedule time with a CRM contact.</div></div>
            <button class="dcslide-x" @onclick="Vm.CloseAppointmentEditor" aria-label="Close"><CrmIcon Name="close" /></button>
        </div>
        <div class="dcslide-body appointment-form">
            <div class="dcfield"><label>Title <span class="req">*</span></label><input class="dcinput" @bind="Vm.AppointmentTitle" placeholder="Site consultation" /></div>
            <div class="dcfield">
                <label>Calendar</label>
                <select class="dcinput" @bind="Vm.AppointmentCalendarId">
                    <option value="">General</option>
                    @foreach (var calendar in Vm.Calendars)
                    {
                        <option value="@calendar.Id">@calendar.Name</option>
                    }
                </select>
            </div>
            <div class="dcfield">
                <label>Contact</label>
                <select class="dcinput" @bind="Vm.AppointmentClientId">
                    <option value="">No linked contact</option>
                    @foreach (var client in Vm.Clients.OrderBy(x => x.Name))
                    {
                        <option value="@client.Id">@client.Name</option>
                    }
                </select>
            </div>
            <div class="appointment-times">
                <div class="dcfield"><label>Starts <span class="req">*</span></label><input class="dcinput" type="datetime-local" value="@Vm.AppointmentStartsAt" @onchange="Vm.OnAppointmentStartsChanged" /></div>
                <div class="dcfield"><label>Ends <span class="req">*</span></label><input class="dcinput" type="datetime-local" value="@Vm.AppointmentEndsAt" @onchange="Vm.OnAppointmentEndsChanged" /></div>
            </div>
            <div class="dcfield"><label>Location</label><input class="dcinput" @bind="Vm.AppointmentLocation" placeholder="Office, phone, or video link" /></div>
            <div class="dcfield"><label>Notes</label><textarea class="dcinput" rows="4" @bind="Vm.AppointmentNotes" placeholder="Appointment context…"></textarea></div>
