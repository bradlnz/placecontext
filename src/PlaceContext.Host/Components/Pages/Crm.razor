@if (Vm.ShowAutomationEditor)
{
    <div class="dcslide-scrim" @onclick="Vm.CloseAutomationEditor"></div>
    <div class="dcslide crm-editor automation-editor">
        <div class="dcslide-head">
            <div>
                <div class="title-14">@(Vm.EditAutomationId is null ? "Add automation" : "Edit automation")</div>
                <div class="subtitle-11-5">Connect a CRM or ingestion event to a job chain</div>
            </div>
            <button class="dcslide-x" @onclick="Vm.CloseAutomationEditor" aria-label="Close"><CrmIcon Name="close" /></button>
        </div>
        <div class="dcslide-body crm-form">
            <div class="automation-editor-intro">
                <span><CrmIcon Name="workflow" /></span>
                <p><strong>Event-driven customer work</strong>Matching events are queued and run with client context or the incoming JSON payload.</p>
            </div>
            <div class="dcfield">
                <label>Automation name</label>
                <input class="dcinput" @bind="Vm.AutomationName"
                       placeholder="e.g. Send onboarding pack" />
            </div>
            <div class="dcfield">
                <label>Event</label>
                <select class="dcinput" @bind="Vm.AutomationEvent">
                    @foreach (var eventType in CrmViewModel.AutomationEvents)
                    {
                        <option value="@eventType">@CrmViewModel.AutomationEventLabel(eventType)</option>
                    }
                </select>
                <small class="field-help">@CrmViewModel.AutomationEventDescription(Vm.AutomationEvent)</small>
            </div>
            @if (Vm.AutomationEvent != CrmAutomationEventType.IngestionReceived)
            {
                <div class="dcfield">
                    <label>Lifecycle stage</label>
                    <select class="dcinput" @bind="Vm.AutomationStage">
                        <option value="">Any lifecycle stage</option>
                        @foreach (var stage in CrmViewModel.Stages)
                        {
                            <option value="@stage">@CrmViewModel.StageLabel(stage)</option>
                        }
                    </select>
                    <small class="field-help">Optionally limit this rule to clients in one stage.</small>
                </div>
            }
            <div class="dcfield">
                <label>Job chain</label>
                <select class="dcinput" @bind="Vm.AutomationChainId">
                    <option value="">Select a job chain…</option>
                    @foreach (var chain in Vm.Chains)
                    {
                        <option value="@chain.Id">@chain.Name (@chain.Steps.Count step@(chain.Steps.Count == 1 ? "" : "s"))</option>
                    }
                </select>
                @if (Vm.Chains.Count == 0)
                {
                    <small class="field-help warning">Create a job chain in this project before enabling an automation.</small>
                }
            </div>
            <label class="automation-enabled-field">
                <span>
                    <strong>Enable automation</strong>
                    <small>Begin listening for matching events as soon as this rule is saved.</small>
                </span>
                <input type="checkbox" @bind="Vm.AutomationEnabled" />
                <i></i>
            </label>
            <div class="automation-preview">
                <span class="preview-node">
                    <small>When</small>
                    <strong>@CrmViewModel.AutomationEventLabel(Vm.AutomationEvent)</strong>
                    <em>@Vm.AutomationStagePreview</em>
                </span>
                <span class="preview-arrow"><CrmIcon Name="arrow-right" /></span>
                <span class="preview-node">
                    <small>Run</small>
                    <strong>@Vm.SelectedAutomationChainName</strong>
                    <em>@(Vm.AutomationEvent == CrmAutomationEventType.IngestionReceived ? "with request payload" : "with client context")</em>
                </span>
            </div>
            @if (Vm.AutomationError is not null)
            {
                <div class="form-error">@Vm.AutomationError</div>
            }
            <div class="form-actions">
                <button class="dcbtn" @onclick="Vm.CloseAutomationEditor">Cancel</button>
                <button class="dcbtn primary" disabled="@Vm.SavingAutomation" @onclick="Vm.SaveAutomation">
                    @(Vm.SavingAutomation ? "Saving…" : "Save automation")
                </button>
            </div>
        </div>
    </div>
}

@if (Vm.PortalProvisioningOpen)
