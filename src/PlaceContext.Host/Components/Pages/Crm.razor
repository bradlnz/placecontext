    private int Count(CustomerLifecycleStage stage) => _clients.Count(c => ParseStage(c.LifecycleStage) == stage);
    private void ToggleStageFilter(CustomerLifecycleStage stage) => _stageFilter = _stageFilter == stage ? null : stage;
    private static CustomerLifecycleStage ParseStage(string value)
        => Enum.TryParse<CustomerLifecycleStage>(value, out var stage) ? stage : CustomerLifecycleStage.Lead;
    private static string StageLabel(CustomerLifecycleStage stage) => stage switch
    {
        CustomerLifecycleStage.AtRisk => "At risk",
        _ => stage.ToString(),
    };
    private static string StageDescription(CustomerLifecycleStage stage) => stage switch
    {
        CustomerLifecycleStage.Lead => "New prospects",
        CustomerLifecycleStage.Qualified => "Ready to engage",
        CustomerLifecycleStage.Onboarding => "Getting started",
        CustomerLifecycleStage.Active => "Current customers",
        CustomerLifecycleStage.AtRisk => "Needs attention",
        CustomerLifecycleStage.Churned => "Closed accounts",
        _ => "",
    };
    private static string StageClass(CustomerLifecycleStage stage) => $"stage-{stage.ToString().ToLowerInvariant()}";
    private static string Searchable(CrmClientView client)
        => $"{client.Name} {client.Company} {client.Email} {client.Phone}";
    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(parts.Take(2).Select(part => char.ToUpperInvariant(part[0])));
    }
