    private void CloseCalendarEditor() => _showCalendarEditor = false;
    private async Task SaveCalendar()
    {
        _savingCalendar = true; _calendarError = null;
        try { await Svc.SaveCrmCalendarAsync(new SaveCrmCalendarCommand(ProjectId, _calendarName, _calendarColor, _editCalendarId)); await RefreshCalendarData(); _showCalendarEditor = false; }
        catch (Exception ex) { _calendarError = ex.Message; }
