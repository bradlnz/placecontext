    private async Task RefreshCalendarData()
    {
        var calendarsTask = Svc.ListCrmCalendarsAsync(ProjectId); var appointmentsTask = Svc.ListCrmAppointmentsAsync(ProjectId);
        await Task.WhenAll(calendarsTask, appointmentsTask); _calendars = await calendarsTask; _appointments = await appointmentsTask;
