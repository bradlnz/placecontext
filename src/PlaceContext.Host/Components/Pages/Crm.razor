        <div class="dcslide-foot">
            @if (Vm.EditAppointmentId is not null) { <button class="dcbtn danger" disabled="@Vm.SavingAppointment" @onclick="Vm.DeleteAppointment">Delete event</button> }
            <button class="dcbtn" @onclick="Vm.CloseAppointmentEditor">Cancel</button>
            <button class="dcbtn primary" disabled="@Vm.SavingAppointment" @onclick="Vm.SaveAppointment">
                @(Vm.SavingAppointment ? "Saving…" : Vm.EditAppointmentId is null ? "Add event" : "Save event")
            </button>
        </div>
    </div>
}

