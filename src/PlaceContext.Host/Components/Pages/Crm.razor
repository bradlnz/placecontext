            </div>
            <div class="dcfield">
                <label>Portal username (email)</label>
                <input class="dcinput" @bind="Vm.PortalUserName" placeholder="portal-user@example.com" aria-label="Portal username" />
                <small class="field-help">Optional. If provided, this user will be created or updated on the portal.</small>
            </div>
            <div class="dcfield">
                <label>Portal password</label>
                <input class="dcinput" type="password" @bind="Vm.PortalPassword" placeholder="••••••••••" aria-label="Portal password" />
                <small class="field-help">Optional. Leave blank to auto-generate and send a reset email.</small>
            </div>
            @if (Vm.PortalMessage is not null)
            {
                <div class="form-error">@Vm.PortalMessage</div>
            }
            <div class="form-actions">
                <button class="dcbtn" @onclick="Vm.ClosePortalProvisioning">Cancel</button>
                @if (Vm.PortalTarget?.CustomerPortalEnabled == true)
                {
                    <button class="dcbtn" disabled="@(Vm.PortalRedeploying || Vm.SavingPortal)" @onclick="Vm.RedeployPortal">
                        @(Vm.PortalRedeploying ? "Redeploying…" : "Redeploy portal")
                    </button>
                }
                <button class="dcbtn primary" disabled="@(Vm.SavingPortal || Vm.PortalRedeploying)" @onclick="Vm.SavePortalProvisioning">
                    @(Vm.SavingPortal
                        ? "Saving…"
                        : Vm.PortalTarget?.CustomerPortalEnabled == true
                            ? "Save portal"
                            : "Create portal")
                </button>
            </div>
        </div>
    </div>
}

@if (Vm.NotesMetadataOpen)
{
    <div class="dcslide-scrim notes-scrim" @onclick="Vm.CloseNotesMetadata"></div>
    <div class="dcslide crm-editor notes-metadata-editor">
        <div class="dcslide-head">
            <span class="title-14">Notes metadata</span>
            <button class="dcslide-x" @onclick="Vm.CloseNotesMetadata" aria-label="Close"><CrmIcon Name="close" /></button>
        </div>
        <div class="dcslide-body crm-form">
            <p class="section-help">JSON extracted from this client's notes.</p>
            <pre class="notes-metadata-json">@Vm.NotesMetadataJson</pre>
            <div class="form-actions">
                <button class="dcbtn" @onclick="Vm.CloseNotesMetadata">Close</button>
                <button class="dcbtn primary" @onclick="Vm.CopyNotesMetadataAsync">Copy JSON</button>
            </div>
        </div>
    </div>
}

@if (Vm.Selected is not null && Vm.CurrentSection is not CrmSection.Conversations and not CrmSection.Portals)
{
    <div class="dcslide-scrim crm-detail-scrim" @onclick="Vm.CloseClient"></div>
    <div class="dcslide crm-detail">
        <div class="dcslide-head">
            <div class="detail-heading">
                <span class="client-avatar large @CrmViewModel.StageClass(CrmViewModel.ParseStage(Vm.Selected.LifecycleStage))">@CrmViewModel.Initials(Vm.Selected.Name)</span>
                <span>
                    <span class="title-14">@Vm.Selected.Name</span>
                    <span class="subtitle-11-5">@(Vm.Selected.Company ?? CrmViewModel.StageLabel(CrmViewModel.ParseStage(Vm.Selected.LifecycleStage)))</span>
                </span>
            </div>
            <button class="dcslide-x" @onclick="Vm.CloseClient" aria-label="Close"><CrmIcon Name="close" /></button>
        </div>
        <div class="dcslide-body detail-body">
            <div class="detail-hero @CrmViewModel.StageClass(CrmViewModel.ParseStage(Vm.Selected.LifecycleStage))">
                <span class="hero-stage">
                    <span class="badge-dot"></span>
                    @CrmViewModel.StageLabel(CrmViewModel.ParseStage(Vm.Selected.LifecycleStage))
                </span>
                <span class="hero-updated">Updated @Vm.UpdatedDate(Vm.Selected.UpdatedAt)</span>
            </div>
            <div class="detail-tabs" role="tablist" aria-label="Client details">
                <button class="@(Vm.CurrentDetailTab == CrmDetailTab.Overview ? "active" : "")"
                        role="tab" aria-selected="@(Vm.CurrentDetailTab == CrmDetailTab.Overview)"
                        @onclick="@(() => Vm.SelectDetailTab(CrmDetailTab.Overview))">
                    Overview
                </button>
                <button class="@(Vm.CurrentDetailTab == CrmDetailTab.Communications ? "active" : "")"
                        role="tab" aria-selected="@(Vm.CurrentDetailTab == CrmDetailTab.Communications)"
                        @onclick="@(() => Vm.SelectDetailTab(CrmDetailTab.Communications))">
                    Comms <span class="tab-count">@Vm.Communications.Count</span>
                </button>
                <button class="@(Vm.CurrentDetailTab == CrmDetailTab.Artifacts ? "active" : "")"
                        role="tab" aria-selected="@(Vm.CurrentDetailTab == CrmDetailTab.Artifacts)"
                        @onclick="@(() => Vm.SelectDetailTab(CrmDetailTab.Artifacts))">
                    Artifacts <span class="tab-count">@Vm.LatestClientArtifacts.Count</span>
                </button>
            </div>

            @if (Vm.CurrentDetailTab == CrmDetailTab.Overview)
            {
                <div class="detail-actions">
                    <button class="dcbtn" @onclick="@(() => Vm.EditClient(Vm.Selected))">Edit client</button>
                    @if (Vm.ConfirmDelete)
                    {
                        <button class="dcbtn danger" @onclick="Vm.DeleteClient">Confirm delete</button>
                        <button class="dcbtn" @onclick="@(() => Vm.ConfirmDelete = false)">Keep</button>
                    }
                    else
                    {
                        <button class="dcbtn" @onclick="@(() => Vm.ConfirmDelete = true)">Delete</button>
                    }
                </div>

                <section class="detail-section">
                    <div class="section-label">Lifecycle</div>
                    <select class="dcinput" value="@Vm.Selected.LifecycleStage"
                            @onchange="@(e => Vm.MoveClient(Vm.Selected, e))">
                        @foreach (var stage in CrmViewModel.Stages)
                        {
                            <option value="@Vm.StageOption(stage)">@CrmViewModel.StageLabel(stage)</option>
                        }
                    </select>
                </section>

                <section class="detail-section">
                    <div class="section-label">Contact</div>
                    <div class="detail-list">
                        <span class="detail-contact">
                            <span class="contact-icon"><CrmIcon Name="mail" /></span>
                            <span><small>Email</small>@(Vm.Selected.Email ?? "Not provided")</span>
                        </span>
                        <span class="detail-contact">
                            <span class="contact-icon"><CrmIcon Name="phone" /></span>
                            <span><small>Phone</small>@(Vm.Selected.Phone ?? "Not provided")</span>
                        </span>
                    </div>
                </section>

                <section class="detail-section portal-section">
                <div class="section-label">Customer portal</div>
                    @if (Vm.SelectedPortalEnabled)
                    {
                        <div class="portal-status">
                            <span class="portal-status-dot enabled"></span>
                            <span>Portal enabled at <strong>@Vm.SelectedPortalHost</strong></span>
                        </div>
                        @if (Vm.CanManagePortal)
                        {
                            <div class="portal-actions">
                                <button class="dcbtn primary" disabled="@(Vm.PortalInviting || string.IsNullOrWhiteSpace(Vm.Selected.Email))" @onclick="Vm.InviteSelectedToPortalAsync">
                                    @(Vm.PortalInviting ? "Inviting…" : "Invite to portal")
                                </button>
                                <button class="dcbtn" disabled="@(Vm.PortalImpersonating || string.IsNullOrWhiteSpace(Vm.Selected.Email))" @onclick="Vm.ImpersonateSelectedToPortalAsync">
                                    @(Vm.PortalImpersonating ? "Signing in…" : "Impersonate")
                                </button>
                                <button class="dcbtn" @onclick="@(() => Vm.OpenPortalProvisioning(Vm.Selected?.Name))">Configure</button>
                            </div>
                            @if (string.IsNullOrWhiteSpace(Vm.Selected.Email))
                            {
                                <small class="field-help">Add an email address to invite this client.</small>
                            }
                        }
                    }
                    else
                    {
                        <p class="section-help">Give this client a self-service portal for their project data and job-chain runs.</p>
                        @if (Vm.CanManagePortal)
                        {
                            <button class="dcbtn primary" @onclick="@(() => Vm.OpenPortalProvisioning(Vm.Selected?.Name))">
                                <CrmIcon Name="globe" />
                                Create customer portal
                            </button>
                        }
                        else
                        {
                            <small class="field-help">The settings.manage permission is required to configure the customer portal.</small>
                        }
                    }
                    @if (Vm.PortalMessage is not null)
                    {
                        <div class="portal-message">@Vm.PortalMessage</div>
                    }
                </section>


                @if (Vm.Selected.Notes is not null)
                {
                    <section class="detail-section">
                        <div class="notes-section-head">
                            <div class="section-label">Notes</div>
                            @if (Vm.HasNotesMetadata)
                            {
                                <button class="dcbtn xs" @onclick="Vm.OpenNotesMetadata">
                                    <CrmIcon Name="code" />
                                    View metadata
                                </button>
                            }
                        </div>
                        <p class="client-notes">@Vm.Selected.Notes</p>
                    </section>
                }

                <section class="detail-section run-section action-panel">
                    <div class="section-label">Run a lifecycle automation</div>
                    <p class="section-help">The chain starts with this client’s contact details, notes, and lifecycle stage as JSON.</p>
                    @if (Vm.Chains.Count == 0)
                    {
                        <div class="run-empty">No job chains exist in this project yet.</div>
                    }
                    else
                    {
                        <div class="run-controls">
                            <select class="dcinput" @bind="Vm.SelectedChainId">
                                <option value="">Select an automation…</option>
                                @foreach (var chain in Vm.Chains)
                                {
                                    <option value="@chain.Id">@chain.Name (@chain.Steps.Count step@(chain.Steps.Count == 1 ? "" : "s"))</option>
                                }
                            </select>
                            <button class="dcbtn primary" disabled="@(Vm.Running || Vm.SelectedChainId is null)" @onclick="Vm.RunAutomation">
                                @(Vm.Running ? "Running…" : "Run automation")
                            </button>
                        </div>
                    }
                </section>

                <section class="detail-section">
                    <div class="section-label">Customer automation history</div>
                    @if (Vm.LoadingRuns)
                    {
                        <div class="history-empty">Loading history…</div>
                    }
                    else if (Vm.ClientRuns.Count == 0)
                    {
                        <div class="history-empty">No automations have been run for this client.</div>
                    }
                    else
                    {
                        <div class="run-history">
                            @foreach (var run in Vm.ClientRuns)
                            {
                                <div class="run-row">
                                    <span class="run-status @Vm.RunStatusCss(run)"></span>
                                    <span class="run-copy">
                                        <strong>@run.ChainName</strong>
                                        <small>@CrmViewModel.StageLabel(CrmViewModel.ParseStage(run.LifecycleStage)) · @Vm.RunDateTime(run.StartedAt)</small>
                                    </span>
                                    <span class="status-text">@run.Status</span>
                                </div>
                            }
                        </div>
                    }
                </section>
            }
            else if (Vm.CurrentDetailTab == CrmDetailTab.Communications)
            {
                <div class="comms-pane">
                    @if (Vm.LoadingComms)
                    {
                        <div class="comms-empty">Loading conversation…</div>
                    }
                    else if (Vm.Communications.Count == 0)
                    {
                        <div class="comms-empty">
                            <span class="comms-empty-icon"><CrmIcon Name="message" /></span>
                            <strong>Start the conversation</strong>
                            <span>Add an internal note, or contact @Vm.Selected.Name by email or SMS.</span>
                        </div>
                    }
                    else
                    {
                        <div class="comms-timeline">
                            @foreach (var item in Vm.Communications.Reverse())
                            {
                                <article class="message-row @Vm.ChannelCss(item) @Vm.StatusCss(item)">
                                    <div class="message-bubble">
                                        <div class="message-meta">
                                            <span class="channel-mark"><CrmIcon Name="@Vm.ChannelIcon(item)" /></span>
                                            <strong>@Vm.ChannelLabel(item)</strong>
                                            @if (Vm.IsFailed(item))
                                            {
                                                <span class="delivery-state failed">Failed</span>
                                            }
                                            else if (Vm.IsSent(item))
                                            {
                                                <span class="delivery-state">Sent</span>
                                            }
                                        </div>
                                        @if (item.Subject is not null)
                                        {
                                            <div class="message-subject">@item.Subject</div>
                                        }
                                        <div class="message-body">@item.Body</div>
                                        @if (item.Error is not null)
                                        {
                                            <div class="message-error">@item.Error</div>
                                        }
                                        <time>@Vm.ArtifactDate(item.CreatedAt)</time>
                                    </div>
                                </article>
                            }
                        </div>
                    }

                    <div class="comms-composer">
                        <div class="channel-picker" role="tablist" aria-label="Communication type">
                            @foreach (var channel in CrmViewModel.CommsChannels)
                            {
                                <button class="@(Vm.CurrentComposeChannel == channel ? "active" : "")"
                                        disabled="@(!Vm.ChannelAvailable(channel))"
                                        title="@Vm.ChannelHelp(channel)"
                                        @onclick="@(() => Vm.SelectChannel(channel))">
                                    <span><CrmIcon Name="@CrmViewModel.ChannelIconName(channel)" /></span>@CrmViewModel.ChannelLabel(channel)
                                </button>
                            }
                        </div>

                        @if (Vm.IsEmailComposer)
                        {
                            <input class="dcinput composer-subject" @bind="Vm.ComposeSubject"
                                   placeholder="Email subject" aria-label="Email subject" />
                        }

                        <textarea class="dcinput composer-body" rows="4" @bind="Vm.ComposeBody"
                                  placeholder="@Vm.ComposerPlaceholder()" aria-label="Message"></textarea>

                        @if (Vm.CommsError is not null)
                        {
                            <div class="form-error">@Vm.CommsError</div>
                        }

                        <div class="composer-foot">
                            <span class="recipient-hint">@Vm.RecipientHint()</span>
                            <button class="dcbtn primary send-comms"
                                    disabled="@(!Vm.CanSubmitComms)"
                                    @onclick="Vm.SubmitCommunication">
                                @(Vm.SendingComms ? "Sending…" : Vm.SubmitLabel())
                            </button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="client-artifacts-pane">
                    <div class="artifact-workspace-head">
                        <div class="artifact-workspace-title">
                            <span class="artifact-folder-mark">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                    <path d="M3 6.5h6l2 2h10v10.5H3z"></path>
                                    <path d="M3 10h18"></path>
                                </svg>
                            </span>
                            <span>
                                <strong>Client files</strong>
                                <small>Everything connected to @Vm.Selected.Name</small>
                            </span>
                        </div>
                        <div class="artifact-summary">
                            <span><strong>@Vm.LatestClientArtifacts.Count</strong> file@(Vm.LatestClientArtifacts.Count == 1 ? "" : "s")</span>
                            <span>@CrmViewModel.FormatBytes(Vm.LatestClientArtifacts.Sum(item => item.SizeBytes))</span>
                        </div>
                    </div>

                    @if (Vm.ArtifactError is not null)
                    {
                        <div class="form-error">@Vm.ArtifactError</div>
                    }

                    <label class="artifact-dropzone @(Vm.UploadingArtifact ? "uploading" : "")">
                        <InputFile OnChange="Vm.AttachArtifact" disabled="@Vm.UploadingArtifact" />
                        <span class="dropzone-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                <path d="M12 16V4M7 9l5-5 5 5"></path>
                                <path d="M4 15v5h16v-5"></path>
                            </svg>
                        </span>
                        <span class="dropzone-copy">
                            <strong>@(Vm.UploadingArtifact ? "Uploading file…" : "Drop a file here or browse")</strong>
                            <small>PDF, images, documents and data files · up to 20 MB</small>
                        </span>
                        <span class="dropzone-action">@(Vm.UploadingArtifact ? "Please wait" : "Choose file")</span>
                    </label>

                    @if (Vm.LoadingArtifacts)
                    {
                        <div class="artifact-loading">
                            @for (var i = 0; i < 3; i++)
                            {
                                <span></span>
                            }
                        </div>
                    }
                    else if (Vm.LatestClientArtifacts.Count == 0)
                    {
                        <div class="artifact-empty">
                            <span class="artifact-empty-icon">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                    <path d="M4 7h6l2 2h8v10H4z"></path><path d="M12 12v4M10 14h4"></path>
                                </svg>
                            </span>
                            <strong>No client files yet</strong>
                            <span>Upload the first file above. Outputs created by client automations will appear here automatically.</span>
                        </div>
                    }
                    else
                    {
                        <div class="artifact-toolbar">
                            <label class="artifact-search">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                    <circle cx="11" cy="11" r="7"></circle><path d="M20 20l-3.5-3.5"></path>
                                </svg>
                                <input value="@Vm.ArtifactSearch" @oninput="Vm.OnArtifactSearch"
                                       placeholder="Search client files…" aria-label="Search client files" />
                                @if (!string.IsNullOrWhiteSpace(Vm.ArtifactSearch))
                                {
                                    <button type="button" title="Clear search"
                                            @onclick="@(() => Vm.ArtifactSearch = "")"><CrmIcon Name="close" /></button>
                                }
                            </label>
                            <div class="artifact-source-filter" aria-label="Artifact source">
                                <button class="@(Vm.CurrentArtifactSource == CrmArtifactSource.All ? "active" : "")"
                                        @onclick="@(() => Vm.SelectArtifactSource(CrmArtifactSource.All))">
                                    All <span>@Vm.LatestClientArtifacts.Count</span>
                                </button>
                                <button class="@(Vm.CurrentArtifactSource == CrmArtifactSource.Upload ? "active" : "")"
                                        @onclick="@(() => Vm.SelectArtifactSource(CrmArtifactSource.Upload))">
                                    Uploaded <span>@Vm.ArtifactSourceCount("Upload")</span>
                                </button>
                                <button class="@(Vm.CurrentArtifactSource == CrmArtifactSource.Automation ? "active" : "")"
                                        @onclick="@(() => Vm.SelectArtifactSource(CrmArtifactSource.Automation))">
                                    Automation <span>@Vm.ArtifactSourceCount("Automation")</span>
                                </button>
                            </div>
                        </div>

                        @if (!Vm.FilteredClientArtifacts.Any())
                        {
                            <div class="artifact-no-results">
                                <strong>No matching files</strong>
                                <span>Try another search or source filter.</span>
                                <button class="dcbtn xs" @onclick="Vm.ClearArtifactFilters">Clear filters</button>
                            </div>
                        }
                        else
                        {
                        <div class="artifact-list-head" aria-hidden="true">
                            <span>File</span><span>Source</span><span>Actions</span>
                        </div>
                        <div class="client-artifact-list">
                            @foreach (var artifact in Vm.FilteredClientArtifacts)
                            {
                                <article class="client-artifact-row @CrmViewModel.ArtifactTypeClass(artifact.ContentType)">
                                    <a class="artifact-open" href="/crm/artifacts/@artifact.Id" target="_blank"
                                        title="Open @artifact.Title">
                                        <span class="artifact-file-icon">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
                                                <path d="M6 3h8l4 4v14H6z"></path><path d="M14 3v5h5"></path>
                                            </svg>
                                            <small>@CrmViewModel.ArtifactExtension(artifact.Title)</small>
                                        </span>
                                        <span class="artifact-file-copy">
                                            <strong>@artifact.Title</strong>
                                            <span class="artifact-file-meta">
                                                <span>@CrmViewModel.FormatBytes(artifact.SizeBytes)</span>
                                                <span>@CrmViewModel.ArtifactTypeLabel(artifact.ContentType)</span>
                                                <span>@CrmViewModel.RelativeArtifactDate(artifact.CreatedAt)</span>
                                            </span>
                                        </span>
                                    </a>
                                    <span class="artifact-source-badge @Vm.ArtifactSourceCss(artifact)">
                                        @if (Vm.IsAutomationArtifact(artifact))
                                        {
                                            <span class="source-dot"></span><text>Automation output</text>
                                        }
                                        else
                                        {
                                            <span class="source-dot"></span><text>Uploaded</text>
                                        }
                                    </span>
                                    <div class="artifact-row-actions">
                                        <a href="/crm/artifacts/@artifact.Id" target="_blank"
                                           class="artifact-action open" title="Open file" aria-label="Open @artifact.Title">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                                <path d="M14 5h5v5M19 5l-8 8"></path><path d="M19 13v6H5V5h6"></path>
                                            </svg>
                                        </a>
                                        @if (Vm.ConfirmArtifactRemoveId == artifact.Id)
                                        {
                                            <button class="artifact-confirm-remove"
                                                    title="Confirm removal"
                                                    @onclick="@(() => Vm.RemoveArtifact(artifact))">Remove</button>
                                            <button class="artifact-action"
                                                    title="Cancel"
                                                    @onclick="@(() => Vm.ConfirmArtifactRemoveId = null)"><CrmIcon Name="close" /></button>
                                        }
                                        else
                                        {
                                            <button class="artifact-action remove"
                                                    title="Remove from client"
                                                    aria-label="Remove @artifact.Title from client"
                                                    @onclick="@(() => Vm.ConfirmArtifactRemoveId = artifact.Id)">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                                                    <path d="M4 7h16M9 7V4h6v3M8 10v8M12 10v8M16 10v8M6 7l1 14h10l1-14"></path>
                                                </svg>
                                            </button>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                        }
                    }
                </div>
            }
        </div>
    </div>
}
@implements IDisposable

@code {
    [Parameter] public Guid ProjectId { get; set; }
   protected override async Task OnParametersSetAsync()
   {
       Vm.ProjectId = ProjectId;
       await Vm.LoadAsync();
   }

   protected override void OnInitialized()
   {
       Vm.Attach(() => InvokeAsync(StateHasChanged));
   }

   public void Dispose()
   {
       Vm.Detach();
   }
}
