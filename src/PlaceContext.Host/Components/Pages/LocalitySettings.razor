@page "/settings/locality"
@implements IDisposable
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@attribute [Authorize(Policy = Policies.DefaultAdmin)]
@using PlaceContext.Host.Components.ViewModels
@inject LocalitySettingsViewModel Vm

<PageTitle>placecontext — Locality</PageTitle>

<div class="page">
    <h2 class="title">Locality</h2>
    <div class="intro">
        The workspace timezone drives everything time-shaped: cron schedules fire in it, and every
        timestamp the portal shows is converted to it. MCP clients can also set it via the
        <code>set_workspace_timezone</code> MCP tool.
    </div>

    <div class="dccard card">
        <div class="dcfield tz-field">
            <label>Workspace timezone <span class="code code-gap">IANA</span></label>
            <select class="dcinput tz-input" @bind="Vm.TimeZoneId">
                @foreach (var zone in LocalityTimeZones.All)
                {
                    <option value="@zone">@zone</option>
                }
            </select>
        </div>
        <div class="now-row">
            Now in <span class="mono">@Vm.TimeZoneId</span>:
            <span class="mono-accent">@Vm.PreviewNow()</span>
        </div>
        <div class="actions">
            <button class="dcbtn primary" disabled="@Vm.Busy" @onclick="@(() => Vm.SaveAsync())">@(Vm.Busy ? "Saving…" : "Save timezone")</button>
            @if (Vm.Message is not null)
            {
                <span class="msg">@Vm.Message</span>
            }
        </div>
        <div class="dchint">
            Existing schedules keep their already-computed next fire time until they next run; new
            and re-saved schedules use the new zone immediately.
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Vm.Attach(() => InvokeAsync(StateHasChanged));
        Vm.Initialize();
    }

    public void Dispose() => Vm.Detach();
}
