                                        </div>
                                    }
                                    else
                                    {
                                        <div class="dcfield">
                                            <label>Command</label>
                                            <input class="dcinput" @bind="_newMcpCommand" placeholder="npx" />
                                        </div>
                                        <div class="dcfield">
                                            <label>Args (JSON array)</label>
                                            <input class="dcinput" @bind="_newMcpArgs" placeholder='["-y", "@@modelcontextprotocol/server-filesystem", "/path"]' />
                                        </div>
                                    }
                                    <div class="mcp-auth-section">
                                        <div class="mcp-auth-header" @onclick="@(() => _showAuthFields = !_showAuthFields)">
                                            <span>Authentication</span>
                                            <span class="mcp-auth-chevron">@(_showAuthFields ? "▾" : "▸")</span>
                                        </div>
                                        @if (_showAuthFields)
