    protected override async Task OnInitializedAsync()
    {
        Ui.Set("Chat", "Agent inference");
        Ui.OnChanged += OnUiChanged;
        _projectId = Ui.CurrentProjectId;
        _projectName = Ui.CurrentProjectName ?? "";
        if (_projectId.HasValue)
        {
            await LoadAgentConfig();
            await LoadSessionsAsync();
            await LoadMcpConnectionsAsync();

            // Load most recent session if one exists, otherwise create new
            if (_sessions.Count > 0)
            {
                await SelectSessionAsync(_sessions[0]);
            }
            else
            {
                NewSession();
            }
        }
    }

    private async Task LoadAgentConfig()
    {
        if (!_projectId.HasValue) return;
        try
        {
            var config = await Svc.GetAgentConfigAsync(_projectId.Value);
            _systemPrompt = config.SystemPrompt;
            _temperature = config.Temperature;
            _maxContextChunks = config.MaxContextChunks;
        }
        catch { /* use defaults */ }
    }

    private async Task OnProjectChanged()
    {
        if (_projectId.HasValue)
        {
            _projectName = Ui.CurrentProjectName ?? "";
            await LoadAgentConfig();
            await LoadGraphAsync();
            _activeActions.Clear();
            _fetchedData.Clear();
            _toolHistory.Clear();
            await LoadSessionsAsync();
            await LoadMcpConnectionsAsync();
            NewSession();
        }
    }

    private async void OnUiChanged()
    {
        if (_projectId == Ui.CurrentProjectId) return;
        _projectId = Ui.CurrentProjectId;
        _projectName = Ui.CurrentProjectName ?? "";
        await OnProjectChanged();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Ui.OnChanged -= OnUiChanged;
        OnMcpOAuthCompleted -= OnMcpOAuthCompletedHandler;
    }

    private async void OnMcpOAuthCompletedHandler(object? _, EventArgs __)
    {
        await InvokeAsync(async () =>
        {
            await LoadMcpConnectionsAsync();
            StateHasChanged();
        });
    }

    private async Task LoadSessionsAsync()
    {
        if (!_projectId.HasValue) return;
        try { _sessions = await MemoryStore.ListSessionsAsync(_projectId.Value); }
        catch { _sessions = Array.Empty<ChatSessionSummary>(); }
    }

    private void NewSession()
    {
        if (_streaming) return;
        _sessionId = Guid.NewGuid();
        _sessionTitle = "New Chat";
        _messages.Clear();
        _activeActions.Clear();
        _fetchedData.Clear();
        _toolHistory.Clear();
        _pendingClarification = null;
        _clarificationSelected.Clear();
        _renderedChartIds.Clear();
        _renderedMapIds.Clear();
        _attachedFile = null;
        _attachedFileName = null;
        _attachedFileText = null;
        _streamBuffer = "";
        StateHasChanged();
    }

    private async Task DeleteSessionAsync(ChatSessionSummary session)
    {
        if (_streaming) return;
        try { await MemoryStore.DeleteSessionAsync(session.Id); }
        catch { }
        if (session.Id == _sessionId)
        {
            NewSession();
        }
        await LoadSessionsAsync();
        StateHasChanged();
    }

    private async Task ClearCurrentSessionAsync()
    {
        if (_streaming) return;
        if (_sessionId.HasValue)
        {
            try { await MemoryStore.ClearSessionMemoryAsync(_sessionId.Value); }
            catch { }
        }
        // Reset the conversation but keep the same session id
        _sessionTitle = "New Chat";
        _messages.Clear();
        _activeActions.Clear();
        _fetchedData.Clear();
        _toolHistory.Clear();
        _pendingClarification = null;
        _clarificationSelected.Clear();
        _renderedChartIds.Clear();
        _renderedMapIds.Clear();
        _attachedFile = null;
        _attachedFileName = null;
        _attachedFileText = null;
        _streamBuffer = "";
        await LoadSessionsAsync();
        StateHasChanged();
    }

    private async Task SelectSessionAsync(ChatSessionSummary session)
    {
        if (_streaming || !_projectId.HasValue) return;
        try
        {
            var memory = await MemoryStore.GetSessionAsync(session.Id);
            if (memory != null)
            {
                _sessionId = session.Id;
                _sessionTitle = memory.Title;
                _messages.Clear();
                foreach (var m in memory.Messages)
                {
                    var msg = new AgentMessage(m.Role, m.Content)
                    {
                        AttachmentName = m.AttachmentName,
                        AttachmentKey = m.AttachmentKey,
                        AttachmentContentType = m.AttachmentContentType,
                        AttachmentSizeBytes = m.AttachmentSizeBytes,
                    };
                    if (m.ToolCalls != null)
                        msg.ToolCalls.AddRange(m.ToolCalls.Select(tc => new ToolCallInfo
                        {
                            ToolName = tc.ToolName,
                            Args = tc.Args,
                            Status = Enum.TryParse<ToolCallStatus>(tc.Status, out var s) ? s : ToolCallStatus.Completed,
                            Result = tc.Result,
                            ResultType = tc.ResultType,
                        }));
                    _messages.Add(msg);
                }
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task SaveCurrentSessionAsync()
    {
        if (!_projectId.HasValue || _sessionId == null) return;
        var memory = new ChatSessionMemory(
            _sessionId.Value, _projectId.Value, _sessionTitle,
            _messages.Select(m => new ChatMemoryMessage(
                m.Role, m.Content, DateTimeOffset.Now,
                m.ToolCalls.Select(tc => new ChatMemoryToolCall(
                    tc.ToolName, tc.Args, tc.Status.ToString(), tc.Result, tc.ResultType)).ToList(),
                m.AttachmentName, m.AttachmentKey, m.AttachmentContentType, m.AttachmentSizeBytes)).ToList(),
            DateTimeOffset.Now, DateTimeOffset.Now);
        try { await MemoryStore.SaveSessionAsync(_sessionId.Value, memory); }
        catch { }
        await LoadSessionsAsync();
    }

    

    private async Task Send()
    {
        var text = _input.Trim();
        if (string.IsNullOrEmpty(text) || _streaming || !_projectId.HasValue) return;

        // Include attached file content in the user message
        var userText = text;
        if (_attachedFileName != null && _attachedFileText != null)
        {
            userText += $"\n\n## Attached file: {_attachedFileName}\n\n{_attachedFileText}";
        }
        var userMsg = new AgentMessage("user", userText);

        // Persist the raw attachment to object storage so it stays downloadable from the transcript
        if (_attachedFile != null && _attachedFileName != null && _sessionId.HasValue && ObjectStore.IsEnabled)
        {
            try
            {
                if (!_attachmentsBucketEnsured)
                {
                    await ObjectStore.EnsureBucketAsync(AttachmentsBucket);
                    _attachmentsBucketEnsured = true;
                }
                var contentType = ContentTypeFor(_attachedFileName);
                var key = $"chat/{Tenant.TenantId}/{_projectId!.Value}/{_sessionId.Value}/{Guid.NewGuid():N}-{SanitizeFileName(_attachedFileName)}";
                await ObjectStore.PutAsync(AttachmentsBucket, key, _attachedFile, contentType);
                userMsg.AttachmentName = _attachedFileName;
                userMsg.AttachmentKey = key;
                userMsg.AttachmentContentType = contentType;
                userMsg.AttachmentSizeBytes = _attachedFile.Length;
            }
            catch { /* best-effort: the extracted text is still inlined above */ }
        }
        else if (_attachedFileName != null)
        {
            // Store disabled or no bytes — still show the attachment name on the message
            userMsg.AttachmentName = _attachedFileName;
            userMsg.AttachmentSizeBytes = _attachedFile?.Length ?? 0;
        }
        _messages.Add(userMsg);
        _input = "";

        // Clear attachment after sending
        _attachedFile = null;
        _attachedFileName = null;
        _attachedFileText = null;

        _streaming = true;
        _streamBuffer = "";

        // Update session title from first user message
        if (_messages.Count(m => m.Role == "user") == 1)
        {
            _sessionTitle = text.Length > 50 ? text[..50] + "…" : text;
        }

        await InvokeAsync(StateHasChanged);
        await ScrollToBottom();

        // Build RAG context once before the tool loop.
        string ragContext = "";
        if (_ragEnabled)
        {
            try { ragContext = await ContextBuilder.BuildContextAsync(_projectId.Value, text, _maxContextChunks); }
            catch { /* best-effort */ }
        }

        try
        {
            var ct = CancellationToken.None;
            var maxToolRounds = 3;
            var round = 0;

            while (round < maxToolRounds)
            {
                round++;
                var messages = BuildChatMessages(ragContext);

                _streamBuffer = "";
                _currentToolCall = null;
                await InvokeAsync(StateHasChanged);

                // Small delay to show typing dots
                if (round > 1 || _messages.Any(m => m.ToolCalls.Count > 0))
                {
                    await Task.Delay(300, ct);
                }

                if (Gateway is ClusterChatGateway cg && cg.IsEnabled)
                {
                    var settings = new ChatSettings(Temperature: _temperature, MaxTokens: _maxTokens);
                    var tokenCount = 0;
                    await foreach (var token in cg.ChatStreamAsync(messages, settings, ct))
                    {
                        _streamBuffer += token;
                        tokenCount++;
                        await InvokeAsync(StateHasChanged);
                        await ScrollToBottom();
                    }
                    // Log if we got no tokens
                    if (tokenCount == 0)
                    {
                        _streamBuffer = "The model returned an empty response. This might be due to the conversation context. Please try rephrasing your question.";
                    }
                }
                else if (Gateway is ClusterChatGateway configuredButNotReady && !configuredButNotReady.IsEnabled)
                {
                    _streamBuffer = "Cluster is starting — please try again in a moment.";
                }
                else
                {
                    var settings = new ChatSettings(Temperature: _temperature, MaxTokens: _maxTokens);
                    _streamBuffer = await Gateway.ChatAsync(messages, settings, ct);
                }

                var toolCalls = ParseToolCalls(_streamBuffer);
                if (toolCalls.Count == 0) 
                {
                    // No tool calls - this is the final response
                    if (string.IsNullOrWhiteSpace(_streamBuffer))
                    {
                        _streamBuffer = "I've processed your request but didn't generate a text response. The tool results are shown above.";
                    }
                    break;
                }

                var toolResults = new System.Text.StringBuilder();
                toolResults.Append("\n\n## Tool Results\n\n");
                foreach (var tc in toolCalls)
                {
                    _currentToolCall = tc;
                    tc.Id = _toolCallCounter++;
                    tc.Status = ToolCallStatus.Running;
                    await InvokeAsync(StateHasChanged);

                    const int maxRetries = 2;
                    const int timeoutSeconds = 15;
                    ToolCallResult result = ToolCallResult.Fail("uninitialized");
                    for (var attempt = 0; attempt <= maxRetries; attempt++)
                    {
                        tc.RetryCount = attempt;
                        await InvokeAsync(StateHasChanged);

                        using var timeoutCts = new CancellationTokenSource(TimeSpan.FromSeconds(timeoutSeconds));
                        using var linkedCts = CancellationTokenSource.CreateLinkedTokenSource(ct, timeoutCts.Token);
                        try
                        {
                            result = await ExecuteToolAsync(tc.ToolName, tc.Args, linkedCts.Token);
                        }
                        catch (OperationCanceledException) when (timeoutCts.IsCancellationRequested)
                        {
                            result = ToolCallResult.Fail($"Timed out after {timeoutSeconds}s");
                        }

                        if (result.Success || !IsTransientError(result.Error ?? ""))
                            break;

                        if (attempt < maxRetries)
                            await Task.Delay(1000, ct);
                    }

                    tc.Status = result.Success ? ToolCallStatus.Completed : ToolCallStatus.Error;
                    tc.Result = result.Data ?? result.Error;
                    tc.ResultType = result.IsMap ? "map" : result.IsGraph ? "graph" : result.IsArtifact ? "artifact" : "text";

                    // Update active action with result detail
                    var action = _activeActions.FirstOrDefault(a => a.ToolName == tc.ToolName && a.Status == ToolCallStatus.Running);
                    if (action != null)
                    {
                        action.Status = result.Success ? ToolCallStatus.Completed : ToolCallStatus.Error;
                        action.Detail = result.Success ? "done" : (result.Error?.Length > 40 ? result.Error[..40] + "…" : result.Error ?? "error");
                    }

                    toolResults.Append("### " + tc.ToolName + "\n");
                    toolResults.Append("Args: " + tc.Args + "\n");
                    toolResults.Append(result.Success ? "Result:\n" : "Error:\n");
                    toolResults.Append(result.Data ?? result.Error);
                    toolResults.Append("\n\n");
                }

                // Extract text content (strip tool call syntax)
                var textContent = System.Text.RegularExpressions.Regex.Replace(_streamBuffer, @"\[\[tool:[^\]]*\]\]", "").Trim();

                var assistantMsg = new AgentMessage("assistant", textContent);
                assistantMsg.ToolCalls.AddRange(toolCalls);
                _messages.Add(assistantMsg);
                _messages.Add(new AgentMessage("system", toolResults.ToString()));
                _streamBuffer = "";
                await InvokeAsync(StateHasChanged);
                await ScrollToBottom();
            }

            // Ensure we always have a final assistant message
            if (_messages.Count == 0 || _messages.Last().Role != "assistant")
            {
                var finalContent = string.IsNullOrWhiteSpace(_streamBuffer) 
                    ? "I've completed the requested actions." 
                    : _streamBuffer;
                _messages.Add(new AgentMessage("assistant", finalContent));
            }
        }
        catch (Exception ex)
        {
            _messages.Add(new AgentMessage("assistant", $"[error: {ex.Message}]"));
        }
        finally
        {
            _streaming = false;
            _streamBuffer = "";
            _currentToolCall = null;
            _pendingClarification = null;
            _clarificationSelected.Clear();
            _clarificationTcs = null;
            await SaveCurrentSessionAsync();
            await InvokeAsync(StateHasChanged);
            await ScrollToBottom();
        }
    }

    private List<ChatMessage> BuildChatMessages(string ragContext = "")
    {
        var toolDesc = "Available tools (use [[tool:toolName|args]] syntax). " +
            "IMPORTANT: Always pass ALL known parameters (table names, column names, IDs, etc.) from the conversation context. " +
            "Do not ask the user for information you already have.\n\n" +
            "Built-in tools:\n" +
            "- [[tool:list_tables|]] - List all project data tables\n" +
            "- [[tool:query_table|tableName|page]] - Query a table (pass table name from context)\n" +
            "- [[tool:list_jobs|]] - List all jobs\n" +
            "- [[tool:list_job_runs|jobId]] - List runs for a job\n" +
            "- [[tool:render_graph|chartType|tableName|columnName]] - Render a chart (pass table AND column names from context, e.g. [[tool:render_graph|bar|cashflow_runs|amount]])\n" +
            "- [[tool:query_graph|]] - Query project dependency graph\n" +
            "- [[tool:search|query]] - Semantic search over project run outputs and data\n" +
            "- [[tool:get_artifacts|query]] - Search project artifacts by title/kind. When the user asks for a specific report/file, search first, then use show_artifact with the id.\n" +
            "- [[tool:show_artifact|artifactId]] - Render an artifact inline by its id (use the id from get_artifacts)\n" +
            "- [[tool:schedule_job|jobId|name|cron]] - Create a cron schedule\n" +
            "- [[tool:list_schedules|jobId]] - List job schedules\n" +
            "- [[tool:toggle_schedule|triggerId|true|false]] - Enable/disable schedule\n" +
            "- [[tool:run_job|jobId]] - Run a job now\n" +
            "- [[tool:call_mcp|serverName|toolName|argsJson]] - Call a tool on an external MCP server\n" +
            "- [[tool:list_mcp_tools|serverName]] - List available tools on an MCP server\n" +
            "- [[tool:render_map|specJson]] - Render a Leaflet map (JSON spec with {markers:[{lat,lng,label,color}], polygons:[{coords,color}], center:[lat,lng], zoom}). Example: [[tool:render_map|{\\\"markers\\\":[{\\\"lat\\\":48.135,\\\"lng\\\":11.582,\\\"label\\\":\\\"Munich\\\"}]}]]";

        var systemPrompt = _systemPrompt + "\n\n" + toolDesc;
        if (!string.IsNullOrWhiteSpace(ragContext))
        {
            systemPrompt += "\n\n## Project context (retrieved automatically)\n\n" + ragContext;
        }

        var messages = new List<ChatMessage>
        {
            new("system", systemPrompt),
        };

        // Build conversation history: merge tool results into assistant messages,
        // skip standalone system messages, and ensure proper role ordering.
        var history = new List<ChatMessage>();
        for (var i = 0; i < _messages.Count; i++)
        {
            var m = _messages[i];

            // Skip standalone system messages (tool results will be merged below)
            if (m.Role == "system") continue;

            var content = m.Content;

            // For assistant messages, append tool calls and any following tool results
            if (m.Role == "assistant")
            {
                if (m.ToolCalls.Count > 0)
                {
                    var toolCallText = string.Join("\n", m.ToolCalls.Select(tc =>
                        $"[[tool:{tc.ToolName}|{tc.Args}]]"));
                    content = string.IsNullOrWhiteSpace(content)
                        ? toolCallText
                        : content + "\n\n" + toolCallText;
                }

                // Merge the next message if it's a system tool-results message
                if (i + 1 < _messages.Count && _messages[i + 1].Role == "system"
                    && _messages[i + 1].Content.Contains("Tool Results"))
                {
                    content += "\n\n" + _messages[i + 1].Content;
                    i++; // skip the merged system message
                }
            }

            history.Add(new ChatMessage(m.Role, content));
        }

        // Limit to last 20 messages to avoid context overflow
        foreach (var m in history.TakeLast(20))
            messages.Add(m);

        return messages;
    }

    private List<ToolCallInfo> ParseToolCalls(string response)
    {
        var calls = new List<ToolCallInfo>();
        var pattern = @"\[\[tool:(\w+)\|([^\]]*)\]\]";
        foreach (System.Text.RegularExpressions.Match m in System.Text.RegularExpressions.Regex.Matches(response, pattern))
        {
            calls.Add(new ToolCallInfo { ToolName = m.Groups[1].Value, Args = m.Groups[2].Value });
        }
        return calls;
    }


