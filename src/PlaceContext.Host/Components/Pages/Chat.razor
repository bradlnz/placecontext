    }

    private async Task<ToolCallResult> ExecuteScheduleJobAsync(string args, CancellationToken ct)
    {
        var parts = args.Split('|');
        if (parts.Length < 3) return ToolCallResult.Fail("Usage: schedule_job|jobId|name|cron");
        var jobId = Guid.TryParse(parts[0].Trim(), out var id) ? id : Guid.Empty;
        if (jobId == Guid.Empty) return ToolCallResult.Fail("Invalid jobId");
        var name = parts[1].Trim();
        var cron = parts[2].Trim();
        AddActiveAction("schedule_job", $"Creating schedule for job {jobId.ToString()[..8]}...");
        var trigger = await Svc.CreateTriggerAsync(new Application.Features.CreateTriggerCommand(
            jobId, name, "Schedule", cron, null), ct);
        CompleteActiveAction("schedule_job", true);
        AddToolHistory("schedule_job", true, $"Next: {trigger.NextRunAt?.ToString("HH:mm") ?? "—"}");
        return ToolCallResult.Ok($"Schedule created: {trigger.Name} (id: {trigger.Id})\n" +
            $"Cron: {trigger.CronExpression}\n" +
            $"Next run: {trigger.NextRunAt?.ToString("yyyy-MM-dd HH:mm") ?? "—"}\n" +
            $"Enabled: {trigger.Enabled}");
    }

