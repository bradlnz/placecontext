@page "/chat"
@attribute [Authorize]
@layout PlaceContext.Host.Components.Layout.MainLayout
@using PlaceContext.Application.Ports
@using PlaceContext.Application.Dtos
@using PlaceContext.Application.Features
@using PlaceContext.Infrastructure.Chat
@using PlaceContext.Infrastructure.Caching
@inject IChatGateway Gateway
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject IJSRuntime JS
@inject PlaceContext.Infrastructure.Caching.IChatMemoryStore MemoryStore
@inject AgentContextBuilder ContextBuilder

<PageTitle>placecontext — Agent Chat</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <h2 class="page-title">Agent Chat</h2>
            <div class="page-sub">
                @if (Gateway is ClusterChatGateway cg)
                {
                    <span>@cg.StatusText — @_projectName</span>
                }
                else if (Gateway.IsEnabled)
                {
                    <span>Chat backend active</span>
                }
                else
                {
                    <span>No model configured</span>
                }
            </div>
        </div>
        <div class="chat-controls">
            @if (_projectId.HasValue)
            {
                <button class="dcbtn sm" @onclick="ToggleSidePanel">@(_showSidePanel ? "Hide Panel" : "Show Panel")</button>
                <button class="dcbtn sm" @onclick="OpenSettings">⚙ Settings</button>
            }
            <select class="dcselect sm" @bind="_projectId" @bind:after="OnProjectChanged">
                <option value="">Select project…</option>
                @foreach (var p in _projects)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
        </div>
    </div>

    <div class="chat-layout">
        <div class="chat-area">
            <div class="chat-messages" @ref="_messagesRef">
                @if (_messages.Count == 0)
                {
                    <div class="empty-note chat-empty">
                        <p>Ask me about your project data, job runs, or request a graph.</p>
                        <p class="hint">Try: "Show me the job run history" or "Render a bar chart of entity counts"</p>
                    </div>
                }
                else
                {
                    @foreach (var msg in _messages)
                    {
                        <div class="chat-msg @msg.Role">
                            <div class="msg-avatar @(msg.Role == "user" ? "avatar-user" : "avatar-bot")">
                                @if (msg.Role == "user")
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                                }
                            </div>
                            <div class="msg-body">
                                <div class="msg-role">@msg.Role</div>
                                @if (msg.ToolCalls.Count > 0)
                                {
                                    <div class="tool-calls">
                                        @foreach (var tc in msg.ToolCalls)
                                        {
                                            <div class="tool-call @(tc.Status.ToString().ToLower())">
                                                <span class="tool-name">@tc.ToolName</span>
                                                <span class="tool-status">@tc.Status</span>
                                                @if (tc.Status == ToolCallStatus.Completed && !string.IsNullOrEmpty(tc.Result))
                                                {
                                                    <details class="tool-result">
                                                        <summary>View result</summary>
                                                        @if (tc.ResultType == "graph")
                                                        {
                                                            <div class="graph-container" @key="tc.Id">
                                                                <canvas id="graph-@tc.Id" width="600" height="300"></canvas>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <pre class="tool-output">@tc.Result</pre>
                                                        }
                                                    </details>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                <div class="msg-content">@((MarkupString)FormatContent(msg.Content))</div>
                                @if (msg.Role == "assistant" && !_streaming)
                                {
                                    <div class="quick-actions">
                                        <button class="qa-btn" @onclick="@(() => QuickActionAsync(msg.Content, "summarize"))" title="Summarize">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M4 6h16M4 12h10M4 18h14"/></svg>
                                            Summarize
                                        </button>
                                        <button class="qa-btn" @onclick="@(() => QuickActionAsync(msg.Content, "explain"))" title="Explain in detail">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                                            Explain
                                        </button>
                                        <button class="qa-btn" @onclick="@(() => QuickActionAsync(msg.Content, "code"))" title="Generate code">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                                            Code
                                        </button>
                                        <button class="qa-btn" @onclick="@(() => QuickActionAsync(msg.Content, "graph"))" title="Visualize as graph">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><circle cx="5" cy="6" r="3"/><circle cx="19" cy="6" r="3"/><circle cx="12" cy="18" r="3"/><line x1="8" y1="8" x2="10" y2="15"/><line x1="16" y1="8" x2="14" y2="15"/></svg>
                                            Graph
                                        </button>
                                        <button class="qa-btn" @onclick="@(() => CopyMessageAsync(msg.Content))" title="Copy to clipboard">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                @if (_streaming)
                {
                    <div class="chat-msg assistant">
                        <div class="msg-avatar avatar-bot">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                        </div>
                        <div class="msg-body">
                            <div class="msg-role">assistant</div>
                            @if (_currentToolCall != null)
                            {
                                <div class="tool-calls">
                                    <div class="tool-call running">
                                        <span class="tool-name">@_currentToolCall.ToolName</span>
                                        <span class="tool-status">Running…</span>
                                    </div>
                                </div>
                            }
                            <div class="msg-content">@((MarkupString)FormatContent(_streamBuffer))</div>
                        </div>
                    </div>
                }
                <div @ref="_scrollAnchor"></div>
            </div>

            <div class="chat-input-bar">
                <input class="dcinput chat-input" @bind="_input" @bind:event="oninput"
                       placeholder="Ask about data, jobs, or request a graph…" disabled="@_streaming"
                       @onkeydown="InputKeydown" />
                <button class="dcbtn primary" disabled="@(_streaming || string.IsNullOrWhiteSpace(_input))" @onclick="Send">Send</button>
            </div>
        </div>

        @if (_showSidePanel)
        {
            <div class="side-panel">
                <div class="side-panel-head">
                    <h3>Agent Workspace</h3>
                    @if (_graphNodes.Count > 0)
                    {
                        <span class="graph-badge">@_graphNodes.Count nodes · @_graphLinks links</span>
                    }
                </div>

                @if (_showSessionList)
                {
                    <div class="side-section">
                        <div class="session-header">
                            <h4>Sessions</h4>
                            <button class="dcbtn xs" @onclick="NewSession">+ New</button>
                        </div>
                        @foreach (var s in _sessions.Take(20))
                        {
                            <div class="session-item @(s.Id == _sessionId ? "active" : "")" @onclick="@(() => SelectSessionAsync(s))">
                                <span class="session-title">@s.Title</span>
                                <span class="session-meta">@s.MessageCount msgs · @s.LastMessageAt.ToString("MMM d HH:mm")</span>
                            </div>
                        }
                    </div>
                }

                @if (_activeActions.Count > 0)
                {
                    <div class="side-section">
                        <h4>Active Actions</h4>
                        @foreach (var action in _activeActions)
                        {
                            <div class="action-item @action.Status.ToString().ToLower()">
                                <span class="action-icon">@GetActionIcon(action.Status)</span>
                                <span class="action-name">@action.ToolName</span>
                                <span class="action-detail">@action.Detail</span>
                            </div>
                        }
                    </div>
                }

                @if (_fetchedData.Count > 0)
                {
                    <div class="side-section">
                        <h4>Fetched Data</h4>
                        @foreach (var data in _fetchedData.TakeLast(10))
                        {
                            <details class="data-item">
                                <summary>@data.Source (@data.RowCount rows)</summary>
                                <pre class="data-preview">@data.Preview</pre>
                            </details>
                        }
                    </div>
                }

                @if (_graphNodes.Count > 0)
                {
                    <div class="side-section">
                        <h4>Project Graph</h4>
                        <div class="graph-nodes">
                            @foreach (var node in _graphNodes.Take(20))
                            {
                                <span class="graph-node-tag" title="@node.Label (@node.Degree connections)">@node.Label</span>
                            }
                        </div>
                    </div>
                }

                @if (_toolHistory.Count > 0)
                {
                    <div class="side-section">
                        <h4>Tool History</h4>
                        @foreach (var th in _toolHistory.TakeLast(15))
                        {
                            <div class="tool-history-item @(th.Success ? "ok" : "err")">
                                <span class="th-time">@th.Timestamp.ToString("HH:mm:ss")</span>
                                <span class="th-tool">@th.ToolName</span>
                                <span class="th-status">@th.Status</span>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>

    @if (_showSettings)
    {
        <div class="dcmodal-overlay" @onclick="CloseSettings">
            <div class="dcmodal settings-modal" @onclick:stopPropagation>
                <div class="dcmodal-head">
                    <h3>Agent Settings</h3>
                    <button class="dcslide-x" @onclick="CloseSettings">×</button>
                </div>
                <div class="dcmodal-body settings-body">
                    <div class="settings-tabs">
                        <button class="tab-btn @(_settingsTab == "prompt" ? "active" : "")" @onclick="@(() => _settingsTab = "prompt")">Prompt</button>
                        <button class="tab-btn @(_settingsTab == "rag" ? "active" : "")" @onclick="@(() => _settingsTab = "rag")">RAG</button>
                        <button class="tab-btn @(_settingsTab == "mcp" ? "active" : "")" @onclick="@(() => _settingsTab = "mcp")">MCP Servers</button>
                    </div>

                    @if (_settingsTab == "prompt")
                    {
                        <div class="dcfield">
                            <label>System Prompt</label>
                            <textarea class="dcinput textarea" @bind="_pendingSystemPrompt" rows="6"
                                placeholder="You are a PlaceContext agent. You can query project data, inspect job runs, and render graphs."></textarea>
                        </div>
                        <div class="settings-row">
                            <div class="dcfield">
                                <label>Temperature</label>
                                <div class="slider-row">
                                    <input type="range" class="dcslider" @bind="_pendingTemperature" min="0" max="1" step="0.1" />
                                    <span class="slider-val">@_pendingTemperature.ToString("0.0")</span>
                                </div>
                            </div>
                            <div class="dcfield">
                                <label>Max Tokens</label>
                                <input type="number" class="dcinput" @bind="_pendingMaxTokens" min="64" max="8192" step="64" />
                            </div>
                        </div>
                    }
                    else if (_settingsTab == "rag")
                    {
                        <div class="rag-settings">
                            <div class="rag-toggle">
                                <label class="toggle-switch">
                                    <input type="checkbox" @bind="_pendingRagEnabled" />
                                    <span class="toggle-slider"></span>
                                </label>
                                <span class="toggle-label">Enable RAG context retrieval</span>
                            </div>
                            <p class="rag-desc">Automatically retrieves semantically relevant project run outputs and dependency graph data to ground agent responses.</p>
                            @if (_pendingRagEnabled)
                            {
                                <div class="dcfield">
                                    <label>Max context chunks</label>
                                    <div class="slider-row">
                                        <input type="range" class="dcslider" @bind="_pendingMaxContextChunks" min="1" max="20" step="1" />
                                        <span class="slider-val">@_pendingMaxContextChunks</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (_settingsTab == "mcp")
                    {
                        <div class="mcp-section">
                            @if (_mcpConnections.Count == 0)
                            {
                                <div class="mcp-empty">
                                    <p>No MCP servers configured yet.</p>
                                    <span>Add external tool servers to extend agent capabilities.</span>
                                </div>
                            }
                            else
                            {
                                <div class="mcp-list">
                                    @foreach (var mcp in _mcpConnections)
                                    {
                                        <div class="mcp-item @(mcp.Enabled ? "" : "disabled")">
                                            <div class="mcp-info">
                                                <span class="mcp-name">@mcp.Name</span>
                                                <span class="mcp-badge">@mcp.Transport</span>
                                                @if (!string.IsNullOrEmpty(mcp.LastStatus))
                                                {
                                                    <span class="mcp-status @(mcp.LastStatus.StartsWith("connected") || mcp.LastStatus.StartsWith("http:2") ? "ok" : "err")">@mcp.LastStatus</span>
                                                }
                                            </div>
                                            <div class="mcp-actions">
                                                <button class="dcbtn xs" @onclick="@(() => TestMcpConnectionAsync(mcp.Id))">Test</button>
                                                <button class="dcbtn xs danger" @onclick="@(() => DeleteMcpConnectionAsync(mcp.Id))">×</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            <button class="dcbtn sm primary add-mcp-btn" @onclick="ShowAddMcp">+ Add MCP Server</button>

                            @if (_showAddMcp)
                            {
                                <div class="mcp-form">
                                    <div class="mcp-form-title">New MCP Server</div>
                                    <div class="dcfield">
                                        <label>Name</label>
                                        <input class="dcinput" @bind="_newMcpName" placeholder="My MCP Server" />
                                    </div>
                                    <div class="dcfield">
                                        <label>Transport</label>
                                        <select class="dcinput" @bind="_newMcpTransport">
                                            <option value="http">HTTP</option>
                                            <option value="sse">SSE</option>
                                            <option value="stdio">Stdio</option>
                                        </select>
                                    </div>
                                    @if (_newMcpTransport != "stdio")
                                    {
                                        <div class="dcfield">
                                            <label>Endpoint URL</label>
                                            <input class="dcinput" @bind="_newMcpEndpoint" placeholder="http://localhost:3001/mcp" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="dcfield">
                                            <label>Command</label>
                                            <input class="dcinput" @bind="_newMcpCommand" placeholder="npx" />
                                        </div>
                                        <div class="dcfield">
                                            <label>Args (JSON array)</label>
                                            <input class="dcinput" @bind="_newMcpArgs" placeholder='["-y", "@@modelcontextprotocol/server-filesystem", "/path"]' />
                                        </div>
                                    }
                                    <div class="mcp-auth-section">
                                        <div class="mcp-auth-header" @onclick="@(() => _showAuthFields = !_showAuthFields)">
                                            <span>Authentication</span>
                                            <span class="mcp-auth-chevron">@(_showAuthFields ? "▾" : "▸")</span>
                                        </div>
                                        @if (_showAuthFields)
                                        {
                                            <div class="dcfield">
                                                <label>Auth Type</label>
                                                <select class="dcinput" @bind="_newMcpAuthType">
                                                    <option value="none">None</option>
                                                    <option value="bearer">Bearer Token</option>
                                                    <option value="apikey">API Key</option>
                                                    <option value="header">Custom Header</option>
                                                </select>
                                            </div>
                                            @if (_newMcpAuthType == "bearer")
                                            {
                                                <div class="dcfield">
                                                    <label>Bearer Token</label>
                                                    <input class="dcinput" type="password" @bind="_newMcpAuthToken" placeholder="eyJhbGci..." />
                                                </div>
                                            }
                                            else if (_newMcpAuthType == "apikey")
                                            {
                                                <div class="dcfield">
                                                    <label>API Key</label>
                                                    <input class="dcinput" type="password" @bind="_newMcpAuthToken" placeholder="sk-..." />
                                                </div>
                                            }
                                            else if (_newMcpAuthType == "header")
                                            {
                                                <div class="dcfield">
                                                    <label>Header Name</label>
                                                    <input class="dcinput" @bind="_newMcpAuthHeader" placeholder="X-API-Key" />
                                                </div>
                                                <div class="dcfield">
                                                    <label>Header Value</label>
                                                    <input class="dcinput" type="password" @bind="_newMcpAuthToken" placeholder="value" />
                                                </div>
                                            }
                                        }
                                    </div>
                                    <div class="mcp-form-actions">
                                        <button class="dcbtn xs" @onclick="@(() => _showAddMcp = false)">Cancel</button>
                                        <button class="dcbtn xs primary" @onclick="AddMcpConnectionAsync">Add</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
                <div class="dcmodal-foot">
                    <button class="dcbtn" @onclick="CloseSettings">Cancel</button>
                    <button class="dcbtn primary" @onclick="SaveSettings">Save</button>
                </div>
            </div>
        </div>
    }
</div>



@code {
    private readonly List<AgentMessage> _messages = new();
    private string _input = "";
    private bool _streaming;
    private string _streamBuffer = "";
    private ElementReference _messagesRef;
    private ElementReference _scrollAnchor;
        private Guid? _projectId;
    private string _systemPrompt = "You are a PlaceContext agent. You can query project data, inspect job runs, and render graphs. Use tools when the user asks about data, jobs, or requests visualizations.";
    private bool _ragEnabled = true;
    private int _maxContextChunks = 5;
    private float _temperature = 0.7f;
    private int _maxTokens = 2048;
    private bool _toolCallingEnabled = true;
    private IReadOnlyList<ProjectSummaryView> _projects = Array.Empty<ProjectSummaryView>();
    private string _projectName = "";
    private ToolCallInfo? _currentToolCall;
    private int _toolCallCounter;
    private bool _showSidePanel = true;
    private bool _showSettings;
    private string _settingsTab = "prompt";
    private IReadOnlyList<McpConnectionView> _mcpConnections = Array.Empty<McpConnectionView>();
    private bool _showAddMcp;
    private bool _showAuthFields;
    private string _newMcpName = "";
    private string _newMcpTransport = "http";
    private string _newMcpEndpoint = "";
    private string _newMcpCommand = "";
    private string _newMcpArgs = "";
    private string _newMcpAuthType = "none";
    private string _newMcpAuthToken = "";
    private string _newMcpAuthHeader = "";
    private string _pendingSystemPrompt = "";
    private float _pendingTemperature;
    private int _pendingMaxTokens;
    private bool _pendingRagEnabled = true;
    private int _pendingMaxContextChunks = 5;
    private Guid? _sessionId;
    private string _sessionTitle = "New Chat";
    private IReadOnlyList<ChatSessionSummary> _sessions = Array.Empty<ChatSessionSummary>();
    private bool _showSessionList = true;
    private readonly List<AgentAction> _activeActions = new();
    private readonly List<FetchedData> _fetchedData = new();
    private readonly List<ToolHistoryEntry> _toolHistory = new();
    private readonly List<GraphNodeView> _graphNodes = new();
    private int _graphLinks;

    protected override async Task OnInitializedAsync()
    {
        Ui.Set("Chat", "Agent inference");
        _projects = await Svc.GetProjectsAsync();
        if (_projects.Count > 0)
        {
            _projectId = _projects[0].Id;
            _projectName = _projects[0].Name;
            await LoadAgentConfig();
        }
    }

    private async Task LoadAgentConfig()
    {
        if (!_projectId.HasValue) return;
        try
        {
            var config = await Svc.GetAgentConfigAsync(_projectId.Value);
            _systemPrompt = config.SystemPrompt;
            _temperature = config.Temperature;
            _maxContextChunks = config.MaxContextChunks;
        }
        catch { /* use defaults */ }
    }

    private async Task OnProjectChanged()
    {
        if (_projectId.HasValue)
        {
            _projectName = _projects.FirstOrDefault(p => p.Id == _projectId.Value)?.Name ?? "";
            await LoadAgentConfig();
            await LoadGraphAsync();
            _activeActions.Clear();
            _fetchedData.Clear();
            _toolHistory.Clear();
            await LoadSessionsAsync();
            await LoadMcpConnectionsAsync();
            NewSession();
        }
    }

    private async Task LoadSessionsAsync()
    {
        if (!_projectId.HasValue) return;
        try { _sessions = await MemoryStore.ListSessionsAsync(_projectId.Value); }
        catch { _sessions = Array.Empty<ChatSessionSummary>(); }
    }

    private void NewSession()
    {
        _sessionId = Guid.NewGuid();
        _sessionTitle = "New Chat";
        _messages.Clear();
        _streamBuffer = "";
        StateHasChanged();
    }

    private async Task SelectSessionAsync(ChatSessionSummary session)
    {
        if (!_projectId.HasValue) return;
        try
        {
            var memory = await MemoryStore.GetSessionAsync(session.Id);
            if (memory != null)
            {
                _sessionId = session.Id;
                _sessionTitle = memory.Title;
                _messages.Clear();
                foreach (var m in memory.Messages)
                {
                    var msg = new AgentMessage(m.Role, m.Content);
                    if (m.ToolCalls != null)
                        msg.ToolCalls.AddRange(m.ToolCalls.Select(tc => new ToolCallInfo
                        {
                            ToolName = tc.ToolName,
                            Args = tc.Args,
                            Status = Enum.TryParse<ToolCallStatus>(tc.Status, out var s) ? s : ToolCallStatus.Completed,
                            Result = tc.Result,
                            ResultType = tc.ResultType,
                        }));
                    _messages.Add(msg);
                }
                StateHasChanged();
            }
        }
        catch { }
    }

    private async Task SaveCurrentSessionAsync()
    {
        if (!_projectId.HasValue || _sessionId == null) return;
        var memory = new ChatSessionMemory(
            _sessionId.Value, _projectId.Value, _sessionTitle,
            _messages.Select(m => new ChatMemoryMessage(
                m.Role, m.Content, DateTimeOffset.Now,
                m.ToolCalls.Select(tc => new ChatMemoryToolCall(
                    tc.ToolName, tc.Args, tc.Status.ToString(), tc.Result, tc.ResultType)).ToList())).ToList(),
            DateTimeOffset.Now, DateTimeOffset.Now);
        try { await MemoryStore.SaveSessionAsync(_sessionId.Value, memory); }
        catch { }
        await LoadSessionsAsync();
    }

    

    private async Task Send()
    {
        var text = _input.Trim();
        if (string.IsNullOrEmpty(text) || _streaming || !_projectId.HasValue) return;

        _messages.Add(new AgentMessage("user", text));
        _input = "";
        _streaming = true;
        _streamBuffer = "";
        StateHasChanged();
        await ScrollToBottom();

        // Build RAG context once before the tool loop.
        string ragContext = "";
        if (_ragEnabled)
        {
            try { ragContext = await ContextBuilder.BuildContextAsync(_projectId.Value, text, _maxContextChunks); }
            catch { /* best-effort */ }
        }

        try
        {
            var ct = CancellationToken.None;
            var maxToolRounds = 3;
            var round = 0;

            while (round < maxToolRounds)
            {
                round++;
                var messages = BuildChatMessages(ragContext);

                _streamBuffer = "";
                _currentToolCall = null;
                StateHasChanged();

                if (Gateway is ClusterChatGateway cg && cg.IsEnabled)
                {
                    var settings = new ChatSettings(Temperature: _temperature, MaxTokens: _maxTokens);
                    await foreach (var token in cg.ChatStreamAsync(messages, settings, ct))
                    {
                        _streamBuffer += token;
                        StateHasChanged();
                        await ScrollToBottom();
                    }
                }
                else if (Gateway is ClusterChatGateway configuredButNotReady && !configuredButNotReady.IsEnabled)
                {
                    _streamBuffer = "Cluster is starting — please try again in a moment.";
                }
                else
                {
                    var settings = new ChatSettings(Temperature: _temperature, MaxTokens: _maxTokens);
                    _streamBuffer = await Gateway.ChatAsync(messages, settings, ct);
                }

                var toolCalls = ParseToolCalls(_streamBuffer);
                if (toolCalls.Count == 0) break;

                var toolResults = new System.Text.StringBuilder();
                toolResults.Append("\n\n## Tool Results\n\n");
                foreach (var tc in toolCalls)
                {
                    _currentToolCall = tc;
                    tc.Status = ToolCallStatus.Running;
                    StateHasChanged();

                    var result = await ExecuteToolAsync(tc.ToolName, tc.Args, ct);
                    tc.Status = result.Success ? ToolCallStatus.Completed : ToolCallStatus.Error;
                    tc.Result = result.Data ?? result.Error;
                    tc.ResultType = result.IsGraph ? "graph" : "text";

                    toolResults.Append("### " + tc.ToolName + "\n");
                    toolResults.Append("Args: " + tc.Args + "\n");
                    toolResults.Append(result.Success ? "Result:\n" : "Error:\n");
                    toolResults.Append(result.Data ?? result.Error);
                    toolResults.Append("\n\n");
                }

                var assistantMsg = new AgentMessage("assistant", _streamBuffer);
                assistantMsg.ToolCalls.AddRange(toolCalls);
                _messages.Add(assistantMsg);
                _messages.Add(new AgentMessage("system", toolResults.ToString()));
                _streamBuffer = "";
                StateHasChanged();
                await ScrollToBottom();
            }

            if (_messages.Count == 0 || _messages.Last().Role != "assistant")
                _messages.Add(new AgentMessage("assistant", _streamBuffer));
        }
        catch (Exception ex)
        {
            _messages.Add(new AgentMessage("assistant", $"[error: {ex.Message}]"));
        }
        finally
        {
            _streaming = false;
            _streamBuffer = "";
            _currentToolCall = null;
            await SaveCurrentSessionAsync();
            StateHasChanged();
            await ScrollToBottom();
        }
    }

    private List<ChatMessage> BuildChatMessages(string ragContext = "")
    {
        var toolDesc = "Available tools (use [[tool:toolName|args]] syntax): " +
            "[[tool:list_tables|]] - List tables, " +
            "[[tool:query_table|tableName|page]] - Query table, " +
            "[[tool:list_jobs|]] - List jobs, " +
            "[[tool:list_job_runs|jobId]] - List runs, " +
            "[[tool:render_graph|bar|table|col]] - Chart, " +
            "[[tool:query_graph|]] - Query project graph for entities/relationships, " +
            "[[tool:schedule_job|jobId|name|cron]] - Create cron schedule, " +
            "[[tool:list_schedules|jobId]] - List job schedules, " +
            "[[tool:toggle_schedule|triggerId|true|false]] - Enable/disable schedule, " +
            "[[tool:run_job|jobId]] - Run job now";

        var systemPrompt = _systemPrompt + "\n\n" + toolDesc;
        if (!string.IsNullOrWhiteSpace(ragContext))
        {
            systemPrompt += "\n\n## Project context (retrieved automatically)\n\n" + ragContext;
        }

        var messages = new List<ChatMessage>
        {
            new("system", systemPrompt),
        };
        foreach (var m in _messages.Where(x => x.Role != "system" || x.Content.Contains("Tool Results")))
            messages.Add(new ChatMessage(m.Role, m.Content));
        return messages;
    }

    private List<ToolCallInfo> ParseToolCalls(string response)
    {
        var calls = new List<ToolCallInfo>();
        var pattern = @"\[\[tool:(\w+)\|([^\]]*)\]\]";
        foreach (System.Text.RegularExpressions.Match m in System.Text.RegularExpressions.Regex.Matches(response, pattern))
        {
            calls.Add(new ToolCallInfo { ToolName = m.Groups[1].Value, Args = m.Groups[2].Value });
        }
        return calls;
    }


