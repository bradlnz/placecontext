    // ── OAuth flow ──────────────────────────────────────────────────────────────────

    private bool _oauthListenerRegistered;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (!_oauthListenerRegistered)
            {
                _oauthListenerRegistered = true;
                var dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("eval", @"
                    window.__mcpOAuthListener = function(e) {
                        if (e.data && e.data.startsWith && e.data.startsWith('mcp-oauth-')) {
                            DotNet.invokeMethodAsync('PlaceContext.Host', 'OnMcpOAuthCallback', e.data);
                        }
                    };
                    window.addEventListener('message', window.__mcpOAuthListener);
                ");
            }
            // Set up file drop zone
            await JS.InvokeVoidAsync("placecontext.setupDropZone", _fileInputRef);

            // Hide side panel by default on narrow screens so the chat area is usable.
            try
            {
                if (await JS.InvokeAsync<bool>("placecontext.isMobile"))
                {
                    _showSidePanel = false;
                    StateHasChanged();
                }
            }
            catch { }
        }

        // Render any pending chart canvases
        foreach (var msg in _messages)
        {
            foreach (var tc in msg.ToolCalls.Where(t => t.ResultType == "graph" && t.Status == ToolCallStatus.Completed))
            {
                if (_renderedChartIds.Contains(tc.Id)) continue;
                try
                {
                    await JS.InvokeVoidAsync("pcchart.render", $"graph-{tc.Id}", tc.Result);
                    _renderedChartIds.Add(tc.Id);
                }
                catch { /* canvas not in DOM yet — will retry next render */ }
            }

            foreach (var tc in msg.ToolCalls.Where(t => t.ResultType == "map" && t.Status == ToolCallStatus.Completed))
            {
                if (_renderedMapIds.Contains(tc.Id)) continue;
                try
                {
                    await JS.InvokeVoidAsync("pcmap.render", $"map-{tc.Id}", tc.Result);
                    _renderedMapIds.Add(tc.Id);
                }
                catch { /* container not in DOM yet — will retry next render */ }
            }
        }
    }

    private async Task StartOAuthFlow(Guid connectionId)
    {
        await JS.InvokeVoidAsync("open", $"/mcp-oauth/start?connectionId={connectionId}", "_blank");
    }

    [JSInvokable]
    public static async Task OnMcpOAuthCallback(string message)
    {
        // This is called from JS when the popup sends a message.
        // We can't directly update the component state from a static method,
        // so we use a static event that components can subscribe to.
        OnMcpOAuthCompleted?.Invoke(null, EventArgs.Empty);
    }

    internal static event EventHandler? OnMcpOAuthCompleted;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        OnMcpOAuthCompleted += OnMcpOAuthCompletedHandler;
    }

    // ── Human-in-the-loop clarification ──────────────────────────────────

    private void ToggleClarificationOption(string id)
    {
        if (_clarificationSelected.Contains(id))
            _clarificationSelected.Remove(id);
        else
            _clarificationSelected.Add(id);
        StateHasChanged();
    }

    private void CancelClarification()
    {
        _pendingClarification = null;
        _clarificationSelected.Clear();
        _clarificationTcs?.TrySetResult(new ClarificationResult { Confirmed = false });
        _clarificationTcs = null;
        StateHasChanged();
    }

    private void SubmitClarification()
    {
        if (_pendingClarification == null) return;

        // Build a user message showing what was selected (for LLM context)
        var selectedLabels = _pendingClarification.Options
            .Where(o => _clarificationSelected.Contains(o.Id))
            .Select(o => o.Label)
            .ToList();

        var userResponse = selectedLabels.Count == 1
            ? $"Selected: {selectedLabels[0]}"
            : $"Selected: {string.Join(", ", selectedLabels)}";

        // Add the user's selection as a message so the LLM sees it
        _messages.Add(new AgentMessage("user", userResponse));

        var result = new ClarificationResult
        {
            Confirmed = true,
            SelectedIds = _clarificationSelected.ToList()
        };
        _pendingClarification = null;
        _clarificationSelected.Clear();
        _clarificationTcs?.TrySetResult(result);
        _clarificationTcs = null;
        StateHasChanged();
    }

    private async Task<ClarificationResult> AskClarificationAsync(ClarificationRequest request)
    {
        _clarificationSelected.Clear();
        _pendingClarification = request;
        _clarificationTcs = new TaskCompletionSource<ClarificationResult>();
        StateHasChanged();
        await ScrollToBottom();
        return await _clarificationTcs.Task;
    }

    private static bool IsTransientError(string error)
    {
        if (string.IsNullOrEmpty(error)) return false;
        var lower = error.ToLowerInvariant();
        return lower.Contains("timeout")
            || lower.Contains("econnreset")
            || lower.Contains("econnrefused")
            || lower.Contains("socket")
            || lower.Contains("503")
            || lower.Contains("502")
            || lower.Contains("429")
            || lower.Contains("rate limit");
    }

    private void PreventDefault() { }

    private async Task TriggerFileInput()
    {
        await JS.InvokeVoidAsync("placecontext.clickElement", _fileInputRef);
    }

    private async Task OnFileSelected(ChangeEventArgs e)
    {
        await ProcessFileFromInput();
    }

    private async Task ProcessFileFromInput()
    {
        try
        {
            var file = await JS.InvokeAsync<UploadedFile>("placecontext.readFileInput", _fileInputRef);
            if (file == null || file.Size == 0) return;
            if (file.Size > 10 * 1024 * 1024) // 10 MB limit
            {
                _attachedFileName = null;
                _attachedFile = null;
                _attachedFileText = null;
                return;
            }
            _attachedFile = file.Data;
            _attachedFileName = file.Name;
            _attachedFileText = DocExtractor.ExtractText(file.Data, file.Name);
            await InvokeAsync(StateHasChanged);
            await SendAttachmentSummaryAsync();
        }
        catch { }
    }

    private async Task OnFileDrop(DragEventArgs e)
    {
        try
        {
            var file = await JS.InvokeAsync<UploadedFile>("placecontext.dropFile");
            if (file == null || file.Size == 0) return;
            if (file.Size > 10 * 1024 * 1024) return;
            _attachedFile = file.Data;
            _attachedFileName = file.Name;
            _attachedFileText = DocExtractor.ExtractText(file.Data, file.Name);
            await InvokeAsync(StateHasChanged);
            await SendAttachmentSummaryAsync();
        }
        catch { }
    }

    private async Task SendAttachmentSummaryAsync()
    {
        if (_attachedFileName == null || _streaming) return;
        _input = $"Please summarize the attached file \"{_attachedFileName}\" and ask what I would like to do with it.";
        await Send();
    }

    private void RemoveAttachment()
    {
        _attachedFile = null;
        _attachedFileName = null;
        _attachedFileText = null;
    }

    private static string SanitizeFileName(string name)
    {
        var cleaned = string.Concat(name.Select(c => char.IsLetterOrDigit(c) || c is '.' or '-' or '_' ? c : '-'));
        return cleaned.Length > 80 ? cleaned[..80] : cleaned;
    }

    private static string ContentTypeFor(string fileName) =>
        System.IO.Path.GetExtension(fileName).ToLowerInvariant() switch
        {
            ".csv" => "text/csv",
            ".pdf" => "application/pdf",
            ".doc" => "application/msword",
            ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".txt" or ".md" => "text/plain",
            ".png" => "image/png",
            ".jpg" or ".jpeg" => "image/jpeg",
            _ => "application/octet-stream",
        };

    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:0.#} KB",
        _ => $"{bytes / (1024.0 * 1024.0):0.#} MB",
    };

