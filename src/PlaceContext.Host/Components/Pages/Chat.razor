    private static List<string> ParseNumberedOptions(string content)
    {
        if (string.IsNullOrWhiteSpace(content)) return new();
        // Match patterns like "1. Option text" or "1) Option text" at start of line
        var matches = System.Text.RegularExpressions.Regex.Matches(
            content, @"^\s*\d+[.)]\s+(.+)$",
            System.Text.RegularExpressions.RegexOptions.Multiline);
        if (matches.Count < 2) return new(); // Need at least 2 options to show picker
        return matches.Select(m => m.Groups[1].Value.Trim()).ToList();
    }

