@page "/chat"
@attribute [Authorize(Policy = Permission.AgentsChat)]
@layout PlaceContext.Host.Components.Layout.MainLayout
@implements IDisposable
@using PlaceContext.Application.Dtos
@using PlaceContext.Application.Features
@using PlaceContext.Application.Mcp
@using PlaceContext.AgentChat.Infrastructure.Chat
@using PlaceContext.AgentChat.Infrastructure.Caching
@using PlaceContext.Host.Components.ViewModels
@using PlaceContext.Host.Components.ViewModels.Helpers
@inject ChatViewModel Vm

<PageTitle>placecontext — Agent Chat</PageTitle>

<div class="page">
    <div class="page-head">
        <div>
            <h2 class="page-title">Agent Chat</h2>
            <div class="page-sub">
                @if (Vm.Gateway is ClusterChatGateway cg)
                {
                    <span>@cg.StatusText — @Vm.ProjectName</span>
                }
                else if (Vm.Gateway.IsEnabled)
                {
                    <span>Chat backend active</span>
                }
                else
                {
                    <span>No model configured</span>
                }
            </div>
        </div>
        <div class="chat-controls">
            @if (Vm.ProjectId.HasValue)
            {
                <button class="dcbtn sm" @onclick="Vm.ToggleSidePanel">@(Vm.ShowSidePanel ? "Hide Panel" : "Show Panel")</button>
                <button class="dcbtn sm" @onclick="Vm.OpenSettingsAsync">⚙ Settings</button>
            }
        </div>
    </div>

    <div class="chat-layout">
        <div class="chat-area">
            <div class="chat-messages" @ref="Vm.MessagesElement">
                @if (Vm.Messages.Count == 0)
                {
                    <div class="empty-note chat-empty">
                        <p>Ask me about your project data, job runs, or request a graph.</p>
                        @if (Vm.ProjectId.HasValue && Vm.GatewayReady)
                        {
                            <div class="starter-actions">
                                <button class="starter-btn" @onclick="@(() => Vm.StarterPromptFromUiAsync("Give me an overview of this project"))">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                        <circle cx="12" cy="12" r="10" />
                                        <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                                        <line x1="12" y1="17" x2="12.01" y2="17" />
                                    </svg>
                                    Project overview
                                </button>
                                <button class="starter-btn" @onclick="@(() => Vm.StarterPromptFromUiAsync("Show me the recent job runs and their status"))">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                                    Recent job runs
                                </button>
                                <button class="starter-btn" @onclick="@(() => Vm.StarterPromptFromUiAsync("What are the hotspots in the project dependency graph?"))">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                        <circle cx="5" cy="6" r="3" /><circle cx="19" cy="6" r="3" />
                                        <circle cx="12" cy="18" r="3" />
                                        <line x1="8" y1="8" x2="10" y2="15" /><line x1="16" y1="8" x2="14" y2="15" />
                                    </svg>
                                    Graph hotspots
                                </button>
                                <button class="starter-btn" @onclick="@(() => Vm.StarterPromptFromUiAsync("List the recent artifacts produced by job runs"))">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                        <polyline points="14 2 14 8 20 8" />
                                    </svg>
                                    Recent artifacts
                                </button>
                                <button class="starter-btn" @onclick="@(() => Vm.StarterPromptFromUiAsync("List the project data tables"))">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                        <ellipse cx="12" cy="5" rx="9" ry="3" />
                                        <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                                    </svg>
                                    Data tables
                                </button>
                            </div>
                        }
                        <p class="hint">Or type your own question below.</p>
                    </div>
                }
                else
                {
                    @foreach (var msg in Vm.Messages.Where(Vm.IsVisible))
                    {
                        <div class="chat-msg @msg.Role">
                            <div class="msg-avatar @(Vm.IsUser(msg) ? "avatar-user" : "avatar-bot")">
                                @if (Vm.IsUser(msg))
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                                }
                                else
                                {
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                                }
                            </div>
                            <div class="msg-body">
                                <div class="msg-role-row">
                                    <span class="msg-role">@msg.Role</span>
                                    @if (Vm.IsAssistant(msg) && !Vm.Streaming)
                                    {
                                        <button class="msg-copy-btn" @onclick="@(() => Vm.CopyMessageAsync(msg.Content))" title="Copy response">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12">
                                                <rect x="9" y="9" width="13" height="13" rx="2" />
                                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                                            </svg>
                                        </button>
                                    }
                                </div>
                                @if (msg.ToolCalls.Count > 0)
                                {

                                    @* Show graphs inline *@
                                    @foreach (var tc in Vm.GraphCalls(msg))
                                    {
                                        <div class="chat-chart-wrap">
                                            <canvas id="graph-@tc.Id"></canvas>
                                        </div>
                                    }

                                    @* Show maps inline *@
                                    @foreach (var tc in Vm.MapCalls(msg))
                                    {
                                        <div class="chat-map-wrap">
                                            <div id="map-@tc.Id" class="chat-map-container"></div>
                                        </div>
                                    }

                                    @* Show artifacts inline *@
                                    @foreach (var tc in Vm.ArtifactCalls(msg))
                                    {
                                        <div class="chat-artifact-wrap">
                                            @Vm.RenderArtifact(tc)
                                        </div>
                                    }

                                    @* Show other tool calls in expandable details *@
                                    @if (Vm.OtherCalls(msg).Count > 0)
                                    {
                                        <details class="tool-calls-expandable">
                                            <summary class="tool-calls-summary">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M9 18l6-6-6-6"/></svg>
                                                <span>@Vm.OtherCalls(msg).Count tool call@(Vm.OtherCalls(msg).Count > 1 ? "s" : "")</span>
                                                @if (Vm.CompletedOtherCallCount(msg) > 0)
                                                {
                                                    <span class="tc-badge tc-ok">@Vm.CompletedOtherCallCount(msg) ok</span>
                                                }
                                                @if (Vm.ErrorOtherCallCount(msg) > 0)
                                                {
                                                    <span class="tc-badge tc-err">@Vm.ErrorOtherCallCount(msg) err</span>
                                                }
                                            </summary>
                                            <div class="tool-calls">
                                                @foreach (var tc in Vm.OtherCalls(msg))
                                                {
                                                    <div class="tool-call @Vm.StatusClass(tc.Status)">
                                                        <span class="tool-name">@tc.ToolName</span>
                                                        <span class="tool-status">@tc.Status</span>
                                                        @if (tc.Status == AgentToolCallStatus.Error && !string.IsNullOrEmpty(tc.Result))
                                                        {
                                                            <span class="tool-error-text">@tc.Result</span>
                                                        }
                                                        @if (tc.Status == AgentToolCallStatus.Completed && !string.IsNullOrEmpty(tc.Result))
                                                        {
                                                            <details class="tool-result">
                                                                <summary>View result</summary>
                                                                <div class="tool-output-formatted">@((MarkupString)Vm.FormatToolResult(tc.Result))</div>
                                                            </details>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </details>
                                    }
                                }
                                @if (msg.AttachmentName != null)
                                {
                                    <div class="msg-attachment">
                                        @if (msg.AttachmentKey != null)
                                        {
                                            <a class="attachment-tile" href="/chat/attachments/@msg.AttachmentKey" target="_blank" title="Open attachment">
                                                <span class="file-tile-icon">@Vm.FileLabel(msg.AttachmentName)</span>
                                                <span class="file-tile-copy">
                                                    <strong>@msg.AttachmentName</strong>
                                                    <small>
                                                        @(msg.AttachmentSizeBytes > 0 ? Vm.Presentation.Bytes(msg.AttachmentSizeBytes) : "attached")
                                                        · @(msg.AttachmentParsed ? $"{msg.AttachmentExtractedChars:N0} characters parsed" : "no readable text")
                                                    </small>
                                                </span>
                                                <span class="file-tile-open">↗</span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="attachment-tile">
                                                <span class="file-tile-icon">@Vm.FileLabel(msg.AttachmentName)</span>
                                                <span class="file-tile-copy">
                                                    <strong>@msg.AttachmentName</strong>
                                                    <small>
                                                        @(msg.AttachmentSizeBytes > 0 ? Vm.Presentation.Bytes(msg.AttachmentSizeBytes) : "attached")
                                                        · @(msg.AttachmentParsed ? $"{msg.AttachmentExtractedChars:N0} characters parsed" : "no readable text")
                                                    </small>
                                                </span>
                                            </span>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(msg.Thinking))
                                {
                                    <details class="thinking-expandable">
                                        <summary class="thinking-summary">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M9 18l6-6-6-6"/></svg>
                                            <span>Thinking</span>
                                        </summary>
                                        <div class="thinking-content">@msg.Thinking</div>
                                    </details>
                                }
                                @if (!string.IsNullOrWhiteSpace(msg.Content))
                                {
                                    <div class="msg-content">@((MarkupString)Vm.FormatContent(msg.Content))</div>
                                }
                                @{
                                    if (Vm.NumberedOptions(msg).Count > 0 && Vm.IsAssistant(msg) && !Vm.Streaming)
                                    {
                                        <div class="option-picker" data-msg-id="@msg.Id">
                                            @foreach (var opt in Vm.NumberedOptions(msg))
                                            {
                                                <label class="option-item">
                                                    <input type="checkbox" value="@opt" />
                                                    <span>@opt</span>
                                                </label>
                                            }
                                            <button class="dcbtn xs primary" @onclick="@(() => Vm.SubmitOptionsFromUiAsync(msg.Id))">Continue</button>
                                        </div>
                                    }
                                }
                                @if (Vm.IsAssistant(msg) && !Vm.Streaming)
                                {
                                    <div class="quick-actions">
                                        <button class="qa-btn" @onclick="@(() => Vm.QuickActionFromUiAsync(msg.Content, "summarize"))" title="Summarize">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="M4 6h16M4 12h10M4 18h14"/></svg>
                                            Summarize
                                        </button>
                                        <button class="qa-btn" @onclick="@(() => Vm.QuickActionFromUiAsync(msg.Content, "explain"))" title="Explain in detail">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                                <circle cx="12" cy="12" r="10" />
                                                <path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" />
                                                <line x1="12" y1="17" x2="12.01" y2="17" />
                                            </svg>
                                            Explain
                                        </button>
                                        <button class="qa-btn" @onclick="@(() => Vm.QuickActionFromUiAsync(msg.Content, "code"))" title="Generate code">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
                                            Code
                                        </button>
                                        <button class="qa-btn" @onclick="@(() => Vm.QuickActionFromUiAsync(msg.Content, "graph"))" title="Visualize as graph">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                                <circle cx="5" cy="6" r="3" />
                                                <circle cx="19" cy="6" r="3" />
                                                <circle cx="12" cy="18" r="3" />
                                                <line x1="8" y1="8" x2="10" y2="15" />
                                                <line x1="16" y1="8" x2="14" y2="15" />
                                            </svg>
                                            Graph
                                        </button>
                                        <button class="qa-btn" @onclick="@(() => Vm.CopyMessageAsync(msg.Content))" title="Copy to clipboard">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                                <rect x="9" y="9" width="13" height="13" rx="2" />
                                                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
                                            </svg>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                @if (Vm.Streaming)
                {
                    <div class="chat-msg assistant">
                        <div class="msg-avatar avatar-bot">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                        </div>
                        <div class="msg-body">
                            <div class="msg-role">assistant</div>
                            @if (Vm.CurrentToolCall != null)
                            {
                                <div class="tool-calls">
                                    <div class="tool-call running">
                                        <span class="tool-name">@Vm.CurrentToolCall.ToolName</span>
                                        <span class="tool-status">Running…</span>
                                        @if (Vm.CurrentToolCall.RetryCount > 0)
                                        {
                                            <span class="retry-badge">retry @Vm.CurrentToolCall.RetryCount</span>
                                        }
                                    </div>
                                </div>
                            }
                            @if (Vm.CurrentToolCall == null && string.IsNullOrEmpty(Vm.StreamBuffer))
                            {
                                <div class="typing-dots">
                                    <span></span>
                                    <span></span>
                                    <span></span>
                                </div>
                            }
                            else if (!string.IsNullOrEmpty(Vm.StreamBuffer))
                            {
                                @if (!string.IsNullOrWhiteSpace(Vm.StreamThinking))
                                {
                                    <details class="thinking-expandable" open>
                                        <summary class="thinking-summary">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M9 18l6-6-6-6"/></svg>
                                            <span>Thinking…</span>
                                        </summary>
                                        <div class="thinking-content">@Vm.StreamThinking</div>
                                    </details>
                                }
                                @if (!string.IsNullOrWhiteSpace(Vm.StreamAnswer))
                                {
                                    <div class="msg-content">@((MarkupString)Vm.FormatContent(Vm.StreamAnswer))</div>
                                }
                            }
                        </div>
                    </div>
                }
                @if (Vm.PendingClarification != null)
                {
                    <div class="chat-msg assistant">
                        <div class="msg-avatar avatar-bot">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                        </div>
                        <div class="msg-body">
                            <div class="msg-role">assistant</div>
                            <div class="clarification-panel">
                                <div class="clarification-title">@Vm.PendingClarification.Question</div>
                                <div class="clarification-options">
                                    @foreach (var opt in Vm.PendingClarification.Options)
                                    {
                                        var isSelected = Vm.ClarificationSelected.Contains(opt.Id);
                                        <label class="clarification-option @(isSelected ? "selected" : "")">
                                            <input type="checkbox"
                                                   checked="@isSelected"
                                                   @onchange="@(_ => Vm.ToggleClarificationOption(opt.Id))" />
                                            <span class="clarification-option-label">@opt.Label</span>
                                            @if (!string.IsNullOrEmpty(opt.Description))
                                            {
                                                <span class="clarification-option-desc">@opt.Description</span>
                                            }
                                        </label>
                                    }
                                </div>
                                <div class="clarification-actions">
                                    <button class="dcbtn xs" @onclick="Vm.CancelClarification">Cancel</button>
                                    <button class="dcbtn xs primary"
                                                disabled="@(Vm.ClarificationSelected.Count == 0)"
                                                @onclick="Vm.SubmitClarification">Continue</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                <div @ref="Vm.ScrollAnchorElement"></div>
            </div>

            @if (Vm.WorkspaceLoaded)
            {
            <div class="chat-input-wrap" @ref="Vm.DropZoneElement">
                <div class="chat-input-bar">
                    <button type="button" class="chat-attach-btn" title="Attach file (CSV, JSON, text, PDF, DOCX, XLSX)"
                            aria-label="Attach file" @onclick="Vm.OpenFilePicker">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <path d="M21.44 11.05l-9.19 9.19a6 6 0 01-8.49-8.49l9.19-9.19a4 4 0 015.66 5.66l-9.2 9.19a2 2 0 01-2.83-2.83l8.49-8.48"/>
                        </svg>
                    </button>
                    <InputFile @key="Vm.FileInputVersion" id="chat-file-input" OnChange="@(e => Vm.ImportFileAsync(e.File))"
                               accept=".csv,.tsv,.json,.txt,.md,.xml,.yaml,.yml,.pdf,.docx,.xlsx"
                               class="hidden-file-input" style="display:none" />
                    <div class="chat-input-outer">
                        @if (Vm.ShowCommandSuggestions)
                        {
                            <div class="cmd-suggest">
                                @foreach (var cmd in Vm.FilteredCommands)
                                {
                                    <div class="cmd-suggest-item @(cmd == Vm.FilteredCommands[Vm.SelectedCommandIndex] ? "hover" : "")"
                                         @onmousedown="@(() => Vm.SelectCommand(cmd))"
                                         @onmouseenter="@(() => Vm.HighlightCommand(cmd))">
                                        <span class="cmd-suggest-name">/<span>@cmd.Name</span></span>
                                        @if (!string.IsNullOrWhiteSpace(cmd.Description))
                                        {
                                            <span class="cmd-suggest-desc">@cmd.Description</span>
                                        }
                                        <span class="cmd-suggest-tool">@cmd.ToolName</span>
                                    </div>
                                }
                            </div>
                        }
                        <input class="dcinput chat-input" @bind="Vm.Input" @bind:event="oninput"
                               @bind:after="Vm.HandleInputChanged"
                               placeholder="@(Vm.PendingClarification != null ? "Respond to the question above…" : "Ask about data, jobs, or request a graph…")"
                               disabled="@(Vm.Streaming && Vm.PendingClarification == null)"
                               @onkeydown="@(e => Vm.HandleInputKeydownAsync(e, Vm.MessagesElement, Vm.ScrollAnchorElement))" />
                    </div>
                    @if (Vm.Streaming && Vm.PendingClarification == null)
                    {
                        <button class="dcbtn danger" @onclick="Vm.StopFromUiAsync">Stop</button>
                    }
                    else
                    {
                        <button class="dcbtn primary"
                                disabled="@(string.IsNullOrWhiteSpace(Vm.Input) && Vm.AttachedFile is null)"
                                @onclick="Vm.SendFromUiAsync">Send</button>
                    }
                </div>
                @if (Vm.AttachedFileName != null)
                {
                    <div class="attached-file-tile">
                        <span class="file-tile-icon compact">@Vm.FileLabel(Vm.AttachedFileName)</span>
                        <span class="file-tile-copy">
                            <strong>@Vm.AttachedFileName</strong>
                            <small>
                                @(Vm.AttachedFile is null ? "attached" : Vm.Presentation.Bytes(Vm.AttachedFile.Length))
                                · @(Vm.AttachedFileText is not null ? $"{Vm.AttachedFileText.Length:N0} characters ready" : "no readable text")
                            </small>
                        </span>
                        <button class="chip-remove" @onclick="Vm.RemoveAttachment" title="Remove file">×</button>
                    </div>
                }
                @if (Vm.AttachmentError is not null)
                {
                    <div class="attachment-error">@Vm.AttachmentError</div>
                }
            </div>
            }
        </div>

        @if (Vm.ShowSidePanel)
        {
            <div class="side-panel-scrim" aria-hidden="true" @onclick="Vm.ToggleSidePanel"></div>
            <div class="side-panel" aria-label="Agent workspace">
                <div class="side-panel-head">
                    <h3>Agent Workspace</h3>
                    @if (Vm.GraphNodes.Count > 0)
                    {
                        <span class="graph-badge">@Vm.GraphNodes.Count nodes · @Vm.GraphLinks links</span>
                    }
                    <button class="side-panel-close" aria-label="Close agent workspace" @onclick="Vm.ToggleSidePanel">×</button>
                </div>

                @if (!Vm.WorkspaceLoaded)
                {
                    <div class="side-section">
                        <div class="skeleton-panel-header">
                            <div class="skeleton skeleton-line w40"></div>
                            <div class="skeleton skeleton-line w60" style="height:22px;margin-bottom:0"></div>
                        </div>
                        <div class="skeleton skeleton-line w80" style="margin-top:10px"></div>
                        <div class="skeleton skeleton-line w60"></div>
                        <div class="skeleton skeleton-line w40"></div>
                    </div>
                    <div class="side-section">
                        <h4 style="opacity:0.4">Artifacts</h4>
                        <div class="skeleton skeleton-line w80"></div>
                        <div class="skeleton skeleton-line w60"></div>
                    </div>
                    <div class="side-section">
                        <h4 style="opacity:0.4">Project Graph</h4>
                        <div style="display:flex;gap:6px;flex-wrap:wrap">
                            <div class="skeleton skeleton-line" style="width:80px;height:22px;border-radius:11px"></div>
                            <div class="skeleton skeleton-line" style="width:100px;height:22px;border-radius:11px"></div>
                            <div class="skeleton skeleton-line" style="width:70px;height:22px;border-radius:11px"></div>
                        </div>
                    </div>
                }
                else
                {
                @if (Vm.ShowSessionList)
                {
                    <div class="side-section">
                        <div class="session-header">
                            <h4>Sessions</h4>
                            <div class="session-header-actions">
                                <button class="dcbtn xs" @onclick="Vm.ClearCurrentSessionAsync" disabled="@(Vm.Messages.Count == 0 || Vm.Streaming)" title="Clear messages in this session">Clear</button>
                                <button class="dcbtn xs" @onclick="Vm.NewSession" disabled="@Vm.Streaming">+ New</button>
                            </div>
                        </div>
                        @foreach (var s in Vm.Sessions.Take(20))
                        {
                            <div class="session-item @(s.Id == Vm.SessionId ? "active" : "")" @onclick="@(() => Vm.SelectSessionAsync(s))">
                                <span class="session-title">@s.Title</span>
                                <span class="session-meta">@s.MessageCount msgs · @Vm.SessionTime(s.LastMessageAt)</span>
                                <button class="session-delete" @onclick="@(() => Vm.DeleteSessionAsync(s))" @onclick:stopPropagation="true" title="Delete session">×</button>
                            </div>
                        }
                    </div>
                }

                @if (Vm.ActiveActions.Count > 0)
                {
                    <div class="side-section">
                        <h4>Active Actions</h4>
                        @foreach (var action in Vm.ActiveActions)
                        {
                            <div class="action-item @Vm.StatusClass(action.Status)">
                                <span class="action-icon">
                                    @if (action.Status == AgentToolCallStatus.Running)
                                    {
                                        <svg class="icon-spinner" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
                                            <path d="M21 12a9 9 0 1 1-6.219-8.56" />
                                        </svg>
                                    }
                                    else if (action.Status == AgentToolCallStatus.Completed)
                                    {
                                        <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
                                            <path d="M20 6 9 17l-5-5" />
                                        </svg>
                                    }
                                    else if (action.Status == AgentToolCallStatus.Error)
                                    {
                                        <svg class="icon-warn" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
                                            <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
                                            <line x1="12" y1="9" x2="12" y2="13" />
                                            <line x1="12" y1="17" x2="12.01" y2="17" />
                                        </svg>
                                    }
                                    else
                                    {
                                        <svg class="icon-pause" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
                                            <rect x="6" y="4" width="4" height="16" />
                                            <rect x="14" y="4" width="4" height="16" />
                                        </svg>
                                    }
                                </span>
                                <span class="action-name">@action.ToolName</span>
                                <span class="action-detail">@action.Detail</span>
                            </div>
                        }
                    </div>
                }

                @if (Vm.FetchedData.Count > 0)
                {
                    <div class="side-section">
                        <h4>Fetched Data</h4>
                        @foreach (var data in Vm.FetchedData.TakeLast(10))
                        {
                            <details class="data-item">
                                <summary>@data.Source (@data.RowCount rows)</summary>
                                <pre class="data-preview">@data.Preview</pre>
                            </details>
                        }
                    </div>
                }

                @if (Vm.PanelArtifacts.Count > 0)
                {
                    <div class="side-section">
                        <h4>Artifacts</h4>
                        @foreach (var a in Vm.PanelArtifacts)
                        {
                            <a class="artifact-item" href="/runs/@a.RunId/artifacts/@a.Id" target="_blank" title="Open @a.Title (@Vm.Presentation.Bytes(a.SizeBytes))">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="13" height="13">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                </svg>
                                <span class="artifact-title">@a.Title</span>
                                <span class="artifact-kind">@a.Kind</span>
                            </a>
                        }
                    </div>
                }

                @if (Vm.GraphNodes.Count > 0)
                {
                    <div class="side-section">
                        <h4>Project Graph</h4>
                        <div class="graph-nodes">
                            @foreach (var node in Vm.GraphNodes.Take(20))
                            {
                                <span class="graph-node-tag" title="@node.Label (@node.Degree connections)">@node.Label</span>
                            }
                        </div>
                    </div>
                }

                @if (Vm.ToolHistory.Count > 0)
                {
                    <div class="side-section">
                        <h4>Tool History</h4>
                        @foreach (var th in Vm.ToolHistory.TakeLast(15))
                        {
                            <div class="tool-history-item @(th.Success ? "ok" : "err")">
                                <span class="th-time">@Vm.ToolTime(th.Timestamp)</span>
                                <span class="th-tool">@th.ToolName</span>
                                <span class="th-status">@th.Status</span>
                            </div>
                        }
                    </div>
                }
                }
            </div>
        }
    </div>

    @if (Vm.ShowSettings)
    {
        <div class="dcmodal-overlay" @onclick="Vm.CloseSettings">
            <div class="dcmodal settings-modal" @onclick:stopPropagation>
                <div class="dcmodal-head">
                    <h3>Agent Settings</h3>
                    <button class="dcslide-x" @onclick="Vm.CloseSettings">×</button>
                </div>
                <div class="dcmodal-body settings-body">
                    <div class="settings-tabs">
                        <button class="tab-btn @(Vm.CurrentSettingsTab == ChatSettingsTab.Prompt ? "active" : "")" @onclick="@(() => Vm.SelectSettingsTab(ChatSettingsTab.Prompt))">Prompt</button>
                        <button class="tab-btn @(Vm.CurrentSettingsTab == ChatSettingsTab.Rag ? "active" : "")" @onclick="@(() => Vm.SelectSettingsTab(ChatSettingsTab.Rag))">RAG</button>
                        <button class="tab-btn @(Vm.CurrentSettingsTab == ChatSettingsTab.Commands ? "active" : "")" @onclick="@(() => Vm.SelectSettingsTab(ChatSettingsTab.Commands))">Commands</button>
                    </div>

                    @if (Vm.CurrentSettingsTab == ChatSettingsTab.Prompt)
                    {
                        <div class="dcfield system-prompt-field">
                            <label>Persona <span class="field-hint">— the agent's personality and instructions</span></label>
                            <textarea class="dcinput textarea prompt-textarea" @bind="Vm.PendingSystemPrompt" rows="10"
                                placeholder="You are a PlaceContext agent. You can query project data, inspect job runs, render artifacts, and render graphs."></textarea>
                        </div>
                        <div class="dcfield system-prompt-field">
                            <label>Preamble <span class="field-hint">— prepended before the persona (e.g., anti-chain-of-thought)</span></label>
                            <textarea class="dcinput textarea prompt-textarea" @bind="Vm.PendingPreamble" rows="6"
                                placeholder="CRITICAL: NEVER think out loud..."></textarea>
                        </div>
                        <div class="dcfield system-prompt-field">
                            <label>Chat Tool Catalog <span class="field-hint">— tool descriptions shown to the interactive chat agent</span></label>
                            <textarea class="dcinput textarea prompt-textarea" @bind="Vm.PendingToolCatalog" rows="14"
                                placeholder="Available tools (use [[tool:toolName|args]] syntax)..."></textarea>
                        </div>
                        <div class="dcfield system-prompt-field">
                            <label>Launchpad Tool Catalog <span class="field-hint">— tool descriptions shown to unattended launchpad agents</span></label>
                            <textarea class="dcinput textarea prompt-textarea" @bind="Vm.PendingLaunchpadToolCatalog" rows="14"
                                placeholder="Available tools (use [[tool:toolName|args]] syntax)..."></textarea>
                        </div>
                        <div class="settings-row">
                            <div class="dcfield">
                                <label>Temperature</label>
                                <div class="slider-row">
                                    <input type="range" class="dcslider" @bind="Vm.PendingTemperature" min="0" max="1" step="0.1" />
                                    <span class="slider-val">@Vm.TemperatureLabel</span>
                                </div>
                            </div>
                            <div class="dcfield">
                                <label>Max Tokens</label>
                                <input type="number" class="dcinput" @bind="Vm.PendingMaxTokens" min="64" max="8192" step="64" />
                            </div>
                        </div>
                    }
                    else if (Vm.CurrentSettingsTab == ChatSettingsTab.Rag)
                    {
                        <div class="rag-settings">
                            <div class="rag-toggle">
                                <label class="toggle-switch">
                                    <input type="checkbox" @bind="Vm.PendingRagEnabled" />
                                    <span class="toggle-slider"></span>
                                </label>
                                <span class="toggle-label">Enable RAG context retrieval</span>
                            </div>
                            <p class="rag-desc">Automatically retrieves semantically relevant project run outputs and dependency graph data to ground agent responses.</p>
                            @if (Vm.PendingRagEnabled)
                            {
                                <div class="dcfield">
                                    <label>Max context chunks</label>
                                    <div class="slider-row">
                                        <input type="range" class="dcslider" @bind="Vm.PendingMaxContextChunks" min="1" max="20" step="1" />
                                        <span class="slider-val">@Vm.PendingMaxContextChunks</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (Vm.CurrentSettingsTab == ChatSettingsTab.Commands)
                    {
                        <div class="cmd-section">
                            <p class="cmd-hint">Typing <code>/name</code> in chat expands into a tool call. The command name is shown in the auto-suggest when you type <code>/</code>.</p>
                            @if (Vm.Commands.Count == 0)
                            {
                                <div class="cmd-empty">
                                    <p>No commands defined yet.</p>
                                </div>
                            }
                            else
                            {
                                <div class="cmd-list">
                                    @foreach (var cmd in Vm.Commands)
                                    {
                                        <div class="cmd-item">
                                            <div class="cmd-info">
                                                <span class="cmd-name">/<span>@cmd.Name</span></span>
                                                @if (!string.IsNullOrWhiteSpace(cmd.Description))
                                                {
                                                    <span class="cmd-desc">@cmd.Description</span>
                                                }
                                                <span class="cmd-tool">→ @cmd.ToolName</span>
                                            </div>
                                            <button class="dcbtn xs danger" @onclick="@(() => Vm.DeleteCommandAsync(cmd.Id))">×</button>
                                        </div>
                                    }
                                </div>
                            }
                            <button class="dcbtn sm primary add-cmd-btn" @onclick="Vm.ToggleAddCommand">+ Add Command</button>
                            @if (Vm.ShowAddCommand)
                            {
                                <div class="cmd-form">
                                    <div class="dcfield">
                                        <label>Name <span class="hint-10-5">(without the /)</span></label>
                                        <input class="dcinput" @bind="Vm.NewCmdName" placeholder="latest-runs" />
                                    </div>
                                    <div class="dcfield">
                                        <label>Description</label>
                                        <input class="dcinput" @bind="Vm.NewCmdDescription" placeholder="Show recent job runs" />
                                    </div>
                                    <div class="dcfield">
                                        <label>Tool name</label>
                                        <input class="dcinput" @bind="Vm.NewCmdToolName" placeholder="list_job_runs" />
                                    </div>
                                    <div class="dcfield">
                                        <label>Default args (optional)</label>
                                        <input class="dcinput" @bind="Vm.NewCmdArgs" placeholder="" />
                                    </div>
                                    <div class="cmd-form-actions">
                                        <button class="dcbtn xs" @onclick="Vm.HideAddCommand">Cancel</button>
                                        <button class="dcbtn xs primary" @onclick="Vm.AddCommandAsync">Add</button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                </div>
                <div class="dcmodal-foot">
                    <button class="dcbtn" @onclick="Vm.CloseSettings">Cancel</button>
                    <button class="dcbtn primary" @onclick="Vm.SaveSettingsAsync">Save</button>
                </div>
            </div>
        </div>
    }
</div>



@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        Vm.Attach(() => InvokeAsync(StateHasChanged));
    }

    protected override Task OnInitializedAsync() => Vm.InitializeAsync();

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        Vm.AfterRenderAsync(Vm.MessagesElement, Vm.ScrollAnchorElement, Vm.DropZoneElement, firstRender);

    public void Dispose()
    {
        Vm.Detach();
        Vm.DetachUi();
    }
}
