@page "/project/{ProjectId:guid}/agents"
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@using PlaceContext.Application.Dtos
@using PlaceContext.Application.Features
@inject IPlaceContextService Svc
@inject PortalUiState Ui

<PageTitle>placecontext — Agents</PageTitle>

<div class="page">

    <div class="page-head">
        <div>
            <h2 class="page-title">Agents</h2>
            <div class="page-sub">
                Chat with your project's AI agent — it retrieves context from run outputs and the dependency graph.
            </div>
        </div>
    </div>

    @if (_message is not null)
    {
        <div class="message">@_message</div>
    }

    <div class="agents-layout">

        @* ── Config panel ──────────────────────────────────────────────────────────────────── *@
        <div class="dccard config-card">
            <h3 class="card-title">Configuration</h3>
            <div class="config-grid">
                <div class="dcfield">
                    <label>Model</label>
                    <input class="dcinput" @bind="_configModel" placeholder="qwen3.5:0.8b" />
                </div>
                <div class="dcfield">
                    <label>Max context chunks</label>
                    <input class="dcinput" type="number" min="1" max="20" @bind="_configChunks" />
                </div>
                <div class="dcfield">
                    <label>Temperature</label>
                    <input class="dcinput" type="number" min="0" max="2" step="0.1" @bind="_configTemp" />
                </div>
                <div class="dcfield">
                    <label>Top-p</label>
                    <input class="dcinput" type="number" min="0" max="1" step="0.1" @bind="_configTopP" />
                </div>
                <div class="dcfield dcfield-check">
                    <label class="check-label">
                        <input type="checkbox" @bind="_configEnabled" />
                        Enabled
                    </label>
                </div>
            </div>
            <div class="dcfield" style="margin-top:10px">
                <label>System prompt</label>
                <textarea class="dcinput textarea" rows="4" @bind="_configPrompt"
                    placeholder="You are a helpful assistant for this project..."></textarea>
            </div>
            <div class="config-actions">
                <button class="dcbtn primary" disabled="@_savingConfig" @onclick="SaveConfig">
                    @(_savingConfig ? "Saving…" : "Save config")
                </button>
                @if (_configError is not null)
                {
                    <span class="err-text">@_configError</span>
                }
            </div>
        </div>

        @* ── Chat panel ────────────────────────────────────────────────────────────────────── *@
        <div class="chat-panel">
            @* Session list *@
            <div class="session-list dccard">
                <h3 class="card-title">Sessions</h3>
                <button class="dcbtn btn-sm" @onclick="NewSession">+ New chat</button>
                @if (_sessions is null)
                {
                    <Skeleton Kind="text" Rows="3" />
                }
                else if (_sessions.Count == 0)
                {
                    <div class="empty-note">No sessions yet.</div>
                }
                else
                {
                    @foreach (var s in _sessions)
                    {
                        <div class="session-item @(_activeSession?.Id == s.Id ? "active" : "")"
                             @onclick="@(() => SelectSession(s))">
                            <span class="session-title">@(s.Title ?? "Untitled")</span>
                            <span class="session-time">@s.UpdatedAt.ToLocalTime().ToString("MMM d HH:mm")</span>
                        </div>
                    }
                }
            </div>

            @* Chat messages *@
            <div class="chat-area dccard">
                @if (_activeSession is null)
                {
                    <div class="empty-note chat-empty">Select a session or start a new chat.</div>
                }
                else
                {
                    <div class="chat-messages" @ref="_messagesRef">
                        @foreach (var m in _activeSession.Messages)
                        {
                            <div class="chat-msg @m.Role">
                                <div class="msg-role">@m.Role</div>
                                <div class="msg-content">@((MarkupString)FormatMessage(m.Content))</div>
                            </div>
                        }
                        @if (_chatBusy)
                        {
                            <div class="chat-msg assistant">
                                <div class="msg-role">assistant</div>
                                <div class="msg-content typing">thinking…</div>
                            </div>
                        }
                    </div>
                    <div class="chat-input-bar">
                        <input class="dcinput chat-input" @bind="_chatInput" @bind:event="oninput"
                            placeholder="Ask about this project…" disabled="@_chatBusy"
                            @onkeydown="ChatKeydown" />
                        <button class="dcbtn primary" disabled="@(_chatBusy || string.IsNullOrWhiteSpace(_chatInput))" @onclick="SendChat">Send</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private string? _message;
    private bool _savingConfig;
    private string? _configError;

    // Config fields
    private string _configModel = "qwen3.5:0.8b";
    private string _configPrompt = "";
    private int _configChunks = 5;
    private float _configTemp = 0.7f;
    private float _configTopP = 0.9f;
    private bool _configEnabled = true;

    // Sessions
    private IReadOnlyList<AgentChatSessionView>? _sessions;
    private AgentChatSessionView? _activeSession;

    // Chat
    private string _chatInput = "";
    private bool _chatBusy;
    private ElementReference _messagesRef;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var config = await Svc.GetAgentConfigAsync(ProjectId);
            _configModel = config.BaseModel;
            _configPrompt = config.SystemPrompt;
            _configChunks = config.MaxContextChunks;
            _configTemp = config.Temperature;
            _configTopP = config.TopP;
            _configEnabled = config.Enabled;

            _sessions = await Svc.ListAgentChatSessionsAsync(ProjectId);
            Ui.Set("Agents", "chat with your project's AI agent");
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private async Task SaveConfig()
    {
        _configError = null;
        _savingConfig = true;
        try
        {
            await Svc.UpdateAgentConfigAsync(new UpdateAgentConfigCommand(
                ProjectId, _configModel, _configPrompt, _configChunks, _configTemp, _configTopP, _configEnabled));
        }
        catch (Exception ex) { _configError = ex.Message; }
        finally { _savingConfig = false; }
    }

    private void NewSession()
    {
        _activeSession = null;
    }

    private void SelectSession(AgentChatSessionView session)
    {
        _activeSession = session;
    }

    private async Task SendChat()
    {
        if (string.IsNullOrWhiteSpace(_chatInput) || _chatBusy) return;

        var message = _chatInput.Trim();
        _chatInput = "";
        _chatBusy = true;

        try
        {
            var result = await Svc.SendAgentMessageAsync(
                new SendAgentMessageCommand(ProjectId, _activeSession?.Id, message));
            _activeSession = result;
            _sessions = await Svc.ListAgentChatSessionsAsync(ProjectId);
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _chatBusy = false; }
    }

    private async Task ChatKeydown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendChat();
    }

    private static string FormatMessage(string text)
    {
        // Minimal markdown: code blocks, bold, inline code.
        return text
            .Replace("&", "&amp;")
            .Replace("<", "&lt;")
            .Replace(">", "&gt;")
            .Replace("\n", "<br/>");
    }
}
