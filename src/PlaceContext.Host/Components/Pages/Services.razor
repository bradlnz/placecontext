@page "/project/{ProjectId:guid}/services"
@page "/project/{ProjectId:guid}/services/{DetailServiceId:guid}"
@attribute [Authorize(Policy = Permission.SettingsManage)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@inject ServicesViewModel Vm

<PageTitle>PlaceContext — @(Vm.DetailServiceId.HasValue ? Vm.Selected?.Name ?? "App details" : "Services")</PageTitle>
<div class="resource-page services-page">
    <nav class="resource-breadcrumb" aria-label="Breadcrumb"><span>Infrastructure</span><AppIcon Kind="chevron-right" /><a href="@Vm.ListUrl">Services</a>@if (Vm.DetailServiceId.HasValue) { <AppIcon Kind="chevron-right" /><span aria-current="page">@(Vm.Selected?.Name ?? "App details")</span> }</nav>
    <header class="resource-head">
        <div>@if (Vm.DetailServiceId.HasValue) { <h2>@(Vm.Selected?.Name ?? "App details")</h2>@if (Vm.Selected is { } heading) { <p><span class="resource-status @(heading.Status == "running" ? "running" : "paused")"><span class="status-dot"></span>@heading.Status</span> · @(heading.RequireSso ? "Web app · Platform SSO" : "Background worker")</p> } }
            else { <h2>Services <span class="resource-count">(@Vm.Services.Count)</span></h2><p>Manage long-running web apps and background workers.</p> }</div>
        <div class="resource-actions">
            <button class="dcbtn icon-button" disabled="@Vm.Busy" aria-label="Refresh services" @onclick="Vm.RefreshAsync"><AppIcon Kind="refresh" /></button>
            @if (!Vm.DetailServiceId.HasValue) { <button class="dcbtn" disabled="@(Vm.Busy || Vm.Selected is null)" @onclick="() => Vm.InspectAsync(Vm.Selected!)"><AppIcon Kind="logs" /> Logs</button> }
            <button class="dcbtn" disabled="@(Vm.Busy || Vm.Selected is null)" @onclick='() => Vm.ControlAsync(Vm.Selected!, Vm.Selected!.Status is "running" or "restarting" ? "stop" : "start")'><AppIcon Kind="@(Vm.Selected?.Status is "running" or "restarting" ? "pause" : "play")" /> @(Vm.Selected?.Status is "running" or "restarting" ? "Stop" : "Start")</button>
            <button class="dcbtn" disabled="@(Vm.Busy || Vm.Selected?.Status != "running")" @onclick='() => Vm.ControlAsync(Vm.Selected!, "restart")'>Restart</button>
            <button class="dcbtn" disabled="@(Vm.Busy || Vm.Selected is null)" @onclick="() => Vm.ConfirmRemove(Vm.Selected!)"><AppIcon Kind="trash" /> Remove</button>
            @if (!Vm.DetailServiceId.HasValue) { <button class="dcbtn primary" disabled="@Vm.Busy" @onclick="Vm.NewService"><AppIcon Kind="plus" /> Launch service</button> }
            else if (Vm.Selected is { RequireSso: true, Status: "running" } webApp) { <a class="dcbtn primary" href="/services/open/@ProjectId/@webApp.Id" target="_blank" rel="noopener noreferrer">Open app <AppIcon Kind="arrow-right" /></a> }
        </div>
    </header>
    @if (!Vm.DetailServiceId.HasValue)
    {
    <nav class="dctabs resource-tabs" aria-label="Services sections">
        <a class="dctab @(Tab != "activity" ? "active" : "")" href="/project/@ProjectId/services">Apps</a>
        <a class="dctab " href="/project/@ProjectId/databases">Databases</a>
        <a class="dctab @(Tab == "activity" ? "active" : "")" href="/project/@ProjectId/services?tab=activity">Activity</a>
    </nav>
    }
    @if (Vm.Error is not null) { <p class="error" role="alert">@Vm.Error</p> }
    @if (Vm.Busy) { <p role="status">Updating services… Image downloads may take a few minutes.</p> }

    @if (Vm.ShowEditor)
    {
        <div class="dcmodal-overlay"><section class="dcmodal resource-pane" role="dialog" aria-modal="true" aria-labelledby="service-editor-title">
            <form @onsubmit="Vm.LaunchAsync" @onsubmit:preventDefault>
                <div class="dcmodal-head"><h3 id="service-editor-title">Launch a service</h3><button type="button" class="dcslide-x" aria-label="Close service settings" disabled="@Vm.Busy" @onclick="Vm.CloseEditor"><AppIcon Kind="close" /></button></div><div class="dcmodal-body resource-pane-body">
                <div class="form-grid">
                    <div class="dcfield"><label for="service-name">Name</label><input id="service-name" class="dcinput" @bind="Vm.Name" required maxlength="80" disabled="@Vm.Busy" placeholder="Customer portal" /></div>
                    <div class="dcfield"><label for="service-image">Image</label><input id="service-image" class="dcinput" @bind="Vm.Image" required maxlength="256" disabled="@Vm.Busy" placeholder="registry.example.com/portal:latest" /></div>
                    <div class="dcfield"><label for="service-kind">Type</label><select id="service-kind" class="dcinput" @bind="Vm.Kind" disabled="@Vm.Busy"><option value="web">Web app</option><option value="worker">Background worker</option></select></div>
                    @if (Vm.Kind == "web")
                    { <div class="dcfield"><label for="service-port">Container port</label><input id="service-port" class="dcinput" type="number" min="1024" max="65535" @bind="Vm.Port" disabled="@Vm.Busy" required /></div> }
                    <div class="dcfield"><label for="service-memory">Memory (MiB)</label><input id="service-memory" class="dcinput" type="number" min="64" max="8192" @bind="Vm.MemoryMb" disabled="@Vm.Busy" required /></div>
                    <div class="dcfield"><label for="service-cpu">CPU cores</label><input id="service-cpu" class="dcinput" type="number" min="0.1" max="8" step="0.1" @bind="Vm.Cpus" disabled="@Vm.Busy" required /></div>
                </div>
                @if (Vm.Kind == "web") { <p class="service-note">Platform SSO is required. The app has a private cluster endpoint and a separate browser address.</p> }
                <p class="service-note">After launching, create a database in <a href="/project/@ProjectId/databases">Databases</a> and assign it to this app. Its private connection variables are supplied automatically.</p>
                <div class="dcfield"><label for="service-queue">Workflow queue</label><select id="service-queue" class="dcinput" @bind="Vm.QueueId" disabled="@Vm.Busy"><option value="">None</option>@foreach (var queue in Vm.Queues) { <option value="@queue.Id">@queue.Name</option> }</select><small>The app receives a credential restricted to this queue and its own results.</small></div>
                <div class="dcfield"><label for="service-environment">Environment variables</label><textarea id="service-environment" class="dcinput" @bind="Vm.Environment" rows="4" maxlength="32768" spellcheck="false" autocomplete="off" disabled="@Vm.Busy" placeholder="PORT=8080"></textarea><small>One NAME=value per line. Values are stored in a Secret in this app’s namespace.</small></div>
                <p class="service-note">Use an image that runs as a non-root user, listens on 0.0.0.0, and writes temporary files under /tmp. Persistent storage and custom domains are not configured here.</p>
                @if (Vm.Error is not null) { <p class="error" role="alert">@Vm.Error</p> }</div><div class="dcmodal-foot resource-actions"><button type="submit" class="dcbtn primary" disabled="@Vm.Busy">@(Vm.Busy ? "Launching…" : "Launch")</button><button type="button" class="dcbtn" disabled="@Vm.Busy" @onclick="Vm.CloseEditor">Cancel</button></div>
            </form>
        </section></div>
    }

    @if (Vm.DetailServiceId.HasValue)
    {
        @if (Vm.Selected is { } app)
        {
            <section class="dccard resource-detail service-overview" aria-label="App details">
                <header><h3>Details</h3><a href="@Vm.ListUrl">All apps <AppIcon Kind="arrow-right" /></a></header>
                <dl class="service-properties">
                    <div><dt>App name</dt><dd>@app.Name</dd></div><div><dt>App ID</dt><dd><code>@app.Id</code></dd></div>
                    <div><dt>Image</dt><dd><code>@app.Image</code></dd></div><div><dt>Created</dt><dd>@Vm.Presentation.DateTime(app.CreatedAt)</dd></div>
                    <div><dt>Health</dt><dd>@(app.Health ?? "Unknown")</dd></div><div><dt>Namespace</dt><dd><code>@app.Namespace</code></dd></div>
                </dl>
            </section>
            <nav class="dctabs resource-tabs" aria-label="App sections">
                <a class="dctab @(Tab != "databases" ? "active" : "")" aria-current="@(Tab != "databases" ? "page" : null)" href="@Vm.ServiceUrl(app.Id)"><AppIcon Kind="logs" /> Logs</a>
                <a class="dctab @(Tab == "databases" ? "active" : "")" aria-current="@(Tab == "databases" ? "page" : null)" href="@(Vm.ServiceUrl(app.Id) + "?tab=databases")"><AppIcon Kind="data" /> Databases <span class="n">@Vm.AppDatabases.Count()</span></a>
            </nav>
            @if (Tab == "databases")
            {
                <section class="dccard resource-catalogue" aria-label="App databases">
                    <div class="resource-toolbar"><h3>Databases</h3><a class="dcbtn" href="/project/@ProjectId/databases">Manage databases <AppIcon Kind="arrow-right" /></a></div>
                    <div class="resource-table-scroll" tabindex="0" role="region" aria-label="App database list">
                        <table class="resource-table"><thead><tr><th>Name</th><th>Status</th><th>Data store</th><th>Database / user</th></tr></thead><tbody>
                        @foreach (var database in Vm.AppDatabases)
                        {
                            <tr><td class="resource-name"><a href="/project/@ProjectId/databases/@database.Id">@database.Name</a></td><td><span class="resource-status @(database.Status == "running" ? "running" : "paused")"><span class="status-dot"></span>@database.Status</span></td><td>@(database.Engine == "postgres" ? "PostgreSQL 17" : "Redis 7")</td><td>@database.Database / @database.Username</td></tr>
                        }
                        </tbody></table>
                    </div>
                    @if (!Vm.AppDatabases.Any()) { <div class="resource-empty"><h3>No databases</h3><p>Create a database and assign it to this app to connect it privately.</p></div> }
                </section>
            }
            else
            {
                <section class="dccard resource-detail logs-panel" aria-label="App logs"><header><div><h3>Logs</h3><p class="service-note">Latest 200 lines from the app’s containers.</p></div><button class="dcbtn" disabled="@Vm.Busy" @onclick="() => Vm.InspectAsync(app)"><AppIcon Kind="refresh" /> Refresh logs</button></header><ContainerLogs Text="@Vm.Logs" /></section>
            }
        }
        else if (!Vm.Busy) { <div class="resource-empty"><h3>App unavailable</h3><a class="dcbtn" href="@Vm.ListUrl">Back to services</a></div> }
    }
    else if (Tab == "activity")
    {
        <section class="dccard resource-detail"><h3>App activity</h3><p class="note">Choose an app to inspect its latest log events.</p><div class="resource-actions">@foreach (var app in Vm.Services) { <button class="dcbtn" disabled="@Vm.Busy" @onclick="() => Vm.InspectAsync(app)">@app.Name</button> }</div></section>
    }
    else
    {
    <section class="dccard resource-catalogue" aria-label="Configured services">
        <div class="resource-toolbar">
            <label class="resource-search"><AppIcon Kind="data.search" /><input class="dcinput" aria-label="Find services" placeholder="Find services by name, image, or ID" @bind="Vm.Search" @bind:event="oninput" /></label>
            <select class="dcinput" aria-label="Filter service status" @bind="Vm.StatusFilter"><option value="">All statuses</option>@foreach (var status in new[] { "running", "exited", "restarting", "created" }) { <option value="@status">@status</option> }</select>
            <select class="dcinput" aria-label="Sort services" @bind="Vm.Sort"><option value="created">Newest first</option><option value="name">Name: A–Z</option></select>
        </div>
        <div class="resource-table-scroll" tabindex="0" role="region" aria-label="Service list">
            <table class="resource-table"><thead><tr><th><span class="visually-hidden">Select</span></th><th>Name</th><th>Status</th><th>Image</th><th>Databases</th><th>Access</th><th>Namespace</th><th>Created</th></tr></thead><tbody>
            @foreach (var service in Vm.VisibleServices)
            {
                <tr @key="service.Id" class="resource-row @(Vm.Selected?.Id == service.Id ? "selected" : "")">
                    <td><input type="radio" name="selected-service" aria-label="@($"Select {service.Name}")" checked="@(Vm.Selected?.Id == service.Id)" disabled="@Vm.Busy" @onchange="() => Vm.Select(service)" /></td>
                    <td class="resource-name"><a class="resource-link" href="@Vm.ServiceUrl(service.Id)"><AppIcon Kind="box" /> @service.Name</a></td>
                    <td><span class="resource-status @(service.Status == "running" ? "running" : "paused")"><span class="status-dot"></span>@service.Status</span>@if (service.Health is not null) { <small>@service.Health</small> }</td>
                    <td class="resource-value"><code>@service.Image</code></td>
                    <td class="resource-value">@(service.DatabaseIds is { Count: > 0 } ? string.Join(", ", service.DatabaseIds.Select(id => Vm.Databases.FirstOrDefault(database => database.Id == id)?.Name ?? "Unavailable")) : "—")</td>
                    <td>@if (service.RequireSso) { <small>Platform SSO</small>@if (service.Status == "running") { <a href="/services/open/@ProjectId/@service.Id" target="_blank" rel="noopener noreferrer">Open app <AppIcon Kind="arrow-right" /></a> } }
                        else if (service.HostPort is { } port) { <small>Local · no platform sign-in</small>@if (service.Status == "running") { <a href="@($"http://{service.Id:N}.localhost:{port}")" target="_blank" rel="noopener noreferrer">Open on host <AppIcon Kind="arrow-right" /></a> } } else { <span>Worker</span> }</td>
                    <td class="resource-value"><code>@service.Namespace</code></td><td class="nowrap">@Vm.Presentation.DateTime(service.CreatedAt)</td>
                </tr>
            }
            </tbody></table>
        </div>
        @if (!Vm.Busy && Vm.Services.Count == 0) { <div class="resource-empty"><AppIcon Kind="box" /><h3>No services</h3><p>Launch an image to host a web app or keep a worker running.</p><button class="dcbtn primary" @onclick="Vm.NewService">Launch your first service</button></div> }
        else if (Vm.Services.Count > 0 && Vm.VisibleServices.Count == 0) { <div class="resource-empty"><h3>No matching services</h3><p>Try another name or change the status filter.</p></div> }
        <footer class="resource-table-footer">@Vm.VisibleServices.Count of @Vm.Services.Count services <span>Select a row for actions. Open an app to view its details.</span></footer>
    </section>
    }
    @if (!Vm.DetailServiceId.HasValue && Vm.Inspecting is { } inspecting)
    {
        <section class="dccard resource-detail logs-panel"><header><h3>@inspecting.Name · Logs</h3><div class="resource-actions"><button class="dcbtn" disabled="@Vm.Busy" @onclick="() => Vm.InspectAsync(inspecting)">Refresh logs</button><button class="dcbtn" disabled="@Vm.Busy" @onclick="Vm.CloseLogs">Close</button></div></header><p class="service-note">Latest 200 lines, up to 256 KiB per stream. Image health checks appear on the service card.</p><ContainerLogs Text="@Vm.Logs" /></section>
    }
</div>
@if (Vm.Removing is { } removing)
{
    <div class="dcmodal-overlay"><div class="dcmodal resource-pane" role="dialog" aria-modal="true" aria-labelledby="remove-service-title"><div class="dcmodal-head"><h3 id="remove-service-title">Remove service?</h3></div><div class="dcmodal-body"><p>Stop and remove <strong>@removing.Name</strong>? Its namespace, deployment and logs will be deleted. Apps that own databases cannot be removed.</p>@if (Vm.Error is not null) { <p role="alert" class="error">@Vm.Error</p> }</div><div class="dcmodal-foot actions"><button class="dcbtn" disabled="@Vm.Busy" @onclick="Vm.CancelRemove">Cancel</button><button class="dcbtn" disabled="@Vm.Busy" @onclick="Vm.RemoveAsync">Remove service</button></div></div></div>
}

@code {
    [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid? DetailServiceId { get; set; }
    [SupplyParameterFromQuery(Name = "service")] public Guid? ServiceId { get; set; }
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override Task OnParametersSetAsync() => Vm.LoadAsync(ProjectId, DetailServiceId ?? ServiceId, Tab);
    public void Dispose() => Vm.DisposePage();
}
