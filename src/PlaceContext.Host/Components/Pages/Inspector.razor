@page "/inspector"
@attribute [Authorize]
@implements IDisposable
@inject IPlaceContextService Svc
@inject PortalUiState Ui

<PageTitle>PlaceContext — MCP Inspector</PageTitle>

<div class="shell">
    <!-- call feed -->
    <div class="feed">
        <div class="feed-head">
            <div class="row8">
                <span class="title-13">Tool calls</span>
                <span class="pulse-dot"></span>
            </div>
            <button class="dcbtn btn-sm" @onclick="Load">refresh</button>
        </div>
        <div class="feed-list">
            @if (_calls is null || _calls.Count == 0)
            {
                <div class="feed-empty">
                    No tool calls yet. Launch the MCP server (<code>--mcp</code>) and call a tool, or use the portal — calls appear here live.
                </div>
            }
            else
            {
                @foreach (var c in _calls)
                {
                    var active = _active?.Id == c.Id;
                    <div class="call-row" style="background:@(active ? "var(--card)" : "transparent"); border-left:2px solid @(active ? "var(--brand)" : "transparent")" @onclick="@(() => _active = c)">
                        <span class="status-dot" style="background:@Status(c.Status)"></span>
                        <div class="flex-min">
                            <div class="row8">
                                <span class="call-tool">@c.Tool</span>
                                <span class="call-dir">@c.Direction</span>
                            </div>
                            <div class="call-summary">@c.Summary</div>
                        </div>
                        <div class="call-meta">
                            <div class="call-status" style="color:@Status(c.Status)">@c.Status.ToLower()</div>
                            <div class="call-dur">@c.DurationMs ms</div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- detail -->
    <div class="detail">
        @if (_active is null)
        {
            <div class="detail-empty">Select a tool call to inspect its request and response.</div>
        }
        else
        {
            <div class="detail-head">
                <span class="detail-tool">@_active.Tool</span>
                <span class="status-pill" style="color:@Status(_active.Status); background:@StatusBg(_active.Status)">@_active.Status.ToLower()</span>
                <span class="detail-meta">@_active.DurationMs ms · @_active.Project</span>
            </div>
            <div class="detail-body">
                <div>
                    <div class="section-label">Request</div>
                    <pre class="json-block">@_active.RequestJson</pre>
                </div>
                <div>
                    <div class="section-label">Response</div>
                    <pre class="json-block">@_active.ResponseJson</pre>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private IReadOnlyList<ToolCallView>? _calls;
    private ToolCallView? _active;
    private System.Threading.Timer? _poll;

    protected override async Task OnInitializedAsync()
    {
        Ui.Set("MCP Inspector", "live tool traffic · MCP via Streamable HTTP");
        await Load();
        // Tool calls arrive from agents, not from portal actions, so there's no in-process change
        // event to subscribe to — a short poll keeps the feed genuinely live.
        _poll = new System.Threading.Timer(_ => _ = InvokeAsync(async () => { await Load(); StateHasChanged(); }),
            null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private async Task Load()
    {
        _calls = await Svc.GetRecentToolCallsAsync(20);
        _active ??= _calls.FirstOrDefault();
    }

    public void Dispose() => _poll?.Dispose();

    private static string Status(string s) => s switch
    {
        "Ok" => "var(--good)", "Warn" => "var(--warn)", _ => "var(--bad)"
    };
    private static string StatusBg(string s) => s switch
    {
        "Ok" => "var(--good-bg)", "Warn" => "var(--warn-bg)", _ => "var(--bad-bg)"
    };
}
