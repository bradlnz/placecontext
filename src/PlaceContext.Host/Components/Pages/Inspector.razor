@page "/inspector"
@attribute [Authorize(Policy = Permission.JobsView)]
@implements IDisposable
@inject InspectorViewModel Vm
@using PlaceContext.Host.Components.ViewModels

<PageTitle>PlaceContext — MCP Inspector</PageTitle>

<div class="shell">
    <!-- call feed -->
    <div class="feed">
        <div class="feed-head">
            <div class="row8">
                <span class="title-13">Tool calls</span>
                <span class="pulse-dot"></span>
            </div>
            <button class="dcbtn btn-sm" @onclick="Vm.LoadAsync">refresh</button>
        </div>
        <div class="feed-list">
            @if (Vm.Calls is null || Vm.Calls.Count == 0)
            {
                <div class="feed-empty">
                    No tool calls yet. Launch the MCP server (<code>--mcp</code>) and call a tool, or use the portal — calls appear here live.
                </div>
            }
            else
            {
                @foreach (var c in Vm.Calls)
                {
                    var active = Vm.Active?.Id == c.Id;
                    <div class="call-row" style="background:@(active ? "var(--card)" : "transparent"); border-left:2px solid @(active ? "var(--brand)" : "transparent")" @onclick="@(() => Vm.Select(c))">
                        <span class="status-dot" style="background:@InspectorViewModel.StatusColor(c.Status)"></span>
                        <div class="flex-min">
                            <div class="row8">
                                <span class="call-tool">@c.Tool</span>
                                <span class="call-dir">@c.Direction</span>
                            </div>
                            <div class="call-summary">@c.Summary</div>
                        </div>
                        <div class="call-meta">
                            <div class="call-status" style="color:@InspectorViewModel.StatusColor(c.Status)">@c.Status.ToLower()</div>
                            <div class="call-dur">@c.DurationMs ms</div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- detail -->
    <div class="detail">
        @if (Vm.Active is null)
        {
            <div class="detail-empty">Select a tool call to inspect its request and response.</div>
        }
        else
        {
            <div class="detail-head">
                <span class="detail-tool">@Vm.Active.Tool</span>
                <span class="status-pill" style="color:@InspectorViewModel.StatusColor(Vm.Active.Status); background:@InspectorViewModel.StatusBackground(Vm.Active.Status)">@Vm.Active.Status.ToLower()</span>
                <span class="detail-meta">@Vm.Active.DurationMs ms · @Vm.Active.Project</span>
            </div>
            <div class="detail-body">
                <div>
                    <div class="section-label">Request</div>
                    <pre class="json-block">@Vm.Active.RequestJson</pre>
                </div>
                <div>
                    <div class="section-label">Response</div>
                    <pre class="json-block">@Vm.Active.ResponseJson</pre>
                </div>
            </div>
        }
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync() { Vm.Attach(() => InvokeAsync(StateHasChanged)); await Vm.LoadAsync(); Vm.StartPolling(); }
    public void Dispose() { Vm.Detach(); Vm.Dispose(); }
}
