@page "/settings/api-tokens"
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@attribute [Authorize]
@using PlaceContext.Host.Components.ViewModels
@inject ApiTokensSettingsViewModel Vm
@implements IDisposable
<PageTitle>placecontext — API tokens</PageTitle>
@if (Vm.Loading)
{
    <Skeleton Kind="list" Rows="3" Padded />
}
else
{
    <div class="page">
        <h2 class="page-title">API tokens</h2>
        <div class="page-sub">
            Personal tokens authenticate you against the project data and search APIs. The raw secret is shown once when created.
        </div>
        <div class="dccard api-docs">
            <div class="add-title">Usable endpoints</div>
            <ul class="api-list">
                @foreach (var endpoint in Vm.UsableEndpoints)
                {
                    <li><code>@endpoint.Method @endpoint.Path</code> — @endpoint.Description</li>
                }
            </ul>
            <div class="api-subtitle">Example calls</div>
            <div class="api-examples">
                @foreach (var sample in Vm.EndpointExamples)
                {
                    <div class="api-example">
                        <div class="api-example-title">@sample.Title</div>
                        <div class="api-example-code-wrap">
                            <code class="api-example-code">@sample.Command</code>
                            <button class="dcbtn api-copy" @onclick="() => Vm.CopyExampleAsync(sample.Command)">Copy</button>
                        </div>
                    </div>
                }
            </div>
            <div class="api-hint">
                Include <code>Authorization: Bearer &lt;token&gt;</code> or
                <code>X-Api-Key: &lt;token&gt;</code>, and one of <code>X-Project-Id</code> / <code>X-Project</code>.
                Job-run endpoints also require the job to have <strong>API invocation enabled</strong> in settings.
            </div>
        </div>
        @if (Vm.Message is not null)
        {
            <div class="message">@Vm.Message</div>
        }
        @if (Vm.CreatedRaw is not null)
        {
            <div class="dccard created">
                <div class="created-title">Copy your token now — it will not be shown again</div>
                <code class="raw-token">@Vm.CreatedRaw</code>
                <button class="dcbtn" @onclick="Vm.DismissCreated">I've copied it</button>
            </div>
        }
        <div class="dccard add-card">
            <div class="add-title">Create token</div>
            <div class="add-row">
                <input class="dcinput field-input" @bind="Vm.NewName" placeholder="CI, local script…" />
                <select class="dcinput field-input" @bind="Vm.LifetimeDays">
                    <option value="30">30 days</option>
                    <option value="90">90 days (default)</option>
                    <option value="180">180 days</option>
                    <option value="365">1 year (max)</option>
                </select>
                <button class="dcbtn primary" disabled="@Vm.Busy" @onclick="Vm.CreateAsync">
                    @(Vm.Busy ? "Creating…" : "Create")
                </button>
            </div>
            @if (Vm.CreateError is not null)
            {
                <div class="add-error">@Vm.CreateError</div>
            }
        </div>
        @if (Vm.Tokens.Count == 0)
        {
            <div class="dccard empty">No active tokens.</div>
        }
        else
        {
            <div class="list">
                @foreach (var token in Vm.Tokens)
                {
                    <div class="dccard token-row">
                        <span class="token-name">@token.Name</span>
                        <span class="token-prefix"><code>@token.TokenPrefix…</code></span>
                        <button class="dcbtn" disabled="@Vm.Busy" @onclick="() => Vm.RevokeAsync(token.Id)">Revoke</button>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    protected override async Task OnInitializedAsync() => await Vm.LoadAsync();

    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));

    public void Dispose() => Vm.Detach();
}
