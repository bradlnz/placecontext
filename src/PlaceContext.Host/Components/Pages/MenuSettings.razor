@page "/settings/menu"
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@attribute [Authorize(Policy = Policies.DefaultAdmin)]
@using PlaceContext.Host.Components.ViewModels
@inject MenuSettingsViewModel Vm
@implements IDisposable
<PageTitle>PlaceContext — Menu</PageTitle>
<div class="menu-settings-page">
    <header class="settings-head">
        <div>
            <span class="settings-kicker">Workspace navigation</span>
            <h2>Menu</h2>
            <p>Reorder, rename and group sidebar items. Permission rules still control visibility.</p>
        </div>
        <div class="head-actions">
            <button class="dcbtn" disabled="@Vm.Saving" @onclick="Vm.Reset">Reset defaults</button>
            <button class="dcbtn primary" disabled="@Vm.Saving" @onclick="Vm.SaveAsync">
                @(Vm.Saving ? "Saving…" : "Save menu")
            </button>
        </div>
    </header>
    @if (Vm.Message is not null)
    {
        <div class="settings-message">@Vm.Message</div>
    }
    <section class="dccard menu-card">
        <div class="menu-card-head">
            <strong>Sidebar items</strong>
            <span>@Vm.Workspace.Count items</span>
        </div>
        @foreach (var (row, idx) in Vm.Workspace.Select((row, index) => (row, index)))
        {
            <article class="menu-row @(!row.Visible ? "muted" : "")">
                <div class="row-move">
                    <button class="dcbtn move" disabled="@(idx == 0)" @onclick="() => Vm.Move(idx, -1)">↑</button>
                    <button class="dcbtn move" disabled="@(idx >= Vm.Workspace.Count - 1)" @onclick="() => Vm.Move(idx, 1)">↓</button>
                </div>
                <div class="menu-item-body">
                    <div class="menu-item-head">
                        <strong>@row.DefaultLabel</strong>
                        <span>@row.Id</span>
                    </div>
                    <div class="field-grid">
                        <input class="dcinput" @bind="row.Label" placeholder="Use default" />
                        <input class="dcinput" @bind="row.Section" placeholder="No section heading" />
                    </div>
                </div>
                <label class="visible-toggle">
                    <input type="checkbox" @bind="row.Visible" /> Visible
                </label>
            </article>
        }
    </section>
</div>

@code {
    protected override async Task OnInitializedAsync() => await Vm.LoadAsync();

    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));

    public void Dispose() => Vm.Detach();
}
