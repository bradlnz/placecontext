@using PlaceContext.Application.Access
@using PlaceContext.Application.Cluster
@page "/cluster"
@page "/settings/cluster"
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@attribute [Authorize(Policy = Permission.SettingsManage)]
@implements IDisposable
@inject ClusterViewModel Vm






<PageTitle>PlaceContext — Cluster</PageTitle>

@if (Vm.Loading)
{
    <Skeleton Kind="list" Rows="6" Padded />
}

else
{
    <div class="cluster-page">
        <section class="page-head">
            <div>
                <h2 class="page-title">Cluster overview</h2>
                <p class="page-sub">Monitor the machines running your workloads and grow the fleet when capacity changes.</p>
            </div>
            <div class="hero-actions">
                <a class="dcbtn" href="/onboarding">Cloud or local setup</a>
                <button class="dcbtn" @onclick="() => Vm.RefreshAsync(false)" disabled="@Vm.Busy" title="Refresh nodes" aria-label="Refresh nodes">
                    <span class="@(Vm.Busy ? "spin" : "")"><AppIcon Kind="refresh" /></span>
                    Refresh
                </button>
                <button class="dcbtn primary" @onclick="Vm.AddWorkerAsync" disabled="@Vm.Busy">
                    <span class="button-plus"><AppIcon Kind="plus" /></span>
                    Add node
                </button>
            </div>
        </section>

        @if (Vm.Message is not null)
        {
            <div class="message-banner @(Vm.MessageOk ? "" : "err")">@Vm.Message</div>
        }

        <section class="summary-strip" aria-label="Cluster summary">
            <div class="summary-count">
                <strong>@(Vm.Nodes?.Count ?? 0)</strong>
                <span>nodes</span>
            </div>
            <div class="summary-count succeeded">
                <strong>@(Vm.Nodes?.Count(n => n.Ready) ?? 0)</strong>
                <span>ready</span>
            </div>
            <div class="summary-count">
                <strong>@(Vm.Nodes?.Count(n => n.IsControlPlane) ?? 0)</strong>
                <span>control plane</span>
            </div>
            <div class="summary-progress" title="@($"{Vm.ReadyPercent:0}% ready")">
                <span style="width:@($"{Vm.ReadyPercent:0}%")"></span>
            </div>
        </section>

        <section class="fleet-section">
            <div class="section-heading">
                <div>
                    <h2>Fleet nodes</h2>
                    <p>Live health, network identity and available compute.</p>
                </div>
                <span class="last-sync">Updated @Vm.LastSyncLabel</span>
            </div>

            @if (Vm.Nodes is null || Vm.Nodes.Count == 0)
            {
                <div class="empty-fleet">
                    <div class="empty-orbit"><AppIcon Kind="circle" /></div>
                    <strong>No nodes found</strong>
                    <span>Add a worker to start building this cluster.</span>
                </div>
            }
            else
            {
                <div class="node-grid">
                    @foreach (var n in Vm.Nodes)
                    {
                        <article class="node-card @(!n.Ready ? "node-warning" : "")">
                            <div class="node-top">
                                <div class="node-avatar @(n.IsControlPlane ? "master-avatar" : "")">
                                    <AppIcon Kind="@(n.IsControlPlane ? "data.graph" : "box")" />
                                    <span class="status-pin @(n.Ready ? "online" : "offline")"></span>
                                </div>
                                <div class="node-title">
                                    <div>
                                        <h3>@n.Name</h3>
                                        @if (n.IsSelf)
                                        {
                                            <span class="you-badge">this host</span>
                                        }
                                    </div>
                                    <span class="node-status @(n.Ready ? "ready" : "not-ready")">
                                        <i></i>@(n.Ready ? "Ready" : "Not ready")
                                    </span>
                                </div>
                            </div>

                            <div class="role-row">
                                @if (n.IsDesignatedMaster)
                                {
                                    <span class="role-chip master-chip">★ Fleet master</span>
                                }
                                @if (!n.IsControlPlane)
                                {
                                    <span class="role-chip">Standard worker</span>
                                }
                                @foreach (var role in n.Roles.Take(3))
                                {
                                    <span class="role-chip">@role</span>
                                }
                            </div>

                            <div class="resource-row">
                                <div class="resource">
                                    <span>CPU</span>
                                    <strong>@(n.CpuCapacity ?? "—")</strong>
                                </div>
                                <div class="resource-divider"></div>
                                <div class="resource">
                                    <span>Memory</span>
                                    <strong>@(n.MemoryCapacity ?? "—")</strong>
                                </div>
                            </div>

                            <dl class="node-details">
                                <div><dt>Address</dt><dd class="mono">@(n.PreferredIp ?? "—")</dd></div>
                                <div><dt>Platform</dt><dd>@ClusterViewModel.PlatformLabel(n)</dd></div>
                                <div><dt>Kubelet</dt><dd class="mono">@n.KubeletVersion</dd></div>
                                <div><dt>Joined</dt><dd>@ClusterViewModel.RelativeAge(n.CreatedAt)</dd></div>
                            </dl>
                        </article>
                    }
                </div>
            }
        </section>

        @* ── Join command pane ─────────────────────────────────────────────────────── *@
        @if (Vm.ShowAddWorkerOptions)
        {
            <div class="cluster-overlay dcmodal-overlay" @onclick="Vm.DismissJoin">
                <div class="join-dialog dcmodal" role="dialog" aria-modal="true" aria-label="Add a node" @onclick:stopPropagation="true">
                    <div class="join-head">
                        <div class="join-symbol"><AppIcon Kind="plus" /></div>
                        <div>
                            <h3>Add a node</h3>
                            <p>Connect a machine to run jobs.</p>
                        </div>
                        <button aria-label="Close" class="dialog-close" @onclick="Vm.DismissJoin"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="join-body dcmodal-body">
                        <p>Run this command on the machine you want to join.</p>
                        <div class="command-shell">
                            <code>@Vm.JoinCommand</code>
                            <button @onclick="Vm.CopyCommandAsync"><AppIcon Kind="@(Vm.Copied ? "check" : "copy")" /> @(Vm.Copied ? "Copied" : "Copy")</button>
                        </div>
                        <div class="security-note">
                            <AppIcon Kind="key" />
                            This join token is short-lived. Generate a new command for each worker.
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Vm.Attach(() => InvokeAsync(StateHasChanged));
        await Vm.InitializeAsync();
    }

    public void Dispose() => Vm.Detach();
}
