@page "/cluster"
@attribute [Authorize(Policy = Permission.SettingsManage)]
@implements IDisposable
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject NavigationManager Nav
@inject PlaceContext.Infrastructure.Operations.OperationCenter OpCenter

<PageTitle>PlaceContext — Cluster</PageTitle>

@if (_loading)
{
    <Skeleton Kind="list" Rows="6" Padded />
}
else
{
    <div class="page">

        <div class="page-head">
            <div>
                <h2 class="page-title">Cluster</h2>
                <div class="page-sub">
                    Fleet nodes, promote master, add machines over Tailscale — plus jobs pipeline telemetry.
                </div>
            </div>
            <button class="dcbtn" @onclick="RefreshAsync" disabled="@_busy">Refresh</button>
        </div>

        @if (_message is not null)
        {
            <div class="message-bar @(_messageIsError ? "message-error" : "")">@_message</div>
        }

        @* ── Nodes ──────────────────────────────────────────────────────────────────────────── *@
        <div class="section-head">
            <h3 class="section-title">Nodes</h3>
            <span class="node-count-badge">
                @(_cluster?.IsRealCluster == true ? $"{_cluster.NodeCount} node(s)" : "local single-node (Docker runner)")
            </span>
            @if (_cluster?.DesignatedMaster is { } dm)
            {
                <span class="master-pill" title="Designated fleet master (join codes target this node)">
                    master · @dm.Name
                    @if (dm.TailscaleIp is not null)
                    {
                        <span class="master-pill-ip">@dm.TailscaleIp</span>
                    }
                </span>
            }
        </div>

        <div class="node-grid">
            @foreach (var node in _cluster?.Nodes ?? Array.Empty<ClusterNode>())
            {
                <div class="dccard node-card @(node.IsDesignatedMaster ? "node-card-master" : "")"
                     style="@(node.IsSelf ? "border-left:2px solid var(--brand-2)" : "")">
                    <div class="node-card-head">
                        <div class="node-name-row">
                            <span class="node-name">@node.Name</span>
                            @if (node.IsSelf)
                            {
                                <span class="this-node-badge">this node</span>
                            }
                            @if (node.IsDesignatedMaster)
                            {
                                <span class="master-badge">master</span>
                            }
                            else if (node.IsControlPlane)
                            {
                                <span class="cp-badge">control-plane</span>
                            }
                        </div>
                        <span class="node-status"
                              style="color:@(node.Ready ? "var(--good)" : "var(--bad)"); background:@(node.Ready ? "var(--good-bg)" : "var(--bad-bg)")">
                            @(node.Ready ? "Ready" : "Not ready")
                        </span>
                    </div>
                    <div class="node-roles">@string.Join(", ", node.Roles)</div>
                    <div class="node-meta">
                        <div>kubelet <span class="text-3">@node.KubeletVersion</span></div>
                        <div>@node.OperatingSystem</div>
                        @if (node.CpuCapacity is not null || node.MemoryCapacity is not null)
                        {
                            <div>@node.CpuCapacity @(node.CpuCapacity is not null && node.MemoryCapacity is not null ? "·" : "") @node.MemoryCapacity</div>
                        }
                        @if (node.TailscaleIp is not null)
                        {
                            <div class="font-sans ts-ip" title="Tailscale mesh address">mesh @node.TailscaleIp</div>
                        }
                        else if (node.InternalIp is not null)
                        {
                            <div class="font-sans">@node.InternalIp</div>
                        }
                        @if (node.CreatedAt is { } created)
                        {
                            <div class="text-3">joined @created.ToWorkspaceTime().ToString("yyyy-MM-dd")</div>
                        }
                    </div>
                    @if (!node.IsDesignatedMaster)
                    {
                        <div class="node-actions">
                            <button class="dcbtn primary node-promote"
                                    disabled="@(_busy || !node.Ready)"
                                    @onclick="() => PromoteAsync(node)">
                                Promote to master
                            </button>
                        </div>
                    }
                </div>
            }
        </div>

        @if (_hostAction is not null)
        {
            <div class="dccard host-action-card">
                <div class="host-action-title">Host action required (agent → control-plane)</div>
                <pre class="host-action-pre">@_hostAction</pre>
            </div>
        }

        @* ── Add a node (Tailscale) ─────────────────────────────────────────────────────────── *@
        <div class="section-head">
            <h3 class="section-title">Add a node</h3>
        </div>
        <div class="dccard add-node-card">
            <p class="add-node-lead">
                New machines (for example a DigitalOcean droplet) join the fleet over
                <strong>Tailscale</strong>, targeting the designated master
                @if (_cluster?.DesignatedMaster is { } m)
                {
                    <text>(currently <code>@m.Name</code>@if (m.PreferredIp is not null) { <text> · @m.PreferredIp</text> }).</text>
                }
                else
                {
                    <text>.</text>
                }
            </p>
            <ol class="add-node-steps">
                <li>Promote the Mac (or desired control-plane) to <strong>master</strong> above if it is not already.</li>
                <li>Ensure Tailscale is up on the master and on the new host (same tailnet / Headscale).</li>
                <li>On the new host install the CLI, then connect with the join code below.</li>
            </ol>

            @if (_join is not null)
            {
                <div class="join-code-block">
                    <div class="join-code-label">Join code</div>
                    <code class="join-code">@_join.JoinCode</code>
                    <div class="join-meta">
                        API: <code>@_join.ServerUrl</code>
                        · @(_join.IncludesTailscaleAuthKey ? "includes Tailscale auth key" : "Tailscale must already be connected on the new host")
                    </div>
                    <pre class="join-instructions">@_join.Instructions</pre>
                </div>
            }
            else
            {
                <div class="join-missing">
                    Portal join codes are unavailable until the cluster join secret is seeded on a k3s server
                    (redeploy / <code>placecontext upgrade</code> on the master after install).
                    Meanwhile on the master host run:
                    <pre class="join-instructions">sudo placecontext   # or tools/pctl join-code
# then on the new DO node:
curl -fsSL https://get.placecontext.ai/install.sh | bash
placecontext connect --code &lt;code&gt;</pre>
                </div>
            }
            <button class="dcbtn" disabled="@_busy" @onclick="LoadJoinAsync">
                @(_join is null ? "Load join code" : "Refresh join code")
            </button>
        </div>

        @* ── Telemetry ──────────────────────────────────────────────────────────────────────── *@
        <h3 class="section-title-tele">Jobs pipeline telemetry</h3>
        <div class="tele-note">
            Collected in-process from the <code>PlaceContext.Jobs</code> OpenTelemetry source/meter since this replica started — no external collector required.
        </div>

        <div class="tile-row">
            @foreach (var tile in StatTiles())
            {
                <div class="dccard stat-tile">
                    <div class="tile-label">@tile.Label</div>
                    <div class="tile-value-row">
                        <span class="tile-value" style="color:@tile.Color">@tile.Value</span>
                    </div>
                    @if (tile.Sub is not null)
                    {
                        <div class="tile-sub">@tile.Sub</div>
                    }
                </div>
            }
        </div>

        @if (_snapshot?.ShardsCompletedByOutcome is { Count: > 0 } outcomes)
        {
            <div class="dccard outcomes-card">
                <div class="outcomes-title">SHARDS BY OUTCOME</div>
                <div class="outcomes-row">
                    @foreach (var (outcome, count) in outcomes.OrderByDescending(kv => kv.Value))
                    {
                        <div class="outcome-item">
                            <span class="outcome-count" style="color:@StatusColor(outcome)">@count</span>
                            <span class="outcome-label">@outcome</span>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="runs-title">Recent run traces</div>
        @if (_recentRuns is null or { Count: 0 })
        {
            <div class="dccard runs-empty">
                No job runs captured yet by this replica — run a job and it appears here.
            </div>
        }
        else
        {
            <div class="runs-list">
                @foreach (var run in _recentRuns)
                {
                    <a href="@($"/observability?run={run.RunId}")" class="run-link">
                        <div class="dccard run-card">
                            <div class="run-row">
                                <span class="run-status"
                                      style="color:@StatusColor(run.Status); background:@StatusBg(run.Status)">@(run.Status ?? "Running")</span>
                                <div class="run-main">
                                    <span class="run-name">@(run.JobName ?? run.JobId.ToString("N")[..8])</span>
                                    @if (run.Replay)
                                    {
                                        <span class="replay-badge">replay</span>
                                    }
                                </div>
                                <span class="run-shards">@run.Shards.Count shard(s)</span>
                                <span class="run-started">
                                    @run.StartedAt.ToWorkspaceTime().ToString("yyyy-MM-dd HH:mm")
                                </span>
                                <span class="run-duration">
                                    @FormatMs(run.DurationMs)
                                </span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }

        @* ── Chain telemetry ────────────────────────────────────────────────────────────────── *@
        <h3 class="section-title-tele">Job chain telemetry</h3>

        <div class="tile-row">
            @foreach (var tile in ChainStatTiles())
            {
                <div class="dccard stat-tile">
                    <div class="tile-label">@tile.Label</div>
                    <div class="tile-value-row">
                        <span class="tile-value" style="color:@tile.Color">@tile.Value</span>
                    </div>
                    @if (tile.Sub is not null)
                    {
                        <div class="tile-sub">@tile.Sub</div>
                    }
                </div>
            }
        </div>

        <div class="runs-title">Recent chain traces</div>
        @if (_recentChainRuns is null or { Count: 0 })
        {
            <div class="dccard runs-empty">
                No chain runs captured yet by this replica — run a job chain and it appears here.
            </div>
        }
        else
        {
            <div class="runs-list">
                @foreach (var run in _recentChainRuns)
                {
                    <a href="@($"/observability?chainRun={run.ChainRunId}")" class="run-link">
                        <div class="dccard run-card">
                            <div class="run-row">
                                <span class="run-status"
                                      style="color:@StatusColor(run.Status); background:@StatusBg(run.Status)">@(run.Status ?? "Running")</span>
                                <div class="run-main">
                                    <span class="run-name">@(run.ChainName ?? run.ChainId.ToString("N")[..8])</span>
                                </div>
                                <span class="run-shards">@run.Steps.Count step(s)</span>
                                <span class="run-started">
                                    @run.StartedAt.ToWorkspaceTime().ToString("yyyy-MM-dd HH:mm")
                                </span>
                                <span class="run-duration">
                                    @FormatMs(run.DurationMs)
                                </span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
}

@code {
    private ClusterInfo? _cluster;
    private ClusterJoinMaterial? _join;
    private JobTelemetrySnapshot? _snapshot;
    private IReadOnlyList<JobRunTelemetry>? _recentRuns;
    private IReadOnlyList<ChainRunTelemetry>? _recentChainRuns;
    private string? _message;
    private bool _messageIsError;
    private string? _hostAction;
    private bool _loading = true;
    private bool _busy;
    private bool _refreshing;

    protected override async Task OnInitializedAsync()
    {
        OpCenter.Changed += OnOpsChanged;
        await RefreshAsync();
        try { _join = await Svc.GetClusterJoinMaterialAsync(); } catch { /* optional */ }
        Ui.Set("Cluster", "nodes · promote master · Tailscale join");
        _loading = false;
    }

    private void OnOpsChanged() => _ = InvokeAsync(async () =>
    {
        if (_refreshing) return;
        _refreshing = true;
        try { await RefreshAsync(); StateHasChanged(); }
        finally { _refreshing = false; }
    });

    public void Dispose() => OpCenter.Changed -= OnOpsChanged;

    private async Task RefreshAsync()
    {
        _message = null;
        _messageIsError = false;
        try
        {
            _cluster = await Svc.GetClusterInfoAsync();
            _snapshot = await Svc.GetJobTelemetrySnapshotAsync();
            _recentRuns = await Svc.ListRecentJobRunTelemetryAsync(50);
            _recentChainRuns = await Svc.ListRecentChainRunTelemetryAsync(50);
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
    }

    private async Task PromoteAsync(ClusterNode node)
    {
        if (_busy) return;
        _busy = true;
        _hostAction = null;
        _message = null;
        _messageIsError = false;
        try
        {
            var result = await Svc.PromoteNodeToMasterAsync(node.Name);
            _message = result.Message;
            _messageIsError = !result.Succeeded;
            _hostAction = result.HostActionRequired;
            await RefreshAsync();
            try { _join = await Svc.GetClusterJoinMaterialAsync(); } catch { /* optional */ }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally { _busy = false; }
    }

    private async Task LoadJoinAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            _join = await Svc.GetClusterJoinMaterialAsync();
            if (_join is null)
            {
                _message = "Join secret not seeded yet — run upgrade/deploy on the k3s master, or use placecontext join-code on the host.";
                _messageIsError = false;
            }
            else
            {
                _message = "Join code refreshed.";
                _messageIsError = false;
            }
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _messageIsError = true;
        }
        finally { _busy = false; }
    }

    private sealed record Tile(string Label, string Value, string? Sub, string Color);

    private IEnumerable<Tile> StatTiles()
    {
        yield return new Tile("RUNS STARTED", (_snapshot?.RunsStarted ?? 0).ToString(), "since this replica booted", "var(--text)");

        foreach (var (status, count) in (_snapshot?.RunsCompletedByStatus ?? new Dictionary<string, long>()).OrderByDescending(kv => kv.Value))
            yield return new Tile($"COMPLETED · {status.ToUpperInvariant()}", count.ToString(), "runs", StatusColor(status));

        if (_snapshot?.RunDuration is { } rd)
            yield return new Tile("RUN DURATION", FormatMs(rd.AvgMs) ?? "—", $"avg · min {FormatMs(rd.MinMs)} · max {FormatMs(rd.MaxMs)}", "var(--text)");

        if (_snapshot?.ShardDuration is { } sd)
            yield return new Tile("SHARD DURATION", FormatMs(sd.AvgMs) ?? "—", $"avg · min {FormatMs(sd.MinMs)} · max {FormatMs(sd.MaxMs)}", "var(--text)");
    }

    private IEnumerable<Tile> ChainStatTiles()
    {
        yield return new Tile("CHAINS STARTED", (_snapshot?.ChainsStarted ?? 0).ToString(), "since this replica booted", "var(--text)");

        foreach (var (status, count) in (_snapshot?.ChainsCompletedByStatus ?? new Dictionary<string, long>()).OrderByDescending(kv => kv.Value))
            yield return new Tile($"COMPLETED · {status.ToUpperInvariant()}", count.ToString(), "chain runs", StatusColor(status));

        if (_snapshot?.ChainDuration is { } cd)
            yield return new Tile("CHAIN DURATION", FormatMs(cd.AvgMs) ?? "—", $"avg · min {FormatMs(cd.MinMs)} · max {FormatMs(cd.MaxMs)}", "var(--text)");
    }

    private static string? FormatMs(double? ms) => ms switch
    {
        null => null,
        < 1000 => $"{ms:0}ms",
        < 60000 => $"{ms / 1000:0.#}s",
        _ => $"{ms / 60000:0.#}m",
    };

    private static string StatusColor(string? status) => status switch
    {
        "Succeeded" => "var(--good)",
        "Failed" => "var(--bad)",
        "Partial" => "var(--warn)",
        "Running" => "var(--brand-2)",
        _ => "var(--text-3)"
    };

    private static string StatusBg(string? status) => status switch
    {
        "Succeeded" => "var(--good-bg)",
        "Failed" => "var(--bad-bg)",
        "Partial" => "var(--warn-bg)",
        "Running" => "var(--brand-bg)",
        _ => "var(--card-2)"
    };
}
