@page "/settings/database"
@attribute [Authorize(Policy = Policies.DatabaseInspection)]
@inject PortalUiState Ui
@inject PlaceContextService Service
@inject NavigationManager Navigation

<PageTitle>PlaceContext — Database</PageTitle>
<p>Opening the PlaceContext database in Data…</p>

@code {
    protected override async Task OnInitializedAsync()
    {
        var projectId = Ui.CurrentProjectId ?? (await Service.GetProjectsAsync()).FirstOrDefault()?.Id;
        if (projectId is { } id)
        {
            Navigation.NavigateTo(PageRoutes.ApplicationDatabase(id), replace: true);
            return;
        }
        Navigation.NavigateTo("/", replace: true);
    }
}
