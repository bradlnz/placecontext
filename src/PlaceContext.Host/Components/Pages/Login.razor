@page "/login"
@attribute [AllowAnonymous]
@layout PlaceContext.Host.Components.Layout.AuthLayout

@using Microsoft.AspNetCore.Components.Forms

@* Password sign-in. Posts as a plain HTML form to AuthController.Login (see Setup.razor's comment for
   why — cookie sign-in needs a normal HTTP round trip, not a Blazor circuit event). Errors are always
   the same generic string regardless of what actually went wrong, so a response can't be used to probe
   for valid emails. *@

<PageTitle>placecontext — sign in</PageTitle>

<div class="dccard auth-card">
    <div class="auth-brand">
        <div class="auth-mark">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8l3.5 4L5 16"></path><path d="M13 16h6"></path></svg>
        </div>
        <span class="auth-brand-name">placecontext</span>
    </div>

    <h1 class="auth-title">Sign in</h1>
    <p class="auth-sub">Enter this workspace's admin (or member) credentials.</p>

    <form method="post" action="/auth/login" class="auth-form">
        <AntiforgeryToken />
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="auth-error">@Error</div>
        }
        @if (!string.IsNullOrEmpty(ReturnUrl))
        {
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
        }
        <div class="dcfield">
            <label>Email</label>
            <input class="dcinput" type="email" name="email" required autofocus value="@Email" autocomplete="username" />
        </div>
        <div class="dcfield">
            <label>Password</label>
            <input class="dcinput" type="password" name="password" required autocomplete="current-password" />
        </div>
        <button type="submit" class="dcbtn primary auth-submit">Sign in</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }
}
