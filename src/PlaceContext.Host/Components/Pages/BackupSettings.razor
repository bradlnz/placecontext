@page "/settings/backup"
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@attribute [Authorize(Policy = Policies.DefaultAdmin)]
@using PlaceContext.Host.Components.ViewModels
@inject BackupSettingsViewModel Vm
@implements IDisposable
<PageTitle>placecontext — Backup</PageTitle>
<div class="page">
    <h2 class="title">Backup & restore</h2>
    <div class="intro">
        Export this workspace's settings and job definitions to a single JSON manifest, or import one to bring a workspace up to date. Run history and vault secrets are never included.
    </div>
    <div class="export-grid">
        <div class="dccard card-export">
            <div class="card-title">Export backup</div>
            <div class="card-desc">Downloads projects, jobs, chains, triggers, event types, data mappings, and workspace settings as one JSON file.</div>
            <a class="dcbtn primary link-btn" href="/backup/export">Download backup</a>
        </div>
        <div class="dccard card-export code-export">
            <div class="card-title">Export job code</div>
            <div class="card-desc">Downloads every job's map and reduce source files as a ZIP.</div>
            <a class="dcbtn primary link-btn" href="/backup/jobs-code">Download job code</a>
        </div>
    </div>
    <div class="dccard card-import">
        <div class="card-title">Import backup</div>
        <div class="card-desc">Merges a manifest into this workspace; re-importing the same file is safe.</div>
        <InputFile OnChange="Vm.SelectFileAsync" accept="application/json" class="dcinput" style="padding:6px" />
        @if (Vm.Pending is not null)
        {
            <div class="card-desc">
                Loaded <span class="code">@Vm.FileName</span> — @Vm.Pending.Projects.Count project(s), @Vm.Pending.Jobs.Count job(s), @Vm.Pending.JobChains.Count chain(s).
            </div>
            @if (Vm.Confirming)
            {
                <button class="dcbtn primary" disabled="@Vm.Busy" @onclick="Vm.ImportAsync">
                    @(Vm.Busy ? "Importing…" : "Confirm import")
                </button>
                <button class="dcbtn" disabled="@Vm.Busy" @onclick="() => Vm.Confirming = false">Cancel</button>
            }
            else
            {
                <button class="dcbtn" @onclick="() => Vm.Confirming = true">Import into this workspace</button>
            }
        }
        @if (Vm.Message is not null)
        {
            <div class="message">@Vm.Message</div>
        }
        @if (Vm.Result is not null)
        {
            <div class="dchint">
                Projects: @Vm.Result.ProjectsCreated created / @Vm.Result.ProjectsUpdated updated · Jobs: @Vm.Result.JobsCreated created / @Vm.Result.JobsUpdated updated / @Vm.Result.JobsSkipped skipped
            </div>
        }
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        Vm.Attach(() => InvokeAsync(StateHasChanged));
        Vm.Load();
    }

    public void Dispose() => Vm.Detach();
}
