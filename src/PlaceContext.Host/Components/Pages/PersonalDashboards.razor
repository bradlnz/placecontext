@page "/project/{ProjectId:guid}/dashboards"
@attribute [Authorize(Policy = Permission.DataRead)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@inject NavigationManager Navigation

<PageTitle>PlaceContext — Workflow overview</PageTitle>
<section role="status" class="dccard" style="padding:24px">
    <h1>Workflow overview</h1>
    <p>The separate personal dashboard has been retired. Workflow status, activity and insights live in the main overview and Workflows.</p>
    <a class="dcbtn primary" href="/">Open workflow overview <AppIcon Kind="arrow-right" /></a>
</section>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Navigation.NavigateTo("/", replace: true);
    }
}
