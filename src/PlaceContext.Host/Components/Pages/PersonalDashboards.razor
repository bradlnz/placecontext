@using PlaceContext.Application.Access
@page "/project/{ProjectId:guid}/dashboards"
@attribute [Authorize(Policy = Permission.DataRead)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@inject NavigationManager Navigation

<PageTitle>PlaceContext — Dashboard</PageTitle>
<section role="status" class="dccard" style="padding:24px">
    <h1>Dashboard</h1>
    <p>Your assistant, project activity, and charts are together in Dashboard.</p>
    <a class="dcbtn primary" href="@($"/project/{ProjectId}/dashboard")">Open Dashboard <AppIcon Kind="arrow-right" /></a>
</section>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Navigation.NavigateTo($"/project/{ProjectId}/dashboard", replace: true);
    }
}
