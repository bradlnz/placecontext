@page "/project/{ProjectId:guid}/data"
@attribute [Authorize(Policy = Permission.DataRead)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@using PlaceContext.Host.Components.ViewModels
@using PlaceContext.Host.Components.ViewModels.Helpers
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@inject ProjectDataViewModel Vm

<PageTitle>PlaceContext — SQL Studio</PageTitle>

<div class="page data-page sql-studio-page">

    <DataTabs ProjectId="ProjectId" Active="@DataSection.Tables" />

    <section class="sql-studio">
        <aside class="studio-sidebar">
            <div class="studio-sidebar-tabs">
                <button class="studio-sidebar-tab @(Vm.SidebarPane == SidebarPane.Tables ? "active" : "")"
                        @onclick="() => Vm.ShowPane(SidebarPane.Tables)">Tables</button>
                <button class="studio-sidebar-tab @(Vm.SidebarPane == SidebarPane.Indexes ? "active" : "")"
                        @onclick="() => Vm.ShowPane(SidebarPane.Indexes)">Indexes</button>
                <button class="studio-sidebar-tab @(Vm.SidebarPane == SidebarPane.Queries ? "active" : "")"
                        @onclick="() => Vm.ShowPane(SidebarPane.Queries)">Queries</button>
            </div>

            @if (Vm.SidebarPane == SidebarPane.Tables)
            {
                <button class="studio-new-table" @onclick="() => Vm.StartNewTable()">
                    <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>New table
                </button>
                @if (Vm.MaterializeMessage is not null)
                {
                    <div class="studio-note">@Vm.MaterializeMessage</div>
                }
                <div class="studio-search">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
                    <input type="text" placeholder="Search tables" @bind="Vm.TableFilter" @bind:event="oninput" />
                </div>
                <div class="studio-resource-list">
                    @if (!Vm.TablesReady)
                    {
                        <Skeleton Kind="list" Rows="6" />
                    }
                    else if (Vm.FilteredTables.Count == 0)
                    {
                        <div class="empty-tables">No tables match.</div>
                    }
                    else
                    {
                        <div class="resource-group">Tables (@Vm.FilteredTables.Count)</div>
                        @foreach (var t in Vm.FilteredTables)
                        {
                            <article @key="t.Name" class="resource-item @(Vm.ActiveTableName == t.Name ? "active" : "")" @onclick="@(() => Vm.OpenTableTabAsync(t.Name))">
                                <span class="resource-icon">
                                    <svg viewBox="0 0 24 24">
                                        <ellipse cx="12" cy="5" rx="8" ry="3" />
                                        <path d="M4 5v7c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12v7c0 1.7 3.6 3 8 3s8-1.3 8-3v-7" />
                                    </svg>
                                </span>
                                <div class="resource-copy">
                                    <strong>@t.Name</strong>
                                    <span>@Vm.TableTag(t)</span>
                                </div>
                                <span class="resource-tag">@Vm.TableEngineTag(t)</span>
                                <button class="studio-materialize" title="Copy this table into an OpenSearch index (for search)"
                                        @onclick:stopPropagation="true" @onclick="@(() => Vm.OpenMaterializeDialog(t.Name))">
                                    <svg viewBox="0 0 24 24"><path d="M12 3v12M5 10l7 7 7-7" /><path d="M5 21h14" /></svg>
                                </button>
                            </article>
                        }
                    }
                </div>
            }
            else if (Vm.SidebarPane == SidebarPane.Indexes)
            {
                <div class="studio-search">
                    <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
                    <input type="text" placeholder="Search indices" @bind="Vm.TableFilter" @bind:event="oninput" />
                </div>
                <div class="studio-resource-list">
                    @if (!Vm.IndicesReady)
                    {
                        <Skeleton Kind="list" Rows="6" />
                    }
                    else if (Vm.IndicesError is not null)
                    {
                        <div class="empty-tables">@Vm.IndicesError</div>
                    }
                    else if (Vm.FilteredIndices.Count == 0)
                    {
                        <div class="empty-tables">No indices match.</div>
                    }
                    else
                    {
                        <div class="resource-group">Indices (@Vm.FilteredIndices.Count)</div>
                        @foreach (var idx in Vm.FilteredIndices)
                        {
                            <article @key="idx.Name" class="resource-item @(Vm.ActiveTableName == idx.Name ? "active" : "")"
                                     @onclick="@(() => Vm.OpenIndexTabAsync(idx.Name))">
                                <span class="resource-icon">
                                    <svg viewBox="0 0 24 24"><path d="M4 5h16M4 5v14a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V5M4 9h16M4 13h16M4 17h16" /></svg>
                                </span>
                                <div class="resource-copy">
                                    <strong>@idx.Name</strong>
                                    <span>@Vm.FormatDocumentCount(idx.DocumentCount) doc(s)</span>
                                </div>
                                <span class="resource-tag">@(idx.StoreSize ?? "—")</span>
                            </article>
                        }
                    }
                </div>
            }
            else
            {
                <button class="studio-new-table" @onclick="Vm.SaveCurrentQuery" title="Save the editor contents as a named query">
                    <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><path d="M17 21v-8H7v8" /></svg>
                    Save current query
                </button>
                <div class="studio-resource-list">
                    @if (!Vm.SavedQueriesReady)
                    {
                        <Skeleton Kind="list" Rows="6" />
                    }
                    else if (Vm.SavedQueriesError is not null)
                    {
                        <div class="empty-tables">@Vm.SavedQueriesError</div>
                    }
                    else if (Vm.FilteredSavedQueries.Count == 0)
                    {
                        <div class="empty-tables">No saved queries yet.</div>
                    }
                    else
                    {
                        <div class="resource-group">Queries (@Vm.FilteredSavedQueries.Count)</div>
                        @foreach (var q in Vm.FilteredSavedQueries)
                        {
                            <article @key="q.Id" class="resource-item @(Vm.ActiveTableName == q.Name ? "active" : "")"
                                     @onclick="@(() => Vm.OpenSavedQueryAsync(q))" title="@q.Sql">
                                <span class="resource-icon">
                                    <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><path d="M17 21v-8H7v8" /></svg>
                                </span>
                                <div class="resource-copy">
                                    <strong>@q.Name</strong>
                                    <span>@Vm.SqlPreview(q.Sql)</span>
                                </div>
                                <button class="studio-query-delete" title="Delete @q.Name"
                                        @onclick:stopPropagation="true" @onclick="@(() => Vm.DeleteSavedQueryAsync(q.Id))">✕</button>
                            </article>
                        }
                    }
                </div>
            }
        </aside>

        <section class="studio-main">
            @if (Vm.OpenTabs.Count == 0)
            {
                <div class="studio-empty">
                    <div class="studio-empty-title">SQL Studio</div>
                    <p>Select a table from the left to open a query tab, or write a new SELECT statement.</p>
                </div>
            }
            else
            {
                <div class="studio-toolbar">
                    <div class="studio-query-title">
                        <span>@(Vm.ActiveTableName ?? "Untitled query")</span>
                    </div>
                    <div class="studio-toolbar-spacer"></div>
                    <button class="studio-run" disabled="@Vm.ActiveTableTab?.Running" @onclick="@(async () => { if (Vm.ActiveTableTab is { } a) await Vm.RunTableTabAsync(a); })">
                        <svg viewBox="0 0 24 24"><path d="M5 3l14 9-14 9V3z" /></svg>
                        @(Vm.ActiveTableTab?.Running == true ? "Running…" : "Run")
                    </button>
                    <button class="studio-tool" title="Save this query" @onclick="Vm.SaveCurrentQuery">
                        <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><path d="M17 21v-8H7v8" /></svg>
                        Save
                    </button>
                </div>

                <div class="studio-tabs">
                    @foreach (var tab in Vm.OpenTabs)
                    {
                        <button @key="tab.TableName" class="studio-tab @(tab.TableName == Vm.ActiveTableName ? "active" : "")"
                                @onclick="@(() => Vm.ActivateTabAsync(tab.TableName))" title="@tab.TableName">
                            <span>@tab.TableName</span>
                            <span class="studio-tab-close"
                                  @onclick:stopPropagation="true" @onclick="@(() => Vm.CloseTableTabAsync(tab.TableName))"
                                  title="Close @tab.TableName">×</span>
                        </button>
                    }
                </div>

                @if (Vm.ActiveTableTab is { } activeTab)
                {
                    <div class="studio-editor-shell">
                        @if (Vm.SqlEditorMonaco)
                        {
                            <div id="@ProjectDataViewModel.SqlEditorId" class="studio-sql-editor monaco-box"></div>
                        }
                        else
                        {
                            <textarea class="studio-sql-editor"
                                      @bind="activeTab.Sql" @bind:event="oninput"></textarea>
                        }
                    </div>

                    <div id="pcdata-studio-splitter" class="studio-splitter" title="Drag to resize"></div>

                    <div class="studio-results-bar">
                        <div class="studio-results-search">
                            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
                            <input type="text" placeholder="Search results…" @bind="Vm.ResultFilter" @bind:event="oninput" />
                        </div>
                        <div class="studio-results-stats">
                            @if (activeTab.Error is not null)
                            {
                                <span class="stat-error">@activeTab.Error</span>
                            }
                            else if (activeTab.Result is not null && activeTab.Result.Columns.Count == 0)
                            {
                                <span class="stat-ok">OK — @activeTab.Result.AffectedRows row(s) affected.</span>
                            }
                            else if (activeTab.Result is not null)
                            {
                                <span>Elapsed: @Vm.FormatElapsed(activeTab.Result)</span>
                                <span>
                                    @if (!string.IsNullOrWhiteSpace(Vm.ResultFilter))
                                    {
                                        @:Showing @Vm.FilteredResultRows(activeTab).Count of @activeTab.Result.Rows.Count row(s)
                                    }
                                    else
                                    {
                                        @:Read: @activeTab.Result.Rows.Count row(s)@(activeTab.Result.Truncated ? " (truncated at 500)" : "")
                                    }
                                </span>
                            }
                            else
                            {
                                <span>Run a query to see results</span>
                            }
                        </div>
                        <div class="studio-results-tabs">
                            <button class="studio-results-tab @(Vm.ResultsPane == ProjectDataResultsPane.Table ? "active" : "")"
                                    @onclick="() => Vm.ShowResultsPane(ProjectDataResultsPane.Table)">Table</button>
                            <button class="studio-results-tab @(Vm.ResultsPane == ProjectDataResultsPane.Chart ? "active" : "")"
                                    @onclick="() => Vm.ShowResultsPane(ProjectDataResultsPane.Chart)">Chart</button>
                        </div>
                    </div>

                    @if (Vm.ResultsPane == ProjectDataResultsPane.Table)
                    {
                        @if (activeTab.Result is { Columns.Count: > 0 })
                        {
                            <div class="studio-results">
                                <table class="studio-result-table">
                                    <thead>
                                        <tr>
                                            <th class="result-row-num">#</th>
                                            @foreach (var c in activeTab.Result.Columns)
                                            {
                                                <th>@c</th>
                                            }
                                            <th class="result-row-actions"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <Virtualize Items="@Vm.FilteredResultRows(activeTab)" Context="row" ItemSize="24">
                                            <tr @onclick="@(() => Vm.SelectRow(row.Index))" class="@(Vm.SelectedRowIndex == row.Index ? "selected" : "")">
                                                <td class="result-row-num">@(row.Index + 1)</td>
                                                @for (var i = 0; i < activeTab.Result!.Columns.Count; i++)
                                                {
                                                    var columnName = activeTab.Result.Columns[i];
                                                    var cellValue = i < row.Row.Count ? row.Row[i] : null;
                                                    <td>
                                                        @if (cellValue is not null && Vm.IsJsonCellPresentation(columnName, cellValue))
                                                        {
                                                            <button class="json-view-button" @onclick:stopPropagation="true" @onclick="@(() => Vm.OpenStudioJsonViewer(columnName, cellValue))">View data</button>
                                                        }
                                                        else
                                                        {
                                                            <OpenSearchDataValue ProjectId="ProjectId" Column="@columnName" Value="@cellValue" NullText="∅" />
                                                        }
                                                    </td>
                                                }
                                                <td class="result-row-actions">
                                                    @if (!activeTab.IsIndex)
                                                    {
                                                        var rowValues = activeTab.Result!.Columns
                                                            .Select((c, i) => (Column: c, Value: i < row.Row.Count ? row.Row[i] : null))
                                                            .ToDictionary(x => x.Column, x => x.Value);
                                                        <button class="row-graph-button"
                                                                title="Show linked records"
                                                                @onclick:stopPropagation="true"
                                                                @onclick="@(() => Vm.OpenGraphPaneAsync(activeTab.TableName, rowValues, row.Index))">
                                                            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98" /></svg>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        </Virtualize>
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="studio-chart">
                            @if (Vm.BuildChartSpec(activeTab) is { } spec)
                            {
                                <div class="studio-chart-title">@spec.Title</div>
                                <div class="studio-chart-sub">@spec.Subtitle</div>
                                <canvas id="pcdata-chart-canvas"></canvas>
                            }
                            else
                            {
                                <div class="studio-chart-empty">Run a query with at least one numeric column to see a chart.</div>
                            }
                        </div>
                    }
                }

                @if (Vm.StudioJsonViewerValue is not null)
                {
                    <aside class="json-side-pane">
                        <header>
                            <div><strong>@Vm.StudioJsonViewerTitle</strong><span>JSON data</span></div>
                            <button class="json-pane-close" @onclick="Vm.CloseStudioJsonViewer" aria-label="Close JSON viewer">×</button>
                        </header>
                        <pre>@Vm.StudioJsonViewerValue</pre>
                    </aside>
                }

                @if (Vm.GraphSidePaneGraph is not null)
                {
                    <aside class="graph-side-pane">
                        <header>
                            <div>
                                <strong>@Vm.GraphSidePaneTitle</strong>
                                <span>@Vm.GraphSidePaneGraph.Links.Count linked record@(Vm.GraphSidePaneGraph.Links.Count == 1 ? "" : "s")</span>
                            </div>
                            <button class="graph-pane-close" @onclick="Vm.CloseGraphPane" aria-label="Close linked records">×</button>
                        </header>
                        <div class="graph-side-pane-body">
                            <GraphCanvas Graph="Vm.GraphSidePaneGraph" Height="440" Searchable="true" AllowFullscreen="true" />
                        </div>
                    </aside>
                }
            }
        </section>
    </section>
</div>

@* ── New-table wizard ───────────────────────────────────────────────────────────────────── *@
@if (Vm.NewTable is not null)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseNewTable()"></div>
    <div class="dcslide slide-560">
        <div class="dcslide-head">
            <span class="slide-title-13">New table</span>
            <button class="dcslide-x" @onclick="() => Vm.CloseNewTable()">×</button>
        </div>
        <div class="slide-pad">
            <label class="field-label">Table name</label>
            <input @bind="Vm.NewTable.Name" @bind:event="oninput" placeholder="e.g. readings"
                   class="table-name-input" />

            <div class="columns-head">
                <span class="field-sub">Columns</span>
                <button class="dcbtn btn-add-col" @onclick="() => Vm.AddColumn()">+ column</button>
            </div>
            <div class="col-grid-head">
                <span>name</span><span>type</span><span class="center">not null</span><span class="center">PK</span><span></span>
            </div>
            @for (var i = 0; i < Vm.NewTable.Columns.Count; i++)
            {
                var col = Vm.NewTable.Columns[i];
                var idx = i;
                <div class="col-grid-row">
                    <input @bind="col.Name" @bind:event="oninput" placeholder="column"
                           class="col-input" />
                    <select @bind="col.Type" class="col-select">
                        @foreach (var t in ProjectDataViewModel.ColumnTypes) { <option value="@t">@t</option> }
                    </select>
                    <input type="checkbox" @bind="col.NotNull" class="center-self" />
                    <input type="checkbox" @bind="col.PrimaryKey" class="center-self" />
                    <button class="dclink link-bad" @onclick="@(() => Vm.NewTable.Columns.RemoveAt(idx))">✕</button>
                </div>
            }

            @if (Vm.NewTableError is not null)
            {
                <div class="error-mt8">@Vm.NewTableError</div>
            }
            <div class="slide-actions">
                <button class="dcbtn primary" disabled="@Vm.Creating" @onclick="async () => await Vm.CreateTableAsync()">@(Vm.Creating ? "Creating…" : "Create table")</button>
                <button class="dcbtn" @onclick="() => Vm.CloseNewTable()">Cancel</button>
            </div>
        </div>
    </div>
}

@* ── CSV import preview ─────────────────────────────────────────────────────────────────── *@
@if (Vm.CsvImport is not null)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseCsvImport()"></div>
    <div class="dcslide slide-680">
        <div class="dcslide-head">
            <div class="flex-min">
                <div class="slide-title-14">Import CSV</div>
                <div class="csv-meta">
                    @Vm.CsvImport.FileName · @Vm.CsvImport.DataRowCount row(s) · @Vm.CsvImport.Columns.Count column(s)
                </div>
            </div>
            <button class="dcslide-x" @onclick="() => Vm.CloseCsvImport()">×</button>
        </div>
        <div class="slide-pad-scroll">
            <div class="csv-name-row">
                <div class="flex-1">
                    <label class="field-label">New table name</label>
                    <input @bind="Vm.CsvImport.TableName" @bind:event="oninput" placeholder="e.g. contacts"
                           class="csv-name-input" />
                </div>
                <label class="header-check-label">
                    <input type="checkbox" checked="@Vm.CsvImport.HasHeader" @onchange="@(e => Vm.OnHeaderToggled(e.Value is bool value && value))" /> First row is a header
                </label>
            </div>

            <div class="field-sub-mb6">Columns &amp; types (inferred — adjust as needed)</div>
            <div class="csv-grid-head">
                <span>name</span><span>type</span>
            </div>
            @foreach (var col in Vm.CsvImport.Columns)
            {
                <div class="csv-grid-row">
                    <input @bind="col.Name" @bind:event="oninput"
                           class="col-input" />
                    <select @bind="col.Type" class="col-select">
                        @foreach (var t in ProjectDataViewModel.ColumnTypes) { <option value="@t">@t</option> }
                    </select>
                </div>
            }

            <div class="preview-label">Preview</div>
            <div class="preview-scroll">
                <table class="preview-table">
                    <thead>
                        <tr>
                            @foreach (var col in Vm.CsvImport.Columns)
                            {
                                <th class="preview-th">@col.Name</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Vm.CsvImport.PreviewRows())
                        {
                            <tr>
                                @for (var i = 0; i < Vm.CsvImport.Columns.Count; i++)
                                {
                                    var cell = i < r.Length ? r[i] : null;
                                    <td class="preview-td">@(string.IsNullOrEmpty(cell) ? "∅" : cell)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Vm.CsvError is not null)
            {
                <div class="error-mt10">@Vm.CsvError</div>
            }
        </div>
        <div class="dcslide-foot">
            <div class="foot-note">
                Creates a new table. Empty cells import as NULL; blank/leading-zero codes may need type <code>text</code>.
            </div>
            <button class="dcbtn" @onclick="() => Vm.CloseCsvImport()">Cancel</button>
            <button class="dcbtn primary" disabled="@Vm.Importing" @onclick="async () => await Vm.RunImportAsync()">
                @(Vm.Importing ? "Importing…" : $"Import {Vm.CsvImport.DataRowCount} rows")
            </button>
        </div>
    </div>
}

@* ── New-view wizard ────────────────────────────────────────────────────────────────────── *@
@if (Vm.ShowNewView)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseNewView()"></div>
    <div class="dcslide slide-560">
        <div class="dcslide-head">
            <span class="slide-title-13">New view</span>
            <button class="dcslide-x" @onclick="() => Vm.CloseNewView()">×</button>
        </div>
        <div class="slide-pad">
            <label class="field-label">View name</label>
            <input @bind="Vm.NewViewName" @bind:event="oninput" placeholder="e.g. active_listings"
                   class="table-name-input" />
            <label class="field-label">SELECT statement</label>
            @if (Vm.ViewMonaco)
            {
                <div id="@ProjectDataViewModel.ViewEditorId" class="monaco-box" style="height:220px"></div>
            }
            else
            {
                <textarea @bind="Vm.NewViewSql" rows="10" spellcheck="false"
                          placeholder="SELECT l.city, avg(l.price) FROM listings l JOIN suburbs s ON s.name = l.city GROUP BY 1"
                          class="view-textarea"></textarea>
            }
            <div class="dchint">One statement, starting with SELECT — writes and DDL are rejected, and the
                view runs as this project's isolated database role.</div>
        </div>
        <div class="dcslide-foot">
            @if (Vm.ViewError is not null)
            {
                <div class="view-error">@Vm.ViewError</div>
            }
            <button class="dcbtn" @onclick="() => Vm.CloseNewView()">Cancel</button>
            <button class="dcbtn primary" @onclick="Vm.SaveViewFromEditorAsync">Create view</button>
        </div>
    </div>
}

@* ── Save-query dialog ──────────────────────────────────────────────────────────────────── *@
@if (Vm.ShowSaveQueryDialog)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseSaveQueryDialog()"></div>
    <div class="dcslide slide-420">
        <div class="dcslide-head">
            <span class="slide-title-13">Save query</span>
            <button class="dcslide-x" @onclick="() => Vm.CloseSaveQueryDialog()">×</button>
        </div>
        <div class="slide-pad">
            <label class="field-label">Name</label>
            <input @bind="Vm.SaveQueryName" @bind:event="oninput" placeholder="e.g. recent readings"
                   class="table-name-input" />
            @if (Vm.SaveQueryError is not null)
            {
                <div class="view-error">@Vm.SaveQueryError</div>
            }
        </div>
        <div class="dcslide-foot">
            <button class="dcbtn" @onclick="() => Vm.CloseSaveQueryDialog()">Cancel</button>
            <button class="dcbtn primary" disabled="@Vm.SavingQuery" @onclick="Vm.SaveQueryFromEditorAsync">
                @(Vm.SavingQuery ? "Saving…" : "Save")
            </button>
        </div>
    </div>
}

@* ── Materialize-table dialog ───────────────────────────────────────────────────────────── *@
@if (Vm.ShowMaterializeDialog)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseMaterializeDialog()"></div>
    <div class="dcslide slide-420">
        <div class="dcslide-head">
            <span class="slide-title-13">Materialize to index</span>
            <button class="dcslide-x" @onclick="() => Vm.CloseMaterializeDialog()">×</button>
        </div>
        <div class="slide-pad">
            <div class="slide-sub">Copies <strong>@Vm.MaterializeTableName</strong> into an OpenSearch index so you can search and aggregate it with your other indices. Re-materializing replaces the existing index.</div>
            <label class="field-label">Index name</label>
            <input @bind="Vm.MaterializeIndexName" @bind:event="oninput" placeholder="e.g. pi-orders"
                   class="table-name-input" />
            @if (Vm.MaterializeError is not null)
            {
                <div class="view-error">@Vm.MaterializeError</div>
            }
        </div>
        <div class="dcslide-foot">
            <button class="dcbtn" @onclick="() => Vm.CloseMaterializeDialog()">Cancel</button>
            <button class="dcbtn primary" disabled="@Vm.Materializing" @onclick="@(() => Vm.MaterializeAsync())">
                @(Vm.Materializing ? "Materializing…" : "Materialize")
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));

    protected override async Task OnParametersSetAsync()
    {
        Vm.Initialize(ProjectId);
        await Vm.LoadAsync();
        Vm.PruneOpenTabs();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) =>
        await Vm.AfterStudioRenderAsync();

    public void Dispose() => Vm.Detach();
}
