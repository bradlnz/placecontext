@page "/project/{ProjectId:guid}/data"
@attribute [Authorize]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@using PlaceContext.Application.Features
@using PlaceContext.Application.Ports
@using PlaceContext.Host.Components.ViewModels
@using PlaceContext.Host.Components.ViewModels.Helpers
@using Microsoft.AspNetCore.Components.Forms
@inject ProjectDataViewModel Vm
@inject PortalUiState Ui
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>PlaceContext — Data</PageTitle>

<div class="page">

    <div class="head-row">
        <h2 class="head-title">Data</h2>
        <span class="head-sub">this project's own database — create tables, store data, query it with SQL</span>
    </div>
    @if (Vm.MonacoLite)
    {
        <div class="monaco-lite-note">basic editor (Monaco CDN unreachable) — SQL still runs.</div>
    }

    <div class="cols">

        @* ── Tables ─────────────────────────────────────────────────────────────────────── *@
        <div class="tables-col">
            <div class="tables-head">
                <span class="col-label">Tables</span>
                <button class="dcbtn btn-refresh" @onclick="() => Vm.RefreshTablesAsync()" title="Refresh">↻</button>
            </div>
            <div class="new-btns">
                <button class="dcbtn primary new-btn" @onclick="() => Vm.StartNewTable()">+ Table</button>
                <button class="dcbtn new-btn" @onclick="() => Vm.OpenNewView()">+ View</button>
            </div>
            <InputFile OnChange="OnCsvSelected" accept=".csv,text/csv" id="pccsv-input" style="display:none" />
            <label for="pccsv-input" class="dcbtn import-csv-label"
                   title="Create a table from a CSV file">⬆ Import CSV</label>
            @if (Vm.CsvError is not null && Vm.CsvImport is null)
            {
                <div class="csv-error">@Vm.CsvError</div>
            }
            <div class="tables-list">
            @if (!Vm.TablesReady)
            {
                <Skeleton Kind="tile-grid" Cards="8" />
            }
            else if (Vm.Tables.Count == 0)
            {
                <div class="empty-tables">
                    No tables yet — click <b>New table</b> or run a <code>CREATE TABLE …</code>.
                </div>
            }
            <div class="tables-grid">
            @foreach (var t in Vm.Tables)
            {
                <div class="table-tile">
                    <button class="tile-main" @onclick="@(() => OpenTableModal(t.Name))" title="Open query view for @t.Name">
                        <div class="tile-icon">
                            @if (t.IsView)
                            {
                                <span title="View">V</span>
                            }
                            else if (t.ReadOnly)
                            {
                                <span title="Read-only system table">R</span>
                            }
                            else
                            {
                                <span title="Table">T</span>
                            }
                        </div>
                        <div class="tile-info">
                            <span class="tile-name">@t.Name</span>
                            <span class="tile-meta">
                                @if (t.IsView)
                                {
                                    <span class="tag-view">view</span>
                                }
                                else if (t.ReadOnly)
                                {
                                    <span class="tag-readonly">read-only</span>
                                }
                                <span class="tile-rows">@(t.IsView ? "" : $"~{t.RowEstimate:N0} rows")</span>
                            </span>
                        </div>
                    </button>
                    <div class="tile-actions">
                        @if (!t.ReadOnly && !t.IsView)
                        {
                            <button class="tile-btn" @onclick="@(() => Vm.StartEditAsync(t.Name))" title="Edit schema">edit</button>
                            <button class="tile-btn" @onclick="@(() => Vm.StartRename(t.Name))" title="Rename">rename</button>
                        }
                        <button class="tile-btn" @onclick="@(() => ExportAsync(t.Name))" title="Export CSV">export</button>
                        @if (t.IsView)
                        {
                            <button class="tile-btn tile-btn-bad" @onclick="@(() => Vm.DropViewAsync(t.Name))" title="Drop view">drop</button>
                        }
                        else if (!t.ReadOnly)
                        {
                            <button class="tile-btn tile-btn-bad" @onclick="@(() => Vm.StartDrop(t.Name))" title="Drop table">drop</button>
                        }
                    </div>
                    @if (Vm.Renaming == t.Name)
                    {
                        <div class="rename-row">
                            <input @bind="Vm.RenameTo" @bind:event="oninput" placeholder="new name" class="rename-input" />
                            <button class="dcbtn btn-sm" @onclick="() => Vm.ConfirmRenameAsync()">✓</button>
                            <button class="dcbtn btn-sm" @onclick="() => Vm.CancelRename()">✕</button>
                        </div>
                    }
                    @if (Vm.Dropping == t.Name)
                    {
                        <div class="drop-row">
                            drop @t.Name?
                            <button class="dcbtn btn-sm" @onclick="() => Vm.ConfirmDropAsync()">yes</button>
                            <button class="dcbtn btn-sm" @onclick="() => Vm.CancelDrop()">no</button>
                        </div>
                    }
                </div>
            }
            </div>
            </div>
        </div>

        @* ── Query + results ────────────────────────────────────────────────────────────── *@
        <div class="flex-min">
            <div id="@ProjectDataViewModel.EditorId" class="sql-editor"></div>
            <div class="run-bar">
                <button class="dcbtn primary" disabled="@Vm.Running" @onclick="RunAsync">@(Vm.Running ? "Running…" : "▶ Run (SQL)")</button>
                @if (Vm.Result is { Columns.Count: > 0, Rows.Count: > 0 })
                {
                    <a class="dcbtn export-link" href="@Vm.ResultCsvUri()" download="query-result.csv">⬇ Export CSV</a>
                }
                @if (Vm.Error is not null)
                {
                    <span class="msg-bad">@Vm.Error</span>
                }
                else if (Vm.Result is not null && Vm.Result.Columns.Count == 0)
                {
                    <span class="msg-good">OK — @Vm.Result.AffectedRows row(s) affected.</span>
                }
                else if (Vm.Result is not null)
                {
                    <span class="msg-muted">
                        @Vm.Result.Rows.Count row(s)@(Vm.Result.Truncated ? " (truncated at 500)" : "")@(Vm.Result.AffectedRows > 0 ? $" · {Vm.Result.AffectedRows} affected" : "")
                    </span>
                }
            </div>

            @if (Vm.ImportWarnings.Count > 0)
            {
                <div class="msg-warn">
                    <strong>@Vm.ImportWarnings.Count possible duplicate(s)</strong> — first: @Vm.ImportWarnings[0]
                    <button class="dclink" style="margin-left:8px" @onclick="() => Vm.DismissImportWarnings()">dismiss</button>
                </div>
            }

            @if (Vm.Result is { Columns.Count: > 0 })
            {
                <div class="result-scroll">
                    <table class="result-table">
                        <thead>
                            <tr>
                                @foreach (var c in Vm.Result.Columns)
                                {
                                    <th class="result-th">@c</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Vm.Result.Rows)
                            {
                                <tr>
                                    @foreach (var cell in row)
                                    {
                                        <td class="result-td" style="color:@(cell is null ? "var(--text-3)" : "var(--text-2)")">
                                            @(cell ?? "∅")
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@* ── Full-screen table query modal (Supabase / Log Analytics style) ─────────────────────── *@
@if (Vm.ShowTableModal)
{
    <div class="table-modal-overlay" @onclick="CloseTableModal">
        <div class="table-modal" @onclick:stopPropagation>
            <div class="table-modal-head">
                <div class="table-modal-title">
                    <span class="modal-table-name">@Vm.ModalTableName</span>
                    <span class="modal-hint">query editor</span>
                </div>
                <div class="table-modal-actions">
                    <button class="dcbtn primary" disabled="@Vm.ModalRunning" @onclick="RunModalAsync">@(Vm.ModalRunning ? "Running…" : "▶ Run")</button>
                    @if (Vm.ModalResult is { Columns.Count: > 0, Rows.Count: > 0 })
                    {
                        <a class="dcbtn export-link" href="@Vm.ModalResultCsvUri()" download="@($"{Vm.ModalTableName}.csv")">⬇ Export CSV</a>
                    }
                    <button class="dcbtn" @onclick="CloseTableModal">Close</button>
                </div>
            </div>

            <div class="table-modal-body">
                <div id="@ProjectDataViewModel.TableModalEditorId" class="table-modal-editor"></div>
            </div>

            <div class="table-modal-status">
                @if (Vm.ModalError is not null)
                {
                    <span class="modal-status-bad">@Vm.ModalError</span>
                }
                else if (Vm.ModalResult is not null && Vm.ModalResult.Columns.Count == 0)
                {
                    <span class="modal-status-good">OK — @Vm.ModalResult.AffectedRows row(s) affected.</span>
                }
                else if (Vm.ModalResult is not null)
                {
                    <span class="modal-status-muted">
                        @Vm.ModalResult.Rows.Count row(s)@(Vm.ModalResult.Truncated ? " (truncated at 500)" : "")@(Vm.ModalResult.AffectedRows > 0 ? $" · {Vm.ModalResult.AffectedRows} affected" : "")
                    </span>
                }
                else
                {
                    <span class="modal-status-muted">Run a query to see results</span>
                }
            </div>

            @if (Vm.ModalResult is { Columns.Count: > 0 })
            {
                <div class="table-modal-results">
                    <table class="result-table modal-result-table">
                        <thead>
                            <tr>
                                @foreach (var c in Vm.ModalResult.Columns)
                                {
                                    <th class="result-th">@c</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Vm.ModalResult.Rows)
                            {
                                <tr>
                                    @foreach (var cell in row)
                                    {
                                        <td class="result-td" style="color:@(cell is null ? "var(--text-3)" : "var(--text-2)")">
                                            @(cell ?? "∅")
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@* ── New-table wizard ───────────────────────────────────────────────────────────────────── *@
@if (Vm.NewTable is not null)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseNewTable()"></div>
    <div class="dcslide slide-560">
        <div class="dcslide-head">
            <span class="slide-title-13">New table</span>
            <button class="dcslide-x" @onclick="() => Vm.CloseNewTable()">×</button>
        </div>
        <div class="slide-pad">
            <label class="field-label">Table name</label>
            <input @bind="Vm.NewTable.Name" @bind:event="oninput" placeholder="e.g. readings"
                   class="table-name-input" />

            <div class="columns-head">
                <span class="field-sub">Columns</span>
                <button class="dcbtn btn-add-col" @onclick="() => Vm.AddColumn()">+ column</button>
            </div>
            <div class="col-grid-head">
                <span>name</span><span>type</span><span class="center">not null</span><span class="center">PK</span><span></span>
            </div>
            @for (var i = 0; i < Vm.NewTable.Columns.Count; i++)
            {
                var col = Vm.NewTable.Columns[i];
                var idx = i;
                <div class="col-grid-row">
                    <input @bind="col.Name" @bind:event="oninput" placeholder="column"
                           class="col-input" />
                    <select @bind="col.Type" class="col-select">
                        @foreach (var t in ProjectDataViewModel.ColumnTypes) { <option value="@t">@t</option> }
                    </select>
                    <input type="checkbox" @bind="col.NotNull" class="center-self" />
                    <input type="checkbox" @bind="col.PrimaryKey" class="center-self" />
                    <button class="dclink link-bad" @onclick="@(() => Vm.NewTable.Columns.RemoveAt(idx))">✕</button>
                </div>
            }

            @if (Vm.NewTableError is not null)
            {
                <div class="error-mt8">@Vm.NewTableError</div>
            }
            <div class="slide-actions">
                <button class="dcbtn primary" disabled="@Vm.Creating" @onclick="() => Vm.CreateTableAsync()">@(Vm.Creating ? "Creating…" : "Create table")</button>
                <button class="dcbtn" @onclick="() => Vm.CloseNewTable()">Cancel</button>
            </div>
        </div>
    </div>
}

@* ── CSV import preview ─────────────────────────────────────────────────────────────────── *@
@if (Vm.CsvImport is not null)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseCsvImport()"></div>
    <div class="dcslide slide-680">
        <div class="dcslide-head">
            <div class="flex-min">
                <div class="slide-title-14">Import CSV</div>
                <div class="csv-meta">
                    @Vm.CsvImport.FileName · @Vm.CsvImport.DataRowCount row(s) · @Vm.CsvImport.Columns.Count column(s)
                </div>
            </div>
            <button class="dcslide-x" @onclick="() => Vm.CloseCsvImport()">×</button>
        </div>
        <div class="slide-pad-scroll">
            <div class="csv-name-row">
                <div class="flex-1">
                    <label class="field-label">New table name</label>
                    <input @bind="Vm.CsvImport.TableName" @bind:event="oninput" placeholder="e.g. contacts"
                           class="csv-name-input" />
                </div>
                <label class="header-check-label">
                    <input type="checkbox" checked="@Vm.CsvImport.HasHeader" @onchange="OnHeaderToggled" /> First row is a header
                </label>
            </div>

            <div class="field-sub-mb6">Columns &amp; types (inferred — adjust as needed)</div>
            <div class="csv-grid-head">
                <span>name</span><span>type</span>
            </div>
            @foreach (var col in Vm.CsvImport.Columns)
            {
                <div class="csv-grid-row">
                    <input @bind="col.Name" @bind:event="oninput"
                           class="col-input" />
                    <select @bind="col.Type" class="col-select">
                        @foreach (var t in ProjectDataViewModel.ColumnTypes) { <option value="@t">@t</option> }
                    </select>
                </div>
            }

            <div class="preview-label">Preview</div>
            <div class="preview-scroll">
                <table class="preview-table">
                    <thead>
                        <tr>
                            @foreach (var col in Vm.CsvImport.Columns)
                            {
                                <th class="preview-th">@col.Name</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Vm.CsvImport.PreviewRows())
                        {
                            <tr>
                                @for (var i = 0; i < Vm.CsvImport.Columns.Count; i++)
                                {
                                    var cell = i < r.Length ? r[i] : null;
                                    <td class="preview-td">@(string.IsNullOrEmpty(cell) ? "∅" : cell)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Vm.CsvError is not null)
            {
                <div class="error-mt10">@Vm.CsvError</div>
            }
        </div>
        <div class="dcslide-foot">
            <div class="foot-note">
                Creates a new table. Empty cells import as NULL; blank/leading-zero codes may need type <code>text</code>.
            </div>
            <button class="dcbtn" @onclick="() => Vm.CloseCsvImport()">Cancel</button>
            <button class="dcbtn primary" disabled="@Vm.Importing" @onclick="() => Vm.RunImportAsync()">
                @(Vm.Importing ? "Importing…" : $"Import {Vm.CsvImport.DataRowCount} rows")
            </button>
        </div>
    </div>
}

@* ── New-view wizard ────────────────────────────────────────────────────────────────────── *@
@if (Vm.ShowNewView)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseNewView()"></div>
    <div class="dcslide slide-560">
        <div class="dcslide-head">
            <span class="slide-title-13">New view</span>
            <button class="dcslide-x" @onclick="() => Vm.CloseNewView()">×</button>
        </div>
        <div class="slide-pad">
            <label class="field-label">View name</label>
            <input @bind="Vm.NewViewName" @bind:event="oninput" placeholder="e.g. active_listings"
                   class="table-name-input" />
            <label class="field-label">SELECT statement</label>
            @if (Vm.ViewMonaco)
            {
                <div id="@ProjectDataViewModel.ViewEditorId" class="monaco-box" style="height:220px"></div>
            }
            else
            {
                <textarea @bind="Vm.NewViewSql" rows="10" spellcheck="false"
                          placeholder="SELECT l.city, avg(l.price) FROM listings l JOIN suburbs s ON s.name = l.city GROUP BY 1"
                          class="view-textarea"></textarea>
            }
            <div class="dchint">One statement, starting with SELECT — writes and DDL are rejected, and the
                view runs as this project's isolated database role.</div>
        </div>
        <div class="dcslide-foot">
            @if (Vm.ViewError is not null)
            {
                <div class="view-error">@Vm.ViewError</div>
            }
            <button class="dcbtn" @onclick="() => Vm.CloseNewView()">Cancel</button>
            <button class="dcbtn primary" @onclick="SaveViewAsync">Create view</button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        Ui.Set("Data", "the project's own database");
        Vm.Initialize(ProjectId);
        await Vm.LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Vm.ShowNewView && Vm.ViewMonaco && !Vm.ViewMonacoReady)
        {
            Vm.ViewMonacoReady = true;
            try
            {
                var richView = await JS.InvokeAsync<bool>("pcmonaco.init", ProjectDataViewModel.ViewEditorId, Vm.NewViewSql, "sql", "vs-dark");
                if (!richView) { Vm.ViewMonaco = false; StateHasChanged(); }
            }
            catch { Vm.ViewMonaco = false; StateHasChanged(); }
        }

        if (Vm.ShowTableModal && !Vm.ModalEditorReady)
        {
            Vm.ModalEditorReady = true;
            try
            {
                var richModal = await JS.InvokeAsync<bool>("pcmonaco.init", ProjectDataViewModel.TableModalEditorId, Vm.ModalSql, "sql", "vs-dark");
                if (!richModal) { Vm.CloseTableModal(); StateHasChanged(); }
            }
            catch { Vm.CloseTableModal(); StateHasChanged(); }
        }

        if (Vm.MonacoReady) return;
        Vm.MonacoReady = true;
        try
        {
            var rich = await JS.InvokeAsync<bool>("pcmonaco.init", ProjectDataViewModel.EditorId, ProjectDataViewModel.StarterSql, "sql", "vs-dark");
            if (!rich) { Vm.MonacoLite = true; StateHasChanged(); }
        }
        catch { Vm.MonacoLite = true; StateHasChanged(); }
    }

    private async Task RunAsync()
        => await Vm.RunAsync(async () => await JS.InvokeAsync<string>("pcmonaco.getValue", ProjectDataViewModel.EditorId));

    private async Task RunModalAsync()
        => await Vm.RunModalAsync(async () => await JS.InvokeAsync<string>("pcmonaco.getValue", ProjectDataViewModel.TableModalEditorId));

    private void OpenTableModal(string table) => Vm.OpenTableModal(table);

    private void CloseTableModal() => Vm.CloseTableModal();

    private async Task SaveViewAsync()
        => await Vm.SaveViewAsync(async (id) => await JS.InvokeAsync<string>("pcmonaco.getValue", id));

    private async Task ExportAsync(string table)
        => await Vm.ExportAsync(table, async (name, uri) => await JS.InvokeVoidAsync("pcdata.download", name, uri));

    private async Task OnCsvSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        try
        {
            using var reader = new StreamReader(file.OpenReadStream(ProjectDataViewModel.MaxCsvBytes));
            var text = await reader.ReadToEndAsync();
            var records = ProjectDataViewModel.ParseCsvRecords(text).Where(r => r.Any(f => !string.IsNullOrEmpty(f))).ToList();
            if (records.Count == 0) { Vm.SetCsvImport(new ProjectDataViewModel.CsvImportDraft { FileName = file.Name }); return; }

            var draft = new ProjectDataViewModel.CsvImportDraft
            {
                FileName = file.Name,
                HasHeader = true,
                Records = records,
                TableName = ProjectDataViewModel.SanitizeIdent(System.IO.Path.GetFileNameWithoutExtension(file.Name), 0),
            };
            ProjectDataViewModel.BuildColumns(draft);
            Vm.SetCsvImport(draft);
        }
        catch { Vm.SetCsvImport(new ProjectDataViewModel.CsvImportDraft { FileName = file.Name }); /* CsvError set by VM */ }
    }

    private void OnHeaderToggled(ChangeEventArgs e)
    {
        var b = e.Value is bool bv ? bv : bool.TryParse(e.Value?.ToString(), out var pb) && pb;
        Vm.OnHeaderToggled(b);
    }
}
