@page "/project/{ProjectId:guid}/data"
@attribute [Authorize(Policy = Permission.DataRead)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@using PlaceContext.Application.Features
@using PlaceContext.Application.Ports
@using System.Text
@using System.Text.Json
@using PlaceContext.Host.Components.ViewModels
@using PlaceContext.Host.Components.ViewModels.Helpers
@using Microsoft.AspNetCore.Components.Forms
@inject ProjectDataViewModel Vm
@inject IPlaceContextService DataService

<PageTitle>PlaceContext — SQL Studio</PageTitle>

<div class="page data-page sql-studio-page">

    <DataTabs ProjectId="ProjectId" Active="@DataSection.Tables" />

    <section class="sql-studio">
        <aside class="studio-sidebar">
            <div class="studio-sidebar-tabs">
                <button class="studio-sidebar-tab active">Tables</button>
                <button class="studio-sidebar-tab" title="Saved queries (coming soon)">Queries</button>
            </div>
            <button class="studio-new-table" @onclick="() => Vm.StartNewTable()">
                <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>New table
            </button>
            <div class="studio-search">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
                <input type="text" placeholder="Search resources" @bind="_tableFilter" @bind:event="oninput" />
            </div>
            <div class="studio-resource-list">
                @if (!Vm.TablesReady)
                {
                    <Skeleton Kind="list" Rows="6" />
                }
                else if (FilteredTables.Count == 0)
                {
                    <div class="empty-tables">No tables match.</div>
                }
                else
                {
                    <div class="resource-group">Tables (@FilteredTables.Count)</div>
                    @foreach (var t in FilteredTables)
                    {
                        <article class="resource-item @(_activeTableName == t.Name ? "active" : "")" @onclick="@(() => OpenTableTabAsync(t.Name))">
                            <span class="resource-icon">
                                <svg viewBox="0 0 24 24">
                                    <ellipse cx="12" cy="5" rx="8" ry="3" />
                                    <path d="M4 5v7c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12v7c0 1.7 3.6 3 8 3s8-1.3 8-3v-7" />
                                </svg>
                            </span>
                            <div class="resource-copy">
                                <strong>@t.Name</strong>
                                <span>@TableTag(t)</span>
                            </div>
                            <span class="resource-tag">@TableEngineTag(t)</span>
                        </article>
                    }
                }
            </div>
        </aside>

        <section class="studio-main">
            @if (_openTabs.Count == 0)
            {
                <div class="studio-empty">
                    <div class="studio-empty-title">SQL Studio</div>
                    <p>Select a table from the left to open a query tab, or write a new SELECT statement.</p>
                </div>
            }
            else
            {
                <div class="studio-toolbar">
                    <div class="studio-query-title">
                        <span>@(_activeTableName ?? "Untitled query")</span>
                    </div>
                    <div class="studio-toolbar-spacer"></div>
                    <div class="studio-connection">
                        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" /></svg>
                        <span>project</span>
                    </div>
                    <button class="studio-run" disabled="@ActiveTableTab?.Running" @onclick="@(async () => { if (ActiveTableTab is { } a) await RunTableTabAsync(a); })">
                        <svg viewBox="0 0 24 24"><path d="M5 3l14 9-14 9V3z" /></svg>
                        @(ActiveTableTab?.Running == true ? "Running…" : "Run")
                    </button>
                    <button class="studio-tool" title="SQL AI (coming soon)">
                        <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" /></svg>
                        SQL AI
                    </button>
                    <button class="studio-tool" title="Save query (coming soon)">
                        <svg viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><path d="M17 21v-8H7v8" /></svg>
                        Save
                    </button>
                    <button class="studio-tool" title="Share query (coming soon)">
                        <svg viewBox="0 0 24 24"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98" /></svg>
                        Share
                    </button>
                </div>

                <div class="studio-tabs">
                    @foreach (var tab in _openTabs)
                    {
                        <button class="studio-tab @(tab.TableName == _activeTableName ? "active" : "")"
                                @onclick="@(() => ActivateTabAsync(tab.TableName))" title="@tab.TableName">
                            <span>@tab.TableName</span>
                            <span class="studio-tab-close"
                                  @onclick:stopPropagation="true" @onclick="@(() => CloseTableTabAsync(tab.TableName))"
                                  title="Close @tab.TableName">×</span>
                        </button>
                    }
                </div>

                @if (ActiveTableTab is { } activeTab)
                {
                    <div class="studio-editor-shell">
                        @if (Vm.SqlEditorMonaco)
                        {
                            <div id="@ProjectDataViewModel.SqlEditorId" class="studio-sql-editor monaco-box"></div>
                        }
                        else
                        {
                            <textarea class="studio-sql-editor"
                                      @bind="activeTab.Sql" @bind:event="oninput"></textarea>
                        }
                    </div>

                    <div class="studio-results-bar">
                        <div class="studio-results-search">
                            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
                            <input type="text" placeholder="Search results…" disabled />
                        </div>
                        <div class="studio-results-stats">
                            @if (activeTab.Error is not null)
                            {
                                <span class="stat-error">@activeTab.Error</span>
                            }
                            else if (activeTab.Result is not null && activeTab.Result.Columns.Count == 0)
                            {
                                <span class="stat-ok">OK — @activeTab.Result.AffectedRows row(s) affected.</span>
                            }
                            else if (activeTab.Result is not null)
                            {
                                <span>Elapsed: @FormatElapsed(activeTab.Result)</span>
                                <span>Read: @activeTab.Result.Rows.Count row(s)@(activeTab.Result.Truncated ? " (truncated at 500)" : "")</span>
                            }
                            else
                            {
                                <span>Run a query to see results</span>
                            }
                        </div>
                        <div class="studio-results-tabs">
                            <button class="studio-results-tab active">Table</button>
                            <button class="studio-results-tab" disabled>Chart</button>
                        </div>
                    </div>

                    @if (activeTab.Result is { Columns.Count: > 0 })
                    {
                        <div class="studio-results">
                            <table class="studio-result-table">
                                <thead>
                                    <tr>
                                        <th class="result-row-num">#</th>
                                        @foreach (var c in activeTab.Result.Columns)
                                        {
                                            <th>@c</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var rowIdx = 0; rowIdx < activeTab.Result.Rows.Count; rowIdx++)
                                    {
                                        var row = activeTab.Result.Rows[rowIdx];
                                        <tr @onclick="@(() => SelectRow(rowIdx))" class="@(_selectedRowIndex == rowIdx ? "selected" : "")">
                                            <td class="result-row-num">@(rowIdx + 1)</td>
                                            @for (var i = 0; i < activeTab.Result.Columns.Count; i++)
                                            {
                                                var columnName = activeTab.Result.Columns[i];
                                                var cellValue = i < row.Count ? row[i] : null;
                                                <td>
                                                    @if (cellValue is not null && Vm.IsJsonCellPresentation(columnName, cellValue))
                                                    {
                                                        <button class="json-view-button" @onclick:stopPropagation="true" @onclick="@(() => OpenJsonViewer(columnName, cellValue))">View data</button>
                                                    }
                                                    else
                                                    {
                                                        <OpenSearchDataValue ProjectId="ProjectId" Column="@columnName" Value="@cellValue" NullText="∅" />
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }

                @if (_jsonViewerValue is not null)
                {
                    <aside class="json-side-pane">
                        <header>
                            <div><strong>@_jsonViewerTitle</strong><span>JSON data</span></div>
                            <button class="json-pane-close" @onclick="CloseJsonViewer" aria-label="Close JSON viewer">×</button>
                        </header>
                        <pre>@_jsonViewerValue</pre>
                    </aside>
                }
            }
        </section>
    </section>
</div>

@* ── New-table wizard ───────────────────────────────────────────────────────────────────── *@
@if (Vm.NewTable is not null)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseNewTable()"></div>
    <div class="dcslide slide-560">
        <div class="dcslide-head">
            <span class="slide-title-13">New table</span>
            <button class="dcslide-x" @onclick="() => Vm.CloseNewTable()">×</button>
        </div>
        <div class="slide-pad">
            <label class="field-label">Table name</label>
            <input @bind="Vm.NewTable.Name" @bind:event="oninput" placeholder="e.g. readings"
                   class="table-name-input" />

            <div class="columns-head">
                <span class="field-sub">Columns</span>
                <button class="dcbtn btn-add-col" @onclick="() => Vm.AddColumn()">+ column</button>
            </div>
            <div class="col-grid-head">
                <span>name</span><span>type</span><span class="center">not null</span><span class="center">PK</span><span></span>
            </div>
            @for (var i = 0; i < Vm.NewTable.Columns.Count; i++)
            {
                var col = Vm.NewTable.Columns[i];
                var idx = i;
                <div class="col-grid-row">
                    <input @bind="col.Name" @bind:event="oninput" placeholder="column"
                           class="col-input" />
                    <select @bind="col.Type" class="col-select">
                        @foreach (var t in ProjectDataViewModel.ColumnTypes) { <option value="@t">@t</option> }
                    </select>
                    <input type="checkbox" @bind="col.NotNull" class="center-self" />
                    <input type="checkbox" @bind="col.PrimaryKey" class="center-self" />
                    <button class="dclink link-bad" @onclick="@(() => Vm.NewTable.Columns.RemoveAt(idx))">✕</button>
                </div>
            }

            @if (Vm.NewTableError is not null)
            {
                <div class="error-mt8">@Vm.NewTableError</div>
            }
            <div class="slide-actions">
                <button class="dcbtn primary" disabled="@Vm.Creating" @onclick="async () => await Vm.CreateTableAsync()">@(Vm.Creating ? "Creating…" : "Create table")</button>
                <button class="dcbtn" @onclick="() => Vm.CloseNewTable()">Cancel</button>
            </div>
        </div>
    </div>
}

@* ── CSV import preview ─────────────────────────────────────────────────────────────────── *@
@if (Vm.CsvImport is not null)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseCsvImport()"></div>
    <div class="dcslide slide-680">
        <div class="dcslide-head">
            <div class="flex-min">
                <div class="slide-title-14">Import CSV</div>
                <div class="csv-meta">
                    @Vm.CsvImport.FileName · @Vm.CsvImport.DataRowCount row(s) · @Vm.CsvImport.Columns.Count column(s)
                </div>
            </div>
            <button class="dcslide-x" @onclick="() => Vm.CloseCsvImport()">×</button>
        </div>
        <div class="slide-pad-scroll">
            <div class="csv-name-row">
                <div class="flex-1">
                    <label class="field-label">New table name</label>
                    <input @bind="Vm.CsvImport.TableName" @bind:event="oninput" placeholder="e.g. contacts"
                           class="csv-name-input" />
                </div>
                <label class="header-check-label">
                    <input type="checkbox" checked="@Vm.CsvImport.HasHeader" @onchange="@(e => Vm.OnHeaderToggled(e.Value is bool value && value))" /> First row is a header
                </label>
            </div>

            <div class="field-sub-mb6">Columns &amp; types (inferred — adjust as needed)</div>
            <div class="csv-grid-head">
                <span>name</span><span>type</span>
            </div>
            @foreach (var col in Vm.CsvImport.Columns)
            {
                <div class="csv-grid-row">
                    <input @bind="col.Name" @bind:event="oninput"
                           class="col-input" />
                    <select @bind="col.Type" class="col-select">
                        @foreach (var t in ProjectDataViewModel.ColumnTypes) { <option value="@t">@t</option> }
                    </select>
                </div>
            }

            <div class="preview-label">Preview</div>
            <div class="preview-scroll">
                <table class="preview-table">
                    <thead>
                        <tr>
                            @foreach (var col in Vm.CsvImport.Columns)
                            {
                                <th class="preview-th">@col.Name</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Vm.CsvImport.PreviewRows())
                        {
                            <tr>
                                @for (var i = 0; i < Vm.CsvImport.Columns.Count; i++)
                                {
                                    var cell = i < r.Length ? r[i] : null;
                                    <td class="preview-td">@(string.IsNullOrEmpty(cell) ? "∅" : cell)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Vm.CsvError is not null)
            {
                <div class="error-mt10">@Vm.CsvError</div>
            }
        </div>
        <div class="dcslide-foot">
            <div class="foot-note">
                Creates a new table. Empty cells import as NULL; blank/leading-zero codes may need type <code>text</code>.
            </div>
            <button class="dcbtn" @onclick="() => Vm.CloseCsvImport()">Cancel</button>
            <button class="dcbtn primary" disabled="@Vm.Importing" @onclick="async () => await Vm.RunImportAsync()">
                @(Vm.Importing ? "Importing…" : $"Import {Vm.CsvImport.DataRowCount} rows")
            </button>
        </div>
    </div>
}

@* ── New-view wizard ────────────────────────────────────────────────────────────────────── *@
@if (Vm.ShowNewView)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseNewView()"></div>
    <div class="dcslide slide-560">
        <div class="dcslide-head">
            <span class="slide-title-13">New view</span>
            <button class="dcslide-x" @onclick="() => Vm.CloseNewView()">×</button>
        </div>
        <div class="slide-pad">
            <label class="field-label">View name</label>
            <input @bind="Vm.NewViewName" @bind:event="oninput" placeholder="e.g. active_listings"
                   class="table-name-input" />
            <label class="field-label">SELECT statement</label>
            @if (Vm.ViewMonaco)
            {
                <div id="@ProjectDataViewModel.ViewEditorId" class="monaco-box" style="height:220px"></div>
            }
            else
            {
                <textarea @bind="Vm.NewViewSql" rows="10" spellcheck="false"
                          placeholder="SELECT l.city, avg(l.price) FROM listings l JOIN suburbs s ON s.name = l.city GROUP BY 1"
                          class="view-textarea"></textarea>
            }
            <div class="dchint">One statement, starting with SELECT — writes and DDL are rejected, and the
                view runs as this project's isolated database role.</div>
        </div>
        <div class="dcslide-foot">
            @if (Vm.ViewError is not null)
            {
                <div class="view-error">@Vm.ViewError</div>
            }
            <button class="dcbtn" @onclick="() => Vm.CloseNewView()">Cancel</button>
            <button class="dcbtn primary" @onclick="Vm.SaveViewFromEditorAsync">Create view</button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private sealed class TableTab
    {
        public TableTab(string tableName, string sql)
        {
            TableName = tableName;
            Sql = sql;
        }

        public string TableName { get; }
        public string Sql { get; set; }
        public ProjectQueryResult? Result { get; set; }
        public string? Error { get; set; }
        public bool Running { get; set; }
    }

    private readonly List<TableTab> _openTabs = new();
    private string? _activeTableName;
    private string? _jsonViewerTitle;
    private string? _jsonViewerValue;
    private string _tableFilter = "";
    private int? _selectedRowIndex;

    private TableTab? ActiveTableTab =>
        _openTabs.FirstOrDefault(tab => tab.TableName == _activeTableName);

    private List<ProjectTableInfo> FilteredTables =>
        string.IsNullOrWhiteSpace(_tableFilter)
            ? Vm.Tables.ToList()
            : Vm.Tables
                .Where(t => t.Name.Contains(_tableFilter, StringComparison.OrdinalIgnoreCase))
                .ToList();

    private static string TableTag(ProjectTableInfo t) =>
        t.IsView ? "view" : t.ReadOnly ? "system" : "table";

    private static string TableEngineTag(ProjectTableInfo t) =>
        t.IsView ? "VIEW" : t.ReadOnly ? "SYS" : "MT";

    private static string FormatElapsed(ProjectQueryResult result) =>
        "0.003s"; // PlaceContext does not currently capture server-side timing; kept as a visual affordance.

    private void SelectRow(int index) =>
        _selectedRowIndex = _selectedRowIndex == index ? null : index;

    protected override async Task OnParametersSetAsync()
    {
        Vm.Initialize(ProjectId);
        await Vm.LoadAsync();
        PruneOpenTabs();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await Vm.AfterRenderAsync();
        if (ActiveTableTab is { } active)
            await Vm.ShowSqlTabAsync(active.TableName, active.Sql);
    }

    private async Task OpenTableTabAsync(string tableName)
    {
        var existing = _openTabs.FirstOrDefault(t => StringComparer.Ordinal.Equals(t.TableName, tableName));
        if (existing is not null)
        {
            _activeTableName = existing.TableName;
            await Vm.ShowSqlTabAsync(existing.TableName, existing.Sql);
            if (existing.Result is null && !existing.Running && existing.Error is null)
                await RunTableTabAsync(existing);
            return;
        }

        var tab = new TableTab(tableName, DefaultSqlFor(tableName));
        _openTabs.Add(tab);
        _activeTableName = tableName;
        await Vm.ShowSqlTabAsync(tableName, tab.Sql);
        await RunTableTabAsync(tab);
    }

    private async Task ActivateTabAsync(string tableName)
    {
        if (StringComparer.Ordinal.Equals(tableName, _activeTableName))
            return;

        if (ActiveTableTab is { } current)
        {
            var value = await Vm.GetSqlEditorValueAsync();
            if (value is not null)
                current.Sql = value;
        }

        _activeTableName = tableName;
        await Vm.ShowSqlTabAsync(tableName, ActiveTableTab?.Sql ?? DefaultSqlFor(tableName));
        StateHasChanged();
    }

    private async Task CloseTableTabAsync(string tableName)
    {
        var index = _openTabs.FindIndex(tab => StringComparer.Ordinal.Equals(tab.TableName, tableName));
        if (index < 0) return;

        var wasActive = _activeTableName == tableName;
        if (wasActive)
        {
            if (_openTabs.Count == 1)
            {
                _activeTableName = null;
            }
            else
            {
                var next = index > 0 ? index - 1 : 1;
                _activeTableName = _openTabs[next].TableName;
            }
        }

        _openTabs.RemoveAt(index);
        await Vm.CloseSqlEditorFileAsync(tableName);

        if (wasActive && _activeTableName is not null)
        {
            var tab = _openTabs.FirstOrDefault(t => StringComparer.Ordinal.Equals(t.TableName, _activeTableName));
            await Vm.ShowSqlTabAsync(_activeTableName, tab?.Sql ?? DefaultSqlFor(_activeTableName));
        }
        else if (_openTabs.Count == 0)
        {
            Vm.ResetSqlEditor();
        }
    }

    private async Task ResetTableTabSql(TableTab tab)
    {
        tab.Sql = DefaultSqlFor(tab.TableName);
        tab.Result = null;
        tab.Error = null;
        await Vm.SetSqlEditorValueAsync(tab.Sql);
        StateHasChanged();
    }

    private async Task RunTableTabAsync(TableTab tab)
    {
        tab.Running = true;
        tab.Error = null;
        StateHasChanged();
        try
        {
            var editorSql = await Vm.GetSqlEditorValueAsync();
            if (editorSql is not null)
                tab.Sql = editorSql;
            tab.Result = await DataService.ExecuteProjectDataAsync(ProjectId, tab.Sql);
        }
        catch (Exception ex)
        {
            tab.Result = null;
            tab.Error = ex.Message;
        }
        finally
        {
            tab.Running = false;
            StateHasChanged();
        }
    }

    private string DefaultSqlFor(string tableName) =>
        $"SELECT * FROM \"{EscapeIdent(tableName)}\" LIMIT 100;";

    private static string EscapeIdent(string value) => value.Replace("\"", "\"\"");

    private static string CsvEscape(string value)
    {
        if (value is null) return "";
        var normalized = value.Replace("\"", "\"\"");
        return normalized.Contains(',', StringComparison.Ordinal) || normalized.Contains('\n', StringComparison.Ordinal) || normalized.Contains('\r', StringComparison.Ordinal)
            ? $"\"{normalized}\""
            : normalized;
    }

    private string GetTabResultCsvUri(TableTab tab)
    {
        if (tab.Result is null)
            return "";
        var sb = new StringBuilder();
        sb.AppendLine(string.Join(",", tab.Result.Columns.Select(CsvEscape)));
        foreach (var row in tab.Result.Rows)
            sb.AppendLine(string.Join(",", row.Select(v => CsvEscape(v ?? ""))));
        return "data:text/csv;charset=utf-8;base64,"
            + Convert.ToBase64String(Encoding.UTF8.GetBytes(sb.ToString()));
    }

    private void OpenJsonViewer(string column, string value)
    {
        using var document = JsonDocument.Parse(value);
        _jsonViewerTitle = column;
        _jsonViewerValue = JsonSerializer.Serialize(
            document.RootElement,
            new JsonSerializerOptions { WriteIndented = true }
        );
    }

    private void CloseJsonViewer()
    {
        _jsonViewerTitle = null;
        _jsonViewerValue = null;
    }

    private void PruneOpenTabs()
    {
        if (_openTabs.Count == 0) return;
        var existing = Vm.Tables.Select(t => t.Name).ToHashSet(StringComparer.Ordinal);
        for (var i = _openTabs.Count - 1; i >= 0; i--)
        {
            if (!existing.Contains(_openTabs[i].TableName))
                _openTabs.RemoveAt(i);
        }

        if (_activeTableName is null) return;
        if (_openTabs.Any(tab => StringComparer.Ordinal.Equals(tab.TableName, _activeTableName))) return;
        _activeTableName = _openTabs.FirstOrDefault()?.TableName;
    }
}
