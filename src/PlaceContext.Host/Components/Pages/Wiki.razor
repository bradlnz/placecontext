@page "/wiki"
@attribute [Authorize]
@page "/wiki/{Slug}"
@using PlaceContext.Host.Wiki
@inject PortalUiState Ui
@inject NavigationManager Nav

<PageTitle>PlaceContext — Wiki: @(_article?.Title ?? "Docs")</PageTitle>

<div class="page">

    <button type="button" class="toc-toggle"
            aria-controls="wiki-contents" aria-expanded="@_tocOpen"
            @onclick="ToggleContents">
        <span>Documentation</span>
        <span class="toc-current">@(_article?.Title ?? "Choose an article")</span>
        <span aria-hidden="true">@(_tocOpen ? "−" : "+")</span>
    </button>

    @* ── Contents ───────────────────────────────────────────────────────────────────────── *@
    <nav id="wiki-contents" class="@($"toc {(_tocOpen ? "open" : string.Empty)}")"
         aria-label="Documentation articles">
        <div class="toc-head">
            Documentation
        </div>
        @foreach (var a in WikiLibrary.Articles)
        {
            var active = a.Slug == _article?.Slug;
            <a href="@($"/wiki/{a.Slug}")" class="toc-link" aria-current="@(active ? "page" : null)"
               @onclick="CloseContents"
               style="color:@(active ? "var(--text)" : "var(--text-2)");
                      background:@(active ? "var(--hover)" : "transparent");
                      border-left:2px solid @(active ? "var(--brand)" : "transparent")">
                @a.Title
            </a>
        }
    </nav>

    @* ── Article ────────────────────────────────────────────────────────────────────────── *@
    <article class="article">
        @if (_article is null)
        {
            <div class="not-found">
                Article not found. <a href="/wiki" class="link">Back to the docs home →</a>
            </div>
        }
        else
        {
            <div class="summary">@_article.Summary</div>
            <div class="pcwiki">
                @((MarkupString)_article.Html)
            </div>
        }
    </article>
</div>

<style>
    .pcwiki { font-size:13.5px; line-height:1.7; color:var(--text-2); max-width:820px; overflow-wrap:anywhere; }
    .pcwiki h1 { font-size:24px; font-weight:700; color:var(--text); margin:0 0 14px; }
    .pcwiki h2 { font-size:17px; font-weight:600; color:var(--text); margin:26px 0 10px; padding-bottom:6px; border-bottom:1px solid var(--border); }
    .pcwiki h3 { font-size:14px; font-weight:600; color:var(--text); margin:20px 0 8px; }
    .pcwiki p { margin:0 0 12px; }
    .pcwiki a { color:var(--brand-2); text-decoration:underline; text-underline-offset:2px; }
    .pcwiki ul, .pcwiki ol { margin:0 0 12px; padding-left:22px; }
    .pcwiki li { margin:4px 0; }
    .pcwiki code { font-family:var(--font-mono); font-size:12px; background:var(--card-2); border:1px solid var(--border); border-radius:4px; padding:1px 5px; color:var(--text); }
    .pcwiki pre { background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:12px 14px; overflow-x:auto; margin:0 0 14px; }
    .pcwiki pre code { background:none; border:none; padding:0; font-size:12px; line-height:1.55; color:var(--text-2); }
    .pcwiki table { border-collapse:collapse; width:100%; max-width:100%; margin:0 0 14px; font-size:12.5px; }
    .pcwiki th, .pcwiki td { text-align:left; padding:7px 10px; border:1px solid var(--border); }
    .pcwiki th { background:var(--card-2); font-weight:600; color:var(--text); }
    .pcwiki blockquote { margin:0 0 14px; padding:8px 14px; border-left:3px solid var(--brand); background:var(--card); border-radius:0 7px 7px 0; color:var(--text-2); }
    .pcwiki hr { border:none; border-top:1px solid var(--border); margin:22px 0; }
</style>

@code {
    [Parameter] public string? Slug { get; set; }

    private WikiArticle? _article;
    private bool _tocOpen;

    protected override void OnParametersSet()
    {
        // Default to the first article (Getting started) at /wiki.
        _article = Slug is null
            ? WikiLibrary.Articles.FirstOrDefault()
            : WikiLibrary.Find(Slug);
        _tocOpen = false;
        Ui.Set("Wiki", _article?.Title ?? "platform documentation");
    }

    private void ToggleContents() => _tocOpen = !_tocOpen;

    private void CloseContents() => _tocOpen = false;
}
