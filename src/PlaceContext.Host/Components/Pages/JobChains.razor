@page "/project/{ProjectId:guid}/chains"
@attribute [Authorize(Policy = Permission.ChainsManage)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@using PlaceContext.Application.Dtos
@using PlaceContext.Domain.ValueObjects
@using System.Text.Json
@using PlaceContext.Host.Components.ViewModels
@using PlaceContext.Host.Components.ViewModels.Helpers
@inject JobChainsViewModel Vm

<PageTitle>PlaceContext — Job chains</PageTitle>

@if (Vm.Loading)
{
    <Skeleton Kind="list" Rows="5" Padded />
}
else
{
    <div class="chains-page">
        <header class="chains-head">
            <div>
                <h2>Job chains</h2>
                <p>Connect reusable jobs into ordered pipelines, including parallel stages and delivery actions.</p>
            </div>
            <div class="head-actions">
                <button class="dcbtn" @onclick="Vm.NavigateToJobs">View jobs</button>
                <button class="dcbtn primary" @onclick="() => Vm.NewChain()">+ New chain</button>
            </div>
        </header>

        @if (Vm.Message is not null)
        {
            <div class="status-message">@Vm.Message</div>
        }

        @if (Vm.Chains is null or { Count: 0 })
        {
            <div class="dccard empty-state">
                <div class="empty-icon">⇢</div>
                <strong>No job chains yet</strong>
                <span>Link reusable jobs into a pipeline, then run the whole workflow with one action.</span>
                <button class="dcbtn primary" @onclick="() => Vm.NewChain()">Create first chain</button>
            </div>
        }
        else
        {
            <section class="summary-strip" aria-label="Job chain summary">
                <div class="summary-count"><strong>@Vm.Chains.Count</strong><span>chains</span></div>
                <div class="summary-count"><strong>@Vm.Chains.Sum(chain => chain.Stages.Count)</strong><span>stages</span></div>
                <div class="summary-count"><strong>@Vm.Chains.Sum(chain => chain.Steps.Count)</strong><span>job steps</span></div>
                <div class="summary-count parallel"><strong>@Vm.Chains.Sum(chain => chain.Stages.Count(stage => stage.IsParallel))</strong><span>parallel</span></div>
            </section>

            <section class="dccard chain-suite">
                <header class="suite-head">
                    <div>
                        <span class="suite-caret">⌄</span>
                        <strong>Chain catalogue</strong>
                        <span>@Vm.Chains.Count reusable pipeline@(Vm.Chains.Count == 1 ? "" : "s")</span>
                    </div>
                    <span class="suite-result">@Vm.Chains.Sum(chain => chain.Stages.Count) stages</span>
                </header>

                <div class="chain-rows">
                    @foreach (var chain in Vm.Chains)
                    {
                        var isRunning = Vm.IsRunningChain(chain.Id);
                        var parallelStages = chain.Stages.Count(stage => stage.IsParallel);
                        var actionStages = chain.Stages.Count(stage => stage.Action is not null);
                        <article class="chain-row @(isRunning ? "running" : null)" @onclick="@(() => Vm.OpenChainAsync(chain))">
                            <div class="status-icon @(isRunning ? "is-running" : null)" aria-label="@Vm.ChainStatusAria(isRunning)">
                                @if (isRunning)
                                {
                                    <span class="spinner"></span>
                                }
                                else
                                {
                                    <span>⇢</span>
                                }
                            </div>
                            <div class="chain-copy">
                                <div class="chain-title">
                                    <strong>@chain.Name</strong>
                                    <span class="chain-chip">@chain.Stages.Count stage@(chain.Stages.Count == 1 ? "" : "s")</span>
                                    <span class="chain-chip">@chain.Steps.Count job step@(chain.Steps.Count == 1 ? "" : "s")</span>
                                    @if (parallelStages > 0)
                                    {
                                        <span class="chain-chip brand-chip">@parallelStages parallel</span>
                                    }
                                    @if (actionStages > 0)
                                    {
                                        <span class="chain-chip action-chip">@actionStages delivery action@(actionStages == 1 ? "" : "s")</span>
                                    }
                                </div>
                                <div class="chain-detail">
                                    <span>@(string.IsNullOrWhiteSpace(chain.Description) ? "No description" : chain.Description)</span>
                                    <span class="chain-facts">updated @Vm.Presentation.Date(chain.UpdatedAt)</span>
                                </div>
                                <div class="step-chips">
                                    @foreach (var (stage, i) in chain.Stages.Select((s, i) => (s, i)))
                                    {
                                        if (i > 0)
                                        {
                                            <span class="chip-arrow">→</span>
                                        }
                                        @if (stage.Action is SendEmailChainActionView emailAction)
                                        {
                                            <span class="step-chip" style="color:var(--brand-2)">✉ Send email · @emailAction.Recipient</span>
                                        }
                                        else if (stage.Action is SendSmsChainActionView smsAction)
                                        {
                                            <span class="step-chip" style="color:var(--brand-2)">▣ Send SMS · @smsAction.Recipient</span>
                                        }
                                        else if (stage.IsParallel)
                                        {
                                            <span class="stage-group" title="parallel fan-out — all run at once">
                                                @foreach (var (job, j) in stage.Jobs.Select((s, j) => (s, j)))
                                                {
                                                    if (j > 0)
                                                    {
                                                        <span class="chip-plus">+</span>
                                                    }
                                                    <span class="step-chip" style="color:@Vm.JobChipColor(job.JobName)">@job.JobName</span>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="step-chip" style="color:@Vm.JobChipColor(stage.Jobs[0].JobName)">@stage.Jobs[0].JobName</span>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="chain-actions">
                                @if (Vm.ConfirmDeleteId == chain.Id)
                                {
                                    <button class="dcbtn danger" @onclick:stopPropagation="true" @onclick="@(() => Vm.DeleteChainAsync(chain.Id))">Delete</button>
                                    <button class="dcbtn" @onclick:stopPropagation="true" @onclick="@(() => Vm.ConfirmDeleteId = null)">Keep</button>
                                }
                                else
                                {
                                    <button class="icon-action run-action" title="Run chain" aria-label="Run @chain.Name"
                                            disabled="@isRunning" @onclick:stopPropagation="true"
                                            @onclick="@(() => Vm.RunChainAsync(chain))">▶</button>
                                    <button class="icon-action" title="Edit chain" aria-label="Edit @chain.Name"
                                            @onclick:stopPropagation="true" @onclick="@(() => Vm.OpenChainAsync(chain))">✎</button>
                                    <button class="icon-action danger-action" title="Delete chain" aria-label="Delete @chain.Name"
                                            @onclick:stopPropagation="true" @onclick="@(() => Vm.ConfirmDeleteId = chain.Id)">⋯</button>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
}

@* ── Chain slide-out: Details (edit) | Runs (pipeline history, live) ─────────────────────── *@
@if (Vm.ShowEditor)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseEditor()"></div>
    <div class="dcslide slide-640">
        <div class="dcslide-head">
            <div class="flex-min">
                <div class="title-14">@(Vm.EditChainId.HasValue ? Vm.EdName : "New chain")</div>
                <div class="sub-115">
                    Stages run in order; a stage with more than one job runs them all in parallel — every job
                    in it must succeed for the chain to continue. A failed job stops the whole chain. The same
                    job may appear more than once.
                </div>
            </div>
            @if (Vm.EditChainId.HasValue && Vm.Chains?.FirstOrDefault(c => c.Id == Vm.EditChainId) is { } runnable)
            {
                <button class="dcbtn primary mr-10" disabled="@Vm.IsRunningChain(runnable.Id)" @onclick="@(() => Vm.RunChainAsync(runnable))">
                    @(Vm.IsRunningChain(runnable.Id) ? "running…" : "▶ Run")
                </button>
            }
            <button class="dcslide-x" @onclick="() => Vm.CloseEditor()">×</button>
        </div>

        @if (Vm.EditChainId.HasValue)
        {
            <div class="dctabs editor-tabs">
                <button class="dctab @(Vm.IsDetailsTab ? "active" : "")" @onclick="@(() => Vm.EditorTab = "details")">Details</button>
                <button class="dctab @(Vm.IsRunsTab ? "active" : "")" @onclick="() => Vm.SwitchToRunsTabAsync()">Runs<span class="n">@(Vm.ChainRuns?.Count ?? 0)</span></button>
            </div>
        }

        @if (Vm.IsRunsTab && Vm.EditChainId.HasValue)
        {
            <div class="dcslide-body runs-body">
                @if (Vm.OpenRun is null)
                {
                    @if (Vm.ChainRuns is null or { Count: 0 })
                    {
                        <div class="no-runs">No runs yet — click ▶ Run to start the pipeline.</div>
                    }
                    else
                    {
                        @foreach (var run in Vm.ChainRuns)
                        {
                            <div class="dccard run-card" @onclick="@(() => Vm.OpenChainRunAsync(run))">
                                <div class="run-row">
                                    <span class="status-chip" style="color:@Vm.Presentation.StatusColor(run.Status); background:@Vm.Presentation.StatusBackground(run.Status)">@run.Status</span>
                                    <span class="run-time">
                                        @Vm.Presentation.DateTime(run.StartedAt)
                                    </span>
                                    <span class="meta-11">
                                        @Vm.SucceededSteps(run)/@run.Steps.Count steps
                                    </span>
                                    @if (run.FinishedAt.HasValue)
                                    {
                                        <span class="dur-meta">
                                            @Vm.Presentation.Duration(run.StartedAt, run.FinishedAt.Value)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="running-note">running…</span>
                                    }
                                    @if (Vm.IsChainRunActive(run.Status))
                                    {
                                        <button class="dcbtn btn-2-8 text-bad" @onclick:stopPropagation="true"
                                                @onclick="@(() => Vm.CancelChainRunAsync(run.Id))">Cancel</button>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <button class="dcbtn btn-start" @onclick="@(() => Vm.CloseChainRun())">← All runs</button>

                    <div class="status-row">
                        <span class="status-chip-lg" style="color:@Vm.Presentation.StatusColor(Vm.OpenRun.Status); background:@Vm.Presentation.StatusBackground(Vm.OpenRun.Status)">@Vm.OpenRun.Status</span>
                        <span class="dur-meta">
                            @Vm.Presentation.DateTime(Vm.OpenRun.StartedAt)
                            @(Vm.OpenRun.FinishedAt.HasValue ? " · took " + Vm.Presentation.Duration(Vm.OpenRun.StartedAt, Vm.OpenRun.FinishedAt.Value) : " · live")
                        </span>
                        @if (Vm.IsChainRunActive(Vm.OpenRun.Status))
                        {
                            <button class="dcbtn btn-2-8 text-bad" @onclick="@(() => Vm.CancelChainRunAsync(Vm.OpenRun.Id))">Cancel run</button>
                        }
                    </div>

                    <div class="running-steps-panel">
                        <div class="running-steps-head">
                            <span>Running steps</span>
                            <span>@Vm.SucceededSteps(Vm.OpenRun)/@Vm.OpenRun.Steps.Count complete</span>
                        </div>
                    <ChainPipeline Run="Vm.OpenRun" OnStepClick="@Vm.OpenStepRunAsync"
                                   OnStepCancel="@(step => Vm.CancelStepRunAsync(step.RunId!.Value))" />
                    </div>

                    @if (Vm.ContextRows.Count > 0)
                    {
                        <div class="chain-context-panel">
                            <div class="out-label">Accumulated chain context</div>
                            <div class="chain-context-scroll">
                                <table class="chain-context-table">
                                    <thead>
                                        <tr>
                                            <th class="chain-context-cell chain-context-path">Field</th>
                                            <th class="chain-context-cell">Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in Vm.ContextRows)
                                        {
                                            var isJson = IsJsonLike(row.Value);
                                            <tr>
                                                <td class="chain-context-cell chain-context-path"><code>@row.Path</code></td>
                                                <td class="chain-context-cell">
                                                    @if (isJson)
                                                    {
                                                        <button class="dcbtn btn-2-8 json-view-button"
                                                                @onclick="@(() => OpenChainContextJson(row.Path, row.Value))">
                                                            View JSON
                                                        </button>
                                                        <span class="chain-context-preview">@GetJsonPreview(row.Value)</span>
                                                    }
                                                    else
                                                    {
                                                        <code class="chain-context-value">@row.Value</code>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    @if (Vm.OpenRun.FinalOutput is { Length: > 0 })
                    {
                        <div>
                            <div class="out-label">Pipeline output</div>
                            <pre class="json-pre">@Vm.Presentation.Json(Vm.OpenRun.FinalOutput)</pre>
                        </div>
                    }

                    @if (Vm.StepRunDetail is { } d)
                    {
                        <div class="stage-detail live-output-panel">
                            <div class="stage-detail-head">
                                <span class="live-output-title">
                                    @if (Vm.IsRunningStep(d.Status))
                                    {
                                        <i class="output-live-dot"></i>
                                    }
                                    @Vm.StepOutputTitle(d.Status)
                                    <b>@(Vm.OpenRun.Steps.FirstOrDefault(s => s.RunId == d.Id)?.JobName)</b>
                                </span>
                                <span class="status-chip-sm" style="color:@Vm.Presentation.StatusColor(d.Status); background:@Vm.Presentation.StatusBackground(d.Status)">@d.Status</span>
                                <span class="flex-1"></span>
                                @if (Vm.LiveOutputUpdatedAt is { } outputAt)
                                {
                                    <span class="output-updated">updated @Vm.Presentation.Format(outputAt, "HH:mm:ss")</span>
                                }
                                <button class="dcbtn btn-xs"
                                        @onclick="Vm.NavigateToJobs">open in Jobs →</button>
                            </div>
                            @if (d.ShardResults.Count == 0 && Vm.IsRunning(d.Status))
                            {
                                @if (!string.IsNullOrWhiteSpace(Vm.LiveOutputText))
                                {
                                    <pre class="log-pre live-log streaming-log">@Vm.LiveOutputText</pre>
                                }
                                else
                                {
                                    <div class="output-waiting">
                                        <span class="output-cursor"></span>
                                        Waiting for the first output from this job…
                                    </div>
                                }
                            }
                            @foreach (var shard in d.ShardResults)
                            {
                                <div class="mb-8">
                                    <div class="shard-head">shard @shard.Index — @shard.Outcome (exit @shard.ExitCode)</div>
                                    @if (shard.Artifact is not null)
                                    {
                                        <pre class="artifact-pre">@Vm.Presentation.Json(shard.Artifact)</pre>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(shard.Log))
                                    {
                                        <details class="log-details" open="@Vm.IsFailedStep(shard.Outcome)">
                                            <summary class="log-summary">Log</summary>
                                            <pre class="log-pre">@shard.Log</pre>
                                        </details>
                                    }
                                </div>
                            }
                            @if (d.ReduceResult is { } reduce)
                            {
                                <div class="mb-8">
                                    <div class="shard-head">reduce — @Vm.ReduceStatusLabel(reduce.Succeeded) (exit @reduce.ExitCode)</div>
                                    @if (!string.IsNullOrWhiteSpace(reduce.Artifact))
                                    {
                                        <pre class="artifact-pre">@Vm.Presentation.Json(reduce.Artifact)</pre>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(reduce.Log))
                                    {
                                        <pre class="log-pre live-log">@reduce.Log</pre>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
        else
        {
            var canvasStages = Vm.BuildCanvasStageViews();
        <div class="dcslide-body editor-body">

            <div class="field-row">
                <div class="dcfield flex-1">
                    <label>Name <span class="req">*</span></label>
                    <input class="dcinput" @bind="Vm.EdName" placeholder="my-pipeline" />
                </div>
                <div class="dcfield flex-14">
                    <label>Description</label>
                    <input class="dcinput" @bind="Vm.EdDescription" placeholder="What does this chain produce? (optional)" />
                </div>
            </div>

            @* ── Canvas / List toggle ────────────────────────────────────────────────────── *@
            <div class="dctabs editor-tabs sub-tabs">
                <button class="dctab @(Vm.IsCanvasView ? "active" : "")" @onclick="@(() => Vm.EditorView = "canvas")">
                    <span class="tab-icon">⌘</span> Canvas
                </button>
                <button class="dctab @(!Vm.IsCanvasView ? "active" : "")" @onclick="@(() => Vm.EditorView = "list")">
                    <span class="tab-icon">☷</span> List
                </button>
            </div>

            @if (Vm.IsCanvasView)
            {
                @* ── Canvas view ──────────────────────────────────────────────────────────── *@
                <div class="mb-8">
            <ChainCanvas Stages="canvasStages"
                         Jobs="@(Vm.Jobs ?? Array.Empty<JobView>())"
                         Gates="@Vm.BuildCanvasGates()"
                         OnAddGate="@(stageIndex => Vm.OpenStageNodePicker(stageIndex))"
                         OnEditGate="@(pair => Vm.OpenGateEditor(pair.StageIndex))"
                         OnAddStage="@(jobId => Vm.AddStage(jobId))"
                         OnEditEmailAction="@(stageIndex => Vm.OpenEmailActionEditor(stageIndex))"
                         OnEditSmsAction="@(stageIndex => Vm.OpenSmsActionEditor(stageIndex))"
                         OnAddPath="@(item => Vm.AddPath(item.StageIndex, item.JobId))"
                         OnMoveStage="@(move => Vm.MoveStageTo(move.SourceIndex, move.TargetIndex))"
                         OnMovePath="@(move => Vm.MovePath(move.SourceStage, move.SourceBranch, move.TargetStage))"
                         OnRemovePath="@(item => Vm.RemoveBranch(item.StageIndex, item.BranchIndex))"
                         OnRemoveStage="@(stageIndex => Vm.RemoveStage(stageIndex))" />
                </div>
            }

            @if (!Vm.IsCanvasView)
            {
            @* ── List editor ──────────────────────────────────────────────────────────────── *@
            <div class="dcform-section">
                <span class="dcform-title">Stages <span class="req">*</span></span>
                <div class="sub-note mb-8">
                    A stage with more than one job runs them all in parallel (a fan-out group) — every job in
                    it must succeed for the chain to continue to the next stage, which acts as the join.
                    Click a <strong>+</strong> diamond between stages to add flow-control gates (wait / condition).
                </div>

                @if (Vm.EdStages.Count == 0)
                {
                    <div class="empty-steps">
                        No stages yet — pick a job below and add it.
                    </div>
                }
                else
                {
                    <div class="step-list">
                        @foreach (var (stage, i) in Vm.EdStages.Select((s, i) => (s, i)))
                        {
                            var stageIndex = i;
                            var hasGate = Vm.EdStageGates.TryGetValue(stageIndex, out var stageGate) && stageGate is not null;
                            <div class="step-item stage-item">
                                <span class="step-num">@(stageIndex + 1).</span>
                                <div class="stage-jobs">
                                    @if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is SendEmailChainAction emailAction)
                                    {
                                        <button class="stage-job-chip" title="Edit Send Email action"
                                                @onclick="@(() => Vm.OpenEmailActionEditor(stageIndex))">
                                            ✉ Send email · @emailAction.Recipient
                                        </button>
                                    }
                                    else if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is SendSmsChainAction smsAction)
                                    {
                                        <button class="stage-job-chip" title="Edit Send SMS action"
                                                @onclick="@(() => Vm.OpenSmsActionEditor(stageIndex))">
                                            ▣ Send SMS · @smsAction.Recipient
                                        </button>
                                    }
                                    @foreach (var (jobId, j) in stage.Select((id, j) => (id, j)))
                                    {
                                        var branchIndex = j;
                                        <span class="stage-job-chip">
                                            @Vm.JobName(jobId)
                                            <button class="dcbtn btn-2-8-del" title="Remove this job from the stage"
                                                    @onclick="@(() => Vm.RemoveBranch(stageIndex, branchIndex))">×</button>
                                        </span>
                                    }
                                </div>
                                <div class="stage-gate-row">
                                    @if (hasGate)
                                    {
                                        var gate = stageGate!;
                                        <span class="gate-tag @(gate is WaitGate ? "gate-tag-wait" : "gate-tag-condition")"
                                              title="@(gate is WaitGate w ? $"Wait {w.Duration.TotalSeconds}s" : gate is ConditionGate c ? $"If {c.Expression}" : "")"
                                              @onclick="@(() => Vm.OpenGateEditor(stageIndex))">
                                            @(gate is WaitGate wg ? $"⏱ {wg.Duration.TotalSeconds}s" : gate is ConditionGate cg ? $"◇ {cg.Expression}" : "")
                                            <button class="dcbtn btn-2-8-del gate-remove" @onclick:stopPropagation="true"
                                                    @onclick="@(() => Vm.RemoveGate(stageIndex))">×</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button class="dcbtn btn-xs" @onclick="@(() => Vm.OpenStageNodePicker(stageIndex))">+ step</button>
                                    }
                                </div>
                                @if (!Vm.HasStageAction(stageIndex))
                                {
                                <div class="stage-branch-row">
                                    <select class="dcinput branch-select" title="Pick a job to add as a parallel branch"
                                            value="@Vm.EdBranchJobIds.GetValueOrDefault(stageIndex, "")"
                                            @onchange="@((e) => Vm.SetBranchJobId(stageIndex, e))">
                                        <option value="">— pick a job —</option>
                                        @foreach (var job in Vm.Jobs ?? Array.Empty<JobView>())
                                        {
                                            <option value="@job.Id">@job.Name</option>
                                        }
                                    </select>
                                    <button class="dcbtn btn-2-8" title="Add the picked job as a parallel branch of this stage"
                                            disabled="@(string.IsNullOrEmpty(Vm.EdBranchJobIds.GetValueOrDefault(stageIndex, "")))"
                                            @onclick="@(() => Vm.AddBranch(stageIndex))">+ branch</button>
                                </div>
                                }
                                <button class="dcbtn btn-2-8" disabled="@(stageIndex == 0)" @onclick="@(() => Vm.MoveStage(stageIndex, -1))">↑</button>
                                <button class="dcbtn btn-2-8" disabled="@(stageIndex == Vm.EdStages.Count - 1)" @onclick="@(() => Vm.MoveStage(stageIndex, +1))">↓</button>
                                <button class="dcbtn btn-2-8-del" @onclick="@(() => Vm.RemoveStage(stageIndex))">×</button>
                            </div>
                        }
                    </div>
                }

                <div class="add-row">
                    <select class="dcinput flex-1" @bind="Vm.EdAddJobId">
                        <option value="">— pick a job —</option>
                        @foreach (var job in Vm.Jobs ?? Array.Empty<JobView>())
                        {
                            <option value="@job.Id">@job.Name</option>
                        }
                    </select>
                    <button class="dcbtn" disabled="@(string.IsNullOrEmpty(Vm.EdAddJobId))" @onclick="() => Vm.AddStage()">+ Add step</button>
                    @if (Vm.CanSendSmsAction)
                    {
                        <button class="dcbtn" @onclick="() => Vm.OpenNewSmsAction()">▣ Send SMS</button>
                    }
                </div>
            </div>
            }

        </div>
        }

        @* ── Unified connector step picker ─────────────────────────────────────────────── *@
        @if (Vm.ShowStageNodePicker)
        {
            <div class="dcmodal-overlay" @onclick="() => Vm.CloseStageNodePicker()">
                <div class="dcmodal pipeline-step-modal" @onclick:stopPropagation="true">
                    <div class="dcmodal-head">
                        <div>
                            <div class="title-14">Add pipeline step</div>
                            <div class="sub-115">Select a job to insert before stage @(Vm.StageNodePickerIndex + 1).</div>
                        </div>
                        <button class="dcslide-x pipeline-modal-close" aria-label="Close add pipeline step"
                                @onclick="() => Vm.CloseStageNodePicker()">×</button>
                    </div>
                    <div class="dcmodal-body pipeline-step-body">
                        <div class="job-picker-grid">
                            @foreach (var job in Vm.Jobs ?? Array.Empty<JobView>())
                            {
                                <button class="job-picker-tile" @onclick="@(() => Vm.ChooseStageJob(job.Id))">
                                    <span class="job-picker-icon">◆</span>
                                    <span>
                                        <strong>@job.Name</strong>
                                        <small>@(string.IsNullOrWhiteSpace(job.Description) ? "Reusable job" : job.Description)</small>
                                    </span>
                                </button>
                            }
                        </div>
                        @if (Vm.Jobs is null or { Count: 0 })
                        {
                            <div class="job-picker-empty">No jobs yet. Create a job before adding it to a chain.</div>
                        }
                        <div class="node-picker-divider">Actions and control</div>
                        <div class="node-picker-grid">
                        <button class="node-picker-tile" disabled="@(!Vm.CanSendEmailAction)" @onclick="@(() => Vm.ChooseStageNode("email"))">
                            <span class="node-picker-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                            </span>
                            <strong>Send email</strong><small>Email through workspace communications</small>
                        </button>
                        <button class="node-picker-tile" disabled="@(!Vm.CanSendSmsAction)" @onclick="@(() => Vm.ChooseStageNode("sms"))">
                            <span class="node-picker-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/><path d="M8 9h8M8 13h5"/></svg>
                            </span>
                            <strong>Send SMS</strong><small>Text message through workspace communications</small>
                        </button>
                        <button class="node-picker-tile" @onclick="Vm.ChooseConditionNode">
                            <span class="node-picker-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><circle cx="6" cy="5" r="2"/><circle cx="18" cy="5" r="2"/><circle cx="12" cy="19" r="2"/><path d="M6 7v2a4 4 0 0 0 4 4h2M18 7v2a4 4 0 0 1-4 4h-2v4"/></svg>
                            </span>
                            <strong>Condition</strong><small>Continue when payload matches</small>
                        </button>
                        <button class="node-picker-tile" @onclick="Vm.ChooseWaitNode">
                            <span class="node-picker-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                            </span>
                            <strong>Delay / gate</strong><small>Wait before the next stage</small>
                        </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ── Gate editor modal ────────────────────────────────────────────────────────────── *@
        @if (Vm.ShowGateEditor)
        {
            <div class="dcmodal-overlay" @onclick="() => Vm.CancelGateEditor()">
                <div class="dcmodal gate-modal" @onclick:stopPropagation="true">
                    <div class="dcmodal-head">
                        <div class="title-14">Gate on stage @(Vm.GateEditorStageIndex + 1)</div>
                        <button class="dcslide-x" @onclick="() => Vm.CancelGateEditor()">×</button>
                    </div>
                    <div class="dcmodal-body">
                        <div class="dcfield mb-8">
                            <label>Gate type</label>
                            <select class="dcinput" @bind="Vm.GateEditorType">
                                <option value="wait">Wait / delay</option>
                                <option value="condition">Condition / if-else</option>
                            </select>
                        </div>

                        @if (Vm.IsWaitGateEditor)
                        {
                            <div class="dcfield">
                                <label>Duration (seconds)</label>
                                <input class="dcinput" type="number" min="1" max="3600" step="1"
                                       @bind="Vm.GateEditorDuration" />
                            </div>
                            <div class="sub-note">Pauses the pipeline before running this stage's jobs.</div>
                        }

                        @if (Vm.IsConditionGateEditor)
                        {
                            <div class="condition-builder">
                                <div class="dcfield">
                                    <label>Payload path</label>
                                    <input class="dcinput mono" @bind="Vm.GateEditorPath"
                                           placeholder="data.status" />
                                </div>
                                <div class="dcfield">
                                    <label>Condition</label>
                                    <select class="dcinput" @bind="Vm.GateEditorOperator">
                                        <option value="exists">exists</option>
                                        <option value="notexists">does not exist</option>
                                        <option value="eq">equals</option>
                                        <option value="neq">does not equal</option>
                                        <option value="contains">contains</option>
                                        <option value="starts">starts with</option>
                                        <option value="ends">ends with</option>
                                        <option value="in">is one of</option>
                                        <option value="empty">is empty</option>
                                        <option value="notempty">is not empty</option>
                                        <option value="gt">is greater than</option>
                                        <option value="gte">is greater than or equal</option>
                                        <option value="lt">is less than</option>
                                        <option value="lte">is less than or equal</option>
                                    </select>
                                </div>
                                @if (Vm.ConditionNeedsValue)
                                {
                                    <div class="dcfield">
                                        <label>Value @(Vm.IsInGateOperator ? "(comma separated)" : "")</label>
                                        <input class="dcinput" @bind="Vm.GateEditorValue" placeholder="approved" />
                                    </div>
                                }
                            </div>
                            <div class="condition-preview">
                                <span>Expression</span>
                                <code>@Vm.ConditionPreview()</code>
                            </div>
                            <div class="sub-note">
                                Evaluated against the current job output. When false, this path is skipped
                                and the pipeline continues.
                            </div>
                        }
                    </div>
                    <div class="dcmodal-foot">
                        <button class="dcbtn" @onclick="() => Vm.CancelGateEditor()">Cancel</button>
                        <button class="dcbtn primary" @onclick="() => Vm.SaveGate()">Save gate</button>
                    </div>
                </div>
            </div>
        }

        @* ── Send SMS action editor ───────────────────────────────────────────────────── *@
        @if (Vm.ShowSmsActionEditor)
        {
            <div class="dcmodal-overlay" @onclick="() => Vm.CancelSmsActionEditor()">
                <div class="dcmodal gate-modal" @onclick:stopPropagation="true">
                    <div class="dcmodal-head">
                        <div>
                            <div class="title-14">Send SMS</div>
                            <div class="sub-115">Uses the workspace Communications connection. Insert previous output with <code>{{path.to.value}}</code>.</div>
                        </div>
                        <button class="dcslide-x" @onclick="() => Vm.CancelSmsActionEditor()">×</button>
                    </div>
                    <div class="dcmodal-body">
                        <div class="dcfield mb-8">
                            <label>Recipient <span class="req">*</span></label>
                            <input class="dcinput" @bind="Vm.SmsRecipient" placeholder="+61412345678 or {{client.phone}}" />
                        </div>
                        <div class="dcfield">
                            <label>Message <span class="req">*</span></label>
                            <textarea class="dcinput" rows="6" maxlength="1600" @bind="Vm.SmsBody"
                                      placeholder="Hello {{client.name}}, your report is ready."></textarea>
                        </div>
                        <div class="sub-note">Use an international recipient number. SMS/client release flags in the previous payload must allow delivery.</div>
                        @if (Vm.SmsActionError is not null)
                        {
                            <div class="editor-err">@Vm.SmsActionError</div>
                        }
                    </div>
                    <div class="dcmodal-foot">
                        <button class="dcbtn" @onclick="() => Vm.CancelSmsActionEditor()">Cancel</button>
                        <button class="dcbtn primary" @onclick="() => Vm.SaveSmsAction()">Save action</button>
                    </div>
                </div>
            </div>
        }

        @* ── Send Email action editor ──────────────────────────────────────────────────── *@
        @if (Vm.ShowEmailActionEditor)
        {
            <div class="dcmodal-overlay" @onclick="() => Vm.CancelEmailActionEditor()">
                <div class="dcmodal gate-modal email-action-modal" @onclick:stopPropagation="true">
                    <div class="dcmodal-head">
                        <div>
                            <div class="title-14">Send email</div>
                            <div class="sub-115">Uses the workspace Communications connection. Insert previous output with <code>{{path.to.value}}</code>.</div>
                        </div>
                        <button class="dcslide-x" @onclick="() => Vm.CancelEmailActionEditor()">×</button>
                    </div>
                    <div class="dcmodal-body">
                        <div class="email-json-panel">
                            <div class="email-json-head">
                                <div>
                                    <strong>Previous-step JSON</strong>
                                    <small>@(Vm.EmailJsonPathSource ?? "Use detected values as email placeholders.")</small>
                                </div>
                                @if (Vm.LoadingEmailJsonPaths)
                                {
                                    <span class="email-json-loading">Inspecting…</span>
                                }
                            </div>
                            @if (!Vm.LoadingEmailJsonPaths && Vm.EmailJsonPaths.Count > 0)
                            {
                                <div class="email-json-paths">
                                    @foreach (var suggestion in Vm.EmailJsonPaths)
                                    {
                                        <div class="email-json-row">
                                            <button class="email-json-key" title="Insert into message body"
                                                    @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "body")'>
                                                <code>@suggestion.Path</code>
                                                <span>@suggestion.Preview</span>
                                            </button>
                                            <div class="email-json-actions">
                                                <button title="Use as recipient" @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "recipient")'>To</button>
                                                <button title="Use as recipient name" @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "name")'>Name</button>
                                                <button title="Insert into subject" @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "subject")'>Subject</button>
                                                <button title="Insert into body" @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "body")'>Body</button>
                                                @if (suggestion.IsAttachmentCandidate)
                                                {
                                                    <button class="attachment-action" title="Use this object or array as email attachments"
                                                            @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "attachment")'>
                                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21.4 11.6-8.9 8.9a6 6 0 0 1-8.5-8.5l9.6-9.6a4 4 0 0 1 5.7 5.7l-9.6 9.6a2 2 0 0 1-2.8-2.8l8.9-8.9"/></svg>
                                                        Attach
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (!Vm.LoadingEmailJsonPaths)
                            {
                                <div class="email-json-empty">Run the preceding JSON job once to populate detected placeholders.</div>
                            }
                        </div>
                        <div class="dcfield mb-8">
                            <label>Recipient <span class="req">*</span></label>
                            <input class="dcinput" @bind="Vm.EmailRecipient" placeholder="client@example.com or {{client.email}}" />
                        </div>
                        <div class="dcfield mb-8">
                            <label>Recipient name</label>
                            <input class="dcinput" @bind="Vm.EmailRecipientName" placeholder="{{client.name}}" />
                        </div>
                        <div class="dcfield mb-8">
                            <label>Subject <span class="req">*</span></label>
                            <input class="dcinput" @bind="Vm.EmailSubject" placeholder="Report for {{site.address}}" />
                        </div>
                        <div class="dcfield">
                            <label>Text body <span class="req">*</span></label>
                            <textarea class="dcinput" rows="8" @bind="Vm.EmailBody"
                                      placeholder="Hello {{client.name}}, your report is ready."></textarea>
                        </div>
                        <div class="dcfield mb-8">
                            <label>Attachments JSON path</label>
                            <input class="dcinput" @bind="Vm.EmailAttachmentPath" placeholder="{{attachments}}" />
                            <div class="sub-note">
                                Optional. Accepts one object or an array with <code>name</code>, <code>content</code>/<code>contentBase64</code>, and <code>contentType</code>. Binary content must be base64.
                            </div>
                        </div>
                        <div class="sub-note">
                            If the previous payload contains email/client release flags, every present flag must explicitly allow delivery.
                        </div>
                        @if (Vm.EmailActionError is not null)
                        {
                            <div class="editor-err">@Vm.EmailActionError</div>
                        }
                    </div>
                    <div class="dcmodal-foot">
                        <button class="dcbtn" @onclick="() => Vm.CancelEmailActionEditor()">Cancel</button>
                        <button class="dcbtn primary" @onclick="() => Vm.SaveEmailAction()">Save action</button>
                    </div>
                </div>
            </div>
        }

        @if (_chainContextJson is not null)
        {
            <div class="dcmodal-overlay" @onclick="CloseChainContextJson">
                <div class="dcmodal chain-json-modal" @onclick:stopPropagation="true">
                    <div class="dcmodal-head">
                        <div>
                            <div class="title-14">Chain context JSON</div>
                            <div class="sub-115">Path: <code>@_chainContextJsonPath</code></div>
                        </div>
                        <button class="dcslide-x" @onclick="CloseChainContextJson">×</button>
                    </div>
                    <div class="dcmodal-body chain-json-body">
                        <pre class="json-pre">@_chainContextJson</pre>
                    </div>
                </div>
            </div>
        }

        @if (Vm.IsDetailsTab)
        {
            <div class="dcslide-foot">
                @if (Vm.EditorError is not null)
                {
                    <div class="editor-err">@Vm.EditorError</div>
                }
                <button class="dcbtn" @onclick="() => Vm.CloseEditor()">Cancel</button>
                <button class="dcbtn primary" disabled="@Vm.Saving" @onclick="() => Vm.SaveChainAsync()">
                    @(Vm.Saving ? "Saving…" : Vm.EditChainId.HasValue ? "Save chain" : "Create chain")
                </button>
            </div>
        }
    </div>
}

@if (Vm.RunPromptChain is not null)
{
    <div class="dcmodal-overlay" @onclick="() => Vm.CancelRunPrompt()">
        <div class="dcmodal run-modal" @onclick:stopPropagation="true">
            <div class="dcmodal-head">
                <div class="flex-min">
                    <div class="title-14">Run @Vm.RunPromptChain.Name</div>
                    <div class="sub-115">
                        Add an optional attachment, then review any declared step inputs below.
                    </div>
                </div>
                <button class="dcslide-x" @onclick="() => Vm.CancelRunPrompt()">×</button>
            </div>
            <div class="dcmodal-body modal-body-scroll">
                <div class="dcfield">
                    <label>
                        @ParameterPromptState.ChainAttachmentParameter.Label
                        <span class="code ml-5">@ParameterPromptState.ChainAttachmentField</span>
                    </label>
                    <ParamInput Parameter="@ParameterPromptState.ChainAttachmentParameter"
                                ProjectId="@ProjectId"
                                Value="@Vm.RunAttachment"
                                ValueChanged="@Vm.SetRunAttachment" />
                    <small>Available to the chain as <code>attachment.$file</code>.</small>
                </div>
                @foreach (var step in Vm.RunPromptSteps)
                {
                    <div class="prompt-step">
                        <div class="prompt-step-head">
                            <span class="step-badge">step @(step.Index + 1)</span>
                            <span class="step-jobtitle">@step.Job.Name</span>
                        </div>
                        @foreach (var p in step.Job.Parameters)
                        {
                            var key = JobChainsViewModel.ArgKey(step.Index, p.Name);
                            <div class="dcfield">
                                <label>
                                    @(p.Label ?? p.Name)
                                    @if (p.Required)
                                    {
                                        <span class="req">*</span>
                                    }
                                    <span class="code ml-5">@p.Name</span>
                                </label>
                                <ParamInput Parameter="p" ProjectId="@ProjectId" Value="@Vm.GetArg(key)"
                                            ValueChanged="@(v => Vm.SetArg(key, v))" />
                            </div>
                        }
                    </div>
                }
                @if (Vm.RunPromptError is not null)
                {
                    <div class="prompt-err">@Vm.RunPromptError</div>
                }
            </div>
            <div class="dcmodal-foot">
                <button class="dcbtn" @onclick="() => Vm.CancelRunPrompt()">Cancel</button>
                <button class="dcbtn primary" disabled="@(Vm.RunPromptChain is not null && Vm.IsRunningChain(Vm.RunPromptChain.Id))" @onclick="() => Vm.SubmitRunPromptAsync()">
                    @(Vm.RunPromptChain is not null && Vm.IsRunningChain(Vm.RunPromptChain.Id) ? "running…" : "▶ Run chain")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private string? _chainContextJson;
    private string? _chainContextJsonPath;

    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));

    protected override async Task OnParametersSetAsync()
    {
        Vm.Initialize(ProjectId);
        await Vm.LoadAsync();
    }

    public void Dispose()
    {
        Vm.DetachEvents();
        Vm.Detach();
    }

    private bool IsJsonLike(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        try
        {
            using var document = JsonDocument.Parse(value);
            return document.RootElement.ValueKind is JsonValueKind.Object or JsonValueKind.Array;
        }
        catch
        {
            return false;
        }
    }

    private static string GetJsonPreview(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "(empty)";

        var trimmed = value.Trim();
        const int max = 90;
        if (trimmed.Length <= max)
            return trimmed;

        return trimmed[..max] + "…";
    }

    private void OpenChainContextJson(string path, string value)
    {
        _chainContextJson = FormatJson(value);
        _chainContextJsonPath = path;
    }

    private void CloseChainContextJson()
    {
        _chainContextJson = null;
        _chainContextJsonPath = null;
    }

    private static string FormatJson(string raw)
    {
        try
        {
            using var document = JsonDocument.Parse(raw);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return raw;
        }
    }
}
