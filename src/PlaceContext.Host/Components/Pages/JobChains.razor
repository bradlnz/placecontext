@using PlaceContext.Application.Access.Models
@using PlaceContext.Application.Workload.VirtualMachines
@page "/project/{ProjectId:guid}/workflows"
@page "/project/{ProjectId:guid}/chains"
@page "/project/{ProjectId:guid}/workflows/{WorkflowRouteId:guid}"
@page "/project/{ProjectId:guid}/workflows/{WorkflowRouteId:guid}/{WorkflowRouteView}"
@page "/project/{ProjectId:guid}/workflows/{WorkflowRouteId:guid}/{WorkflowRouteView}/{WorkflowRouteRunId:guid}"
@attribute [Authorize(Policy = Permission.ChainsManage)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@using PlaceContext.Application.Dtos
@using PlaceContext.Domain.ValueObjects
@using System.Text.Json
@using PlaceContext.Host.Components.ViewModels
@using PlaceContext.Host.Components.ViewModels.Helpers
@inject JobChainsViewModel Vm

<PageTitle>PlaceContext — Workflows</PageTitle>

@if (Vm.Loading)
{
    <Skeleton Kind="list" Rows="5" Padded />
}
else
{
    <div class="chains-page">
        <WorkflowTabs ProjectId="ProjectId" Active="workflows" />
        <header class="chains-head">
            <div>
                <h2>Workflows</h2>
                <p>Build, run and monitor workflows here, including human approvals, execution history and results.</p>
            </div>
            <div class="head-actions">
                <a class="dcbtn" href="/observability?tab=workflows"><AppIcon Kind="pulse" /> Execution details</a>
                <button class="dcbtn primary" @onclick="() => Vm.NewChain()"><AppIcon Kind="plus" /> New workflow</button>
            </div>
        </header>

        @if (Vm.Message is not null)
        {
            <div class="status-message">@Vm.Message</div>
        }

        @if (Vm.Chains is null or { Count: 0 })
        {
            <div class="dccard empty-state">
                <div class="empty-icon"><AppIcon Kind="chain" /></div>
                <strong>No workflows yet</strong>
                <span>Link reusable jobs into a pipeline, then run the whole workflow with one action.</span>
                <button class="dcbtn primary" @onclick="() => Vm.NewChain()">Create first workflow</button>
            </div>
        }
        else
        {
            <section class="summary-strip" aria-label="Workflow summary">
                <div class="summary-count"><strong>@Vm.Chains.Count</strong><span>workflows</span></div>
                <div class="summary-count"><strong>@Vm.Chains.Sum(chain => chain.Stages.Count)</strong><span>stages</span></div>
                <div class="summary-count"><strong>@Vm.Chains.Sum(chain => chain.Steps.Count)</strong><span>job steps</span></div>
                <div class="summary-count parallel"><strong>@Vm.Chains.Sum(chain => chain.Stages.Count(stage => stage.IsParallel))</strong><span>parallel</span></div>
            </section>

            <section class="dccard chain-suite">
                <header class="suite-head">
                    <div>
                        <span class="suite-caret"><AppIcon Kind="chevron-down" /></span>
                        <strong>Workflow catalogue</strong>
                        <span>@Vm.Chains.Count reusable pipeline@(Vm.Chains.Count == 1 ? "" : "s")</span>
                    </div>
                    <span class="suite-result">@Vm.Chains.Sum(chain => chain.Stages.Count) stages</span>
                </header>

                <div class="chain-rows">
                    @foreach (var chain in Vm.Chains)
                    {
                        var isRunning = Vm.IsRunningChain(chain.Id);
                        var parallelStages = chain.Stages.Count(stage => stage.IsParallel);
                        var actionStages = chain.Stages.Count(stage => stage.Action is not null);
                        <article class="chain-row @(isRunning ? "running" : null)" @onclick="@(() => Vm.OpenChainEditorAsync(chain))">
                            <div class="status-icon @(isRunning ? "is-running" : null)" aria-label="@Vm.ChainStatusAria(isRunning)">
                                @if (isRunning)
                                {
                                    <span class="spinner"></span>
                                }
                                else
                                {
                                    <span><AppIcon Kind="chain" /></span>
                                }
                            </div>
                            <div class="chain-copy">
                                <div class="chain-title">
                                    <strong>@chain.Name</strong>
                                    <span class="chain-chip">@chain.Stages.Count stage@(chain.Stages.Count == 1 ? "" : "s")</span>
                                    <span class="chain-chip">@chain.Steps.Count job step@(chain.Steps.Count == 1 ? "" : "s")</span>
                                    @if (parallelStages > 0)
                                    {
                                        <span class="chain-chip brand-chip">@parallelStages parallel</span>
                                    }
                                    @if (actionStages > 0)
                                    {
                                        <span class="chain-chip action-chip">@actionStages delivery action@(actionStages == 1 ? "" : "s")</span>
                                    }
                                </div>
                                <div class="chain-detail">
                                    <span>@(string.IsNullOrWhiteSpace(chain.Description) ? "No description" : chain.Description)</span>
                                    <span class="chain-facts">updated @Vm.Presentation.Date(chain.UpdatedAt)</span>
                                </div>
                                <div class="step-chips">
                                    @foreach (var (stage, i) in chain.Stages.Select((s, i) => (s, i)))
                                    {
                                        if (i > 0)
                                        {
                                            <span class="chip-arrow"><AppIcon Kind="arrow-right" /></span>
                                        }
                                        @if (stage.Action is SendEmailChainActionView emailAction)
                                        {
                                            <span class="step-chip" style="color:var(--brand-2)"><AppIcon Kind="mail" /> Send email · @emailAction.Recipient</span>
                                        }
                                        else if (stage.Action is SendSmsChainActionView smsAction)
                                        {
                                            <span class="step-chip" style="color:var(--brand-2)"><AppIcon Kind="message" /> Send SMS · @smsAction.Recipient</span>
                                        }
                                        else if (stage.Action is LoopChainActionView loopAction)
                                        {
                                            <span class="step-chip loop-chip">@loopAction.DisplayName</span>
                                        }
                                        else if (stage.Action is QueryDataChainActionView queryAction)
                                        {
                                            <span class="step-chip">Query data · @queryAction.OutputField</span>
                                        }
                                        else if (stage.Action is ScoringGateChainActionView scoreAction)
                                        {
                                            <span class="step-chip">Scoring gate · ≥ @scoreAction.PassScore/100</span>
                                        }
                                        else if (stage.Action is RepeatFlowChainActionView repeatAction)
                                        {
                                            <span class="step-chip">Repeat flow · @repeatAction.MaxAttempts attempts</span>
                                        }
                                        else if (stage.Action is ContainerBuildChainActionView or ContainerRunChainActionView)
                                        {
                                            <span class="step-chip">@stage.Action.DisplayName</span>
                                        }
                                        else if (stage.Action is VirtualMachineChainActionView vmAction)
                                        {
                                            <span class="step-chip"><AppIcon Kind="vm" /> Browser workspace · @vmAction.ImageProfile</span>
                                        }
                                        else if (stage.IsParallel)
                                        {
                                            <span class="stage-group" title="parallel fan-out — all run at once">
                                                @foreach (var (job, j) in stage.Jobs.Select((s, j) => (s, j)))
                                                {
                                                    if (j > 0)
                                                    {
                                                        <span class="chip-plus"><AppIcon Kind="plus" /></span>
                                                    }
                                                    <span class="step-chip" style="color:@Vm.JobChipColor(job.JobName)">@job.JobName</span>
                                                }
                                            </span>
                                        }
                                        else if (stage.Action is { } action)
                                        {
                                            <span class="step-chip">@action.DisplayName</span>
                                        }
                                        else if (stage.Jobs.FirstOrDefault() is { } job)
                                        {
                                            <span class="step-chip" style="color:@Vm.JobChipColor(job.JobName)">@job.JobName</span>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="chain-actions">
                                @if (Vm.ConfirmDeleteId == chain.Id)
                                {
                                    <button class="dcbtn" @onclick:stopPropagation="true" @onclick="@(() => Vm.DeleteChainAsync(chain.Id))">Delete</button>
                                    <button class="dcbtn" @onclick:stopPropagation="true" @onclick="@(() => Vm.ConfirmDeleteId = null)">Keep</button>
                                }
                                else
                                {
                                    <button class="icon-action run-action" title="Run workflow" aria-label="Run @chain.Name"
                                            disabled="@isRunning" @onclick:stopPropagation="true"
                                            @onclick="@(() => Vm.RunChainAsync(chain))"><AppIcon Kind="play" /></button>
                                    <button class="icon-action" title="Edit workflow" aria-label="Edit @chain.Name"
                                            @onclick:stopPropagation="true" @onclick="@(() => Vm.OpenChainEditorAsync(chain))"><AppIcon Kind="edit" /></button>
                                    <button class="icon-action" title="Delete workflow" aria-label="Delete @chain.Name"
                                            @onclick:stopPropagation="true" @onclick="@(() => Vm.ConfirmDeleteId = chain.Id)"><AppIcon Kind="trash" /></button>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
}

@* ── Chain slide-out: Details (edit) | Runs (pipeline history, live) ─────────────────────── *@
@if (Vm.ShowEditor)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseEditor()"></div>
    <div class="dcslide slide-640">
        <div class="dcslide-head">
            <div class="flex-min">
                <div class="title-14">@(Vm.EditChainId.HasValue ? Vm.EdName : "New workflow")</div>
                <div class="sub-115">
                    Connect jobs, human decisions, and agent responses into one workflow.
                </div>
            </div>
            @if (Vm.EditChainId.HasValue && Vm.Chains?.FirstOrDefault(c => c.Id == Vm.EditChainId) is { } runnable)
            {
                <button class="dcbtn primary mr-10" disabled="@Vm.IsRunningChain(runnable.Id)" @onclick="@(() => Vm.RunChainAsync(runnable))">
                    <AppIcon Kind="play" /> @(Vm.IsRunningChain(runnable.Id) ? "running…" : "Run")
                </button>
            }
            <button class="dcbtn" aria-haspopup="dialog" @onclick='() => Vm.SetEditorView("canvas")'><AppIcon Kind="data.graph" /> Canvas</button>
            <button aria-label="Close" class="dcslide-x" @onclick="() => Vm.CloseEditor()"><AppIcon Kind="close" /></button>
        </div>

        <section class="workflow-readiness" aria-label="Workflow readiness checks">
            <div class="workflow-readiness-head">
                <div><strong>Pre-run checks</strong><small>Inspect referenced jobs, source configuration and human gates before saving.</small></div>
                <button type="button" class="dcbtn btn-2-8" disabled="@Vm.Saving" @onclick="Vm.CheckReadiness"><AppIcon Kind="test" /> Check</button>
            </div>
            @if (Vm.Readiness is { } preflight)
            {
                <div class="workflow-readiness-summary @(preflight.Ready ? "ready" : "blocked")" role="status">
                    <AppIcon Kind="@(preflight.Ready ? "check" : "warning")" />
                    @(preflight.Ready ? "Definition checks passed" : $"{preflight.ErrorCount} issues need fixing")
                    <span>@preflight.UniqueJobCount job(s) · @preflight.StageCount stages · @preflight.WarningCount warnings</span>
                </div>
                @if (preflight.Findings.Count > 0)
                {
                    <ul class="workflow-readiness-findings">
                        @foreach (var issue in preflight.Findings.Take(12))
                        {
                            <li class="@issue.Severity"><strong>@issue.Title</strong><span>@issue.Detail</span></li>
                        }
                    </ul>
                }
                <small class="workflow-readiness-note">Definition checks do not validate live credentials, source data, or future external side effects. Test jobs before production use.</small>
            }
        </section>

        @if (Vm.EditChainId.HasValue)
        {
            <div class="dctabs editor-tabs">
                <button class="dctab @(Vm.IsDetailsTab ? "active" : "")" @onclick="Vm.ShowWorkflowDetails">Details</button>
                <button class="dctab @(Vm.IsRunsTab ? "active" : "")" @onclick="Vm.ShowWorkflowRunsAsync">Runs<span class="n">@(Vm.ChainRuns?.Count ?? 0)</span></button>
            </div>
        }

        @{
            var previewStages = Vm.BuildCanvasStageViews();
        <div class="dcslide-body editor-body">

            <div class="field-row">
                <div class="dcfield flex-1">
                    <label>Name <span class="req">*</span></label>
                    <input class="dcinput" @bind="Vm.EdName" placeholder="my-pipeline" />
                </div>
                <div class="dcfield flex-14">
                    <label>Description</label>
                    <input class="dcinput" @bind="Vm.EdDescription" placeholder="What does this workflow produce? (optional)" />
                </div>
            </div>

            <div class="workflow-canvas-preview">
                <div class="workflow-canvas-thumbnail" inert aria-hidden="true">
                    <ChainCanvas Stages="previewStages"
                                 Jobs="@(Vm.Jobs ?? Array.Empty<JobView>())"
                                 Gates="@Vm.BuildCanvasGates()"
                                 ReadOnly="true" />
                </div>
                <button type="button" class="workflow-canvas-open" aria-haspopup="dialog"
                        aria-label="@($"Open workflow canvas, {previewStages.Count} steps")"
                        @onclick='() => Vm.SetEditorView("canvas")'>
                    <span><AppIcon Kind="data.graph" /> Open workflow canvas</span>
                </button>
            </div>

        </div>
        }

        @if (Vm.IsCanvasView || Vm.IsListView || Vm.IsRunsView || Vm.IsSchedulesView || Vm.IsMarkupView)
        {
            <div class="dcmodal-overlay workflow-canvas-overlay">
                <div class="dcmodal workflow-canvas-dialog @(Vm.ShowWorkflowAssistant ? "assistant-open" : null)" role="dialog" aria-modal="true" aria-label="Workflow canvas" @onclick:stopPropagation="true">
                    <div class="dcmodal-head" inert="@Vm.ShowWorkflowAssistant">
                        <div class="flex-min">
                            <div class="title-14">@(string.IsNullOrWhiteSpace(Vm.EdName) ? "New workflow" : Vm.EdName) <span class="workflow-step-count">@Vm.EdStages.Count steps</span></div>
                            <div class="sub-115">@(Vm.IsMarkupView ? "Edit and deploy this workflow as YAML." : Vm.IsCanvasView ? "Drag stages to reorder. Select a step to configure it." : Vm.IsSchedulesView ? "Choose when this workflow runs." : Vm.IsRunsView ? "Execution history, inputs, and job logs." : "Steps run in order. Jobs within a parallel stage run together.")</div>
                        </div>
                        <div class="workflow-canvas-actions">
                            @if (Vm.EditChainId.HasValue && Vm.Chains?.FirstOrDefault(chain => chain.Id == Vm.EditChainId) is { } canvasWorkflow)
                            {
                                <button type="button" class="dcbtn primary workflow-run" title="Run the saved workflow" disabled="@Vm.IsRunningChain(canvasWorkflow.Id)" @onclick="() => Vm.RunChainAsync(canvasWorkflow)"><AppIcon Kind="play" /> @(Vm.IsRunningChain(canvasWorkflow.Id) ? "Running…" : "Run")</button>
                            }
                            @if (!Vm.IsMarkupView)
                            {
                            <button type="button" class="dcbtn" @onclick="() => Vm.OpenStageNodePicker(Vm.EdStages.Count)"><AppIcon Kind="plus" /> Add step</button>
                            @if (Vm.EditChainId.HasValue)
                            {
                                <button type="button" class="dcbtn" title="Save the current canvas and open the workflow editor agent" disabled="@Vm.Saving" @onclick="Vm.OpenWorkflowAssistantAsync"><AppIcon Kind="agent" /> Edit with AI</button>
                            }
                            <details class="workflow-menu">
                                <summary>Workflow actions</summary>
                                <div class="workflow-menu-items">
                                    <button type="button" @onclick="ShowWorkflowDetailsAsync"><AppIcon Kind="edit" /> Details</button>
                                    @if (Vm.EditChainId.HasValue)
                                    {
                                        <button type="button" @onclick="Vm.ShowWorkflowRunsAsync"><AppIcon Kind="logs" /> Runs</button>
                                    }
                                    <button type="button" disabled="@Vm.Saving" @onclick="SaveWorkflowAsync"><AppIcon Kind="save" /> @(Vm.Saving ? "Saving…" : "Save workflow")</button>

                                </div>
                            </details>
                            }
                            <button class="dcslide-x" aria-label="Close canvas" disabled="@Vm.Saving" @onclick="CloseWorkflowAsync"><AppIcon Kind="close" /></button>
                        </div>
                    </div>
                    <nav class="dctabs workflow-view-tabs" aria-label="Workflow view" inert="@(Vm.ShowWorkflowAssistant || Vm.Saving)">
                        <button type="button" class="dctab @(Vm.IsCanvasView ? "active" : null)" aria-pressed="@Vm.IsCanvasView" @onclick='() => SetWorkflowViewAsync("canvas")'>Canvas</button>
                        @if (Vm.EditChainId.HasValue)
                        {
                            <button type="button" class="dctab @(Vm.IsMarkupView ? "active" : null)" aria-pressed="@Vm.IsMarkupView" @onclick='() => SetWorkflowViewAsync("markup")'>Markup</button>
                            <button type="button" class="dctab @(Vm.IsRunsView ? "active" : null)" aria-pressed="@Vm.IsRunsView" @onclick='() => SetWorkflowViewAsync("runs")'>Runs<span class="n">@(Vm.ChainRuns?.Count ?? 0)</span></button>
                            <AuthorizeView Policy="@Permission.TriggersManage">
                                <button type="button" class="dctab @(Vm.IsSchedulesView ? "active" : null)" aria-pressed="@Vm.IsSchedulesView" @onclick='() => SetWorkflowViewAsync("schedules")'>Schedules</button>
                            </AuthorizeView>
                        }
                    </nav>
                    @if (Vm.AssistantWorkflow is { } assistantWorkflow)
                    {
                        <WorkflowEditorAssistant @key="assistantWorkflow.Id" Workflow="assistantWorkflow" Visible="Vm.ShowWorkflowAssistant" OnClose="Vm.CloseWorkflowAssistant" OnChanged="Vm.RefreshAssistantWorkflowAsync" />
                    }
                    @if (Vm.EditorError is { } canvasError)
                    {
                        <p class="workflow-canvas-error" role="alert">@canvasError</p>
                    }
                    <div class="dcmodal-body @(Vm.IsListView || Vm.IsRunsView || Vm.IsSchedulesView || Vm.IsMarkupView ? "workflow-list-body" : null)" inert="@Vm.ShowWorkflowAssistant">
                        @if (Vm.IsMarkupView)
                        {
                            <section class="workflow-markup" aria-label="Workflow YAML">
                                <div class="markup-toolbar">
                                    <p>Deploy validates and saves this definition. Run executes the saved workflow.</p>
                                    <button type="button" class="dcbtn" disabled="@Vm.Saving" title="Replace the YAML draft with the current canvas definition" @onclick="Vm.ReloadMarkup">Reload from canvas</button>
                                    <button type="button" class="dcbtn primary" disabled="@Vm.Saving" @onclick="DeployWorkflowMarkupAsync"><AppIcon Kind="save" /> @(Vm.Saving ? "Deploying…" : "Deploy")</button>
                                </div>
                                @if (Vm.MarkupNotice is not null) { <p class="markup-notice" role="status">@Vm.MarkupNotice</p> }
                                <div class="markup-editor" inert="@Vm.Saving">
                                    <WorkflowInstructionsEditor @key="Vm.MarkupRevision" @ref="_markupEditor" Value="@Vm.MarkupText" Language="yaml" FileName="workflow.yaml" Label="Workflow definition in YAML" />
                                </div>
                            </section>
                        }
                        else if (Vm.IsSchedulesView && Vm.EditChainId is { } scheduledWorkflowId)
                        {
                            <AuthorizeView Policy="@Permission.TriggersManage">
                                <Schedules ProjectId="ProjectId" WorkflowId="scheduledWorkflowId" Embedded="true" />
                            </AuthorizeView>
                        }
                        else if (Vm.IsRunsView)
                        {
                            <div class="dcslide-body runs-body">
                                @if (Vm.RunsAwaitingInput > 0 && Vm.ChainRuns?.FirstOrDefault(run => run.Status == "AwaitingInput") is { } blocked)
                                {
                                    <div class="workflow-input-banner" role="status">
                                        <AppIcon Kind="human" />
                                        <div>
                                            <strong>@Vm.RunsAwaitingInput run@(Vm.RunsAwaitingInput == 1 ? "" : "s") awaiting input</strong>
                                            <p>These workflows are paused. Review the required response to continue.</p>
                                        </div>
                                        <button class="dcbtn primary" @onclick="() => Vm.OpenChainRunAsync(blocked)">Review input</button>
                                    </div>
                                }
                                @if (Vm.ChainRuns is { Count: > 0 })
                                {
                                    <div class="run-health-strip" aria-label="Workflow execution status in recent runs">
                                        <span><strong>@Vm.RunsSucceeded</strong> succeeded</span>
                                        <span class="run-health-attention"><strong>@Vm.RunsAwaitingInput</strong> awaiting input</span>
                                        <span><strong>@Vm.RunsFailedOrPartial</strong> failed or partial</span>
                                    </div>
                                }
                                @if (Vm.OpenRun is null)
                                {
                                    @if (Vm.PendingChainRunId is not null)
                                    {
                                        <div class="workflow-run-queued" role="status">
                                            <span class="spinner" aria-hidden="true"></span>
                                            <div>
                                                <strong>Workflow queued</strong>
                                                <p>The run is being picked up. This view will update automatically.</p>
                                            </div>
                                            <span class="queued-detail">Starting…</span>
                                        </div>
                                    }
                                    @if (Vm.ChainRuns is null or { Count: 0 })
                                    {
                                        @if (Vm.PendingChainRunId is null)
                                        {
                                            <div class="no-runs">No runs yet — click Run to start the pipeline.</div>
                                        }
                                    }
                                    else
                                    {
                                        @foreach (var run in Vm.ChainRuns.OrderByDescending(run => run.Status == "AwaitingInput").ThenByDescending(run => run.StartedAt))
                                        {
                                            <div class="dccard run-card" @onclick="@(() => Vm.OpenChainRunAsync(run))">
                                                <div class="run-row">
                                                    <span class="status-chip" style="color:@Vm.Presentation.StatusColor(run.Status); background:@Vm.Presentation.StatusBackground(run.Status)">@run.Status</span>
                                                    @if (run.Status == "AwaitingInput")
                                                    {
                                                        <span class="run-attention-label"><AppIcon Kind="human" /> Needs input</span>
                                                    }
                                                    <span class="run-time">
                                                        @Vm.Presentation.DateTime(run.StartedAt)
                                                    </span>
                                                    <span class="meta-11">
                                                        @Vm.SucceededSteps(run)/@run.Steps.Count steps
                                                    </span>
                                                    @if (run.FinishedAt.HasValue)
                                                    {
                                                        <span class="dur-meta">
                                                            @Vm.Presentation.Duration(run.StartedAt, run.FinishedAt.Value)
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="running-note">running…</span>
                                                    }
                                                    @if (Vm.IsChainRunActive(run.Status))
                                                    {
                                                        <button class="dcbtn btn-2-8 text-bad" @onclick:stopPropagation="true"
                                                                @onclick="@(() => Vm.CancelChainRunAsync(run.Id))">Cancel</button>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    }
                                }
                                else
                                {
                                    <button class="dcbtn btn-start" @onclick="@(() => Vm.CloseChainRun())"><AppIcon Kind="arrow-left" /> All runs</button>

                                    <div class="status-row">
                                        <span class="status-chip-lg" style="color:@Vm.Presentation.StatusColor(Vm.OpenRun.Status); background:@Vm.Presentation.StatusBackground(Vm.OpenRun.Status)">@Vm.OpenRun.Status</span>
                                        <span class="dur-meta">
                                            @Vm.Presentation.DateTime(Vm.OpenRun.StartedAt)
                                            @(Vm.OpenRun.FinishedAt.HasValue ? " · took " + Vm.Presentation.Duration(Vm.OpenRun.StartedAt, Vm.OpenRun.FinishedAt.Value) : " · live")
                                        </span>
                                        @if (Vm.IsChainRunActive(Vm.OpenRun.Status))
                                        {
                                            <button class="dcbtn btn-2-8 text-bad" @onclick="@(() => Vm.CancelChainRunAsync(Vm.OpenRun.Id))">Cancel run</button>
                                        }
                                    </div>

                                    <ExecutionApprovalPanel @key="Vm.OpenRun.Id" ProjectId="Vm.ProjectId" RunIds="@(new[] { Vm.OpenRun.Id }.Concat(Vm.OpenRun.Steps.Select(s => s.RunId).OfType<Guid>()).ToArray())" />

                                    @if (Vm.OpenRun.InputRequest is { } inputRequest)
                                    {
                                        <section class="workflow-input" aria-label="Required workflow inputs">
                                            @if (Vm.CanResumeAgentAutomatically)
                                            {
                                                <h3>Ready for automatic execution</h3>
                                                <p>This step now has an automatic agent configured. Continue this run using the saved model and instructions.</p>
                                                <button class="dcbtn primary" disabled="@Vm.Resuming" @onclick="Vm.ResumeAgentAutomaticallyAsync">Run agent automatically</button>
                                                @if (Vm.ResumeError is not null) { <p role="alert">@Vm.ResumeError</p> }
                                            }
                                            else
                                            {
                                            <span class="workflow-eyebrow">Workflow paused</span>
                                            <h3>@(inputRequest.Kind == LoopChainAction.HumanType ? inputRequest.Instructions ?? "Your response is needed" : inputRequest.Kind is LoopChainAction.AgentType or LoopChainAction.TaskType ? "Waiting for an agent response" : "Input required")</h3>
                                            @if (inputRequest.Instructions is not null)
                                            {
                                                @if (inputRequest.Kind != LoopChainAction.HumanType) { <p class="loop-instructions">@inputRequest.Instructions</p> }
                                                <p class="sub-note">Review the accumulated context below, then submit a response to continue.</p>
                                            }
                                            else
                                            {
                                                <p>Complete the required fields to continue from this stage.</p>
                                            }
                                            @if (inputRequest.ResponseType == LoopChainAction.YesNoResponse)
                                            {
                                                <p class="sub-note">Review the evidence and downstream steps before responding. A No answer follows the configured No branch; it does not automatically cancel execution.</p>
                                            }
                                            else
                                            {
                                            @foreach (var step in inputRequest.Steps)
                                            {
                                                <h4>@step.JobName</h4>
                                                @foreach (var field in step.Parameters)
                                                {
                                                    <div class="dcfield">
                                                        @if (inputRequest.Kind is LoopChainAction.HumanType or LoopChainAction.AgentType or LoopChainAction.TaskType)
                                                        {
                                                            <label for="loop-response">Response <span class="req">*</span></label>
                                                            <textarea id="loop-response" class="dcinput" rows="5" required
                                                                      value="@Vm.GetResumeArg(step.Index, field.Name)"
                                                                      @oninput="@(e => Vm.SetResumeArg(step.Index, field.Name, e.Value?.ToString() ?? ""))"></textarea>
                                                            <span class="sub-note">Saved as <code>@field.Name</code> for the next steps.</span>
                                                        }
                                                        else
                                                        {
                                                        <label>@(field.Label ?? field.Name) @(field.Required ? "*" : "")</label>
                                                        <ParamInput Parameter="field" ProjectId="@ProjectId" Value="@Vm.GetResumeArg(step.Index, field.Name)"
                                                                    ValueChanged="@(value => Vm.SetResumeArg(step.Index, field.Name, value))" />
                                                        }
                                                    </div>
                                                }
                                            }
                                            }
                                            @if (Vm.ResumeError is not null) { <p role="alert">@Vm.ResumeError</p> }
                                            @if (inputRequest.ResponseType == LoopChainAction.YesNoResponse)
                                            {
                                                <div class="human-decision-actions" aria-label="Answer the question">
                                                    <button class="dcbtn primary" disabled="@Vm.Resuming" @onclick="() => Vm.RequestHumanAnswer(true)"><AppIcon Kind="check" /> Yes</button>
                                                    <button class="dcbtn" disabled="@Vm.Resuming" @onclick="() => Vm.RequestHumanAnswer(false)"><AppIcon Kind="close" /> No</button>
                                                    @if (Vm.Resuming) { <span role="status">Resuming…</span> }
                                                </div>
                                            }
                                            else
                                            {
                                                <button class="dcbtn primary" disabled="@Vm.Resuming" @onclick="Vm.ResumeWithInputsAsync">@(Vm.Resuming ? "Resuming…" : "Submit and continue")</button>
                                            }
                                            }
                                        </section>
                                    }

                                    <div class="running-steps-panel">
                                        <div class="running-steps-head">
                                            <span>Running steps</span>
                                            <span>@Vm.SucceededSteps(Vm.OpenRun)/@Vm.OpenRun.Steps.Count complete</span>
                                        </div>
                                    <ChainPipeline Run="Vm.OpenRun" OnStepClick="OpenExecutionStepAsync" InspectActions="true"
                                                   OnStepCancel="@(step => Vm.CancelStepRunAsync(step.RunId!.Value))" />
                                    </div>

                                    @if (Vm.ContextRows.Count > 0)
                                    {
                                        <details class="chain-context-panel run-detail-fold">
                                            <summary>Accumulated workflow context</summary>
                                            <div class="chain-context-scroll">
                                                <table class="chain-context-table">
                                                    <thead>
                                                        <tr>
                                                            <th class="chain-context-cell chain-context-path">Field</th>
                                                            <th class="chain-context-cell">Value</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var row in Vm.ContextRows)
                                                        {
                                                            var isJson = IsJsonLike(row.Value);
                                                            <tr>
                                                                <td class="chain-context-cell chain-context-path"><code>@row.Path</code></td>
                                                                <td class="chain-context-cell">
                                                                    @if (isJson)
                                                                    {
                                                                        <button class="dcbtn btn-2-8 json-view-button"
                                                                                @onclick="@(() => OpenChainContextJson(row.Path, row.Value))">
                                                                            View JSON
                                                                        </button>
                                                                        <span class="chain-context-preview">@GetJsonPreview(row.Value)</span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <code class="chain-context-value">@row.Value</code>
                                                                    }
                                                                </td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </details>
                                    }

                                    @if (Vm.OpenRun.FinalOutput is { Length: > 0 })
                                    {
                                        <div>
                                            <div class="out-label">Pipeline output</div>
                                            <RunOutput Value="@(Vm.Presentation.Json(Vm.OpenRun.FinalOutput))" />
                                        </div>
                                    }

                                }
                            </div>
                        }
                        @if (Vm.IsCanvasView)
                        {
                        <ChainCanvas OnEditCode="OpenCodeAsync" Stages="Vm.BuildCanvasStageViews()"
                                     Jobs="@(Vm.Jobs ?? Array.Empty<JobView>())"
                                     Gates="@Vm.BuildCanvasGates()"
                                     OnAddGate="@(stageIndex => Vm.OpenStageNodePicker(stageIndex))"
                                     OnEditGate="@(pair => Vm.OpenGateEditor(pair.StageIndex))"
                                     OnRemoveGate="Vm.RemoveGate"
                                     OnEditPolicy="Vm.OpenStepPolicy"
                                     OnEditEmailAction="@(stageIndex => Vm.OpenEmailActionEditor(stageIndex))"
                                     OnEditSmsAction="@(stageIndex => Vm.OpenSmsActionEditor(stageIndex))"
                                     OnEditLoopAction="@(stageIndex => Vm.EditLoopAction(stageIndex))" OnEditRepeatAction="@(index => Vm.OpenRepeatAction(index))" OnEditScoringAction="@(index => Vm.OpenScoringAction(index, true))" OnEditQueryDataAction="@(index => Vm.OpenQueryDataAction(index, true))" OnEditSubWorkflowAction="@(index => Vm.OpenSubWorkflowAction(index, true))" OnEditParallelWorkflowAction="@(index => Vm.OpenParallelWorkflowAction(index, true))"
                                     OnEditContainerAction="Vm.EditContainerAction" OnEditQemuAction="Vm.EditQemuAction"
                                     OnAddPath="@(item => Vm.AddPath(item.StageIndex, item.JobId))"
                                     OnMoveStage="@(move => Vm.MoveStageTo(move.SourceIndex, move.TargetIndex))"
                                     OnMovePath="@(move => Vm.MovePath(move.SourceStage, move.SourceBranch, move.TargetStage))"
                                     OnRemovePath="@(item => Vm.RemoveBranch(item.StageIndex, item.BranchIndex))"
                                     OnRemoveStage="@(stageIndex => Vm.RemoveStage(stageIndex))" />
                        }
                        @if (Vm.IsListView)
                        {
                            var canvasStages = Vm.BuildCanvasStageViews();
                            <section class="workflow-list" aria-label="Workflow stages">
                                @if (Vm.EdStages.Count == 0)
                                {
                                    <div class="empty-steps">Your workflow starts here. Add a job, an action, or a review step.</div>
                                }
                                else
                                {
                                    <ol class="step-list">
                                        @foreach (var (stage, i) in Vm.EdStages.Select((s, i) => (s, i)))
                                        {
                                            var stageIndex = i;
                                            var stageView = canvasStages[stageIndex];
                                            var stageGate = Vm.EdStageGates.GetValueOrDefault(stageIndex);
                                            <li class="stage-item">
                                                <div class="list-stage-head">
                                                    <span class="step-num">@(stageIndex + 1)</span>
                                                    <AppIcon Kind="@ChainCanvasViewModel.StageIcon(stageView)" />
                                                    <strong>@(stageView.Action?.DisplayName ?? (stage.Count > 1 ? "Parallel jobs" : "Job"))</strong>
                                                    @if (stage.Count > 1) { <span class="list-stage-count">@stage.Count jobs</span> }
                                                    <div class="list-stage-actions">
                                                        <button aria-label="@($"Move step {stageIndex + 1} up")" title="Move up" class="dcbtn" disabled="@(stageIndex == 0)" @onclick="@(() => Vm.MoveStage(stageIndex, -1))"><AppIcon Kind="arrow-up" /></button>
                                                        <button aria-label="@($"Move step {stageIndex + 1} down")" title="Move down" class="dcbtn" disabled="@(stageIndex == Vm.EdStages.Count - 1)" @onclick="@(() => Vm.MoveStage(stageIndex, +1))"><AppIcon Kind="arrow-down" /></button>
                                                        <button aria-label="@($"Remove step {stageIndex + 1}")" title="Remove step" class="dcbtn danger" @onclick="@(() => Vm.RemoveStage(stageIndex))"><AppIcon Kind="close" /></button>
                                                    </div>
                                                </div>
                                                <div class="list-stage-body">
                                                    @if (stageGate is not null)
                                                    {
                                                        <div class="list-stage-gate">
                                                            <button class="dcbtn" @onclick="@(() => Vm.OpenGateEditor(stageIndex))">
                                                                <AppIcon Kind="@(stageGate is WaitGate ? "clock" : "split")" />
                                                                <span>@(stageGate is WaitGate wait ? $"Wait {wait.Duration.TotalSeconds:0.#} seconds" : stageGate is ConditionGate condition ? condition.ReviewQuestion is { } question ? $"Determine · {question}" : $"If {condition.Expression}" : "Edit gate")</span>
                                                            </button>
                                                            <button class="dcbtn danger" aria-label="@($"Remove gate from step {stageIndex + 1}")" title="Remove gate" @onclick="@(() => Vm.RemoveGate(stageIndex))"><AppIcon Kind="close" /></button>
                                                        </div>
                                                    }
                                                    <div class="stage-jobs">
                                                        @if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is SendEmailChainAction emailAction)
                                                        {
                                                            <button class="stage-job-chip" @onclick="@(() => Vm.OpenEmailActionEditor(stageIndex))"><AppIcon Kind="mail" /><span><strong>Send email</strong><small>@emailAction.Recipient</small></span><span class="list-configure">Edit</span></button>
                                                        }
                                                        else if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is SendSmsChainAction smsAction)
                                                        {
                                                            <button class="stage-job-chip" @onclick="@(() => Vm.OpenSmsActionEditor(stageIndex))"><AppIcon Kind="message" /><span><strong>Send SMS</strong><small>@smsAction.Recipient</small></span><span class="list-configure">Edit</span></button>
                                                        }
                                                        else if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is ContainerBuildChainAction or ContainerRunChainAction)
                                                        {
                                                            <button class="stage-job-chip" @onclick="@(() => Vm.EditContainerAction(stageIndex))"><span><strong>@Vm.EdStageActions[stageIndex]!.DisplayName</strong></span><span class="list-configure">Edit</span></button>
                                                        }
                                                        else if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is VirtualMachineChainAction vmAction)
                                                        {
                                                            <button class="stage-job-chip" @onclick="@(() => Vm.EditQemuAction(stageIndex))"><AppIcon Kind="vm" /><span><strong>@vmAction.ImageProfile</strong><small>@vmAction.MemoryMb MiB · @vmAction.Cpus CPU(s) · @vmAction.TimeoutSeconds s timeout</small></span><span class="list-configure">Configure</span></button>
                                                        }
                                                        else if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is ParallelWorkflowsChainAction parallel)
                                                        {
                                                            <button class="stage-job-chip" @onclick="@(() => Vm.OpenParallelWorkflowAction(stageIndex, true))"><span><strong>Parallel if gates</strong><small>@parallel.Branches.Count conditional workflows · join results</small></span><span class="list-configure">Edit</span></button>
                                                        }
                                                        else if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is SubWorkflowChainAction child)
                                                        {
                                                            <button class="stage-job-chip" @onclick="@(() => Vm.OpenSubWorkflowAction(stageIndex, true))"><span><strong>@child.WorkflowName</strong><small>Run sub-workflow</small></span><span class="list-configure">Edit</span></button>
                                                        }
                                                        else if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is QueryDataChainAction queryAction)
                                                        {
                                                            <button class="stage-job-chip" @onclick="@(() => Vm.OpenQueryDataAction(stageIndex, true))"><span><strong>Query data</strong><small>Rows saved to @(queryAction.OutputField).rows</small></span><span class="list-configure">Edit</span></button>
                                                        }
                                                        else if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is ScoringGateChainAction scoreAction)
                                                        {
                                                            <button class="stage-job-chip" @onclick="@(() => Vm.OpenScoringAction(stageIndex, true))"><span><strong>Scoring gate</strong><small>@scoreAction.InputField · ≥ @scoreAction.PassScore/100</small></span><span class="list-configure">Edit</span></button>
                                                        }
                                                        else if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is RepeatFlowChainAction repeatAction)
                                                        {
                                                            <button class="stage-job-chip" @onclick="@(() => Vm.OpenRepeatAction(stageIndex))"><span><strong>Repeat flow</strong><small>Up to @repeatAction.MaxAttempts attempts</small></span><span class="list-configure">Edit</span></button>
                                                        }
                                                        else if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is LoopChainAction loopAction)
                                                        {
                                                            <button class="stage-job-chip" @onclick="@(() => Vm.EditLoopAction(stageIndex))"><AppIcon Kind="@(loopAction.Type == LoopChainAction.HumanType ? "human" : "agent")" /><span><strong>@loopAction.DisplayName</strong><small>Response saved to @loopAction.ResponseField</small></span><span class="list-configure">Edit</span></button>
                                                        }
                                                        @foreach (var (jobId, j) in stage.Select((id, j) => (id, j)))
                                                        {
                                                            var branchIndex = j;
                                                            <div class="stage-job-chip"><AppIcon Kind="code" /><span class="list-job-name">@Vm.JobName(jobId)</span><JobCodeLink Job="@Vm.Jobs?.FirstOrDefault(job => job.Id == jobId)" OnEdit="OpenCodeAsync" /><button class="dcbtn danger" aria-label="@($"Remove {Vm.JobName(jobId)} from step {stageIndex + 1}")" title="Remove job" @onclick="@(() => Vm.RemoveBranch(stageIndex, branchIndex))"><AppIcon Kind="close" /></button></div>
                                                        }
                                                    </div>
                                                    @if (stageGate is ConditionGate { ElseBranch: { Count: > 0 } other })
                                                    {
                                                        <div class="list-false-path"><strong>When false</strong><WorkflowBranchPreview Jobs="@(Vm.Jobs ?? Array.Empty<JobView>())" Stages="@other.Select(Vm.BuildStageView).ToList()" /><button class="dcbtn" @onclick="@(() => Vm.OpenGateEditor(stageIndex))">Edit false path</button></div>
                                                    }
                                                    @if (!Vm.HasStageAction(stageIndex))
                                                    {
                                                        <div class="stage-branch-row">
                                                            <select class="dcinput branch-select" aria-label="@($"Parallel job for step {stageIndex + 1}")" value="@Vm.EdBranchJobIds.GetValueOrDefault(stageIndex, "")" @onchange="@((e) => Vm.SetBranchJobId(stageIndex, e))">
                                                                <option value="">Choose a parallel job…</option>
                                                                @foreach (var job in Vm.Jobs ?? Array.Empty<JobView>()) { <option value="@job.Id">@job.Name</option> }
                                                            </select>
                                                            <button class="dcbtn" disabled="@(string.IsNullOrEmpty(Vm.EdBranchJobIds.GetValueOrDefault(stageIndex, "")))" @onclick="@(() => Vm.AddBranch(stageIndex))"><AppIcon Kind="plus" /> Add parallel job</button>
                                                        </div>
                                                    }
                                                    <div class="list-stage-footer">
                                                        @if (stageGate is null) { <button class="dcbtn" @onclick="@(() => Vm.OpenGateEditor(stageIndex))"><AppIcon Kind="split" /> Add condition or delay</button> }
                                                        <button class="dcbtn" @onclick="@(() => Vm.OpenStageNodePicker(stageIndex))"><AppIcon Kind="plus" /> Insert step before</button>
                                                    </div>
                                                </div>
                                            </li>
                                        }
                                    </ol>
                                }
                            </section>
                        }
                    </div>
                    @if (_codeJob is { } codeJob)
                    {
                        <WorkflowCodeWindow @ref="_codeWindow" Job="codeJob" OnClose="() => _codeJob = null" />
                    }
                </div>
            </div>
        }

        @if (Vm.ShowEditor && Vm.IsRunsView && Vm.ExecutionStep is { } executionStep)
        {
            <div class="dcmodal-overlay execution-overlay" @onclick="Vm.CloseExecutionStep"
                 @onkeydown="@(e => { if (e.Key == "Escape") Vm.CloseExecutionStep(); })">
                <div class="dcmodal execution-modal" role="dialog" aria-modal="true" aria-labelledby="execution-title" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><WorkflowDialogHandle Icon="code" />
                        <div class="execution-heading">
                            <span class="workflow-eyebrow">Step @(executionStep.Index + 1) · Execution details</span>
                            <h3 id="execution-title">@executionStep.JobName</h3>
                            <div class="execution-meta">
                                <span class="status-chip" style="color:@Vm.Presentation.StatusColor(executionStep.Status); background:@Vm.Presentation.StatusBackground(executionStep.Status)">@executionStep.Status</span>
                                @if (executionStep.Provider is { } provider) { <span>@provider</span> }
                                @if (executionStep.StartedAt is { } started) { <span>@Vm.Presentation.DateTime(started)</span> }
                            </div>
                        </div>
                        <button @ref="_executionClose" type="button" aria-label="Close execution details" class="dcslide-x" @onclick="Vm.CloseExecutionStep"><AppIcon Kind="close" /></button>
                    </div>
                    <nav class="execution-tabs" aria-label="Execution output">
                        @if (executionStep.ActionType is LoopChainAction.TaskType or LoopChainAction.AgentType || executionStep.AgentActivity is { Count: > 0 })
                        {
                            <button type="button" aria-pressed="@(_executionTab == "activity" ? "true" : "false")" @onclick='() => _executionTab = "activity"'>Agent activity <span>@(executionStep.AgentActivity?.Count ?? 0)</span></button>
                        }
                        <button type="button" aria-pressed="@(_executionTab == "logs" ? "true" : "false")" @onclick='() => _executionTab = "logs"'>Job logs <span>@Vm.ExecutionLogSteps.Count</span></button>
                    </nav>
                    <div class="dcmodal-body execution-body">
                        <SubWorkflowRunLink ProjectId="Vm.ProjectId" Step="executionStep" />
                        @if (_executionTab == "activity")
                        {
                        @if (executionStep.ActionType is LoopChainAction.TaskType or LoopChainAction.AgentType || executionStep.AgentActivity is { Count: > 0 })
                        {
                            <WorkflowAgentActivity @key="(Vm.OpenRun!.Id, executionStep.Index)" Step="executionStep" OnRunClick="OpenExecutionLogsAsync" />
                        }
                        }
                        else
                        {
                        @if (executionStep.Error is not null)
                        {
                            <p class="execution-error" role="alert">@executionStep.Error</p>
                        }
                        <section class="workflow-job-logs" aria-label="Step job logs">
                            <div class="job-log-selector">
                                <div><span class="console-stream">stdout / stderr</span></div>
                                @if (Vm.ExecutionLogSteps.Count > 1)
                                {
                                    <label for="chain-log-job">Job run</label>
                                    <select id="chain-log-job" class="dcinput" value="@Vm.SelectedStepRunId" @onchange="@(e => Vm.SelectLogStepAsync(e.Value?.ToString()))">
                                        @foreach (var step in Vm.ExecutionLogSteps)
                                        {
                                            <option value="@step.RunId">@step.RunId?.ToString()[..8] · @step.Status</option>
                                        }
                                    </select>
                                }
                            </div>
                            @if (Vm.StepOutputError is not null) { <p class="execution-error" role="alert">@Vm.StepOutputError</p> }
                            @if (Vm.StepRunDetail is { } loggedRun && Vm.ExecutionLogSteps.Any(step => step.RunId == loggedRun.Id))
                            {
                                <JobRunLogs @key="loggedRun.Id" Run="loggedRun" />
                            }
                            else
                            {
                                <div class="execution-empty">
                                    <AppIcon Kind="code" />
                                    <strong>@(Vm.SelectedStepRunId.HasValue ? "Waiting for job output" : "No job logs yet")</strong>
                                    <p>@(executionStep.Status == "Running" ? "Activity and job output update here automatically while this step runs." : "This step has no recorded job output. Check the Agent activity tab for recorded agent messages, when available.")</p>
                                </div>
                            }
                        </section>
                        }
                    </div>
                    <div class="dcmodal-foot execution-footer">
                        <span>@(executionStep.Status == "Running" ? "Live updates · refreshes automatically" : "Saved execution details")</span>
                        @if (Vm.OpenRun is { } activeRun && Vm.IsChainRunActive(activeRun.Status))
                        {
                            <button type="button" class="dcbtn text-bad" @onclick="() => Vm.CancelChainRunAsync(activeRun.Id)">Cancel workflow</button>
                        }
                    </div>
                </div>
            </div>
        }

        @* ── Unified connector step picker ─────────────────────────────────────────────── *@
        @if (Vm.ShowStageNodePicker)
        {
            <div class="dcmodal-overlay" @onclick="() => Vm.CloseStageNodePicker()">
                <div class="dcmodal pipeline-step-modal" role="dialog" aria-modal="true" aria-labelledby="pipeline-step-title" aria-describedby="pipeline-step-description" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><WorkflowDialogHandle Icon="plus" />
                        <div>
                            <h3 id="pipeline-step-title">Add pipeline step</h3>
                            <p id="pipeline-step-description" class="sub-115">@(Vm.StageNodePickerIndex >= Vm.EdStages.Count ? "Choose what happens next in your workflow." : $"Choose a step to insert before stage {Vm.StageNodePickerIndex + 1}.")</p>
                        </div>
                        <button class="dcslide-x" aria-label="Close add pipeline step"
                                @onclick="() => Vm.CloseStageNodePicker()"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body pipeline-step-body">
                        @if (!Vm.JevAvailable)
                        { <p class="field-hint" role="status">@JobChainsViewModel.JevSetupMessage Determine gates, scoring and browser workspaces require Jev.</p> }
                        <section class="step-picker-section" aria-labelledby="step-picker-agents">
                        <h4 id="step-picker-agents">Agents &amp; review</h4>
                        <div class="node-picker-grid">
                            <button class="node-picker-tile human-step" @onclick="@(() => Vm.ChooseStageNode(LoopChainAction.HumanType))">
                                <span class="node-picker-icon" aria-hidden="true"><AppIcon Kind="human" /></span>
                                <strong>Human in the loop</strong><small>Pause for a person to review and respond</small>
                            </button>
                            <button class="node-picker-tile agent-step" @onclick="@(() => Vm.ChooseStageNode(LoopChainAction.AgentType))">
                                <span class="node-picker-icon" aria-hidden="true"><AppIcon Kind="agent" /></span>
                                <strong>Agent review</strong><small>Review previous results before continuing</small>
                            </button>
                        <button class="node-picker-tile agent-step" @onclick="@(() => Vm.ChooseStageNode(LoopChainAction.TaskType))">
                            <span class="node-picker-icon" aria-hidden="true"><AppIcon Kind="agent" /></span>
                            <strong>Agent task</strong><small>Ask an AI agent to complete a task</small>
                        </button>
                        <button class="node-picker-tile" @onclick="@(() => Vm.ChooseStageNode(ContainerBuildChainAction.ActionType))"><span class="node-picker-icon"><AppIcon Kind="code" /></span><strong>Build container</strong><small>Build an image from a Dockerfile and workflow files</small></button>
                        <button class="node-picker-tile" @onclick="@(() => Vm.ChooseStageNode(ContainerRunChainAction.ActionType))"><span class="node-picker-icon"><AppIcon Kind="code" /></span><strong>Run container</strong><small>Run a built or pulled image in a sandbox</small></button>
                        <button class="node-picker-tile" disabled="@(!Vm.JevAvailable)" title="@(!Vm.JevAvailable ? JobChainsViewModel.JevSetupMessage : null)" @onclick="@(() => Vm.ChooseStageNode(VirtualMachineChainAction.ActionType))">
                            <span class="node-picker-icon" aria-hidden="true"><AppIcon Kind="vm" /></span>
                            <strong>Browser workspace</strong><small>Work in a secure, disposable browser desktop</small>
                        </button>
                        </div>
                        </section>
                        <section class="step-picker-section" aria-labelledby="step-picker-control">
                        <h4 id="step-picker-control">Data &amp; flow control</h4>
                        <div class="node-picker-grid">
                        <button class="node-picker-tile" @onclick="@(() => Vm.ChooseStageNode(ParallelWorkflowsChainAction.ActionType))"><span class="node-picker-icon"><AppIcon Kind="parallel" /></span><strong>Parallel if gates</strong><small>Run every matching sub-workflow, then join</small></button>
                        <button class="node-picker-tile" @onclick="@(() => Vm.ChooseStageNode(SubWorkflowChainAction.ActionType))"><span class="node-picker-icon"><AppIcon Kind="workflow" /></span><strong>Sub-workflow</strong><small>Run a reusable agent workflow</small></button>
                        <button class="node-picker-tile" @onclick="@(() => Vm.ChooseStageNode(QueryDataChainAction.ActionType))">
                            <span class="node-picker-icon" aria-hidden="true"><AppIcon Kind="data" /></span>
                            <strong>Query data</strong><small>Read project tables for the next step</small>
                        </button>
                        <button class="node-picker-tile" disabled="@(!Vm.JevAvailable)" title="@(!Vm.JevAvailable ? JobChainsViewModel.JevSetupMessage : null)" @onclick="@(() => Vm.ChooseStageNode(ScoringGateChainAction.ActionType))">
                            <span class="node-picker-icon" aria-hidden="true"><AppIcon Kind="check" /></span>
                            <strong>Scoring gate</strong><small>Check evidence against quality thresholds</small>
                        </button>
                        <button class="node-picker-tile" disabled="@(!Vm.JevAvailable)" title="@(!Vm.JevAvailable ? JobChainsViewModel.JevSetupMessage : null)" @onclick="Vm.ChooseAutomaticGateNode">
                            <span class="node-picker-icon" aria-hidden="true"><AppIcon Kind="split" /></span>
                            <strong>Determine</strong><small>Evaluate evidence and choose the True or False path</small>
                        </button>
                        <button class="node-picker-tile" @onclick="Vm.ChooseConditionNode">
                            <span class="node-picker-icon" aria-hidden="true"><AppIcon Kind="split" /></span>
                            <strong>Condition</strong><small>Branch based on the workflow data</small>
                        </button>
                        <button class="node-picker-tile" @onclick="@(() => Vm.ChooseStageNode(RepeatFlowChainAction.ActionType))">
                            <span class="node-picker-icon" aria-hidden="true"><AppIcon Kind="chain" /></span>
                            <strong>Repeat flow</strong><small>Repeat steps until a quality condition passes</small>
                        </button>
                        <button class="node-picker-tile" @onclick="Vm.ChooseWaitNode">
                            <span class="node-picker-icon" aria-hidden="true"><AppIcon Kind="clock" /></span>
                            <strong>Delay / gate</strong><small>Wait before continuing to the next stage</small>
                        </button>
                        </div>
                        </section>
                        <section class="step-picker-section" aria-labelledby="step-picker-messages">
                        <h4 id="step-picker-messages">Communications</h4>
                        <div class="node-picker-grid">
                        <button class="node-picker-tile" disabled="@(!Vm.CanSendEmailAction)" title="@(!Vm.CanSendEmailAction ? "Requires permission to send email" : null)" @onclick="@(() => Vm.ChooseStageNode("email"))">
                            <span class="node-picker-icon" aria-hidden="true"><AppIcon Kind="mail" /></span>
                            <strong>Send email</strong><small>Email through workspace communications</small>
                        </button>
                        <button class="node-picker-tile" disabled="@(!Vm.CanSendSmsAction)" title="@(!Vm.CanSendSmsAction ? "Requires permission to send SMS" : null)" @onclick="@(() => Vm.ChooseStageNode("sms"))">
                            <span class="node-picker-icon" aria-hidden="true"><AppIcon Kind="message" /></span>
                            <strong>Send SMS</strong><small>Send a text message from your workspace</small>
                        </button>
                        </div>
                        </section>
                        <section class="step-picker-section" aria-labelledby="step-picker-jobs">
                        <h4 id="step-picker-jobs">Reusable jobs <span>@(Vm.Jobs?.Count ?? 0)</span></h4>
                        <div class="job-picker-grid">
                            @foreach (var job in Vm.Jobs ?? Array.Empty<JobView>())
                            {
                                <button class="job-picker-tile" @onclick="@(() => Vm.ChooseStageJob(job.Id))">
                                    <span class="node-picker-icon" aria-hidden="true"><AppIcon Kind="code" /></span>
                                    <span>
                                        <strong>@job.Name</strong>
                                        <small>@(string.IsNullOrWhiteSpace(job.Description) ? "Reusable job" : job.Description)</small>
                                    </span>
                                </button>
                            }
                        </div>
                        @if (Vm.Jobs is null or { Count: 0 })
                        {
                            <div class="job-picker-empty">No jobs yet. Create a job before adding it to a workflow.</div>
                        }
                        </section>
                    </div>
                </div>
            </div>
        }

        @if (Vm.ShowContainerEditor)
        {
            <div class="dcmodal-overlay" @onclick="Vm.CloseContainerEditor">
                <div class="dcmodal qemu-modal" role="dialog" aria-modal="true" aria-labelledby="container-title" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><WorkflowDialogHandle />
                        <div><span class="workflow-eyebrow">Workflow step</span><h3 id="container-title">@(Vm.ContainerBuild ? "Build container" : "Run container")</h3><p class="sub-note">@(Vm.ContainerBuild ? "Build an image for later workflow steps." : "Run an image in a disposable sandbox.")</p></div>
                        <button class="dcslide-x" aria-label="Close container settings" @onclick="Vm.CloseContainerEditor"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body">
                        <section class="qemu-section" aria-labelledby="container-source-title">
                        <h4 id="container-source-title">@(Vm.ContainerBuild ? "Build instructions" : "Image & command")</h4>
                        @if (Vm.ContainerBuild)
                        {
                            <div class="dcfield"><label for="container-dockerfile">Dockerfile</label><textarea id="container-dockerfile" class="dcinput" rows="10" maxlength="65536" @bind="Vm.ContainerDockerfile"></textarea></div>
                        }
                        else
                        {
                            <div class="dcfield"><label for="container-image">Container image (optional)</label><input id="container-image" class="dcinput" placeholder="python:3.13-alpine" @bind="Vm.ContainerImage" /><small>Leave blank to use the workflow’s built image.</small></div>
                            <div class="dcfield"><label for="container-command">Command arguments (optional)</label><textarea id="container-command" class="dcinput" rows="3" @bind="Vm.ContainerCommand"></textarea><small>One argument per line. Leave blank to use the image's default command.</small></div>
                            <label class="qemu-network"><span><strong>Keep web app running for later steps</strong><small>Stops when the workflow exits, pauses, or reaches the time limit.</small></span><input type="checkbox" role="switch" @bind="Vm.ContainerWeb" /></label>
                            @if (Vm.ContainerWeb)
                            {
                                <div class="dcfield"><label for="container-port">App port</label><input id="container-port" class="dcinput" type="number" min="1024" max="65535" @bind="Vm.ContainerPort" /><small>Listen on 0.0.0.0. In the next Browser workspace step, enable network access and ask the agent to test @(Vm.ContainerOutputField).qemuUrl from the workflow context.</small></div>
                            }
                            <p class="sub-note">Runs as a non-root user with a read-only filesystem and writable /tmp.</p>
                        }
                        </section>
                        <section class="qemu-section" aria-labelledby="container-resources-title">
                            <h4 id="container-resources-title">Resources &amp; limits</h4>
                            <div class="qemu-resource-grid">
                                @if (!Vm.ContainerBuild)
                                {
                                    <div class="dcfield"><label for="container-memory">Memory <span>MiB</span></label><input id="container-memory" class="dcinput" type="number" min="64" max="8192" @bind="Vm.ContainerMemory" /></div>
                                    <div class="dcfield"><label for="container-cpus">CPUs</label><input id="container-cpus" class="dcinput" type="number" min="1" max="8" @bind="Vm.ContainerCpus" /></div>
                                }
                                <div class="dcfield"><label for="container-timeout">@(Vm.ContainerWeb && !Vm.ContainerBuild ? "Maximum lifetime" : "Timeout") <span>seconds</span></label><input id="container-timeout" class="dcinput" type="number" min="10" max="3600" @bind="Vm.ContainerTimeout" /></div>
                            </div>
                            <label class="qemu-network"><span><strong>Allow outbound network access</strong><small>@(Vm.ContainerBuild ? "Allow build commands to download dependencies. Base images can always be pulled." : "Allow the running container to reach external services. Image pulling is separate.")</small></span><input type="checkbox" role="switch" @bind="Vm.ContainerNetwork" /></label>
                        </section>
                        <section class="qemu-section" aria-labelledby="container-result-title">
                        <h4 id="container-result-title">Result</h4>
                        <div class="dcfield"><label for="container-output">Save result to</label><input id="container-output" class="dcinput" maxlength="80" @bind="Vm.ContainerOutputField" /><small>@(Vm.ContainerBuild ? "The next Run container step reads the image reference from this result." : "Contains the exit code, output, errors, and web URLs when applicable.")</small></div>
                        </section>
                        <p class="sub-note">Apply step keeps this edit in the draft. Save workflow saves all current workflow changes.</p>
                        @if (Vm.ContainerError is not null) { <p class="qemu-error" role="alert">@Vm.ContainerError</p> }
                    </div>
                    <div class="dcmodal-foot"><button class="dcbtn" @onclick="Vm.CloseContainerEditor">Cancel</button><button class="dcbtn primary" @onclick="Vm.SaveContainerAction">Apply step</button></div>
                </div>
            </div>
        }

        @if (Vm.ShowQemuEditor)
        {
            var imageAvailable = Vm.QemuEnvironment.Images.Any(image => image.Name == Vm.VirtualMachineImageProfile && image.Available);
            var environmentReady = Vm.QemuEnvironment.Enabled && Vm.QemuEnvironment.AgentReady && imageAvailable;
            <div class="dcmodal-overlay" @onclick="Vm.CloseQemuEditor">
                <div class="dcmodal qemu-modal" role="dialog" aria-modal="true" aria-labelledby="qemu-editor-title" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><WorkflowDialogHandle />
                        <span class="qemu-heading-icon"><AppIcon Kind="vm" /></span>
                        <div><span class="workflow-eyebrow">Workflow step</span><h3 id="qemu-editor-title">Browser workspace</h3><p class="sub-note">Give an agent a task in a secure, disposable desktop.</p></div>
                        <button class="dcslide-x" aria-label="Close browser workspace settings" @onclick="Vm.CloseQemuEditor"><AppIcon Kind="close" /></button>
                    </div>
                    <nav class="dctabs workflow-view-tabs qemu-editor-tabs" aria-label="Browser workspace settings">
                        <button type="button" class="dctab @(Vm.QemuEditorTab == "task" ? "active" : null)" aria-pressed="@(Vm.QemuEditorTab == "task")" @onclick='() => Vm.SetQemuEditorTab("task")'>Task</button>
                        <button type="button" class="dctab @(Vm.QemuEditorTab == "settings" ? "active" : null)" aria-pressed="@(Vm.QemuEditorTab == "settings")" @onclick='() => Vm.SetQemuEditorTab("settings")'>Settings</button>
                    </nav>
                    <div class="dcmodal-body">
                    @if (Vm.QemuEditorTab == "task")
                    {
                        <section class="qemu-section" aria-labelledby="qemu-task-title">
                            <h4 id="qemu-task-title">Task</h4>
                            <div class="dcfield"><label for="qemu-command">What should the agent do?</label><div class="qemu-command-editor"><WorkflowInstructionsEditor @ref="_qemuCommandEditor" Value="@Vm.QemuCommand" Label="Browser workspace task instructions" /></div><small id="qemu-task-help">Include a starting URL, the actions to take, and how to verify the result. The agent also receives the workflow context.</small></div>
                        </section>
                    }
                    else
                    {
                        <section class="qemu-section" aria-labelledby="qemu-environment-title">
                            <h4 id="qemu-environment-title">Environment</h4>
                            <div class="dcfield"><label for="qemu-image">Image profile</label><input id="qemu-image" class="dcinput" list="qemu-profiles" maxlength="80" placeholder="browser-linux" @bind="Vm.VirtualMachineImageProfile" @bind:event="oninput" /><datalist id="qemu-profiles">@foreach (var profile in Vm.QemuEnvironment.Images.Where(image => image.Available)) { <option value="@profile.Name" /> }</datalist><small>Choose a Linux desktop profile available on your execution hosts.</small></div>
                            <div class="qemu-readiness" role="status">
                                <span class="qemu-status @(environmentReady ? "ready" : "")"><AppIcon Kind="@(environmentReady ? "check" : "warning")" /> @(environmentReady ? "Ready to run" : "Setup required")</span>
                                @if (!Vm.QemuEnvironment.Enabled) { <p>Execution is disabled on this host. You can save this step; an administrator must enable browser workspaces to run it.</p> }
                                @if (Vm.QemuEnvironment.Enabled && !imageAvailable) { <p>This image profile is unavailable on this host. Configure its image before running.</p> }
                                @if (!Vm.QemuEnvironment.AgentReady) { <p>The task agent needs an execution provider and model credentials.</p> }
                                else { <p>Agent model: <strong>@Vm.QemuEnvironment.AgentModel</strong></p> }
                            </div>
                            <label class="qemu-network" for="qemu-network"><span><strong>Network access</strong><small>Allow access to websites and services outside the VM.</small></span><input id="qemu-network" type="checkbox" role="switch" @bind="Vm.QemuAllowNetwork" /></label>
                        </section>
                        <section class="qemu-section" aria-labelledby="qemu-login-title">
                            <h4 id="qemu-login-title">Login &amp; human control</h4>
                            <div class="dcfield"><label for="qemu-login">Saved browser session</label>
                                <select id="qemu-login" class="dcinput" @bind="Vm.QemuLoginId">
                                    <option value="">Fresh browser — no saved login</option>
                                    @if (!string.IsNullOrEmpty(Vm.QemuLoginId) && !Vm.QemuLogins.Any(p => p.Id.ToString() == Vm.QemuLoginId && p.ImageProfile == Vm.VirtualMachineImageProfile))
                                    { <option value="@Vm.QemuLoginId">Saved login unavailable — choose your own session</option> }
                                    @foreach (var profile in Vm.QemuLogins.Where(p => p.ImageProfile == Vm.VirtualMachineImageProfile))
                                    { <option value="@profile.Id">@profile.Name</option> }
                                </select><small>Only your private sessions for this project and image are listed. Each run gets its own copy.</small>
                            </div>
                            <div class="qemu-login-actions">
                                <button class="dcbtn" @onclick="Vm.LoadQemuLoginsAsync">Refresh logins</button>
                                @if (!string.IsNullOrEmpty(Vm.QemuLoginId)) { <button class="dcbtn" @onclick="Vm.ForgetQemuLoginAsync">Forget selected login</button> }
                            </div>
                            @if (Vm.QemuLoginError is not null) { <p role="alert">@Vm.QemuLoginError</p> }
                            <label class="qemu-network" for="qemu-login-pause"><span><strong>Pause for login before starting</strong><small>Open the live desktop from the run, sign in, then resume automation. Requires the configured browser executor.</small></span><input id="qemu-login-pause" type="checkbox" @bind="Vm.QemuPauseForLogin" /></label>
                        </section>
                        <section class="qemu-section" aria-labelledby="qemu-resources-title">
                            <h4 id="qemu-resources-title">Resources &amp; limits</h4>
                            <div class="qemu-resource-grid">
                                <div class="dcfield"><label for="qemu-memory">Memory <span>MiB</span></label><input id="qemu-memory" class="dcinput" type="number" min="256" max="8192" @bind="Vm.QemuMemoryMb" /></div>
                                <div class="dcfield"><label for="qemu-cpus">CPUs</label><input id="qemu-cpus" class="dcinput" type="number" min="1" max="8" @bind="Vm.QemuCpus" /></div>
                                <div class="dcfield"><label for="qemu-timeout">Timeout <span>seconds</span></label><input id="qemu-timeout" class="dcinput" type="number" min="10" max="3600" @bind="Vm.QemuTimeoutSeconds" /></div>
                            </div>
                            <p class="sub-note">The timeout includes startup and human interaction. Disk changes are discarded unless you explicitly save a login.</p>
                        </section>
                        <section class="qemu-section" aria-labelledby="qemu-result-title">
                            <h4 id="qemu-result-title">Result</h4>
                            <div class="dcfield"><label for="qemu-output">Save output to</label><input id="qemu-output" class="dcinput" maxlength="80" @bind="Vm.QemuOutputField" /><small>Later steps can use the final result, errors, exit code, and activity recorded in this field.</small></div>
                        </section>
                        <p class="sub-note">Apply step keeps this edit in the draft. Save workflow saves all current workflow changes.</p>
                        @if (Vm.QemuError is not null) { <p role="alert" class="qemu-error">@Vm.QemuError</p> }
                    }
                    </div>
                    <div class="dcmodal-foot">
                        <button class="dcbtn" disabled="@Vm.Saving" @onclick="Vm.CloseQemuEditor">Cancel</button>
                        <button class="dcbtn" disabled="@Vm.Saving" @onclick="SaveQemuActionAsync">Apply step</button>
                        <button class="dcbtn primary" disabled="@Vm.Saving" @onclick="SaveQemuWorkflowAsync">@(Vm.Saving ? "Saving…" : "Save workflow")</button>
                    </div>
                </div>
            </div>
        }

        @if (Vm.ShowQemuRunModal && Vm.QemuReplayRun is { } runReplay)
        {
            <div class="dcmodal-overlay" @onclick="Vm.CloseQemuEditor">
                <div class="dcmodal qemu-modal qemu-modal-replay qemu-run-modal" role="dialog" aria-modal="true" aria-labelledby="qemu-run-title" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><WorkflowDialogHandle />
                        <span class="qemu-heading-icon"><AppIcon Kind="vm" /></span>
                        <div><span class="workflow-eyebrow">Workflow run</span><h3 id="qemu-run-title">Browser workspace</h3><p class="sub-note">Recorded activity and visual replay for this run.</p></div>
                        <button class="dcslide-x" aria-label="Close browser workspace replay" @onclick="Vm.CloseQemuEditor"><AppIcon Kind="close" /></button>
                    </div>
                    <nav class="dctabs workflow-view-tabs qemu-run-tabs" aria-label="Browser workspace run view">
                        <button type="button" class="dctab @(Vm.QemuRunTab == "replay" ? "active" : null)" aria-pressed="@(Vm.QemuRunTab == "replay")" @onclick='() => Vm.SetQemuRunTab("replay")'>Replay</button>
                        <button type="button" class="dctab @(Vm.QemuRunTab == "live" ? "active" : null)" aria-pressed="@(Vm.QemuRunTab == "live")" @onclick='() => Vm.SetQemuRunTab("live")'>Live view</button>
                    </nav>
                    <div class="dcmodal-body">
                        @if (Vm.QemuRunTab == "live" && Vm.IsChainRunActive(runReplay.Status) && Vm.QemuLiveContext is { } liveContext)
                        {
                            <VirtualMachineDesktop @key="(runReplay.Id, Vm.QemuReplayStep, Vm.QemuRunTab)" Run="liveContext" />
                        }
                        else if (Vm.QemuRunTab == "live")
                        {
                            <div class="qemu-live-empty" role="status">
                                <strong>No active live view</strong>
                                <p>The workflow run is @runReplay.Status.ToLowerInvariant(), so its live browser session is no longer available.</p>
                            </div>
                        }
                        else
                        {
                            <VirtualMachineReplay @key="(runReplay.Id, Vm.QemuReplayStep, Vm.QemuRunTab)" Run="runReplay" Step="Vm.QemuReplayStep" />
                        }
                    </div>
                </div>
            </div>
        }

        @if (Vm.ShowParallelWorkflowEditor)
        {
            <div class="dcmodal-overlay" @onclick="Vm.CloseParallelWorkflowEditor">
                <div class="dcmodal parallel-workflow-modal workflow-conditions-modal" role="dialog" aria-modal="true" aria-label="Parallel if gates" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><WorkflowDialogHandle /><div class="title-14">Parallel if gates</div><button class="dcslide-x" aria-label="Close" @onclick="Vm.CloseParallelWorkflowEditor"><AppIcon Kind="close" /></button></div>
                    <div class="dcmodal-body">
                        <p class="sub-note">Each branch checks the same incoming payload. Every matching workflow runs, up to four at once. The next step waits for all matching branches. Results stay separate in branch order.</p>
                        <nav class="dctabs parallel-branch-tabs" aria-label="Parallel branches">
                            @foreach (var tabBranch in Vm.ParallelBranches)
                            {
                                <button type="button" class="dctab @(Vm.ActiveParallelBranch == tabBranch ? "active" : null)" aria-pressed="@(Vm.ActiveParallelBranch == tabBranch ? "true" : "false")" @onclick="() => Vm.SelectParallelBranch(tabBranch)">Branch @(Vm.ParallelBranches.IndexOf(tabBranch) + 1)</button>
                            }
                        </nav>
                        @if (Vm.ActiveParallelBranch is { } branch)
                        {
                            <section class="parallel-branch" @key="branch">
                                <h4>Branch @(Vm.ParallelBranches.IndexOf(branch) + 1)</h4>
                                <div class="dcfield"><label for="parallel-workflow">Run workflow</label><select id="parallel-workflow" class="dcinput" @bind="branch.WorkflowId"><option value="">Choose a workflow</option>
                                    @foreach (var workflow in (Vm.Chains ?? []).Where(chain => chain.Id != Vm.EditChainId)) { <option value="@workflow.Id">@workflow.Name</option> }
                                </select></div>
                                <div><WorkflowConditionsEditor Rows="branch.Conditions" @bind-Match="branch.Match" LoadFields="Vm.LoadParallelConditionFieldsAsync"
                                    TrueLabel="@((Vm.Chains ?? []).FirstOrDefault(chain => chain.Id.ToString() == branch.WorkflowId)?.Name ?? "Run selected workflow")"
                                    FalseLabel="Skip this branch" JoinLabel="Wait for matching branches, then continue" /></div>
                                <button class="dcbtn btn-xs" disabled="@(Vm.ParallelBranches.Count <= 2)" @onclick="() => Vm.RemoveParallelBranch(branch)">Remove branch</button>
                            </section>
                        }
                        <div><button class="dcbtn" disabled="@(Vm.ParallelBranches.Count >= 8)" @onclick="Vm.AddParallelBranch">Add parallel branch</button></div>
                        <div class="dcfield"><label for="parallel-output">Join output field</label><input id="parallel-output" class="dcinput" @bind="Vm.ParallelOutputField" /></div>
                        @if (Vm.ParallelWorkflowError is { } error) { <div role="alert">@error</div> }
                    </div>
                    <div class="dcmodal-foot"><button class="dcbtn" @onclick="Vm.CloseParallelWorkflowEditor">Cancel</button><button class="dcbtn primary" @onclick="Vm.SaveParallelWorkflowAction">Save step</button></div>
                </div>
            </div>
        }

        @if (Vm.PolicyStageIndex is { } policyIndex)
        {
            <div class="dcmodal-overlay step-policy-overlay" @onclick="Vm.CloseStepPolicy">
                <div class="dcmodal run-modal" role="dialog" aria-modal="true" aria-label="Step retries and limits" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><div class="title-14">Retries and limits · @(Vm.PolicyIsFalsePath ? "False path step" : "Step") @(policyIndex + 1)</div><button class="dcslide-x" aria-label="Close" @onclick="Vm.CloseStepPolicy"><AppIcon Kind="close" /></button></div>
                    <div class="dcmodal-body">
                        <div class="dcfield"><label for="step-max-retries">Maximum retries</label><input id="step-max-retries" class="dcinput" type="number" min="0" max="10" @bind="Vm.StepMaxRetries" /><small>Additional attempts after a failure. Zero disables retries.</small></div>
                        <div class="dcfield"><label for="step-retry-delay">Delay between retries (seconds)</label><input id="step-retry-delay" class="dcinput" type="number" min="0" max="3600" @bind="Vm.StepRetryDelaySeconds" /></div>
                        <div class="dcfield"><label for="step-timeout">Timeout per attempt (seconds)</label><input id="step-timeout" class="dcinput" type="number" min="1" max="86400" placeholder="Use runtime limit" @bind="Vm.StepTimeoutSeconds" /><small>Leave empty to keep the runtime limit. Human input and scheduled waits are excluded.</small></div>
                        <p class="sub-note">Applies to each job in a parallel step. Retrying may repeat side effects such as sending messages.</p>
                        @if (Vm.StepPolicyError is { } policyError) { <div class="prompt-err" role="alert">@policyError</div> }
                    </div>
                    <div class="dcmodal-foot"><button class="dcbtn" @onclick="Vm.ResetStepPolicy">Use defaults</button><button class="dcbtn" @onclick="Vm.CloseStepPolicy">Cancel</button><button class="dcbtn primary" @onclick="Vm.SaveStepPolicy">Apply</button></div>
                </div>
            </div>
        }

        @if (Vm.ShowSubWorkflowEditor)
        {
            <div class="dcmodal-overlay" @onclick="Vm.CloseSubWorkflowEditor">
                <div class="dcmodal sub-workflow-modal" role="dialog" aria-modal="true" aria-label="Run sub-workflow" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><WorkflowDialogHandle /><div class="title-14">Run sub-workflow</div><button class="dcslide-x" aria-label="Close" @onclick="Vm.CloseSubWorkflowEditor"><AppIcon Kind="close" /></button></div>
                    <div class="dcmodal-body">
                        <div class="dcfield"><label for="sub-workflow">Workflow</label><select id="sub-workflow" class="dcinput" @bind="Vm.SubWorkflowId"><option value="">Choose a workflow</option>
                            @foreach (var workflow in (Vm.Chains ?? []).Where(chain => chain.Id != Vm.EditChainId))
                            { <option value="@workflow.Id">@workflow.Name</option> }
                        </select></div>
                        <p class="sub-note">Passes the current payload to an automatic workflow and merges its result into the next step. Put waits and requests for human input in the parent workflow.</p>
                        @if (Vm.SelectedSubWorkflow is { } subWorkflow)
                        {
                            <div><a class="dcbtn" href="@($"{Vm.WorkflowsRoute}/{subWorkflow.Id}/canvas")"
                                    target="_blank" rel="noopener noreferrer" title="Edit workflow in a new tab">
                                <AppIcon Kind="edit" /> Edit workflow <AppIcon Kind="external-link" />
                            </a></div>
                            <ChainCanvas @key="subWorkflow.Id" Stages="subWorkflow.Stages" Jobs="@(Vm.Jobs ?? Array.Empty<JobView>())" ReadOnly="true" />
                        }
                        else
                        {
                            <p class="sub-note" role="status">@(string.IsNullOrEmpty(Vm.SubWorkflowId) ? "Choose a workflow to see its canvas." : "This sub-workflow is unavailable. Choose another workflow to see its canvas.")</p>
                        }
                        @if (Vm.SubWorkflowError is { } error) { <div role="alert">@error</div> }
                    </div>
                    <div class="dcmodal-foot"><button class="dcbtn" @onclick="Vm.CloseSubWorkflowEditor">Cancel</button><button class="dcbtn primary" @onclick="Vm.SaveSubWorkflowAction">Save step</button></div>
                </div>
            </div>
        }

        @if (Vm.ShowQueryDataEditor)
        {
            <div class="dcmodal-overlay" @onclick="CloseQueryStudioAsync" @onkeydown='@(e => { if (e.Key == "Escape") _ = CloseQueryStudioAsync(); })'>
                <div class="dcmodal query-studio-modal" role="dialog" aria-modal="true" aria-labelledby="query-data-title" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><WorkflowDialogHandle />
                        <div>
                            <h3 id="query-data-title">Query data</h3>
                            <p class="sub-note">Read this project’s tables. Rows become the next step’s <code>@(Vm.QueryDataOutputField).rows</code>.</p>
                        </div>
                        <button class="dcslide-x" aria-label="Close query settings" @onclick="CloseQueryStudioAsync"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="query-studio-body">
                        <aside class="query-studio-schema" aria-label="Project tables">
                            <div class="query-studio-schema-head">
                                <div><strong>Project tables</strong><small>Only this project’s schema</small></div>
                                <button class="dcbtn btn-xs" @onclick="ReloadQuerySchemaAsync" disabled="@Vm.QueryDataSchemaLoading">Refresh</button>
                            </div>
                            <input class="dcinput" type="search" placeholder="Filter tables and columns"
                                   @bind="Vm.QueryDataTableFilter" @bind:event="oninput" />
                            @if (Vm.QueryDataSchemaLoading)
                            {
                                <p class="query-studio-note">Loading tables…</p>
                            }
                            else if (Vm.QueryDataSchemaError is { } schemaError)
                            {
                                <p class="danger" role="alert">@schemaError</p>
                            }
                            else if (!Vm.QueryDataTables.Any())
                            {
                                <p class="query-studio-note">No tables yet.</p>
                            }
                            else
                            {
                                @foreach (var table in Vm.FilteredQueryDataTables)
                                {
                                    var isSelected = string.Equals(Vm.QueryDataTableName, table.Name, StringComparison.OrdinalIgnoreCase);
                                    <div class="query-table @(isSelected ? "selected" : "")">
                                        <button class="query-table-name" aria-pressed="@isSelected" @onclick="() => Vm.SelectQueryTableAsync(table.Name)">
                                            <span>@table.Name</span>
                                            <small>@table.Columns.Count column@(table.Columns.Count == 1 ? "" : "s")</small>
                                        </button>
                                        @if (isSelected)
                                        {
                                            <div class="query-columns">
                                                <div class="query-columns-head">
                                                    <span>Columns</span>
                                                    <button class="linklike" @onclick="() => Vm.SetAllQueryColumns(true)">All</button>
                                                    <button class="linklike" @onclick="() => Vm.SetAllQueryColumns(false)">None</button>
                                                </div>
                                                @foreach (var column in table.Columns)
                                                {
                                                    <div class="query-column">
                                                        <label>
                                                            <input type="checkbox" checked="@Vm.QueryDataSelectedColumns.Contains(column.Name)"
                                                                   @onchange="e => Vm.SetQueryColumn(column.Name, e.Value is true)" />
                                                            <span>@column.Name</span>
                                                            <small>@column.Type</small>
                                                        </label>
                                                        <button class="query-column-insert" title="Insert @column.Name into the query"
                                                                aria-label="Insert @column.Name" @onclick="() => Vm.InsertQueryColumnAsync(column.Name)">+</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </aside>
                        <section class="query-studio-main">
                            <div class="query-studio-toolbar">
                                <button class="dcbtn btn-xs" @onclick="BuildSelectedQueryAsync" title="Generate a SELECT for the checked columns and filters">SELECT checked</button>
                                <button class="dcbtn btn-xs" @onclick="BuildCountQueryAsync" title="Generate a COUNT(*) for the selected table and filters">Count</button>
                                <button class="dcbtn btn-xs" @onclick="InsertLimitAsync" title="Add LIMIT 100 when the query has no LIMIT">Add LIMIT 100</button>
                                <span class="query-toolbar-spacer"></span>
                                <button class="dcbtn primary btn-xs" @onclick="PreviewQueryAsync" disabled="@Vm.QueryDataPreviewLoading">
                                    @(Vm.QueryDataPreviewLoading ? "Previewing…" : "Preview")
                                </button>
                            </div>
                            <div class="query-studio-editor">
                                <WorkflowQueryEditor @ref="_queryEditor" Value="@Vm.QueryDataSql" Tables="@Vm.QueryDataTables"
                                                     Label="Read-only SQL for the Query data step" />
                            </div>
                            <div class="query-studio-output">
                                <label for="query-data-output">Output field</label>
                                <input id="query-data-output" class="dcinput" maxlength="80" @bind="Vm.QueryDataOutputField" />
                                <button class="dcbtn btn-xs" @onclick="Vm.UseSelectedTableAsOutputField" disabled="@(Vm.QueryDataTable is null)">Use table name</button>
                                <span>Next step reads <code>@(Vm.QueryDataOutputField).rows</code></span>
                            </div>
                            @if (Vm.QueryDataHelperError is { } helperError)
                            {
                                <p class="danger query-studio-message" role="alert">@helperError</p>
                            }
                            <div class="query-studio-tabs" role="tablist" aria-label="Query data panes">
                                <button role="tab" aria-selected="@(Vm.QueryDataPane == "values")" @onclick='() => Vm.ShowQueryPane("values")'>Table values</button>
                                <button role="tab" aria-selected="@(Vm.QueryDataPane == "result")" @onclick='() => Vm.ShowQueryPane("result")'>Query result</button>
                                @if (Vm.QueryDataPreview is not null)
                                {
                                    <span class="query-studio-summary">@WorkflowSql.PreviewSummary(Vm.QueryDataPreview, Vm.QueryDataOutputField)</span>
                                }
                            </div>
                            @if (Vm.QueryDataPane == "values")
                            {
                                <div class="query-studio-pane">
                                    @if (Vm.QueryDataTable is not { } valuesTable)
                                    {
                                        <p class="query-studio-note">Choose a table to see its values.</p>
                                    }
                                    else
                                    {
                                        <div class="query-values-bar">
                                            <div class="query-values-search">
                                                <input class="dcinput" type="search" placeholder="Search @valuesTable.Name"
                                                       @bind="Vm.QueryDataValuesSearch" @bind:event="oninput" @onkeydown="QueryValuesSearchKeyAsync" />
                                                <button class="dcbtn btn-xs" @onclick="Vm.SearchQueryValuesAsync">Search</button>
                                            </div>
                                            <div class="query-values-nav">
                                                <button class="dcbtn btn-xs" disabled="@(Vm.QueryDataValuesPage <= 1 || Vm.QueryDataValuesLoading)"
                                                        @onclick="Vm.PreviousQueryValuesPageAsync">Previous</button>
                                                <span>Page @Vm.QueryDataValuesPage</span>
                                                <button class="dcbtn btn-xs" disabled="@(!Vm.QueryDataHasNextPage || Vm.QueryDataValuesLoading)"
                                                        @onclick="Vm.NextQueryValuesPageAsync">Next</button>
                                            </div>
                                        </div>
                                        @if (Vm.QueryDataValuesLoading)
                                        {
                                            <p class="query-studio-note">Loading values…</p>
                                        }
                                        else if (Vm.QueryDataValuesError is { } valuesError)
                                        {
                                            <p class="danger" role="alert">@valuesError</p>
                                        }
                                        else
                                        {
                                            var values = Vm.QueryDataValues;
                                            if (values is null || values.Columns.Count == 0 || values.Rows.Count == 0)
                                            {
                                                <p class="query-studio-note">This table has no rows to sample yet.</p>
                                            }
                                            else
                                            {
                                                <div class="query-filters">
                                                    @if (Vm.QueryDataFilters.Count == 0)
                                                    {
                                                        <span class="query-studio-note">Click a cell to filter by its value.</span>
                                                    }
                                                    @foreach (var filter in Vm.QueryDataFilters)
                                                    {
                                                        <span class="query-filter-chip">
                                                            @WorkflowSql.FilterLabel(filter)
                                                            <button aria-label="Remove filter @WorkflowSql.FilterLabel(filter)" @onclick="() => Vm.RemoveQueryFilter(filter)">×</button>
                                                        </span>
                                                    }
                                                </div>
                                                <div class="query-grid-scroll">
                                                    <table class="query-grid">
                                                        <thead>
                                                            <tr>@foreach (var column in values.Columns) { <th scope="col">@column</th> }</tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var row in values.Rows.Take(WorkflowSql.SampleRows))
                                                            {
                                                                <tr>
                                                                    @for (var i = 0; i < values.Columns.Count; i++)
                                                                    {
                                                                        var cell = i < row.Count ? row[i] : null;
                                                                        var column = values.Columns[i];
                                                                        <td>
                                                                            <button class="query-cell" title="Filter @column = @(cell ?? "null")"
                                                                                    @onclick="() => Vm.AddQueryFilter(column, cell)">@(cell ?? "∅")</button>
                                                                        </td>
                                                                    }
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="query-studio-pane">
                                    @if (Vm.QueryDataPreviewWarning is { } warning)
                                    {
                                        <p class="query-studio-warning" role="alert">@warning</p>
                                    }
                                    @if (Vm.QueryDataPreviewLoading)
                                    {
                                        <p class="query-studio-note">Running preview…</p>
                                    }
                                    else if (Vm.QueryDataPreviewError is { } previewError)
                                    {
                                        <p class="danger" role="alert">@previewError</p>
                                    }
                                    else
                                    {
                                        var preview = Vm.QueryDataPreview;
                                        if (preview is null || preview.Columns.Count == 0)
                                        {
                                            <p class="query-studio-note">Run a preview to see the rows this step will pass on.</p>
                                        }
                                        else
                                        {
                                            if (WorkflowSql.SampleRow(preview) is { } sample)
                                            {
                                                <div class="query-sample">
                                                    <div class="query-sample-head"><strong>Next step receives</strong><code>@WorkflowSql.RowsPath(Vm.QueryDataOutputField)</code></div>
                                                    <RunOutput Value="@sample" Label="Query sample JSON" />
                                                </div>
                                            }
                                            <div class="query-grid-scroll">
                                                <table class="query-grid">
                                                    <thead>
                                                        <tr>@foreach (var column in preview.Columns) { <th scope="col">@column</th> }</tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var row in preview.Rows)
                                                        {
                                                            <tr>
                                                                @for (var i = 0; i < preview.Columns.Count; i++)
                                                                {
                                                                    var cell = i < row.Count ? row[i] : null;
                                                                    <td><span class="query-cell readonly">@(cell ?? "∅")</span></td>
                                                                }
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                    }
                                    <p class="query-studio-note">@WorkflowSql.IsolationNote</p>
                                </div>
                            }
                        </section>
                    </div>
                    <div class="dcmodal-foot">
                        <button class="dcbtn" @onclick="CloseQueryStudioAsync">Cancel</button>
                        <button class="dcbtn primary" @onclick="SaveQueryDataAsync" disabled="@Vm.QueryDataPreviewLoading">Save step</button>
                    </div>
                </div>
            </div>
        }

        @if (Vm.ShowScoringEditor)
        {
            var criterion = CurrentScoreCriterion;
            <div class="dcmodal-overlay" @onclick="Vm.CloseScoringEditor" @onkeydown='@(e => { if (e.Key == "Escape") Vm.CloseScoringEditor(); })'>
                <div class="dcmodal loop-modal agent-instructions-modal scoring-modal" role="dialog" aria-modal="true" aria-labelledby="score-title" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><WorkflowDialogHandle /><h3 id="score-title">Scoring gate</h3>
                        <button class="dcslide-x" aria-label="Close scoring settings" @onclick="Vm.CloseScoringEditor"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body loop-editor-body">
                        <div class="loop-settings">
                            <p class="sub-note">Higher scores mean better quality. Every criterion minimum and confidence floor must pass.</p>
                            <div class="dcfield"><label for="score-source">Map from a previous step</label><select id="score-source" class="dcinput" value="@Vm.ScoreInputField" @onchange='e => Vm.ScoreInputField = e.Value?.ToString() ?? ""'><option value="">Choose a field or enter a path</option>@foreach (var field in Vm.ScoreEvidenceFields) { <option value="@field">@field</option> }</select></div>
                            <div class="dcfield"><label for="score-input">Evidence field path</label><input id="score-input" class="dcinput" @bind="Vm.ScoreInputField" maxlength="200" /><span class="sub-note">Up to 65,536 characters; never truncated.</span></div>
                            <div class="dcfield"><label for="score-output">Output field</label><input id="score-output" class="dcinput" @bind="Vm.ScoreOutputField" maxlength="80" /></div>
                            <div class="dcfield"><label for="score-pass">Weighted pass score (0–100)</label><div class="score-slider-row">
                                <input id="score-pass" type="range" min="0" max="100" step="1" @bind="Vm.ScorePass" @bind:event="oninput" />
                                <input class="dcinput" aria-label="Exact weighted pass score" type="number" min="0" max="100" step="1" @bind="Vm.ScorePass" />
                            </div></div>
                            <div class="dcfield"><label for="score-confidence">Minimum confidence (0–1)</label><div class="score-slider-row">
                                <input id="score-confidence" type="range" min="0" max="1" step="0.01" @bind="Vm.ScoreConfidence" @bind:event="oninput" />
                                <input class="dcinput" aria-label="Exact minimum confidence" type="number" min="0" max="1" step="0.01" @bind="Vm.ScoreConfidence" />
                            </div></div>
                            <div class="dcfield"><label for="score-criterion">Criterion</label><select id="score-criterion" class="dcinput" value="@(criterion is null ? -1 : Vm.ScoreCriteria.IndexOf(criterion))" @onchange="SelectScoreCriterionAsync">
                                @foreach (var (item, index) in Vm.ScoreCriteria.Select((item, index) => (item, index))) { <option value="@index">@(index + 1). @item.Id</option> }
                            </select></div>
                            @if (criterion is not null)
                            {
                                <div class="dcfield"><label for="score-criterion-name">Criterion name</label><input id="score-criterion-name" class="dcinput" @bind="criterion.Id" maxlength="80" /></div>
                                <div class="dcfield"><label for="score-weight">Criterion weight</label><div class="score-slider-row">
                                    <input id="score-weight" type="range" min="0.01" max="100" step="0.01" @bind="criterion.Weight" @bind:event="oninput" />
                                    <input class="dcinput" aria-label="Exact criterion weight" type="number" min="0.01" max="100" step="0.01" @bind="criterion.Weight" />
                                </div></div>
                                <div class="dcfield"><label for="score-minimum">Required score (0–100)</label><div class="score-slider-row">
                                    <input id="score-minimum" type="range" min="0" max="100" step="1" @bind="criterion.MinimumScore" @bind:event="oninput" />
                                    <input class="dcinput" aria-label="Exact required criterion score" type="number" min="0" max="100" step="1" @bind="criterion.MinimumScore" />
                                </div></div>
                            }
                            <div class="score-criterion-actions">
                                <button class="dcbtn" disabled="@(Vm.ScoreCriteria.Count >= 12)" @onclick="AddScoreCriterionAsync">Add criterion</button>
                                <button class="dcbtn" disabled="@(criterion is null)" @onclick="RemoveScoreCriterion">Remove</button>
                            </div>
                            <label class="dcfield"><span><input type="checkbox" @bind="Vm.ScoreStopOnFailure" /> Stop workflow when the gate fails</span></label>
                            <p class="sub-note">When unchecked, route downstream steps using @(Vm.ScoreOutputField).passed. Service errors always stop execution.</p>
                            @if (Vm.ScoreError is not null) { <p class="danger" role="alert">@Vm.ScoreError</p> }
                        </div>
                        <section class="loop-instructions-pane" aria-label="Criterion editor">
                            <nav class="execution-tabs score-editor-tabs" aria-label="Criterion content">
                                <button type="button" aria-pressed="@(_scoreTab == "question" ? "true" : "false")" @onclick='() => SelectScoreTabAsync("question")'>Question</button>
                                <button type="button" aria-pressed="@(_scoreTab == "levels" ? "true" : "false")" @onclick='() => SelectScoreTabAsync("levels")'>Scoring levels</button>
                            </nav>
                            @if (criterion is not null)
                            {
                                <div class="loop-instructions-toolbar"><strong>@criterion.Id</strong><span>@(_scoreTab == "question" ? "Markdown · one question · up to 4,000 characters" : "2–10 levels · lowest to highest · one description per line")</span></div>
                                <WorkflowInstructionsEditor @key="(criterion, _scoreTab)" @ref="_scoreEditor" Value="@(_scoreTab == "question" ? criterion.Question : criterion.Levels)" Label="@(_scoreTab == "question" ? "Scoring criterion question in Markdown" : "Scoring levels, one description per line")" />
                            }
                            else { <p class="sub-note">Add a criterion to define the quality rubric.</p> }
                        </section>
                    </div>
                    <div class="dcmodal-foot"><button class="dcbtn" @onclick="Vm.CloseScoringEditor">Cancel</button><button class="dcbtn primary" @onclick="SaveScoringInstructionsAsync">Save step</button></div>
                </div>
            </div>
        }

        @if (Vm.ShowRepeatEditor)
        {
            <div class="dcmodal-overlay" @onclick="Vm.CloseRepeatEditor">
                <div class="dcmodal loop-modal" role="dialog" aria-modal="true" aria-labelledby="repeat-title" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><WorkflowDialogHandle /><h3 id="repeat-title">Repeat flow</h3>
                        <button class="dcslide-x" aria-label="Close repeat settings" @onclick="Vm.CloseRepeatEditor"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body">
                        <p>When this condition is false, repeat all preceding stages with their latest output. Continue to the next step only when it passes. Fail the workflow after the maximum total attempts.</p>
                        <div class="dcfield"><label for="repeat-condition">Completion condition</label><input id="repeat-condition" class="dcinput" @bind="Vm.RepeatCondition" maxlength="500" /></div>
                        <div class="dcfield"><label for="repeat-attempts">Maximum total attempts</label><input id="repeat-attempts" class="dcinput" type="number" min="1" max="10" @bind="Vm.RepeatMaxAttempts" /></div>
                        @if (Vm.RepeatError is not null) { <p class="danger" role="alert">@Vm.RepeatError</p> }
                    </div>
                    <div class="dcmodal-foot"><button class="dcbtn" @onclick="Vm.CloseRepeatEditor">Cancel</button><button class="dcbtn primary" @onclick="Vm.SaveRepeatAction">Save step</button></div>
                </div>
            </div>
        }

        @if (Vm.ShowLoopEditor)
        {
            <div class="dcmodal-overlay" @onclick="Vm.CloseLoopEditor">
                <div class="dcmodal loop-modal agent-instructions-modal" role="dialog" aria-modal="true" aria-labelledby="loop-editor-title" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><WorkflowDialogHandle />
                        <div>
                            <span class="workflow-eyebrow">Workflow step</span>
                            <h3 id="loop-editor-title">@(Vm.LoopKind == LoopChainAction.TaskType ? "Agent task" : Vm.LoopKind == LoopChainAction.HumanType ? "Human in the loop" : "Agent review")</h3>
                        </div>
                        <button class="dcslide-x" aria-label="Close step settings" @onclick="Vm.CloseLoopEditor"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body loop-editor-body">
                        <div class="loop-settings">
                        <p class="sub-note">@(Vm.LoopKind == LoopChainAction.TaskType ? "Assign work and acceptance criteria, then choose automatic execution or an external handoff." : Vm.LoopKind == LoopChainAction.HumanType ? "The model uses the preceding output to ask the user a validation question. The workflow waits for their response." : "Review the previous step’s results. Choose automatic approval, a response from an external agent, or an AI evidence check.")</p>
                        @if (Vm.LoopKind != LoopChainAction.HumanType)
                        {
                            <div class="dcfield">
                                <label for="loop-agent">@(Vm.LoopKind == LoopChainAction.AgentType ? "Review method" : "How to run this task")</label>
                                <select id="loop-agent" class="dcinput" @bind="Vm.LoopAgentProvider" aria-describedby="loop-agent-help">
                                    <option value="@LoopChainAction.AutomaticAgent">@(Vm.LoopKind == LoopChainAction.AgentType ? "Automatic — ask the parent agent for approval" : "Automatic — have an AI agent do the task")</option>
                                    <option value="@LoopChainAction.ExternalAgent">External — pause for a connected agent</option>
                                    @if (Vm.LoopKind == LoopChainAction.AgentType) { <option value="@LoopChainAction.JevAgent" disabled="@(!Vm.JevAvailable)">Jev review — return a confidence score@(!Vm.JevAvailable ? " (API key required)" : "")</option> }
                                </select>
                                <span id="loop-agent-help" class="sub-note">@(Vm.LoopAgentProvider == LoopChainAction.AutomaticAgent
                                    ? Vm.LoopKind == LoopChainAction.AgentType ? "The parent of the agent selected below reviews the previous results against your instructions. If no agent is selected, the master agent reviews them. A rejection stops the workflow." : "Runs the agent with parent approval before actions and completion, then saves its JSON result."
                                    : Vm.LoopAgentProvider == LoopChainAction.JevAgent
                                    ? "Checks the previous results against a yes/no question and returns a confidence score. Add a condition to decide whether the workflow continues. This does not approve the work automatically."
                                    : "Waits for a connected agent to submit a written response. No agent is launched automatically.")</span>
                            </div>
                        }
                        @if (Vm.LoopAgentProvider == LoopChainAction.AutomaticAgent)
                        {
                            <div class="dcfield"><label for="loop-project-agent">@(Vm.LoopKind == LoopChainAction.AgentType ? "Agent whose work is being reviewed" : "Agent to do the task")</label>
                                <select id="loop-project-agent" class="dcinput" @bind="Vm.LoopAgentId" @bind:after="Vm.SelectLoopAgent">
                                    <option value="">@(Vm.LoopKind == LoopChainAction.AgentType ? "No specific agent — master agent reviews" : "Use the model and instructions below")</option>
                                    @foreach (var agent in Vm.LoopAgents) { <option value="@agent.Id">@agent.DisplayName</option> }
                                    @if (Vm.LoopAgentId is not null && Vm.SelectedLoopAgent is null) { <option value="@Vm.LoopAgentId">Unavailable agent</option> }
                                </select>
                                @if (Vm.SelectedLoopAgent is { } selectedAgent)
                                {
                                    <span class="sub-note">@(Vm.LoopKind == LoopChainAction.AgentType
                                        ? $"Reviewer: {(selectedAgent.EffectiveParentAgentId is null ? "Master agent" : Vm.LoopAgents.FirstOrDefault(a => a.Id == selectedAgent.EffectiveParentAgentId)?.DisplayName ?? "Unavailable parent agent")}. The reviewer uses its own saved instructions and model when configured."
                                        : "Uses this agent’s saved instructions, model and permissions when the task runs.")</span>
                                }
                                <a class="dcbtn btn-2-8 btn-start" href="/project/@Vm.ProjectId/agents">Manage agents</a>
                            </div>
                            <div class="dcfield"><label for="loop-connection">@(Vm.LoopKind == LoopChainAction.AgentType ? "Fallback model connection" : "Model connection")</label>
                                <select id="loop-connection" class="dcinput" @bind="Vm.LoopConnectionId" @bind:after="Vm.SelectLoopConnection" disabled="@(Vm.SelectedLoopAgent is { ConnectionId: var id } && id != Guid.Empty)">
                                    <option value="">Choose a connection</option>
                                    @foreach (var connection in Vm.LoopConnections) { <option value="@connection.Id">@connection.Name</option> }
                                </select>
                            </div>
                            <div class="dcfield"><label for="loop-model">@(Vm.LoopKind == LoopChainAction.AgentType ? "Fallback model" : "Model")</label>
                                <select id="loop-model" class="dcinput" @bind="Vm.LoopModel" disabled="@(Vm.SelectedLoopAgent is { ConnectionId: var modelConnection } && modelConnection != Guid.Empty)">
                                    <option value="">Choose a model</option>
                                    @foreach (var model in Vm.LoopModels) { <option value="@model">@model</option> }
                                </select>
                                @if (Vm.LoopKind == LoopChainAction.AgentType) { <span class="sub-note">Used only if the reviewing agent has no saved model connection.</span> }
                                @if (Vm.LoopConnections.Count == 0) { <span class="sub-note">Add an enabled model connection in Settings → Models.</span> }
                            </div>
                        }
                        @if (Vm.LoopKind == LoopChainAction.HumanType)
                        {
                            <div class="dcfield">
                                <label for="loop-response-type">Answer format</label>
                                <select id="loop-response-type" class="dcinput" @bind="Vm.LoopResponseType">
                                    <option value="@LoopChainAction.TextResponse">Written response</option>
                                    <option value="@LoopChainAction.YesNoResponse">Yes / No buttons</option>
                                </select>
                            </div>
                        }
                        <div class="dcfield">
                            <label for="loop-output">Response field <span class="req">*</span></label>
                            <input id="loop-output" class="dcinput" maxlength="80" @bind="Vm.LoopResponseField" aria-describedby="loop-output-help" />
                            <span id="loop-output-help" class="sub-note">@(Vm.LoopAgentProvider == LoopChainAction.JevAgent
                                ? "Saves the question, model version, and noul (probability of Yes, 0–1). Add a condition on this field's .noul value to control what happens next; completing verification does not mean approval."
                                : "The response is saved in this field. Later jobs and conditions can use it.")</span>
                        </div>
                        @if (Vm.LoopError is not null) { <p class="danger" role="alert">@Vm.LoopError</p> }
                        </div>
                        <section class="loop-instructions-pane" aria-labelledby="loop-markdown-title">
                            <div class="loop-instructions-toolbar"><strong id="loop-markdown-title">Task or review instructions <span class="req">*</span></strong><span>Markdown · up to 4,000 characters</span></div>
                            <WorkflowInstructionsEditor @ref="_loopInstructionsEditor" Value="@Vm.LoopInstructions" Label="@(Vm.LoopKind == LoopChainAction.HumanType ? "Human review instructions in Markdown" : "Agent task instructions in Markdown")" />
                        </section>
                    </div>
                    <div class="dcmodal-foot">
                        <button class="dcbtn" @onclick="Vm.CloseLoopEditor">Cancel</button>
                        <button class="dcbtn primary" @onclick="SaveLoopInstructionsAsync">Save step</button>
                    </div>
                </div>
            </div>
        }

        @if (Vm.HumanConfirmationCurrent && Vm.PendingHumanAnswer is { } requestedAnswer)
        {
            <div class="dcmodal-overlay">
                <div class="dcmodal" role="dialog" aria-modal="true" aria-labelledby="human-confirm-title">
                    <div class="dcmodal-head"><WorkflowDialogHandle /><h3 id="human-confirm-title">Confirm workflow response</h3>
                        <button class="dcslide-x" aria-label="Close confirmation" disabled="@Vm.Resuming" @onclick="Vm.CancelHumanAnswer"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body">
                        <p><strong>@(requestedAnswer ? "Yes" : "No")</strong> will resume this paused workflow from its saved checkpoint.</p>
                        <p>@(Vm.OpenRun?.InputRequest?.Instructions ?? "Review the workflow evidence first.")</p>
                        <p class="sub-note">The next steps depend on the configured branches. A No response does not automatically stop the workflow.</p>
                    </div>
                    @if (Vm.ResumeError is not null) { <p class="danger" role="alert">@Vm.ResumeError</p> }
                    <div class="dcmodal-foot">
                        <button class="dcbtn" disabled="@Vm.Resuming" @onclick="Vm.CancelHumanAnswer">Cancel</button>
                        <button class="dcbtn primary" disabled="@Vm.Resuming" @onclick="Vm.ConfirmHumanAnswerAsync">@(Vm.Resuming ? "Submitting…" : requestedAnswer ? "Confirm Yes" : "Confirm No")</button>
                    </div>
                </div>
            </div>
        }

        @if (Vm.ShowGateEditor)
        {
            <div class="dcmodal-overlay" @onclick="() => Vm.CancelGateEditor()">
                <div class="dcmodal gate-modal @(Vm.IsConditionGateEditor ? "workflow-conditions-modal" : null)" role="dialog" aria-modal="true" aria-label="Configure workflow step" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><WorkflowDialogHandle />
                        <div class="title-14">@(Vm.IsAutomaticGateEditor ? "Determine" : Vm.IsConditionGateEditor ? "If gate" : "Wait / delay") · Stage @(Vm.GateEditorStageIndex + 1)</div>
                        <button aria-label="Close" class="dcslide-x" @onclick="() => Vm.CancelGateEditor()"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body">
                        <div class="dcfield mb-8">
                            <label for="gate-type">Gate type</label>
                            <select id="gate-type" class="dcinput" @bind="Vm.GateEditorType">
                                <option value="wait">Wait / delay</option>
                                <option value="condition">Condition / if-else</option>
                                <option value="automatic" disabled="@(!Vm.JevAvailable)">Determine@(!Vm.JevAvailable ? " (Jev API key required)" : "")</option>
                            </select>
                        </div>

                        @if (Vm.GateEditorStageIndex == Vm.EdStages.Count)
                        {
                            <div class="dcfield">
                                <label for="gate-true-job">@(Vm.IsConditionGateEditor ? "Job on the True path" : "Job after the delay")</label>
                                <select id="gate-true-job" class="dcinput" @bind="Vm.GateEditorTrueJobId">
                                    <option value="">Choose a job…</option>
                                    @foreach (var job in Vm.Jobs ?? Array.Empty<JobView>())
                                    {
                                        <option value="@job.Id">@job.Name</option>
                                    }
                                </select>
                            </div>
                        }

                        @if (Vm.IsWaitGateEditor)
                        {
                            <div class="dcfield">
                                <label>Duration (seconds)</label>
                                <input class="dcinput" type="number" min="1" max="3600" step="1"
                                       @bind="Vm.GateEditorDuration" />
                            </div>
                            <div class="sub-note">Pauses the pipeline before running this stage's jobs.</div>
                        }

                        @if (Vm.IsConditionGateEditor)
                        {
                            <p class="sub-note">@(Vm.IsAutomaticGateEditor ? "Determine checks the incoming workflow data against your question and chooses the True or False path. Both paths rejoin at the next stage." : "Check the incoming payload. When true, run this stage. When false, follow the other path. Both paths rejoin at the next stage.")</p>
                            <nav class="dctabs parallel-branch-tabs" aria-label="Gate paths">
                                <button type="button" class="dctab @(Vm.GateEditorPath == "true" ? "active" : null)" aria-pressed="@(Vm.GateEditorPath == "true" ? "true" : "false")" @onclick='() => Vm.GateEditorPath = "true"'>True path</button>
                                <button type="button" class="dctab @(Vm.GateEditorPath == "false" ? "active" : null)" aria-pressed="@(Vm.GateEditorPath == "false" ? "true" : "false")" @onclick='() => Vm.GateEditorPath = "false"'>False path</button>
                            </nav>
                            <section class="parallel-branch" hidden="@(Vm.GateEditorPath != "true")">
                                <h4>True path</h4>
                                <div class="gate-path-target"><span>Run stage</span><strong>@Vm.GateTruePathLabel</strong></div>
                                <div><WorkflowConditionsEditor Automatic="Vm.IsAutomaticGateEditor" @bind-ReviewQuestion="Vm.GateReviewQuestion" Rows="Vm.GateEditorConditions" @bind-Match="Vm.GateEditorMatch" LoadFields="() => Vm.LoadConditionFieldsAsync(Vm.GateEditorStageIndex)"
                                    TrueLabel="@Vm.GateTruePathLabel" FalseLabel="@Vm.GateFalsePathLabel" /></div>
                                @if (!Vm.IsAutomaticGateEditor)
                                {
                                <details class="gate-retry-options">
                                    <summary>Retry on a failed condition</summary>
                                    <p>Retry the preceding process until these conditions pass, or fail after a fixed number of attempts.</p>
                                    <button class="dcbtn" disabled="@(!Vm.CanRetryGate)" @onclick="Vm.RetryGateProcess">Add bounded retry</button>
                                    @if (!Vm.CanRetryGate) { <p class="sub-note">A preceding step is required, and a workflow can have one Repeat step.</p> }
                                </details>
                                }
                            </section>
                            <section class="parallel-branch" hidden="@(Vm.GateEditorPath != "false")">
                                <h4>False path</h4>
                                @for (var i = 0; i < Vm.GateEditorElseStages.Count; i++)
                                {
                                    var index = i;
                                    <div class="dcfield">
                                        <WorkflowBranchPreview Jobs="@(Vm.Jobs ?? Array.Empty<JobView>())" Stages="@(new[] { Vm.BuildStageView(Vm.GateEditorElseStages[index]) })" />
                                        <button class="dcbtn btn-xs" aria-label="@($"Retries and limits for false path step {index + 1}")" @onclick="() => Vm.OpenElseStepPolicy(index)">Retries and limits</button>
                                        <button class="dcbtn btn-xs" aria-label="@($"Remove false path step {index + 1}")"
                                                @onclick="@(() => Vm.RemoveElseStage(index))">Remove step</button>
                                    </div>
                                }
                                @if (Vm.GateEditorElseStages.Count == 0)
                                {
                                    <p class="sub-note">No steps: continue to the next workflow stage.</p>
                                }
                                <div class="dcfield">
                                    <label for="false-path-job">Add a job to the false path</label>
                                    <select id="false-path-job" class="dcinput" @bind="Vm.GateEditorElseJobId">
                                        <option value="">Choose a job…</option>
                                        @foreach (var job in Vm.Jobs ?? Array.Empty<JobView>())
                                        {
                                            <option value="@job.Id">@job.Name</option>
                                        }
                                    </select>
                                    <button class="dcbtn" disabled="@(string.IsNullOrEmpty(Vm.GateEditorElseJobId))" @onclick="Vm.AddElseJob">Add step</button>
                                </div>
                            </section>
                        }
                    </div>
                    <div class="dcmodal-foot">
                        <button class="dcbtn" @onclick="() => Vm.CancelGateEditor()">Cancel</button>
                        @if (Vm.GateEditorError is not null) { <p class="danger" role="alert">@Vm.GateEditorError</p> }
                        <button class="dcbtn primary" @onclick="() => Vm.SaveGate()">Save gate</button>
                    </div>
                </div>
            </div>
        }

        @* ── Send SMS action editor ───────────────────────────────────────────────────── *@
        @if (Vm.ShowSmsActionEditor)
        {
            <div class="dcmodal-overlay" @onclick="() => Vm.CancelSmsActionEditor()">
                <div class="dcmodal gate-modal" role="dialog" aria-modal="true" aria-label="Configure workflow step" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><WorkflowDialogHandle />
                        <div>
                            <div class="title-14">Send SMS</div>
                            <div class="sub-115">Uses the workspace Communications connection. Insert previous output with <code>{{path.to.value}}</code>.</div>
                        </div>
                        <button aria-label="Close" class="dcslide-x" @onclick="() => Vm.CancelSmsActionEditor()"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body">
                        <div class="dcfield mb-8">
                            <label>Recipient <span class="req">*</span></label>
                            <input class="dcinput" @bind="Vm.SmsRecipient" placeholder="+61412345678 or {{client.phone}}" />
                        </div>
                        <div class="dcfield">
                            <label>Message <span class="req">*</span></label>
                            <textarea class="dcinput" rows="6" maxlength="1600" @bind="Vm.SmsBody"
                                      placeholder="Hello {{client.name}}, your report is ready."></textarea>
                        </div>
                        <div class="sub-note">Use an international recipient number. SMS/client release flags in the previous payload must allow delivery.</div>
                        @if (Vm.SmsActionError is not null)
                        {
                            <div class="editor-err">@Vm.SmsActionError</div>
                        }
                    </div>
                    <div class="dcmodal-foot">
                        <button class="dcbtn" @onclick="() => Vm.CancelSmsActionEditor()">Cancel</button>
                        <button class="dcbtn primary" @onclick="() => Vm.SaveSmsAction()">Save action</button>
                    </div>
                </div>
            </div>
        }

        @* ── Send Email action editor ──────────────────────────────────────────────────── *@
        @if (Vm.ShowEmailActionEditor)
        {
            <div class="dcmodal-overlay" @onclick="() => Vm.CancelEmailActionEditor()">
                <div class="dcmodal gate-modal email-action-modal" role="dialog" aria-modal="true" aria-label="Configure email step" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><WorkflowDialogHandle />
                        <div>
                            <div class="title-14">Send email</div>
                            <div class="sub-115">Uses the workspace Communications connection. Insert previous output with <code>{{path.to.value}}</code>.</div>
                        </div>
                        <button aria-label="Close" class="dcslide-x" @onclick="() => Vm.CancelEmailActionEditor()"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body">
                        <div class="email-json-panel">
                            <div class="email-json-head">
                                <div>
                                    <strong>Previous-step JSON</strong>
                                    <small>@(Vm.EmailJsonPathSource ?? "Use detected values as email placeholders.")</small>
                                </div>
                                @if (Vm.LoadingEmailJsonPaths)
                                {
                                    <span class="email-json-loading">Inspecting…</span>
                                }
                            </div>
                            @if (!Vm.LoadingEmailJsonPaths && Vm.EmailJsonPaths.Count > 0)
                            {
                                <div class="email-json-paths">
                                    @foreach (var suggestion in Vm.EmailJsonPaths)
                                    {
                                        <div class="email-json-row">
                                            <button class="email-json-key" title="Insert into message body"
                                                    @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "body")'>
                                                <code>@suggestion.Path</code>
                                                <span>@suggestion.Preview</span>
                                            </button>
                                            <div class="email-json-actions">
                                                <button title="Use as recipient" @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "recipient")'>To</button>
                                                <button title="Use as recipient name" @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "name")'>Name</button>
                                                <button title="Insert into subject" @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "subject")'>Subject</button>
                                                <button title="Insert into body" @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "body")'>Body</button>
                                                @if (suggestion.IsAttachmentCandidate)
                                                {
                                                    <button class="attachment-action" title="Use this object or array as email attachments"
                                                            @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "attachment")'>
                                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21.4 11.6-8.9 8.9a6 6 0 0 1-8.5-8.5l9.6-9.6a4 4 0 0 1 5.7 5.7l-9.6 9.6a2 2 0 0 1-2.8-2.8l8.9-8.9"/></svg>
                                                        Attach
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (!Vm.LoadingEmailJsonPaths)
                            {
                                <div class="email-json-empty">Run the preceding JSON job once to populate detected placeholders.</div>
                            }
                        </div>
                        <div class="dcfield mb-8">
                            <label>Recipient <span class="req">*</span></label>
                            <input class="dcinput" @bind="Vm.EmailRecipient" placeholder="client@example.com or {{client.email}}" />
                        </div>
                        <div class="dcfield mb-8">
                            <label>Recipient name</label>
                            <input class="dcinput" @bind="Vm.EmailRecipientName" placeholder="{{client.name}}" />
                        </div>
                        <div class="dcfield mb-8">
                            <label>Subject <span class="req">*</span></label>
                            <input class="dcinput" @bind="Vm.EmailSubject" placeholder="Report for {{site.address}}" />
                        </div>
                        <div class="dcfield">
                            <label>Text body <span class="req">*</span></label>
                            <textarea class="dcinput" rows="8" @bind="Vm.EmailBody"
                                      placeholder="Hello {{client.name}}, your report is ready."></textarea>
                        </div>
                        <div class="dcfield mb-8">
                            <label>Attachments JSON path</label>
                            <input class="dcinput" @bind="Vm.EmailAttachmentPath" placeholder="{{attachments}}" />
                            <div class="sub-note">
                                Optional. Accepts one object or an array with <code>name</code>, <code>content</code>/<code>contentBase64</code>, and <code>contentType</code>. Binary content must be base64.
                            </div>
                        </div>
                        <div class="sub-note">
                            If the previous payload contains email/client release flags, every present flag must explicitly allow delivery.
                        </div>
                        @if (Vm.EmailActionError is not null)
                        {
                            <div class="editor-err">@Vm.EmailActionError</div>
                        }
                    </div>
                    <div class="dcmodal-foot">
                        <button class="dcbtn" @onclick="() => Vm.CancelEmailActionEditor()">Cancel</button>
                        <button class="dcbtn primary" @onclick="() => Vm.SaveEmailAction()">Save action</button>
                    </div>
                </div>
            </div>
        }

        @if (_chainContextJson is not null)
        {
            <div class="dcmodal-overlay" @onclick="CloseChainContextJson">
                <div class="dcmodal chain-json-modal" role="dialog" aria-modal="true" aria-label="Workflow context JSON" @onclick:stopPropagation="true">
                    <div class="dcmodal-head"><WorkflowDialogHandle />
                        <div>
                            <div class="title-14">Workflow context JSON</div>
                            <div class="sub-115">Path: <code>@_chainContextJsonPath</code></div>
                        </div>
                        <button aria-label="Close" class="dcslide-x" @onclick="CloseChainContextJson"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body chain-json-body">
                        <RunOutput Value="@(_chainContextJson)" />
                    </div>
                </div>
            </div>
        }

        @if (Vm.IsDetailsTab)
        {
            <div class="dcslide-foot">
                @if (Vm.EditorError is not null)
                {
                    <div class="editor-err">@Vm.EditorError</div>
                }
                <button class="dcbtn" @onclick="() => Vm.CloseEditor()">Cancel</button>
                <button class="dcbtn primary" disabled="@Vm.Saving" @onclick="() => Vm.SaveChainAsync()">
                    @(Vm.Saving ? "Saving…" : Vm.EditChainId.HasValue ? "Save workflow" : "Create workflow")
                </button>
            </div>
        }
    </div>
}

<WorkflowRunDialog Vm="Vm" />

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid? WorkflowRouteId { get; set; }
    [Parameter] public string? WorkflowRouteView { get; set; }
    [Parameter] public Guid? WorkflowRouteRunId { get; set; }

    private WorkflowInstructionsEditor? _markupEditor;
    private async Task SetWorkflowViewAsync(string view)
    {
        if (Vm.IsMarkupView && _markupEditor is not null) Vm.MarkupText = await _markupEditor.ReadAsync();
        if (view == "runs") await Vm.ShowWorkflowRunsAsync();
        else Vm.SetEditorView(view);
    }
    private async Task DeployWorkflowMarkupAsync()
    {
        if (_markupEditor is not null) await Vm.DeployMarkupAsync(await _markupEditor.ReadAsync());
    }

    private ElementReference _executionClose;
    private bool _focusExecution;
    private string _executionTab = "activity";
    private async Task OpenExecutionLogsAsync(Guid runId)
    {
        _executionTab = "logs";
        await Vm.OpenAgentJobRunAsync(runId);
    }
    private async Task OpenExecutionStepAsync(ChainStepRunView step)
    {
        if (step.ActionType == VirtualMachineChainAction.ActionType && Vm.OpenQemuReplay(step))
        {
            return;
        }
        _focusExecution = true;
        _executionTab = step.ActionType is LoopChainAction.TaskType or LoopChainAction.AgentType
            || step.AgentActivity is { Count: > 0 } ? "activity" : "logs";
        await Vm.OpenExecutionStepAsync(step);
    }

    private WorkflowInstructionsEditor? _scoreEditor;
    private JobChainsViewModel.ScoreCriterionEditor? _scoreCriterion;
    private string _scoreTab = "question";
    private JobChainsViewModel.ScoreCriterionEditor? CurrentScoreCriterion => _scoreCriterion is not null && Vm.ScoreCriteria.Contains(_scoreCriterion)
        ? _scoreCriterion : Vm.ScoreCriteria.FirstOrDefault();

    private async Task ReadScoreEditorAsync()
    {
        if (_scoreEditor is null || CurrentScoreCriterion is not { } criterion) return;
        var text = await _scoreEditor.ReadAsync();
        if (_scoreTab == "question") criterion.Question = text;
        else criterion.Levels = text;
    }
    private async Task SelectScoreTabAsync(string tab)
    {
        if (_scoreTab == tab) return;
        await ReadScoreEditorAsync();
        _scoreTab = tab;
    }
    private async Task SelectScoreCriterionAsync(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var index) || index < 0 || index >= Vm.ScoreCriteria.Count) return;
        await ReadScoreEditorAsync();
        _scoreCriterion = Vm.ScoreCriteria[index];
    }
    private async Task AddScoreCriterionAsync()
    {
        await ReadScoreEditorAsync();
        Vm.AddScoreCriterion();
        _scoreCriterion = Vm.ScoreCriteria.LastOrDefault();
    }
    private void RemoveScoreCriterion()
    {
        if (CurrentScoreCriterion is { } criterion) Vm.RemoveScoreCriterion(criterion);
        _scoreCriterion = null;
    }
    private async Task SaveScoringInstructionsAsync()
    {
        await ReadScoreEditorAsync();
        Vm.SaveScoringAction();
    }

    private WorkflowInstructionsEditor? _loopInstructionsEditor;
    private WorkflowInstructionsEditor? _qemuCommandEditor;

    private async Task ReadQemuCommandAsync()
    {
        if (_qemuCommandEditor is not null)
        {
            Vm.QemuCommand = await _qemuCommandEditor.ReadAsync();
        }
    }

    private async Task SaveQemuActionAsync()
    {
        await ReadQemuCommandAsync();
        Vm.SaveQemuAction();
    }

    private async Task SaveQemuWorkflowAsync()
    {
        await ReadQemuCommandAsync();
        await Vm.SaveQemuWorkflowAsync();
    }

    private async Task SaveLoopInstructionsAsync()
    {
        if (_loopInstructionsEditor is not null)
            Vm.LoopInstructions = await _loopInstructionsEditor.ReadAsync();
        Vm.SaveLoopAction();
    }

    private WorkflowQueryEditor? _queryEditor;
    private int _queryStudioVersion;

    private async Task ReloadQuerySchemaAsync() => await Vm.LoadQueryStudioAsync();

    private async Task InsertQueryTextFromEditorAsync(string text)
    {
        if (_queryEditor is null) return;
        var value = await _queryEditor.InsertAsync(text);
        if (value is not null) Vm.QueryDataSql = value;
    }

    private async Task SetQuerySqlAsync(string? sql)
    {
        if (string.IsNullOrWhiteSpace(sql)) return;
        Vm.QueryDataSql = sql;
        if (_queryEditor is not null) await _queryEditor.SetValueAsync(sql);
    }

    private async Task BuildSelectedQueryAsync() => await SetQuerySqlAsync(Vm.BuildSelectedQuery());

    private async Task BuildCountQueryAsync() => await SetQuerySqlAsync(Vm.BuildCountQuery());

    private async Task InsertLimitAsync()
    {
        var sql = await ReadQueryEditorAsync();
        if (!WorkflowSql.EnsureLimit(sql, WorkflowSql.DefaultRowLimit, out var bounded))
        {
            Vm.ReportQueryHelperError(string.IsNullOrWhiteSpace(sql)
                ? "Write a query first, then add a LIMIT."
                : "This query already has a LIMIT.");
            return;
        }
        await SetQuerySqlAsync(bounded);
    }

    private async Task<string> ReadQueryEditorAsync()
    {
        var sql = _queryEditor is null ? Vm.QueryDataSql : await _queryEditor.ReadAsync();
        Vm.QueryDataSql = sql;
        return sql;
    }

    private async Task PreviewQueryAsync() => await Vm.PreviewQueryDataAsync(await ReadQueryEditorAsync());

    private async Task QueryValuesSearchKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await Vm.SearchQueryValuesAsync();
    }

    private async Task SaveQueryDataAsync()
    {
        await ReadQueryEditorAsync();
        Vm.SaveQueryDataAction();
    }

    private async Task CloseQueryStudioAsync()
    {
        await ReadQueryEditorAsync();
        Vm.CloseQueryDataEditor();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusExecution && Vm.ExecutionStep is not null)
        {
            _focusExecution = false;
            await _executionClose.FocusAsync();
        }
        if (Vm.ShowQueryDataEditor && _queryStudioVersion != Vm.QueryStudioVersion)
        {
            _queryStudioVersion = Vm.QueryStudioVersion;
            Vm.InsertQueryText = InsertQueryTextFromEditorAsync;
            await Vm.LoadQueryStudioAsync();
        }
    }

    private JobView? _codeJob;
    private WorkflowCodeWindow? _codeWindow;

    private async Task<bool> CloseCodeAsync()
    {
        if (_codeJob is not null && _codeWindow is not null && !await _codeWindow.ConfirmCloseAsync())
        {
            return false;
        }
        _codeJob = null;
        return true;
    }

    private async Task OpenCodeAsync(JobView job)
    {
        if (_codeJob?.Id == job.Id || !await CloseCodeAsync())
        {
            return;
        }
        _codeJob = job;
    }

    private async Task CloseWorkflowAsync()
    {
        if (await CloseCodeAsync())
        {
            Vm.CloseEditor();
        }
    }

    private async Task ShowWorkflowDetailsAsync()
    {
        if (await CloseCodeAsync())
        {
            Vm.ShowWorkflowDetails();
        }
    }

    private async Task SaveWorkflowAsync()
    {
        if (await CloseCodeAsync())
        {
            await Vm.SaveChainAsync();
        }
    }

    private string? _chainContextJson;
    private string? _chainContextJsonPath;

    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));

    protected override Task OnParametersSetAsync() => Vm.LoadPageAsync(ProjectId, WorkflowRouteId, WorkflowRouteRunId, WorkflowRouteView);

    public void Dispose()
    {
        Vm.DetachEvents();
        Vm.Detach();
    }

    private bool IsJsonLike(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        try
        {
            using var document = JsonDocument.Parse(value);
            return document.RootElement.ValueKind is JsonValueKind.Object or JsonValueKind.Array;
        }
        catch
        {
            return false;
        }
    }

    private static string GetJsonPreview(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "(empty)";

        var trimmed = value.Trim();
        const int max = 90;
        if (trimmed.Length <= max)
            return trimmed;

        return trimmed[..max] + "…";
    }

    private void OpenChainContextJson(string path, string value)
    {
        _chainContextJson = FormatJson(value);
        _chainContextJsonPath = path;
    }

    private void CloseChainContextJson()
    {
        _chainContextJson = null;
        _chainContextJsonPath = null;
    }

    private static string FormatJson(string raw)
    {
        try
        {
            using var document = JsonDocument.Parse(raw);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return raw;
        }
    }
}
