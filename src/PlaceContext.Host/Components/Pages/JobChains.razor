@page "/project/{ProjectId:guid}/workflows"
@page "/project/{ProjectId:guid}/chains"
@attribute [Authorize(Policy = Permission.ChainsManage)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@using PlaceContext.Application.Dtos
@using PlaceContext.Domain.ValueObjects
@using System.Text.Json
@using PlaceContext.Host.Components.ViewModels
@using PlaceContext.Host.Components.ViewModels.Helpers
@inject JobChainsViewModel Vm

<PageTitle>PlaceContext — Workflows</PageTitle>

@if (Vm.Loading)
{
    <Skeleton Kind="list" Rows="5" Padded />
}
else
{
    <div class="chains-page">
        <header class="chains-head">
            <div>
                <h2>Workflows</h2>
                <p>Connect reusable jobs into ordered pipelines, including parallel stages and delivery actions.</p>
            </div>
            <div class="head-actions">
                <button class="dcbtn" @onclick="Vm.NavigateToJobs">View jobs</button>
                <button class="dcbtn primary" @onclick="() => Vm.NewChain()"><AppIcon Kind="plus" /> New workflow</button>
            </div>
        </header>

        @if (Vm.Message is not null)
        {
            <div class="status-message">@Vm.Message</div>
        }

        @if (Vm.Chains is null or { Count: 0 })
        {
            <div class="dccard empty-state">
                <div class="empty-icon"><AppIcon Kind="chain" /></div>
                <strong>No workflows yet</strong>
                <span>Link reusable jobs into a pipeline, then run the whole workflow with one action.</span>
                <button class="dcbtn primary" @onclick="() => Vm.NewChain()">Create first workflow</button>
            </div>
        }
        else
        {
            <section class="summary-strip" aria-label="Workflow summary">
                <div class="summary-count"><strong>@Vm.Chains.Count</strong><span>workflows</span></div>
                <div class="summary-count"><strong>@Vm.Chains.Sum(chain => chain.Stages.Count)</strong><span>stages</span></div>
                <div class="summary-count"><strong>@Vm.Chains.Sum(chain => chain.Steps.Count)</strong><span>job steps</span></div>
                <div class="summary-count parallel"><strong>@Vm.Chains.Sum(chain => chain.Stages.Count(stage => stage.IsParallel))</strong><span>parallel</span></div>
            </section>

            <section class="dccard chain-suite">
                <header class="suite-head">
                    <div>
                        <span class="suite-caret"><AppIcon Kind="chevron-down" /></span>
                        <strong>Workflow catalogue</strong>
                        <span>@Vm.Chains.Count reusable pipeline@(Vm.Chains.Count == 1 ? "" : "s")</span>
                    </div>
                    <span class="suite-result">@Vm.Chains.Sum(chain => chain.Stages.Count) stages</span>
                </header>

                <div class="chain-rows">
                    @foreach (var chain in Vm.Chains)
                    {
                        var isRunning = Vm.IsRunningChain(chain.Id);
                        var parallelStages = chain.Stages.Count(stage => stage.IsParallel);
                        var actionStages = chain.Stages.Count(stage => stage.Action is not null);
                        <article class="chain-row @(isRunning ? "running" : null)" @onclick="@(() => Vm.OpenChainEditorAsync(chain))">
                            <div class="status-icon @(isRunning ? "is-running" : null)" aria-label="@Vm.ChainStatusAria(isRunning)">
                                @if (isRunning)
                                {
                                    <span class="spinner"></span>
                                }
                                else
                                {
                                    <span><AppIcon Kind="chain" /></span>
                                }
                            </div>
                            <div class="chain-copy">
                                <div class="chain-title">
                                    <strong>@chain.Name</strong>
                                    <span class="chain-chip">@chain.Stages.Count stage@(chain.Stages.Count == 1 ? "" : "s")</span>
                                    <span class="chain-chip">@chain.Steps.Count job step@(chain.Steps.Count == 1 ? "" : "s")</span>
                                    @if (parallelStages > 0)
                                    {
                                        <span class="chain-chip brand-chip">@parallelStages parallel</span>
                                    }
                                    @if (actionStages > 0)
                                    {
                                        <span class="chain-chip action-chip">@actionStages delivery action@(actionStages == 1 ? "" : "s")</span>
                                    }
                                </div>
                                <div class="chain-detail">
                                    <span>@(string.IsNullOrWhiteSpace(chain.Description) ? "No description" : chain.Description)</span>
                                    <span class="chain-facts">updated @Vm.Presentation.Date(chain.UpdatedAt)</span>
                                </div>
                                <div class="step-chips">
                                    @foreach (var (stage, i) in chain.Stages.Select((s, i) => (s, i)))
                                    {
                                        if (i > 0)
                                        {
                                            <span class="chip-arrow"><AppIcon Kind="arrow-right" /></span>
                                        }
                                        @if (stage.Action is SendEmailChainActionView emailAction)
                                        {
                                            <span class="step-chip" style="color:var(--brand-2)"><AppIcon Kind="mail" /> Send email · @emailAction.Recipient</span>
                                        }
                                        else if (stage.Action is SendSmsChainActionView smsAction)
                                        {
                                            <span class="step-chip" style="color:var(--brand-2)"><AppIcon Kind="message" /> Send SMS · @smsAction.Recipient</span>
                                        }
                                        else if (stage.Action is LoopChainActionView loopAction)
                                        {
                                            <span class="step-chip loop-chip">@loopAction.DisplayName</span>
                                        }
                                        else if (stage.Action is QemuChainActionView vmAction)
                                        {
                                            <span class="step-chip"><AppIcon Kind="vm" /> QEMU · @vmAction.ImageProfile</span>
                                        }
                                        else if (stage.IsParallel)
                                        {
                                            <span class="stage-group" title="parallel fan-out — all run at once">
                                                @foreach (var (job, j) in stage.Jobs.Select((s, j) => (s, j)))
                                                {
                                                    if (j > 0)
                                                    {
                                                        <span class="chip-plus"><AppIcon Kind="plus" /></span>
                                                    }
                                                    <span class="step-chip" style="color:@Vm.JobChipColor(job.JobName)">@job.JobName</span>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="step-chip" style="color:@Vm.JobChipColor(stage.Jobs[0].JobName)">@stage.Jobs[0].JobName</span>
                                        }
                                    }
                                </div>
                            </div>
                            <div class="chain-actions">
                                @if (Vm.ConfirmDeleteId == chain.Id)
                                {
                                    <button class="dcbtn" @onclick:stopPropagation="true" @onclick="@(() => Vm.DeleteChainAsync(chain.Id))">Delete</button>
                                    <button class="dcbtn" @onclick:stopPropagation="true" @onclick="@(() => Vm.ConfirmDeleteId = null)">Keep</button>
                                }
                                else
                                {
                                    <button class="icon-action run-action" title="Run workflow" aria-label="Run @chain.Name"
                                            disabled="@isRunning" @onclick:stopPropagation="true"
                                            @onclick="@(() => Vm.RunChainAsync(chain))"><AppIcon Kind="play" /></button>
                                    <button class="icon-action" title="Edit workflow" aria-label="Edit @chain.Name"
                                            @onclick:stopPropagation="true" @onclick="@(() => Vm.OpenChainEditorAsync(chain))"><AppIcon Kind="edit" /></button>
                                    <button class="icon-action" title="Delete workflow" aria-label="Delete @chain.Name"
                                            @onclick:stopPropagation="true" @onclick="@(() => Vm.ConfirmDeleteId = chain.Id)"><AppIcon Kind="trash" /></button>
                                }
                            </div>
                        </article>
                    }
                </div>
            </section>
        }
    </div>
}

@* ── Chain slide-out: Details (edit) | Runs (pipeline history, live) ─────────────────────── *@
@if (Vm.ShowEditor)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseEditor()"></div>
    <div class="dcslide slide-640">
        <div class="dcslide-head">
            <div class="flex-min">
                <div class="title-14">@(Vm.EditChainId.HasValue ? Vm.EdName : "New workflow")</div>
                <div class="sub-115">
                    Connect jobs, human decisions, and agent responses into one workflow.
                </div>
            </div>
            @if (Vm.EditChainId.HasValue && Vm.Chains?.FirstOrDefault(c => c.Id == Vm.EditChainId) is { } runnable)
            {
                <button class="dcbtn primary mr-10" disabled="@Vm.IsRunningChain(runnable.Id)" @onclick="@(() => Vm.RunChainAsync(runnable))">
                    <AppIcon Kind="play" /> @(Vm.IsRunningChain(runnable.Id) ? "running…" : "Run")
                </button>
            }
            <button aria-label="Close" class="dcslide-x" @onclick="() => Vm.CloseEditor()"><AppIcon Kind="close" /></button>
        </div>

        @if (Vm.EditChainId.HasValue)
        {
            <div class="dctabs editor-tabs">
                <button class="dctab @(Vm.IsDetailsTab ? "active" : "")" @onclick="@(() => Vm.EditorTab = "details")">Details</button>
                <button class="dctab @(Vm.IsRunsTab ? "active" : "")" @onclick="() => Vm.SwitchToRunsTabAsync()">Runs<span class="n">@(Vm.ChainRuns?.Count ?? 0)</span></button>
            </div>
        }

        @if (Vm.IsRunsTab && Vm.EditChainId.HasValue)
        {
            <div class="dcslide-body runs-body">
                @if (Vm.OpenRun is null)
                {
                    @if (Vm.ChainRuns is null or { Count: 0 })
                    {
                        <div class="no-runs">No runs yet — click Run to start the pipeline.</div>
                    }
                    else
                    {
                        @foreach (var run in Vm.ChainRuns)
                        {
                            <div class="dccard run-card" @onclick="@(() => Vm.OpenChainRunAsync(run))">
                                <div class="run-row">
                                    <span class="status-chip" style="color:@Vm.Presentation.StatusColor(run.Status); background:@Vm.Presentation.StatusBackground(run.Status)">@run.Status</span>
                                    <span class="run-time">
                                        @Vm.Presentation.DateTime(run.StartedAt)
                                    </span>
                                    <span class="meta-11">
                                        @Vm.SucceededSteps(run)/@run.Steps.Count steps
                                    </span>
                                    @if (run.FinishedAt.HasValue)
                                    {
                                        <span class="dur-meta">
                                            @Vm.Presentation.Duration(run.StartedAt, run.FinishedAt.Value)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="running-note">running…</span>
                                    }
                                    @if (Vm.IsChainRunActive(run.Status))
                                    {
                                        <button class="dcbtn btn-2-8 text-bad" @onclick:stopPropagation="true"
                                                @onclick="@(() => Vm.CancelChainRunAsync(run.Id))">Cancel</button>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <button class="dcbtn btn-start" @onclick="@(() => Vm.CloseChainRun())"><AppIcon Kind="arrow-left" /> All runs</button>

                    <div class="status-row">
                        <span class="status-chip-lg" style="color:@Vm.Presentation.StatusColor(Vm.OpenRun.Status); background:@Vm.Presentation.StatusBackground(Vm.OpenRun.Status)">@Vm.OpenRun.Status</span>
                        <span class="dur-meta">
                            @Vm.Presentation.DateTime(Vm.OpenRun.StartedAt)
                            @(Vm.OpenRun.FinishedAt.HasValue ? " · took " + Vm.Presentation.Duration(Vm.OpenRun.StartedAt, Vm.OpenRun.FinishedAt.Value) : " · live")
                        </span>
                        @if (Vm.IsChainRunActive(Vm.OpenRun.Status))
                        {
                            <button class="dcbtn btn-2-8 text-bad" @onclick="@(() => Vm.CancelChainRunAsync(Vm.OpenRun.Id))">Cancel run</button>
                        }
                    </div>

                    @if (Vm.OpenRun.InputRequest is { } inputRequest)
                    {
                        <section class="workflow-input" aria-label="Required workflow inputs">
                            <span class="workflow-eyebrow">Workflow paused</span>
                            <h3>@(inputRequest.Kind == LoopChainAction.HumanType ? inputRequest.Instructions ?? "Your response is needed" : inputRequest.Kind == LoopChainAction.AgentType ? "Waiting for an agent response" : "Input required")</h3>
                            @if (inputRequest.Instructions is not null)
                            {
                                @if (inputRequest.Kind != LoopChainAction.HumanType) { <p class="loop-instructions">@inputRequest.Instructions</p> }
                                <p class="sub-note">Review the accumulated context below, then submit a response to continue.</p>
                            }
                            else
                            {
                                <p>Complete the required fields to continue from this stage.</p>
                            }
                            @if (inputRequest.ResponseType == LoopChainAction.YesNoResponse)
                            {
                                <p class="sub-note">Choose Yes or No to continue. The answer is saved as true or false for later jobs and conditions.</p>
                            }
                            else
                            {
                            @foreach (var step in inputRequest.Steps)
                            {
                                <h4>@step.JobName</h4>
                                @foreach (var field in step.Parameters)
                                {
                                    <div class="dcfield">
                                        @if (inputRequest.Kind is LoopChainAction.HumanType or LoopChainAction.AgentType)
                                        {
                                            <label for="loop-response">Response <span class="req">*</span></label>
                                            <textarea id="loop-response" class="dcinput" rows="5" required
                                                      value="@Vm.GetResumeArg(step.Index, field.Name)"
                                                      @oninput="@(e => Vm.SetResumeArg(step.Index, field.Name, e.Value?.ToString() ?? ""))"></textarea>
                                            <span class="sub-note">Saved as <code>@field.Name</code> for the next steps.</span>
                                        }
                                        else
                                        {
                                        <label>@(field.Label ?? field.Name) @(field.Required ? "*" : "")</label>
                                        <ParamInput Parameter="field" ProjectId="@ProjectId" Value="@Vm.GetResumeArg(step.Index, field.Name)"
                                                    ValueChanged="@(value => Vm.SetResumeArg(step.Index, field.Name, value))" />
                                        }
                                    </div>
                                }
                            }
                            }
                            @if (Vm.ResumeError is not null) { <p role="alert">@Vm.ResumeError</p> }
                            @if (inputRequest.ResponseType == LoopChainAction.YesNoResponse)
                            {
                                <div class="human-decision-actions" aria-label="Answer the question">
                                    <button class="dcbtn primary" disabled="@Vm.Resuming" @onclick="() => Vm.RespondYesNoAsync(true)"><AppIcon Kind="check" /> Yes</button>
                                    <button class="dcbtn" disabled="@Vm.Resuming" @onclick="() => Vm.RespondYesNoAsync(false)"><AppIcon Kind="close" /> No</button>
                                    @if (Vm.Resuming) { <span role="status">Resuming…</span> }
                                </div>
                            }
                            else
                            {
                                <button class="dcbtn primary" disabled="@Vm.Resuming" @onclick="Vm.ResumeWithInputsAsync">@(Vm.Resuming ? "Resuming…" : "Submit and continue")</button>
                            }
                        </section>
                    }

                    @if (Vm.OpenRun.Steps.Any(step => step.ActionType == QemuChainAction.ActionType))
                    {
                        <QemuReplay @key="Vm.OpenRun.Id" Run="Vm.OpenRun" />
                    }

                    <div class="running-steps-panel">
                        <div class="running-steps-head">
                            <span>Running steps</span>
                            <span>@Vm.SucceededSteps(Vm.OpenRun)/@Vm.OpenRun.Steps.Count complete</span>
                        </div>
                    <ChainPipeline Run="Vm.OpenRun" OnStepClick="@Vm.OpenStepRunAsync"
                                   OnStepCancel="@(step => Vm.CancelStepRunAsync(step.RunId!.Value))" />
                    </div>

                    <section class="workflow-job-logs" aria-label="Underlying job logs">
                        <div class="job-log-selector">
                            <div><span class="workflow-eyebrow">Execution details</span><h3>Underlying job logs</h3></div>
                            <label for="chain-log-job">Job run</label>
                            <select id="chain-log-job" class="dcinput" value="@Vm.SelectedStepRunId" @onchange="@(e => Vm.SelectLogStepAsync(e.Value?.ToString()))">
                                <option value="">Select a job step…</option>
                                @foreach (var step in Vm.OpenRun.Steps.Where(step => step.RunId.HasValue))
                                {
                                    <option value="@step.RunId">@(step.Index + 1). @step.JobName · @step.Status</option>
                                }
                            </select>
                        </div>
                        @if (Vm.StepOutputError is not null) { <p class="danger" role="alert">@Vm.StepOutputError</p> }
                        @if (Vm.StepRunDetail is { } loggedRun)
                        {
                            <JobRunLogs Run="loggedRun" />
                        }
                        else
                        {
                            <p class="sub-note">@(Vm.SelectedStepRunId.HasValue ? "Loading logs…" : "Logs appear here when a job starts. Human and agent hand-offs do not launch a job.")</p>
                        }
                    </section>

                    @if (Vm.ContextRows.Count > 0)
                    {
                        <div class="chain-context-panel">
                            <div class="out-label">Accumulated workflow context</div>
                            <div class="chain-context-scroll">
                                <table class="chain-context-table">
                                    <thead>
                                        <tr>
                                            <th class="chain-context-cell chain-context-path">Field</th>
                                            <th class="chain-context-cell">Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var row in Vm.ContextRows)
                                        {
                                            var isJson = IsJsonLike(row.Value);
                                            <tr>
                                                <td class="chain-context-cell chain-context-path"><code>@row.Path</code></td>
                                                <td class="chain-context-cell">
                                                    @if (isJson)
                                                    {
                                                        <button class="dcbtn btn-2-8 json-view-button"
                                                                @onclick="@(() => OpenChainContextJson(row.Path, row.Value))">
                                                            View JSON
                                                        </button>
                                                        <span class="chain-context-preview">@GetJsonPreview(row.Value)</span>
                                                    }
                                                    else
                                                    {
                                                        <code class="chain-context-value">@row.Value</code>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }

                    @if (Vm.OpenRun.FinalOutput is { Length: > 0 })
                    {
                        <div>
                            <div class="out-label">Pipeline output</div>
                            <RunOutput Value="@(Vm.Presentation.Json(Vm.OpenRun.FinalOutput))" />
                        </div>
                    }

                    @if (Vm.StepRunDetail is { } d)
                    {
                        <div class="stage-detail live-output-panel">
                            <div class="stage-detail-head">
                                <span class="live-output-title">
                                    @if (Vm.IsRunningStep(d.Status))
                                    {
                                        <i class="output-live-dot"></i>
                                    }
                                    @Vm.StepOutputTitle(d.Status)
                                    <b>@(Vm.OpenRun.Steps.FirstOrDefault(s => s.RunId == d.Id)?.JobName)</b>
                                </span>
                                <span class="status-chip-sm" style="color:@Vm.Presentation.StatusColor(d.Status); background:@Vm.Presentation.StatusBackground(d.Status)">@d.Status</span>
                                <span class="flex-1"></span>
                                @if (Vm.LiveOutputUpdatedAt is { } outputAt)
                                {
                                    <span class="output-updated">updated @Vm.Presentation.Format(outputAt, "HH:mm:ss")</span>
                                }
                                <button class="dcbtn btn-xs"
                                        @onclick="Vm.NavigateToJobs">open in Jobs <AppIcon Kind="arrow-right" /></button>
                            </div>
                            @foreach (var shard in d.ShardResults)
                            {
                                <div class="mb-8">
                                    <div class="shard-head">shard @shard.Index — @shard.Outcome (exit @shard.ExitCode)</div>
                                    @if (shard.Artifact is not null)
                                    {
                                        <RunOutput Value="@(Vm.Presentation.Json(shard.Artifact))" />
                                    }
                                </div>
                            }
                            @if (d.ReduceResult is { } reduce)
                            {
                                <div class="mb-8">
                                    <div class="shard-head">reduce — @Vm.ReduceStatusLabel(reduce.Succeeded) (exit @reduce.ExitCode)</div>
                                    @if (!string.IsNullOrWhiteSpace(reduce.Artifact))
                                    {
                                        <RunOutput Value="@(Vm.Presentation.Json(reduce.Artifact))" />
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
        else
        {
            var canvasStages = Vm.BuildCanvasStageViews();
        <div class="dcslide-body editor-body">

            <div class="field-row">
                <div class="dcfield flex-1">
                    <label>Name <span class="req">*</span></label>
                    <input class="dcinput" @bind="Vm.EdName" placeholder="my-pipeline" />
                </div>
                <div class="dcfield flex-14">
                    <label>Description</label>
                    <input class="dcinput" @bind="Vm.EdDescription" placeholder="What does this workflow produce? (optional)" />
                </div>
            </div>

            @* ── Canvas / List toggle ────────────────────────────────────────────────────── *@
            <div class="dctabs editor-tabs sub-tabs">
                <button class="dctab @(Vm.IsCanvasView ? "active" : "")" @onclick="@(() => Vm.EditorView = "canvas")">
                    <span class="tab-icon"><AppIcon Kind="data.graph" /></span> Canvas
                </button>
                <button class="dctab @(!Vm.IsCanvasView ? "active" : "")" @onclick="@(() => Vm.EditorView = "list")">
                    <span class="tab-icon"><AppIcon Kind="logs" /></span> List
                </button>
            </div>

            @if (Vm.IsCanvasView)
            {
                @* ── Canvas view ──────────────────────────────────────────────────────────── *@
                <div class="workflow-builder">
                    <aside class="workflow-palette" aria-label="Workflow steps">
                        <span class="workflow-eyebrow">Step library</span>
                        <h3>Build your workflow</h3>
                        <p>Add a step, then configure what happens.</p>
                        <span class="palette-label">People &amp; agents</span>
                        <button class="palette-step human-step" @onclick="@(() => Vm.OpenLoopActionAt(LoopChainAction.HumanType, Vm.EdStages.Count))">
                            <span class="palette-icon" aria-hidden="true"><AppIcon Kind="human" /></span>
                            <span><strong>Human in the loop</strong><small>Pause for review or input</small></span>
                            <span aria-hidden="true"><AppIcon Kind="plus" /></span>
                        </button>
                        <button class="palette-step agent-step" @onclick="@(() => Vm.OpenLoopActionAt(LoopChainAction.AgentType, Vm.EdStages.Count))">
                            <span class="palette-icon" aria-hidden="true"><AppIcon Kind="agent" /></span>
                            <span><strong>Agent in the loop</strong><small>Ask Jev or an external agent</small></span>
                            <span aria-hidden="true"><AppIcon Kind="plus" /></span>
                        </button>
                        <span class="palette-label">Automate</span>
                        <button class="palette-step" @onclick="@(() => Vm.OpenQemuActionAt(Vm.EdStages.Count))">
                            <span class="palette-icon" aria-hidden="true"><AppIcon Kind="vm" /></span>
                            <span><strong>QEMU environment</strong><small>Run a task in a fresh virtual machine</small></span>
                            <span aria-hidden="true"><AppIcon Kind="plus" /></span>
                        </button>
                        <button class="palette-step" @onclick="@(() => Vm.OpenStageNodePicker(Vm.EdStages.Count))">
                            <span class="palette-icon" aria-hidden="true"><AppIcon Kind="box" /></span>
                            <span><strong>Jobs &amp; actions</strong><small>Run a job, send a message, or add a gate</small></span>
                            <span aria-hidden="true"><AppIcon Kind="plus" /></span>
                        </button>
                        <div class="palette-note">Each step passes its output forward. Human and agent steps wait for a response before continuing.</div>
                    </aside>
            <ChainCanvas Stages="canvasStages"
                         Jobs="@(Vm.Jobs ?? Array.Empty<JobView>())"
                         Gates="@Vm.BuildCanvasGates()"
                         OnAddGate="@(stageIndex => Vm.OpenStageNodePicker(stageIndex))"
                         OnEditGate="@(pair => Vm.OpenGateEditor(pair.StageIndex))"
                         OnEditEmailAction="@(stageIndex => Vm.OpenEmailActionEditor(stageIndex))"
                         OnEditSmsAction="@(stageIndex => Vm.OpenSmsActionEditor(stageIndex))"
                         OnEditLoopAction="@(stageIndex => Vm.EditLoopAction(stageIndex))"
                         OnEditQemuAction="Vm.EditQemuAction"
                         OnAddPath="@(item => Vm.AddPath(item.StageIndex, item.JobId))"
                         OnMoveStage="@(move => Vm.MoveStageTo(move.SourceIndex, move.TargetIndex))"
                         OnMovePath="@(move => Vm.MovePath(move.SourceStage, move.SourceBranch, move.TargetStage))"
                         OnRemovePath="@(item => Vm.RemoveBranch(item.StageIndex, item.BranchIndex))"
                         OnRemoveStage="@(stageIndex => Vm.RemoveStage(stageIndex))" />
                </div>
            }

            @if (!Vm.IsCanvasView)
            {
            <section class="workflow-list" aria-label="Workflow stages">
                <div class="workflow-list-heading">
                    <div><h3>Workflow steps <span>@Vm.EdStages.Count</span></h3><p>Steps run in order. Jobs within a parallel stage run together.</p></div>
                    <button class="dcbtn" @onclick="@(() => Vm.OpenStageNodePicker(Vm.EdStages.Count))"><AppIcon Kind="plus" /> Add step</button>
                </div>
                @if (Vm.EdStages.Count == 0)
                {
                    <div class="empty-steps">Your workflow starts here. Add a job, an action, or a review step.</div>
                }
                else
                {
                    <ol class="step-list">
                        @foreach (var (stage, i) in Vm.EdStages.Select((s, i) => (s, i)))
                        {
                            var stageIndex = i;
                            var stageView = canvasStages[stageIndex];
                            var stageGate = Vm.EdStageGates.GetValueOrDefault(stageIndex);
                            <li class="stage-item">
                                <div class="list-stage-head">
                                    <span class="step-num">@(stageIndex + 1)</span>
                                    <AppIcon Kind="@ChainCanvasViewModel.StageIcon(stageView)" />
                                    <strong>@(stageView.Action?.DisplayName ?? (stage.Count > 1 ? "Parallel jobs" : "Job"))</strong>
                                    @if (stage.Count > 1) { <span class="list-stage-count">@stage.Count jobs</span> }
                                    <div class="list-stage-actions">
                                        <button aria-label="@($"Move step {stageIndex + 1} up")" title="Move up" class="dcbtn" disabled="@(stageIndex == 0)" @onclick="@(() => Vm.MoveStage(stageIndex, -1))"><AppIcon Kind="arrow-up" /></button>
                                        <button aria-label="@($"Move step {stageIndex + 1} down")" title="Move down" class="dcbtn" disabled="@(stageIndex == Vm.EdStages.Count - 1)" @onclick="@(() => Vm.MoveStage(stageIndex, +1))"><AppIcon Kind="arrow-down" /></button>
                                        <button aria-label="@($"Remove step {stageIndex + 1}")" title="Remove step" class="dcbtn danger" @onclick="@(() => Vm.RemoveStage(stageIndex))"><AppIcon Kind="close" /></button>
                                    </div>
                                </div>
                                <div class="list-stage-body">
                                    @if (stageGate is not null)
                                    {
                                        <div class="list-stage-gate">
                                            <button class="dcbtn" @onclick="@(() => Vm.OpenGateEditor(stageIndex))">
                                                <AppIcon Kind="@(stageGate is WaitGate ? "clock" : "split")" />
                                                <span>@(stageGate is WaitGate wait ? $"Wait {wait.Duration.TotalSeconds:0.#} seconds" : stageGate is ConditionGate condition ? $"If {condition.Expression}" : "Edit gate")</span>
                                            </button>
                                            <button class="dcbtn danger" aria-label="@($"Remove gate from step {stageIndex + 1}")" title="Remove gate" @onclick="@(() => Vm.RemoveGate(stageIndex))"><AppIcon Kind="close" /></button>
                                        </div>
                                    }
                                    <div class="stage-jobs">
                                        @if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is SendEmailChainAction emailAction)
                                        {
                                            <button class="stage-job-chip" @onclick="@(() => Vm.OpenEmailActionEditor(stageIndex))"><AppIcon Kind="mail" /><span><strong>Send email</strong><small>@emailAction.Recipient</small></span><span class="list-configure">Edit</span></button>
                                        }
                                        else if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is SendSmsChainAction smsAction)
                                        {
                                            <button class="stage-job-chip" @onclick="@(() => Vm.OpenSmsActionEditor(stageIndex))"><AppIcon Kind="message" /><span><strong>Send SMS</strong><small>@smsAction.Recipient</small></span><span class="list-configure">Edit</span></button>
                                        }
                                        else if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is QemuChainAction vmAction)
                                        {
                                            <button class="stage-job-chip" @onclick="@(() => Vm.EditQemuAction(stageIndex))"><AppIcon Kind="vm" /><span><strong>@vmAction.ImageProfile</strong><small>@vmAction.MemoryMb MiB · @vmAction.Cpus CPU(s) · @vmAction.TimeoutSeconds s timeout</small></span><span class="list-configure">Configure</span></button>
                                        }
                                        else if (Vm.EdStageActions.GetValueOrDefault(stageIndex) is LoopChainAction loopAction)
                                        {
                                            <button class="stage-job-chip" @onclick="@(() => Vm.EditLoopAction(stageIndex))"><AppIcon Kind="@(loopAction.Type == LoopChainAction.HumanType ? "human" : "agent")" /><span><strong>@loopAction.DisplayName</strong><small>Response saved to @loopAction.ResponseField</small></span><span class="list-configure">Edit</span></button>
                                        }
                                        @foreach (var (jobId, j) in stage.Select((id, j) => (id, j)))
                                        {
                                            var branchIndex = j;
                                            <div class="stage-job-chip"><AppIcon Kind="code" /><span class="list-job-name">@Vm.JobName(jobId)</span><button class="dcbtn danger" aria-label="@($"Remove {Vm.JobName(jobId)} from step {stageIndex + 1}")" title="Remove job" @onclick="@(() => Vm.RemoveBranch(stageIndex, branchIndex))"><AppIcon Kind="close" /></button></div>
                                        }
                                    </div>
                                    @if (stageGate is ConditionGate { ElseBranch: { Count: > 0 } other })
                                    {
                                        <div class="list-false-path"><strong>When false</strong><WorkflowBranchPreview Stages="@other.Select(Vm.BuildStageView).ToList()" /><button class="dcbtn" @onclick="@(() => Vm.OpenGateEditor(stageIndex))">Edit false path</button></div>
                                    }
                                    @if (!Vm.HasStageAction(stageIndex))
                                    {
                                        <div class="stage-branch-row">
                                            <select class="dcinput branch-select" aria-label="@($"Parallel job for step {stageIndex + 1}")" value="@Vm.EdBranchJobIds.GetValueOrDefault(stageIndex, "")" @onchange="@((e) => Vm.SetBranchJobId(stageIndex, e))">
                                                <option value="">Choose a parallel job…</option>
                                                @foreach (var job in Vm.Jobs ?? Array.Empty<JobView>()) { <option value="@job.Id">@job.Name</option> }
                                            </select>
                                            <button class="dcbtn" disabled="@(string.IsNullOrEmpty(Vm.EdBranchJobIds.GetValueOrDefault(stageIndex, "")))" @onclick="@(() => Vm.AddBranch(stageIndex))"><AppIcon Kind="plus" /> Add parallel job</button>
                                        </div>
                                    }
                                    <div class="list-stage-footer">
                                        @if (stageGate is null) { <button class="dcbtn" @onclick="@(() => Vm.OpenGateEditor(stageIndex))"><AppIcon Kind="split" /> Add condition or delay</button> }
                                        <button class="dcbtn" @onclick="@(() => Vm.OpenStageNodePicker(stageIndex))"><AppIcon Kind="plus" /> Insert step before</button>
                                    </div>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>
            }

        </div>
        }

        @* ── Unified connector step picker ─────────────────────────────────────────────── *@
        @if (Vm.ShowStageNodePicker)
        {
            <div class="dcmodal-overlay" @onclick="() => Vm.CloseStageNodePicker()">
                <div class="dcmodal pipeline-step-modal" role="dialog" aria-modal="true" aria-label="Add pipeline step" @onclick:stopPropagation="true">
                    <div class="dcmodal-head">
                        <div>
                            <div class="title-14">Add pipeline step</div>
                            <div class="sub-115">@(Vm.StageNodePickerIndex >= Vm.EdStages.Count ? "Add a step at the end of the workflow." : $"Insert a step before stage {Vm.StageNodePickerIndex + 1}.")</div>
                        </div>
                        <button class="dcslide-x pipeline-modal-close" aria-label="Close add pipeline step"
                                @onclick="() => Vm.CloseStageNodePicker()"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body pipeline-step-body">
                        <div class="node-picker-divider">People &amp; agents</div>
                        <div class="node-picker-grid">
                            <button class="node-picker-tile human-step" @onclick="@(() => Vm.ChooseStageNode(LoopChainAction.HumanType))">
                                <span class="palette-icon" aria-hidden="true"><AppIcon Kind="human" /></span>
                                <strong>Human in the loop</strong><small>Pause for a person to review and respond</small>
                            </button>
                            <button class="node-picker-tile agent-step" @onclick="@(() => Vm.ChooseStageNode(LoopChainAction.AgentType))">
                                <span class="palette-icon" aria-hidden="true"><AppIcon Kind="agent" /></span>
                                <strong>Agent in the loop</strong><small>Ask Jev or wait for an external agent</small>
                            </button>
                        </div>
                        <div class="node-picker-divider">Jobs</div>
                        <button class="node-picker-tile" @onclick="@(() => Vm.ChooseStageNode(QemuChainAction.ActionType))">
                            <span class="palette-icon" aria-hidden="true"><AppIcon Kind="vm" /></span>
                            <strong>QEMU environment</strong><small>Run a task in a fresh virtual machine</small>
                        </button>
                        <div class="job-picker-grid">
                            @foreach (var job in Vm.Jobs ?? Array.Empty<JobView>())
                            {
                                <button class="job-picker-tile" @onclick="@(() => Vm.ChooseStageJob(job.Id))">
                                    <span class="job-picker-icon"><AppIcon Kind="code" /></span>
                                    <span>
                                        <strong>@job.Name</strong>
                                        <small>@(string.IsNullOrWhiteSpace(job.Description) ? "Reusable job" : job.Description)</small>
                                    </span>
                                </button>
                            }
                        </div>
                        @if (Vm.Jobs is null or { Count: 0 })
                        {
                            <div class="job-picker-empty">No jobs yet. Create a job before adding it to a workflow.</div>
                        }
                        <div class="node-picker-divider">Actions and control</div>
                        <div class="node-picker-grid">
                        <button class="node-picker-tile" disabled="@(!Vm.CanSendEmailAction)" @onclick="@(() => Vm.ChooseStageNode("email"))">
                            <span class="node-picker-icon" aria-hidden="true">
                                <AppIcon Kind="mail" />
                            </span>
                            <strong>Send email</strong><small>Email through workspace communications</small>
                        </button>
                        <button class="node-picker-tile" disabled="@(!Vm.CanSendSmsAction)" @onclick="@(() => Vm.ChooseStageNode("sms"))">
                            <span class="node-picker-icon" aria-hidden="true">
                                <AppIcon Kind="message" />
                            </span>
                            <strong>Send SMS</strong><small>Text message through workspace communications</small>
                        </button>
                        <button class="node-picker-tile" @onclick="Vm.ChooseConditionNode">
                            <span class="node-picker-icon" aria-hidden="true">
                                <AppIcon Kind="split" />
                            </span>
                            <strong>Condition</strong><small>Continue when payload matches</small>
                        </button>
                        <button class="node-picker-tile" @onclick="Vm.ChooseWaitNode">
                            <span class="node-picker-icon" aria-hidden="true">
                                <AppIcon Kind="clock" />
                            </span>
                            <strong>Delay / gate</strong><small>Wait before the next stage</small>
                        </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (Vm.ShowQemuEditor)
        {
            var imageAvailable = Vm.QemuEnvironment.Images.Any(image => image.Name == Vm.QemuImageProfile && image.Available);
            var environmentReady = Vm.QemuEnvironment.Enabled && Vm.QemuEnvironment.AgentReady && imageAvailable;
            <div class="dcmodal-overlay" @onclick="Vm.CloseQemuEditor">
                <div class="dcmodal qemu-modal" role="dialog" aria-modal="true" aria-labelledby="qemu-editor-title" @onclick:stopPropagation="true">
                    <div class="dcmodal-head">
                        <span class="qemu-heading-icon"><AppIcon Kind="vm" /></span>
                        <div><span class="workflow-eyebrow">Workflow step</span><h3 id="qemu-editor-title">QEMU environment</h3><p class="sub-note">Give an agent a task in a fresh Linux desktop.</p></div>
                        <button class="dcslide-x" aria-label="Close QEMU settings" @onclick="Vm.CloseQemuEditor"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body">
                        <section class="qemu-section" aria-labelledby="qemu-task-title">
                            <h4 id="qemu-task-title">Task</h4>
                            <div class="dcfield"><label for="qemu-command">What should the agent do?</label><textarea id="qemu-command" class="dcinput" rows="7" maxlength="8192" @bind="Vm.QemuCommand" @bind:event="oninput" aria-describedby="qemu-task-help"></textarea><small id="qemu-task-help">Include a starting URL, the actions to take, and how to verify the result. The agent also receives the workflow context.</small></div>
                        </section>
                        <section class="qemu-section" aria-labelledby="qemu-environment-title">
                            <h4 id="qemu-environment-title">Environment</h4>
                            <div class="dcfield"><label for="qemu-image">Image profile</label><input id="qemu-image" class="dcinput" list="qemu-profiles" maxlength="80" placeholder="browser-linux" @bind="Vm.QemuImageProfile" @bind:event="oninput" /><datalist id="qemu-profiles">@foreach (var profile in Vm.QemuEnvironment.Images.Where(image => image.Available)) { <option value="@profile.Name" /> }</datalist><small>Choose a Linux desktop profile available on your execution hosts.</small></div>
                            <div class="qemu-readiness" role="status">
                                <span class="qemu-status @(environmentReady ? "ready" : "")"><AppIcon Kind="@(environmentReady ? "check" : "warning")" /> @(environmentReady ? "Ready to run" : "Setup required")</span>
                                @if (!Vm.QemuEnvironment.Enabled) { <p>Execution is disabled on this host. You can save this step; an administrator must enable QEMU to run it.</p> }
                                @if (Vm.QemuEnvironment.Enabled && !imageAvailable) { <p>This image profile is unavailable on this host. Configure its image before running.</p> }
                                @if (!Vm.QemuEnvironment.AgentReady) { <p>The task agent needs an execution provider and model credentials.</p> }
                                else { <p>Agent model: <strong>@Vm.QemuEnvironment.AgentModel</strong></p> }
                            </div>
                            <label class="qemu-network" for="qemu-network"><span><strong>Network access</strong><small>Allow access to websites and services outside the VM.</small></span><input id="qemu-network" type="checkbox" role="switch" @bind="Vm.QemuAllowNetwork" /></label>
                        </section>
                        <section class="qemu-section" aria-labelledby="qemu-login-title">
                            <h4 id="qemu-login-title">Login &amp; human control</h4>
                            <div class="dcfield"><label for="qemu-login">Saved browser session</label>
                                <select id="qemu-login" class="dcinput" @bind="Vm.QemuLoginId">
                                    <option value="">Fresh browser — no saved login</option>
                                    @if (!string.IsNullOrEmpty(Vm.QemuLoginId) && !Vm.QemuLogins.Any(p => p.Id.ToString() == Vm.QemuLoginId && p.ImageProfile == Vm.QemuImageProfile))
                                    { <option value="@Vm.QemuLoginId">Saved login unavailable — choose your own session</option> }
                                    @foreach (var profile in Vm.QemuLogins.Where(p => p.ImageProfile == Vm.QemuImageProfile))
                                    { <option value="@profile.Id">@profile.Name</option> }
                                </select><small>Only your private sessions for this project and image are listed. Each run gets its own copy.</small>
                            </div>
                            <div class="qemu-login-actions">
                                <button class="dcbtn" @onclick="Vm.LoadQemuLoginsAsync">Refresh logins</button>
                                @if (!string.IsNullOrEmpty(Vm.QemuLoginId)) { <button class="dcbtn" @onclick="Vm.ForgetQemuLoginAsync">Forget selected login</button> }
                            </div>
                            @if (Vm.QemuLoginError is not null) { <p role="alert">@Vm.QemuLoginError</p> }
                            <label class="qemu-network" for="qemu-login-pause"><span><strong>Pause for login before starting</strong><small>Open the live desktop from the run, sign in, then resume automation. Requires the Jev executor.</small></span><input id="qemu-login-pause" type="checkbox" @bind="Vm.QemuPauseForLogin" /></label>
                        </section>
                        <section class="qemu-section" aria-labelledby="qemu-resources-title">
                            <h4 id="qemu-resources-title">Resources &amp; limits</h4>
                            <div class="qemu-resource-grid">
                                <div class="dcfield"><label for="qemu-memory">Memory <span>MiB</span></label><input id="qemu-memory" class="dcinput" type="number" min="256" max="8192" @bind="Vm.QemuMemoryMb" /></div>
                                <div class="dcfield"><label for="qemu-cpus">CPUs</label><input id="qemu-cpus" class="dcinput" type="number" min="1" max="8" @bind="Vm.QemuCpus" /></div>
                                <div class="dcfield"><label for="qemu-timeout">Timeout <span>seconds</span></label><input id="qemu-timeout" class="dcinput" type="number" min="10" max="3600" @bind="Vm.QemuTimeoutSeconds" /></div>
                            </div>
                            <p class="sub-note">The timeout includes startup and human interaction. Disk changes are discarded unless you explicitly save a login.</p>
                        </section>
                        <section class="qemu-section" aria-labelledby="qemu-result-title">
                            <h4 id="qemu-result-title">Result</h4>
                            <div class="dcfield"><label for="qemu-output">Save output to</label><input id="qemu-output" class="dcinput" maxlength="80" @bind="Vm.QemuOutputField" /><small>Later steps can use the final result, errors, exit code, and activity recorded in this field.</small></div>
                        </section>
                        <p class="sub-note">Apply step keeps this edit in the draft. Save workflow saves all current workflow changes.</p>
                        @if (Vm.QemuError is not null) { <p role="alert" class="qemu-error">@Vm.QemuError</p> }
                    </div>
                    <div class="dcmodal-foot">
                        <button class="dcbtn" disabled="@Vm.Saving" @onclick="Vm.CloseQemuEditor">Cancel</button>
                        <button class="dcbtn" disabled="@Vm.Saving" @onclick="Vm.SaveQemuAction">Apply step</button>
                        <button class="dcbtn primary" disabled="@Vm.Saving" @onclick="Vm.SaveQemuWorkflowAsync">@(Vm.Saving ? "Saving…" : "Save workflow")</button>
                    </div>
                </div>
            </div>
        }

        @if (Vm.ShowLoopEditor)
        {
            <div class="dcmodal-overlay" @onclick="Vm.CloseLoopEditor">
                <div class="dcmodal loop-modal" role="dialog" aria-modal="true" aria-labelledby="loop-editor-title" @onclick:stopPropagation="true">
                    <div class="dcmodal-head">
                        <div>
                            <span class="workflow-eyebrow">Workflow step</span>
                            <h3 id="loop-editor-title">@(Vm.LoopKind == LoopChainAction.HumanType ? "Human in the loop" : "Agent in the loop")</h3>
                        </div>
                        <button class="dcslide-x" aria-label="Close step settings" @onclick="Vm.CloseLoopEditor"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body">
                        <p class="sub-note">@(Vm.LoopKind == LoopChainAction.HumanType ? "The model uses the preceding output to ask the user a validation question. The workflow waits for their response." : "The model uses the preceding output to ask a verification question. Choose which agent answers it.")</p>
                        @if (Vm.LoopKind == LoopChainAction.AgentType)
                        {
                            <div class="dcfield">
                                <label for="loop-agent">Responding agent</label>
                                <select id="loop-agent" class="dcinput" @bind="Vm.LoopAgentProvider" aria-describedby="loop-agent-help">
                                    <option value="@LoopChainAction.ExternalAgent">External agent — wait for a response</option>
                                    <option value="@LoopChainAction.JevAgent">Jev (TypeSafe) — call for verification</option>
                                </select>
                                <span id="loop-agent-help" class="sub-note">@(Vm.LoopAgentProvider == LoopChainAction.JevAgent
                                    ? "Sends the preceding output and a yes/no verification question to TypeSafe. Requires a TypeSafe API key configured on the server."
                                    : "Waits for a connected agent to submit a written response. No agent is launched automatically.")</span>
                            </div>
                        }
                        <div class="dcfield">
                            <label for="loop-instructions">Validation instructions <span class="req">*</span></label>
                            <textarea id="loop-instructions" class="dcinput" rows="6" maxlength="4000" @bind="Vm.LoopInstructions"
                                      placeholder="@(Vm.LoopKind == LoopChainAction.HumanType ? "Ask the user to confirm the proposed changes are correct." : "Ask the agent to verify the action output against the expected result and provide evidence.")"></textarea>
                        </div>
                        @if (Vm.LoopKind == LoopChainAction.HumanType)
                        {
                            <div class="dcfield">
                                <label for="loop-response-type">Answer format</label>
                                <select id="loop-response-type" class="dcinput" @bind="Vm.LoopResponseType">
                                    <option value="@LoopChainAction.TextResponse">Written response</option>
                                    <option value="@LoopChainAction.YesNoResponse">Yes / No buttons</option>
                                </select>
                            </div>
                        }
                        <div class="dcfield">
                            <label for="loop-output">Response field <span class="req">*</span></label>
                            <input id="loop-output" class="dcinput" maxlength="80" @bind="Vm.LoopResponseField" aria-describedby="loop-output-help" />
                            <span id="loop-output-help" class="sub-note">@(Vm.LoopAgentProvider == LoopChainAction.JevAgent
                                ? "Saves the question, model version, and noul (probability of Yes, 0–1). Add a condition on this field's .noul value to control what happens next; completing verification does not mean approval."
                                : "The response is saved in this field. Later jobs and conditions can use it.")</span>
                        </div>
                        @if (Vm.LoopError is not null) { <p class="danger" role="alert">@Vm.LoopError</p> }
                    </div>
                    <div class="dcmodal-foot">
                        <button class="dcbtn" @onclick="Vm.CloseLoopEditor">Cancel</button>
                        <button class="dcbtn primary" @onclick="Vm.SaveLoopAction">Save step</button>
                    </div>
                </div>
            </div>
        }

        @if (Vm.ShowGateEditor)
        {
            <div class="dcmodal-overlay" @onclick="() => Vm.CancelGateEditor()">
                <div class="dcmodal gate-modal" role="dialog" aria-modal="true" aria-label="Configure workflow step" @onclick:stopPropagation="true">
                    <div class="dcmodal-head">
                        <div class="title-14">Gate on stage @(Vm.GateEditorStageIndex + 1)</div>
                        <button aria-label="Close" class="dcslide-x" @onclick="() => Vm.CancelGateEditor()"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body">
                        <div class="dcfield mb-8">
                            <label>Gate type</label>
                            <select class="dcinput" @bind="Vm.GateEditorType">
                                <option value="wait">Wait / delay</option>
                                <option value="condition">Condition / if-else</option>
                            </select>
                        </div>

                        @if (Vm.IsWaitGateEditor)
                        {
                            <div class="dcfield">
                                <label>Duration (seconds)</label>
                                <input class="dcinput" type="number" min="1" max="3600" step="1"
                                       @bind="Vm.GateEditorDuration" />
                            </div>
                            <div class="sub-note">Pauses the pipeline before running this stage's jobs.</div>
                        }

                        @if (Vm.IsConditionGateEditor)
                        {
                            <div class="condition-builder">
                                <div class="dcfield">
                                    <label>Payload path</label>
                                    <input class="dcinput mono" @bind="Vm.GateEditorPath"
                                           placeholder="data.status" />
                                </div>
                                <div class="dcfield">
                                    <label>Condition</label>
                                    <select class="dcinput" @bind="Vm.GateEditorOperator">
                                        <option value="exists">exists</option>
                                        <option value="notexists">does not exist</option>
                                        <option value="eq">equals</option>
                                        <option value="neq">does not equal</option>
                                        <option value="contains">contains</option>
                                        <option value="starts">starts with</option>
                                        <option value="ends">ends with</option>
                                        <option value="in">is one of</option>
                                        <option value="empty">is empty</option>
                                        <option value="notempty">is not empty</option>
                                        <option value="gt">is greater than</option>
                                        <option value="gte">is greater than or equal</option>
                                        <option value="lt">is less than</option>
                                        <option value="lte">is less than or equal</option>
                                    </select>
                                </div>
                                @if (Vm.ConditionNeedsValue)
                                {
                                    <div class="dcfield">
                                        <label>Value @(Vm.IsInGateOperator ? "(comma separated)" : "")</label>
                                        <input class="dcinput" @bind="Vm.GateEditorValue" placeholder="approved" />
                                    </div>
                                }
                            </div>
                            <div class="condition-preview">
                                <span>Expression</span>
                                <code>@Vm.ConditionPreview()</code>
                            </div>
                            <div class="sub-note">
                                When true, run this stage's jobs. When false, run the steps below instead.
                                Both paths rejoin at the next workflow stage.
                            </div>
                            <div class="dcform-section">
                                <h4>False path</h4>
                                @for (var i = 0; i < Vm.GateEditorElseStages.Count; i++)
                                {
                                    var index = i;
                                    <div class="dcfield">
                                        <WorkflowBranchPreview Stages="@(new[] { Vm.BuildStageView(Vm.GateEditorElseStages[index]) })" />
                                        <button class="dcbtn btn-xs" aria-label="@($"Remove false path step {index + 1}")"
                                                @onclick="@(() => Vm.RemoveElseStage(index))">Remove step</button>
                                    </div>
                                }
                                @if (Vm.GateEditorElseStages.Count == 0)
                                {
                                    <p class="sub-note">No steps: continue to the next workflow stage.</p>
                                }
                                <div class="dcfield">
                                    <label for="false-path-job">Add a job to the false path</label>
                                    <select id="false-path-job" class="dcinput" @bind="Vm.GateEditorElseJobId">
                                        <option value="">Choose a job…</option>
                                        @foreach (var job in Vm.Jobs ?? Array.Empty<JobView>())
                                        {
                                            <option value="@job.Id">@job.Name</option>
                                        }
                                    </select>
                                    <button class="dcbtn" disabled="@(string.IsNullOrEmpty(Vm.GateEditorElseJobId))" @onclick="Vm.AddElseJob">Add step</button>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="dcmodal-foot">
                        <button class="dcbtn" @onclick="() => Vm.CancelGateEditor()">Cancel</button>
                        <button class="dcbtn primary" @onclick="() => Vm.SaveGate()">Save gate</button>
                    </div>
                </div>
            </div>
        }

        @* ── Send SMS action editor ───────────────────────────────────────────────────── *@
        @if (Vm.ShowSmsActionEditor)
        {
            <div class="dcmodal-overlay" @onclick="() => Vm.CancelSmsActionEditor()">
                <div class="dcmodal gate-modal" role="dialog" aria-modal="true" aria-label="Configure workflow step" @onclick:stopPropagation="true">
                    <div class="dcmodal-head">
                        <div>
                            <div class="title-14">Send SMS</div>
                            <div class="sub-115">Uses the workspace Communications connection. Insert previous output with <code>{{path.to.value}}</code>.</div>
                        </div>
                        <button aria-label="Close" class="dcslide-x" @onclick="() => Vm.CancelSmsActionEditor()"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body">
                        <div class="dcfield mb-8">
                            <label>Recipient <span class="req">*</span></label>
                            <input class="dcinput" @bind="Vm.SmsRecipient" placeholder="+61412345678 or {{client.phone}}" />
                        </div>
                        <div class="dcfield">
                            <label>Message <span class="req">*</span></label>
                            <textarea class="dcinput" rows="6" maxlength="1600" @bind="Vm.SmsBody"
                                      placeholder="Hello {{client.name}}, your report is ready."></textarea>
                        </div>
                        <div class="sub-note">Use an international recipient number. SMS/client release flags in the previous payload must allow delivery.</div>
                        @if (Vm.SmsActionError is not null)
                        {
                            <div class="editor-err">@Vm.SmsActionError</div>
                        }
                    </div>
                    <div class="dcmodal-foot">
                        <button class="dcbtn" @onclick="() => Vm.CancelSmsActionEditor()">Cancel</button>
                        <button class="dcbtn primary" @onclick="() => Vm.SaveSmsAction()">Save action</button>
                    </div>
                </div>
            </div>
        }

        @* ── Send Email action editor ──────────────────────────────────────────────────── *@
        @if (Vm.ShowEmailActionEditor)
        {
            <div class="dcmodal-overlay" @onclick="() => Vm.CancelEmailActionEditor()">
                <div class="dcmodal gate-modal email-action-modal" role="dialog" aria-modal="true" aria-label="Configure email step" @onclick:stopPropagation="true">
                    <div class="dcmodal-head">
                        <div>
                            <div class="title-14">Send email</div>
                            <div class="sub-115">Uses the workspace Communications connection. Insert previous output with <code>{{path.to.value}}</code>.</div>
                        </div>
                        <button aria-label="Close" class="dcslide-x" @onclick="() => Vm.CancelEmailActionEditor()"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body">
                        <div class="email-json-panel">
                            <div class="email-json-head">
                                <div>
                                    <strong>Previous-step JSON</strong>
                                    <small>@(Vm.EmailJsonPathSource ?? "Use detected values as email placeholders.")</small>
                                </div>
                                @if (Vm.LoadingEmailJsonPaths)
                                {
                                    <span class="email-json-loading">Inspecting…</span>
                                }
                            </div>
                            @if (!Vm.LoadingEmailJsonPaths && Vm.EmailJsonPaths.Count > 0)
                            {
                                <div class="email-json-paths">
                                    @foreach (var suggestion in Vm.EmailJsonPaths)
                                    {
                                        <div class="email-json-row">
                                            <button class="email-json-key" title="Insert into message body"
                                                    @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "body")'>
                                                <code>@suggestion.Path</code>
                                                <span>@suggestion.Preview</span>
                                            </button>
                                            <div class="email-json-actions">
                                                <button title="Use as recipient" @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "recipient")'>To</button>
                                                <button title="Use as recipient name" @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "name")'>Name</button>
                                                <button title="Insert into subject" @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "subject")'>Subject</button>
                                                <button title="Insert into body" @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "body")'>Body</button>
                                                @if (suggestion.IsAttachmentCandidate)
                                                {
                                                    <button class="attachment-action" title="Use this object or array as email attachments"
                                                            @onclick='() => Vm.InsertEmailJsonPath(suggestion.Path, "attachment")'>
                                                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m21.4 11.6-8.9 8.9a6 6 0 0 1-8.5-8.5l9.6-9.6a4 4 0 0 1 5.7 5.7l-9.6 9.6a2 2 0 0 1-2.8-2.8l8.9-8.9"/></svg>
                                                        Attach
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (!Vm.LoadingEmailJsonPaths)
                            {
                                <div class="email-json-empty">Run the preceding JSON job once to populate detected placeholders.</div>
                            }
                        </div>
                        <div class="dcfield mb-8">
                            <label>Recipient <span class="req">*</span></label>
                            <input class="dcinput" @bind="Vm.EmailRecipient" placeholder="client@example.com or {{client.email}}" />
                        </div>
                        <div class="dcfield mb-8">
                            <label>Recipient name</label>
                            <input class="dcinput" @bind="Vm.EmailRecipientName" placeholder="{{client.name}}" />
                        </div>
                        <div class="dcfield mb-8">
                            <label>Subject <span class="req">*</span></label>
                            <input class="dcinput" @bind="Vm.EmailSubject" placeholder="Report for {{site.address}}" />
                        </div>
                        <div class="dcfield">
                            <label>Text body <span class="req">*</span></label>
                            <textarea class="dcinput" rows="8" @bind="Vm.EmailBody"
                                      placeholder="Hello {{client.name}}, your report is ready."></textarea>
                        </div>
                        <div class="dcfield mb-8">
                            <label>Attachments JSON path</label>
                            <input class="dcinput" @bind="Vm.EmailAttachmentPath" placeholder="{{attachments}}" />
                            <div class="sub-note">
                                Optional. Accepts one object or an array with <code>name</code>, <code>content</code>/<code>contentBase64</code>, and <code>contentType</code>. Binary content must be base64.
                            </div>
                        </div>
                        <div class="sub-note">
                            If the previous payload contains email/client release flags, every present flag must explicitly allow delivery.
                        </div>
                        @if (Vm.EmailActionError is not null)
                        {
                            <div class="editor-err">@Vm.EmailActionError</div>
                        }
                    </div>
                    <div class="dcmodal-foot">
                        <button class="dcbtn" @onclick="() => Vm.CancelEmailActionEditor()">Cancel</button>
                        <button class="dcbtn primary" @onclick="() => Vm.SaveEmailAction()">Save action</button>
                    </div>
                </div>
            </div>
        }

        @if (_chainContextJson is not null)
        {
            <div class="dcmodal-overlay" @onclick="CloseChainContextJson">
                <div class="dcmodal chain-json-modal" role="dialog" aria-modal="true" aria-label="Workflow context JSON" @onclick:stopPropagation="true">
                    <div class="dcmodal-head">
                        <div>
                            <div class="title-14">Workflow context JSON</div>
                            <div class="sub-115">Path: <code>@_chainContextJsonPath</code></div>
                        </div>
                        <button aria-label="Close" class="dcslide-x" @onclick="CloseChainContextJson"><AppIcon Kind="close" /></button>
                    </div>
                    <div class="dcmodal-body chain-json-body">
                        <RunOutput Value="@(_chainContextJson)" />
                    </div>
                </div>
            </div>
        }

        @if (Vm.IsDetailsTab)
        {
            <div class="dcslide-foot">
                @if (Vm.EditorError is not null)
                {
                    <div class="editor-err">@Vm.EditorError</div>
                }
                <button class="dcbtn" @onclick="() => Vm.CloseEditor()">Cancel</button>
                <button class="dcbtn primary" disabled="@Vm.Saving" @onclick="() => Vm.SaveChainAsync()">
                    @(Vm.Saving ? "Saving…" : Vm.EditChainId.HasValue ? "Save workflow" : "Create workflow")
                </button>
            </div>
        }
    </div>
}

@if (Vm.RunPromptChain is not null)
{
    <div class="dcmodal-overlay" @onclick="() => Vm.CancelRunPrompt()">
        <div class="dcmodal run-modal" role="dialog" aria-modal="true" aria-label="Run workflow" @onclick:stopPropagation="true">
            <div class="dcmodal-head">
                <div class="flex-min">
                    <div class="title-14">Run @Vm.RunPromptChain.Name</div>
                    <div class="sub-115">
                        Add an optional attachment, then review any declared step inputs below.
                    </div>
                </div>
                <button aria-label="Close" class="dcslide-x" @onclick="() => Vm.CancelRunPrompt()"><AppIcon Kind="close" /></button>
            </div>
            <div class="dcmodal-body modal-body-scroll">
                <div class="dcfield">
                    <label>
                        @ParameterPromptState.ChainAttachmentParameter.Label
                        <span class="code ml-5">@ParameterPromptState.ChainAttachmentField</span>
                    </label>
                    <ParamInput Parameter="@ParameterPromptState.ChainAttachmentParameter"
                                ProjectId="@ProjectId"
                                Value="@Vm.RunAttachment"
                                ValueChanged="@Vm.SetRunAttachment" />
                    <small>Available to the workflow as <code>attachment.$file</code>.</small>
                </div>
                @foreach (var step in Vm.RunPromptSteps)
                {
                    <div class="prompt-step">
                        <div class="prompt-step-head">
                            <span class="step-badge">step @(step.Index + 1)</span>
                            <span class="step-jobtitle">@step.Job.Name</span>
                        </div>
                        @foreach (var p in step.Job.Parameters)
                        {
                            var key = JobChainsViewModel.ArgKey(step.Index, p.Name);
                            <div class="dcfield">
                                <label>
                                    @(p.Label ?? p.Name)
                                    @if (p.Required)
                                    {
                                        <span class="req">*</span>
                                    }
                                    <span class="code ml-5">@p.Name</span>
                                </label>
                                <ParamInput Parameter="p" ProjectId="@ProjectId" Value="@Vm.GetArg(key)"
                                            ValueChanged="@(v => Vm.SetArg(key, v))" />
                            </div>
                        }
                    </div>
                }
                @if (Vm.RunPromptError is not null)
                {
                    <div class="prompt-err">@Vm.RunPromptError</div>
                }
            </div>
            <div class="dcmodal-foot">
                <button class="dcbtn" @onclick="() => Vm.CancelRunPrompt()">Cancel</button>
                <button class="dcbtn primary" disabled="@(Vm.RunPromptChain is not null && Vm.IsRunningChain(Vm.RunPromptChain.Id))" @onclick="() => Vm.SubmitRunPromptAsync()">
                    <AppIcon Kind="play" /> @(Vm.RunPromptChain is not null && Vm.IsRunningChain(Vm.RunPromptChain.Id) ? "running…" : "Run workflow")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [SupplyParameterFromQuery(Name = "workflow")] public Guid? WorkflowId { get; set; }
    [SupplyParameterFromQuery(Name = "chain")] public Guid? ChainId { get; set; }

    private string? _chainContextJson;
    private string? _chainContextJsonPath;

    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));

    protected override Task OnParametersSetAsync() => Vm.LoadPageAsync(ProjectId, WorkflowId ?? ChainId);

    public void Dispose()
    {
        Vm.DetachEvents();
        Vm.Detach();
    }

    private bool IsJsonLike(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        try
        {
            using var document = JsonDocument.Parse(value);
            return document.RootElement.ValueKind is JsonValueKind.Object or JsonValueKind.Array;
        }
        catch
        {
            return false;
        }
    }

    private static string GetJsonPreview(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "(empty)";

        var trimmed = value.Trim();
        const int max = 90;
        if (trimmed.Length <= max)
            return trimmed;

        return trimmed[..max] + "…";
    }

    private void OpenChainContextJson(string path, string value)
    {
        _chainContextJson = FormatJson(value);
        _chainContextJsonPath = path;
    }

    private void CloseChainContextJson()
    {
        _chainContextJson = null;
        _chainContextJsonPath = null;
    }

    private static string FormatJson(string raw)
    {
        try
        {
            using var document = JsonDocument.Parse(raw);
            return JsonSerializer.Serialize(document.RootElement, new JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return raw;
        }
    }
}
