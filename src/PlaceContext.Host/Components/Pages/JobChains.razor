@page "/project/{ProjectId:guid}/chains"
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject NavigationManager Nav
@inject PlaceContext.Infrastructure.Operations.OperationCenter OpCenter
@using Microsoft.Extensions.DependencyInjection

<PageTitle>PlaceContext — Job chains</PageTitle>

@if (_loading)
{
    <div style="padding:24px; color:var(--text-3)">Loading…</div>
}
else
{
    <div style="padding:20px 24px 40px; max-width:1320px; margin:0 auto">


        <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:18px">
            <div>
                <h2 style="font-size:18px; font-weight:600; margin:0">Job chains</h2>
                <div style="font-size:12px; color:var(--text-3); margin-top:3px">
                    Ordered pipelines — each step's primary output becomes the next step's input payload.
                </div>
            </div>
            <button class="dcbtn primary" @onclick="NewChain">+ New chain</button>
        </div>

        @if (_message is not null)
        {
            <div style="margin-bottom:12px; padding:10px 14px; border-radius:8px; background:var(--card); font-size:12.5px; color:var(--text-2)">@_message</div>
        }

        @if (_chains is null or { Count: 0 })
        {
            <div class="dccard" style="padding:24px; color:var(--text-3); font-size:13px; text-align:center">
                No chains defined for this project yet. Click <strong>+ New chain</strong> to link jobs into a pipeline.
            </div>
        }
        else
        {
            <div style="display:flex; flex-direction:column; gap:10px">
                @foreach (var chain in _chains)
                {
                    <div class="dccard" style="padding:14px 16px; cursor:pointer" @onclick="@(() => OpenChain(chain))">
                        <div style="display:flex; align-items:center; justify-content:space-between; gap:14px">
                            <div style="min-width:0">
                                <div style="font-size:14px; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">@chain.Name</div>
                                @if (!string.IsNullOrWhiteSpace(chain.Description))
                                {
                                    <div style="font-size:12px; color:var(--text-3); margin-top:3px">@chain.Description</div>
                                }
                                <div style="display:flex; flex-wrap:wrap; align-items:center; gap:6px; margin-top:8px; font-size:11.5px; font-family:'IBM Plex Mono',monospace">
                                    @foreach (var (step, i) in chain.Steps.Select((s, i) => (s, i)))
                                    {
                                        if (i > 0)
                                        {
                                            <span style="color:var(--text-3)">→</span>
                                        }
                                        <span style="padding:2px 8px; border-radius:6px; background:var(--card-2); color:@(step.JobName == "(deleted)" ? "var(--bad)" : "var(--brand-2)")">@step.JobName</span>
                                    }
                                </div>
                            </div>
                            <div style="display:flex; align-items:center; gap:8px; flex:none">
                                @if (_confirmDeleteId == chain.Id)
                                {
                                    <button class="dcbtn" style="color:var(--bad)" @onclick:stopPropagation="true" @onclick="@(() => DeleteChain(chain.Id))">Confirm delete</button>
                                    <button class="dcbtn" @onclick:stopPropagation="true" @onclick="@(() => _confirmDeleteId = null)">Keep</button>
                                }
                                else
                                {
                                    <button class="dcbtn" @onclick:stopPropagation="true" @onclick="@(() => _confirmDeleteId = chain.Id)">Delete</button>
                                }
                                <button class="dcbtn primary" @onclick:stopPropagation="true" @onclick="@(() => RunChain(chain))">▶ Run</button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

@* ── Chain slide-out: Details (edit) | Runs (pipeline history, live) ─────────────────────── *@
@if (_showEditor)
{
    <div class="dcslide-scrim" @onclick="CloseEditor"></div>
    <div class="dcslide" style="width:640px">
        <div class="dcslide-head">
            <div style="flex:1; min-width:0">
                <div style="font-size:14px; font-weight:600">@(_editChainId.HasValue ? _edName : "New chain")</div>
                <div style="font-size:11.5px; color:var(--text-3); margin-top:3px">
                    Steps run in order; a failed step stops the chain. The same job may appear more than once.
                </div>
            </div>
            @if (_editChainId.HasValue && _chains?.FirstOrDefault(c => c.Id == _editChainId) is { } runnable)
            {
                <button class="dcbtn primary" style="margin-right:10px" @onclick="@(() => RunChain(runnable))">▶ Run</button>
            }
            <button class="dcslide-x" @onclick="CloseEditor">×</button>
        </div>

        @if (_editChainId.HasValue)
        {
            <div class="dctabs" style="margin:0; padding:0 18px; border-bottom:1px solid var(--border)">
                <button class="dctab @(_editorTab == "details" ? "active" : "")" @onclick="@(() => _editorTab = "details")">Details</button>
                <button class="dctab @(_editorTab == "runs" ? "active" : "")" @onclick="SwitchToRunsTab">Runs<span class="n">@(_chainRuns?.Count ?? 0)</span></button>
            </div>
        }

        @if (_editorTab == "runs" && _editChainId.HasValue)
        {
            <div class="dcslide-body" style="flex:1; overflow-y:auto; display:flex; flex-direction:column; gap:12px">
                @if (_openRun is null)
                {
                    @if (_chainRuns is null or { Count: 0 })
                    {
                        <div style="color:var(--text-3); font-size:13px; padding:14px 0">No runs yet — click ▶ Run to start the pipeline.</div>
                    }
                    else
                    {
                        @foreach (var run in _chainRuns)
                        {
                            <div class="dccard" style="padding:12px 16px; cursor:pointer" @onclick="@(() => OpenChainRun(run))">
                                <div style="display:flex; align-items:center; gap:12px">
                                    <span style="font-size:11px; font-weight:600; padding:3px 8px; border-radius:5px;
                                          color:@StatusColor(run.Status); background:@StatusBg(run.Status)">@run.Status</span>
                                    <span style="font-family:'IBM Plex Mono',monospace; font-size:11.5px; color:var(--text-2); flex:1">
                                        @run.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                                    </span>
                                    <span style="font-size:11px; color:var(--text-3)">
                                        @run.Steps.Count(s => s.Status == "Succeeded")/@run.Steps.Count steps
                                    </span>
                                    @if (run.FinishedAt.HasValue)
                                    {
                                        <span style="font-size:11px; color:var(--text-3); font-family:'IBM Plex Mono',monospace">
                                            @FormatDuration(run.StartedAt, run.FinishedAt.Value)
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="font-size:11px; color:var(--brand-2)">running…</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
                else
                {
                    <button class="dcbtn" style="align-self:flex-start" @onclick="@(() => { _openRun = null; _stepRunDetail = null; })">← All runs</button>

                    <div style="display:flex; align-items:center; gap:8px">
                        <span style="font-size:12px; font-weight:600; padding:3px 9px; border-radius:5px;
                              color:@StatusColor(_openRun.Status); background:@StatusBg(_openRun.Status)">@_openRun.Status</span>
                        <span style="font-size:11px; color:var(--text-3); font-family:'IBM Plex Mono',monospace">
                            @_openRun.StartedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                            @(_openRun.FinishedAt.HasValue ? " · took " + FormatDuration(_openRun.StartedAt, _openRun.FinishedAt.Value) : " · live")
                        </span>
                    </div>

                    @* ── The pipeline: stage chips flowing left to right ───────────────────────── *@
                    <div style="display:flex; flex-wrap:wrap; align-items:center; gap:8px; padding:14px; border-radius:10px; background:var(--card)">
                        @foreach (var (step, i) in _openRun.Steps.Select((s, i) => (s, i)))
                        {
                            if (i > 0)
                            {
                                <span style="color:var(--text-3); font-size:15px">──▶</span>
                            }
                            <div style="display:flex; flex-direction:column; gap:2px; padding:8px 12px; border-radius:8px; border:1.5px solid @StepBorder(step.Status);
                                        background:@StatusBg(step.Status); @(step.RunId is not null ? "cursor:pointer" : "")"
                                 @onclick="@(() => OpenStepRun(step))">
                                <div style="display:flex; align-items:center; gap:6px; font-size:12.5px; font-weight:600; color:@StatusColor(step.Status)">
                                    <span>@StepIcon(step.Status)</span><span>@step.JobName</span>
                                </div>
                                <div style="font-size:10.5px; color:var(--text-3)">
                                    @(step.Status == "Running" ? "running…"
                                        : step.StartedAt.HasValue && step.FinishedAt.HasValue
                                            ? step.Status + " " + FormatDuration(step.StartedAt.Value, step.FinishedAt.Value)
                                            : step.Status.ToLowerInvariant())
                                </div>
                            </div>
                        }
                    </div>

                    @if (_openRun.FinalOutput is { Length: > 0 })
                    {
                        <div>
                            <div style="font-size:12px; font-weight:600; margin-bottom:4px">Pipeline output</div>
                            <pre style="background:var(--bg); border:1px solid var(--border); border-radius:6px; padding:10px; font-size:11px; font-family:'IBM Plex Mono',monospace; white-space:pre-wrap; word-break:break-all; color:var(--text-2); max-height:200px; overflow-y:auto">@PrettyJson(_openRun.FinalOutput)</pre>
                        </div>
                    }

                    @* Compact detail of a clicked stage's job run — artifact + logs without leaving the pipeline. *@
                    @if (_stepRunDetail is { } d)
                    {
                        <div style="border-top:1px solid var(--border); padding-top:10px">
                            <div style="font-size:12px; font-weight:600; margin-bottom:6px; display:flex; align-items:center; gap:8px">
                                <span>Stage run — @(_openRun.Steps.FirstOrDefault(s => s.RunId == d.Id)?.JobName)</span>
                                <span style="font-size:11px; padding:2px 7px; border-radius:4px; color:@StatusColor(d.Status); background:@StatusBg(d.Status)">@d.Status</span>
                                <span style="flex:1"></span>
                                <button class="dcbtn" style="padding:2px 10px; font-size:11px"
                                        @onclick="@(() => Nav.NavigateTo($"/project/{ProjectId}/jobs"))">open in Jobs →</button>
                            </div>
                            @foreach (var shard in d.ShardResults)
                            {
                                <div style="margin-bottom:8px">
                                    <div style="font-size:11px; color:var(--text-3); margin-bottom:3px">shard @shard.Index — @shard.Outcome (exit @shard.ExitCode)</div>
                                    @if (shard.Artifact is not null)
                                    {
                                        <pre style="background:var(--bg); border:1px solid var(--border); border-radius:6px; padding:8px; font-size:10.5px; font-family:'IBM Plex Mono',monospace; white-space:pre-wrap; word-break:break-all; color:var(--text-2); max-height:160px; overflow-y:auto">@PrettyJson(shard.Artifact)</pre>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(shard.Log))
                                    {
                                        <details style="margin-top:3px" open="@(shard.Outcome == "Failed")">
                                            <summary style="font-size:10.5px; color:var(--text-3); cursor:pointer">Log</summary>
                                            <pre style="font-size:10px; font-family:'IBM Plex Mono',monospace; color:var(--text-3); white-space:pre-wrap; margin-top:3px; max-height:220px; overflow-y:auto">@shard.Log</pre>
                                        </details>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        }
        else
        {
        <div class="dcslide-body" style="flex:1; display:flex; flex-direction:column; gap:14px">

            <div style="display:flex; gap:10px">
                <div class="dcfield" style="flex:1">
                    <label>Name <span class="req">*</span></label>
                    <input class="dcinput" @bind="_edName" placeholder="my-pipeline" />
                </div>
                <div class="dcfield" style="flex:1.4">
                    <label>Description</label>
                    <input class="dcinput" @bind="_edDescription" placeholder="What does this chain produce? (optional)" />
                </div>
            </div>

            <div class="dcform-section">
                <span class="dcform-title">Steps <span class="req">*</span></span>

                @if (_edSteps.Count == 0)
                {
                    <div style="padding:14px; border-radius:8px; background:var(--card-2); font-size:12px; color:var(--text-3); text-align:center">
                        No steps yet — pick a job below and add it.
                    </div>
                }
                else
                {
                    <div style="display:flex; flex-direction:column; gap:6px">
                        @foreach (var (jobId, i) in _edSteps.Select((id, i) => (id, i)))
                        {
                            <div style="display:flex; align-items:center; gap:10px; padding:8px 10px; border-radius:8px; background:var(--card-2)">
                                <span style="font-size:11px; color:var(--text-3); font-family:'IBM Plex Mono',monospace; flex:none">@(i + 1).</span>
                                <span style="flex:1; min-width:0; font-size:12.5px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">@JobName(jobId)</span>
                                <button class="dcbtn" style="padding:2px 8px" disabled="@(i == 0)" @onclick="@(() => MoveStep(i, -1))">↑</button>
                                <button class="dcbtn" style="padding:2px 8px" disabled="@(i == _edSteps.Count - 1)" @onclick="@(() => MoveStep(i, +1))">↓</button>
                                <button class="dcbtn" style="padding:2px 8px; color:var(--bad)" @onclick="@(() => _edSteps.RemoveAt(i))">×</button>
                            </div>
                        }
                    </div>
                }

                <div style="display:flex; gap:8px; margin-top:4px">
                    <select class="dcinput" style="flex:1" @bind="_edAddJobId">
                        <option value="">— pick a job —</option>
                        @foreach (var job in _jobs ?? Array.Empty<JobView>())
                        {
                            <option value="@job.Id">@job.Name</option>
                        }
                    </select>
                    <button class="dcbtn" disabled="@(string.IsNullOrEmpty(_edAddJobId))" @onclick="AddStep">+ Add step</button>
                </div>
            </div>

        </div>
        }

        @if (_editorTab == "details")
        {
            <div class="dcslide-foot">
                @if (_editorError is not null)
                {
                    <div style="color:var(--bad); font-size:12px; flex:1">@_editorError</div>
                }
                <button class="dcbtn" @onclick="CloseEditor">Cancel</button>
                <button class="dcbtn primary" disabled="@_saving" @onclick="SaveChain">
                    @(_saving ? "Saving…" : _editChainId.HasValue ? "Save chain" : "Create chain")
                </button>
            </div>
        }
    </div>
}

@if (_runPromptChain is not null)
{
    <div class="dcmodal-overlay" @onclick="@(() => _runPromptChain = null)">
        <div class="dcmodal" style="width:520px; max-height:80vh; display:flex; flex-direction:column" @onclick:stopPropagation="true">
            <div class="dcmodal-head">
                <div style="flex:1; min-width:0">
                    <div style="font-size:14px; font-weight:600">Run @_runPromptChain.Name</div>
                    <div style="font-size:11.5px; color:var(--text-3); margin-top:3px">
                        Every step that takes input is listed below — values are prefilled from each job's stored payload.
                    </div>
                </div>
                <button class="dcslide-x" @onclick="@(() => _runPromptChain = null)">×</button>
            </div>
            <div class="dcmodal-body" style="overflow-y:auto">
                @foreach (var step in _runPromptSteps)
                {
                    <div style="margin-bottom:14px">
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px">
                            <span style="font-family:'IBM Plex Mono',monospace; font-size:10.5px; padding:1px 7px; border-radius:5px; background:var(--card-2); color:var(--text-3)">step @(step.Index + 1)</span>
                            <span style="font-size:12.5px; font-weight:600">@step.Job.Name</span>
                        </div>
                        @foreach (var p in step.Job.Parameters)
                        {
                            var key = ArgKey(step.Index, p.Name);
                            <div class="dcfield">
                                <label>
                                    @(p.Label ?? p.Name)
                                    @if (p.Required)
                                    {
                                        <span class="req">*</span>
                                    }
                                    <span class="code" style="margin-left:5px">@p.Name</span>
                                </label>
                                <input class="dcinput" value="@GetArg(key)"
                                       @oninput="@(e => SetArg(key, e.Value?.ToString() ?? ""))" />
                            </div>
                        }
                    </div>
                }
                @if (_runPromptError is not null)
                {
                    <div style="color:var(--bad); font-size:12px; padding:8px 10px; background:var(--bad-bg); border-radius:6px">@_runPromptError</div>
                }
            </div>
            <div class="dcmodal-foot">
                <button class="dcbtn" @onclick="@(() => _runPromptChain = null)">Cancel</button>
                <button class="dcbtn primary" @onclick="SubmitRunPrompt">▶ Run chain</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private IReadOnlyList<JobChainView>? _chains;
    private IReadOnlyList<JobView>? _jobs;
    private string? _message;
    private bool _loading = true;
    private Guid? _confirmDeleteId;

    // ── Editor state ────────────────────────────────────────────────────────────────────────────
    private bool _showEditor;
    private bool _saving;
    private Guid? _editChainId;
    private string? _editorError;
    private string _editorTab = "details"; // details | runs
    private string _edName = "";
    private string _edDescription = "";
    private readonly List<Guid> _edSteps = new();
    private string _edAddJobId = "";

    // ── Pipeline runs state ───────────────────────────────────────────────────────────────────────
    private IReadOnlyList<ChainRunView>? _chainRuns;
    private ChainRunView? _openRun;
    private JobRunDetailView? _stepRunDetail;
    private CancellationTokenSource? _pollCts; // live refresh while a pipeline is running
    private bool _followNewest;                // just dispatched: open the new Running run when it lands

    // ── Run-input prompt state (only when the first step's job declares parameters) ──────────────
    private JobChainView? _runPromptChain;
    private List<(int Index, JobView Job)> _runPromptSteps = new();
    private Dictionary<string, string> _runArgs = new();
    private string? _runPromptError;

    private static string ArgKey(int stepIndex, string param) => $"{stepIndex}:{param}";

    protected override void OnInitialized() => OpCenter.Changed += OnOpsChanged;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _message = null;
        try
        {
            _chains = await Svc.ListJobChainsAsync(ProjectId);
            _jobs = await Svc.ListJobsAsync(ProjectId);
            Ui.Set("Job chains", "ordered job pipelines");
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _loading = false; }
    }

    // Push updates for chains started elsewhere (MCP, triggers, another tab): the run-status
    // watcher syncs chain/step transitions into the OperationCenter, so refresh the open runs tab
    // on every change — the local poll loop only covers a run this page just dispatched.
    private void OnOpsChanged() => _ = InvokeAsync(async () =>
    {
        if (_opRefreshing || _editChainId is not { } chainId || _editorTab != "runs") return;
        _opRefreshing = true;
        try
        {
            await RefreshRunsAsync(chainId, openNewest: false);
            StateHasChanged();
        }
        finally { _opRefreshing = false; }
    });

    private bool _opRefreshing;

    public void Dispose()
    {
        OpCenter.Changed -= OnOpsChanged;
        StopPolling();
    }

    private string JobName(Guid jobId) =>
        _jobs?.FirstOrDefault(j => j.Id == jobId)?.Name ?? "(deleted)";

    // ── Run ───────────────────────────────────────────────────────────────────────────────────────

    private async Task RunChain(JobChainView chain)
    {
        // Collect the declared parameters of EVERY step that takes input — the form groups them
        // per step and each step's values merge over its chained input at run time.
        _runPromptSteps = chain.Steps
            .Select((step, i) => (Index: i, Job: _jobs?.FirstOrDefault(j => j.Id == step.JobId)))
            .Where(x => x.Job is { Parameters.Count: > 0 })
            .Select(x => (x.Index, x.Job!))
            .ToList();
        if (_runPromptSteps.Count > 0)
        {
            _runPromptChain = chain;
            _runArgs = new Dictionary<string, string>();
            foreach (var (index, job) in _runPromptSteps)
            {
                var defaults = StoredPayloadDefaults(job);
                foreach (var p in job.Parameters)
                    _runArgs[ArgKey(index, p.Name)] = defaults.GetValueOrDefault(p.Name, "");
            }
            _runPromptError = null;
            return;
        }
        await RunChainCore(chain, null);
    }

    // Prefill from existing data: the job's stored input payload is its last-known-good shape.
    private static Dictionary<string, string> StoredPayloadDefaults(JobView job)
    {
        try
        {
            if (job.InputPayloads.Count == 0) return new();
            using var doc = System.Text.Json.JsonDocument.Parse(job.InputPayloads[0]);
            if (doc.RootElement.ValueKind != System.Text.Json.JsonValueKind.Object) return new();
            return doc.RootElement.EnumerateObject()
                .Where(p => p.Value.ValueKind is not (System.Text.Json.JsonValueKind.Object or System.Text.Json.JsonValueKind.Array))
                .ToDictionary(p => p.Name, p => p.Value.ValueKind == System.Text.Json.JsonValueKind.String ? p.Value.GetString() ?? "" : p.Value.ToString());
        }
        catch { return new(); }
    }

    private async Task RunChainCore(JobChainView chain, string? payload, IReadOnlyDictionary<int, string>? stepOverrides = null)
    {
        _message = null;
        // The pipeline executes as a background portal operation; the run row appears in the DB
        // the moment it starts, so the Runs tab below picks it up and follows it live.
        var tenant = PlaceContext.Infrastructure.Tenancy.CurrentTenant.Current;
        if (tenant is null) { _message = "No tenant resolved — sign in again."; return; }
        // Pre-allocated run id = the op's correlation key: the run-status watcher updates this
        // entry live (step progress, prompt terminal status) straight from the persisted run.
        var chainRunId = Guid.NewGuid();
        OpCenter.Run(tenant, ProjectId, $"Run chain — {chain.Name}", $"/project/{ProjectId}/chains",
            async (sp, ct) =>
            {
                var result = await sp.GetRequiredService<IPlaceContextService>().RunJobChainAsync(chain.Id, payload, chainRunId, stepOverrides, ct);
                return $"chain finished — {result.Status} ({result.Steps.Count(s => s.Status != "Skipped")} step(s) ran)";
            },
            correlationKey: PlaceContext.Application.Features.RunStatusWatchService.ChainRunKey(chainRunId));
        _runPromptChain = null;
        _runPromptSteps = new();

        // Land the user on the live pipeline: open this chain's Runs tab and follow the new run.
        // The background op needs a beat to persist the run row, so the poll loop latches onto
        // the newest Running run as soon as it appears rather than reading the list right now.
        if (_editChainId != chain.Id || !_showEditor) OpenChainEditor(chain);
        _editorTab = "runs";
        _openRun = null;
        _stepRunDetail = null;
        _followNewest = true;
        await RefreshRunsAsync(chain.Id, openNewest: false);
        StartPolling();
    }

    private string GetArg(string name) => _runArgs.TryGetValue(name, out var v) ? v : "";
    private void SetArg(string name, string value) => _runArgs[name] = value;

    private async Task SubmitRunPrompt()
    {
        if (_runPromptChain is null) return;
        _runPromptError = null;

        var missing = _runPromptSteps
            .SelectMany(step => step.Job.Parameters
                .Where(p => p.Required && string.IsNullOrWhiteSpace(GetArg(ArgKey(step.Index, p.Name))))
                .Select(p => $"step {step.Index + 1}: {p.Label ?? p.Name}"))
            .ToList();
        if (missing.Count > 0) { _runPromptError = $"Required: {string.Join(", ", missing)}"; return; }

        // One JSON object per step; step 0's doubles as the chain's input payload.
        var overrides = _runPromptSteps.ToDictionary(
            step => step.Index,
            step => System.Text.Json.JsonSerializer.Serialize(
                step.Job.Parameters.ToDictionary(p => p.Name, p => GetArg(ArgKey(step.Index, p.Name)))));
        var payload = overrides.GetValueOrDefault(0);
        await RunChainCore(_runPromptChain, payload, overrides);
    }

    // ── Pipeline runs ─────────────────────────────────────────────────────────────────────────────

    private async Task SwitchToRunsTab()
    {
        _editorTab = "runs";
        _openRun = null;
        _stepRunDetail = null;
        if (_editChainId is { } chainId)
        {
            await RefreshRunsAsync(chainId, openNewest: false);
            StartPolling();
        }
    }

    private void OpenChainRun(ChainRunView run)
    {
        _openRun = run;
        _stepRunDetail = null;
        StartPolling();
    }

    private async Task OpenStepRun(ChainStepRunView step)
    {
        if (step.RunId is not { } runId || runId == Guid.Empty) return;
        try
        {
            _stepRunDetail = await Svc.GetJobRunAsync(runId);
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private async Task RefreshRunsAsync(Guid chainId, bool openNewest)
    {
        try
        {
            _chainRuns = await Svc.ListChainRunsAsync(chainId);
            if (_followNewest && _chainRuns.FirstOrDefault(r => r.Status == "Running") is { } live)
            {
                _openRun = live;
                _followNewest = false; // latched — from here the poll refreshes it by id
            }
            else if (openNewest && _chainRuns.Count > 0) _openRun = _chainRuns[0];
            else if (_openRun is not null)
                _openRun = _chainRuns.FirstOrDefault(r => r.Id == _openRun.Id) ?? _openRun;
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    /// <summary>Follows a running pipeline: refresh every 1.5s until nothing is Running.</summary>
    private void StartPolling()
    {
        if (_pollCts is not null) return; // already following
        var cts = new CancellationTokenSource();
        _pollCts = cts;
        _ = Task.Run(async () =>
        {
            try
            {
                while (!cts.IsCancellationRequested)
                {
                    await Task.Delay(1500, cts.Token);
                    if (_editChainId is not { } chainId || _editorTab != "runs") break;
                    await InvokeAsync(async () =>
                    {
                        await RefreshRunsAsync(chainId, openNewest: false);
                        StateHasChanged();
                    });
                    // _followNewest keeps the loop alive across the gap between dispatching the
                    // background op and its run row landing in the DB.
                    var anyRunning = _followNewest
                        || (_chainRuns?.Any(r => r.Status == "Running") ?? false)
                        || _openRun?.Status == "Running";
                    if (!anyRunning) break;
                }
            }
            catch (OperationCanceledException) { /* closed the panel */ }
            finally
            {
                if (ReferenceEquals(_pollCts, cts)) _pollCts = null;
                cts.Dispose();
            }
        });
    }

    private void StopPolling()
    {
        _pollCts?.Cancel();
        _pollCts = null;
    }

    // ── Editor ───────────────────────────────────────────────────────────────────────────────────

    private void NewChain()
    {
        _editChainId = null;
        _edName = "";
        _edDescription = "";
        _edSteps.Clear();
        _edAddJobId = "";
        _editorError = null;
        _editorTab = "details";
        _showEditor = true;
    }

    private async Task OpenChain(JobChainView chain)
    {
        OpenChainEditor(chain);
        await RefreshRunsAsync(chain.Id, openNewest: false);
    }

    private void OpenChainEditor(JobChainView chain)
    {
        _editChainId = chain.Id;
        _edName = chain.Name;
        _edDescription = chain.Description ?? "";
        _edSteps.Clear();
        _edSteps.AddRange(chain.Steps.Select(s => s.JobId));
        _edAddJobId = "";
        _editorError = null;
        _editorTab = "details";
        _openRun = null;
        _stepRunDetail = null;
        _chainRuns = null;
        _showEditor = true;
    }

    private void CloseEditor()
    {
        _showEditor = false;
        _editorError = null;
        _editorTab = "details";
        _openRun = null;
        _stepRunDetail = null;
        StopPolling();
    }

    private void AddStep()
    {
        if (Guid.TryParse(_edAddJobId, out var id)) _edSteps.Add(id);
        _edAddJobId = "";
    }

    private void MoveStep(int index, int delta)
    {
        var target = index + delta;
        if (target < 0 || target >= _edSteps.Count) return;
        (_edSteps[index], _edSteps[target]) = (_edSteps[target], _edSteps[index]);
    }

    private async Task SaveChain()
    {
        _editorError = null;
        if (string.IsNullOrWhiteSpace(_edName)) { _editorError = "Name is required."; return; }
        if (_edSteps.Count == 0) { _editorError = "A chain needs at least one step."; return; }

        _saving = true;
        try
        {
            var description = string.IsNullOrWhiteSpace(_edDescription) ? null : _edDescription.Trim();
            if (_editChainId is { } chainId)
            {
                await Svc.UpdateJobChainAsync(chainId, _edName.Trim(), description, _edSteps);
                _message = $"Chain {_edName.Trim()} updated.";
            }
            else
            {
                await Svc.CreateJobChainAsync(ProjectId, _edName.Trim(), description, _edSteps);
                _message = $"Chain {_edName.Trim()} created.";
            }
            _chains = await Svc.ListJobChainsAsync(ProjectId);
            _showEditor = false;
        }
        catch (Exception ex) { _editorError = ex.Message; }
        finally { _saving = false; }
    }

    private async Task DeleteChain(Guid chainId)
    {
        _confirmDeleteId = null;
        try
        {
            await Svc.DeleteJobChainAsync(chainId);
            _chains = await Svc.ListJobChainsAsync(ProjectId);
            _message = "Chain deleted.";
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    // ── Presentation helpers ─────────────────────────────────────────────────────────────────────

    private static string StepIcon(string status) => status switch
    {
        "Succeeded" => "✓",
        "Failed" => "✗",
        "Partial" => "~",
        "Running" => "●",
        "Skipped" => "⏭",
        _ => "○"
    };

    private static string StepBorder(string status) => status switch
    {
        "Running" => "var(--brand-2)",
        "Pending" or "Skipped" => "var(--border)",
        _ => StatusColor(status)
    };

    private static string StatusColor(string status) => status switch
    {
        "Succeeded" => "var(--good)",
        "Failed" => "var(--bad)",
        "Partial" => "var(--warn)",
        "Running" => "var(--brand-2)",
        _ => "var(--text-3)"
    };

    private static string StatusBg(string status) => status switch
    {
        "Succeeded" => "var(--good-bg)",
        "Failed" => "var(--bad-bg)",
        "Partial" => "var(--warn-bg)",
        "Running" => "var(--brand-bg)",
        _ => "var(--card-2)"
    };

    private static string FormatDuration(DateTimeOffset start, DateTimeOffset end)
    {
        var span = end - start;
        if (span.TotalSeconds < 60) return $"{(int)span.TotalSeconds}s";
        return $"{(int)span.TotalMinutes}m {span.Seconds}s";
    }

    private static string PrettyJson(string raw)
    {
        try
        {
            var doc = System.Text.Json.JsonDocument.Parse(raw);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement,
                new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch { return raw; }
    }
}
