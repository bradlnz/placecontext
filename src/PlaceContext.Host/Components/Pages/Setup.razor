@page "/setup"
@attribute [AllowAnonymous]
@layout PlaceContext.Host.Components.Layout.AuthLayout

@using Microsoft.AspNetCore.Components.Forms
@using PlaceContext.Host.Components.ViewModels
@inject SetupViewModel Vm

@* First-run admin setup. Shown only while this tenant has no Owner with a real password (checked below
   for UX; /auth/setup enforces the same thing server-side and fails closed regardless). The form posts
   as a plain HTML form to AuthController — not a Blazor event handler — because signing the cookie in
   requires a normal HTTP request/response, which an already-connected Blazor circuit doesn't have. *@

<PageTitle>placecontext — set up this workspace</PageTitle>

<div class="dccard auth-card">
    <div class="auth-brand">
        <div class="auth-mark">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8l3.5 4L5 16"></path><path d="M13 16h6"></path></svg>
        </div>
        <span class="auth-brand-name">placecontext</span>
    </div>

    @if (Vm.Configured)
    {
        <h1 class="auth-title">Already set up</h1>
        <p class="auth-sub">This workspace already has an admin account.</p>
        <a class="dcbtn primary auth-submit" href="@PageRoutes.Login">Go to sign in</a>
    }
    else
    {
        <h1 class="auth-title">Set up this workspace</h1>
        <p class="auth-sub">
            Create the admin account before anything else is reachable. There is no default password —
            you choose one now.
        </p>

        <form method="post" action="/auth/setup" class="auth-form">
            <AntiforgeryToken />
            @if (!string.IsNullOrEmpty(Vm.Error))
            {
                <div class="auth-error">@Vm.Error</div>
            }
            <div class="dcfield">
                <label>Admin email <span class="req">*</span></label>
                <input class="dcinput" type="email" name="email" required autofocus placeholder="you@example.com" />
            </div>
            <div class="dcfield">
                <label>Display name</label>
                <input class="dcinput" type="text" name="displayName" placeholder="Optional — defaults to the email's local part" />
            </div>
            <div class="dcfield">
                <label>Password <span class="req">*</span> <span class="code">min 12 characters</span></label>
                <input class="dcinput" type="password" name="password" required minlength="12" autocomplete="new-password" />
            </div>
            <div class="dcfield">
                <label>Confirm password <span class="req">*</span></label>
                <input class="dcinput" type="password" name="confirmPassword" required minlength="12" autocomplete="new-password" />
            </div>
            <button type="submit" class="dcbtn primary auth-submit">Create admin account</button>
            <div class="dchint">Avoid common or reused passwords — this account can manage the whole workspace.</div>
        </form>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Vm.Error = Error;
        await Vm.InitializeAsync();
    }
}
