@page "/project/{ProjectId:guid}/databases/{DatabaseId:guid}"
@attribute [Authorize(Policy = Permission.SettingsManage)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IAsyncDisposable
@inject DatabaseStudioViewModel Vm

<PageTitle>PlaceContext — Database workspace</PageTitle>
<div class="resource-page">
    <nav class="resource-breadcrumb" aria-label="Breadcrumb"><span>Infrastructure</span><AppIcon Kind="chevron-right" /><a href="/project/@ProjectId/databases">Databases</a><AppIcon Kind="chevron-right" /><span>@(Vm.Database?.Name ?? "Database workspace")</span></nav>
    <header class="resource-head"><div><h2>@(Vm.Database?.Name ?? "Database workspace")</h2><p>Query your service data. Read-only access · up to 500 rows · 5-second query timeout.</p></div><a class="dcbtn" href="/project/@ProjectId/databases">Back to databases</a></header>
    @if (Vm.Error is not null) { <p class="error" role="alert">@Vm.Error</p> }
    @if (Vm.Database is { } database)
    {
        <section class="database-studio" aria-label="Database query workspace">
            <aside class="studio-sidebar"><h3>@(database.Engine == "postgres" ? "Tables" : "Keys")</h3><input class="dcinput" aria-label="Find database resources" placeholder="Search…" @bind="Vm.Search" @bind:event="oninput" />
                <div class="studio-resources">@foreach (var resource in Vm.VisibleResources) { <button disabled="@Vm.Busy" @onclick="() => Vm.SelectAsync(resource.Query)"><AppIcon Kind="data" /> @resource.Name</button> }
                @if (!Vm.Resources.Any()) { <p>No resources loaded. Run a query to inspect this database.</p> }</div>
                <small>Namespace<br /><code>@database.Namespace</code></small>
            </aside>
            <div class="studio-main"><header><h3>@(database.Engine == "postgres" ? "SQL query" : "Redis query")</h3><button class="dcbtn primary" disabled="@Vm.Busy" @onclick="() => Vm.RunAsync()"><AppIcon Kind="play" /> @(Vm.Busy ? "Running…" : "Run query")</button></header>
                @if (database.Engine == "redis") { <p class="note">Use SCAN [pattern], GET key, TYPE key, or TTL key. String values are limited to 16 KiB.</p> }
                <div id="@Vm.EditorId" class="database-query-editor" aria-label="Database query editor"></div>
                <details><summary>Plain text editor</summary><textarea class="dcinput" aria-label="Query text" rows="5" @bind="Vm.Query"></textarea><button class="dcbtn" disabled="@Vm.Busy" @onclick="() => Vm.SelectAsync(Vm.Query)">Run this query</button></details>
                <div class="studio-results-heading"><h3>Results</h3><span>@(Vm.Result?.Rows.Count ?? 0) rows</span></div>
                <div class="resource-table-scroll" role="region" aria-label="Database query results" tabindex="0"><table class="resource-table"><thead><tr>@if (Vm.Result is { } result) { @foreach (var column in result.Columns) { <th>@column</th> } }</tr></thead><tbody>
                    @if (Vm.Result is { } rows) { @foreach (var row in rows.Rows) { <tr>@foreach (var cell in row) { <td><pre>@(cell ?? "NULL")</pre></td> }</tr> } }
                </tbody></table></div>
                @if (Vm.Result?.Truncated == true) { <p class="note">Results reached the display limit. Narrow your query.</p> }
                @if (Vm.Result?.Cursor is not null) { <button class="dcbtn" disabled="@Vm.Busy" @onclick="() => Vm.RunAsync(true)">Next keys</button> }
            </div>
        </section>
    }
    else if (Vm.Busy) { <Skeleton Kind="list" Rows="4" /> }
</div>
@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid DatabaseId { get; set; }
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override Task OnParametersSetAsync() => Vm.LoadAsync(ProjectId, DatabaseId);
    protected override Task OnAfterRenderAsync(bool firstRender) => Vm.AfterRenderAsync();
    public ValueTask DisposeAsync() => Vm.DisposeAsync();
}
