@page "/about"
@inject PortalUiState Ui

<PageTitle>PlaceContext — About</PageTitle>

<div style="padding:24px 24px 40px; max-width:720px; margin:0 auto">
    <div class="dccard" style="padding:28px 30px">
        <div style="display:flex; align-items:center; gap:12px; margin-bottom:14px">
            <div style="width:36px; height:36px; flex:none; border-radius:9px; background:var(--brand); display:flex; align-items:center; justify-content:center">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8l3.5 4L5 16"></path><path d="M13 16h6"></path></svg>
            </div>
            <div>
                <div style="font-size:17px; font-weight:600; letter-spacing:-.3px">PlaceContext</div>
                <div style="font-size:12px; color:var(--text-3)">a context platform for AI</div>
            </div>
        </div>

        <p style="font-size:13px; color:var(--text-2); line-height:1.7; margin:0 0 14px">
            PlaceContext gives AI agents and the people working with them a durable, structured home for
            project context — decisions, activity, knowledge graphs, jobs and their artifacts, data, and
            analytics — served over MCP and this portal.
        </p>

        <div style="border-top:1px solid var(--border); padding-top:14px; font-size:12.5px; color:var(--text-2); line-height:1.8">
            Built by <strong>Bradley Lietz</strong> of <strong>CTRL SIGNAL SOFTWARE PTY LTD</strong>.<br />
            <span style="color:var(--text-3)">© @DateTime.UtcNow.Year CTRL SIGNAL SOFTWARE PTY LTD. All rights reserved.</span>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized() => Ui.Set("About", "PlaceContext — a context platform for AI");
}
