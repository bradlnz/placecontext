@page "/about"
@attribute [Authorize]
@using PlaceContext.Host.Components.ViewModels
@inject AboutViewModel Vm

<PageTitle>PlaceContext — About</PageTitle>

<div class="page">
    <div class="dccard card">
        <div class="brand-row">
            <div class="logo">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8l3.5 4L5 16"></path><path d="M13 16h6"></path></svg>
            </div>
            <div>
                <div class="product">PlaceContext</div>
                <div class="tagline">a full-scale data platform</div>
            </div>
        </div>

        <p class="lead">
            PlaceContext is a self-hosted job engine for defining, scheduling, and running durable workloads
            across infrastructure you own. It brings code and container jobs, pipelines, project data,
            observability, and artifacts into one workspace.
        </p>

        <div class="section">
            <div class="section-title">Platform</div>
            <p class="section-body">
                Build project-scoped tables and entity models, run scheduled or event-driven jobs and pipelines,
                inspect lineage and execution traces, and create reports and charts. Use the web workspace directly
                or connect automation and AI clients through MCP.
            </p>
        </div>

        <div class="section">
            <div class="section-title">Product</div>
            <p class="section-body">
                PlaceContext is open-source software by <strong>Bradley Lietz</strong>
                (CTRL SIGNAL SOFTWARE PTY LTD), released under the MIT License.
            </p>
        </div>

        <div class="section">
            <div class="section-title">Your data &amp; jobs</div>
            <p class="section-body">
                <strong>You own your data and your jobs.</strong> Project data, decisions,
                activity, secrets, job definitions, runs, and artifacts remain yours. We claim no
                ownership of content you create or import — the platform only stores and runs it for you.
            </p>
        </div>

        <div class="section">
            <div class="section-title">Built on</div>
            <p class="section-note">
                ASP.NET Core &amp; EF Core (MIT) · PostgreSQL (PostgreSQL License) · ModelContextProtocol SDK (MIT) ·
                k3s/k3d (Apache-2.0) · MinIO (AGPL-3.0, unmodified service) ·
                Bubble Tea &amp; Lip Gloss (MIT) · Monaco Editor (MIT) · Markdig (BSD-2-Clause) ·
                Cronos (MIT) · Npgsql (PostgreSQL License) · Geist typeface (SIL OFL 1.1).
                Full attributions ship in <code>THIRD-PARTY-NOTICES.md</code>.
            </p>
        </div>

        <div class="footer">
            Created by <strong>Bradley Lietz</strong>.<br />
            <span class="muted">© @Vm.CopyrightYear Bradley Lietz / CTRL SIGNAL SOFTWARE PTY LTD — product rights reserved; your data &amp; jobs are yours.</span>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized() => Vm.Initialize();
}
