@page "/about"
@attribute [Authorize]
@using PlaceContext.Host.Components.ViewModels
@inject AboutViewModel Vm

<PageTitle>PlaceContext — About</PageTitle>

<div class="page">
    <div class="dccard card">
        <div class="brand-row">
            <div class="logo">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M5 8l3.5 4L5 16"></path><path d="M13 16h6"></path></svg>
            </div>
            <div>
                <div class="product">PlaceContext</div>
                <div class="tagline">self-hosted data operations</div>
            </div>
        </div>

        <p class="lead">
            PlaceContext is a self-hosted workspace for operational data and durable workloads. Define jobs,
            schedule or trigger them, work with project data, and inspect every run without handing control of
            your infrastructure to a hosted platform.
        </p>

        <div class="section">
            <div class="section-title">Platform</div>
            <p class="section-body">
                Build project-scoped tables and entity models, run code, container, and PostgreSQL jobs, compose
                pipelines, inspect execution traces, and retain outputs as versioned artifacts. Use the web workspace
                directly or connect trusted automation and AI clients through authenticated APIs and MCP.
            </p>
        </div>

        <div class="section">
            <div class="section-title">Deployment</div>
            <p class="section-body">
                Run a local evaluation cluster with Docker and k3d, or deploy the stateless application to an existing
                hardened k3s cluster with external PostgreSQL and object storage. PlaceContext keeps deployment choices
                explicit so evaluation defaults are not mistaken for a production architecture.
            </p>
        </div>

        <div class="section">
            <div class="section-title">Product</div>
            <p class="section-body">
                PlaceContext is open-source software by <strong>Bradley Lietz</strong>
                (CTRL SIGNAL SOFTWARE PTY LTD), released under the MIT License.
            </p>
        </div>

        <div class="section">
            <div class="section-title">Your data &amp; jobs</div>
            <p class="section-body">
                <strong>You own your data and your jobs.</strong> Project data, decisions,
                activity, secrets, job definitions, runs, and artifacts remain yours. We claim no
                ownership of content you create or import — the platform only stores and runs it for you.
            </p>
        </div>

        <div class="section">
            <div class="section-title">Built on</div>
            <p class="section-note">
                .NET 10, ASP.NET Core &amp; EF Core (MIT) · PostgreSQL and pgvector (PostgreSQL License) ·
                Model Context Protocol SDK (MIT) · k3s/k3d and Traefik (Apache-2.0) · OpenTelemetry (Apache-2.0) ·
                Monaco Editor (MIT) · Markdig (BSD-2-Clause) · Cronos (MIT) · Npgsql (PostgreSQL License) ·
                Inter typeface (SIL OFL 1.1).
                Full attributions ship in <code>THIRD-PARTY-NOTICES.md</code>.
            </p>
        </div>

        <nav class="resources" aria-label="PlaceContext resources">
            <a href="/wiki/getting-started">Getting started</a>
            <a href="/wiki">Documentation</a>
            <a href="https://github.com/bradlnz/placecontext" target="_blank" rel="noopener noreferrer">Source and releases</a>
        </nav>

        <div class="footer">
            Created by <strong>Bradley Lietz</strong>.<br />
            <span class="muted">© @Vm.CopyrightYear Bradley Lietz / CTRL SIGNAL SOFTWARE PTY LTD — MIT licensed; your data &amp; jobs are yours.</span>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized() => Vm.Initialize();
}
