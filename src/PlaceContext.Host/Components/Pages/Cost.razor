@page "/cost"
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject NavigationManager Nav

<PageTitle>PlaceContext — Tokens &amp; Cost</PageTitle>

<div style="padding:24px 24px 40px; max-width:1080px; margin:0 auto">
    <div style="display:flex; align-items:center; gap:9px; margin-bottom:18px">
        <h2 style="font-size:14px; font-weight:600; margin:0">Tokens &amp; cost</h2>
        <span style="font-size:11px; color:var(--text-3)">reported via the <code>record_usage</code> MCP tool · metadata only</span>
    </div>

    @if (_cost is null)
    {
        <p style="color:var(--text-3)">Loading…</p>
    }
    else
    {
        <!-- stat strip -->
        <div style="display:grid; grid-template-columns:repeat(4,1fr); gap:0; background:var(--card); border:1px solid var(--border); border-radius:12px; overflow:hidden; margin-bottom:22px">
            @Stat("Total cost", _cost.CostUsd.ToString("C2"), $"{_cost.RecordCount} records", "var(--brand)")
            @Stat("Input tokens", Fmt(_cost.InputTokens), "prompt", "var(--text)")
            @Stat("Output tokens", Fmt(_cost.OutputTokens), "completion", "var(--text)")
            @Stat("Total tokens", Fmt(_cost.InputTokens + _cost.OutputTokens), "in + out", "var(--text)")
        </div>

        @if (_cost.RecordCount == 0)
        {
            <div class="dccard" style="padding:30px; text-align:center; color:var(--text-3)">
                No usage recorded yet. Agents report token usage through the <code>record_usage</code> MCP tool.
            </div>
        }
        else
        {
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:14px; align-items:start">
                <!-- by model -->
                <div class="dccard" style="overflow:hidden">
                    <div style="padding:13px 15px; border-bottom:1px solid var(--border); font-size:13px; font-weight:600">By model</div>
                    @foreach (var m in _cost.ByModel)
                    {
                        <div style="display:flex; align-items:center; gap:12px; padding:11px 15px; border-bottom:1px solid var(--border)">
                            <span style="font-family:'Geist Mono',monospace; font-size:12px; flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">@m.Model</span>
                            <span style="font-family:'Geist Mono',monospace; font-size:11px; color:var(--text-3)">@Fmt(m.InputTokens + m.OutputTokens) tok</span>
                            <span style="font-family:'Geist Mono',monospace; font-size:12.5px; font-weight:600; color:var(--brand); width:74px; text-align:right">@m.CostUsd.ToString("C2")</span>
                        </div>
                    }
                </div>

                <!-- by project -->
                <div class="dccard" style="overflow:hidden">
                    <div style="padding:13px 15px; border-bottom:1px solid var(--border); font-size:13px; font-weight:600">By project</div>
                    @foreach (var p in _cost.ByProject)
                    {
                        <div style="display:flex; align-items:center; gap:12px; padding:11px 15px; border-bottom:1px solid var(--border); cursor:pointer" @onclick="@(() => Nav.NavigateTo($"/project/{p.ProjectId}"))">
                            <span style="font-size:12.5px; flex:1; white-space:nowrap; overflow:hidden; text-overflow:ellipsis">@p.Project</span>
                            <span style="font-family:'Geist Mono',monospace; font-size:11px; color:var(--text-3)">@Fmt(p.TotalTokens) tok</span>
                            <span style="font-family:'Geist Mono',monospace; font-size:12.5px; font-weight:600; color:var(--brand); width:74px; text-align:right">@p.CostUsd.ToString("C2")</span>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@code {
    private RootCostView? _cost;

    protected override async Task OnInitializedAsync()
    {
        Ui.Set("Tokens & Cost", "LLM spend across the workspace");
        _cost = await Svc.GetRootCostAsync();
    }

    private static string Fmt(long n) => n switch
    {
        >= 1_000_000 => $"{n / 1_000_000.0:0.0}M",
        >= 1_000 => $"{n / 1_000.0:0.0}k",
        _ => n.ToString()
    };

    private RenderFragment Stat(string label, string value, string sub, string color) => builder =>
        builder.AddMarkupContent(0, $@"
            <div style='padding:15px 16px; border-right:1px solid var(--border)'>
              <div style='font-size:10.5px; color:var(--text-3); text-transform:uppercase; letter-spacing:.5px; font-weight:600; margin-bottom:9px'>{label}</div>
              <div style='font-size:23px; font-weight:600; letter-spacing:-.6px; font-family:Geist Mono,monospace; color:{color}'>{System.Net.WebUtility.HtmlEncode(value)}</div>
              <div style='font-size:11px; color:var(--text-3); margin-top:3px'>{sub}</div>
            </div>");
}
