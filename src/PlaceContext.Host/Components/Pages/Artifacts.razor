@inject ArtifactsViewModel Vm
@using PlaceContext.Host.Components.ViewModels
@page "/artifacts"
@attribute [Authorize(Policy = Permission.ArtifactsView)]
@implements IDisposable
@using PlaceContext.Application.Features
@using PlaceContext.Application.Dtos

<PageTitle>placecontext — Artifacts</PageTitle>

<div class="page">

    @* ── File list ─────────────────────────────────────────────────────────────────────── *@
    <div class="file-panel">
        <div class="file-panel-head">
            <div class="head-row">
                <span class="panel-title">Artifact files</span>
                <input class="dcinput filter-input" placeholder="search files…"
                       value="@Vm.Filter" @oninput="Vm.OnFilterInputAsync" />
            </div>
            <select class="dcinput project-select" value="@Vm.ProjectFilter" @onchange="Vm.OnProjectFilter">
                <option value="">All projects</option>
                @foreach (var p in Vm.Projects)
                {
                    <option value="@p.Id">@p.Name</option>
                }
            </select>
            <div class="artifact-type-bar" aria-label="Artifact type filters">
                <button class="type-toggle @(string.IsNullOrEmpty(Vm.CategoryFilter) ? "active" : null)"
                        @onclick="@(() => Vm.SetCategoryFilter(null))">
                    <span>All</span><small>@Vm.BaseFiltered().Count</small>
                </button>
                @foreach (var category in Vm.ArtifactConfig.Categories)
                {
                    <button class="type-toggle @(Vm.CategoryFilter == category.Id ? "active" : null)"
                            title="Prefixes: @string.Join(", ", category.Prefixes)"
                            @onclick="@(() => Vm.SetCategoryFilter(category.Id))">
                        <span>@category.Label</span><small>@Vm.CategoryCount(category.Id)</small>
                    </button>
                }
                @if (Vm.OtherCount() > 0)
                {
                    <button class="type-toggle @(Vm.CategoryFilter == ArtifactsViewModel.OtherCategory ? "active" : null)"
                            @onclick="@(() => Vm.SetCategoryFilter(ArtifactsViewModel.OtherCategory))">
                        <span>Other</span><small>@Vm.OtherCount()</small>
                    </button>
                }
                @if (Vm.CanManageSettings)
                {
                    <a class="type-config" href="/settings/artifacts" title="Configure artifact filters"
                       aria-label="Configure artifact filters">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 15.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7z" />
                            <path d="M19.4 15a1.7 1.7 0 0 0 .34 1.88l.06.06-2.83 2.83-.06-.06A1.7 1.7 0 0 0 15 19.4a1.7 1.7 0 0 0-1 .6 1.7 1.7 0 0 0-.4 1.1V21h-4v-.09a1.7 1.7 0 0 0-1.1-1.56 1.7 1.7 0 0 0-1.88.34l-.06.06-2.83-2.83.06-.06A1.7 1.7 0 0 0 4.6 15a1.7 1.7 0 0 0-.6-1 1.7 1.7 0 0 0-1.1-.4H3v-4h.09a1.7 1.7 0 0 0 1.56-1.1 1.7 1.7 0 0 0-.34-1.88l-.06-.06 2.83-2.83.06.06A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-.6 1.7 1.7 0 0 0 .4-1.1V3h4v.09a1.7 1.7 0 0 0 1.1 1.56 1.7 1.7 0 0 0 1.88-.34l.06-.06 2.83 2.83-.06.06A1.7 1.7 0 0 0 19.4 9c.08.38.29.73.6 1 .3.25.69.4 1.1.4h.09v4h-.09a1.7 1.7 0 0 0-1.7.6z" />
                        </svg>
                    </a>
                }
            </div>
            @if (Vm.CanDelete && Vm.Selected.Count > 0)
            {
                <div class="bulk-bar">
                    <span class="selected-count">@Vm.Selected.Count selected</span>
                    <button class="dcbtn bulk-delete-btn" disabled="@Vm.BulkDeleting"
                            @onclick="Vm.DeleteSelectedAsync">@(Vm.BulkDeleting ? "Deleting…" : "Delete selected")</button>
                    <button class="dcbtn bulk-clear-btn" disabled="@Vm.BulkDeleting"
                            @onclick="@(() => Vm.Selected.Clear())">Clear</button>
                </div>
            }
            @if (Vm.LoadMayBeIncomplete)
            {
                <div class="cap-note">
                    Showing the newest @Vm.Files.Count loaded files — older ones may not be listed yet. Pick a project or narrow the search to see more.
                </div>
            }
        </div>
        @{
            var groups = Vm.Grouped();
            var totalGroups = groups.Count;
            var maxFilesPage = Math.Max(1, (int)Math.Ceiling(totalGroups / (double)ArtifactsViewModel.FilesPageSize));
            if (Vm.FilesPage > maxFilesPage) Vm.FilesPage = maxFilesPage;
            var pageGroups = groups.Skip((Vm.FilesPage - 1) * ArtifactsViewModel.FilesPageSize).Take(ArtifactsViewModel.FilesPageSize).ToList();
        }
        <div class="file-list">
            @if (totalGroups == 0)
            {
                <div class="empty-note">
                    @Vm.EmptyMessage()
                </div>
            }
            else
            {
                @foreach (var group in pageGroups)
                {
                    var latest = group[0];
                    var groupKey = ArtifactsViewModel.GroupKey(latest);
                    var active = Vm.Active is { } act && group.Any(v => v.Id == act.Id);
                    <div class="file-group" style="border-left:2px solid @(active ? "var(--brand)" : "transparent")">
                        <div @onclick="@(() => Vm.OpenAsync(latest))"
                             class="file-row" style="background:@(active ? "var(--card)" : "transparent")">
                            @if (Vm.CanDelete)
                            {
                                <input type="checkbox" checked="@Vm.GroupAllSelected(group)" title="Select for delete"
                                       @onclick:stopPropagation="true"
                                       @onchange="@(e => Vm.ToggleGroup(group, (bool)(e.Value ?? false)))"
                                       class="select-check" />
                            }
                            <span class="file-icon">@Vm.Presentation.FileIcon(latest.ContentType, 16)</span>
                            <div class="file-meta">
                                <div class="file-title">@latest.Title</div>
                                <div class="file-sub">
                                    @Vm.ProjectName(latest.ProjectId) · @latest.Kind · @Vm.Presentation.Bytes(latest.SizeBytes) · @Vm.Presentation.ShortDateTime(latest.CreatedAt)
                                </div>
                            </div>
                            @if (group.Count > 1)
                            {
                                <button title="@(group.Count) versions — show history"
                                        class="version-btn"
                                        @onclick:stopPropagation="true"
                                        @onclick="@(() => Vm.Expanded = Vm.Expanded == groupKey ? null : groupKey)">
                                    v@(group.Count) @(Vm.Expanded == groupKey ? "▴" : "▾")
                                </button>
                            }
                        </div>
                        @if (Vm.Expanded == groupKey && group.Count > 1)
                        {
                            @foreach (var version in group.Skip(1).Select((ArtifactFileView artifact, int index) =>
                                (Artifact: artifact, Number: group.Count - 1 - index)))
                            {
                                var v = version.Artifact;
                                var n = version.Number;
                                var vActive = Vm.Active?.Id == v.Id;
                                <div @onclick="@(() => Vm.OpenAsync(v))"
                                     class="version-row" style="background:@(vActive ? "var(--card)" : "transparent")">
                                    @if (Vm.CanDelete)
                                    {
                                        <input type="checkbox" checked="@Vm.Selected.Contains(v.Id)"
                                               @onclick:stopPropagation="true"
                                               @onchange="@(e => Vm.ToggleOne(v.Id, (bool)(e.Value ?? false)))"
                                               class="select-check" />
                                    }
                                    <span class="version-tag">v@(n)</span>
                                    <span class="version-date">@Vm.Presentation.ShortDateTime(v.CreatedAt)</span>
                                    <span class="version-size">@Vm.Presentation.Bytes(v.SizeBytes)</span>
                                </div>
                            }
                        }
                    </div>
                }
            }
        </div>
        @if (totalGroups > 0)
        {
            <div class="pager-row">
                <span class="pager-info">
                    Showing @(((Vm.FilesPage - 1) * ArtifactsViewModel.FilesPageSize) + 1)–@(Math.Min(Vm.FilesPage * ArtifactsViewModel.FilesPageSize, totalGroups)) of @totalGroups files
                </span>
                <div class="pager-controls">
                    <button class="dcbtn pager-btn" disabled="@(Vm.FilesPage <= 1)"
                            @onclick="@(() => Vm.GoToFilesPage(Vm.FilesPage - 1))">‹ Prev</button>
                    <span class="pager-page">Page @Vm.FilesPage of @maxFilesPage</span>
                    <button class="dcbtn pager-btn" disabled="@(Vm.FilesPage >= maxFilesPage)"
                            @onclick="@(() => Vm.GoToFilesPage(Vm.FilesPage + 1))">Next ›</button>
                </div>
            </div>
        }
    </div>

    @* ── Viewer ────────────────────────────────────────────────────────────────────────── *@
    <div class="viewer @(Vm.Active is not null ? "active" : null)">
        @if (Vm.Active is null)
        {
            <div class="viewer-empty">
                <span class="icon-placeholder">@Vm.Presentation.FileIcon("", 40)</span>
                @if (Vm.LoadError is { } deepLinkError)
                {
                    <span>Couldn't open the linked artifact — @deepLinkError.</span>
                }
                else
                {
                    <span>Select a file on the left to view it.</span>
                }
            </div>
        }
        else
        {
            <div class="viewer-head">
                <button class="viewer-back" @onclick="Vm.CloseViewer" title="Back to files">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5"></path><path d="M12 19l-7-7 7-7"></path></svg>
                    Back
                </button>
                <span class="viewer-title">@Vm.Active.Title</span>
                <span class="viewer-ct">@Vm.Active.ContentType</span>
                <a class="dcbtn viewer-open-btn" target="_blank" rel="noopener"
                   href="@ArtifactsViewModel.Url(Vm.Active)">Open ↗</a>
                @if (Vm.CanShare)
                {
                    <button class="dcbtn viewer-btn" title="Create or manage a public share link"
                            @onclick="Vm.ToggleShareAsync">@(Vm.ShareOpen ? "Close share" : "Share")</button>
                }
                @if (Vm.CanDelete && Vm.ConfirmDelete)
                {
                    <button class="dcbtn viewer-btn-danger"
                            disabled="@Vm.Deleting" @onclick="Vm.DeleteActiveAsync">@(Vm.Deleting ? "Deleting…" : "Confirm delete")</button>
                    <button class="dcbtn viewer-btn" disabled="@Vm.Deleting"
                            @onclick="@(() => Vm.ConfirmDelete = false)">Keep</button>
                }
                else if (Vm.CanDelete)
                {
                    <button class="dcbtn viewer-btn" title="Permanently delete this artifact"
                            @onclick="@(() => Vm.ConfirmDelete = true)">Delete</button>
                }
            </div>
            @if (Vm.ShareOpen)
            {
                <div class="share-panel">
                    <div class="share-copy">
                        <strong>Public share link</strong>
                        <span>Anyone with the code can open this artifact without signing in. Links expire and can be revoked.</span>
                    </div>
                    @if (Vm.ShareBusy)
                    {
                        <span class="share-status">Working…</span>
                    }
                    else if (Vm.ShareUrl is not null)
                    {
                        <div class="share-link-row">
                            <input class="dcinput share-link" value="@Vm.ShareUrl" readonly />
                            <button class="dcbtn viewer-btn" @onclick="Vm.CopyShareAsync">Copy link</button>
                        </div>
                        <span class="share-status">
                            This link is shown once and expires @(Vm.ShareCreatedExpiresAt is { } expires ? Vm.Presentation.Format(expires, "MMM d, yyyy · HH:mm") : "").
                        </span>
                    }
                    else if (Vm.ShareStatus?.IsActive == true)
                    {
                        <div class="share-actions">
                            <span class="share-status">
                                Active code @Vm.ShareStatus.TokenPrefix · expires @Vm.Presentation.Format(Vm.ShareStatus.ExpiresAt, "MMM d, yyyy · HH:mm")
                                @if (Vm.ShareStatus.LastAccessedAt is { } accessed)
                                {
                                    <span> · last opened @Vm.Presentation.Format(accessed, "MMM d · HH:mm")</span>
                                }
                            </span>
                            <button class="dcbtn viewer-btn" @onclick="Vm.CreateShareAsync">Rotate link</button>
                            <button class="dcbtn viewer-btn-danger" @onclick="Vm.RevokeShareAsync">Revoke</button>
                        </div>
                    }
                    else
                    {
                        <div class="share-actions">
                            <label class="share-duration">
                                Expires after
                                <select class="dcinput" @bind="Vm.ShareLifetimeDays">
                                    <option value="1">1 day</option>
                                    <option value="7">7 days</option>
                                    <option value="30">30 days</option>
                                </select>
                            </label>
                            <button class="dcbtn viewer-btn" @onclick="Vm.CreateShareAsync">Create public link</button>
                        </div>
                    }
                    @if (Vm.ShareMessage is not null)
                    {
                        <span class="share-message">@Vm.ShareMessage</span>
                    }
                </div>
            }
            @if (Vm.LoadFailed)
            {
                <div class="viewer-error">
                    <span class="icon-warn">@Vm.Presentation.FileIcon(Vm.Active.ContentType, 34)</span>
                    Couldn't load the preview — @(Vm.LoadError ?? "unknown error").
                    <span>Use <strong>Open ↗</strong> to fetch the file directly.</span>
                </div>
            }
            else if (Vm.Presentation.IsJson(Vm.Active.ContentType))
            {
                <div class="json-view">
                    @if (Vm.Loading)
                    {
                        <Skeleton Kind="text" Rows="8" />
                    }
                    else if (Vm.Content is null)
                    {
                        <div class="raw-note">Not valid JSON — showing the raw content:</div>
                        <pre class="raw-pre">@Vm.RawText</pre>
                    }
                    else
                    {
                        @Vm.JsonTree(Vm.Content)
                    }
                </div>
            }
            else if (ArtifactsViewModel.IsCsv(Vm.Active.ContentType))
            {
                <div class="csv-view">
                    @if (Vm.Loading)
                    {
                        <Skeleton Kind="table" Rows="8" Columns="5" />
                    }
                    else if (Vm.Csv is null)
                    {
                        <span class="csv-error">Couldn't parse this CSV — use Open ↗.</span>
                    }
                    else
                    {
                        <table class="csv-table">
                            <thead>
                                <tr>
                                    @foreach (var h in Vm.Csv.Value.Header)
                                    {
                                        <th class="csv-th">@h</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Vm.Csv.Value.Rows)
                                {
                                    <tr>
                                        @foreach (var cell in row)
                                        {
                                            <td class="csv-td">@cell</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (Vm.Truncated)
                        {
                            <div class="truncated-note">Showing the first rows — Open ↗ for the full file.</div>
                        }
                    }
                </div>
            }
            else if (ArtifactsViewModel.IsImage(Vm.Active))
            {
                <div class="image-view">
                    <img src="@ArtifactsViewModel.Url(Vm.Active)" class="artifact-image" alt="@Vm.Active.Title" />
                </div>
            }
            else if (ArtifactsViewModel.IsPdf(Vm.Active.ContentType))
            {
                @* Mobile Safari and several Android webviews only expose the first page of an
                   embedded PDF. On compact screens PDF.js renders every page into this scrollable
                   canvas list. Desktop retains the browser's native viewer and toolbar. *@
                <div class="pdf-view">
                    <div id="@ArtifactsViewModel.PdfMobileId(Vm.Active)" class="pdf-mobile-view" aria-label="PDF pages"
                         data-pc-pdf data-pdf-url="@ArtifactsViewModel.Url(Vm.Active)">
                        <div class="pdf-loading">Preparing all PDF pages…</div>
                    </div>
                    <iframe src="@ArtifactsViewModel.Url(Vm.Active)" class="preview-frame pdf-desktop-frame" title="@Vm.Active.Title"
                            loading="lazy" referrerpolicy="no-referrer"></iframe>
                </div>
            }
            else if (ArtifactsViewModel.Previewable(Vm.Active.ContentType))
            {
                @* Relative /runs/… — browser keeps the public DNS host (never rewrite to in-cluster name).
                   No sandbox attribute here: it would give the frame an opaque origin, so the browser
                   drops the SameSite=Lax auth cookie and the [Authorize] endpoint bounces to /locked.
                   HTML/SVG is still sandboxed — ArtifactsController sends CSP "sandbox", which applies
                   after the authenticated fetch. *@
                <iframe src="@ArtifactsViewModel.Url(Vm.Active)" class="preview-frame" title="@Vm.Active.Title"
                        loading="lazy" referrerpolicy="no-referrer"></iframe>
            }
            else
            {
                <div class="viewer-none">
                    <span class="icon-placeholder">@Vm.Presentation.FileIcon(Vm.Active.ContentType, 40)</span>
                    No inline preview for @Vm.Active.ContentType — use Open ↗ to download it.
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter]
    public string? ArtifactId { get; set; }

    protected override Task OnInitializedAsync()
        => Vm.AttachAndInitializeAsync(() => InvokeAsync(StateHasChanged));

    protected override Task OnParametersSetAsync()
    {
        Vm.ArtifactId = ArtifactId;
        return Vm.ApplyDeepLinkAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender) => Vm.AfterRenderAsync(firstRender);

    public void Dispose() => Vm.Detach();
}
