@page "/settings/communications"
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@attribute [Authorize(Policy = Policies.DefaultAdmin)]
@using PlaceContext.Host.Components.ViewModels
@inject CommunicationsSettingsViewModel Vm
@implements IDisposable


<PageTitle>PlaceContext — Communications</PageTitle>

<div class="communications-page">
    <header class="settings-head">
        <div>
            <span class="settings-kicker">Workspace integrations</span>
            <h2>Communications</h2>
            <p>Connect providers for workflows and sign-in codes. Credentials are referenced from project Vaults and resolved only when a message is sent.</p>
        </div>
        <button class="dcbtn primary" @onclick="Vm.ShowAdd">+ Add provider</button>
    </header>

    @if (Vm.Loading)
    {
        <div class="dccard loading-card">Loading communication providers…</div>
    }
    else if (Vm.LoadError is not null)
    {
        <div class="settings-alert error">@Vm.LoadError</div>
    }
    else
    {
        @if (Vm.Message is not null)
        {
            <div class="settings-alert @(Vm.MessageIsError ? "error" : "success")">@Vm.Message</div>
        }

        <section class="dccard provider-card">
            @if (Vm.Providers.Count == 0)
            {
                <div class="empty-note">No communication providers configured.</div>
            }
            else
            {
                @foreach (var provider in Vm.Providers)
                {
                    <article class="provider-row @(!provider.Enabled ? "disabled" : "")">
                        <div class="provider-info">
                            <strong>@provider.Name</strong>
                            <span class="channel-badge">@Vm.ChannelLabel(provider.Channel)</span>
                            <span class="kind-badge">@Vm.KindLabel(provider.Kind)</span>
                            @if (provider.IsDefault)
                            {
                                <span class="flag-badge default">Default</span>
                            }
                            @if (provider.UseForTwoFactor)
                            {
                                <span class="flag-badge twofactor">2FA</span>
                            }
                            <label class="enabled-toggle">
                                <input type="checkbox" checked="@provider.Enabled"
                                       @onchange="@(() => Vm.ToggleEnabledAsync(provider))" />
                                Enabled
                            </label>
                        </div>
                        <div class="provider-actions">
                            @if (!provider.IsDefault)
                            {
                                <button class="dcbtn xs" @onclick="@(() => Vm.SetDefaultAsync(provider.Id))">Make default</button>
                            }
                            <button class="dcbtn xs" @onclick="@(() => Vm.ToggleTwoFactorAsync(provider))">
                                @(provider.UseForTwoFactor ? "Remove 2FA" : "Use for 2FA")
                            </button>
                            <button class="dcbtn xs" @onclick="@(() => Vm.StartTest(provider))">Test</button>
                            <button class="dcbtn xs" @onclick="@(() => Vm.StartEdit(provider))">Edit</button>
                            @if (Vm.ConfirmDeleteId == provider.Id)
                            {
                                <button class="dcbtn xs danger" @onclick="@(() => Vm.DeleteAsync(provider.Id))">Confirm</button>
                                <button class="dcbtn xs" @onclick="@(() => Vm.ConfirmDeleteId = null)">Keep</button>
                            }
                            else
                            {
                                <button class="dcbtn xs danger" @onclick="@(() => Vm.ConfirmDeleteId = provider.Id)">Delete</button>
                            }
                        </div>
                    </article>
                    @if (Vm.TestProviderId == provider.Id)
                    {
                        <div class="test-row">
                            <div class="dcfield test-recipient">
                                <label>Test recipient</label>
                                <input class="dcinput" @bind="Vm.TestRecipient"
                                       placeholder="@Vm.TestRecipientPlaceholder(provider.Channel)" />
                            </div>
                            <button class="dcbtn xs primary" disabled="@(Vm.TestSending || string.IsNullOrWhiteSpace(Vm.TestRecipient))"
                                    @onclick="@(() => Vm.SendTestAsync(provider.Id))">
                                @(Vm.TestSending ? "Sending…" : "Send test")
                            </button>
                            <button class="dcbtn xs" @onclick="@(() => Vm.TestProviderId = null)">Cancel</button>
                        </div>
                    }
                }
            }
        </section>

        @if (Vm.ShowForm)
        {
            <section class="dccard add-card">
                <div class="form-title">@(Vm.EditingId is null ? "New provider" : $"Edit {Vm.Name}")</div>
                <div class="field-grid">
                    <div class="dcfield">
                        <label>Channel</label>
                        <select class="dcinput" value="@Vm.Channel" @onchange="Vm.ChannelChanged">
                            <option value="email">Email</option>
                            <option value="sms">SMS</option>
                        </select>
                    </div>
                    <div class="dcfield">
                        <label>Provider kind</label>
                        <select class="dcinput" value="@Vm.Kind" @onchange="Vm.KindChanged">
                            @foreach (var kind in Vm.KindsForChannel(Vm.Channel))
                            {
                                <option value="@kind">@Vm.KindLabel(kind)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="field-grid">
                    <div class="dcfield">
                        <label>Display name</label>
                        <input class="dcinput" @bind="Vm.Name" placeholder="Transactional email" />
                    </div>
                    <div class="dcfield">
                        <label>Authentication</label>
                        <select class="dcinput" value="@Vm.AuthType" @onchange="Vm.AuthTypeChanged">
                            <option value="none">None</option>
                            <option value="bearer">Bearer token</option>
                            <option value="header">API key header</option>
                            <option value="basic">Basic auth</option>
                        </select>
                    </div>
                </div>
                <label class="enabled-toggle form-enabled">
                    <input type="checkbox" @bind="Vm.Enabled" /> Enabled
                </label>

                @if (Vm.IsHeaderAuth)
                {
                    <div class="dcfield">
                        <label>Header name</label>
                        <input class="dcinput" @bind="Vm.AuthHeaderName" placeholder="X-Api-Key" />
                        <small>The header that carries the API key. Postmark uses <code>X-Postmark-Server-Token</code>.</small>
                    </div>
                }
                @if (Vm.UsesSecret)
                {
                    @if (Vm.IsBasicAuth)
                    {
                        <div class="settings-alert">
                            Basic auth takes its username from the Account SID field below; the Vault secret is the auth token used as the password.
                        </div>
                    }
                    <div class="field-grid">
                        <div class="dcfield">
                            <label>Vault project</label>
                            <select class="dcinput" value="@Vm.VaultProjectId" @onchange="Vm.ProjectChanged">
                                <option value="">Select a project…</option>
                                @foreach (var project in Vm.Projects)
                                {
                                    <option value="@project.Id">@project.Name</option>
                                }
                            </select>
                            <small>The project whose Vault contains the API key.</small>
                        </div>
                        <div class="dcfield">
                            <label>API key secret</label>
                            <select class="dcinput" @bind="Vm.SecretName" disabled="@(Vm.VaultProjectId is null)">
                                <option value="">Select a Vault secret…</option>
                                @foreach (var secret in Vm.Secrets)
                                {
                                    <option value="@secret.Name">@secret.Name</option>
                                }
                            </select>
                            @if (Vm.VaultProjectId is not null && Vm.Secrets.Count == 0)
                            {
                                <small class="warning">No Vault secrets exist in this project yet.</small>
                            }
                        </div>
                    </div>
                }

                @if (Vm.IsTransactionalKind)
                {
                    <div class="field-grid">
                        <div class="dcfield">
                            <label>Verified sender email</label>
                            <input class="dcinput" type="email" @bind="Vm.FromEmail" placeholder="hello@yourdomain.com" />
                            <small>This address or its domain must be verified with the provider.</small>
                        </div>
                        <div class="dcfield">
                            <label>Sender name</label>
                            <input class="dcinput" @bind="Vm.FromName" placeholder="Your company" />
                        </div>
                    </div>
                    @if (Vm.IsPostmark)
                    {
                        <div class="dcfield stream-field">
                            <label>Message stream</label>
                            <input class="dcinput" @bind="Vm.MessageStream" placeholder="outbound" />
                            <small>Use <code>outbound</code> unless you created a dedicated transactional stream.</small>
                        </div>
                    }
                }
                else if (Vm.IsTwilio)
                {
                    <div class="field-grid">
                        <div class="dcfield">
                            <label>Account SID</label>
                            <input class="dcinput" @bind="Vm.AccountSid" placeholder="AC…" />
                            <small>Also used as the basic-auth username.</small>
                        </div>
                        <div class="dcfield">
                            <label>From number</label>
                            <input class="dcinput" @bind="Vm.FromNumber" placeholder="+15551234567" />
                        </div>
                    </div>
                }
                <div class="dcfield stream-field">
                    <label>Endpoint override <small>(optional)</small></label>
                    <input class="dcinput" @bind="Vm.Endpoint" placeholder="Leave empty for the provider default" />
                </div>

                <div class="form-actions">
                    <button class="dcbtn" @onclick="Vm.CloseForm">Cancel</button>
                    <button class="dcbtn primary" disabled="@(Vm.Saving || string.IsNullOrWhiteSpace(Vm.Name))"
                            @onclick="Vm.SaveAsync">
                        @(Vm.Saving ? "Saving…" : Vm.EditingId is null ? "Add provider" : "Save changes")
                    </button>
                </div>
            </section>
        }
    }
</div>


@code {
    protected override void OnInitialized()
        => Vm.Attach(() => InvokeAsync(StateHasChanged));

    protected override async Task OnInitializedAsync()
        => await Vm.LoadAsync();

    public void Dispose()
        => Vm.Detach();
}
