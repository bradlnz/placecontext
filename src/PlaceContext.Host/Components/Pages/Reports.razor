@page "/reports"
@using Markdig
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject PlaceContext.Application.Ports.ILlmGateway Llm

<PageTitle>PlaceContext — Reports</PageTitle>

<div style="padding:24px 24px 40px; max-width:1080px; margin:0 auto">
    <div style="display:flex; align-items:center; gap:9px; margin-bottom:16px">
        <h2 style="font-size:14px; font-weight:600; margin:0">Reports</h2>
        <span style="font-size:11px; color:var(--text-3)">generate a defined report from a project's accumulated data</span>
    </div>

    <div class="dccard" style="padding:14px 15px; margin-bottom:14px">
        <div style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap">
            <label style="display:flex; flex-direction:column; gap:4px; font-size:11.5px; color:var(--text-3)">
                Project
                <select @bind="_projectId" style="min-width:240px; padding:8px; background:var(--bg); border:1px solid var(--border); border-radius:7px; color:var(--text)">
                    <option value="">— choose —</option>
                    @foreach (var p in _projects)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </label>
            <label style="display:flex; flex-direction:column; gap:4px; font-size:11.5px; color:var(--text-3)">
                Report
                <select @bind="_template" style="min-width:220px; padding:8px; background:var(--bg); border:1px solid var(--border); border-radius:7px; color:var(--text)">
                    @foreach (var t in _templates)
                    {
                        <option value="@t.Name">@t.Name @(t.IsBuiltIn ? "(built-in)" : "")</option>
                    }
                </select>
            </label>
            <label style="display:flex; align-items:center; gap:6px; font-size:12px; color:var(--text-2)">
                <input type="checkbox" @bind="_createWorkItems" /> queue action plan as work items
            </label>
            <button class="dcbtn primary" @onclick="Generate" disabled="@(_busy || _projectId == "")">@(_busy ? "generating…" : "Generate")</button>
        </div>
        @if (_selectedTemplate is not null)
        {
            <div style="margin-top:10px; font-size:11.5px; color:var(--text-3)">@_selectedTemplate.Description</div>
        }
        @if (_message is not null) { <div style="color:var(--text-3); font-size:12px; margin-top:8px">@_message</div> }
    </div>

    @if (_report is not null)
    {
        <div class="dccard" style="padding:14px 15px">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px">
                <span style="font-size:12.5px; font-weight:600">@_report.TemplateName — @_report.ProjectName</span>
                <span style="font-size:11px; color:var(--text-3)">@(_report.GeneratedByLlm ? "LLM-polished" : "deterministic") · @_report.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
            </div>
            @if (_report.CreatedWorkItems.Count > 0)
            {
                <div style="font-size:11.5px; color:var(--good); margin-bottom:8px">Queued @_report.CreatedWorkItems.Count work item(s) from the action plan.</div>
            }

            @* Action-plan summary chart: count of actions by severity, as proportional bars. *@
            @if (_report.Actions.Count > 0)
            {
                <div style="margin-bottom:14px">
                    <div style="font-size:11px; color:var(--text-3); margin-bottom:6px">Action plan — @_report.Actions.Count item(s) by severity</div>
                    @foreach (var grp in SeverityCounts())
                    {
                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:3px">
                            <span style="width:72px; font-size:11px; color:var(--text-2); text-transform:capitalize">@grp.Key</span>
                            <div style="flex:1; background:var(--bg); border-radius:4px; overflow:hidden; height:14px">
                                <div style="width:@(Pct(grp.Value))%; height:100%; background:@SevColor(grp.Key)"></div>
                            </div>
                            <span style="width:26px; text-align:right; font-size:11px; color:var(--text-2)">@grp.Value</span>
                        </div>
                    }
                </div>

                <div style="display:flex; flex-direction:column; gap:8px; margin-bottom:14px">
                    @foreach (var a in _report.Actions)
                    {
                        <div style="border:1px solid var(--border); border-left:3px solid @SevColor(a.Severity); border-radius:7px; padding:10px 12px">
                            <div style="display:flex; align-items:center; gap:8px">
                                <span style="font-size:10px; font-weight:600; text-transform:uppercase; color:@SevColor(a.Severity)">@a.Severity</span>
                                <span style="font-size:12.5px; font-weight:600">@a.Title</span>
                            </div>
                            <div style="font-size:12px; color:var(--text-2); margin-top:3px">@a.Detail</div>
                        </div>
                    }
                </div>
            }

            @* Render the report body as HTML (Markdig) — headings, tables, and any embedded HTML render
               properly instead of as a raw text blob. *@
            <div class="dcreport" style="background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:16px; max-height:640px; overflow:auto; font-size:13px; line-height:1.6">
                @((MarkupString)RenderHtml(_report.Markdown))
            </div>
        </div>
    }

    @* ── Job data: the global reporting view. Every recent run is ingested; the tiles summarize
       the period, the local LLM narrates it, and any JSON numeric series becomes a chart card —
       jobs exist to generate artifacts, and this is where all of that output lands. ── *@
    <div style="display:flex; align-items:center; gap:9px; margin:24px 0 10px">
        <h3 style="font-size:13px; font-weight:600; margin:0">Job data</h3>
        <span style="font-size:11px; color:var(--text-3)">the last @_statRuns run(s) across all projects</span>
    </div>

    @if (_statRuns > 0)
    {
        <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(150px, 1fr)); gap:10px; margin-bottom:12px">
            <div class="dccard" style="padding:12px 14px">
                <div style="font-size:22px; font-weight:700">@_statRuns</div>
                <div style="font-size:11px; color:var(--text-3)">runs ingested</div>
            </div>
            <div class="dccard" style="padding:12px 14px">
                <div style="font-size:22px; font-weight:700; color:@(_statSuccessPct >= 90 ? "var(--good)" : _statSuccessPct >= 60 ? "var(--warn)" : "var(--bad)")">@_statSuccessPct%</div>
                <div style="font-size:11px; color:var(--text-3)">succeeded</div>
            </div>
            <div class="dccard" style="padding:12px 14px">
                <div style="font-size:22px; font-weight:700">@_statJobs</div>
                <div style="font-size:11px; color:var(--text-3)">jobs producing output</div>
            </div>
            <div class="dccard" style="padding:12px 14px">
                <div style="font-size:22px; font-weight:700">@_jobCharts.Count</div>
                <div style="font-size:11px; color:var(--text-3)">chartable series</div>
            </div>
        </div>
    }

    @if (_narrative is not null)
    {
        <div class="dccard" style="padding:12px 15px; margin-bottom:12px; border-left:3px solid var(--brand)">
            <div style="font-size:10.5px; text-transform:uppercase; letter-spacing:.5px; color:var(--text-3); margin-bottom:4px">agent summary</div>
            <div style="font-size:12.5px; line-height:1.55; color:var(--text-2)">@_narrative</div>
        </div>
    }
    else if (_narrativeLoading)
    {
        <div style="font-size:11px; color:var(--text-3); margin-bottom:12px">agent is summarising the period…</div>
    }

    @if (_jobCharts.Count == 0)
    {
        <div class="dccard" style="padding:14px 15px; font-size:12px; color:var(--text-3)">
            No chartable job output yet — when a run's artifact is JSON carrying a numeric series
            (e.g. <code>[{"day":"mon","total":12}, …]</code>), its chart appears here automatically.
        </div>
    }
    else
    {
        @foreach (var group in _jobCharts.GroupBy(c => (c.JobName, c.ProjectId)))
        {
            <div style="display:flex; align-items:baseline; gap:8px; margin:10px 0 8px">
                <a href="@($"/project/{group.Key.ProjectId}/jobs")" style="font-size:12.5px; font-weight:600; color:var(--text)">@group.Key.JobName</a>
                <span style="font-size:10.5px; color:var(--text-3)">@group.Count() chart(s)</span>
            </div>
            <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(320px, 1fr)); gap:12px">
                @foreach (var c in group)
                {
                    <div class="dccard" style="padding:12px 14px">
                        <div style="display:flex; align-items:baseline; justify-content:space-between; gap:8px; margin-bottom:2px">
                            <span style="font-size:10.5px; color:var(--text-3)">@c.Source</span>
                            <span style="font-size:10.5px; color:var(--text-3)">@c.StartedAt.ToLocalTime().ToString("MM-dd HH:mm")</span>
                        </div>
                        @((MarkupString)c.Svg)
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private IReadOnlyList<ProjectSummaryView> _projects = Array.Empty<ProjectSummaryView>();
    private IReadOnlyList<ReportTemplateView> _templates = Array.Empty<ReportTemplateView>();
    private string _projectId = "";
    private string _template = "Onboarding Brief";
    private bool _createWorkItems;
    private bool _busy;
    private string? _message;
    private ReportView? _report;

    private ReportTemplateView? _selectedTemplate => _templates.FirstOrDefault(t => t.Name == _template);

    // ── Job data (global chart view) ──────────────────────────────────────────────────────────
    private sealed record JobChartCard(string JobName, Guid ProjectId, DateTimeOffset StartedAt, string Source, string Svg);
    private List<JobChartCard> _jobCharts = new();
    private int _statRuns;
    private int _statSuccessPct;
    private int _statJobs;
    private string? _narrative;      // the local LLM's 2–3 sentence read of the period
    private bool _narrativeLoading;

    private const int MaxChartCards = 12;
    private const int MaxChartsPerRun = 2;

    /// <summary>Ingest recent runs and extract every chartable JSON artifact into a card.</summary>
    private async Task LoadJobChartsAsync()
    {
        var reports = await Svc.ListRecentRunReportsAsync(24);

        _statRuns = reports.Count;
        _statJobs = reports.Select(r => r.JobId).Distinct().Count();
        var finished = reports.Count(r => r.Run.Status is "Succeeded" or "Failed" or "Partial");
        _statSuccessPct = finished == 0 ? 0
            : (int)Math.Round(100.0 * reports.Count(r => r.Run.Status == "Succeeded") / finished);

        var cards = new List<JobChartCard>();
        foreach (var r in reports)
        {
            var seen = new HashSet<string>(); // identical shard outputs chart once per run
            var fromThisRun = 0;
            void TryAdd(string? payload, string source)
            {
                if (fromThisRun >= MaxChartsPerRun || cards.Count >= MaxChartCards) return;
                if (!ArtifactChart.TrySvg(payload, out var svg) || !seen.Add(svg)) return;
                cards.Add(new JobChartCard(r.JobName, r.Run.ProjectId, r.Run.StartedAt, source, svg));
                fromThisRun++;
            }

            foreach (var s in r.Run.ShardResults)
            {
                TryAdd(s.Artifact, $"shard {s.Index}");
                foreach (var a in s.Artifacts) TryAdd(a.Content, a.Name);
            }
            if (r.Run.ReduceResult is { } red)
            {
                TryAdd(red.Artifact, "reduce");
                foreach (var a in red.Artifacts) TryAdd(a.Content, a.Name);
            }
            if (cards.Count >= MaxChartCards) break;
        }
        _jobCharts = cards;

        // Hand the period to the local LLM for a short narrative — fire-and-forget so the page
        // never waits on the model; the summary card streams in when ready.
        if (Llm.IsEnabled && reports.Count > 0)
        {
            var context = string.Join("\n", reports.Select(r =>
                $"- {r.JobName}: {r.Run.Status}, started {r.Run.StartedAt:yyyy-MM-dd HH:mm}, " +
                $"{r.Run.ShardResults.Count} shard(s)"));
            _narrativeLoading = true;
            _ = GenerateNarrativeAsync(
                $"Recent job runs across all projects ({_statSuccessPct}% success):\n{context}");
        }
    }

    private async Task GenerateNarrativeAsync(string context)
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(45));
            var text = await Llm.GenerateAsync(
                "You summarise job-run activity for an operations dashboard. In two or three plain " +
                "sentences, say how the jobs have been doing and anything notable (failures, gaps, " +
                "unusually busy jobs). No markdown, no lists, no preamble — just the sentences.",
                context, cts.Token);
            var t = text.Trim();
            _narrative = t.Length > 600 ? t[..600] + "…" : t;
        }
        catch { /* the narrative is a bonus — its absence is never an error */ }
        finally
        {
            _narrativeLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static readonly Markdig.MarkdownPipeline _md =
        new Markdig.MarkdownPipelineBuilder().UseAdvancedExtensions().Build();

    // Render report Markdown (which may contain embedded HTML) to HTML for display.
    private static string RenderHtml(string markdown) => Markdig.Markdown.ToHtml(markdown ?? "", _md);

    private IEnumerable<KeyValuePair<string, int>> SeverityCounts()
    {
        var order = new[] { "critical", "high", "medium", "low", "info" };
        return _report!.Actions
            .GroupBy(a => (a.Severity ?? "info").ToLowerInvariant())
            .ToDictionary(g => g.Key, g => g.Count())
            .OrderBy(kv => Array.IndexOf(order, kv.Key) is var i && i >= 0 ? i : 99);
    }

    private int Pct(int n)
    {
        var max = _report!.Actions.Count;
        return max == 0 ? 0 : (int)Math.Round(100.0 * n / max);
    }

    private static string SevColor(string? severity) => (severity ?? "").ToLowerInvariant() switch
    {
        "critical" => "var(--err, #e5484d)",
        "high"     => "var(--warn, #f5a623)",
        "medium"   => "var(--brand, #6e9fff)",
        "low"      => "var(--good, #46a758)",
        _          => "var(--text-3)",
    };

    protected override async Task OnInitializedAsync()
    {
        Ui.Set("Reports", "defined reports from project data");
        try
        {
            _projects = await Svc.GetProjectsAsync();
            _templates = await Svc.ListReportTemplatesAsync();
            await LoadJobChartsAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private async Task Generate()
    {
        if (!Guid.TryParse(_projectId, out var pid)) return;
        _busy = true; _message = null; _report = null;
        try
        {
            _report = await Svc.GenerateReportAsync(pid, _template, _createWorkItems);
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _busy = false; }
    }
}
