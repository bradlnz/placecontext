@page "/reports"
@inject IPlaceContextService Svc
@inject PortalUiState Ui

<PageTitle>PlaceContext — Reports</PageTitle>

<div style="padding:24px 24px 40px; max-width:1080px; margin:0 auto">
    <div style="display:flex; align-items:center; gap:9px; margin-bottom:16px">
        <h2 style="font-size:14px; font-weight:600; margin:0">Reports</h2>
        <span style="font-size:11px; color:var(--text-3)">generate a defined report from a project's accumulated data</span>
    </div>

    <div class="dccard" style="padding:14px 15px; margin-bottom:14px">
        <div style="display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap">
            <label style="display:flex; flex-direction:column; gap:4px; font-size:11.5px; color:var(--text-3)">
                Project
                <select @bind="_projectId" style="min-width:240px; padding:8px; background:var(--bg); border:1px solid var(--border); border-radius:7px; color:var(--text)">
                    <option value="">— choose —</option>
                    @foreach (var p in _projects)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </label>
            <label style="display:flex; flex-direction:column; gap:4px; font-size:11.5px; color:var(--text-3)">
                Report
                <select @bind="_template" style="min-width:220px; padding:8px; background:var(--bg); border:1px solid var(--border); border-radius:7px; color:var(--text)">
                    @foreach (var t in _templates)
                    {
                        <option value="@t.Name">@t.Name @(t.IsBuiltIn ? "(built-in)" : "")</option>
                    }
                </select>
            </label>
            <label style="display:flex; align-items:center; gap:6px; font-size:12px; color:var(--text-2)">
                <input type="checkbox" @bind="_createWorkItems" /> queue action plan as work items
            </label>
            <button class="dcbtn primary" @onclick="Generate" disabled="@(_busy || _projectId == "")">@(_busy ? "generating…" : "Generate")</button>
        </div>
        @if (_selectedTemplate is not null)
        {
            <div style="margin-top:10px; font-size:11.5px; color:var(--text-3)">@_selectedTemplate.Description</div>
        }
        @if (_message is not null) { <div style="color:var(--text-3); font-size:12px; margin-top:8px">@_message</div> }
    </div>

    @if (_report is not null)
    {
        <div class="dccard" style="padding:14px 15px">
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:8px">
                <span style="font-size:12.5px; font-weight:600">@_report.TemplateName — @_report.ProjectName</span>
                <span style="font-size:11px; color:var(--text-3)">@(_report.GeneratedByLlm ? "LLM-polished" : "deterministic") · @_report.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
            </div>
            @if (_report.CreatedWorkItems.Count > 0)
            {
                <div style="font-size:11.5px; color:var(--good); margin-bottom:8px">Queued @_report.CreatedWorkItems.Count work item(s) from the action plan.</div>
            }
            <pre style="white-space:pre-wrap; font-family:'Geist Mono',monospace; font-size:12.5px; line-height:1.55; background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:14px; margin:0; color:var(--text); max-height:620px; overflow:auto">@_report.Markdown</pre>
        </div>
    }
</div>

@code {
    private IReadOnlyList<ProjectSummaryView> _projects = Array.Empty<ProjectSummaryView>();
    private IReadOnlyList<ReportTemplateView> _templates = Array.Empty<ReportTemplateView>();
    private string _projectId = "";
    private string _template = "Onboarding Brief";
    private bool _createWorkItems;
    private bool _busy;
    private string? _message;
    private ReportView? _report;

    private ReportTemplateView? _selectedTemplate => _templates.FirstOrDefault(t => t.Name == _template);

    protected override async Task OnInitializedAsync()
    {
        Ui.Set("Reports", "defined reports from project data");
        try
        {
            _projects = await Svc.GetProjectsAsync();
            _templates = await Svc.ListReportTemplatesAsync();
        }
        catch (Exception ex) { _message = ex.Message; }
    }

    private async Task Generate()
    {
        if (!Guid.TryParse(_projectId, out var pid)) return;
        _busy = true; _message = null; _report = null;
        try
        {
            _report = await Svc.GenerateReportAsync(pid, _template, _createWorkItems);
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _busy = false; }
    }
}
