@page "/brain"
@inject IPlaceContextService Svc
@inject PortalUiState Ui

<PageTitle>PlaceContext — Brain</PageTitle>

<div style="padding:24px 24px 40px; max-width:1320px; margin:0 auto">
    <div style="display:flex; align-items:center; gap:9px; margin-bottom:16px">
        <h2 style="font-size:14px; font-weight:600; margin:0">Organisation brain</h2>
        <span style="font-size:11px; color:var(--text-3)">every project's dependency graph joined into one · shared files link across projects</span>
    </div>

    <div class="dccard" style="overflow:hidden">
        <div style="display:flex; align-items:center; justify-content:space-between; padding:13px 15px; border-bottom:1px solid var(--border)">
            <span style="font-family:'Geist Mono',monospace; font-size:11px; color:var(--text-3)">@(_brain?.NodeCount ?? 0) nodes · @(_brain?.LinkCount ?? 0) links</span>
            <div style="display:flex; align-items:center; gap:12px; font-size:10.5px; color:var(--text-3)">
                <span style="display:flex; align-items:center; gap:5px"><span style="width:8px; height:8px; border-radius:50%; background:var(--brand)"></span>project hub</span>
                <span style="display:flex; align-items:center; gap:5px"><span style="width:14px; height:0; border-top:1.5px dashed var(--warn)"></span>shared across projects</span>
            </div>
        </div>
        <div style="padding:8px; background:var(--bg)">
            @if (_brain is null)
            {
                <div style="height:520px; display:flex; align-items:center; justify-content:center; color:var(--text-3); font-size:12.5px">Loading…</div>
            }
            else if (_brain.NodeCount == 0)
            {
                <div style="height:520px; display:flex; align-items:center; justify-content:center; color:var(--text-3); font-size:12.5px; text-align:center">
                    No projects yet. Add and graphify projects, then they'll join the brain here.
                </div>
            }
            else
            {
                <GraphCanvas Graph="_brain" Height="540" />
            }
        </div>
    </div>
</div>

@code {
    private GraphVizView? _brain;

    protected override async Task OnInitializedAsync()
    {
        Ui.Set("Brain", "organisation-wide dependency graph");
        _brain = await Svc.GetBrainAsync();
    }
}
