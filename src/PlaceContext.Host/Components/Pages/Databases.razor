@page "/project/{ProjectId:guid}/databases"
@attribute [Authorize(Policy = Permission.SettingsManage)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@inject DatabasesViewModel Vm

<PageTitle>PlaceContext — Databases</PageTitle>
<div class="resource-page databases-page">
    <nav class="resource-breadcrumb" aria-label="Breadcrumb"><span>Infrastructure</span><AppIcon Kind="chevron-right" /><span aria-current="page">Databases</span></nav>
    <header class="resource-head"><div><h2>Databases <span class="resource-count">(@Vm.Databases.Count)</span></h2><p>Manage persistent data stores for your services.</p></div><div class="resource-actions">
        <button class="dcbtn icon-button" disabled="@Vm.Busy" aria-label="Refresh databases" @onclick="Vm.RefreshAsync"><AppIcon Kind="refresh" /></button>
        @if (Vm.Selected is { } selectedDatabase) { <a class="dcbtn" href="/project/@ProjectId/databases/@selectedDatabase.Id"><AppIcon Kind="code" /> Query</a> }
        <button class="dcbtn" disabled="@(Vm.Busy || Vm.Selected is null)" @onclick="() => Vm.InspectAsync(Vm.Selected!)"><AppIcon Kind="logs" /> Logs</button>
        <button class="dcbtn" disabled="@(Vm.Busy || Vm.Selected is null)" @onclick='() => Vm.ControlAsync(Vm.Selected!, Vm.Selected!.Status is "running" or "restarting" ? "stop" : "start")'><AppIcon Kind="@(Vm.Selected?.Status is "running" or "restarting" ? "pause" : "play")" /> @(Vm.Selected?.Status is "running" or "restarting" ? "Stop" : "Start")</button>
        <button class="dcbtn" disabled="@(Vm.Busy || Vm.Selected?.Status != "running")" @onclick='() => Vm.ControlAsync(Vm.Selected!, "restart")'>Restart</button>
        <button class="dcbtn primary" disabled="@Vm.Busy" @onclick="Vm.NewDatabase"><AppIcon Kind="plus" /> Create database</button>
    </div></header>
    <nav class="dctabs resource-tabs" aria-label="Services sections">
        <a class="dctab " href="/project/@ProjectId/services">Apps</a>
        <a class="dctab active" href="/project/@ProjectId/databases">Databases</a>
        <a class="dctab" href="/project/@ProjectId/services?tab=activity">Activity</a>
    </nav>
    @if (Vm.Error is not null) { <p class="error" role="alert">@Vm.Error</p> }
    @if (Vm.Busy) { <p role="status">Updating databases… Image downloads may take a few minutes.</p> }
    @if (Vm.ShowEditor)
    {
        <div class="dcmodal-overlay"><section class="dcmodal resource-pane" role="dialog" aria-modal="true" aria-labelledby="database-editor-title"><form @onsubmit="Vm.CreateAsync" @onsubmit:preventDefault>
            <div class="dcmodal-head"><h3 id="database-editor-title">Create a database</h3><button type="button" class="dcslide-x" aria-label="Close database settings" disabled="@Vm.Busy" @onclick="Vm.CloseEditor"><AppIcon Kind="close" /></button></div><div class="dcmodal-body resource-pane-body"><div class="form-grid">
                <div class="dcfield"><label for="database-app">App</label><select id="database-app" class="dcinput" @bind="Vm.AppId" required disabled="@Vm.Busy"><option value="">Choose an app</option>@foreach (var app in Vm.Apps) { <option value="@app.Id">@app.Name</option> }</select><small>Required. Creating a database restarts this app to supply its private connection variables.</small></div>
                <div class="dcfield"><label for="database-name">Name</label><input id="database-name" class="dcinput" @bind="Vm.Name" required maxlength="80" disabled="@Vm.Busy" placeholder="Customer portal data" /></div>
                <div class="dcfield"><label for="database-engine">Data store</label><select id="database-engine" class="dcinput" @bind="Vm.Engine" disabled="@Vm.Busy"><option value="postgres">PostgreSQL 17</option><option value="redis">Redis 7</option></select></div>
                <div class="dcfield"><label for="database-memory">Memory (MiB)</label><input id="database-memory" class="dcinput" type="number" min="@(Vm.Engine == "postgres" ? 256 : 64)" max="8192" @bind="Vm.MemoryMb" required disabled="@Vm.Busy" /></div>
                <div class="dcfield"><label for="database-cpu">CPU cores</label><input id="database-cpu" class="dcinput" type="number" min="0.1" max="8" step="0.1" @bind="Vm.Cpus" required disabled="@Vm.Busy" /></div>
            </div><p class="note">A password is generated automatically. Each database has its own namespace and service account. Credentials are stored as Kubernetes Secrets. PostgreSQL uses the app database and user; Redis persists changes to disk. Backups are not configured automatically.</p>
            @if (Vm.Error is not null) { <p class="error" role="alert">@Vm.Error</p> }</div><div class="dcmodal-foot resource-actions"><button class="dcbtn primary" type="submit" disabled="@Vm.Busy">Create</button><button class="dcbtn" type="button" disabled="@Vm.Busy" @onclick="Vm.CloseEditor">Cancel</button></div>
        </form></section></div>
    }
    <section class="dccard resource-catalogue" aria-label="Configured databases">
        <div class="resource-toolbar">
            <label class="resource-search"><AppIcon Kind="data.search" /><input class="dcinput" aria-label="Find databases" placeholder="Find databases by name, host, or ID" @bind="Vm.Search" @bind:event="oninput" /></label>
            <select class="dcinput" aria-label="Filter database engine" @bind="Vm.EngineFilter"><option value="">All data stores</option><option value="postgres">PostgreSQL</option><option value="redis">Redis</option></select>
            <select class="dcinput" aria-label="Sort databases" @bind="Vm.Sort"><option value="created">Newest first</option><option value="name">Name: A–Z</option></select>
        </div>
        <div class="resource-table-scroll" tabindex="0" role="region" aria-label="Database list">
            <table class="resource-table"><thead><tr><th><span class="visually-hidden">Select</span></th><th>Name</th><th>Status</th><th>Data store</th><th>App</th><th>Private endpoint</th><th>Database / user</th><th>Created</th></tr></thead><tbody>
            @foreach (var database in Vm.VisibleDatabases)
            {
                <tr @key="database.Id" class="resource-row @(Vm.Selected?.Id == database.Id ? "selected" : "")">
                    <td><input type="radio" name="selected-database" aria-label="@($"Select {database.Name}")" checked="@(Vm.Selected?.Id == database.Id)" disabled="@Vm.Busy" @onchange="() => Vm.Select(database)" /></td>
                    <td class="resource-name"><a href="/project/@ProjectId/databases/@database.Id"><AppIcon Kind="data" /> @database.Name</a></td>
                    <td><span class="resource-status @(database.Status == "running" ? "running" : "paused")"><span class="status-dot"></span>@database.Status</span><small>Health: @(database.Health ?? "starting")</small></td>
                    <td class="nowrap">@(database.Engine == "postgres" ? "PostgreSQL 17" : "Redis 7")</td><td>@(Vm.Apps.FirstOrDefault(app => app.Id == database.ServiceId)?.Name ?? "Unassigned legacy store")</td><td class="resource-value"><code>@database.Host:@database.Port</code></td><td>@database.Database / @database.Username</td><td class="nowrap">@Vm.Presentation.DateTime(database.CreatedAt)</td>
                </tr>
            }
            </tbody></table>
        </div>
        @if (!Vm.Busy && Vm.Databases.Count == 0) { <div class="resource-empty"><AppIcon Kind="data" /><h3>No databases</h3><p>Create PostgreSQL for application records or Redis for caching and queues.</p><button class="dcbtn primary" @onclick="Vm.NewDatabase">Create your first database</button></div> }
        else if (Vm.Databases.Count > 0 && Vm.VisibleDatabases.Count == 0) { <div class="resource-empty"><h3>No matching databases</h3><p>Try another name or change the data store filter.</p></div> }
        <footer class="resource-table-footer">@Vm.VisibleDatabases.Count of @Vm.Databases.Count databases <span>Select a row for actions. Data remains when an app or database stops.</span></footer>
    </section>
    <p class="note">Select a database when launching a <a href="/project/@ProjectId/services">Service</a> to connect it privately and supply its connection variables automatically.</p>
    @if (Vm.Inspecting is { } inspecting)
    {
        <section class="dccard resource-detail logs-panel"><header><h3>@inspecting.Name · Logs</h3><div class="resource-actions"><button class="dcbtn" disabled="@Vm.Busy" @onclick="() => Vm.InspectAsync(inspecting)">Refresh logs</button><button class="dcbtn" disabled="@Vm.Busy" @onclick="Vm.CloseLogs">Close</button></div></header><ContainerLogs Text="@Vm.Logs" /></section>
    }
</div>
@code {
    [Parameter] public Guid ProjectId { get; set; }
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override Task OnParametersSetAsync() => Vm.LoadAsync(ProjectId);
    public void Dispose() => Vm.DisposePage();
}
