@using PlaceContext.Application.Access.Models
@page "/project/{ProjectId:guid}/build/workflows"
@attribute [Authorize(Policy = Permission.ChainsManage)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@inject NavigationManager Navigation

<PageTitle>PlaceContext — Workflows</PageTitle>
<section role="status" class="dccard" style="padding:24px">
    <h1>Workflows have moved</h1>
    <p>Build, run and manage workflows in one place. The separate workflow catalogue has been retired.</p>
    <a class="dcbtn primary" href="/project/@ProjectId/workflows">Open workflows <AppIcon Kind="arrow-right" /></a>
</section>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            Navigation.NavigateTo($"/project/{ProjectId}/workflows", replace: true);
    }
}
