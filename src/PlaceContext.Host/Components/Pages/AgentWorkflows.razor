@page "/project/{ProjectId:guid}/build/workflows"
@attribute [Authorize(Policy = Permission.ChainsManage)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@using PlaceContext.Application.AgentWorkflows
@inject AgentWorkflowsViewModel Vm
@implements IDisposable

<PageTitle>PlaceContext — Agent Store</PageTitle>
<div class="agent-store product-workspace" aria-busy="@(Vm.Busy ? "true" : "false")">
    <header class="store-header">
        <div class="store-header-start">
            <span class="workspace-symbol"><AppIcon Kind="agent" /></span>
            <div class="store-breadcrumb"><a href="@Vm.BuildUrl">Build</a><AppIcon Kind="chevron-right" /><h1>Agent Store</h1></div>
        </div>
        <div class="store-header-actions">
            <a class="dui-btn dui-btn-ghost dui-btn-sm profiles-link" href="@Vm.DashboardsUrl" aria-label="Data profiles"><AppIcon Kind="data.analytics" /><span>Data profiles</span></a>
            <a class="dui-btn dui-btn-primary dui-btn-sm new-agent" href="@Vm.BuildUrl"><AppIcon Kind="plus" /><span>Build an agent</span></a>
        </div>
    </header>

    <div class="store-navigation">
      <nav class="dui-tabs dui-tabs-box dui-tabs-sm store-tabs" aria-label="Agent Store views">
        <button class="dui-tab @(!Vm.ShowHistory ? "dui-tab-active" : "")" aria-pressed="@(!Vm.ShowHistory ? "true" : "false")" disabled="@Vm.Busy" @onclick="() => ShowHistory(false)"><AppIcon Kind="grid" /> Browse agents <span class="dui-badge dui-badge-sm dui-badge-soft">@Vm.UseCaseCount</span></button>
        <button @ref="_historyTab" class="dui-tab @(Vm.ShowHistory ? "dui-tab-active" : "")" aria-pressed="@(Vm.ShowHistory ? "true" : "false")" disabled="@Vm.Busy" @onclick="() => ShowHistory(true)"><AppIcon Kind="history" /> Run history @if (Vm.Workspace is { Runs.Count: > 0 } history) { <span class="dui-badge dui-badge-sm dui-badge-soft">@history.Runs.Count</span> }</button>
      </nav>
        <span class="store-tabs-note"><AppIcon Kind="data" /> Uses your project context</span>
    </div>

    <div class="store-content">
        @if (Vm.Error is not null) { <p class="store-error" role="alert"><AppIcon Kind="warning" /> @Vm.Error</p> }
        @if (Vm.Workspace is { } workspace)
        {
            <div class="store-heading">
                <div><h2>@(Vm.ShowHistory ? "Agent activity" : "Agent catalogue")</h2><p>@(Vm.ShowHistory ? "Review the latest 50 runs and their results." : "Choose an outcome and review the project data it can use.")</p></div>
            </div>

            <div class="catalogue-layout @(Vm.Selected is null ? "" : "has-selection")">
                <section class="catalogue-panel @(Vm.ShowHistory ? "dui-card dui-card-border history-panel" : "")" aria-label="@(Vm.ShowHistory ? "Run history" : "Agent catalogue")">
                    @if (Vm.ShowHistory)
                    {
                        <div class="catalogue-panel-heading"><h3>Recent runs <span>@workspace.Runs.Count</span></h3><button class="dui-btn dui-btn-ghost dui-btn-sm" disabled="@Vm.Busy" @onclick="Vm.RefreshAsync"><AppIcon Kind="refresh" /> Refresh</button></div>
                        @if (workspace.Runs.Count == 0)
                        {
                            <div class="store-empty"><span class="empty-symbol"><AppIcon Kind="history" /></span><h3>Your agent activity will appear here</h3><p>Choose an agent and review its project context to get started.</p><button class="dui-btn dui-btn-outline dui-btn-sm" disabled="@Vm.Busy" @onclick="() => ShowHistory(false)">Browse agents <AppIcon Kind="arrow-right" /></button></div>
                        }
                        @foreach (var run in workspace.Runs)
                        {
                            <article class="history-row" @key="run.Id">
                                <span class="row-symbol"><AppIcon Kind="history" /></span>
                                <div class="history-copy"><strong>@Vm.WorkflowName(run.AgentId)</strong><small>@AgentWorkflowsViewModel.StartedLabel(run)</small></div>
                                <span class="dui-badge dui-badge-soft dui-badge-sm run-status">@AgentWorkflowsViewModel.StatusLabel(run)</span>
                                <button class="dui-btn dui-btn-ghost dui-btn-sm" disabled="@Vm.Busy" @onclick="() => OpenResult(run)">View <AppIcon Kind="chevron-right" /></button>
                            </article>
                        }
                    }
                    else
                    {
                        <div class="catalogue-controls">
                            <label class="dui-input store-search"><AppIcon Kind="data.search" /><span class="visually-hidden">Find an agent by outcome or data source</span><input @ref="_search" placeholder="Search agents, teams or data…" @bind="Vm.Search" @bind:event="oninput" disabled="@Vm.Busy" /></label>
                            <label class="availability-select"><span class="visually-hidden">Agent availability</span><select class="dui-select" value="@Vm.Filter" disabled="@Vm.Busy" @onchange="SetAvailability"><option value="@AgentBrowseFilter.All">All agents</option><option value="@AgentBrowseFilter.Free">Local checks</option>@if (workspace.SimulationEnabled) { <option value="@AgentBrowseFilter.Subscribed">Enabled agents</option> }</select></label>
                            <div class="dui-join display-toggle" aria-label="Catalogue layout">
                                <button class="dui-btn dui-btn-sm dui-join-item @(!_listView ? "dui-btn-primary dui-btn-soft" : "dui-btn-ghost")" aria-label="Grid view" aria-pressed="@(!_listView ? "true" : "false")" disabled="@Vm.Busy" @onclick="() => _listView = false"><AppIcon Kind="grid" /> Grid</button>
                                <button class="dui-btn dui-btn-sm dui-join-item @(_listView ? "dui-btn-primary dui-btn-soft" : "dui-btn-ghost")" aria-label="List view" aria-pressed="@(_listView ? "true" : "false")" disabled="@Vm.Busy" @onclick="() => _listView = true"><AppIcon Kind="logs" /> List</button>
                            </div>
                        </div>
                        <nav class="category-filters" aria-label="Agent categories">
                            <button class="dui-btn dui-btn-sm @(Vm.Industry.Length == 0 ? "dui-btn-primary dui-btn-soft" : "dui-btn-ghost")" aria-pressed="@(Vm.Industry.Length == 0 ? "true" : "false")" disabled="@Vm.Busy" @onclick='() => Vm.Industry = ""'>All teams <span>@Vm.UseCaseCount</span></button>
                            @foreach (var industry in Vm.Industries)
                            {
                                <button class="dui-btn dui-btn-sm @(Vm.Industry == industry ? "dui-btn-primary dui-btn-soft" : "dui-btn-ghost")" aria-pressed="@(Vm.Industry == industry ? "true" : "false")" disabled="@Vm.Busy" @onclick="() => Vm.Industry = industry">@IndustryLabel(industry)<span>@workspace.Workflows.Where(x => x.Industry == industry).Select(x => x.UseCaseId).Distinct().Count()</span></button>
                            }
                        </nav>
                        <div class="agent-list @(_listView ? "list-view" : "grid-view")">
                            @foreach (var useCase in Vm.VisibleUseCases)
                            {
                                var agent = useCase.Summary;
                                <article class="dui-card dui-card-border agent-card agent-row @(Vm.Selected?.UseCaseId == useCase.Id ? "selected" : "")" @key="useCase.Id">
                                    <div class="dui-card-body">
                                        <div class="agent-card-top"><span class="row-symbol @IndustryTone(agent.Industry)"><AppIcon Kind="@AgentIcon(agent)" /></span><span class="dui-badge dui-badge-soft dui-badge-sm agent-category">@IndustryLabel(agent.Industry)</span></div>
                                        <div class="agent-card-copy"><h3 class="dui-card-title">@useCase.Name</h3><p class="agent-outcome">@agent.Outcome</p><span class="agent-list-team">@IndustryLabel(agent.Industry)</span></div>
                                        <div class="agent-card-context"><AppIcon Kind="data" /><span>@agent.DataSources.FirstOrDefault()</span></div>
                                        <div class="dui-card-actions agent-card-actions"><span class="agent-source-count" title="@string.Join(", ", agent.DataSources)">@agent.DataSources.Count suggested source types</span><button class="dui-btn dui-btn-sm @(Vm.Selected?.UseCaseId == useCase.Id ? "dui-btn-primary" : "dui-btn-soft")" disabled="@Vm.Busy" aria-label="Use @useCase.Name" aria-pressed="@(Vm.Selected?.UseCaseId == useCase.Id ? "true" : "false")" @onclick="() => OpenAgentAsync(agent)">@(Vm.Selected?.UseCaseId == useCase.Id ? "Selected" : "Use agent")<AppIcon Kind="@(Vm.Selected?.UseCaseId == useCase.Id ? "check" : "arrow-right")" /></button></div>
                                    </div>
                                </article>
                            }
                            @if (!Vm.VisibleUseCases.Any())
                            {
                                <div class="store-empty"><span class="empty-symbol"><AppIcon Kind="data.search" /></span><h3>No agents match these filters</h3><p>Try another outcome, team or data source.</p><button class="dui-btn dui-btn-outline dui-btn-sm" @onclick="Vm.ClearFilters">Clear filters</button></div>
                            }
                        </div>
                        <footer class="catalogue-footer"><span>@Vm.VisibleUseCases.Count() of @Vm.UseCaseCount agents</span><span><AppIcon Kind="check" /> Context checks use no AI tokens</span></footer>
                    }
                </section>

                @if (Vm.Selected is { } selected)
                {
                    var summary = Vm.SelectedVariants.FirstOrDefault(x => x.Paid) ?? selected;
                    <aside class="dui-card dui-card-border agent-detail" aria-labelledby="agent-detail-title" @key="selected.Id">
                        <div class="inspector-toolbar"><span>AGENT WORKSPACE</span><button class="dui-btn dui-btn-ghost dui-btn-sm store-icon-button" aria-label="Close agent details" title="Close agent details" disabled="@Vm.Busy" @onclick="CloseDetailsAsync"><AppIcon Kind="close" /></button></div>
                        <div class="inspector-heading">
                            <span class="detail-symbol @IndustryTone(selected.Industry)"><AppIcon Kind="@AgentIcon(selected)" /></span>
                            <span class="dui-badge dui-badge-soft dui-badge-sm detail-category">@IndustryLabel(selected.Industry)</span>
                            <h2 id="agent-detail-title" tabindex="-1" @ref="_detailHeading">@selected.UseCaseName</h2>
                            <p>@summary.Description</p>
                        </div>
                        <div class="dui-tabs dui-tabs-box dui-tabs-sm agent-variants" aria-label="Agent mode">
                            @foreach (var variant in Vm.SelectedVariants)
                            {
                                <button class="dui-tab @(selected.Id == variant.Id ? "dui-tab-active" : "")" disabled="@Vm.Busy" aria-pressed="@(selected.Id == variant.Id ? "true" : "false")" @onclick="() => SelectVariantAsync(variant)"><AppIcon Kind="@(variant.Paid ? "agent" : "check")" />@(variant.Paid ? "AI plan" : "Context check")</button>
                            }
                        </div>

                        @if (Vm.Result is { } result)
                        {
                            <section class="detail-result" aria-live="polite"><div class="section-heading"><h3>Run result</h3><span class="dui-badge dui-badge-soft dui-badge-sm state-badge">@AgentWorkflowsViewModel.StatusLabel(result)</span></div><small>@AgentWorkflowsViewModel.StartedLabel(result)</small>
                                @if (Vm.ReadinessResult is { } readiness) { <p>@readiness.Summary</p>@if (readiness.MissingFields.Count > 0) { <p><strong>Missing:</strong> @string.Join(", ", readiness.MissingFields)</p> } }
                                else if (result.Output is not null) { <pre>@result.Output</pre> }
                                @if (!string.IsNullOrWhiteSpace(result.Notice)) { <p>@result.Notice</p> }
                                @if (selected.Paid) { <small>@AgentWorkflowsViewModel.TokenLabel(result) · @AgentWorkflowsViewModel.CreditLabel(result)</small> }
                            </section>
                        }

                        <section class="project-context" aria-labelledby="agent-project-context">
                            <div class="section-heading"><h3 id="agent-project-context">Project context</h3><span class="dui-badge dui-badge-soft dui-badge-sm state-badge @(Vm.ProjectContextApplied ? "dui-badge-success" : "")">@(Vm.PreparingContext ? "Finding sources" : Vm.ProjectContextApplied ? "Selected" : Vm.HasPreparedContext ? "Review needed" : "Not connected")</span></div>
                            @if (Vm.PreparingContext)
                            {
                                <p class="context-note" role="status">Checking accessible project sources…</p><div class="context-skeleton dcskel"></div>
                            }
                            else if (Vm.Preparation is { } preparation)
                            {
                                @if (preparation.Sources.Count > 0)
                                {
                                    <div class="context-sources">
                                        @foreach (var source in preparation.Sources)
                                        {
                                            <details class="source-row"><summary><span class="source-icon"><AppIcon Kind="data" /></span><span class="source-copy"><strong>@source.Name</strong><small>@source.Kind · sampled</small></span><AppIcon Kind="chevron-down" /></summary><p>@source.Summary</p><small>@AgentWorkflowsViewModel.ContextTimestamp(source)</small></details>
                                        }
                                    </div>
                                }
                                @if (Vm.HasPreparedContext)
                                {
                                    <p class="sample-notice"><AppIcon Kind="about" /> Bounded samples. Freshness and full coverage are unverified.</p>
                                    @if (!Vm.ProjectContextApplied)
                                    {
                                        <button class="dui-btn dui-btn-sm @(selected.Paid && !Vm.CanRunAiPlan ? "dui-btn-outline" : "dui-btn-primary") context-primary" disabled="@Vm.Busy" @onclick="Vm.UseProjectContext"><AppIcon Kind="check" /> Use project data</button><p class="action-hint">Review the sources, then select them. The agent runs separately.</p>
                                    }
                                }
                                else
                                {
                                    <div class="context-empty"><span class="source-icon"><AppIcon Kind="data" /></span><div><strong>Find the right source with Build</strong><p>No matching context is ready to use in this project.</p></div></div>
                                }
                                <details class="context-review"><summary>Review prepared context <AppIcon Kind="chevron-down" /></summary><p>@preparation.Notice</p>
                                    @if (Vm.HasPreparedContext) { <dl class="context-preview">@foreach (var entry in preparation.Inputs.Where(x => !string.IsNullOrWhiteSpace(x.Value))) { <div><dt>@AgentWorkflowsViewModel.FieldLabel(entry.Key)</dt><dd>@entry.Value</dd></div> }</dl> }
                                </details>
                            }
                            else
                            {
                                <button class="dui-btn dui-btn-outline dui-btn-sm" disabled="@Vm.Busy" @onclick="Vm.PrepareContextAsync"><AppIcon Kind="data.search" /> Find project data</button>
                            }

                            @if (Vm.ProjectContextApplied && Vm.MissingContextFields.Count > 0)
                            {
                                <p class="required-context"><AppIcon Kind="warning" /><span><strong>Still needed:</strong> @string.Join(", ", Vm.MissingContextFields.Select(AgentWorkflowsViewModel.FieldLabel))</span></p>
                            }
                            @if ((!Vm.HasContext && !Vm.HasPreparedContext) || (selected.Paid && !Vm.CanRunAiPlan))
                            {
                                <a class="dui-btn dui-btn-primary dui-btn-sm context-primary" href="@Vm.BuildAgentUrl"><AppIcon Kind="agent" /> Set up this agent in Build <AppIcon Kind="arrow-right" /></a>
                                <p class="action-hint">Opens an editable setup request.</p>
                            }
                            else if (Vm.HasContext)
                            {
                                <button class="dui-btn dui-btn-primary dui-btn-sm context-primary" disabled="@(!Vm.CanStart)" @onclick="Vm.RunAsync"><AppIcon Kind="play" /> @(Vm.Busy && !Vm.PreparingContext ? "Running…" : selected.Paid ? "Run AI plan" : "Check context readiness")</button>
                                <a class="dui-btn dui-btn-outline dui-btn-sm build-continuation" href="@Vm.BuildAgentUrl">Continue in Build <AppIcon Kind="arrow-right" /></a>
                            }
                            else if (Vm.HasPreparedContext)
                            {
                                <a class="dui-btn dui-btn-outline dui-btn-sm build-continuation" href="@Vm.BuildAgentUrl">Continue in Build <AppIcon Kind="arrow-right" /></a>
                            }
                            @if (selected.Paid && Vm.MissingContextFields.Count > 0 && Vm.HasContext) { <p class="context-note">Add @string.Join(", ", Vm.MissingContextFields.Select(AgentWorkflowsViewModel.FieldLabel)) before running an AI plan.</p> }

                            <details class="context-editor"><summary><span><AppIcon Kind="edit" /> @(Vm.ProjectContextApplied && Vm.MissingContextFields.Count > 0 ? "Add missing context" : "Add or edit context")</span><AppIcon Kind="chevron-down" /></summary>
                                <p class="context-note">Provide only what is missing or needs correcting. Keep credentials in the vault.</p>
                                @foreach (var field in selected.InputFields)
                                {
                                    <label for="@($"agent-input-{field}")">@AgentWorkflowsViewModel.FieldLabel(field) @if (!selected.RequiredInputFields.Contains(field)) { <span>Optional</span> }</label>
                                    <textarea class="dui-textarea" id="@($"agent-input-{field}")" rows="3" maxlength="5000" value="@Vm.Inputs[field]" @oninput="e => Vm.SetInput(field, e.Value?.ToString())" disabled="@Vm.Busy" aria-describedby="@($"agent-hint-{field}")"></textarea>
                                    <small id="@($"agent-hint-{field}")" class="input-hint">@(selected.InputHints.TryGetValue(field, out var hint) ? hint : "Add context relevant to this outcome.")</small>
                                }
                            </details>
                        </section>

                        <div class="agent-notes">
                            <details class="detail-disclosure"><summary>What you’ll get <AppIcon Kind="chevron-down" /></summary><ul>@foreach (var deliverable in selected.Deliverables) { <li>@deliverable</li> }</ul><p>@selected.ExecutionScope</p></details>
                            <details class="detail-disclosure"><summary>How this agent works <AppIcon Kind="chevron-down" /></summary><ol>@foreach (var step in selected.Steps) { <li>@step</li> }</ol></details>
                            @if (selected.Paid)
                            {
                                <details class="detail-disclosure access-note" open="@(!Vm.CanRunAiPlan)"><summary>AI plan access <span class="access-label">@(Vm.CanRunAiPlan ? "Simulation enabled" : "Set up in Build")</span><AppIcon Kind="chevron-down" /></summary>
                                    @if (workspace.SimulationEnabled)
                                    {
                                        <p>Local subscription simulation: @AgentWorkflowsViewModel.PriceLabel(selected) @AgentWorkflowsViewModel.PriceUnit(selected). No payments collected. Provider charges may apply; Jev usage is excluded from demo credits.</p>
                                        @if (Vm.CanManageSubscriptions) { <button class="dui-btn dui-btn-outline dui-btn-sm" disabled="@Vm.Busy" @onclick="() => Vm.ToggleSubscriptionAsync(selected)">@(Vm.Subscribed(selected.Id) ? "Disable simulated access" : "Enable simulated access")</button> }
                                        else if (!Vm.Subscribed(selected.Id)) { <p>An administrator can enable simulated access on this host.</p> }
                                    }
                                    else { <p>Standalone AI plans are not enabled on this host. Continue in Build to configure a project workflow.</p> }
                                </details>
                            }
                        </div>
                        <footer class="inspector-footer"><AppIcon Kind="about" /><span>@(selected.Paid ? "AI plans propose actions for review." : "Checks confirm input presence, not source accuracy.")</span></footer>
                    </aside>
                }
            </div>
        }
        else if (Vm.Busy) { <Skeleton Kind="cards" Rows="3" /> }
        else { <button class="dui-btn dui-btn-outline dui-btn-sm" @onclick="Vm.RefreshAsync"><AppIcon Kind="refresh" /> Reload Agent Store</button> }
    </div>
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    private ElementReference _search;
    private ElementReference _historyTab;
    private ElementReference _detailHeading;
    private string? _focusedAgent;
    private bool _focusRequested;
    private bool _listView;
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override Task OnParametersSetAsync() => Vm.LoadAsync(ProjectId);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusRequested && _focusedAgent == Vm.Selected?.Id) return;
        _focusRequested = false;
        _focusedAgent = Vm.Selected?.Id;
        if (_focusedAgent is not null) await _detailHeading.FocusAsync();
    }
    private void ShowHistory(bool show) { if (!Vm.Busy && Vm.ShowHistory != show) Vm.ToggleHistory(); }
    private void SetAvailability(ChangeEventArgs args)
    {
        if (!Vm.Busy && Enum.TryParse<AgentBrowseFilter>(args.Value?.ToString(), out var filter)) Vm.Browse(filter);
    }
    private Task OpenAgentAsync(AgentWorkflow agent) { _focusRequested = true; return Vm.SelectUseCaseAsync(agent); }
    private Task SelectVariantAsync(AgentWorkflow agent) { _focusRequested = true; return Vm.SelectAsync(agent); }
    private void OpenResult(AgentRun run) { _focusRequested = true; Vm.OpenResult(run); }
    private async Task CloseDetailsAsync()
    {
        Vm.CloseDetails();
        if (Vm.Selected is null) await (Vm.ShowHistory ? _historyTab : _search).FocusAsync();
    }
    private static string IndustryLabel(string industry) => industry == "Enterprise communications" ? "Phone systems" : industry;
    private static string IndustryTone(string industry) => industry switch { "Enterprise communications" => "tone-cyan", "Service operations" => "tone-violet", "Retail" => "tone-amber", "Professional services" => "tone-violet", "Property operations" => "tone-green", _ => "" };
    private static string AgentIcon(AgentWorkflow agent) => agent.UseCaseId switch { "call-abandonment" => "queue", "phone-inventory" => "data.entities", "call-routing" => "branch", "call-quality" => "pulse", "telephony-cost" => "ledger", _ => AgentWorkflowsViewModel.IndustryIcon(agent) };
    public void Dispose() => Vm.Dispose();
}
