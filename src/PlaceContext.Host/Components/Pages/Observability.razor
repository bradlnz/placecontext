@page "/observability"
@attribute [Authorize(Policy = Permission.JobsView)]
@implements IDisposable
@inject ObservabilityViewModel Vm





<PageTitle>PlaceContext — Observability</PageTitle>

@if (Vm.Loading)
{
    <Skeleton Kind="list" Rows="6" Padded />
}



else
{
    <div class="page">

        <div class="page-head">
            <div>
                <h2 class="page-title">Observability</h2>
                <div class="page-sub">
                    What ran, where, and how it went — across every project in the workspace.
                </div>
            </div>
            <button class="dcbtn" @onclick="Vm.RefreshAsync">Refresh</button>
        </div>

        @* Global tab strip — more lenses (events, triggers, costs) slot in here. *@
        <div class="dctabs tabs-strip">
            <button class="dctab @(Vm.IsRunsTab ? "active" : "")" @onclick="Vm.SelectRunsTab">Job history<span class="n">@(Vm.Reports?.Count ?? 0)</span></button>
            <button class="dctab @(Vm.IsChainsTab ? "active" : "")" @onclick="Vm.SelectChainsTab">Chains<span class="n">@(Vm.ChainReports?.Count ?? 0)</span></button>
            <button class="dctab @(Vm.IsTracesTab ? "active" : "")" @onclick="Vm.LoadTracesAsync">Live traces<span class="n">@(Vm.LiveTraces?.Count ?? 0)</span></button>
        </div>

        @if (Vm.Message is not null)
        {
            <div class="message-banner">@Vm.Message</div>
        }

        @if (Vm.ActiveRunCount > 0)
        {
            <section class="summary-strip" aria-label="Run summary">
                <div class="summary-count"><strong>@Vm.ActiveRunCount</strong><span>runs</span></div>
                <div class="summary-count running"><strong>@Vm.ActiveStatusCount(JobRunStatus.Running)</strong><span>running</span></div>
                <div class="summary-count succeeded"><strong>@Vm.ActiveStatusCount(JobRunStatus.Succeeded)</strong><span>succeeded</span></div>
                <div class="summary-count failed"><strong>@Vm.ActiveStatusCount(JobRunStatus.Failed)</strong><span>failed</span></div>
                <div class="summary-progress" title="@Vm.ActiveSuccessPercent% succeeded">
                    <span style="width:@Vm.ActiveSuccessPercent%"></span>
                </div>
            </section>
        }

        @if (Vm.IsRunsTab)
        {
            @if (Vm.Reports is null or { Count: 0 })
            {
                <div class="dccard empty-card">
                    No job runs recorded yet — run a job from any project's Jobs tab and it appears here.
                </div>
            }
            else
            {
                <section class="dccard run-suite">
                    <header class="suite-head">
                        <div><span class="suite-caret">⌄</span><strong>Job run catalogue</strong><span>@Vm.Reports.Count across the workspace</span></div>
                        <span class="suite-result">@Vm.ActiveStatusCount(JobRunStatus.Succeeded) succeeded</span>
                    </header>
                    <div class="run-list">
                        @foreach (var rep in Vm.Reports)
                        {
                            var run = rep.Run;
                            <article class="run-row" @onclick="@(() => Vm.OpenRun(rep))">
                                <div class="run-row-inner">
                                    <span class="status-pill" style="color:@Vm.Presentation.StatusColor(run.Status); background:@Vm.Presentation.StatusBackground(run.Status)">@run.Status</span>
                                    <div class="flex-fill">
                                        <span class="job-name">@rep.JobName</span>
                                        <span class="project-name">@rep.ProjectName</span>
                                    </div>
                                    <span class="note-sm">
                                        ✓ @Vm.SucceededShardCount(run)@Vm.FailedShardSummary(run)
                                    </span>
                                    <span class="run-time">
                                        @Vm.Presentation.DateTime(run.StartedAt)
                                    </span>
                                    @if (run.FinishedAt.HasValue)
                                    {
                                        <span class="run-duration">
                                            @Vm.Presentation.Duration(run.StartedAt, run.FinishedAt.Value)
                                        </span>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        }

        @if (Vm.IsChainsTab)
        {
            @if (Vm.ChainReports is null or { Count: 0 })
            {
                <div class="dccard empty-card">
                    No chain runs recorded yet — run a job chain from any project's Chains tab and it appears here.
                </div>
            }
            else
            {
                <section class="dccard run-suite">
                    <header class="suite-head">
                        <div><span class="suite-caret">⌄</span><strong>Chain run catalogue</strong><span>@Vm.ChainReports.Count across the workspace</span></div>
                        <span class="suite-result">@Vm.ActiveStatusCount(JobRunStatus.Succeeded) succeeded</span>
                    </header>
                    <div class="run-list">
                        @foreach (var rep in Vm.ChainReports)
                        {
                            var run = rep.Run;
                            <article class="run-row" @onclick="@(() => Vm.OpenChainRun(rep))">
                                <div class="run-row-inner">
                                    <span class="status-pill" style="color:@Vm.Presentation.StatusColor(run.Status); background:@Vm.Presentation.StatusBackground(run.Status)">@run.Status</span>
                                    <div class="flex-fill">
                                        <span class="job-name">@run.ChainName</span>
                                        <span class="project-name">@rep.ProjectName</span>
                                    </div>
                                    <span class="note-sm">
                                        @Vm.SucceededStepCount(run)/@run.Steps.Count step(s)
                                    </span>
                                    <span class="run-time">
                                        @Vm.Presentation.DateTime(run.StartedAt)
                                    </span>
                                    @if (run.FinishedAt.HasValue)
                                    {
                                        <span class="run-duration">
                                            @Vm.Presentation.Duration(run.StartedAt, run.FinishedAt.Value)
                                        </span>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        }

        @if (Vm.IsTracesTab)
        {
            <div class="page-sub" style="margin-bottom:12px">
                In-process OpenTelemetry spans from this Host replica (job.run → job.shard). Full span trees for runs executed here.
            </div>
            @if (Vm.LiveTraces is null or { Count: 0 })
            {
                <div class="dccard empty-card">
                    No live traces on this replica yet — run a job and refresh.
                </div>
            }
            else
            {
                <section class="dccard run-suite">
                    <header class="suite-head">
                        <div><span class="suite-caret">⌄</span><strong>Live trace catalogue</strong><span>@Vm.LiveTraces.Count on this replica</span></div>
                        <span class="suite-result">@Vm.ActiveStatusCount(JobRunStatus.Succeeded) succeeded</span>
                    </header>
                    <div class="run-list">
                        @foreach (var t in Vm.LiveTraces)
                        {
                            <article class="run-row" @onclick="@(() => Vm.OpenLiveTrace(t))">
                                <div class="run-row-inner">
                                    <span class="status-pill" style="color:@Vm.Presentation.StatusColor(t.Status); background:@Vm.Presentation.StatusBackground(t.Status)">@Vm.Presentation.StatusLabel(t.Status)</span>
                                    <div class="flex-fill">
                                        <span class="job-name">@(t.JobName ?? Vm.Presentation.AbbreviatedId(t.JobId))</span>
                                        <span class="project-name">trace @Vm.TraceLabel(t)…</span>
                                    </div>
                                    <span class="note-sm">@t.Shards.Count shard(s)</span>
                                    <span class="run-duration">@Vm.Presentation.Milliseconds(t.DurationMs)</span>
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        }
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "run")] public string? RunId { get; set; }
    [SupplyParameterFromQuery(Name = "chainRun")] public string? ChainRunId { get; set; }
    private string? _chainContextJson;
    private string? _chainContextJsonPath;

    protected override async Task OnInitializedAsync()
    {
        Vm.Attach(() => InvokeAsync(StateHasChanged));
        Vm.RunId = RunId;
        Vm.ChainRunId = ChainRunId;
        await Vm.InitializeAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        Vm.RunId = RunId;
        Vm.ChainRunId = ChainRunId;
        await Vm.ApplyDeepLinkAsync();
    }

    public void Dispose() => Vm.Dispose();

    private bool IsJsonLike(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return false;

        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(value);
            return document.RootElement.ValueKind is System.Text.Json.JsonValueKind.Object
                or System.Text.Json.JsonValueKind.Array;
        }
        catch
        {
            return false;
        }
    }

    private static string GetJsonPreview(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "(empty)";

        var trimmed = value.Trim();
        const int max = 90;
        return trimmed.Length <= max ? trimmed : trimmed[..max] + "…";
    }

    private static string FormatJson(string raw)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(raw);
            return System.Text.Json.JsonSerializer.Serialize(document.RootElement, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true
            });
        }
        catch
        {
            return raw;
        }
    }

    private void OpenChainContextJson(string path, string value)
    {
        _chainContextJson = FormatJson(value);
        _chainContextJsonPath = path;
    }

    private void CloseChainContextJson()
    {
        _chainContextJson = null;
        _chainContextJsonPath = null;
    }
}

@* ── Chain run detail slide-out: the fan-out/fan-in pipeline — a fan-out stage stacks its branches
   in one column, and the join is simply the next column. Clicking a step deep-links into the run
   detail slide-out below (same query-param convention the notification bell already uses). ────── *@
@if (Vm.OpenChain is not null)
{
    var chainRun = Vm.OpenChain.Run;
    <div class="dcslide-scrim" @onclick="Vm.CloseChainRun"></div>
    <div class="dcslide slide-wide">
        <div class="dcslide-head">
            <div class="flex-fill">
                <div class="slide-title">@chainRun.ChainName</div>
                <div class="slide-sub">
                    @Vm.OpenChain.ProjectName · chain run @Vm.Presentation.AbbreviatedId(chainRun.Id)
                    · @Vm.Presentation.DateTime(chainRun.StartedAt)
                </div>
            </div>
            <button class="dcbtn btn-open-project"
                    @onclick="@(() => Vm.OpenProject(Vm.OpenChain.ProjectId, "chains"))">Open project →</button>
            <button class="dcslide-x" @onclick="Vm.CloseChainRun">×</button>
        </div>
        <div class="dcslide-body slide-body-scroll">
            <div class="status-line">
                <span class="status-pill-lg" style="color:@Vm.Presentation.StatusColor(chainRun.Status); background:@Vm.Presentation.StatusBackground(chainRun.Status)">@chainRun.Status</span>
                <span class="note-sm">
                    @Vm.ChainRunStepSummary(chainRun)@Vm.ChainRunDuration(chainRun)
                </span>
            </div>

            <ChainPipeline Run="chainRun" OnStepClick="Vm.OpenChainStep" />

            @if (Vm.OpenChainContextRows.Count > 0)
            {
                <div class="dccard chain-context-panel">
                    <div class="out-label">Accumulated chain context</div>
                    <div class="chain-context-scroll">
                        <table class="chain-context-table">
                            <thead>
                                <tr>
                                    <th class="chain-context-cell chain-context-path">Field</th>
                                    <th class="chain-context-cell">Value</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Vm.OpenChainContextRows)
                                {
                                    <tr>
                                        <td class="chain-context-cell chain-context-path"><code>@row.Path</code></td>
                                        <td class="chain-context-cell">
                                            @if (IsJsonLike(row.Value))
                                            {
                                                <button class="dcbtn btn-2-8 json-view-button"
                                                        @onclick="(() => OpenChainContextJson(row.Path, row.Value))">
                                                    View JSON
                                                </button>
                                                <span class="chain-context-preview">@GetJsonPreview(row.Value)</span>
                                            }
                                            else
                                            {
                                                <code class="chain-context-value">@row.Value</code>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (chainRun.FinalOutput is { Length: > 0 })
            {
                <div class="dccard panel-card">
                    <div class="panel-title">Pipeline output</div>
                    <pre class="shard-json">@Vm.Presentation.Json(chainRun.FinalOutput)</pre>
                </div>
            }
        </div>
    </div>
}

@if (_chainContextJson is not null)
{
    <div class="dcmodal-overlay" @onclick="CloseChainContextJson">
        <div class="dcmodal chain-json-modal" @onclick:stopPropagation="true">
            <div class="dcmodal-head">
                <div>
                    <div class="title-14">Chain context JSON</div>
                    <div class="sub-115">Path: <code>@_chainContextJsonPath</code></div>
                </div>
                <button class="dcslide-x" @onclick="CloseChainContextJson">×</button>
            </div>
            <div class="dcmodal-body chain-json-body">
                <pre class="json-pre">@_chainContextJson</pre>
            </div>
        </div>
    </div>
}

@* ── Run detail slide-out: the full picture — shards, artifacts, charts, logs ─────────────── *@
@if (Vm.Open is not null)
{
    var run = Vm.Open.Run;
    <div class="dcslide-scrim" @onclick="Vm.CloseRun"></div>
    <div class="dcslide slide-wide">
        <div class="dcslide-head">
            <div class="flex-fill">
                <div class="slide-title">@Vm.Open.JobName</div>
                <div class="slide-sub">
                    @Vm.Open.ProjectName · run @Vm.Presentation.AbbreviatedId(run.Id) · @Vm.Presentation.DateTime(run.StartedAt)
                </div>
            </div>
            <button class="dcbtn btn-replay" title="Re-run this run's exact captured inputs"
                    @onclick="@(() => Vm.ReplayRun(run.Id, run.ProjectId))">↻ Replay</button>
            <button class="dcbtn btn-open-project"
                    @onclick="@(() => Vm.OpenProject(run.ProjectId, "jobs"))">Open project →</button>
            <button class="dcslide-x" @onclick="Vm.CloseRun">×</button>
        </div>
        <div class="dcslide-body slide-body-scroll">
            <div class="status-line">
                <span class="status-pill-lg" style="color:@Vm.Presentation.StatusColor(run.Status); background:@Vm.Presentation.StatusBackground(run.Status)">@run.Status</span>
                <span class="note-sm">
                    Ran as: <code>@run.Snapshot.MapSourceKind</code> · @run.Snapshot.MapSourceLabel
                    · @run.Snapshot.ShardCount shard(s) · concurrency @run.Snapshot.ConcurrencyLimit
                </span>
            </div>

            @if (Vm.OpenArtifacts is { Count: > 0 })
            {
                <div class="dccard panel-card">
                    <div class="panel-title">Post-job outputs</div>
                    <div class="output-list">
                        @foreach (var art in Vm.OpenArtifacts)
                        {
                            <div class="output-row">
                                <span class="kind-tag">@art.Kind</span>
                                <a href="@($"/runs/{art.RunId}/artifacts/{art.Id}")" target="_blank" rel="noopener"
                                   class="output-link">@art.Title ↗</a>
                                <span class="size-note">@Vm.Presentation.Bytes(art.SizeBytes)</span>
                            </div>
                        }
                    </div>
                </div>
            }

            @* ── Full in-process OTel span tree (run → shards). ── *@
            @if (Vm.OpenTraceSpans is { Count: > 0 })
            {
                <div class="dccard panel-card">
                    <div class="panel-head">
                        <div class="card-title">Full trace</div>
                        <div class="note-sm">
                            @if (Vm.OpenTelemetry?.TraceId is { } tid)
                            {
                                <span class="mono">@tid</span>
                            }
                            · @Vm.Presentation.Milliseconds(Vm.OpenTelemetry?.DurationMs) total
                        </div>
                    </div>
                    <div class="trace-waterfall">
                        @foreach (var span in Vm.OpenTraceSpans)
                        {
                            @* Trace spans are rendered by the existing trace component markup. *@
                        }
                    </div>
                </div>
            }
            else if (Vm.OpenTelemetry is { } tel)
            {
                <div class="dccard panel-card">
                    <div class="panel-head">
                        <div class="card-title">OpenTelemetry summary</div>
                        <div class="note-sm">@Vm.Presentation.Milliseconds(tel.DurationMs) total @(Vm.IsReplay(tel) ? "· replay" : "")</div>
                    </div>
                    <div class="shard-chips">
                        @foreach (var shard in tel.Shards.OrderBy(s => s.Index))
                        {
                            <span class="shard-chip">
                                shard @shard.Index
                                <span style="color:@Vm.Presentation.StatusColor(shard.Outcome)">@shard.Outcome</span>
                                · @Vm.Presentation.Milliseconds(shard.DurationMs)
                            </span>
                        }
                    </div>
                </div>
            }

            @foreach (var shard in run.ShardResults)
            {
                <div class="shard-block">
                    <div class="shard-title">
                        <span>Shard @shard.Index</span>
                        <span class="outcome-pill" style="color:@Vm.Presentation.StatusColor(shard.Outcome); background:@Vm.Presentation.StatusBackground(shard.Outcome)">@shard.Outcome</span>
                        <span class="note-sm">exit @shard.ExitCode</span>
                    </div>
                    @if (shard.Artifact is not null)
                    {
                        <pre class="shard-json">@Vm.Presentation.Json(shard.Artifact)</pre>
                        @if (Vm.TryArtifactSvg(shard.Artifact, out var shardChart))
                        {
                            <div class="chart-label">chart <span class="text-dim">(from the artifact's JSON)</span></div>
                            @((MarkupString)shardChart)
                        }
                    }
                    @if (shard.Artifacts.Count > 0)
                    {
                        <div class="artifact-dl-row">
                            @foreach (var a in shard.Artifacts)
                            {
                                <a class="dcbtn dl-btn"
                                   href="@ObservabilityViewModel.DataUri(a)" download="@a.Name">⬇ @a.Name</a>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(shard.Log))
                    {
                        <details class="log-details" open="@Vm.IsFailed(shard.Outcome)">
                            <summary class="log-summary">Log</summary>
                            <pre class="log-pre">@shard.Log</pre>
                        </details>
                    }
                </div>
            }

            @if (run.ReduceResult is { } reduce)
            {
                <div class="reduce-block">
                    <div class="shard-title">
                        <span>Reduce step</span>
                        <span class="outcome-pill" style="color:@(reduce.Succeeded ? "var(--good)" : "var(--bad)"); background:@(reduce.Succeeded ? "var(--good-bg)" : "var(--bad-bg)")">
                            @(reduce.Succeeded ? "succeeded" : "failed")
                        </span>
                        <span class="note-sm">exit @reduce.ExitCode</span>
                    </div>
                    @if (reduce.Artifact is not null)
                    {
                        <pre class="reduce-json">@Vm.Presentation.Json(reduce.Artifact)</pre>
                    }
                    @if (!string.IsNullOrWhiteSpace(reduce.Log))
                    {
                        <details class="log-details">
                            <summary class="log-summary">Log</summary>
                            <pre class="log-pre">@reduce.Log</pre>
                        </details>
                    }
                </div>
            }
        </div>
    </div>
}
