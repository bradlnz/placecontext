@page "/project/{ProjectId:guid}/entities"
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@using PlaceContext.Application.Features
@inject IPlaceContextService Svc
@inject PortalUiState Ui

<PageTitle>placecontext — Entities</PageTitle>

<div style="padding:20px 24px 40px; max-width:1320px; margin:0 auto">
    <DataTabs ProjectId="ProjectId" Active="entities" />

    <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:14px">
        <div>
            <h2 style="font-size:18px; font-weight:600; margin:0">Entities</h2>
            <div style="font-size:12px; color:var(--text-3); margin-top:3px">
                Tag ingested tables as business entities and relate them to each other — the entity graph
                below. Each entity becomes a menu item with its own business view.
            </div>
        </div>
        <button class="dcbtn primary" @onclick="@(() => OpenEditor(null))">+ New entity</button>
    </div>

    @* ── The entity graph: nodes = entities, edges = declared relations ─────────────────── *@
    @if (_entities.Count > 0)
    {
        <div class="dccard" style="padding:16px 18px; margin-bottom:16px; display:flex; flex-wrap:wrap; gap:26px; align-items:center">
            @foreach (var e in _entities)
            {
                <div style="display:flex; align-items:center; gap:10px">
                    <div @onclick="@(() => OpenEditor(e))"
                         style="border:1px solid var(--brand-2); border-radius:9px; padding:9px 14px; background:var(--brand-bg); cursor:pointer">
                        <div style="font-size:12.5px; font-weight:600">@e.Name</div>
                        <div style="font-size:10px; color:var(--text-3); font-family:var(--font-sans)">@e.TableName</div>
                    </div>
                    @foreach (var r in e.Relations)
                    {
                        <div style="display:flex; align-items:center; gap:6px; font-size:10.5px; color:var(--text-3)">
                            <span style="font-family:var(--font-sans)">@r.Column</span>
                            <svg width="34" height="12" viewBox="0 0 34 12"><line x1="1" y1="6" x2="26" y2="6" stroke="currentColor" stroke-dasharray="3 2"/><path d="M26 2l7 4-7 4Z" fill="currentColor"/></svg>
                            <span style="font-family:var(--font-sans); color:var(--human)">@r.TargetEntity.@r.TargetColumn</span>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="dccard" style="padding:24px; text-align:center; color:var(--text-3); font-size:13px">
            No entities yet — tag your first ingested table (e.g. <b>sites</b>) and it appears in the
            project menu as a business view.
        </div>
    }
</div>

@* ── Entity editor slide-out ─────────────────────────────────────────────────────────────── *@
@if (_showEditor)
{
    <div class="dcslide-scrim" @onclick="@(() => _showEditor = false)"></div>
    <div class="dcslide" style="width:540px">
        <div class="dcslide-head">
            <div style="flex:1">
                <div style="font-size:14px; font-weight:600">@(_editId.HasValue ? "Edit entity" : "New entity")</div>
                <div style="font-size:11.5px; color:var(--text-3); margin-top:3px">A named business view over an ingested table, related to other entities.</div>
            </div>
            <button class="dcslide-x" @onclick="@(() => _showEditor = false)">×</button>
        </div>
        <div class="dcslide-body" style="flex:1; overflow-y:auto; display:flex; flex-direction:column; gap:12px">
            <div style="display:flex; gap:10px">
                <div class="dcfield" style="flex:1">
                    <label>Name <span class="req">*</span> <span class="code" style="margin-left:4px">menu label</span></label>
                    <input class="dcinput" @bind="_edName" placeholder="Sites" />
                </div>
                <div class="dcfield" style="flex:1">
                    <label>Source table / view <span class="req">*</span></label>
                    <select class="dcinput" @bind="_edTable">
                        <option value="">— pick —</option>
                        @foreach (var t in _tables)
                        {
                            <option value="@t.Name">@t.Name@(t.IsView ? " (view)" : "")</option>
                        }
                    </select>
                </div>
            </div>
            <div class="dcfield" style="max-width:250px">
                <label>Label column <span class="code" style="margin-left:4px">names a record</span></label>
                <input class="dcinput" style="font-family:var(--font-sans)" @bind="_edLabel" placeholder="name" />
            </div>
            <div class="dcfield">
                <div style="display:flex; align-items:center; justify-content:space-between">
                    <label>Relations <span class="code" style="margin-left:4px">this column ↔ that entity's column</span></label>
                    <button class="dcbtn" style="padding:3px 9px; font-size:11px" @onclick="@(() => _edRelations.Add(new RelEdit()))">+ relation</button>
                </div>
                <div style="display:flex; flex-direction:column; gap:6px; margin-top:6px">
                    @for (var i = 0; i < _edRelations.Count; i++)
                    {
                        var idx = i;
                        <div style="display:flex; gap:6px; align-items:center">
                            <input class="dcinput" style="flex:1; font-size:12px; font-family:var(--font-sans)" placeholder="column" @bind="_edRelations[idx].Column" />
                            <span style="color:var(--text-3)">↔</span>
                            <select class="dcinput" style="flex:1; font-size:12px" @bind="_edRelations[idx].TargetEntity">
                                <option value="">— entity —</option>
                                @foreach (var e in _entities.Where(x => x.Id != _editId))
                                {
                                    <option value="@e.Name">@e.Name</option>
                                }
                            </select>
                            <input class="dcinput" style="flex:1; font-size:12px; font-family:var(--font-sans)" placeholder="their column (default: same)" @bind="_edRelations[idx].TargetColumn" />
                            <button class="dcbtn" style="padding:3px 8px" @onclick="@(() => _edRelations.RemoveAt(idx))">×</button>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="dcslide-foot">
            @if (_error is not null)
            {
                <div style="flex:1; color:var(--bad); font-size:12px">@_error</div>
            }
            @if (_editId.HasValue)
            {
                <button class="dcbtn" style="color:var(--bad)" @onclick="DeleteAsync">Delete</button>
            }
            <button class="dcbtn" @onclick="@(() => _showEditor = false)">Cancel</button>
            <button class="dcbtn primary" disabled="@_busy" @onclick="SaveAsync">@(_busy ? "Saving…" : "Save entity")</button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private IReadOnlyList<DataEntityView> _entities = Array.Empty<DataEntityView>();
    private IReadOnlyList<PlaceContext.Application.Ports.ProjectTableInfo> _tables = Array.Empty<PlaceContext.Application.Ports.ProjectTableInfo>();
    private bool _showEditor, _busy;
    private Guid? _editId;
    private string _edName = "", _edTable = "", _edLabel = "";
    private string? _error;
    private readonly List<RelEdit> _edRelations = new();

    private sealed class RelEdit
    {
        public string Column = "";
        public string TargetEntity = "";
        public string TargetColumn = "";
    }

    protected override async Task OnParametersSetAsync()
    {
        Ui.Set("Entities", "the project's data graph — tagged tables, related records");
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _entities = await Svc.ListDataEntitiesAsync(ProjectId);
            _tables = await Svc.ListProjectDataTablesAsync(ProjectId);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void OpenEditor(DataEntityView? e)
    {
        _editId = e?.Id;
        _edName = e?.Name ?? "";
        _edTable = e?.TableName ?? "";
        _edLabel = e?.LabelColumn ?? "";
        _edRelations.Clear();
        if (e is not null)
            _edRelations.AddRange(e.Relations.Select(r => new RelEdit { Column = r.Column, TargetEntity = r.TargetEntity, TargetColumn = r.TargetColumn }));
        _error = null;
        _showEditor = true;
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_edName)) { _error = "Name is required."; return; }
        if (string.IsNullOrWhiteSpace(_edTable)) { _error = "Pick a source table or view."; return; }
        _busy = true;
        try
        {
            var relations = _edRelations
                .Select(r => new EntityRelationDto(r.Column, r.TargetEntity, r.TargetColumn))
                .ToList();
            await Svc.SaveDataEntityAsync(new SaveDataEntityCommand(
                ProjectId, _edName, _edTable, _edLabel, relations, _editId));
            await ReloadAsync();
            _showEditor = false;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        if (_editId is not { } id) return;
        try
        {
            await Svc.DeleteDataEntityAsync(id);
            await ReloadAsync();
            _showEditor = false;
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
