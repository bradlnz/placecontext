@page "/project/{ProjectId:guid}/entities"
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@using PlaceContext.Application.Features
@inject IPlaceContextService Svc
@inject PortalUiState Ui

<PageTitle>placecontext — Entities</PageTitle>

<div class="page">
    <DataTabs ProjectId="ProjectId" Active="entities" />

    <div class="page-head">
        <div>
            <h2 class="page-title">Entities</h2>
            <div class="page-sub">
                Tag ingested tables as business entities and relate them to each other — the entity graph
                below. Each entity becomes a menu item with its own business view.
            </div>
        </div>
        <button class="dcbtn primary" @onclick="@(() => OpenEditor(null))">+ New entity</button>
    </div>

    @* ── The entity graph: nodes = entities, edges = declared relations ─────────────────── *@
    @if (_entities.Count > 0)
    {
        <div class="dccard entity-graph">
            @foreach (var e in _entities)
            {
                <div class="entity-row">
                    <div @onclick="@(() => OpenEditor(e))"
                         class="entity-node">
                        <div class="entity-node-name">@e.Name</div>
                        <div class="entity-node-table">@e.TableName</div>
                        @if (e.Tags.Count > 0)
                        {
                            <div class="entity-tags">
                                @foreach (var tag in e.Tags)
                                {
                                    <span class="entity-tag">@tag</span>
                                }
                            </div>
                        }
                    </div>
                    @foreach (var r in e.Relations)
                    {
                        <div class="entity-rel">
                            <span class="sans">@r.Column</span>
                            <svg width="34" height="12" viewBox="0 0 34 12"><line x1="1" y1="6" x2="26" y2="6" stroke="currentColor" stroke-dasharray="3 2"/><path d="M26 2l7 4-7 4Z" fill="currentColor"/></svg>
                            <span class="rel-target">@r.TargetEntity.@r.TargetColumn</span>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="dccard empty-note">
            No entities yet — tag your first ingested table (e.g. <b>sites</b>) and it appears in the
            project menu as a business view.
        </div>
    }
</div>

@* ── Entity editor slide-out ─────────────────────────────────────────────────────────────── *@
@if (_showEditor)
{
    <div class="dcslide-scrim" @onclick="@(() => _showEditor = false)"></div>
    <div class="dcslide editor-slide">
        <div class="dcslide-head">
            <div class="flex-1">
                <div class="slide-title">@(_editId.HasValue ? "Edit entity" : "New entity")</div>
                <div class="slide-sub">A named business view over an ingested table, related to other entities.</div>
            </div>
            <button class="dcslide-x" @onclick="@(() => _showEditor = false)">×</button>
        </div>
        <div class="dcslide-body editor-body">
            <div class="field-row">
                <div class="dcfield flex-1">
                    <label>Name <span class="req">*</span> <span class="code code-hint">menu label</span></label>
                    <input class="dcinput" @bind="_edName" placeholder="Sites" />
                </div>
                <div class="dcfield flex-1">
                    <label>Source table / view <span class="req">*</span></label>
                    <select class="dcinput" @bind="_edTable">
                        <option value="">— pick —</option>
                        @foreach (var t in _tables)
                        {
                            <option value="@t.Name">@t.Name@(t.IsView ? " (view)" : "")</option>
                        }
                    </select>
                </div>
            </div>
            <div class="dcfield field-narrow">
                <label>Label column <span class="code code-hint">names a record</span></label>
                <input class="dcinput sans" @bind="_edLabel" placeholder="name" />
            </div>
            <div class="dcfield">
                <label>Tags <span class="code code-hint">extra keys a run's output maps this entity to</span></label>
                <div class="tag-input-box">
                    @foreach (var tag in _edTags)
                    {
                        var t = tag;
                        <span class="tag-chip">
                            @t
                            <button class="dcslide-x tag-chip-x"
                                    title="Remove tag" @onclick="@(() => _edTags.Remove(t))">×</button>
                        </span>
                    }
                    <input class="dcinput tag-input"
                           placeholder="type a tag, press Enter" @bind="_tagInput" @bind:event="oninput" @onkeydown="TagKey" />
                </div>
                <div class="field-hint">Enter or comma adds; a run whose output or documents mention a tag links to this entity.</div>
            </div>
            <div class="dcfield">
                <div class="flex-between">
                    <label>Relations <span class="code code-hint">this column ↔ that entity's column</span></label>
                    <button class="dcbtn rel-add-btn" @onclick="@(() => _edRelations.Add(new RelEdit()))">+ relation</button>
                </div>
                <div class="rel-list">
                    @for (var i = 0; i < _edRelations.Count; i++)
                    {
                        var idx = i;
                        <div class="rel-edit-row">
                            <input class="dcinput rel-input-mono" placeholder="column" @bind="_edRelations[idx].Column" />
                            <span class="rel-sep">↔</span>
                            <select class="dcinput rel-select" @bind="_edRelations[idx].TargetEntity">
                                <option value="">— entity —</option>
                                @foreach (var e in _entities.Where(x => x.Id != _editId))
                                {
                                    <option value="@e.Name">@e.Name</option>
                                }
                            </select>
                            <input class="dcinput rel-input-mono" placeholder="their column (default: same)" @bind="_edRelations[idx].TargetColumn" />
                            <button class="dcbtn rel-del-btn" @onclick="@(() => _edRelations.RemoveAt(idx))">×</button>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="dcslide-foot">
            @if (_error is not null)
            {
                <div class="foot-error">@_error</div>
            }
            @if (_editId.HasValue)
            {
                <button class="dcbtn btn-danger" @onclick="DeleteAsync">Delete</button>
            }
            <button class="dcbtn" @onclick="@(() => _showEditor = false)">Cancel</button>
            <button class="dcbtn primary" disabled="@_busy" @onclick="SaveAsync">@(_busy ? "Saving…" : "Save entity")</button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private IReadOnlyList<DataEntityView> _entities = Array.Empty<DataEntityView>();
    private IReadOnlyList<PlaceContext.Application.Ports.ProjectTableInfo> _tables = Array.Empty<PlaceContext.Application.Ports.ProjectTableInfo>();
    private bool _showEditor, _busy;
    private Guid? _editId;
    private string _edName = "", _edTable = "", _edLabel = "";
    private string? _error;
    private readonly List<RelEdit> _edRelations = new();
    private readonly List<string> _edTags = new();
    private string _tagInput = "";

    private sealed class RelEdit
    {
        public string Column = "";
        public string TargetEntity = "";
        public string TargetColumn = "";
    }

    protected override async Task OnParametersSetAsync()
    {
        Ui.Set("Entities", "the project's data graph — tagged tables, related records");
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        try
        {
            _entities = await Svc.ListDataEntitiesAsync(ProjectId);
            _tables = await Svc.ListProjectDataTablesAsync(ProjectId);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private void OpenEditor(DataEntityView? e)
    {
        _editId = e?.Id;
        _edName = e?.Name ?? "";
        _edTable = e?.TableName ?? "";
        _edLabel = e?.LabelColumn ?? "";
        _edRelations.Clear();
        if (e is not null)
            _edRelations.AddRange(e.Relations.Select(r => new RelEdit { Column = r.Column, TargetEntity = r.TargetEntity, TargetColumn = r.TargetColumn }));
        _edTags.Clear();
        if (e is not null) _edTags.AddRange(e.Tags);
        _tagInput = "";
        _error = null;
        _showEditor = true;
    }

    // Enter or comma commits the typed tag; a duplicate (case-insensitive) is ignored.
    private void TagKey(KeyboardEventArgs e)
    {
        if (e.Key is not ("Enter" or ",")) return;
        var tag = _tagInput.Trim().TrimEnd(',').Trim();
        if (tag.Length > 0 && !_edTags.Contains(tag, StringComparer.OrdinalIgnoreCase))
            _edTags.Add(tag);
        _tagInput = "";
    }

    private async Task SaveAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_edName)) { _error = "Name is required."; return; }
        if (string.IsNullOrWhiteSpace(_edTable)) { _error = "Pick a source table or view."; return; }
        _busy = true;
        try
        {
            var relations = _edRelations
                .Select(r => new EntityRelationDto(r.Column, r.TargetEntity, r.TargetColumn))
                .ToList();
            // A tag left in the input box (never Enter-committed) should still be saved.
            var tags = _edTags.ToList();
            var pending = _tagInput.Trim().TrimEnd(',').Trim();
            if (pending.Length > 0 && !tags.Contains(pending, StringComparer.OrdinalIgnoreCase)) tags.Add(pending);
            await Svc.SaveDataEntityAsync(new SaveDataEntityCommand(
                ProjectId, _edName, _edTable, _edLabel, relations, tags, _editId));
            await ReloadAsync();
            _showEditor = false;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteAsync()
    {
        if (_editId is not { } id) return;
        try
        {
            await Svc.DeleteDataEntityAsync(id);
            await ReloadAsync();
            _showEditor = false;
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
