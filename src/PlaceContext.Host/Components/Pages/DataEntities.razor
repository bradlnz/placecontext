@page "/project/{ProjectId:guid}/entities"
@attribute [Authorize(Policy = Permission.DataRead)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@using PlaceContext.Application.Features
@implements IDisposable
@inject DataEntitiesViewModel Vm
@using PlaceContext.Host.Components.ViewModels

<PageTitle>placecontext — Entities</PageTitle>

<div class="page">
    <DataTabs ProjectId="ProjectId" Active="@DataSection.Entities" />

    <div class="page-head">
        <div>
            <h2 class="page-title">Entities</h2>
            <div class="page-sub">
                Tag ingested tables as business entities and relate them to each other. Each entity becomes
                a menu item with its own business view.
            </div>
        </div>
        <div class="head-actions">
            <button class="dcbtn" disabled="@Vm.Rescanning" @onclick="Vm.RescanAsync">@(Vm.Rescanning ? "Scanning…" : "↻ Rescan links")</button>
            <button class="dcbtn primary" @onclick="@(() => Vm.OpenEditor(null))">+ New entity</button>
        </div>
    </div>

    @if (Vm.Entities.Count > 0)
    {
        <section class="entity-summary"><div><strong>@Vm.Entities.Count</strong><span>entities</span></div><div><strong>@Vm.Entities.Sum(x => x.Relations.Count)</strong><span>relations</span></div><div><strong>@Vm.Entities.Sum(x => x.Tags.Count)</strong><span>tags</span></div></section>
        <section class="dccard entity-suite">
            <header class="entity-suite-head"><div><strong>Entity catalogue</strong><span>Business views over project data tables</span></div></header>
            <div class="entity-list">
            @foreach (var e in Vm.Entities)
            {
                <article class="entity-row" @onclick="@(() => Vm.NavigateToEntity(e.Name))">
                    <span class="entity-icon"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="8" ry="3" /><path d="M4 5v7c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 12v7c0 1.7 3.6 3 8 3s8-1.3 8-3v-7" /></svg></span>
                    <div class="entity-copy">
                        <div><strong>@e.Name</strong><span class="entity-table-chip">@e.TableName</span></div>
                        <small>@e.Relations.Count relation@(e.Relations.Count == 1 ? "" : "s") · @e.Tags.Count tag@(e.Tags.Count == 1 ? "" : "s")</small>
                        @if (e.Tags.Count > 0)
                        {
                            <div class="entity-tags">
                                @foreach (var tag in e.Tags)
                                {
                                    <span class="entity-tag">@tag</span>
                                }
                            </div>
                        }
                    </div>
                        <div class="entity-actions" @onclick:stopPropagation="true">
                            <button class="dcbtn xs" @onclick="@(() => Vm.OpenEditor(e))">Edit</button>
                            <button class="dcbtn xs" @onclick="@(() => Vm.NavigateToEntity(e.Name))">Open records</button>
                        </div>
                </article>
            }
            </div>
        </section>
    }
    else
    {
        <div class="dccard empty-note">
            No entities yet — tag your first ingested table (e.g. <b>sites</b>) and it appears in the
            project menu as a business view.
        </div>
    }

    @if (Vm.RescanMessage is not null)
    {
        <div class="rescan-msg">@Vm.RescanMessage</div>
    }

</div>

@* ── Entity editor slide-out ─────────────────────────────────────────────────────────────── *@
@if (Vm.ShowEditor)
{
    <div class="dcslide-scrim" @onclick="@(() => Vm.ShowEditor = false)"></div>
    <div class="dcslide editor-slide">
        <div class="dcslide-head">
            <div class="flex-1">
                <div class="slide-title">@(Vm.EditId.HasValue ? "Edit entity" : "New entity")</div>
                <div class="slide-sub">A named business view over an ingested table, related to other entities.</div>
            </div>
            <button class="dcslide-x" @onclick="@(() => Vm.ShowEditor = false)">×</button>
        </div>
        <div class="dcslide-body editor-body">
            <div class="field-row">
                <div class="dcfield flex-1">
                    <label>Name <span class="req">*</span> <span class="code code-hint">menu label</span></label>
                    <input class="dcinput" @bind="Vm.EditName" placeholder="Sites" />
                </div>
                <div class="dcfield flex-1">
                    <label>Source table / view <span class="req">*</span></label>
                    <select class="dcinput" @bind="Vm.EditTable">
                        <option value="">— pick —</option>
                        @foreach (var t in Vm.Tables)
                        {
                            <option value="@t.Name">@t.Name@(t.IsView ? " (view)" : "")</option>
                        }
                    </select>
                </div>
            </div>
            <div class="dcfield field-narrow">
                <label>Label column <span class="code code-hint">names a record</span></label>
                <input class="dcinput sans" @bind="Vm.EditLabel" placeholder="name" />
            </div>
            <div class="dcfield">
                <label>Tags <span class="code code-hint">extra keys a run's output maps this entity to</span></label>
                <div class="tag-input-box">
                    @foreach (var tag in Vm.EditTags)
                    {
                        var t = tag;
                        <span class="tag-chip">
                            @t
                            <button class="dcslide-x tag-chip-x"
                                    title="Remove tag" @onclick="@(() => Vm.EditTags.Remove(t))">×</button>
                        </span>
                    }
                    <input class="dcinput tag-input"
                           placeholder="type a tag, press Enter" @bind="Vm.TagInput" @bind:event="oninput" @onkeydown="Vm.TagKey" />
                </div>
                <div class="field-hint">Enter or comma adds; a run whose output or documents mention a tag links to this entity.</div>
            </div>
            <div class="dcfield">
                <div class="flex-between">
                    <label>Relations <span class="code code-hint">this column ↔ that entity's column</span></label>
                    <button class="dcbtn rel-add-btn" @onclick="@(() => Vm.EditRelations.Add(new DataEntitiesViewModel.RelationEdit()))">+ relation</button>
                </div>
                <div class="rel-list">
                    @for (var i = 0; i < Vm.EditRelations.Count; i++)
                    {
                        var idx = i;
                        <div class="rel-edit-row">
                            <input class="dcinput rel-input-mono" placeholder="column" @bind="Vm.EditRelations[idx].Column" />
                            <span class="rel-sep">↔</span>
                            <select class="dcinput rel-select" @bind="Vm.EditRelations[idx].TargetEntity">
                                <option value="">— entity —</option>
                                @foreach (var e in Vm.Entities.Where(x => x.Id != Vm.EditId))
                                {
                                    <option value="@e.Name">@e.Name</option>
                                }
                            </select>
                            <input class="dcinput rel-input-mono" placeholder="their column (default: same)" @bind="Vm.EditRelations[idx].TargetColumn" />
                            <button class="dcbtn rel-del-btn" @onclick="@(() => Vm.EditRelations.RemoveAt(idx))">×</button>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="dcslide-foot">
            @if (Vm.Error is not null)
            {
                <div class="foot-error">@Vm.Error</div>
            }
            @if (Vm.EditId.HasValue)
            {
                <button class="dcbtn btn-danger" @onclick="Vm.DeleteAsync">Delete</button>
            }
            <button class="dcbtn" @onclick="@(() => Vm.ShowEditor = false)">Cancel</button>
            <button class="dcbtn primary" disabled="@Vm.Busy" @onclick="Vm.SaveAsync">@(Vm.Busy ? "Saving…" : "Save entity")</button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    protected override async Task OnParametersSetAsync() { Vm.Attach(() => InvokeAsync(StateHasChanged)); await Vm.LoadAsync(ProjectId); }
    public void Dispose() { Vm.Detach(); }
}
