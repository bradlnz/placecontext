@page "/settings/artifacts"
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@attribute [Authorize(Policy = Policies.DefaultAdmin)]
@using PlaceContext.Host.Components.ViewModels
@inject ArtifactSettingsViewModel Vm
@implements IDisposable
<PageTitle>placecontext — Artifact filters</PageTitle>
<div class="page">
    <h2 class="page-title">Artifact filters</h2>
    <div class="page-sub">Group artifact files into named filter buttons using filename prefixes. Rules are checked from top to bottom.</div>
    @if (Vm.Message is not null)
    {
        <div class="message">@Vm.Message</div>
    }
    <div class="dccard panel">
        <div class="panel-head">
            <div>
                <div class="panel-title">Filter buttons</div>
                <div class="panel-note">Example: <code>feasibility_v1_</code> → <strong>Feasibility Reports</strong></div>
            </div>
            <button class="dcbtn" @onclick="Vm.Reset">Reset defaults</button>
        </div>
        <div class="rules">
            @if (Vm.Rows.Count == 0)
            {
                <div class="empty">No custom artifact filters. The page will show All and Other.</div>
            }
            @for (var index = 0; index < Vm.Rows.Count; index++)
            {
                var row = Vm.Rows[index];
                var rowIndex = index;
                <div class="rule">
                    <div class="rule-order">
                        <button class="dcbtn move" disabled="@(rowIndex == 0)" @onclick="() => Vm.Move(rowIndex, -1)">↑</button>
                        <button class="dcbtn move" disabled="@(rowIndex == Vm.Rows.Count - 1)" @onclick="() => Vm.Move(rowIndex, 1)">↓</button>
                    </div>
                    <div class="rule-fields">
                        <label>
                            <span>Button label</span>
                            <input class="dcinput" @bind="row.Label" />
                        </label>
                        <label>
                            <span>Filename prefixes</span>
                            <textarea class="dcinput prefixes" @bind="row.PrefixText"></textarea>
                        </label>
                    </div>
                    <button class="dcbtn remove" @onclick="() => Vm.Remove(row)">Remove</button>
                </div>
            }
        </div>
        <button class="dcbtn add" @onclick="Vm.AddRule">＋ Add filter</button>
    </div>
    <div class="actions">
        <button class="dcbtn primary" disabled="@Vm.Saving" @onclick="Vm.SaveAsync">
            @(Vm.Saving ? "Saving…" : "Save artifact filters")
        </button>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync() => await Vm.LoadAsync();

    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));

    public void Dispose() => Vm.Detach();
}
