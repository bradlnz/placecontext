@page "/settings/mcp"
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@attribute [Authorize(Policy = Policies.DefaultAdmin)]
@using PlaceContext.Host.Components.ViewModels
@using PlaceContext.Domain.Mcp
@inject McpSettingsViewModel Vm
@implements IDisposable
<PageTitle>PlaceContext — MCP servers</PageTitle>
<div class="mcp-settings-page">
    <header class="settings-head">
        <div>
            <span class="settings-kicker">Project integrations</span>
            <h2>MCP servers</h2>
            <p>Connect external tool servers and make them available to jobs in the selected project.</p>
        </div>
        <button class="dcbtn primary" disabled="@(Vm.ProjectId is null)" @onclick="Vm.ShowAddMcp">+ Add server</button>
    </header>
    <div class="dcfield project-picker">
        <label>Project</label>
        <select class="dcinput" value="@Vm.ProjectId" @onchange="Vm.ProjectChangedAsync">
            <option value="">Select a project…</option>
            @foreach (var project in Vm.Projects)
            {
                <option value="@project.Id">@project.Name</option>
            }
        </select>
    </div>
    @if (Vm.Message is not null)
    {
        <div class="settings-message">@Vm.Message</div>
    }
    <section class="dccard server-card">
        @if (Vm.Loading)
        {
            <Skeleton Kind="list" Rows="3" />
        }
        else if (Vm.ProjectId is null)
        {
            <div class="empty-note">Choose a project to manage its MCP servers.</div>
        }
        else if (Vm.Connections.Count == 0)
        {
            <div class="empty-note">No MCP servers configured for this project.</div>
        }
        else
        {
            @foreach (var connection in Vm.Connections)
            {
                var expired = Vm.IsExpired(connection);
                <article class="server-row @(!connection.Enabled ? "disabled" : "")">
                    <div class="server-info">
                        <strong>@connection.Name</strong>
                        <span>@connection.Transport</span>
                        @if (connection.AuthType == McpAuthType.OAuth)
                        {
                            <span>@(expired ? "OAuth expired" : Vm.IsOAuthConnected(connection) ? "OAuth connected" : "OAuth")</span>
                        }
                        <small>@connection.LastStatus</small>
                    </div>
                    <div class="server-actions">
                        @if (connection.AuthType == McpAuthType.OAuth)
                        {
                            <button class="dcbtn xs" @onclick="() => Vm.StartOAuthFlowAsync(connection.Id)">
                                @(expired ? "Reconnect" : "Authorize")
                            </button>
                        }
                        <button class="dcbtn xs" @onclick="() => Vm.TestAsync(connection.Id)">Test</button>
                        <button class="dcbtn xs danger" @onclick="() => Vm.DeleteAsync(connection.Id)">Delete</button>
                    </div>
                </article>
            }
        }
    </section>
    @if (Vm.ShowAdd && Vm.ProjectId is not null)
    {
        <section class="dccard add-card">
            <div class="form-title">New MCP server</div>
            <div class="field-grid">
                <input class="dcinput" @bind="Vm.Name" placeholder="Property tools" />
                <select class="dcinput" @bind="Vm.Transport">
                    <option value="@McpTransport.Http">HTTP</option>
                    <option value="@McpTransport.Sse">SSE</option>
                    <option value="@McpTransport.Stdio">Stdio</option>
                </select>
            </div>
            @if (Vm.IsStdio)
            {
                <div class="field-grid">
                    <input class="dcinput" @bind="Vm.Command" placeholder="npx" />
                    <input class="dcinput" @bind="Vm.Args" placeholder='["-y", "server"]' />
                </div>
            }
            else
            {
                <input class="dcinput" @bind="Vm.Endpoint" placeholder="https://mcp.example.com/mcp" />
            }
            <div class="field-grid">
                <select class="dcinput" @bind="Vm.AuthType">
                    <option value="@McpAuthType.None">None</option>
                    <option value="@McpAuthType.Bearer">Bearer token</option>
                    <option value="@McpAuthType.ApiKey">API key</option>
                    <option value="@McpAuthType.Header">Custom header</option>
                    <option value="@McpAuthType.OAuth">OAuth 2.1</option>
                </select>
                @if (Vm.HasTokenAuth)
                {
                    <input class="dcinput" type="password" @bind="Vm.AuthToken" />
                }
                else if (Vm.IsHeaderAuth)
                {
                    <input class="dcinput" @bind="Vm.AuthHeader" placeholder="X-API-Key" />
                }
            </div>
            @if (Vm.IsHeaderAuth)
            {
                <input class="dcinput" type="password" @bind="Vm.AuthToken" />
            }
            else if (Vm.IsOAuth)
            {
                <input class="dcinput" @bind="Vm.OAuthScopes" placeholder="openid profile" />
            }
            <div class="form-actions">
                <button class="dcbtn" @onclick="Vm.CancelAdd">Cancel</button>
                <button class="dcbtn primary" disabled="@string.IsNullOrWhiteSpace(Vm.Name)" @onclick="Vm.AddAsync">Add server</button>
            </div>
        </section>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        Vm.Attach(() => InvokeAsync(StateHasChanged));
        await Vm.LoadAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender) => Vm.AfterRenderAsync(firstRender);

    public void Dispose()
    {
        Vm.Detach();
        Vm.Dispose();
    }
}
