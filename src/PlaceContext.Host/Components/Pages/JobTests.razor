@page "/project/{ProjectId:guid}/tests"
@attribute [Authorize(Policy = Permission.JobsView)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@inject JobTestsViewModel Vm
@using PlaceContext.Host.Components.ViewModels

<PageTitle>PlaceContext — Tests</PageTitle>

<div class="tests-page">
    <header class="tests-head">
        <div>
            <h2>Tests</h2>
            <p>Verify Job logic against declared mock scenarios with no live Job execution or production side effects.</p>
        </div>
        <div class="head-actions">
            <button class="dcbtn" disabled="@(Vm.Running.Count > 0 || Vm.EnabledTests.Count == 0)"
                    @onclick="Vm.RunAllAsync">
                @(Vm.Running.Count > 0 ? "Running…" : "Run all")
            </button>
            <button class="dcbtn primary" disabled="@(Vm.Jobs.Count == 0)" @onclick="Vm.NewTest">+ New block</button>
        </div>
    </header>

    @if (Vm.Message is not null)
    {
        <div class="test-message @(Vm.MessageIsError ? "error" : null)">@Vm.Message</div>
    }

    @if (Vm.Loading)
    {
        <Skeleton Kind="list" Rows="5" />
    }
    else if (Vm.Jobs.Count == 0)
    {
        <div class="dccard empty-state">
            <div class="empty-icon">⌁</div>
            <strong>Create a Job before adding tests</strong>
            <span>Tests use declared mock scenarios and never execute the selected Job.</span>
            <button class="dcbtn primary" @onclick="@(() => Vm.OpenJobs())">Open Jobs</button>
        </div>
    }
    else if (Vm.Tests.Count == 0)
    {
        <div class="dccard empty-state">
            <div class="empty-icon">✓</div>
            <strong>No test blocks yet</strong>
            <span>Add a framework-backed block with multiple test methods to start verifying Job code.</span>
            <button class="dcbtn primary" @onclick="Vm.NewTest">Create first block</button>
        </div>
    }
    else
    {
        <section class="summary-strip" aria-label="Test summary">
            <div class="summary-count"><strong>@Vm.TotalMethodCount</strong><span>methods</span></div>
            <div class="summary-count passed"><strong>@Vm.PassedCount</strong><span>passed</span></div>
            <div class="summary-count failed"><strong>@Vm.FailedCount</strong><span>failed</span></div>
            <div class="summary-count"><strong>@Vm.NotRunCount</strong><span>not run</span></div>
            <div class="summary-progress">
                <span style="width:@Vm.PassPercent%"></span>
            </div>
        </section>

        <div class="suite-list">
            @foreach (var suite in Vm.Suites)
            {
                <section class="dccard test-suite">
                    <header class="suite-head">
                        <div>
                            <span class="suite-caret">⌄</span>
                            <strong>@suite.Key</strong>
                            <span>@suite.Count() block@(suite.Count() == 1 ? "" : "s") · @suite.Sum(JobTestsViewModel.MethodCount) methods</span>
                        </div>
                        <span class="suite-result">@JobTestsViewModel.SuitePassedCount(suite) / @suite.Sum(JobTestsViewModel.MethodCount) passing</span>
                    </header>

                    <div class="test-rows">
                        @foreach (var test in suite)
                        {
                            var isRunning = Vm.Running.Contains(test.Id);
                            <article class="test-row @Vm.StatusClassLabel(test, isRunning)">
                                <div class="status-icon" aria-label="@Vm.StatusLabelText(test, isRunning)">
                                    @if (isRunning)
                                    {
                                        <span class="spinner"></span>
                                    }
                                    else if (JobTestsViewModel.IsPassed(test))
                                    {
                                        <span>✓</span>
                                    }
                                    else if (JobTestsViewModel.IsFailed(test))
                                    {
                                        <span>×</span>
                                    }
                                    else
                                    {
                                        <span>○</span>
                                    }
                                </div>
                                <div class="test-copy">
                                    <div class="test-title">
                                        <strong>@test.Name</strong>
                                        @if (!test.Enabled)
                                        {
                                            <span class="disabled-chip">disabled</span>
                                        }
                                        @if (test.CodeFiles.Count == 0)
                                        {
                                            <span class="assertion-chip">@JobTestsViewModel.AssertionLabel(test.AssertionType)</span>
                                        }
                                        <span class="assertion-chip">@JobTestFramework.Label(test.RuntimeId) · @JobTestsViewModel.MethodCount(test) methods</span>
                                    </div>
                                    <div class="test-detail">
                                        @if (isRunning)
                                        {
                                            <span>Running framework tests against the mock scenario…</span>
                                        }
                                        else
                                        {
                                            <span>@(test.LastMessage ?? "Not run yet")</span>
                                            @if (test.LastDurationMs is { } duration)
                                            {
                                                <span class="duration">@Vm.DurationLabel(duration)</span>
                                            }
                                        }
                                    </div>
                                    @if (JobTestsViewModel.HasFailureOutput(test, isRunning))
                                    {
                                        <details class="actual-output">
                                            <summary>Actual output</summary>
                                            <pre>@test.LastActualOutput</pre>
                                        </details>
                                    }
                                </div>
                                <div class="test-actions">
                                    @if (Vm.ConfirmDelete == test.Id)
                                    {
                                        <button class="dcbtn danger" @onclick="@(() => Vm.DeleteAsync(test.Id))">Delete</button>
                                        <button class="dcbtn" @onclick="@(() => Vm.ConfirmDelete = null)">Keep</button>
                                    }
                                    else
                                    {
                                        <button class="icon-action" title="Run test" aria-label="Run @test.Name"
                                                disabled="@(isRunning || !test.Enabled)"
                                                @onclick="@(() => Vm.RunAsync(test.Id))">▶</button>
                                        <button class="icon-action" title="Edit test" aria-label="Edit @test.Name"
                                                @onclick="@(() => Vm.EditTest(test))">✎</button>
                                        <button class="icon-action code-action" title="Open test code editor"
                                                aria-label="Open code editor for @test.Name"
                                                @onclick="@(() => Vm.OpenCodeEditor(test.Id))">&lt;/&gt;</button>
                                        <button class="icon-action" title="Delete test" aria-label="Delete @test.Name"
                                                @onclick="@(() => Vm.ConfirmDelete = test.Id)">⋯</button>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>
    }
</div>

@if (Vm.Editing)
{
    <div class="editor-backdrop" @onclick="Vm.CloseEditor">
        <aside class="test-editor" @onclick:stopPropagation="true" role="dialog" aria-modal="true"
               aria-labelledby="test-editor-title">
            <header>
                <div>
                    <span class="eyebrow">JOB TEST BLOCK</span>
                    <h3 id="test-editor-title">@(Vm.EditId is null ? "New block" : "Edit block")</h3>
                </div>
                <button class="close-button" aria-label="Close" @onclick="Vm.CloseEditor">×</button>
            </header>

            <div class="editor-body">
                <label class="field">
                    <span>Job</span>
                    <select class="dcinput" @bind="Vm.EditJobId">
                        @foreach (var job in Vm.Jobs)
                        {
                            <option value="@job.Id">@job.Name</option>
                        }
                    </select>
                </label>

                <label class="field">
                    <span>Block name</span>
                    <input class="dcinput" @bind="Vm.EditName" placeholder="customer output contract" />
                </label>

                <label class="field">
                    <span>Mock scenario JSON</span>
                    <textarea class="dcinput code-input" rows="7" @bind="Vm.EditInput"
                              placeholder='{"input":{},"run":{"status":"Succeeded","output":{},"shards":[]}}'></textarea>
                    <small>Defines input and the mocked status, output, and shard results. Never executes the selected Job.</small>
                </label>

                <label class="field">
                    <span>Assertion</span>
                    <select class="dcinput" @bind="Vm.EditAssertion">
                        @foreach (var assertion in Enum.GetValues<JobTestAssertionType>())
                        {
                            <option value="@assertion">@JobTestsViewModel.AssertionLabel(assertion)</option>
                        }
                    </select>
                </label>

                @if (Vm.EditAssertion != JobTestAssertionType.Succeeds)
                {
                    <label class="field">
                        <span>Expected value</span>
                        <textarea class="dcinput code-input" rows="7" @bind="Vm.EditExpected"
                                  placeholder="@Vm.ExpectedPlaceholder"></textarea>
                        <small>@Vm.AssertionHelp</small>
                    </label>
                }

                <label class="enabled-field">
                    <input type="checkbox" @bind="Vm.EditEnabled" />
                    <span><strong>Enabled</strong><small>Included when Run all is selected.</small></span>
                </label>

                <div class="code-editor-callout">
                    <div>
                        <strong>Framework test methods</strong>
                        <small>Add multiple methods using pytest, Node test, Go testing, or Ruby Minitest.</small>
                    </div>
                    @if (Vm.EditId is { } testId)
                    {
                        <button class="dcbtn" @onclick="@(() => Vm.OpenCodeEditor(testId))">
                            &lt;/&gt; Open code editor
                        </button>
                    }
                    else
                    {
                        <small>Save this block first, then add its test methods in the code editor.</small>
                    }
                </div>
            </div>

            <footer>
                <button class="dcbtn" @onclick="Vm.CloseEditor">Cancel</button>
                <button class="dcbtn primary" disabled="@Vm.Saving" @onclick="Vm.SaveAsync">
                    @(Vm.Saving ? "Saving…" : "Save block")
                </button>
            </footer>
        </aside>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    protected override async Task OnParametersSetAsync() { Vm.Attach(() => InvokeAsync(StateHasChanged)); await Vm.LoadAsync(ProjectId); }
    public void Dispose() { Vm.Detach(); }
}
