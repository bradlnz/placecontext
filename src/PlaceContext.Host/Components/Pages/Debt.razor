@page "/debt"
@inject IPlaceContextService Svc
@inject PortalUiState Ui

<PageTitle>PlaceContext — Debt &amp; Trust</PageTitle>

<div style="padding:24px 24px 40px; max-width:1320px; margin:0 auto">
    @if (_debt is null)
    {
        <p style="color:var(--text-3)">Loading…</p>
    }
    else
    {
        var agentic = (int)Math.Round(_debt.Agentic * 100);
        <!-- hero + signal breakdown -->
        <div style="display:grid; grid-template-columns:340px 1fr; gap:16px; margin-bottom:16px">
            <div style="background:linear-gradient(160deg, var(--brand-bg), var(--card) 62%); border:1px solid var(--border); border-radius:14px; padding:22px; display:flex; flex-direction:column">
                <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px">
                    <span style="font-size:12px; font-weight:600; color:var(--brand-2); text-transform:uppercase; letter-spacing:.6px">Agentic debt</span>
                    <span style="font-size:10px; color:var(--text-3); border:1px solid var(--border-2); border-radius:5px; padding:1px 6px; font-family:'Geist Mono',monospace">root</span>
                </div>
                <div style="display:flex; align-items:flex-end; gap:10px; margin-top:6px">
                    <span style="font-size:62px; font-weight:600; line-height:.9; letter-spacing:-2px; font-family:'Geist Mono',monospace; color:@Viz.Tone(agentic)">@agentic</span>
                    <span style="font-size:18px; color:var(--text-3); font-family:'Geist Mono',monospace; margin-bottom:6px">/100</span>
                </div>
                <p style="font-size:12.5px; line-height:1.55; color:var(--text-2); margin:18px 0 0">
                    Debt accrued when agent-authored changes skip the process guardrails.
                    <span style="color:var(--text)">@_debt.FlaggedChanges of the last @_debt.AgentChangesScored agent changes</span> tripped at least one trust signal.
                </p>
            </div>

            <div class="dccard" style="border-radius:14px; padding:18px 20px">
                <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:16px">
                    <span style="font-size:13px; font-weight:600">Process-trust signals</span>
                    <span style="font-size:11px; color:var(--text-3)">last @_debt.AgentChangesScored agent changes</span>
                </div>
                @if (_debt.TrustSignals.Count == 0)
                {
                    <div style="color:var(--text-3); font-size:12.5px">No trust signals — agent changes are clean. ✓</div>
                }
                else
                {
                    <div style="display:flex; flex-direction:column; gap:13px">
                        @foreach (var t in _debt.TrustSignals)
                        {
                            <div style="display:flex; align-items:center; gap:14px">
                                <span style="width:8px; height:8px; border-radius:2px; background:@Viz.ToneVar(t.Tone); flex:none"></span>
                                <span style="font-size:12.5px; color:var(--text); width:230px; flex:none">@t.Label</span>
                                <div style="flex:1; height:6px; border-radius:99px; background:var(--card-2); overflow:hidden">
                                    <div class="dcbar" data-pct="@t.Percent" style="background:@Viz.ToneVar(t.Tone)"></div>
                                </div>
                                <span style="font-family:'Geist Mono',monospace; font-size:12px; color:var(--text-2); width:70px; text-align:right; flex:none">@t.Count</span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- technical metrics -->
        <div style="display:flex; align-items:center; gap:9px; margin:22px 0 13px">
            <h2 style="font-size:14px; font-weight:600; margin:0">Technical debt</h2>
            <span style="font-size:11px; color:var(--text-3)">across the root</span>
        </div>
        <div style="display:grid; grid-template-columns:repeat(5,1fr); gap:12px">
            @foreach (var m in _debt.TechMetrics)
            {
                <div class="dccard" style="padding:15px">
                    <div style="font-size:11.5px; color:var(--text-2); margin-bottom:11px; height:30px">@m.Label</div>
                    <div style="display:flex; align-items:baseline; gap:6px; margin-bottom:11px">
                        <span style="font-size:24px; font-weight:600; font-family:'Geist Mono',monospace; letter-spacing:-.5px; color:@Viz.ToneVar(m.Tone)">@m.Value</span>
                        <span style="font-size:12px; color:var(--text-3); font-family:'Geist Mono',monospace">@m.Unit</span>
                    </div>
                    <div style="height:5px; border-radius:99px; background:var(--card-2); overflow:hidden">
                        <div class="dcbar" data-pct="@m.Percent" style="background:@Viz.ToneVar(m.Tone)"></div>
                    </div>
                </div>
            }
        </div>

        <!-- staleness -->
        <div class="dccard" style="margin-top:14px; padding:16px 18px; display:flex; align-items:center; gap:16px">
            <div style="width:34px; height:34px; border-radius:8px; background:var(--warn-bg); display:flex; align-items:center; justify-content:center; flex:none">
                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--warn)" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
            </div>
            <div style="flex:1">
                <div style="font-size:13px; font-weight:600">Context staleness</div>
                <div style="font-size:12px; color:var(--text-2); margin-top:2px">@_debt.StaleContextCount project(s) have context older than their last graph build — graph and rationale may be out of date.</div>
            </div>
        </div>
    }
</div>

@code {
    private RootDebtView? _debt;

    protected override async Task OnInitializedAsync()
    {
        Ui.Set("Debt & Trust", "technical + agentic debt across the root");
        _debt = await Svc.GetRootDebtAsync();
    }
}
