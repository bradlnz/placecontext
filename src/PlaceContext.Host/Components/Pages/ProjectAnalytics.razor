@using PlaceContext.Application.Access
@using PlaceContext.Application.ProjectData
@page "/project/{ProjectId:guid}/analytics"
@attribute [Authorize(Policy = Permission.DataRead)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@inject ProjectAnalyticsViewModel Vm



@using PlaceContext.Application.Features
@using PlaceContext.Application.Tenancy

<PageTitle>PlaceContext — Analytics</PageTitle>

<div class="page analytics-page" data-tv-page>

    <div class="analytics-navigation"><DataTabs ProjectId="ProjectId" Active="@DataSection.Analytics" /></div>

    <div class="page-head">
        <div>
            <h2 class="page-title">Analytics</h2>
            <span class="page-sub analytics-description">Charts query your project data automatically every 10 seconds. Pause updates to inspect a result.</span>
        </div>
        <div class="live-controls">
            <span class="tv-status @(Vm.LiveEnabled ? "is-live" : "is-paused")" role="status"><span aria-hidden="true"></span>@(Vm.LiveEnabled ? "Live · refreshes every 10s" : "Live refresh paused")</span>
            <button type="button" class="dcbtn tv-enter" data-tv-enter title="Present charts in full screen"><AppIcon Kind="fullscreen" /> TV mode</button>
            <button type="button" class="dcbtn tv-exit" data-tv-exit title="Exit TV mode (Esc)"><AppIcon Kind="close" /> Exit TV mode</button>
            <label><input type="checkbox" @bind="Vm.LiveEnabled" /> Live · 10s</label>
            <button class="dcbtn" disabled="@Vm.Refreshing" @onclick="Vm.ReloadAsync">
                <AppIcon Kind="refresh" /> @(Vm.Refreshing ? "Updating…" : "Refresh now")
            </button>
        </div>
    </div>
    @if (Vm.Error is not null)
    {
        <div class="error-msg">@Vm.Error</div>
    }

    @* ── Charts: user-defined queries → charts (isolated to this project's schema/role) ── *@
    <div class="section-head">
        <span class="section-title">Charts</span>
        <button class="dcbtn btn-sql" @onclick="Vm.ToggleSqlEditor">＋ SQL chart</button>
    </div>

    @if (Vm.ShowSqlEditor)
    {
        <div class="dccard sql-editor">
            <input class="dcinput sql-name-input" placeholder="chart name (e.g. sales per city)" @bind="Vm.SqlName" />
            @if (Vm.SqlMonaco)
            {
                <div id="@ProjectAnalyticsViewModel.SqlEditorId" class="sql-monaco"></div>
            }
            else
            {
                <textarea @bind="Vm.SqlQuery" rows="4" spellcheck="false"
                          placeholder="SELECT city, avg(price) FROM listings GROUP BY city ORDER BY 2 DESC"
                          class="sql-textarea"></textarea>
            }
            <div class="sql-actions">
                <select class="dcinput sql-type-select" @bind="Vm.SqlType">
                    <option value="bar">bar</option>
                    <option value="line">line</option>
                    <option value="pie">pie</option>
                </select>
                <button class="dcbtn primary btn-run-save" disabled="@Vm.SqlBusy" @onclick="Vm.SaveSqlAsync">
                    <AppIcon Kind="play" /> @(Vm.SqlBusy ? "Running…" : "Run & save")
                </button>
                <span class="dchint hint-flush">
                    First text column = labels, numeric columns = series. The query runs as this project's own
                    database role — it cannot see any other project's data.
                </span>
                @if (Vm.SqlError is not null)
                {
                    <span class="error-inline">@Vm.SqlError</span>
                }
            </div>
        </div>
    }

    @if (Vm.SqlCharts() is { Count: > 0 } sqlCharts)
    {
        <div class="sql-chart-grid">
            @foreach (var chart in sqlCharts)
            {
                <div class="dccard chart-card" @key="chart.TableName">
                    <div class="chart-card-head">
                        <span class="chart-name">@chart.TableName["sql:".Length..]</span>
                        <span class="sql-badge">@(chart.IsLive ? "Live" : "Snapshot")</span>
                        <span class="type-switch">
                            @foreach (var t in new[] { "bar", "line", "pie" })
                            {
                                <button class="dcbtn btn-type" style="@(Vm.ChartTypeStyle(chart, t))"
                                        disabled="@(Vm.SqlBusy || ProjectAnalyticsViewModel.StoredSql(chart) is null)" title="Switch to @t" @onclick="@(() => Vm.SwitchTypeAsync(chart, t))">@t</button>
                            }
                        </span>
                        <span class="spacer"></span>
                        <span class="chart-time">Updated @Vm.Presentation.DateTime(chart.GeneratedAt)</span>
                        <button class="dcbtn btn-sm" disabled="@Vm.Refreshing" @onclick="@(() => Vm.RefreshSqlAsync(chart))"><AppIcon Kind="refresh" /> refresh</button>
                        <button class="dcbtn btn-sm" @onclick="@(() => Vm.EditSql(chart))">edit</button>
                        <button aria-label="Remove" class="dcbtn btn-sm" @onclick="@(() => Vm.DeleteSqlAsync(chart))"><AppIcon Kind="close" /></button>
                    </div>
                    @if (chart.Error is not null)
                    {
                        <p class="error-msg" role="status">@chart.Error Last saved result is shown below.</p>
                    }
                    <div class="chart-canvas-box">
                        <div class="pc-chart" id="@ProjectAnalyticsViewModel.CanvasId(chart.TableName)"></div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="section-head">
        <div><span class="section-title">Table previews</span><p class="page-sub">Sampled rows, not totals. Use a SQL chart to aggregate the full dataset.</p></div>
        <button class="dcbtn" disabled="@Vm.SweepPending" @onclick="Vm.GenerateAll">
            @(Vm.SweepPending ? "Preparing…" : "Create table previews")
        </button>
    </div>

    @if (Vm.Tables is null)
    {
        <div class="skeleton-wrap"><Skeleton Kind="card-grid" Cards="4" /></div>
    }
    else if (Vm.Tables is { Count: 0 })
    {
        <div class="dccard empty-card">
            No tables yet — create some on the <a href="@($"/project/{Vm.ProjectId}/data")" class="link-accent">Data</a>
            tab and charts will be drawn over them here.
        </div>
    }

    <div class="table-chart-grid">
        @foreach (var table in Vm.Tables ?? Array.Empty<ProjectTableInfo>())
        {
            var chart = Vm.ChartFor(table.Name);
            var pending = Vm.IsPending(table.Name);
            <div class="dccard chart-card">
                <div class="chart-card-head">
                    <span class="chart-name">@table.Name</span>
                    <span class="chart-time">~@table.RowEstimate rows</span>
                    <span class="spacer"></span>
                    @if (pending)
                    {
                        <span class="status-drawing">drawing…</span>
                    }
                    else if (chart is not null)
                    {
                        <span class="chart-time">Updated @Vm.Presentation.DateTime(chart.GeneratedAt)</span>
                    }
                    <button class="dcbtn btn-sm" disabled="@pending"
                            @onclick="@(() => Vm.ToggleRedraw(table.Name))">
                        <AppIcon Kind="@(chart is null ? "play" : "refresh")" /> @(chart is null ? "Draw" : "Redraw")
                    </button>
                </div>

                @if (Vm.RedrawFor == table.Name)
                {
                    <div class="redraw-row">
                        <input @bind="Vm.Instruction" @bind:event="oninput"
                               placeholder="what should this chart show? (optional — e.g. totals per day)"
                               class="redraw-input" />
                        <button class="dcbtn primary btn-go" @onclick="@(() => Vm.RedrawAsync(table.Name))">Go</button>
                        <button aria-label="Close" class="dcbtn btn-cancel" @onclick="@(() => Vm.CancelRedraw())"><AppIcon Kind="close" /></button>
                    </div>
                }

                @if (chart is not null)
                {
                    @if (chart.Error is not null)
                    {
                        <p class="error-msg" role="status">@chart.Error</p>
                    }
                    @if (ProjectAnalyticsViewModel.IsSpec(chart))
                    {
                        @* Chart spec — rendered by pcchart.js with the validated palette + theme tokens. *@
                        <div class="chart-canvas-box">
                            <div class="pc-chart" id="@ProjectAnalyticsViewModel.CanvasId(table.Name)"></div>
                        </div>
                    }
                    else
                    {
                        @* Legacy LLM-drawn HTML chart (older rows keep rendering until redrawn). *@
                        <iframe srcdoc="@chart.Html" sandbox="" loading="lazy"
                                class="chart-iframe"></iframe>
                    }
                }
                else
                {
                    <div class="chart-empty">
                        @(pending ? "Preparing a preview from the table data" : "no chart yet — hit draw")
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        Vm.Attach(() => InvokeAsync(StateHasChanged));
        Vm.ResetChartCache();
        await Vm.LoadAsync(ProjectId);
    }

    private readonly CancellationTokenSource _refreshCancellation = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _ = RefreshLoopAsync(_refreshCancellation.Token);
        }
        await Vm.RenderAsync();
    }

    private async Task RefreshLoopAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await InvokeAsync(async () =>
                {
                    if (Vm.LiveEnabled || Vm.SweepPending)
                    {
                        await Vm.ReloadAsync();
                    }
                });
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }

    public void Dispose()
    {
        _refreshCancellation.Cancel();
        _refreshCancellation.Dispose();
        Vm.Dispose();
    }
}
