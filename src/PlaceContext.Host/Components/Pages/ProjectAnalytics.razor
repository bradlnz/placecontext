@page "/project/{ProjectId:guid}/analytics"
@attribute [Authorize(Policy = Permission.DataRead)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@inject ProjectAnalyticsViewModel Vm



@using PlaceContext.Application.Features
@using PlaceContext.Application.Ports
@using PlaceContext.Infrastructure.Tenancy

<PageTitle>PlaceContext — Analytics</PageTitle>

<div class="page">

    <DataTabs ProjectId="ProjectId" Active="@DataSection.Analytics" />

    <div class="page-head">
        <div>
            <h2 class="page-title">Analytics</h2>
            <span class="page-sub">SQL-defined charts plus one auto chart per table — every query runs isolated inside this project's own database</span>
        </div>
        <button class="dcbtn primary" disabled="@Vm.SweepPending" @onclick="Vm.GenerateAll">
            @(Vm.SweepPending ? "Generating…" : "↻ Generate all")
        </button>
    </div>
    @if (Vm.Error is not null)
    {
        <div class="error-msg">@Vm.Error</div>
    }

    @* ── Charts: user-defined queries → charts (isolated to this project's schema/role) ── *@
    <div class="section-head">
        <span class="section-title">Charts</span>
        <button class="dcbtn btn-sql" @onclick="Vm.ToggleSqlEditor">＋ SQL chart</button>
    </div>

    @if (Vm.ShowSqlEditor)
    {
        <div class="dccard sql-editor">
            <input class="dcinput sql-name-input" placeholder="chart name (e.g. sales per city)" @bind="Vm.SqlName" />
            @if (Vm.SqlMonaco)
            {
                <div id="@ProjectAnalyticsViewModel.SqlEditorId" class="sql-monaco"></div>
            }
            else
            {
                <textarea @bind="Vm.SqlQuery" rows="4" spellcheck="false"
                          placeholder="SELECT city, avg(price) FROM listings GROUP BY city ORDER BY 2 DESC"
                          class="sql-textarea"></textarea>
            }
            <div class="sql-actions">
                <select class="dcinput sql-type-select" @bind="Vm.SqlType">
                    <option value="bar">bar</option>
                    <option value="line">line</option>
                    <option value="pie">pie</option>
                </select>
                <button class="dcbtn primary btn-run-save" disabled="@Vm.SqlBusy" @onclick="Vm.SaveSqlAsync">
                    @(Vm.SqlBusy ? "Running…" : "▶ Run & save")
                </button>
                <span class="dchint hint-flush">
                    First text column = labels, numeric columns = series. The query runs as this project's own
                    database role — it cannot see any other project's data.
                </span>
                @if (Vm.SqlError is not null)
                {
                    <span class="error-inline">@Vm.SqlError</span>
                }
            </div>
        </div>
    }

    @if (Vm.SqlCharts() is { Count: > 0 } sqlCharts)
    {
        <div class="sql-chart-grid">
            @foreach (var chart in sqlCharts)
            {
                <div class="dccard chart-card">
                    <div class="chart-card-head">
                        <span class="chart-name">@chart.TableName["sql:".Length..]</span>
                        <span class="sql-badge">SQL</span>
                        <span class="type-switch">
                            @foreach (var t in new[] { "bar", "line", "pie" })
                            {
                                <button class="dcbtn btn-type" style="@(Vm.ChartTypeStyle(chart, t))"
                                        title="Switch to @t" @onclick="@(() => Vm.SwitchTypeAsync(chart, t))">@t</button>
                            }
                        </span>
                        <span class="spacer"></span>
                        <span class="chart-time">@Vm.Presentation.DateTime(chart.GeneratedAt)</span>
                        <button class="dcbtn btn-sm" @onclick="@(() => Vm.RefreshSqlAsync(chart))">↻ refresh</button>
                        <button class="dcbtn btn-sm" @onclick="@(() => Vm.EditSql(chart))">edit</button>
                        <button class="dcbtn btn-sm-danger" @onclick="@(() => Vm.DeleteSqlAsync(chart))">✕</button>
                    </div>
                    <div class="chart-canvas-box">
                        <canvas id="@ProjectAnalyticsViewModel.CanvasId(chart.TableName)"></canvas>
                    </div>
                </div>
            }
        </div>
    }

    <div class="subsection-title">Table charts</div>

    @if (Vm.Tables is null)
    {
        <div class="skeleton-wrap"><Skeleton Kind="card-grid" Cards="4" /></div>
    }
    else if (Vm.Tables is { Count: 0 })
    {
        <div class="dccard empty-card">
            No tables yet — create some on the <a href="@($"/project/{Vm.ProjectId}/data")" class="link-accent">Data</a>
            tab and charts will be drawn over them here.
        </div>
    }

    <div class="table-chart-grid">
        @foreach (var table in Vm.Tables ?? Array.Empty<ProjectTableInfo>())
        {
            var chart = Vm.ChartFor(table.Name);
            var pending = Vm.IsPending(table.Name);
            <div class="dccard chart-card">
                <div class="chart-card-head">
                    <span class="chart-name">@table.Name</span>
                    <span class="chart-time">~@table.RowEstimate rows</span>
                    <span class="spacer"></span>
                    @if (pending)
                    {
                        <span class="status-drawing">drawing…</span>
                    }
                    else if (chart is not null)
                    {
                        <span class="chart-time">@Vm.Presentation.DateTime(chart.GeneratedAt)</span>
                    }
                    <button class="dcbtn btn-sm" disabled="@pending"
                            @onclick="@(() => Vm.ToggleRedraw(table.Name))">
                        @(chart is null ? "▶ draw" : "↻ redraw")
                    </button>
                </div>

                @if (Vm.RedrawFor == table.Name)
                {
                    <div class="redraw-row">
                        <input @bind="Vm.Instruction" @bind:event="oninput"
                               placeholder="what should this chart show? (optional — e.g. totals per day)"
                               class="redraw-input" />
                        <button class="dcbtn primary btn-go" @onclick="@(() => Vm.RedrawAsync(table.Name))">Go</button>
                        <button class="dcbtn btn-cancel" @onclick="@(() => Vm.CancelRedraw())">✕</button>
                    </div>
                }

                @if (chart is not null)
                {
                    @if (ProjectAnalyticsViewModel.IsSpec(chart))
                    {
                        @* Chart.js spec — rendered by pcchart.js with the validated palette + theme tokens. *@
                        <div class="chart-canvas-box">
                            <canvas id="@ProjectAnalyticsViewModel.CanvasId(table.Name)"></canvas>
                        </div>
                    }
                    else
                    {
                        @* Legacy LLM-drawn HTML chart (pre-Chart.js rows keep rendering until redrawn). *@
                        <iframe srcdoc="@chart.Html" sandbox="" loading="lazy"
                                class="chart-iframe"></iframe>
                    }
                }
                else
                {
                    <div class="chart-empty">
                        @(pending ? "the local LLM is drawing this chart — it appears here when done" : "no chart yet — hit draw")
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        Vm.Attach(() => InvokeAsync(StateHasChanged));
        Vm.ResetChartCache();
        await Vm.LoadAsync(ProjectId);
    }

    protected override Task OnAfterRenderAsync(bool firstRender) => Vm.RenderAsync();

    public void Dispose() => Vm.Dispose();
}
