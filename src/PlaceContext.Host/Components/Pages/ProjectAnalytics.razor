@page "/project/{ProjectId:guid}/analytics"
@implements IDisposable
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject IJSRuntime JS
@inject PlaceContext.Infrastructure.Scheduling.AnalyticsRefreshQueue Queue
@using PlaceContext.Application.Features
@using PlaceContext.Application.Ports
@using PlaceContext.Infrastructure.Tenancy

<PageTitle>PlaceContext — Analytics</PageTitle>

<div style="padding:20px 24px 40px; max-width:1320px; margin:0 auto">

    <ProjectTabs ProjectId="ProjectId" Active="analytics" />

    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px">
        <div>
            <h2 style="font-size:18px; font-weight:600; margin:0">Analytics</h2>
            <span style="font-size:11.5px; color:var(--text-3)">one chart per table, drawn by the local LLM in the background — redraw any of them with your own instruction</span>
        </div>
        <button class="dcbtn primary" disabled="@_sweepPending" @onclick="GenerateAllAsync">
            @(_sweepPending ? "Generating…" : "↻ Generate all")
        </button>
    </div>
    @if (_error is not null)
    {
        <div style="font-size:12px; color:var(--bad); margin-top:8px">@_error</div>
    }

    @if (_tables is { Count: 0 })
    {
        <div class="dccard" style="padding:18px; margin-top:14px; font-size:12.5px; color:var(--text-3); line-height:1.6">
            No tables yet — create some on the <a href="@($"/project/{ProjectId}/data")" style="color:var(--accent)">Data</a>
            tab and charts will be drawn over them here.
        </div>
    }

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(480px, 1fr)); gap:14px; margin-top:14px">
        @foreach (var table in _tables ?? Array.Empty<ProjectTableInfo>())
        {
            var chart = ChartFor(table.Name);
            var pending = Queue.IsPending(ProjectId, table.Name);
            <div class="dccard" style="padding:12px 16px">
                <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px">
                    <span style="font-size:12.5px; font-weight:600; font-family:'Geist Mono',monospace">@table.Name</span>
                    <span style="font-size:10.5px; color:var(--text-3)">~@table.RowEstimate rows</span>
                    <span style="flex:1"></span>
                    @if (pending)
                    {
                        <span style="font-size:11px; color:var(--warn)">drawing…</span>
                    }
                    else if (chart is not null)
                    {
                        <span style="font-size:10.5px; color:var(--text-3)">@chart.GeneratedAt.ToLocalTime().ToString("MM-dd HH:mm")</span>
                    }
                    <button class="dcbtn" style="padding:3px 10px; font-size:11px" disabled="@pending"
                            @onclick="@(() => ToggleRedraw(table.Name))">
                        @(chart is null ? "▶ draw" : "↻ redraw")
                    </button>
                </div>

                @if (_redrawFor == table.Name)
                {
                    <div style="display:flex; gap:8px; margin-bottom:8px">
                        <input @bind="_instruction" @bind:event="oninput"
                               placeholder="what should this chart show? (optional — e.g. totals per day)"
                               style="flex:1; padding:6px 10px; background:var(--bg); border:1px solid var(--border); border-radius:7px; color:var(--text); font-size:12px" />
                        <button class="dcbtn primary" style="padding:4px 12px; font-size:11.5px" @onclick="@(() => RedrawAsync(table.Name))">Go</button>
                        <button class="dcbtn" style="padding:4px 10px; font-size:11.5px" @onclick="@(() => _redrawFor = null)">✕</button>
                    </div>
                }

                @if (chart is not null)
                {
                    @if (IsSpec(chart))
                    {
                        @* Chart.js spec — rendered by pcchart.js with the validated palette + theme tokens. *@
                        <div style="height:340px; padding:14px 10px 10px; border:1px solid var(--border); border-radius:8px; background:var(--card)">
                            <canvas id="@CanvasId(table.Name)"></canvas>
                        </div>
                    }
                    else
                    {
                        @* Legacy LLM-drawn HTML chart (pre-Chart.js rows keep rendering until redrawn). *@
                        <iframe srcdoc="@chart.Html" sandbox="" loading="lazy"
                                style="width:100%; height:340px; border:1px solid var(--border); border-radius:8px; background:var(--card)"></iframe>
                    }
                }
                else
                {
                    <div style="height:120px; display:flex; align-items:center; justify-content:center; border:1px dashed var(--border); border-radius:8px; font-size:12px; color:var(--text-3)">
                        @(pending ? "the local LLM is drawing this chart — it appears here when done" : "no chart yet — hit draw")
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private IReadOnlyList<ProjectTableInfo>? _tables;
    private IReadOnlyList<ProjectChartView> _charts = Array.Empty<ProjectChartView>();
    private string? _error, _redrawFor, _instruction;
    private bool _sweepPending;
    private System.Threading.Timer? _poll;

    private ProjectChartView? ChartFor(string table)
        => _charts.FirstOrDefault(c => string.Equals(c.TableName, table, StringComparison.OrdinalIgnoreCase));

    // A stored spec is JSON ('{…}'); anything else is a legacy LLM-drawn HTML document.
    private static bool IsSpec(ProjectChartView chart) => chart.Html.TrimStart().StartsWith('{');

    // Stable, DOM-safe canvas id per table (names can hold chars invalid in element ids).
    private static string CanvasId(string table)
        => "pcchart-" + Convert.ToHexString(System.Security.Cryptography.MD5.HashData(
               System.Text.Encoding.UTF8.GetBytes(table)))[..12];

    // Track what each canvas last rendered so poll-driven re-renders only redraw changed charts.
    private readonly Dictionary<string, DateTimeOffset> _rendered = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        foreach (var chart in _charts.Where(IsSpec))
        {
            var id = CanvasId(chart.TableName);
            if (_rendered.TryGetValue(id, out var at) && at == chart.GeneratedAt) continue;
            try
            {
                await JS.InvokeVoidAsync("pcchart.render", id, chart.Html);
                _rendered[id] = chart.GeneratedAt;
            }
            catch (JSException) { /* canvas not on screen yet — the next render pass retries */ }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        Ui.Set("Analytics", "charts over the project's data");
        await LoadAsync();
        // Charts land table-by-table while the worker runs — poll so they appear without a reload.
        _poll ??= new System.Threading.Timer(_ => _ = InvokeAsync(PollAsync), null,
            TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadAsync()
    {
        _sweepPending = Queue.IsPending(ProjectId);
        try
        {
            _tables = await Svc.ListProjectDataTablesAsync(ProjectId);
            _charts = await Svc.ListProjectChartsAsync(ProjectId);
            _error = null;
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task PollAsync()
    {
        var wasPending = _sweepPending;
        _sweepPending = Queue.IsPending(ProjectId);
        if (_sweepPending || wasPending)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private Task GenerateAllAsync()
    {
        var tenant = CurrentTenant.Current;
        if (tenant is null) { _error = "No tenant resolved — sign in again."; return Task.CompletedTask; }
        Queue.TryEnqueue(tenant, ProjectId);
        _sweepPending = true;
        return Task.CompletedTask;
    }

    private void ToggleRedraw(string table)
    {
        if (_redrawFor == table) { _redrawFor = null; return; }
        _redrawFor = table;
        _instruction = null;
    }

    private Task RedrawAsync(string table)
    {
        var tenant = CurrentTenant.Current;
        if (tenant is null) { _error = "No tenant resolved — sign in again."; return Task.CompletedTask; }
        Queue.TryEnqueue(tenant, ProjectId, tableName: table, instruction: _instruction);
        _redrawFor = null;
        _instruction = null;
        return Task.CompletedTask;
    }

    public void Dispose() => _poll?.Dispose();
}
