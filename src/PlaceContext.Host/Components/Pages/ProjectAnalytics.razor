@page "/project/{ProjectId:guid}/analytics"
@implements IDisposable
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject NavigationManager Nav
@inject PlaceContext.Infrastructure.Scheduling.AnalyticsRefreshQueue Queue
@using PlaceContext.Application.Features
@using PlaceContext.Infrastructure.Tenancy

<PageTitle>PlaceContext — Analytics</PageTitle>

<div style="padding:20px 24px 40px; max-width:1100px; margin:0 auto">

    <ProjectTabs ProjectId="ProjectId" Active="analytics" />

    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px">
        <div>
            <h2 style="font-size:18px; font-weight:600; margin:0">Analytics</h2>
            <span style="font-size:11.5px; color:var(--text-3)">charts drawn over this project's data by the local LLM, generated in the background</span>
        </div>
        <div style="display:flex; align-items:center; gap:10px">
            @if (_pending)
            {
                <span style="font-size:11.5px; color:var(--warn)">generating… charts appear below as they finish</span>
            }
            else if (_charts is { Count: > 0 })
            {
                <span style="font-size:11px; color:var(--text-3)">last generated @_charts.Max(c => c.GeneratedAt).ToLocalTime().ToString("HH:mm")</span>
            }
            <button class="dcbtn primary" disabled="@_pending" @onclick="RefreshChartsAsync">
                @(_pending ? "Generating…" : (_charts is { Count: > 0 } ? "↻ Regenerate charts" : "▶ Generate charts"))
            </button>
        </div>
    </div>
    @if (_error is not null)
    {
        <div style="font-size:12px; color:var(--bad); margin-top:8px">@_error</div>
    }

    @if (_charts is { Count: 0 } && !_pending)
    {
        <div style="font-size:12.5px; color:var(--text-3); margin-top:20px">
            No charts yet. Click <b>Generate charts</b> and the platform will read every table on the
            <a href="@($"/project/{ProjectId}/data")" style="color:var(--accent)">Data</a> tab and draw one chart per
            table in the background — local-LLM inference takes a few minutes per table.
        </div>
    }

    @* Sandboxed srcdoc iframes: the generated document renders but can never run script or reach
       the app — same posture as job chart artifacts. *@
    @foreach (var chart in _charts ?? Array.Empty<ProjectChartView>())
    {
        <div class="dccard" style="padding:12px 16px; margin-top:14px">
            <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px">
                <span style="font-size:12.5px; font-weight:600; font-family:'Geist Mono',monospace">@chart.TableName</span>
                <span style="flex:1"></span>
                <span style="font-size:10.5px; color:var(--text-3)">generated @chart.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
            </div>
            <iframe srcdoc="@chart.Html" sandbox="" loading="lazy"
                    style="width:100%; height:380px; border:1px solid var(--border); border-radius:8px; background:var(--card)"></iframe>
        </div>
    }
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private IReadOnlyList<ProjectChartView>? _charts;
    private string? _error;
    private bool _pending;
    private System.Threading.Timer? _poll;

    protected override async Task OnParametersSetAsync()
    {
        Ui.Set("Analytics", "charts over the project's data");
        await LoadAsync();
        // While a sweep is queued/running, poll so finished charts appear without a manual reload.
        _poll ??= new System.Threading.Timer(_ => _ = InvokeAsync(PollAsync), null,
            TimeSpan.FromSeconds(5), TimeSpan.FromSeconds(5));
    }

    private async Task LoadAsync()
    {
        _pending = Queue.IsPending(ProjectId);
        try { _charts = await Svc.ListProjectChartsAsync(ProjectId); }
        catch (Exception ex) { _error = ex.Message; }
    }

    private async Task PollAsync()
    {
        var wasPending = _pending;
        _pending = Queue.IsPending(ProjectId);
        if (_pending || wasPending)
        {
            await LoadAsync();
            StateHasChanged();
        }
    }

    private Task RefreshChartsAsync()
    {
        _error = null;
        var tenant = CurrentTenant.Current;
        if (tenant is null) { _error = "No tenant resolved — sign in again."; return Task.CompletedTask; }
        Queue.TryEnqueue(tenant, ProjectId);
        _pending = true;
        return Task.CompletedTask;
    }

    public void Dispose() => _poll?.Dispose();
}
