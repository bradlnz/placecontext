@page "/project/{ProjectId:guid}/jobs/{JobId:guid}"
@attribute [Authorize(Policy = Permission.JobsEdit)]
@using PlaceContext.Host.Components.ViewModels
@inject JobEditorViewModel Vm

<PageTitle>PlaceContext — @(Vm.Job?.Name ?? "Job editor")</PageTitle>

@if (Vm.Loading)
{
    <Skeleton Kind="detail" Rows="8" Padded />
}
else if (Vm.Job is null)
{
    <div class="notice">Job not found. <a href="/project/@ProjectId/jobs">Back to jobs</a></div>
}
else if (!Vm.IsCodeMap)
{
    <div class="notice">
        This job runs a container image (<code>@Vm.Job.MapImage</code>), not inline code — there is nothing to edit here.
        <a href="/project/@ProjectId/jobs">Back to jobs</a>
    </div>
}
else
{
    <div class="page">
    @* ── Toolbar ─────────────────────────────────────────────────────────────────────────── *@
    <div class="toolbar">
        <button class="dcbtn toolbar-back" @onclick="Vm.NavigateBack">←</button>
        <span class="job-name">@Vm.Job.Name</span>
        <span class="runtime-badge">@Vm.RuntimeId</span>
        @if (Vm.MonacoLite)
        {
            <span class="editor-warn"
                  title="The Monaco editor's CDN was unreachable — editing still works in a plain editor.">
                basic editor (CDN unreachable)
            </span>
        }
        <span class="flex-spacer"></span>
        @if (Vm.Message is not null)
        {
            <span class="text-12-3">@Vm.Message</span>
        }
        <button class="dcbtn" disabled="@Vm.Busy" @onclick="Vm.RunAsync">
            @(Vm.Running ? "Testing…" : "▶ Test")
        </button>
        <button class="dcbtn primary" disabled="@Vm.Busy" @onclick="Vm.DeployAsync">
            @(Vm.Saving ? "Deploying…" : "Deploy")
        </button>
    </div>

    <div class="workspace">

        @* ── File tree ───────────────────────────────────────────────────────────────────── *@
        <div class="file-tree">
            <div class="file-tree-head">
                <span>Files</span>
                <button class="dcbtn add-file-btn" @onclick="Vm.StartAddFile" title="Add file">+</button>
            </div>

            @if (Vm.AddingFile)
            {
                <div class="add-file-row">
                    <input class="dcinput add-file-input" placeholder="path/name.js"
                           @bind="Vm.NewFileName" @bind:event="oninput" @onkeydown="Vm.AddFileKey" @ref="Vm.NewFileInput" />
                    <button class="dcbtn add-file-confirm" @onclick="Vm.ConfirmAddFile">✓</button>
                </div>
            }

            <div class="file-list">
                @for (var i = 0; i < Vm.Files.Count; i++)
                {
                    var idx = i;
                    var file = Vm.Files[idx];
                    var isActive = idx == Vm.ActiveIndex;
                    var isEntry = file.Path == Vm.Entrypoint;
                    <div class="dcfile file-row @(isActive ? "active" : "")"
                         style="@(isActive ? "background:var(--card-2); color:var(--text-1)" : "color:var(--text-2)")"
                         @onclick="@(() => Vm.SwitchFileAsync(idx))">
                        @if (idx == Vm.RenamingIndex)
                        {
                            <input class="dcinput rename-input"
                                   @bind="Vm.RenameValue" @bind:event="oninput" @onkeydown="Vm.RenameKey"
                                   @onclick:stopPropagation="true" @ref="Vm.RenameInput" />
                            <button class="dcfile-act file-act-confirm" title="Confirm rename"
                                    @onclick:stopPropagation="true" @onclick="Vm.ConfirmRenameAsync">✓</button>
                        }
                        else
                        {
                            <span class="file-name" title="@file.Path">@file.Path</span>
                            <button class="dcfile-act file-act" title="Rename file"
                                    @onclick:stopPropagation="true" @onclick="@(() => Vm.StartRenameAsync(idx))">✎</button>
                        }
                        @if (isEntry)
                        {
                            <span title="Entry point" class="entry-star">★</span>
                        }
                        else
                        {
                            <button class="dcfile-act file-act" title="Set as entry point"
                                    @onclick:stopPropagation="true" @onclick="@(() => Vm.SetEntry(file.Path))">☆</button>
                        }
                        @if (Vm.Files.Count > 1)
                        {
                            <button class="dcfile-act file-act-del" title="Delete file"
                                    @onclick:stopPropagation="true" @onclick="@(() => Vm.DeleteFileAsync(idx))">×</button>
                        }
                    </div>
                }
            </div>

            <div class="entry-foot">
                Entry: <code class="entry-code">@(Vm.Entrypoint ?? "(runtime default)")</code>
            </div>
        </div>

        @* ── Editor + results ────────────────────────────────────────────────────────────── *@
        <div class="editor-pane">
            <div id="@Vm.EditorId" class="editor-host"></div>

            @* Results panel *@
            <div class="results-panel" style="height:@(Vm.PanelOpen ? "240px" : "34px")">
                <div class="results-bar" @onclick="Vm.TogglePanel">
                    <span class="section-label">Execution results</span>
                    @if (Vm.LastRun is not null)
                    {
                        <span class="status-badge" style="color:@Vm.StatusTextColor(Vm.LastRun.Status); background:@Vm.StatusTextBackground(Vm.LastRun.Status)">@Vm.StatusLabelText(Vm.LastRun.Status)</span>
                    }
                    <span class="flex-spacer"></span>
                    <span class="text-12-3">@(Vm.PanelOpen ? "▾" : "▴")</span>
                </div>

                @if (Vm.PanelOpen)
                {
                    <div class="results-body">
                        @if (Vm.LastRun is null)
                        {
                            <div class="text-12-3">Click <strong>Test</strong> to deploy and run this job. Shard artifacts and logs appear here.</div>
                        }
                        else
                        {
                            @foreach (var shard in Vm.LastRun.ShardResults)
                            {
                                <div class="shard">
                                    <div class="shard-head">
                                        <span>Shard @shard.Index</span>
                                        <span class="shard-badge" style="color:@Vm.StatusTextColor(shard.Outcome); background:@Vm.StatusTextBackground(shard.Outcome)">@Vm.StatusLabelText(shard.Outcome)</span>
                                        <span class="shard-exit">exit @shard.ExitCode</span>
                                    </div>
                                    @if (shard.Artifact is not null)
                                    {
                                        <pre class="shard-artifact">@Vm.JsonText(shard.Artifact)</pre>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(shard.Log))
                                    {
                                        <details class="shard-log-details">
                                            <summary class="shard-log-summary">Log</summary>
                                            <pre class="shard-log">@shard.Log</pre>
                                        </details>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid JobId { get; set; }

    protected override void OnInitialized() =>
        Vm.Attach(() => InvokeAsync(StateHasChanged));

    protected override Task OnParametersSetAsync()
    {
        Vm.Initialize(ProjectId, JobId);
        return Task.CompletedTask;
    }

    protected override Task OnAfterRenderAsync(bool firstRender) => Vm.AfterRenderAsync();

    public void Dispose()
    {
        Vm.Detach();
    }
}
