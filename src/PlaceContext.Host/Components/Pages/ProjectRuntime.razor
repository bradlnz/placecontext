@page "/project/{ProjectId:guid}/runtime"
@implements IDisposable
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject PlaceContext.Application.Ports.IContainerRuntime Runtime
@inject PlaceContext.Infrastructure.Operations.OperationCenter OpCenter
@inject PlaceContext.Infrastructure.Tenancy.ITenantStore Tenants
@using PlaceContext.Application.Features
@using PlaceContext.Application.Ports
@using PlaceContext.Infrastructure.Tenancy
@using Microsoft.Extensions.DependencyInjection

<PageTitle>PlaceContext — Runtime</PageTitle>

<div style="padding:20px 24px 40px; max-width:1100px; margin:0 auto">

    <ProjectTabs ProjectId="ProjectId" Active="runtime" />

    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px">
        <div>
            <h2 style="font-size:18px; font-weight:600; margin:0">Runtime</h2>
            <span style="font-size:11.5px; color:var(--text-3)">this project's application containers (Docker-in-Docker)</span>
        </div>
        <div style="display:flex; gap:8px">
            @if (Runtime.IsEnabled)
            {
                <button class="dcbtn primary" @onclick="StartDeploy">+ Deploy app</button>
            }
            <button class="dcbtn" @onclick="ReloadAsync" title="Refresh">↻ Refresh</button>
        </div>
    </div>
    @if (_error is not null)
    {
        <div style="font-size:12px; color:var(--bad); margin-top:8px">@_error</div>
    }

    @if (!Runtime.IsEnabled)
    {
        <div class="dccard" style="padding:18px; margin-top:14px; font-size:12.5px; color:var(--text-3); line-height:1.6">
            No application runtime is configured for this deployment.
            Set <code>PlaceContext:Runtime:DockerEndpoint</code> to the DinD daemon
            (the manifests ship one as <code>placecontext-dind</code>) and restart the Host.
        </div>
    }
    else if (_containers is { Count: 0 })
    {
        <div class="dccard" style="padding:18px; margin-top:14px; font-size:12.5px; color:var(--text-3); line-height:1.6">
            No containers for this project yet. Anything started in the runtime daemon with the label<br />
            <code>placecontext.project=@ProjectId</code> shows up here — state, ports, logs, restart/stop.
        </div>
    }
    else
    {
        @foreach (var c in _containers ?? Array.Empty<ContainerInfo>())
        {
            <div class="dccard" style="padding:12px 16px; margin-top:12px">
                <div style="display:flex; align-items:center; gap:10px">
                    <span style="font-size:11px; font-weight:600; padding:3px 8px; border-radius:5px;
                          color:@(c.State == "running" ? "var(--good)" : "var(--text-3)");
                          background:@(c.State == "running" ? "var(--good-bg)" : "var(--card-2)")">@c.State</span>
                    <span style="font-size:13px; font-weight:600; font-family:'Geist Mono',monospace">@c.Name</span>
                    <span style="font-size:11.5px; color:var(--text-3); font-family:'Geist Mono',monospace; flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis">@c.Image</span>
                    <span style="font-size:11px; color:var(--text-3)">@c.Status</span>
                    <button class="dcbtn" style="padding:3px 10px; font-size:11px" disabled="@_busy" @onclick="@(() => ToggleLogsAsync(c.Id))">
                        @(_logsFor == c.Id ? "hide logs" : "logs")
                    </button>
                    <button class="dcbtn" style="padding:3px 10px; font-size:11px" disabled="@_busy" @onclick="@(() => RestartAsync(c.Id))">restart</button>
                    @if (c.State == "running")
                    {
                        <button class="dcbtn" style="padding:3px 10px; font-size:11px; color:var(--bad)" disabled="@_busy" @onclick="@(() => StopAsync(c.Id))">stop</button>
                    }
                </div>
                @if (c.Ports.Count > 0)
                {
                    <div style="display:flex; gap:6px; margin-top:7px; flex-wrap:wrap; align-items:center">
                        @foreach (var p in c.Ports)
                        {
                            <span style="font-size:10.5px; padding:2px 7px; border-radius:4px; background:var(--bg-2); color:var(--text-3); font-family:'Geist Mono',monospace">@p</span>
                        }
                        @* Published ports are reachable through the Host's authenticated /runtime proxy. *@
                        @if (c.State == "running")
                        {
                            @foreach (var port in c.PublishedPorts)
                            {
                                <a class="dcbtn" style="padding:2px 9px; font-size:10.5px; text-decoration:none"
                                   href="@($"/runtime/{ProjectId}/{port}/")" target="_blank" rel="noopener">open :@port ↗</a>
                            }
                        }
                    </div>
                }
                @if (_logsFor == c.Id)
                {
                    <pre style="margin-top:10px; background:var(--bg); border:1px solid var(--border); border-radius:6px; padding:10px; font-size:10.5px; font-family:'Geist Mono',monospace; white-space:pre-wrap; word-break:break-all; color:var(--text-2); max-height:320px; overflow-y:auto">@(_logs ?? "(no output)")</pre>
                }
            </div>
        }
    }
</div>

@* ── Deploy wizard: onboard code into the runtime from GitHub or a Docker image ─────────── *@
@if (_deploying)
{
    <div class="dcslide-scrim" @onclick="@(() => _deploying = false)"></div>
    <div class="dcslide" style="width:520px">
        <div class="dcslide-head">
            <span style="font-size:13px; font-weight:600">Deploy an app</span>
            <button class="dcslide-x" @onclick="@(() => _deploying = false)">×</button>
        </div>
        <div style="padding:16px 18px; display:flex; flex-direction:column; gap:12px">
            <div style="display:flex; gap:8px">
                <button class="dcbtn @(_source == "image" ? "primary" : "")" style="flex:1" @onclick="@(() => _source = "image")">Docker image</button>
                <button class="dcbtn @(_source == "github" ? "primary" : "")" style="flex:1" @onclick="@(() => _source = "github")">GitHub repo</button>
            </div>

            <div>
                <label style="display:block; font-size:11px; color:var(--text-3); margin-bottom:4px">App name</label>
                <input @bind="_dName" @bind:event="oninput" placeholder="e.g. web"
                       style="width:100%; padding:7px 10px; background:var(--bg); border:1px solid var(--border); border-radius:7px; color:var(--text); font-size:12.5px; font-family:'Geist Mono',monospace" />
            </div>

            @if (_source == "image")
            {
                <div>
                    <label style="display:block; font-size:11px; color:var(--text-3); margin-bottom:4px">Image</label>
                    <input @bind="_dImage" @bind:event="oninput" placeholder="e.g. nginx:alpine or ghcr.io/acme/app:1.2"
                           style="width:100%; padding:7px 10px; background:var(--bg); border:1px solid var(--border); border-radius:7px; color:var(--text); font-size:12.5px; font-family:'Geist Mono',monospace" />
                </div>
            }
            else
            {
                <div>
                    <label style="display:block; font-size:11px; color:var(--text-3); margin-bottom:4px">Repository URL <span style="opacity:.6">(must contain a Dockerfile; private repos use your connected GitHub)</span></label>
                    <input @bind="_dRepo" @bind:event="oninput" placeholder="https://github.com/acme/app.git"
                           style="width:100%; padding:7px 10px; background:var(--bg); border:1px solid var(--border); border-radius:7px; color:var(--text); font-size:12.5px; font-family:'Geist Mono',monospace" />
                </div>
            }

            <div style="display:flex; gap:10px">
                <div style="flex:1">
                    <label style="display:block; font-size:11px; color:var(--text-3); margin-bottom:4px">App port <span style="opacity:.6">(in the container)</span></label>
                    <input @bind="_dContainerPort" placeholder="80" type="number"
                           style="width:100%; padding:7px 10px; background:var(--bg); border:1px solid var(--border); border-radius:7px; color:var(--text); font-size:12.5px" />
                </div>
                <div style="flex:1">
                    <label style="display:block; font-size:11px; color:var(--text-3); margin-bottom:4px">Publish as <span style="opacity:.6">(runtime port; defaults to app port)</span></label>
                    <input @bind="_dPublishPort" placeholder="8080" type="number"
                           style="width:100%; padding:7px 10px; background:var(--bg); border:1px solid var(--border); border-radius:7px; color:var(--text); font-size:12.5px" />
                </div>
            </div>

            <div>
                <label style="display:block; font-size:11px; color:var(--text-3); margin-bottom:4px">Environment <span style="opacity:.6">(KEY=VALUE per line, optional)</span></label>
                <textarea @bind="_dEnv" rows="3" placeholder="MODE=production"
                          style="width:100%; padding:7px 10px; background:var(--bg); border:1px solid var(--border); border-radius:7px; color:var(--text); font-size:12px; font-family:'Geist Mono',monospace; resize:vertical"></textarea>
            </div>

            @if (_dError is not null)
            {
                <div style="font-size:12px; color:var(--bad)">@_dError</div>
            }
            <div style="display:flex; gap:8px">
                <button class="dcbtn primary" @onclick="DeployAsync">🚀 Deploy</button>
                <button class="dcbtn" @onclick="@(() => _deploying = false)">Cancel</button>
            </div>
            <div style="font-size:11px; color:var(--text-3); line-height:1.5">
                The deploy runs in the background (watch the notifications bell): pull/clone+build,
                then run — labeled to this project, restarted unless stopped, replacing a previous
                deploy of the same name. Published ports get an <b>open</b> link on this tab.
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private IReadOnlyList<ContainerInfo>? _containers;
    private string? _error, _logsFor, _logs;
    private bool _busy;
    private System.Threading.Timer? _poll;

    protected override async Task OnParametersSetAsync()
    {
        Ui.Set("Runtime", "the project's application containers");
        await ReloadAsync();
        // Container state changes outside the portal too — keep the view fresh.
        _poll ??= new System.Threading.Timer(_ => _ = InvokeAsync(async () => { await ReloadAsync(); StateHasChanged(); }),
            null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task ReloadAsync()
    {
        try
        {
            _containers = await Svc.ListProjectContainersAsync(ProjectId);
            _error = null;
        }
        catch (Exception ex) { _error = Trim(ex.Message); }
    }

    private async Task ToggleLogsAsync(string containerId)
    {
        if (_logsFor == containerId) { _logsFor = null; _logs = null; return; }
        _busy = true;
        try
        {
            _logs = await Svc.GetContainerLogsAsync(ProjectId, containerId, 300);
            _logsFor = containerId;
            _error = null;
        }
        catch (Exception ex) { _error = Trim(ex.Message); }
        finally { _busy = false; }
    }

    private async Task RestartAsync(string containerId)
    {
        _busy = true;
        try { await Svc.RestartProjectContainerAsync(ProjectId, containerId); await ReloadAsync(); }
        catch (Exception ex) { _error = Trim(ex.Message); }
        finally { _busy = false; }
    }

    private async Task StopAsync(string containerId)
    {
        _busy = true;
        try { await Svc.StopProjectContainerAsync(ProjectId, containerId); await ReloadAsync(); }
        catch (Exception ex) { _error = Trim(ex.Message); }
        finally { _busy = false; }
    }

    private static string Trim(string s) => s.Length > 300 ? s[..300] + "…" : s;

    // ── Deploy wizard ─────────────────────────────────────────────────────────────────────────
    private bool _deploying;
    private string _source = "image";
    private string _dName = "", _dImage = "", _dRepo = "", _dEnv = "";
    private int? _dContainerPort, _dPublishPort;
    private string? _dError;

    private void StartDeploy()
    {
        _deploying = true;
        _dError = null;
        _source = "image";
        _dName = _dImage = _dRepo = _dEnv = "";
        _dContainerPort = _dPublishPort = null;
    }

    private async Task DeployAsync()
    {
        _dError = null;
        if (string.IsNullOrWhiteSpace(_dName)) { _dError = "Give the app a name."; return; }
        if (_source == "image" && string.IsNullOrWhiteSpace(_dImage)) { _dError = "An image reference is required."; return; }
        if (_source == "github" && string.IsNullOrWhiteSpace(_dRepo)) { _dError = "A repository URL is required."; return; }

        var tenant = CurrentTenant.Current;
        if (tenant is null) { _dError = "No tenant resolved — sign in again."; return; }

        var env = (_dEnv ?? "")
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(l => l.Contains('='))
            .Select(l => l.Split('=', 2))
            .ToDictionary(p => p[0].Trim(), p => p[1], StringComparer.Ordinal);
        var name = _dName.Trim();
        var source = _source;
        var image = _dImage.Trim();
        var repo = _dRepo.Trim();
        var cport = _dContainerPort;
        var pport = _dPublishPort;

        // Private repos ride on the tenant's connected GitHub (same token the Import page uses).
        string? token = null;
        if (source == "github")
            token = (await Tenants.GetRowAsync(tenant.Id))?.GitHubToken;

        OpCenter.Run(tenant, ProjectId,
            $"Deploy app — {name} ({(source == "image" ? image : repo)})",
            $"/project/{ProjectId}/runtime",
            async (sp, ct) =>
            {
                var svc = sp.GetRequiredService<IPlaceContextService>();
                if (source == "image")
                    await svc.DeployContainerFromImageAsync(
                        new DeployContainerFromImageCommand(ProjectId, name, image, cport, pport, env), ct);
                else
                    await svc.DeployContainerFromGitHubAsync(
                        new DeployContainerFromGitHubCommand(ProjectId, name, repo, token, tenant.Slug, cport, pport, env), ct);
                return $"{name} is running";
            });

        _deploying = false;
        _error = null;
        await ReloadAsync();
    }

    public void Dispose() => _poll?.Dispose();
}
