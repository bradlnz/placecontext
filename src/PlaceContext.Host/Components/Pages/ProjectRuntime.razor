@page "/project/{ProjectId:guid}/runtime"
@implements IDisposable
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject PlaceContext.Application.Ports.IContainerRuntime Runtime
@using PlaceContext.Application.Ports

<PageTitle>PlaceContext — Runtime</PageTitle>

<div style="padding:20px 24px 40px; max-width:1100px; margin:0 auto">

    <ProjectTabs ProjectId="ProjectId" Active="runtime" />

    <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:6px">
        <div>
            <h2 style="font-size:18px; font-weight:600; margin:0">Runtime</h2>
            <span style="font-size:11.5px; color:var(--text-3)">this project's application containers (Docker-in-Docker)</span>
        </div>
        <button class="dcbtn" @onclick="ReloadAsync" title="Refresh">↻ Refresh</button>
    </div>
    @if (_error is not null)
    {
        <div style="font-size:12px; color:var(--bad); margin-top:8px">@_error</div>
    }

    @if (!Runtime.IsEnabled)
    {
        <div class="dccard" style="padding:18px; margin-top:14px; font-size:12.5px; color:var(--text-3); line-height:1.6">
            No application runtime is configured for this deployment.
            Set <code>PlaceContext:Runtime:DockerEndpoint</code> to the DinD daemon
            (the manifests ship one as <code>placecontext-dind</code>) and restart the Host.
        </div>
    }
    else if (_containers is { Count: 0 })
    {
        <div class="dccard" style="padding:18px; margin-top:14px; font-size:12.5px; color:var(--text-3); line-height:1.6">
            No containers for this project yet. Anything started in the runtime daemon with the label<br />
            <code>placecontext.project=@ProjectId</code> shows up here — state, ports, logs, restart/stop.
        </div>
    }
    else
    {
        @foreach (var c in _containers ?? Array.Empty<ContainerInfo>())
        {
            <div class="dccard" style="padding:12px 16px; margin-top:12px">
                <div style="display:flex; align-items:center; gap:10px">
                    <span style="font-size:11px; font-weight:600; padding:3px 8px; border-radius:5px;
                          color:@(c.State == "running" ? "var(--good)" : "var(--text-3)");
                          background:@(c.State == "running" ? "var(--good-bg)" : "var(--card-2)")">@c.State</span>
                    <span style="font-size:13px; font-weight:600; font-family:'Geist Mono',monospace">@c.Name</span>
                    <span style="font-size:11.5px; color:var(--text-3); font-family:'Geist Mono',monospace; flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis">@c.Image</span>
                    <span style="font-size:11px; color:var(--text-3)">@c.Status</span>
                    <button class="dcbtn" style="padding:3px 10px; font-size:11px" disabled="@_busy" @onclick="@(() => ToggleLogsAsync(c.Id))">
                        @(_logsFor == c.Id ? "hide logs" : "logs")
                    </button>
                    <button class="dcbtn" style="padding:3px 10px; font-size:11px" disabled="@_busy" @onclick="@(() => RestartAsync(c.Id))">restart</button>
                    @if (c.State == "running")
                    {
                        <button class="dcbtn" style="padding:3px 10px; font-size:11px; color:var(--bad)" disabled="@_busy" @onclick="@(() => StopAsync(c.Id))">stop</button>
                    }
                </div>
                @if (c.Ports.Count > 0)
                {
                    <div style="display:flex; gap:6px; margin-top:7px; flex-wrap:wrap; align-items:center">
                        @foreach (var p in c.Ports)
                        {
                            <span style="font-size:10.5px; padding:2px 7px; border-radius:4px; background:var(--bg-2); color:var(--text-3); font-family:'Geist Mono',monospace">@p</span>
                        }
                        @* Published ports are reachable through the Host's authenticated /runtime proxy. *@
                        @if (c.State == "running")
                        {
                            @foreach (var port in c.PublishedPorts)
                            {
                                <a class="dcbtn" style="padding:2px 9px; font-size:10.5px; text-decoration:none"
                                   href="@($"/runtime/{ProjectId}/{port}/")" target="_blank" rel="noopener">open :@port ↗</a>
                            }
                        }
                    </div>
                }
                @if (_logsFor == c.Id)
                {
                    <pre style="margin-top:10px; background:var(--bg); border:1px solid var(--border); border-radius:6px; padding:10px; font-size:10.5px; font-family:'Geist Mono',monospace; white-space:pre-wrap; word-break:break-all; color:var(--text-2); max-height:320px; overflow-y:auto">@(_logs ?? "(no output)")</pre>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private IReadOnlyList<ContainerInfo>? _containers;
    private string? _error, _logsFor, _logs;
    private bool _busy;
    private System.Threading.Timer? _poll;

    protected override async Task OnParametersSetAsync()
    {
        Ui.Set("Runtime", "the project's application containers");
        await ReloadAsync();
        // Container state changes outside the portal too — keep the view fresh.
        _poll ??= new System.Threading.Timer(_ => _ = InvokeAsync(async () => { await ReloadAsync(); StateHasChanged(); }),
            null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task ReloadAsync()
    {
        try
        {
            _containers = await Svc.ListProjectContainersAsync(ProjectId);
            _error = null;
        }
        catch (Exception ex) { _error = Trim(ex.Message); }
    }

    private async Task ToggleLogsAsync(string containerId)
    {
        if (_logsFor == containerId) { _logsFor = null; _logs = null; return; }
        _busy = true;
        try
        {
            _logs = await Svc.GetContainerLogsAsync(ProjectId, containerId, 300);
            _logsFor = containerId;
            _error = null;
        }
        catch (Exception ex) { _error = Trim(ex.Message); }
        finally { _busy = false; }
    }

    private async Task RestartAsync(string containerId)
    {
        _busy = true;
        try { await Svc.RestartProjectContainerAsync(ProjectId, containerId); await ReloadAsync(); }
        catch (Exception ex) { _error = Trim(ex.Message); }
        finally { _busy = false; }
    }

    private async Task StopAsync(string containerId)
    {
        _busy = true;
        try { await Svc.StopProjectContainerAsync(ProjectId, containerId); await ReloadAsync(); }
        catch (Exception ex) { _error = Trim(ex.Message); }
        finally { _busy = false; }
    }

    private static string Trim(string s) => s.Length > 300 ? s[..300] + "…" : s;

    public void Dispose() => _poll?.Dispose();
}
