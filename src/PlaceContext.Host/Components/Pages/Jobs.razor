@page "/project/{ProjectId:guid}/jobs"
@attribute [Authorize(Policy = Permission.JobsView)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IDisposable
@inject JobsViewModel Vm
@inject PortalUiState Ui
@inject NavigationManager Nav
@using PlaceContext.Host.Components.ViewModels
@using PlaceContext.Host.Components.ViewModels.Helpers

<PageTitle>PlaceContext — Jobs</PageTitle>

@if (Vm.Loading)
{
    <Skeleton Kind="list" Rows="6" Padded />
}
else
{
    <div class="jobs-page">


        <div class="page-header">
            <h2 class="page-title">Jobs</h2>
            <button class="dcbtn primary" @onclick="() => Vm.NewJob()">+ New job</button>
        </div>

        @if (Vm.Message is not null)
        {
            <div class="status-message">@Vm.Message</div>
        }

        @if (Vm.Jobs is null || Vm.Jobs.Count == 0)
        {
            <div class="dccard empty-state">
                No jobs defined for this project yet. Click <strong>+ New job</strong> to create one.
            </div>
        }
        else
        {
            <div class="jobs-list">
                @foreach (var job in Vm.Jobs)
                {
                    var isSelected = Vm.SelectedJobId == job.Id;
                    <div class="dccard @(isSelected ? "selected" : "") job-card"
                         @onclick="@(() => Vm.OpenJobAsync(job))">
                        <div class="job-card-row">
                            <div class="min-w-0">
                                <div class="job-name">@job.Name</div>
                                @if (!string.IsNullOrWhiteSpace(job.Description))
                                {
                                    <div class="job-desc">@job.Description</div>
                                }
                                <div class="job-meta">
                                    @if (job.MapSourceKind == "code")
                                    {
                                        <span class="brand-2-text">[@job.MapRuntimeId]</span>
                                    }
                                    else
                                    {
                                        <span>@job.MapImage</span>
                                    }
                                    <span>@job.ShardCount shard(s)</span>
                                    <span>concurrency @job.ConcurrencyLimit</span>
                                    @if (job.ReduceSourceKind is not null)
                                    {
                                        <span class="brand-2-text">+ reduce</span>
                                    }
                                </div>
                            </div>
                            <div class="job-actions">
                                @if (Vm.ConfirmDeleteId == job.Id)
                                {
                                    <button class="dcbtn c-bad" @onclick:stopPropagation="true" @onclick="@(() => Vm.DeleteJobAsync(job.Id))">Confirm delete</button>
                                    <button class="dcbtn" @onclick:stopPropagation="true" @onclick="@(() => Vm.ConfirmDeleteId = null)">Keep</button>
                                }
                                else
                                {
                                    <button class="dcbtn" @onclick:stopPropagation="true" @onclick="@(() => Vm.ConfirmDeleteId = job.Id)">Delete</button>
                                }
                                @if (job.MapSourceKind == "code")
                                {
                                    <button class="dcbtn" @onclick:stopPropagation="true"
                                            @onclick="@(() => Nav.NavigateTo($"/project/{ProjectId}/jobs/{job.Id}"))">⌁ Editor</button>
                                }
                                <button class="dcbtn primary" disabled="@Vm.IsRunningJob(job.Id)"
                                        @onclick:stopPropagation="true"
                                        @onclick="@(() => Vm.RunJobAsync(job.Id))">
                                    @(Vm.IsRunningJob(job.Id) ? "running…" : "Run")
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
}

@* ── Job editor slide-out ─────────────────────────────────────────────────────────────── *@
@if (Vm.ShowEditor)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseEditor()"></div>
    <div class="dcslide slide-620">
        <div class="dcslide-head">
            <div class="flex-fill-min">
                <div class="title-14">@(Vm.EditJobId.HasValue ? Vm.EdName : "New job")</div>
                <div class="subtitle-11-5">
                    A job fans its input payloads out as parallel shards and collects a JSON artifact from each.
                </div>
            </div>
            @if (Vm.EditJobId is { } runnableId)
            {
                <button class="dcbtn primary mr-10" disabled="@Vm.IsRunningJob(runnableId)"
                        @onclick="@(() => Vm.RunJobAsync(runnableId))">▶ Run</button>
            }
            <button class="dcslide-x" @onclick="() => Vm.CloseEditor()">×</button>
        </div>

        @if (Vm.EditJobId.HasValue)
        {
            <div class="dctabs job-tabs">
                <button class="dctab @(Vm.EditorTab == "details" ? "active" : "")" @onclick="@(() => Vm.SetEditorTab("details"))">Details</button>
                <button class="dctab @(Vm.EditorTab == "runs" ? "active" : "")" @onclick="@(() => Vm.SwitchToRunsTabAsync())">Runs<span class="n">@(Vm.Runs?.Count ?? 0)</span></button>
                <button class="dctab @(Vm.EditorTab == "triggers" ? "active" : "")" @onclick="@(() => Vm.SetEditorTab("triggers"))">Triggers<span class="n">@Vm.JobTriggers().Count()</span></button>
            </div>
        }

        @if (Vm.EditorTab == "runs" && Vm.EditJobId.HasValue)
        {
            @* ── Runs tab: execution results, with a run's full detail inline ─────────────────── *@
            <div class="dcslide-body slide-body-scroll">
                @if (Vm.RunDetail is null)
                {
                    @if (Vm.JobTelemetry is { Count: > 0 })
                    {
                        <div class="dccard otel-card">
                            <div class="otel-title">RECENT RUN DURATIONS (OTEL)</div>
                            <div class="otel-bars">
                                @{ var maxMs = Vm.JobTelemetry.Max(t => t.DurationMs ?? 0); }
                                @foreach (var t in Vm.JobTelemetry.Reverse().TakeLast(24))
                                {
                                    var pct = maxMs > 0 ? Math.Max(6, (t.DurationMs ?? 0) / maxMs * 100) : 6;
                                    <div title="@(t.Status ?? "running") · @JobsViewModel.FormatMs(t.DurationMs)"
                                         class="otel-bar" style="height:@(pct)%; background:@JobsViewModel.StatusColor(t.Status)"></div>
                                }
                            </div>
                            <div class="otel-legend">
                                @foreach (var (outcome, count) in Vm.JobTelemetry.SelectMany(t => t.Shards)
                                    .GroupBy(s => s.Outcome ?? "unknown")
                                    .Select(g => (Outcome: g.Key, Count: g.Count()))
                                    .OrderByDescending(g => g.Count))
                                {
                                    <span style="color:@JobsViewModel.StatusColor(outcome)">@count @outcome shard(s)</span>
                                }
                            </div>
                        </div>
                    }

                    @if (Vm.Runs is null or { Count: 0 })
                    {
                        <div class="empty-note">No runs yet — click ▶ Run to start one.</div>
                    }
                    else
                    {
                        <div class="col-gap-8">
                            @foreach (var run in Vm.Runs)
                            {
                                <div class="dccard card-pad">
                                    <div class="run-row-head" @onclick="@(() => Vm.OpenRunDetailAsync(run.Id))">
                                        <span class="status-badge-sm" style="color:@JobsViewModel.StatusColor(run.Status); background:@JobsViewModel.StatusBg(run.Status)">
                                            @run.Status
                                        </span>
                                        <span class="run-time">
                                            @run.StartedAt.ToWorkspaceTime().ToString("yyyy-MM-dd HH:mm")
                                        </span>
                                        <span class="meta-11">
                                            ✓ @run.SucceededShards  @(run.PartialShards > 0 ? $"~ {run.PartialShards}" : "")  @(run.FailedShards > 0 ? $"✗ {run.FailedShards}" : "")
                                        </span>
                                        @if (run.FinishedAt.HasValue)
                                        {
                                            <span class="meta-mono">
                                                @JobsViewModel.FormatDuration(run.StartedAt, run.FinishedAt.Value)
                                            </span>
                                        }
                                        @if (run.Status is "Queued" or "Running")
                                        {
                                            <button class="dcbtn btn-2-8 text-bad" @onclick:stopPropagation="true"
                                                    @onclick="@(() => Vm.CancelRunAsync(run.Id))">Cancel</button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <button class="dcbtn mb-12" @onclick="() => Vm.CloseRunDetail()">← All runs</button>

                    <div class="run-detail-head">
                        <span class="status-badge-lg" style="color:@JobsViewModel.StatusColor(Vm.RunDetail.Status); background:@JobsViewModel.StatusBg(Vm.RunDetail.Status)">
                            @Vm.RunDetail.Status
                        </span>
                        <span class="meta-mono">@Vm.RunDetail.Id</span>
                        @if (Vm.RunDetail.AttemptNumber > 1)
                        {
                            <span class="meta-11">attempt @Vm.RunDetail.AttemptNumber
                                @if (Vm.RunDetail.OriginalRunId is { } orig)
                                {
                                    <span>of <a @onclick:preventDefault @onclick="@(() => Vm.OpenRunDetailAsync(orig))" href="#">@orig</a></span>
                                }
                            </span>
                        }
                    </div>

                    @if (Vm.RunDetail.Status is "Queued" or "Running")
                    {
                        <button class="dcbtn text-bad mb-8" @onclick="@(() => Vm.CancelRunAsync(Vm.RunDetail.Id))">Cancel run</button>
                    }

                    <div class="snapshot-line">
                        Ran as: <code>@Vm.RunDetail.Snapshot.MapSourceKind</code> · @Vm.RunDetail.Snapshot.MapSourceLabel
                        · @Vm.RunDetail.Snapshot.ShardCount shard(s) · concurrency @Vm.RunDetail.Snapshot.ConcurrencyLimit
                        @if (Vm.RunDetail.Snapshot.AllowNetworkEgress)
                        {
                            <span class="egress-flag">[network egress allowed]</span>
                        }
                    </div>

                    @if (Vm.RunArtifacts is { Count: > 0 })
                    {
                        <div class="dccard outputs-card">
                            <div class="outputs-title">Post-job outputs</div>
                            <div class="col-gap-6">
                                @foreach (var art in Vm.RunArtifacts)
                                {
                                    <div class="output-row">
                                        <span class="output-kind">@art.Kind</span>
                                        <a href="@($"/runs/{art.RunId}/artifacts/{art.Id}")" target="_blank" rel="noopener"
                                           class="output-link">@art.Title ↗</a>
                                        <span class="hint-10-5">@JobsViewModel.FormatBytes(art.SizeBytes)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @foreach (var shard in Vm.RunDetail.ShardResults)
                    {
                        <div class="mb-14">
                            <div class="shard-head">
                                <span>Shard @shard.Index</span>
                                <span class="shard-badge" style="color:@JobsViewModel.StatusColor(shard.Outcome); background:@JobsViewModel.StatusBg(shard.Outcome)">
                                    @shard.Outcome
                                </span>
                                <span class="meta-11">exit @shard.ExitCode</span>
                            </div>
                            @if (shard.Artifact is not null)
                            {
                                <pre class="artifact-pre">@JobsViewModel.PrettyJson(shard.Artifact)</pre>
                                @if (ArtifactChart.TrySvg(shard.Artifact, out var shardChart))
                                {
                                    <div class="chart-label">chart <span class="text-3">(from the artifact's JSON)</span></div>
                                    @((MarkupString)shardChart)
                                }
                            }
                            else
                            {
                                <div class="text-3-12">_(no artifact)_</div>
                            }
                            @if (shard.Artifacts.Count > 0)
                            {
                                <div class="artifact-links">
                                    @foreach (var a in shard.Artifacts)
                                    {
                                        <a class="dcbtn artifact-dl"
                                           href="@JobsViewModel.DataUri(a)" download="@a.Name">⬇ @a.Name</a>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(shard.Log))
                            {
                                <details class="mt-4" open="@(Vm.RunDetail.Status == "Running")">
                                    <summary class="log-summary">
                                        Log
                                        @if (Vm.RunDetail.Status == "Running")
                                        {
                                            <span class="live-badge">LIVE</span>
                                        }
                                    </summary>
                                    <pre class="log-pre">@shard.Log</pre>
                                </details>
                            }
                        </div>
                    }

                    @if (Vm.RunDetail.ReduceResult is { } reduce)
                    {
                        <div class="reduce-section">
                            <div class="shard-head">
                                <span>Reduce step</span>
                                <span class="shard-badge" style="color:@(reduce.Succeeded ? "var(--good)" : "var(--bad)"); background:@(reduce.Succeeded ? "var(--good-bg)" : "var(--bad-bg)")">
                                    @(reduce.Succeeded ? "succeeded" : "failed")
                                </span>
                                <span class="meta-11">exit @reduce.ExitCode</span>
                            </div>
                            @if (reduce.Artifact is not null)
                            {
                                <pre class="artifact-pre-lg">@JobsViewModel.PrettyJson(reduce.Artifact)</pre>
                                @if (ArtifactChart.TrySvg(reduce.Artifact, out var reduceChart))
                                {
                                    <div class="chart-label">chart <span class="text-3">(from the artifact's JSON)</span></div>
                                    @((MarkupString)reduceChart)
                                }
                            }
                            @if (reduce.Artifacts.Count > 0)
                            {
                                <div class="artifact-links">
                                    @foreach (var a in reduce.Artifacts)
                                    {
                                        <a class="dcbtn artifact-dl"
                                           href="@JobsViewModel.DataUri(a)" download="@a.Name">⬇ @a.Name</a>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(reduce.Log))
                            {
                                <details class="mt-4" open="@(Vm.RunDetail.Status == "Running")">
                                    <summary class="log-summary">
                                        Reduce log
                                        @if (Vm.RunDetail.Status == "Running")
                                        {
                                            <span class="live-badge">LIVE</span>
                                        }
                                    </summary>
                                    <pre class="log-pre">@reduce.Log</pre>
                                </details>
                            }
                        </div>
                    }
                }
            </div>
        }
        else if (Vm.EditorTab == "triggers" && Vm.EditJobId.HasValue)
        {
            @* ── Triggers tab: this job's triggers, a trigger's detail inline, and the add form ── *@
            <div class="dcslide-body slide-body-col">
                @if (Vm.SelectedTrigger() is { } sel)
                {
                    <button class="dcbtn self-start" @onclick="() => Vm.SelectedTriggerId = null">← All triggers</button>

                    <div class="row-center-8">
                        <span class="status-badge-lg" style="color:@(sel.Enabled ? "var(--good)" : "var(--text-3)"); background:@(sel.Enabled ? "var(--good-bg)" : "var(--card-2)")">
                            @(sel.Enabled ? "on" : "paused")
                        </span>
                        <span class="title-14">@sel.Name</span>
                        <span class="flex-1"></span>
                        <button class="dcbtn" @onclick="@(() => Vm.ToggleTriggerAsync(sel))">@(sel.Enabled ? "Pause" : "Enable")</button>
                        <button class="dcbtn text-bad" @onclick="@(() => Vm.RemoveTriggerAsync(sel.Id))">Delete</button>
                    </div>

                    <div class="dccard trigger-detail-card">
                        <div><span class="text-3">Kind:</span> @sel.Kind</div>
                        @if (sel.Kind == "Schedule")
                        {
                            <div><span class="text-3">Cron:</span> <code>@sel.CronExpression</code></div>
                            <div><span class="text-3">Next run:</span> @(sel.NextRunAt?.ToWorkspaceTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</div>
                        }
                        else
                        {
                            <div><span class="text-3">Event:</span> <code>@sel.EventName</code></div>
                        }
                        <div><span class="text-3">Last fired:</span> @(sel.LastFiredAt?.ToWorkspaceTime().ToString("yyyy-MM-dd HH:mm") ?? "never")</div>
                        <div><span class="text-3">Created:</span> @sel.CreatedAt.ToWorkspaceTime().ToString("yyyy-MM-dd HH:mm")</div>
                    </div>

                    <div class="section-label-mt4">Execution results</div>
                    @if (Vm.Runs is null or { Count: 0 })
                    {
                        <div class="text-3-12">This job has no runs yet.</div>
                    }
                    else
                    {
                        <div class="col-gap-6">
                            @foreach (var run in Vm.Runs)
                            {
                                <div class="dccard run-row"
                                     @onclick="@(() => Vm.OpenRunDetailFromTriggerAsync(run.Id))">
                                    <span class="status-badge-sm" style="color:@JobsViewModel.StatusColor(run.Status); background:@JobsViewModel.StatusBg(run.Status)">@run.Status</span>
                                    <span class="run-time">
                                        @run.StartedAt.ToWorkspaceTime().ToString("yyyy-MM-dd HH:mm")
                                    </span>
                                    <span class="meta-11">✓ @run.SucceededShards @(run.FailedShards > 0 ? $"✗ {run.FailedShards}" : "")</span>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    @foreach (var t in Vm.JobTriggers())
                    {
                        <div class="dccard trigger-row"
                             @onclick="@(() => Vm.SelectedTriggerId = t.Id)">
                            <span class="status-badge-sm" style="color:@(t.Enabled ? "var(--good)" : "var(--text-3)"); background:@(t.Enabled ? "var(--good-bg)" : "var(--card-2)")">
                                @(t.Enabled ? "on" : "paused")
                            </span>
                            <div class="flex-fill-min">
                                <div class="title-13">
                                    @t.Name <span class="trigger-kind">· @t.Kind</span>
                                </div>
                                <div class="trigger-meta">
                                    @if (t.Kind == "Schedule")
                                    {
                                        <span>@t.CronExpression</span>
                                        @if (t.NextRunAt.HasValue)
                                        {
                                            <span class="ml-8">next @t.NextRunAt.Value.ToWorkspaceTime().ToString("yyyy-MM-dd HH:mm")</span>
                                        }
                                    }
                                    else
                                    {
                                        <span>on @t.EventName</span>
                                    }
                                    @if (t.LastFiredAt.HasValue)
                                    {
                                        <span class="ml-8">last @t.LastFiredAt.Value.ToWorkspaceTime().ToString("MM-dd HH:mm")</span>
                                    }
                                </div>
                            </div>
                            <button class="dcbtn" @onclick:stopPropagation="true" @onclick="@(() => Vm.ToggleTriggerAsync(t))">@(t.Enabled ? "Pause" : "Enable")</button>
                            <button class="dcbtn" @onclick:stopPropagation="true" @onclick="@(() => Vm.RemoveTriggerAsync(t.Id))">Delete</button>
                        </div>
                    }
                    @if (!Vm.JobTriggers().Any())
                    {
                        <div class="text-3-12">No triggers — add one below to run this job automatically.</div>
                    }

                    <div class="dccard add-trigger-card">
                        <div class="subhead">Add trigger</div>
                        <div class="trigger-form-row">
                            <div class="field-150">
                                <label class="field-label">Name</label>
                                <input class="dcinput w-full" @bind="Vm.TrName" placeholder="nightly" />
                            </div>
                            <div>
                                <label class="field-label">Kind</label>
                                <select class="dcinput" @bind="Vm.TrKind">
                                    <option value="Schedule">Schedule</option>
                                    <option value="Event">Event</option>
                                </select>
                            </div>
                            @if (Vm.TrKind == "Schedule")
                            {
                                <div class="field-150">
                                    <label class="field-label">Cron</label>
                                    <input class="dcinput w-full" @bind="Vm.TrCron" placeholder="0 0 * * *" />
                                </div>
                            }
                            else
                            {
                                <div class="field-150">
                                    <label class="field-label">Event</label>
                                    <input class="dcinput w-full" list="evt-names" @bind="Vm.TrEvent" placeholder="deploy.finished" />
                                    <datalist id="evt-names">
                                        @foreach (var e in Vm.EventTypes ?? Array.Empty<PlaceContext.Application.Dtos.EventTypeView>())
                                        {
                                            <option value="@e.Name" />
                                        }
                                    </datalist>
                                </div>
                            }
                            <button class="dcbtn primary" disabled="@Vm.TrBusy" @onclick="() => Vm.AddTriggerAsync()">Add</button>
                        </div>
                        @if (Vm.TrError is not null)
                        {
                            <div class="error-12">@Vm.TrError</div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
        <div class="dcslide-body slide-body-form">

            <div class="row-gap-10">
                <div class="dcfield flex-1">
                    <label>Name <span class="req">*</span></label>
                    <input class="dcinput" @bind="Vm.EdName" placeholder="my-job" />
                </div>
                <div class="dcfield flex-1-4">
                    <label>Description</label>
                    <input class="dcinput" @bind="Vm.EdDescription" placeholder="What does this job do? (optional)" />
                </div>
            </div>

            <div class="dcform-section">
                <div class="workload-head">
                    <span class="dcform-title">Workload</span>
                    <div class="dcseg">
                        <button type="button" class="@(Vm.EdMapSourceKind == "image" ? "on" : "")"
                                @onclick="@(() => Vm.EdMapSourceKind = "image")">Container image</button>
                        <button type="button" class="@(Vm.EdMapSourceKind == "code" ? "on" : "")"
                                @onclick="@(() => Vm.EdMapSourceKind = "code")">Inline code</button>
                    </div>
                </div>

                @if (Vm.EdMapSourceKind == "image")
                {
                    <div class="dcfield">
                        <label>Image <span class="req">*</span></label>
                        <input class="dcinput input-sans-12" @bind="Vm.EdMapImage" placeholder="myorg/worker:latest" />
                    </div>
                }
                else
                {
                    <div class="row-gap-10">
                        <div class="dcfield flex-1">
                            <label>Runtime <span class="req">*</span></label>
                            <select class="dcinput" @bind="Vm.EdMapRuntimeId">
                                <option value="">— select —</option>
                                <option value="node">node</option>
                                <option value="python">python</option>
                                <option value="go">go</option>
                                <option value="ruby">ruby</option>
                                <option value="dotnet">.NET (C#)</option>
                            </select>
                        </div>
                        <div class="dcfield flex-1">
                            <label>Entrypoint</label>
                            <input class="dcinput input-sans-12" @bind="Vm.EdMapEntrypoint"
                                   placeholder="@JobsViewModel.DefaultEntrypointFor(Vm.EdMapRuntimeId)" />
                        </div>
                    </div>
                    <div class="dcfield">
                        <label>Source code @(Vm.EditJobId.HasValue ? "" : "*")</label>
                        @if (Vm.EditJobId is { } editingJobId)
                        {
                            <button class="dcbtn open-editor-btn"
                                    @onclick="@(() => Nav.NavigateTo($"/project/{ProjectId}/jobs/{editingJobId}"))">
                                ⤷ Open code editor
                                <span class="hint-10-5">@Math.Max(Vm.EdMapFiles.Count, 1) file(s)</span>
                            </button>
                        }
                        else
                        {
                            <textarea class="dcinput textarea-sans" rows="12"
                                      @bind="Vm.EdMapSource"
                                      placeholder="@JobsViewModel.SourcePlaceholderFor(Vm.EdMapRuntimeId)">
                            </textarea>
                        }
                        <div class="dchint">
                            Stdin: opaque JSON payload. Print the JSON artifact to <code>stdout</code>.
                            Dependencies: add your runtime's manifest as an extra file (<code>requirements.txt</code>,
                            <code>package.json</code>, <code>Gemfile</code>, <code>go.mod</code>) and packages install
                            before the entrypoint runs — downloads need <strong>Allow network egress</strong> ticked.
                        </div>
                        @if (Vm.EdMapFiles.Count > 1)
                        {
                            <div class="files-note">
                                <span>This job has @Vm.EdMapFiles.Count files — the editor above changes only the entrypoint; the rest are kept on save:</span>
                                @foreach (var f in Vm.EdMapFiles.Where(f => f.Path != (Vm.EdMapEntrypoint == "" ? JobsViewModel.DefaultEntrypointFor(Vm.EdMapRuntimeId) : Vm.EdMapEntrypoint)))
                                {
                                    <span class="file-chip">@f.Path</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="dcform-section">
                <span class="dcform-title">Input</span>
                <div class="dcfield">
                    <label>
                        Input payloads <span class="req">*</span>
                        @if (Vm.DeclaredParams().Count > 0)
                        {
                            <span class="payload-mode-toggle">
                                <button type="button" class="dcbtn mode-btn" style="@(Vm.EdPayloadMode == "form" ? "color:var(--brand-2); border-color:var(--brand-2)" : "")"
                                        @onclick="@(() => Vm.SwitchPayloadMode("form"))">form</button>
                                <button type="button" class="dcbtn mode-btn" style="@(Vm.EdPayloadMode == "raw" ? "color:var(--brand-2); border-color:var(--brand-2)" : "")"
                                        @onclick="@(() => Vm.SwitchPayloadMode("raw"))">raw JSON</button>
                            </span>
                        }
                        else
                        {
                            <span class="code ml-5">one JSON per line — each line becomes a shard</span>
                        }
                    </label>
                    @if (Vm.EdPayloadMode == "form" && Vm.DeclaredParams().Count > 0)
                    {
                        @foreach (var p in Vm.DeclaredParams())
                        {
                            <div class="param-row">
                                <span class="param-name-label">
                                    @(p.Label ?? p.Name)@(p.Required ? " *" : "")
                                </span>
                                <div class="flex-1">
                                    <ParamInput Parameter="p" ProjectId="@ProjectId" Value="@Vm.PayloadFormValue(p.Name)"
                                                ValueChanged="@(v => Vm.SetPayloadFormValue(p.Name, v))" />
                                </div>
                            </div>
                        }
                        <div class="dchint">Composes a single-shard payload from the declared inputs — switch to raw JSON for multi-shard fan-out.</div>
                    }
                    else
                    {
                        <textarea class="dcinput textarea-sans" rows="4"
                                  @bind="Vm.EdInputPayloadsRaw"
                                  placeholder="{&quot;key&quot;: &quot;value1&quot;}&#10;{&quot;key&quot;: &quot;value2&quot;}">
                        </textarea>
                    }
                </div>
                <div class="dcfield">
                    <div class="row-between">
                        <label>Run-form parameters</label>
                        <button type="button" class="dcbtn btn-2-9" @onclick="@(() => Vm.EdParams.Add(new ParamEdit()))">+ input</button>
                    </div>
                    <div class="param-list">
                        @for (var i = 0; i < Vm.EdParams.Count; i++)
                        {
                            var idx = i;
                            <div class="param-edit-row">
                                <input class="dcinput param-name-input" placeholder="name" @bind="Vm.EdParams[idx].Name" />
                                <input class="dcinput param-label-input" placeholder="Label (optional)" @bind="Vm.EdParams[idx].Label" />
                                <select class="dcinput param-type-select" @bind="Vm.EdParams[idx].Type">
                                    <option value="text">text</option>
                                    <option value="number">number</option>
                                    <option value="select">select</option>
                                    <option value="checkbox">checkbox</option>
                                    <option value="file">file upload</option>
                                </select>
                                @if (Vm.EdParams[idx].Type is "select" or "file")
                                {
                                    <input class="dcinput param-options-input"
                                           placeholder="@(Vm.EdParams[idx].Type == "file" ? "accepted types, e.g. application/pdf, image/*" : "options, comma-separated")"
                                           @bind="Vm.EdParams[idx].OptionsRaw" />
                                }
                                <label class="param-required-label">
                                    <input type="checkbox" @bind="Vm.EdParams[idx].Required" class="accent-brand" /> required
                                </label>
                                <button type="button" class="dcbtn btn-2-8" @onclick="@(() => Vm.EdParams.RemoveAt(idx))">×</button>
                            </div>
                        }
                    </div>
                    <div class="dchint">
                        When set, clicking <strong>Run</strong> opens a form asking for these values (events supply them in the payload) —
                        so the same job can run on demand with different inputs instead of the payloads above.
                    </div>
                </div>
            </div>

            <div class="dcform-section">
                <span class="dcform-title">Environment</span>
                <div class="dcfield">
                    <label>Environment variables <span class="code ml-5">KEY=VALUE, one per line</span></label>
                    <textarea class="dcinput textarea-sans" rows="3"
                              @bind="Vm.EdMapEnvRaw"
                              placeholder="MY_KEY=my_value">
                    </textarea>
                </div>

                <div class="vault-box">
                    <div class="vault-head">
                        <span class="text-3-12">Injected at run time (from Vault)</span>
                        <button type="button" class="link-btn"
                                @onclick="@(() => Nav.NavigateTo($"/project/{ProjectId}/secrets"))">manage in Vault →</button>
                    </div>
                    @if (Vm.VaultSecrets is { Count: > 0 })
                    {
                        <div class="chip-wrap">
                            @foreach (var s in Vm.VaultSecrets)
                            {
                                <span class="secret-chip">@s.Name</span>
                            }
                        </div>
                        <div class="dchint mt-6">
                            These encrypted secrets are added to every run's environment. A plaintext variable above with the same name overrides the vault value.
                        </div>
                    }
                    else
                    {
                        <div class="text-3-11-5">No vault secrets yet — add API keys or passwords in the Vault and they'll be injected here automatically.</div>
                    }
                </div>
            </div>

            @* ── MCP Servers ───────────────────────────────────────────────────────────────── *@
            <div class="dcform-section">
                <span class="dcform-title">MCP Servers</span>
                <div class="mcp-section">
                    @if (Vm.ProjectMcpConnections is { Count: > 0 })
                    {
                        <div class="mcp-list">
                            @foreach (var mcp in Vm.ProjectMcpConnections)
                            {
                                var connId = mcp.Id.ToString();
                                var isEnabled = Vm.EdMcpConnectionIds.Contains(connId);
                                var isOAuth = mcp.AuthType == "oauth";
                                var isExpired = mcp.OAuthTokenExpiresAt.HasValue && mcp.OAuthTokenExpiresAt.Value <= DateTimeOffset.UtcNow;
                                var isConnected = mcp.LastStatus?.StartsWith("oauth:connected") == true;

                                <label class="mcp-item @(isEnabled ? "" : "disabled")">
                                    <input type="checkbox" class="checkbox-15 mcp-checkbox"
                                           checked="@isEnabled"
                                           @onchange="@(e => Vm.ToggleMcpConnection(mcp.Id, (bool)e.Value!))" />
                                    <span class="mcp-name">@mcp.Name</span>
                                    <span class="mcp-badge">@mcp.Transport</span>
                                    <span class="mcp-url">@mcp.EndpointUrl</span>
                                    @if (isOAuth)
                                    {
                                        <span class="mcp-badge oauth @(isExpired ? "expired" : isConnected ? "active" : "")">
                                            @(isExpired ? "token expired" : isConnected ? "oauth connected" : "oauth")
                                        </span>
                                        <button type="button" class="dcbtn xs"
                                                @onclick="@(() => Js.InvokeVoidAsync("open", Vm.GetOAuthUrl(mcp.Id), "_blank"))">
                                            @(isExpired ? "Reconnect" : "Auth")
                                        </button>
                                    }
                                </label>
                            }
                        </div>
                        <div class="dchint mt-6">
                            Enabled MCP connections are injected as env vars at runtime. Auth via the project's MCP settings.
                        </div>
                    }
                    else
                    {
                        <div class="text-3-11-5">No MCP servers configured for this project. Add them in the chat settings to use from jobs.</div>
                    }
                </div>
            </div>

            <div class="dcform-section">
                <span class="dcform-title">Execution</span>
                <div class="row-gap-10">
                    <div class="dcfield flex-1">
                        <label>Concurrency</label>
                        <input class="dcinput" type="number" min="1" max="32" @bind="Vm.EdConcurrency" />
                    </div>
                    <div class="dcfield flex-1">
                        <label>Success exit codes <span class="code ml-5">comma-separated</span></label>
                        <input class="dcinput" @bind="Vm.EdSuccessCodesRaw" placeholder="0" />
                    </div>
                    <div class="dcfield flex-1">
                        <label>Partial exit codes</label>
                        <input class="dcinput" @bind="Vm.EdPartialCodesRaw" placeholder="" />
                    </div>
                </div>
                <div class="row-gap-10 mt-10">
                    <div class="dcfield flex-1">
                        <label>Max retries</label>
                        <input class="dcinput" type="number" min="0" @bind="Vm.EdRetryCount" />
                        <div class="dchint">Automatic retry attempts when a run fails. 0 = no retries.</div>
                    </div>
                    <div class="dcfield flex-1">
                        <label>Retry delay (seconds)</label>
                        <input class="dcinput" type="number" min="0" @bind="Vm.EdRetryDelaySeconds" />
                        <div class="dchint">Fixed wait between retry attempts.</div>
                    </div>
                    <div class="flex-1"></div>
                </div>
                <label class="egress-label">
                    <input type="checkbox" @bind="Vm.EdAllowNetworkEgress"
                           class="checkbox-16" />
                    Allow network egress
                    <span class="dchint">(disables the --network none sandbox; only enable for jobs that require outbound access)</span>
                </label>
            </div>

            <div class="dcform-section">
                <span class="dcform-title">Outputs</span>
                <div class="dcfield">
                    <label>Return type <span class="req">*</span></label>
                    <select class="dcinput mw-260" @bind="Vm.EdReturnType">
                        @foreach (var (rt, label) in JobsViewModel.ReturnTypeChoices)
                        {
                            <option value="@rt">@label</option>
                        }
                    </select>
                    <div class="dchint">
                        What this job's code returns on stdout. Every run generates its primary artifact from this
                        type — a run always yields at least one stored artifact.
                    </div>
                    @if (Vm.EdReturnType is PlaceContext.Domain.ValueObjects.JobReturnType.Pdf
                        or PlaceContext.Domain.ValueObjects.JobReturnType.Image
                        or PlaceContext.Domain.ValueObjects.JobReturnType.Video)
                    {
                        <div class="dcfield mw-280-mt8">
                            <label>Output file name <span class="code ml-5">in /out</span></label>
                            <input class="dcinput font-sans" @bind="Vm.EdReturnFileName"
                                   placeholder="report.pdf" />
                            <div class="dchint">The named file becomes the run's artifact; blank = first file matching the type.</div>
                        </div>
                    }
                </div>
                <div class="dcfield">
                    <label>Extra post-job actions</label>
                    <div class="actions-wrap">
                        @foreach (var (kind, label) in JobsViewModel.PostJobActionChoices)
                        {
                            <label class="action-label">
                                <input type="checkbox" checked="@Vm.EdPostJobActions.Contains(kind)"
                                       class="checkbox-15"
                                       @onchange="@(e => Vm.TogglePostJobAction(kind, (bool)e.Value!))" />
                                @label
                            </label>
                        }
                    </div>
                    <div class="dchint">
                        Additional outputs generated after each run on top of the return-type artifact — they appear as links on the run.
                    </div>
                </div>
            </div>
        </div>
        }

        @if (Vm.EditorTab == "details")
        {
            <div class="dcslide-foot">
                @if (Vm.EditorError is not null)
                {
                    <div class="foot-error">@Vm.EditorError</div>
                }
                <button class="dcbtn" @onclick="() => Vm.CloseEditor()">Cancel</button>
                <button class="dcbtn primary" disabled="@Vm.Saving" @onclick="() => Vm.SaveJobAsync()">
                    @(Vm.Saving ? "Saving…" : Vm.EditJobId.HasValue ? "Save changes" : "Create job")
                </button>
            </div>
        }
    </div>
}

@* ── Run-input modal (prompts for a job's declared parameters) ────────────────────────── *@
@if (Vm.RunPromptJob is not null)
{
    <div class="dcmodal-overlay" @onclick="() => Vm.CancelRunPrompt()">
        <div class="dcmodal modal-440" @onclick:stopPropagation="true">
            <div class="dcmodal-head">
                <div class="flex-fill-min">
                    <div class="title-14">Run @Vm.RunPromptJob.Name</div>
                    <div class="subtitle-11-5">
                        This job takes input — the values below become the run's payload.
                    </div>
                </div>
                <button class="dcslide-x" @onclick="() => Vm.CancelRunPrompt()">×</button>
            </div>
            <div class="dcmodal-body">
                @foreach (var (p, i) in Vm.RunPromptJob.Parameters.Select((p, i) => (p, i)))
                {
                    <div class="dcfield">
                        <label>
                            @(p.Label ?? p.Name)
                            @if (p.Required)
                            {
                                <span class="req">*</span>
                            }
                            <span class="code ml-5">@p.Name</span>
                        </label>
                        <ParamInput Parameter="p" ProjectId="@ProjectId" Value="@Vm.GetArg(p.Name)"
                                    ValueChanged="@(v => Vm.SetArg(p.Name, v))" />
                    </div>
                }
                @if (Vm.RunPromptError is not null)
                {
                    <div class="prompt-error">@Vm.RunPromptError</div>
                }
            </div>
            <div class="dcmodal-foot">
                <button class="dcbtn" @onclick="() => Vm.CancelRunPrompt()">Cancel</button>
                <button class="dcbtn primary" disabled="@Vm.IsRunningJob(Vm.RunPromptJob.Id)" @onclick="() => Vm.SubmitRunPromptAsync()">
                    @(Vm.IsRunningJob(Vm.RunPromptJob.Id) ? "Running…" : "▶ Run job")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Inject] private IJSRuntime Js { get; set; } = null!;

    protected override void OnInitialized()
    {
        Vm.Attach(() => InvokeAsync(StateHasChanged));
        McpOAuthCompleted += async (_, _) =>
        {
            await Vm.LoadMcpConnectionsAsync();
            StateHasChanged();
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Js.InvokeVoidAsync("eval", @"
if (!window.__jobsMcpOAuthListener) {
    window.__jobsMcpOAuthListener = function(e) {
        if (e.data && e.data.startsWith && e.data.startsWith('mcp-oauth-')) {
            DotNet.invokeMethodAsync('PlaceContext.Host', 'OnJobsMcpOAuthCallback', e.data);
        }
    };
    window.addEventListener('message', window.__jobsMcpOAuthListener);
}");
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        Vm.Initialize(ProjectId);
        await Vm.LoadAsync();
    }

    public void Dispose()
    {
        Vm.DetachEvents();
        Vm.Detach();
    }

    private static event EventHandler? McpOAuthCompleted;

    [JSInvokable]
    public static async Task OnJobsMcpOAuthCallback(string message)
    {
        McpOAuthCompleted?.Invoke(null, EventArgs.Empty);
        await Task.CompletedTask;
    }
}
