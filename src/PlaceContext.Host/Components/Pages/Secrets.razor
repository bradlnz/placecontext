@page "/project/{ProjectId:guid}/secrets"
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@attribute [Authorize(Policy = Permission.SecretsManage)]
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject NavigationManager Nav

<PageTitle>PlaceContext — Vault</PageTitle>

@if (_loading)
{
    <Skeleton Kind="list" Rows="4" Padded />
}
else
{
    <div class="page">


        <div class="head">
            <h2 class="title">Vault</h2>
        </div>
        <div class="intro">
            Encrypted secrets injected as environment variables into this project's jobs at run time.
            Values are encrypted at rest and never displayed after creation — to rotate a secret, delete it and add it again.
        </div>

        @if (_message is not null)
        {
            <div class="message">@_message</div>
        }

        @* ── Add secret ───────────────────────────────────────────────────────────────────── *@
        <div class="dccard add-card">
            <div class="add-title">Add secret</div>
            <div class="add-row">
                <div class="field-name">
                    <label class="field-label">Name</label>
                    <input class="dcinput field-input" @bind="_newName" placeholder="API_KEY" />
                </div>
                <div class="field-value">
                    <label class="field-label">Value</label>
                    <input class="dcinput field-input" type="password" @bind="_newValue" placeholder="••••••••" />
                </div>
                <button class="dcbtn primary" disabled="@_busy" @onclick="AddSecret">@(_busy ? "Saving…" : "Add")</button>
            </div>
            @if (_addError is not null)
            {
                <div class="add-error">@_addError</div>
            }
        </div>

        @* ── Existing secrets ─────────────────────────────────────────────────────────────── *@
        @if (_secrets is null || _secrets.Count == 0)
        {
            <div class="dccard empty">
                No secrets yet. Add one above and reference it as an environment variable in any of this project's jobs.
            </div>
        }
        else
        {
            <div class="list">
                @foreach (var s in _secrets)
                {
                    <div class="dccard secret-row">
                        <span class="secret-name">@s.Name</span>
                        <span class="secret-mask">••••••••</span>
                        <span class="secret-added">added @s.CreatedAt.ToWorkspaceTime().ToString("yyyy-MM-dd HH:mm")</span>
                        <button class="dcbtn" disabled="@_busy" @onclick="@(() => DeleteSecret(s.Name))">Delete</button>
                    </div>
                }
            </div>
        }

    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private IReadOnlyList<ProjectSecretView>? _secrets;
    private bool _loading = true;
    private bool _busy;
    private string? _message;
    private string? _addError;

    private string _newName = "";
    private string _newValue = "";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _message = null;
        try
        {
            _secrets = await Svc.ListProjectSecretsAsync(ProjectId);
            Ui.Set("Vault", "encrypted project secrets");
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _loading = false; }
    }

    private async Task AddSecret()
    {
        _addError = null;
        if (string.IsNullOrWhiteSpace(_newName)) { _addError = "Name is required."; return; }
        if (string.IsNullOrEmpty(_newValue)) { _addError = "Value is required."; return; }

        _busy = true;
        try
        {
            await Svc.AddProjectSecretAsync(ProjectId, _newName.Trim(), _newValue);
            _secrets = await Svc.ListProjectSecretsAsync(ProjectId);
            _message = $"Secret '{_newName.Trim()}' saved.";
            _newName = "";
            _newValue = "";
        }
        catch (Exception ex) { _addError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteSecret(string name)
    {
        _busy = true;
        _message = null;
        try
        {
            await Svc.DeleteProjectSecretAsync(ProjectId, name);
            _secrets = await Svc.ListProjectSecretsAsync(ProjectId);
            _message = $"Secret '{name}' deleted.";
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _busy = false; }
    }
}
