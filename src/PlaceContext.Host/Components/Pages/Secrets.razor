@page "/project/{ProjectId:guid}/secrets"
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject NavigationManager Nav

<PageTitle>PlaceContext — Vault</PageTitle>

@if (_loading)
{
    <div style="padding:24px; color:var(--text-3)">Loading…</div>
}
else
{
    <div style="padding:20px 24px 40px; max-width:920px; margin:0 auto">


        <div style="display:flex; align-items:baseline; justify-content:space-between; margin-bottom:6px">
            <h2 style="font-size:18px; font-weight:600; margin:0">Vault</h2>
        </div>
        <div style="font-size:12.5px; color:var(--text-3); margin-bottom:18px">
            Encrypted secrets injected as environment variables into this project's jobs at run time.
            Values are encrypted at rest and never displayed after creation — to rotate a secret, delete it and add it again.
        </div>

        @if (_message is not null)
        {
            <div style="margin-bottom:12px; padding:10px 14px; border-radius:8px; background:var(--card); font-size:12.5px; color:var(--text-2)">@_message</div>
        }

        @* ── Add secret ───────────────────────────────────────────────────────────────────── *@
        <div class="dccard" style="padding:14px 16px; display:flex; flex-direction:column; gap:10px; margin-bottom:18px">
            <div style="font-size:12.5px; font-weight:600">Add secret</div>
            <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:flex-end">
                <div style="flex:1; min-width:160px">
                    <label style="font-size:12px; color:var(--text-3); display:block; margin-bottom:4px">Name</label>
                    <input class="dcinput" style="width:100%; font-family:'IBM Plex Mono',monospace" @bind="_newName" placeholder="API_KEY" />
                </div>
                <div style="flex:2; min-width:200px">
                    <label style="font-size:12px; color:var(--text-3); display:block; margin-bottom:4px">Value</label>
                    <input class="dcinput" type="password" style="width:100%; font-family:'IBM Plex Mono',monospace" @bind="_newValue" placeholder="••••••••" />
                </div>
                <button class="dcbtn primary" disabled="@_busy" @onclick="AddSecret">@(_busy ? "Saving…" : "Add")</button>
            </div>
            @if (_addError is not null)
            {
                <div style="color:var(--bad); font-size:12px">@_addError</div>
            }
        </div>

        @* ── Existing secrets ─────────────────────────────────────────────────────────────── *@
        @if (_secrets is null || _secrets.Count == 0)
        {
            <div class="dccard" style="padding:24px; color:var(--text-3); font-size:13px; text-align:center">
                No secrets yet. Add one above and reference it as an environment variable in any of this project's jobs.
            </div>
        }
        else
        {
            <div style="display:flex; flex-direction:column; gap:8px">
                @foreach (var s in _secrets)
                {
                    <div class="dccard" style="padding:12px 16px; display:flex; align-items:center; gap:12px">
                        <span style="font-size:13px; font-weight:600; font-family:'IBM Plex Mono',monospace; flex:1; min-width:0">@s.Name</span>
                        <span style="font-size:11px; color:var(--text-3); font-family:'IBM Plex Mono',monospace">••••••••</span>
                        <span style="font-size:11px; color:var(--text-3)">added @s.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span>
                        <button class="dcbtn" disabled="@_busy" @onclick="@(() => DeleteSecret(s.Name))">Delete</button>
                    </div>
                }
            </div>
        }

    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    private IReadOnlyList<ProjectSecretView>? _secrets;
    private bool _loading = true;
    private bool _busy;
    private string? _message;
    private string? _addError;

    private string _newName = "";
    private string _newValue = "";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _message = null;
        try
        {
            _secrets = await Svc.ListProjectSecretsAsync(ProjectId);
            Ui.Set("Vault", "encrypted project secrets");
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _loading = false; }
    }

    private async Task AddSecret()
    {
        _addError = null;
        if (string.IsNullOrWhiteSpace(_newName)) { _addError = "Name is required."; return; }
        if (string.IsNullOrEmpty(_newValue)) { _addError = "Value is required."; return; }

        _busy = true;
        try
        {
            await Svc.AddProjectSecretAsync(ProjectId, _newName.Trim(), _newValue);
            _secrets = await Svc.ListProjectSecretsAsync(ProjectId);
            _message = $"Secret '{_newName.Trim()}' saved.";
            _newName = "";
            _newValue = "";
        }
        catch (Exception ex) { _addError = ex.Message; }
        finally { _busy = false; }
    }

    private async Task DeleteSecret(string name)
    {
        _busy = true;
        _message = null;
        try
        {
            await Svc.DeleteProjectSecretAsync(ProjectId, name);
            _secrets = await Svc.ListProjectSecretsAsync(ProjectId);
            _message = $"Secret '{name}' deleted.";
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _busy = false; }
    }
}
