@page "/project/{ProjectId:guid}/secrets"
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@attribute [Authorize(Policy = Permission.SecretsManage)]
@using PlaceContext.Host.Components.ViewModels
@inject SecretsViewModel Vm
@implements IDisposable
<PageTitle>PlaceContext — Vault</PageTitle>
@if (Vm.Loading)
{
    <Skeleton Kind="list" Rows="4" Padded />
}
else
{
    <div class="page">
        <div class="head">
            <h2 class="title">Vault</h2>
        </div>
        <div class="intro">
            Encrypted secrets injected as environment variables into this project's jobs at run time. Values are encrypted at rest and never displayed after creation.
        </div>
        @if (Vm.Message is not null)
        {
            <div class="message">@Vm.Message</div>
        }
        <div class="dccard add-card">
            <div class="add-title">Add secret</div>
            <div class="add-row">
                <input class="dcinput field-input" @bind="Vm.NewName" placeholder="API_KEY" />
                <input class="dcinput field-input" type="password" @bind="Vm.NewValue" placeholder="••••••••" />
                <button class="dcbtn primary" disabled="@Vm.Busy" @onclick="Vm.AddAsync">
                    @(Vm.Busy ? "Saving…" : "Add")
                </button>
            </div>
            @if (Vm.AddError is not null)
            {
                <div class="add-error">@Vm.AddError</div>
            }
        </div>
        @if (Vm.Secrets is null || Vm.Secrets.Count == 0)
        {
            <div class="dccard empty">No secrets yet.</div>
        }
        else
        {
            <div class="list">
                @foreach (var secret in Vm.Secrets)
                {
                    <div class="dccard secret-row">
                        <span class="secret-name">@secret.Name</span>
                        <span class="secret-mask">••••••••</span>
                        <span class="secret-added">added @Vm.CreatedAt(secret)</span>
                        <button class="dcbtn" disabled="@Vm.Busy" @onclick="() => Vm.DeleteAsync(secret.Name)">Delete</button>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }

    protected override async Task OnParametersSetAsync() => await Vm.LoadAsync(ProjectId);

    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));

    public void Dispose() => Vm.Detach();
}
