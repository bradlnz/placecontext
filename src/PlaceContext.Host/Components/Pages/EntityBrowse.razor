@page "/project/{ProjectId:guid}/entity/{EntityName}"
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@attribute [Authorize(Policy = Permission.DataRead)]
@implements IDisposable
@using PlaceContext.Application.Features
@using PlaceContext.Application.Ports
@inject IPlaceContextService Svc
@inject PortalUiState Ui
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>placecontext — @EntityName</PageTitle>

<div class="page-wrap">
    @if (!_loaded)
    {
        <Skeleton Kind="detail" Rows="7" />
    }
    else if (_entity is null)
    {
        <div class="unknown-entity">Unknown entity “@EntityName”. Define it under Data → Entities.</div>
    }
    else
    {
        <div class="header-row">
            <div>
                <h2 class="page-title">@_entity.Name</h2>
                <div class="page-sub">
                    <span class="mono">@_entity.TableName</span>
                    · @(_page?.TotalCount ?? 0) records
                    @if (_entity.Relations.Count > 0)
                    {
                        <span> · related to @string.Join(", ", _entity.Relations.Select(r => r.TargetEntity))</span>
                    }
                </div>
            </div>
            <div class="header-actions">
                <AuthorizeView Policy="@Permission.DataWrite">
                    <Authorized>
                        <button class="dcbtn primary" @onclick="StartCreateAsync">＋ New</button>
                    </Authorized>
                </AuthorizeView>
                <input class="dcinput filter-input" placeholder="search records…"
                       value="@_search" @oninput="OnSearchInput" />
            </div>
        </div>

        @if (_error is not null)
        {
            <div class="error-banner">@_error</div>
        }
        @if (_warnMessage is not null)
        {
            <div class="warn-banner">@_warnMessage</div>
        }

        <div class="dctabs tabs-mb">
            <button class="dctab @(_viewTab == "records" ? "active" : "")" @onclick="@(() => _viewTab = "records")">Records</button>
            <button class="dctab @(_viewTab == "graph" ? "active" : "")" @onclick="@(() => _viewTab = "graph")">Graph</button>
            <button class="dctab @(_viewTab == "analytics" ? "active" : "")" @onclick="OpenAnalyticsAsync">Analytics</button>
        </div>

        @* ── Analytics tab: SQL-backed charts scoped to this entity (same engine as Data → Analytics). ── *@
        @if (_viewTab == "analytics")
        {
            <div class="analytics-head">
                <span class="note-12">Charts over <span class="mono">@_entity.TableName</span> — SELECT-only, isolated to this project.</span>
                <button class="dcbtn sql-chart-btn" @onclick="ToggleChartEditor">＋ SQL chart</button>
            </div>

            @if (_showChartEditor)
            {
                <div class="dccard chart-editor">
                    <input class="dcinput chart-name-input" placeholder="chart name (e.g. price by suburb)" @bind="_chartName" />
                    @if (_chartMonaco)
                    {
                        <div id="@ChartEditorId" class="monaco-box"></div>
                    }
                    else
                    {
                        <textarea @bind="_chartSql" rows="4" spellcheck="false"
                                  class="sql-textarea"></textarea>
                    }
                    <div class="editor-controls">
                        <select class="dcinput chart-type-select" @bind="_chartType">
                            <option value="bar">bar</option>
                            <option value="line">line</option>
                            <option value="pie">pie</option>
                        </select>
                        <button class="dcbtn primary run-save-btn" disabled="@_chartBusy" @onclick="SaveEntityChartAsync">
                            @(_chartBusy ? "Running…" : "▶ Run & save")
                        </button>
                        @if (_chartError is not null)
                        {
                            <span class="chart-err">@_chartError</span>
                        }
                    </div>
                </div>
            }

            @if (EntityCharts() is { Count: 0 })
            {
                <div class="dccard empty-card">
                    No charts yet — the first text column labels, numeric columns become series.
                </div>
            }
            else
            {
                <div class="charts-grid">
                    @foreach (var chart in EntityCharts())
                    {
                        <div class="dccard card-pad">
                            <div class="chart-head">
                                <span class="chart-name">@ChartShortName(chart)</span>
                                <span class="chart-type-group">
                                    @foreach (var t in new[] { "bar", "line", "pie" })
                                    {
                                        <button class="dcbtn chart-type-btn" style="@(StoredType(chart) == t ? "color:var(--brand-2); border-color:var(--brand-2)" : "")"
                                                @onclick="@(() => SwitchChartTypeAsync(chart, t))">@t</button>
                                    }
                                </span>
                                <span class="flex-1"></span>
                                <button class="dcbtn btn-11" @onclick="@(() => RefreshChartAsync(chart))">↻</button>
                                <button class="dcbtn btn-11-del" @onclick="@(() => DeleteChartAsync(chart))">✕</button>
                            </div>
                            <div class="chart-canvas-box">
                                <canvas id="@ChartCanvasId(chart.TableName)"></canvas>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @* ── Graph tab: the full data graph — records, relations, runs, artifacts. ── *@
        @if (_viewTab == "graph")
        {
            @if (_brainGraph is { Nodes.Count: > 0 })
            {
                <div class="dccard graph-card">
                    <GraphCanvas Graph="_brainGraph" Height="520" NodeUrl="NodeUrl" Searchable="true" AllowFullscreen="true" />
                </div>
                @if (_focusKey is not null)
                {
                    <div class="focus-row">
                        <span class="focus-chip">focused: @_focusKey</span>
                        <button class="dcbtn btn-11"
                                @onclick="@(async () => { _focusKey = null; await BuildSectionGraphAsync(); })">show whole graph</button>
                    </div>
                }
                <div class="legend">
                    <span><span class="dot-brand">●</span> @_entity.Name records</span>
                    <span><span class="dot-human">●</span> related records</span>
                    <span><span class="dot-good">●</span> artifacts</span>
                    <span><span class="dot-run">●</span> runs</span>
                    <span>click a node → Open ↗ jumps to it</span>
                </div>
            }
            else
            {
                <div class="dccard empty-card">
                    Nothing linked yet — run a job whose output mentions these records and the graph fills in.
                </div>
            }
        }

        @* ── Insights: organized automatically from the entity's tags — numeric columns roll up,
             relation keys show their distribution. No configuration, just the graph. ── *@
        @if (_viewTab == "records" && _insights.Count > 0)
        {
            <div class="insights-grid">
                @foreach (var ins in _insights)
                {
                    <div class="dccard insight-card">
                        <div class="insight-title">@ins.Title</div>
                        @if (ins.Big is not null)
                        {
                            <div class="insight-big-row">
                                <span class="insight-big">@ins.Big</span>
                                <span class="insight-sub">@ins.Sub</span>
                            </div>
                        }
                        else
                        {
                            <div class="insight-bars">
                                @foreach (var (label, count, frac) in ins.Bars)
                                {
                                    <div class="bar-row">
                                        <span class="bar-label" title="@label">@label</span>
                                        <span class="bar-track">
                                            <span class="bar-fill" style="width:@(frac)%"></span>
                                        </span>
                                        <span class="bar-count">@count</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (_viewTab == "records" && _page is null)
        {
            <Skeleton Kind="table" Rows="8" Columns="4" />
        }

        @if (_viewTab == "records" && _page is { } pg)
        {
            <div class="dccard table-card">
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                @foreach (var c in pg.Columns)
                                {
                                    <th class="data-th">@c</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (pg.Rows.Count == 0)
                            {
                                <tr>
                                    <td class="data-cell no-rows-cell" colspan="@Math.Max(1, pg.Columns.Count)">
                                        @(string.IsNullOrWhiteSpace(_search) ? "No records yet." : "No records match your search.")
                                    </td>
                                </tr>
                            }
                            @foreach (var row in pg.Rows)
                            {
                                <tr class="dcdash-row clickable" @onclick="@(() => OpenRecordAsync(row))">
                                    @for (var i = 0; i < pg.Columns.Count; i++)
                                    {
                                        <td class="data-cell" style="color:@(pg.Columns[i] == LabelCol() ? "var(--text)" : "var(--text-2)"); font-weight:@(pg.Columns[i] == LabelCol() ? "600" : "400")">@(i < row.Count ? row[i] : "")</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="pager-row">
                    <span class="pager-info">
                        @if (pg.TotalCount == 0)
                        {
                            <text>0 records</text>
                        }
                        else
                        {
                            <text>Showing @(((pg.Page - 1) * pg.PageSize) + 1)–@(Math.Min((long)pg.Page * pg.PageSize, pg.TotalCount)) of @pg.TotalCount</text>
                        }
                    </span>
                    <div class="pager-controls">
                        <button class="dcbtn pager-btn" disabled="@(pg.Page <= 1)"
                                @onclick="@(() => GoToPageAsync(pg.Page - 1))">‹ Prev</button>
                        <span class="pager-page">Page @pg.Page of @TotalPages(pg)</span>
                        <button class="dcbtn pager-btn" disabled="@((long)pg.Page * pg.PageSize >= pg.TotalCount)"
                                @onclick="@(() => GoToPageAsync(pg.Page + 1))">Next ›</button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@* ── Record detail / CRM edit modal ────── *@
@if ((_open is not null || _editing) && _entity is not null)
{
    <div class="dcslide-scrim" @onclick="CloseRecordPanel"></div>
    <div class="dcslide slide-560">
        <div class="dcslide-head">
            <div class="flex-min">
                <div class="title-14">@(_creating ? $"New {_entity.Name}" : (_editing ? "Edit record" : RecordLabel(_open!)))</div>
                <div class="sub-115">@_entity.Name</div>
            </div>
            @if (!_editing && _open is not null)
            {
                <button class="dcbtn graph-toggle-btn" style="@(_showGraph ? "color:var(--brand-2); border-color:var(--brand-2)" : "")"
                        @onclick="@(() => _showGraph = !_showGraph)">◉ Graph</button>
                <AuthorizeView Policy="@Permission.DataWrite">
                    <Authorized>
                        <button class="dcbtn graph-toggle-btn" @onclick="StartEditAsync">Edit</button>
                        <button class="dcbtn btn-11-del" @onclick="DeleteOpenAsync">Delete</button>
                    </Authorized>
                </AuthorizeView>
            }
            <button class="dcslide-x" @onclick="CloseRecordPanel">×</button>
        </div>
        <div class="dcslide-body record-body">
            @if (_editError is not null)
            {
                <div class="error-banner">@_editError</div>
            }
            @if (_editing)
            {
                <div class="dccard card-pad crm-form">
                    @foreach (var col in _formColumns)
                    {
                        var inputType = col.Type switch
                        {
                            "integer" or "bigint" or "numeric" or "double" or "real" => "number",
                            "boolean" => "checkbox",
                            "date" => "date",
                            "timestamptz" => "datetime-local",
                            _ => "text"
                        };
                        <label class="crm-label">@col.Name
                            @if (inputType == "checkbox")
                            {
                                <input type="checkbox" class="dccheckbox crm-input" style="margin-top:2px"
                                       checked="@(_formValues.GetValueOrDefault(col.Name) == "true" || _formValues.GetValueOrDefault(col.Name) == "1")"
                                       @onchange="e => ToggleBool(col.Name, (ChangeEventArgs)e)" />
                            }
                            else
                            {
                                <input type="@inputType" class="dcinput crm-input"
                                       value="@(_formValues.GetValueOrDefault(col.Name))"
                                       @oninput="e => _formValues[col.Name] = e.Value?.ToString()" />
                            }
                        </label>
                    }
                    <div class="crm-actions">
                        <button class="dcbtn" @onclick="CloseRecordPanel" disabled="@_saving">Cancel</button>
                        <button class="dcbtn primary" @onclick="SaveRecordAsync" disabled="@_saving">
                            @(_saving ? "Saving…" : (_creating ? "Create" : "Save"))
                        </button>
                    </div>
                </div>
            }
            else if (_open is not null && _rows is not null)
            {
            @if (_showGraph)
            {
                @* ── The link graph: every relation this record participates in, as nodes/edges. ── *@
                @((MarkupString)GraphSvg())
            }
            <div class="dccard card-pad">
                <dl class="field-dl">
                    @for (var i = 0; i < _rows.Columns.Count; i++)
                    {
                        <dt class="field-dt">@_rows.Columns[i]</dt>
                        <dd class="field-dd">@(i < _open.Count ? _open[i] : "")</dd>
                    }
                </dl>
            </div>

            @if (_artifacts.Count > 0)
            {
                <div>
                    <div class="section-label">
                        Artifacts <span class="label-normal">from runs tagged with this record</span>
                    </div>
                    @foreach (var (a, versions) in _artifacts)
                    {
                        <a href="@($"/artifacts?artifact={a.Id}")"
                           class="artifact-link">
                            <span class="artifact-title">@a.Title</span>
                            @if (versions > 1)
                            {
                                <span title="@versions versions — this is the latest" class="version-badge">v@(versions)</span>
                            }
                            <span class="artifact-meta">@a.Kind · @a.CreatedAt.ToWorkspaceTime().ToString("MMM d · HH:mm")</span>
                        </a>
                    }
                </div>
            }

            @foreach (var (relation, related) in _related)
            {
                <div>
                    <div class="section-label">
                        @relation.TargetEntity <span class="label-normal">via @relation.Column ↔ @relation.TargetColumn</span>
                    </div>
                    @if (related.Rows.Count == 0)
                    {
                        <div class="note-12">no related records</div>
                    }
                    else
                    {
                        @foreach (var r in related.Rows.Take(8))
                        {
                            var recordKey = r.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? "";
                            <a href="@($"/project/{ProjectId}/entity/{Uri.EscapeDataString(relation.TargetEntity)}?record={Uri.EscapeDataString(recordKey)}")"
                               class="dccard dcdash-row related-link">
                                @for (var i = 0; i < Math.Min(related.Columns.Count, 4); i++)
                                {
                                    <span class="ellipsis" style="color:@(i == 0 ? "var(--text)" : "var(--text-3)")">@(i < r.Count ? r[i] : "")</span>
                                }
                                <span class="related-arrow">→</span>
                            </a>
                        }
                    }
                </div>
            }

            @if (_autoLinks.Count > 0)
            {
                <div>
                    <div class="section-label">Auto-linked records</div>
                    @foreach (var link in _autoLinks)
                    {
                        <div class="dccard dcdash-row auto-link">
                            <span class="link-kind">@link.Kind</span>
                            <span class="ellipsis">@link.DisplayValue</span>
                            <span class="link-meta">@link.TableName · @link.ColumnName · @link.RowKey</span>
                        </div>
                    }
                </div>
            }
            } @* end view mode *@
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public string EntityName { get; set; } = "";

    /// <summary>Search deep link: focuses the graph on this record. Supplied from the query so
    /// clicking a search hit while already on the page re-applies without a manual refresh.</summary>
    [SupplyParameterFromQuery(Name = "record")] public string? RecordKey { get; set; }

    private DataEntityView? _entity;
    private IReadOnlyList<DataEntityView> _all = Array.Empty<DataEntityView>();
    private PlaceContext.Application.Ports.ProjectQueryResult? _rows;
    private IReadOnlyList<string?>? _open;
    private readonly List<(EntityRelationDto Relation, PlaceContext.Application.Ports.ProjectQueryResult Rows)> _related = new();
    private IReadOnlyList<RecordLink> _autoLinks = Array.Empty<RecordLink>();
    private string? _error;
    private string? _warnMessage;
    private bool _editing, _creating, _saving;
    private string? _editError;
    private record FormColumn(string Name, string Type);
    private List<FormColumn> _formColumns = new();
    private Dictionary<string, string?> _formValues = new(StringComparer.Ordinal);
    private Dictionary<string, string?> _keySnapshot = new(StringComparer.Ordinal);

    // ── Records tab: server-side pagination + search over the entity's table (the store binds the
    // search term as a parameter — see NpgsqlProjectDataStore.QueryTablePageAsync). ──
    private PlaceContext.Application.Ports.ProjectTablePageResult? _page;
    private string _search = "";
    private int _pageNum = 1;
    private const int RecordsPageSize = 50;
    private CancellationTokenSource? _searchDebounce;
    private string _viewTab = "records";
    private bool _loaded;   // entity list resolved — gates the load skeleton vs the not-found message

    // ── Entity analytics: SQL charts namespaced "{Entity} · {name}" on the shared chart engine. ──
    private IReadOnlyList<ProjectChartView> _charts = Array.Empty<ProjectChartView>();
    private bool _showChartEditor, _chartBusy;
    private string _chartName = "", _chartSql = "", _chartType = "bar";
    private string? _chartError;
    private bool _chartMonaco = true;   // degrade to the textarea when the Monaco CDN is unreachable
    private bool _chartMonacoReady;
    private const string ChartEditorId = "pcmonaco-entchart";
    private readonly Dictionary<string, DateTimeOffset> _renderedCharts = new();

    private string ChartPrefix => $"sql:{_entity?.Name} · ";
    private bool _defaultsTried;

    private async Task OpenAnalyticsAsync()
    {
        _viewTab = "analytics";
        // Leaving the tab destroys the canvases, so the render cache must not survive re-entry.
        _renderedCharts.Clear();
        _chartMonacoReady = false;
        await EnsureDefaultChartsAsync();
    }

    // Default charts: when an entity has none, seed a few sensible ones straight from its schema —
    // a count distribution, a numeric average per category, and a relation-key pie. They persist
    // as ordinary SQL charts, so they're editable, refreshable, and deletable like any other.
    private async Task EnsureDefaultChartsAsync()
    {
        if (_defaultsTried || _entity is null || EntityCharts().Count > 0) return;
        _defaultsTried = true;
        try
        {
            var table = _entity.TableName.Replace("\"", "");
            var columns = await Svc.ListProjectTableColumnsAsync(ProjectId, _entity.TableName);
            var categorical = _entity.Relations.Select(r => r.Column)
                .Concat(columns.Where(c => (c.Type.Contains("text") || c.Type.Contains("char"))
                    && !string.Equals(c.Name, _entity.LabelColumn, StringComparison.OrdinalIgnoreCase)).Select(c => c.Name))
                .Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            var numeric = columns.Where(c => (c.Type.Contains("int") || c.Type.Contains("numeric") || c.Type.Contains("double") || c.Type.Contains("real"))
                    && !string.Equals(c.Name, "id", StringComparison.OrdinalIgnoreCase))
                .Select(c => c.Name).ToList();

            async Task Seed(string name, string sql, string type)
            {
                try { await Svc.SaveSqlChartAsync(ProjectId, $"{_entity.Name} · {name}", sql, type); } catch { }
            }

            if (categorical.FirstOrDefault() is { } cat)
            {
                await Seed($"records by {cat}",
                    $"SELECT \"{cat}\"::text, count(*) FROM \"{table}\" GROUP BY 1 ORDER BY 2 DESC LIMIT 10", "bar");
                if (numeric.FirstOrDefault() is { } num)
                    await Seed($"avg {num} by {cat}",
                        $"SELECT \"{cat}\"::text, round(avg(\"{num}\")::numeric, 1) FROM \"{table}\" GROUP BY 1 ORDER BY 2 DESC LIMIT 10", "bar");
                if (categorical.Skip(1).FirstOrDefault() is { } cat2)
                    await Seed($"share by {cat2}",
                        $"SELECT \"{cat2}\"::text, count(*) FROM \"{table}\" GROUP BY 1 ORDER BY 2 DESC LIMIT 8", "pie");
            }
            else if (numeric.FirstOrDefault() is { } num && LabelCol() is { } label)
            {
                await Seed($"{num} by {label}",
                    $"SELECT \"{label.Replace("\"", "")}\"::text, \"{num}\" FROM \"{table}\" ORDER BY 2 DESC LIMIT 12", "bar");
            }

            _charts = await Svc.ListProjectChartsAsync(ProjectId);
        }
        catch { /* defaults are a convenience — the tab still works empty */ }
    }

    private IReadOnlyList<ProjectChartView> EntityCharts()
        => _charts.Where(c => c.TableName.StartsWith(ChartPrefix, StringComparison.OrdinalIgnoreCase)).ToList();

    private string ChartShortName(ProjectChartView c) => c.TableName[ChartPrefix.Length..];

    private static string ChartCanvasId(string slot)
        => "pcentchart-" + Convert.ToHexString(System.Security.Cryptography.MD5.HashData(
               System.Text.Encoding.UTF8.GetBytes(slot)))[..12];

    private void ToggleChartEditor()
    {
        _showChartEditor = !_showChartEditor;
        _chartMonacoReady = false;   // the editor div remounts each time the pane opens
        _chartError = null;
        if (_showChartEditor && string.IsNullOrWhiteSpace(_chartSql) && _entity is not null)
            _chartSql = $"SELECT \"{LabelCol()}\", count(*) FROM \"{_entity.TableName}\" GROUP BY 1 ORDER BY 2 DESC LIMIT 10";
    }

    private async Task SaveEntityChartAsync()
    {
        if (_entity is null) return;
        if (_chartMonaco && _chartMonacoReady)
        {
            try { _chartSql = await JS.InvokeAsync<string>("pcmonaco.getValue", ChartEditorId); } catch { }
        }
        _chartError = null;
        if (string.IsNullOrWhiteSpace(_chartName)) { _chartError = "Give the chart a name."; return; }
        _chartBusy = true;
        try
        {
            await Svc.SaveSqlChartAsync(ProjectId, $"{_entity.Name} · {_chartName.Trim()}", _chartSql, _chartType);
            _charts = await Svc.ListProjectChartsAsync(ProjectId);
            _showChartEditor = false;
            _chartName = "";
        }
        catch (Exception ex) { _chartError = ex.Message; }
        finally { _chartBusy = false; }
    }

    private async Task SwitchChartTypeAsync(ProjectChartView chart, string type)
    {
        if (StoredSql(chart) is not { } sql || StoredType(chart) == type) return;
        try
        {
            await Svc.SaveSqlChartAsync(ProjectId, chart.TableName["sql:".Length..], sql, type);
            _charts = await Svc.ListProjectChartsAsync(ProjectId);
        }
        catch (Exception ex) { _chartError = ex.Message; }
    }

    private async Task RefreshChartAsync(ProjectChartView chart)
    {
        if (StoredSql(chart) is not { } sql) return;
        try
        {
            await Svc.SaveSqlChartAsync(ProjectId, chart.TableName["sql:".Length..], sql, StoredType(chart));
            _charts = await Svc.ListProjectChartsAsync(ProjectId);
        }
        catch (Exception ex) { _chartError = ex.Message; }
    }

    private async Task DeleteChartAsync(ProjectChartView chart)
    {
        try
        {
            await Svc.DeleteSqlChartAsync(ProjectId, chart.TableName["sql:".Length..]);
            _charts = await Svc.ListProjectChartsAsync(ProjectId);
        }
        catch (Exception ex) { _chartError = ex.Message; }
    }

    private static string? StoredSql(ProjectChartView chart)
    {
        try { return System.Text.Json.Nodes.JsonNode.Parse(chart.Html)?["sql"]?.GetValue<string>(); }
        catch { return null; }
    }

    private static string StoredType(ProjectChartView chart)
    {
        try { return System.Text.Json.Nodes.JsonNode.Parse(chart.Html)?["type"]?.GetValue<string>() ?? "bar"; }
        catch { return "bar"; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_viewTab != "analytics") return;
        if (_showChartEditor && _chartMonaco && !_chartMonacoReady)
        {
            _chartMonacoReady = true;
            try
            {
                var rich = await JS.InvokeAsync<bool>("pcmonaco.init", ChartEditorId, _chartSql, "sql", "vs-dark");
                if (!rich) { _chartMonaco = false; StateHasChanged(); }
            }
            catch { _chartMonaco = false; StateHasChanged(); }
        }
        foreach (var chart in EntityCharts().Where(c => c.Html.TrimStart().StartsWith('{')))
        {
            var id = ChartCanvasId(chart.TableName);
            if (_renderedCharts.TryGetValue(id, out var at) && at == chart.GeneratedAt) continue;
            try
            {
                await JS.InvokeVoidAsync("pcchart.render", id, chart.Html);
                _renderedCharts[id] = chart.GeneratedAt;
            }
            catch (JSException) { /* canvas not on screen yet — the next render pass retries */ }
        }
    }
    private string? _focusKey;   // set by search deep links: the graph renders only this record's neighbourhood

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        _open = null;
        _loaded = false;
        try
        {
            _all = await Svc.ListDataEntitiesAsync(ProjectId);
            _entity = _all.FirstOrDefault(e => string.Equals(e.Name, EntityName, StringComparison.OrdinalIgnoreCase));
            if (_entity is null) return;
            Ui.Set(_entity.Name, "business view · project data graph");
            // Read through the project's isolated role; identifier comes from the registry, quoted.
            _rows = await Svc.ExecuteProjectDataAsync(ProjectId, $"SELECT * FROM \"{_entity.TableName}\" LIMIT 500");
            try { _charts = await Svc.ListProjectChartsAsync(ProjectId); } catch { }

            // Search deep link: /entity/{name}?record={key} lands on the GRAPH, scoped to just
            // that record's neighbourhood — the search result IS the node.
            _focusKey = null;
            if (RecordKey is { Length: > 0 } recordKey
                && _rows is not null
                && _rows.Rows.Any(r => r.Any(v => string.Equals(v, recordKey, StringComparison.OrdinalIgnoreCase))))
            {
                _focusKey = recordKey;
                _viewTab = "graph";
            }
            await BuildInsightsAsync();
            await BuildSectionGraphAsync();

            // A new entity (or a fresh navigation to the same one) always starts unfiltered on page 1.
            _search = "";
            _pageNum = 1;
            await LoadRecordsPageAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loaded = true; }
    }

    // ── Records tab: server-side pagination + search ────────────────────────────────────────────
    private async Task LoadRecordsPageAsync()
    {
        if (_entity is null) return;
        try
        {
            _page = await Svc.QueryProjectTablePageAsync(ProjectId, _entity.TableName, _search, _pageNum, RecordsPageSize);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private static int TotalPages(PlaceContext.Application.Ports.ProjectTablePageResult page)
        => Math.Max(1, (int)Math.Ceiling(page.TotalCount / (double)Math.Max(1, page.PageSize)));

    private async Task GoToPageAsync(int page)
    {
        if (_page is null) return;
        var target = Math.Clamp(page, 1, TotalPages(_page));
        if (target == _pageNum) return;
        _pageNum = target;
        await LoadRecordsPageAsync();
    }

    // Debounced so every keystroke doesn't fire a round trip — only the last one, ~300ms after typing stops.
    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _pageNum = 1;
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
        var cts = new CancellationTokenSource();
        _searchDebounce = cts;
        try
        {
            await Task.Delay(300, cts.Token);
        }
        catch (TaskCanceledException) { return; }
        if (cts.IsCancellationRequested) return;
        await LoadRecordsPageAsync();
        StateHasChanged();
    }

    public void Dispose()
    {
        _searchDebounce?.Cancel();
        _searchDebounce?.Dispose();
    }

    // The record label: the configured column when it exists; otherwise the first column that
    // looks like text (skipping ids and provenance) — a lost label config must never reduce the
    // graph to row numbers.
    private string? LabelCol()
    {
        if (_rows is null) return _entity?.LabelColumn;
        var cols = _rows.Columns;
        if (_entity?.LabelColumn is { Length: > 0 } configured
            && cols.FirstOrDefault(c => string.Equals(c, configured, StringComparison.OrdinalIgnoreCase)) is { } exact)
            return exact;
        for (var i = 0; i < cols.Count; i++)
        {
            var c = cols[i];
            if (string.Equals(c, "id", StringComparison.OrdinalIgnoreCase)
                || c.EndsWith("_id", StringComparison.OrdinalIgnoreCase)
                || string.Equals(c, "ingested_at", StringComparison.OrdinalIgnoreCase)) continue;
            var v = _rows.Rows.FirstOrDefault() is { } first && i < first.Count ? first[i] : null;
            if (v is null || double.TryParse(v, out _)) continue;
            return c;
        }
        return cols.FirstOrDefault();
    }

    private string RecordLabel(IReadOnlyList<string?> row)
    {
        if (_rows is null) return _entity?.Name ?? "";
        var idx = LabelCol() is { } c ? _rows.Columns.ToList().IndexOf(c) : 0;
        return (idx >= 0 && idx < row.Count ? row[idx] : null) ?? _entity?.Name ?? "";
    }

    private readonly List<(RunArtifactLinkView Art, int Versions)> _artifacts = new();
    private readonly List<Guid> _linkedRuns = new();
    private readonly Dictionary<Guid, List<RunArtifactLinkView>> _runArtifacts = new();
    private bool _showGraph;

    private async Task OpenRecordAsync(IReadOnlyList<string?> row)
    {
        _open = row;
        _related.Clear();
        _autoLinks = Array.Empty<RecordLink>();
        _artifacts.Clear();
        _linkedRuns.Clear();
        _runArtifacts.Clear();
        _showGraph = false;
        if (_entity is null || _rows is null) return;
        await LoadLinkedArtifactsAsync(row);
        await LoadAutoLinksAsync(row);
        foreach (var rel in _entity.Relations)
        {
            var target = _all.FirstOrDefault(e => string.Equals(e.Name, rel.TargetEntity, StringComparison.OrdinalIgnoreCase));
            var colIdx = _rows.Columns.ToList().FindIndex(c => string.Equals(c, rel.Column, StringComparison.OrdinalIgnoreCase));
            if (target is null || colIdx < 0 || colIdx >= row.Count || row[colIdx] is not { } value) continue;
            try
            {
                // The graph hop: matching records on the related entity, value passed as a literal
                // with quotes escaped (the query still runs as the isolated project role).
                var related = await Svc.ExecuteProjectDataAsync(ProjectId,
                    $"SELECT * FROM \"{target.TableName}\" WHERE \"{rel.TargetColumn}\"::text = '{value.Replace("'", "''")}' LIMIT 20");
                _related.Add((rel, related));
            }
            catch { /* a broken relation must not break the record view */ }
        }
    }

    private async Task LoadAutoLinksAsync(IReadOnlyList<string?> row)
    {
        if (_entity is null || _rows is null) return;
        try
        {
            var columns = await Svc.ListProjectTableColumnsAsync(ProjectId, _entity.TableName);
            var rowKey = ComputeRowKey(_entity.TableName, row, _rows.Columns, _all, columns);
            if (string.IsNullOrEmpty(rowKey)) return;
            _autoLinks = await Svc.RelatedRecordLinksAsync(ProjectId, _entity.TableName, rowKey);
        }
        catch { /* auto-links are best-effort display sugar */ }
    }

    private void CloseRecordPanel()
    {
        _open = null;
        _editing = _creating = false;
        _editError = null;
        _warnMessage = null;
        _autoLinks = Array.Empty<RecordLink>();
        _formValues.Clear();
        _keySnapshot.Clear();
    }

    private static string ComputeRowKey(string table, IReadOnlyList<string?> row, IReadOnlyList<string> colNames,
        IReadOnlyList<DataEntityView> entities, IReadOnlyList<ProjectColumnInfo> columns)
    {
        var colNamesList = colNames.ToList();
        var entity = entities.FirstOrDefault(e => string.Equals(e.TableName, table, StringComparison.OrdinalIgnoreCase));
        if (entity?.LabelColumn is { Length: > 0 } label)
        {
            var li = colNamesList.FindIndex(c => string.Equals(c, label, StringComparison.OrdinalIgnoreCase));
            if (li >= 0 && li < row.Count && !string.IsNullOrEmpty(row[li])) return row[li]!;
        }
        var values = columns
            .Where(c => c.Type is "text" or "citext" || c.Type.StartsWith("character", StringComparison.Ordinal) || c.Type.StartsWith("varchar", StringComparison.Ordinal))
            .Select(c => c.Name)
            .Take(3)
            .Select(name => { var i = colNamesList.FindIndex(n => string.Equals(n, name, StringComparison.OrdinalIgnoreCase)); return i >= 0 && i < row.Count ? row[i] : null; })
            .Where(v => !string.IsNullOrEmpty(v));
        return string.Join(" · ", values);
    }

    private async Task StartEditAsync()
    {
        if (_entity is null) return;
        _creating = false;
        _editing = true;
        _editError = null;
        // Fetch column types for proper input rendering; fall back to "text".
        var columnInfos = (await Svc.ListProjectTableColumnsAsync(ProjectId, _entity.TableName))
            .ToDictionary(c => c.Name, c => c.Type, StringComparer.Ordinal);
        _formColumns = (_rows.Columns ?? Array.Empty<string>()).Select(c => new FormColumn(c, columnInfos.GetValueOrDefault(c, "text"))).ToList();
        _formValues = new Dictionary<string, string?>(StringComparer.Ordinal);
        _keySnapshot = new Dictionary<string, string?>(StringComparer.Ordinal);
        for (var i = 0; i < _formColumns.Count; i++)
        {
            var v = i < _open.Count ? _open[i] : null;
            _formValues[_formColumns[i].Name] = v;
            _keySnapshot[_formColumns[i].Name] = v;
        }
        // Narrow keys to identity columns when possible.
        var label = LabelCol();
        if (label is not null && _keySnapshot.ContainsKey(label))
            _keySnapshot = new Dictionary<string, string?>(StringComparer.Ordinal)
                { [label] = _keySnapshot[label] };
        else
        {
            var kept = _keySnapshot.Where(kv => !string.IsNullOrEmpty(kv.Value)).Take(3)
                .ToDictionary(kv => kv.Key, kv => kv.Value, StringComparer.Ordinal);
            if (kept.Count > 0) _keySnapshot = kept;
        }
    }

    private async Task StartCreateAsync()
    {
        if (_entity is null) return;
        _creating = true;
        _editing = true;
        _open = null;
        _editError = null;
        var columnInfos = await Svc.ListProjectTableColumnsAsync(ProjectId, _entity.TableName);
        _formColumns = columnInfos.Select(c => new FormColumn(c.Name, c.Type)).ToList();
        if (_formColumns.Count == 0 && _page is { Columns.Count: > 0 })
            _formColumns = _page.Columns.Select(c => new FormColumn(c, "text")).ToList();
        _formValues = _formColumns.ToDictionary(c => c.Name, _ => (string?)null, StringComparer.Ordinal);
        _keySnapshot.Clear();
    }

    private async Task SaveRecordAsync()
    {
        if (_entity is null || _formValues.Count == 0) return;
        _saving = true;
        _editError = null;
        _warnMessage = null;
        try
        {
            if (_creating)
            {
                var created = await Svc.CreateEntityRecordAsync(ProjectId, _entity.TableName, _formValues);
                _warnMessage = created.DuplicateWarnings.Count > 0
                    ? "Created — possible duplicate(s): " + string.Join("; ", created.DuplicateWarnings)
                    : null;
            }
            else
            {
                await Svc.UpdateEntityRecordAsync(ProjectId, _entity.TableName, _keySnapshot, _formValues);
            }
            CloseRecordPanel();
            await ReloadPageAsync();
        }
        catch (Exception ex)
        {
            _editError = ex.Message;
        }
        finally { _saving = false; }
    }

    private async Task DeleteOpenAsync()
