@page "/project/{ProjectId:guid}/entity/{EntityName}"
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@attribute [Authorize(Policy = Permission.DataRead)]
@implements IDisposable
@using PlaceContext.Application.Features
@using PlaceContext.Application.Ports
@using PlaceContext.Host.Components.ViewModels
@using PlaceContext.Host.Components.ViewModels.Helpers
@inject EntityBrowseViewModel Vm
@inject PortalUiState Ui
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>placecontext — @EntityName</PageTitle>

<div class="page-wrap">
    @if (!Vm.Loaded)
    {
        <Skeleton Kind="detail" Rows="7" />
    }
    else if (Vm.Entity is null)
    {
        <div class="unknown-entity">Unknown entity "@EntityName". Define it under Data → Entities.</div>
    }
    else
    {
        <div class="header-row">
            <div>
                <h2 class="page-title">@Vm.Entity.Name</h2>
                <div class="page-sub">
                    <span class="mono">@Vm.Entity.TableName</span>
                    · @(Vm.Page?.TotalCount ?? 0) records
                    @if (Vm.Entity.Relations.Count > 0)
                    {
                        <span> · related to @string.Join(", ", Vm.Entity.Relations.Select(r => r.TargetEntity))</span>
                    }
                </div>
            </div>
            <div class="header-actions">
                <AuthorizeView Policy="@Permission.DataWrite">
                    <Authorized>
                        <button class="dcbtn primary" @onclick="() => Vm.StartCreateAsync()">＋ New</button>
                    </Authorized>
                </AuthorizeView>
                <input class="dcinput filter-input" placeholder="search records…"
                       value="@Vm.Search" @oninput="OnSearchInput" />
            </div>
        </div>

        @if (Vm.Error is not null)
        {
            <div class="error-banner">@Vm.Error</div>
        }
        @if (Vm.WarnMessage is not null)
        {
            <div class="warn-banner">@Vm.WarnMessage</div>
        }

        <div class="dctabs tabs-mb">
            <button class="dctab @(Vm.ViewTab == "records" ? "active" : "")" @onclick="@(() => Vm.ViewTab = "records")">Records</button>
            <button class="dctab @(Vm.ViewTab == "graph" ? "active" : "")" @onclick="@(() => Vm.ViewTab = "graph")">Graph</button>
            <button class="dctab @(Vm.ViewTab == "analytics" ? "active" : "")" @onclick="OpenAnalyticsAsync">Analytics</button>
        </div>

        @if (Vm.ViewTab == "analytics")
        {
            <div class="analytics-head">
                <span class="note-12">Charts over <span class="mono">@Vm.Entity.TableName</span> — SELECT-only, isolated to this project.</span>
                <button class="dcbtn sql-chart-btn" @onclick="() => Vm.ToggleChartEditor()">＋ SQL chart</button>
            </div>

            @if (Vm.ShowChartEditor)
            {
                <div class="dccard chart-editor">
                    <input class="dcinput chart-name-input" placeholder="chart name (e.g. price by suburb)" @bind="Vm.ChartName" />
                    @if (Vm.ChartMonaco)
                    {
                        <div id="@EntityBrowseViewModel.ChartEditorId" class="monaco-box"></div>
                    }
                    else
                    {
                        <textarea @bind="Vm.ChartSql" rows="4" spellcheck="false"
                                  class="sql-textarea"></textarea>
                    }
                    <div class="editor-controls">
                        <select class="dcinput chart-type-select" @bind="Vm.ChartType">
                            <option value="bar">bar</option>
                            <option value="line">line</option>
                            <option value="pie">pie</option>
                        </select>
                        <button class="dcbtn primary run-save-btn" disabled="@Vm.ChartBusy" @onclick="SaveChartAsync">
                            @(Vm.ChartBusy ? "Running…" : "▶ Run & save")
                        </button>
                        @if (Vm.ChartError is not null)
                        {
                            <span class="chart-err">@Vm.ChartError</span>
                        }
                    </div>
                </div>
            }

            @if (Vm.EntityCharts() is { Count: 0 })
            {
                <div class="dccard empty-card">
                    No charts yet — the first text column labels, numeric columns become series.
                </div>
            }
            else
            {
                <div class="charts-grid">
                    @foreach (var chart in Vm.EntityCharts())
                    {
                        <div class="dccard card-pad">
                            <div class="chart-head">
                                <span class="chart-name">@Vm.ChartShortName(chart)</span>
                                <span class="chart-type-group">
                                    @foreach (var t in new[] { "bar", "line", "pie" })
                                    {
                                        <button class="dcbtn chart-type-btn" style="@(EntityBrowseViewModel.StoredType(chart) == t ? "color:var(--brand-2); border-color:var(--brand-2)" : "")"
                                                @onclick="@(() => Vm.SwitchChartTypeAsync(chart, t))">@t</button>
                                    }
                                </span>
                                <span class="flex-1"></span>
                                <button class="dcbtn btn-11" @onclick="@(() => Vm.RefreshChartAsync(chart))">↻</button>
                                <button class="dcbtn btn-11-del" @onclick="@(() => Vm.DeleteChartAsync(chart))">✕</button>
                            </div>
                            <div class="chart-canvas-box">
                                <canvas id="@EntityBrowseViewModel.ChartCanvasId(chart.TableName)"></canvas>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @if (Vm.ViewTab == "graph")
        {
            @if (Vm.BrainGraph is { Nodes.Count: > 0 })
            {
                <div class="dccard graph-card">
                    <GraphCanvas Graph="Vm.BrainGraph" Height="520" NodeUrl="Vm.NodeUrl" Searchable="true" AllowFullscreen="true" />
                </div>
                @if (Vm.FocusKey is not null)
                {
                    <div class="focus-row">
                        <span class="focus-chip">focused: @Vm.FocusKey</span>
                        <button class="dcbtn btn-11"
                                @onclick="@ClearFocusAsync">show whole graph</button>
                    </div>
                }
                <div class="legend">
                    <span><span class="dot-brand">●</span> @Vm.Entity.Name records</span>
                    <span><span class="dot-human">●</span> related records</span>
                    <span><span class="dot-good">●</span> artifacts</span>
                    <span><span class="dot-run">●</span> runs</span>
                    <span>click a node → Open ↗ jumps to it</span>
                </div>
            }
            else
            {
                <div class="dccard empty-card">
                    Nothing linked yet — run a job whose output mentions these records and the graph fills in.
                </div>
            }
        }

        @if (Vm.ViewTab == "records" && Vm.Insights.Count > 0)
        {
            <div class="insights-grid">
                @foreach (var ins in Vm.Insights)
                {
                    <div class="dccard insight-card">
                        <div class="insight-title">@ins.Title</div>
                        @if (ins.Big is not null)
                        {
                            <div class="insight-big-row">
                                <span class="insight-big">@ins.Big</span>
                                <span class="insight-sub">@ins.Sub</span>
                            </div>
                        }
                        else
                        {
                            <div class="insight-bars">
                                @foreach (var (label, count, frac) in ins.Bars)
                                {
                                    <div class="bar-row">
                                        <span class="bar-label" title="@label">@label</span>
                                        <span class="bar-track">
                                            <span class="bar-fill" style="width:@(frac)%"></span>
                                        </span>
                                        <span class="bar-count">@count</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }

        @if (Vm.ViewTab == "records" && Vm.Page is null)
        {
            <Skeleton Kind="table" Rows="8" Columns="4" />
        }

        @if (Vm.ViewTab == "records" && Vm.Page is { } pg)
        {
            <div class="dccard table-card">
                <div class="table-scroll">
                    <table class="data-table">
                        <thead>
                            <tr>
                                @foreach (var c in pg.Columns)
                                {
                                    <th class="data-th">@c</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (pg.Rows.Count == 0)
                            {
                                <tr>
                                    <td class="data-cell no-rows-cell" colspan="@Math.Max(1, pg.Columns.Count)">
                                        @(string.IsNullOrWhiteSpace(Vm.Search) ? "No records yet." : "No records match your search.")
                                    </td>
                                </tr>
                            }
                            @foreach (var row in pg.Rows)
                            {
                                <tr class="dcdash-row clickable" @onclick="@(() => OpenRecordAsync(row))">
                                    @for (var i = 0; i < pg.Columns.Count; i++)
                                    {
                                        var cell = i < row.Count ? row[i] : null;
                                        <td class="data-cell" style="color:@(pg.Columns[i] == Vm.LabelCol() ? "var(--text)" : "var(--text-2)"); font-weight:@(pg.Columns[i] == Vm.LabelCol() ? "600" : "400")">
                                            <OpenSearchDataValue ProjectId="ProjectId" Column="@pg.Columns[i]" Value="@cell" />
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="pager-row">
                    <span class="pager-info">
                        @if (pg.TotalCount == 0)
                        {
                            <text>0 records</text>
                        }
                        else
                        {
                            <text>Showing @(((pg.Page - 1) * pg.PageSize) + 1)–@(Math.Min((long)pg.Page * pg.PageSize, pg.TotalCount)) of @pg.TotalCount</text>
                        }
                    </span>
                    <div class="pager-controls">
                        <button class="dcbtn pager-btn" disabled="@(pg.Page <= 1)"
                                @onclick="@(() => Vm.GoToPageAsync(pg.Page - 1))">‹ Prev</button>
                        <span class="pager-page">Page @pg.Page of @EntityBrowseViewModel.TotalPages(pg)</span>
                        <button class="dcbtn pager-btn" disabled="@((long)pg.Page * pg.PageSize >= pg.TotalCount)"
                                @onclick="@(() => Vm.GoToPageAsync(pg.Page + 1))">Next ›</button>
                    </div>
                </div>
            </div>
        }
    }
</div>

@* ── Record detail / CRM edit modal ────── *@
@if ((Vm.Open is not null || Vm.Editing) && Vm.Entity is not null)
{
    <div class="dcslide-scrim" @onclick="() => Vm.CloseRecordPanel()"></div>
    <div class="dcslide slide-560">
        <div class="dcslide-head">
            <div class="flex-min">
                <div class="title-14">@(Vm.Creating ? $"New {Vm.Entity.Name}" : (Vm.Editing ? "Edit record" : Vm.RecordLabel(Vm.Open!)))</div>
                <div class="sub-115">@Vm.Entity.Name</div>
            </div>
            @if (!Vm.Editing && Vm.Open is not null)
            {
                <button class="dcbtn graph-toggle-btn" style="@(Vm.ShowGraph ? "color:var(--brand-2); border-color:var(--brand-2)" : "")"
                        @onclick="@(() => Vm.ShowGraph = !Vm.ShowGraph)">◉ Graph</button>
                <AuthorizeView Policy="@Permission.DataWrite">
                    <Authorized>
                        <button class="dcbtn graph-toggle-btn" @onclick="() => Vm.StartEditAsync()">Edit</button>
                        <button class="dcbtn btn-11-del" @onclick="() => Vm.DeleteOpenAsync()">Delete</button>
                    </Authorized>
                </AuthorizeView>
            }
            <button class="dcslide-x" @onclick="() => Vm.CloseRecordPanel()">×</button>
        </div>
        <div class="dcslide-body record-body">
            @if (Vm.EditError is not null)
            {
                <div class="error-banner">@Vm.EditError</div>
            }
            @if (Vm.Editing)
            {
                <div class="dccard card-pad crm-form">
                    @foreach (var col in Vm.FormColumns)
                    {
                        var inputType = col.Type switch
                        {
                            "integer" or "bigint" or "numeric" or "double" or "real" => "number",
                            "boolean" => "checkbox",
                            "date" => "date",
                            "timestamptz" => "datetime-local",
                            _ => "text"
                        };
                        <label class="crm-label">@col.Name
                            @if (inputType == "checkbox")
                            {
                                <input type="checkbox" class="dccheckbox crm-input" style="margin-top:2px"
                                       checked="@(Vm.FormValues.GetValueOrDefault(col.Name) == "true" || Vm.FormValues.GetValueOrDefault(col.Name) == "1")"
                                       @onchange="e => ToggleBool(col.Name, (ChangeEventArgs)e)" />
                            }
                            else
                            {
                                <input type="@inputType" class="dcinput crm-input"
                                       value="@(Vm.FormValues.GetValueOrDefault(col.Name))"
                                       @oninput="e => Vm.FormValues[col.Name] = e.Value?.ToString()" />
                            }
                        </label>
                    }
                    <div class="crm-actions">
                        <button class="dcbtn" @onclick="() => Vm.CloseRecordPanel()" disabled="@Vm.Saving">Cancel</button>
                        <button class="dcbtn primary" @onclick="() => Vm.SaveRecordAsync()" disabled="@Vm.Saving">
                            @(Vm.Saving ? "Saving…" : (Vm.Creating ? "Create" : "Save"))
                        </button>
                    </div>
                </div>
            }
            else if (Vm.Open is not null && Vm.Rows is not null)
            {
            @if (Vm.ShowGraph)
            {
                @((MarkupString)Vm.GraphSvg())
            }
            <div class="dccard card-pad">
                <dl class="field-dl">
                    @for (var i = 0; i < Vm.Rows.Columns.Count; i++)
                    {
                        <dt class="field-dt">@Vm.Rows.Columns[i]</dt>
                        var cell = i < Vm.Open.Count ? Vm.Open[i] : null;
                        <dd class="field-dd">
                            <OpenSearchDataValue ProjectId="ProjectId" Column="@Vm.Rows.Columns[i]" Value="@cell" />
                        </dd>
                    }
                </dl>
            </div>

            @if (Vm.Artifacts.Count > 0)
            {
                <div>
                    <div class="section-label">
                        Artifacts <span class="label-normal">from runs tagged with this record</span>
                    </div>
                    @foreach (var (a, versions) in Vm.Artifacts)
                    {
                        <a href="@($"/artifacts?artifact={a.Id}")"
                           class="artifact-link">
                            <span class="artifact-title">@a.Title</span>
                            @if (versions > 1)
                            {
                                <span title="@versions versions — this is the latest" class="version-badge">v@(versions)</span>
                            }
                            <span class="artifact-meta">@a.Kind · @a.CreatedAt.ToWorkspaceTime().ToString("MMM d · HH:mm")</span>
                        </a>
                    }
                </div>
            }

            @foreach (var (relation, related) in Vm.Related)
            {
                <div>
                    <div class="section-label">
                        @relation.TargetEntity <span class="label-normal">via @relation.Column ↔ @relation.TargetColumn</span>
                    </div>
                    @if (related.Rows.Count == 0)
                    {
                        <div class="note-12">no related records</div>
                    }
                    else
                    {
                        @foreach (var r in related.Rows.Take(8))
                        {
                            var recordKey = r.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v)) ?? "";
                            <a href="@($"/project/{ProjectId}/entity/{Uri.EscapeDataString(relation.TargetEntity)}?record={Uri.EscapeDataString(recordKey)}")"
                               class="dccard dcdash-row related-link">
                                @for (var i = 0; i < Math.Min(related.Columns.Count, 4); i++)
                                {
                                    <span class="ellipsis" style="color:@(i == 0 ? "var(--text)" : "var(--text-3)")">@(i < r.Count ? r[i] : "")</span>
                                }
                                <span class="related-arrow">→</span>
                            </a>
                        }
                    }
                </div>
            }

            @if (Vm.AutoLinks.Count > 0)
            {
                <div>
                    <div class="section-label">Auto-linked records</div>
                    @foreach (var link in Vm.AutoLinks)
                    {
                        <a class="dccard dcdash-row auto-link"
                           href="@($"/project/{ProjectId}/entity/{Uri.EscapeDataString(EntityNameForTable(link.TableName))}?record={Uri.EscapeDataString(link.RowKey)}")">
                            <span class="link-kind">@link.Kind</span>
                            <span class="ellipsis">@link.DisplayValue</span>
                            <span class="link-meta">@link.TableName · @link.ColumnName · @link.RowKey</span>
                            <span aria-hidden="true">→</span>
                        </a>
                    }
                </div>
            }
            }
        </div>
    </div>
}

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public string EntityName { get; set; } = "";

    [SupplyParameterFromQuery(Name = "record")] public string? RecordKey { get; set; }

    private string EntityNameForTable(string tableName)
        => Vm.AllEntities.FirstOrDefault(entity => string.Equals(entity.TableName, tableName, StringComparison.OrdinalIgnoreCase))?.Name
           ?? tableName;

    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));

    protected override async Task OnParametersSetAsync()
    {
        Vm.EntityName = EntityName;
        Vm.RecordKey = RecordKey;
        Vm.Initialize(ProjectId);
        await Vm.LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Vm.ViewTab != "analytics") return;
        if (Vm.ShowChartEditor && Vm.ChartMonaco && !Vm.ChartMonacoReady)
        {
            Vm.ChartMonacoReady = true;
            try
            {
                var rich = await JS.InvokeAsync<bool>("pcmonaco.init", EntityBrowseViewModel.ChartEditorId, Vm.ChartSql, "sql", "vs-dark");
                if (!rich) { Vm.ChartMonaco = false; StateHasChanged(); }
            }
            catch { Vm.ChartMonaco = false; StateHasChanged(); }
        }
        foreach (var chart in Vm.EntityCharts().Where(c => c.Html.TrimStart().StartsWith('{')))
        {
            var id = EntityBrowseViewModel.ChartCanvasId(chart.TableName);
            if (Vm.RenderedCharts.TryGetValue(id, out var at) && at == chart.GeneratedAt) continue;
            try
            {
                await JS.InvokeVoidAsync("pcchart.render", id, chart.Html);
                Vm.RenderedCharts[id] = chart.GeneratedAt;
            }
            catch (JSException) { }
        }
    }

    public void Dispose()
    {
        Vm.CancelSearchDebounce();
        Vm.Detach();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
        => await Vm.OnSearchInputAsync(e.Value?.ToString() ?? "");

    private async Task OpenRecordAsync(IReadOnlyList<string?> row)
        => await Vm.OpenRecordAsync(row);

    private async Task OpenAnalyticsAsync()
        => await Vm.OpenAnalyticsAsync();

    private async Task ClearFocusAsync()
    {
        Vm.FocusKey = null;
        await Vm.BuildSectionGraphAsync();
    }

    private async Task SaveChartAsync()
        => await Vm.SaveEntityChartAsync(async (id, current) =>
        {
            try { return await JS.InvokeAsync<string>("pcmonaco.getValue", id); }
            catch { return current; }
        });

    private void ToggleBool(string colName, ChangeEventArgs e)
        => Vm.FormValues[colName] = e.Value?.ToString() == "true" ? "true" : "false";
}
