@if (Vm.EditingChart is { } editingChart)
{
    <div class="dcmodal-overlay" @onclick="Vm.CloseChartQuery">
        <section class="dcmodal chart-query-modal" role="dialog" aria-modal="true" aria-labelledby="chart-query-title" @onclick:stopPropagation="true">
