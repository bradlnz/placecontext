@if (Vm.WorkflowRunPrompt is { } runPrompt)
{
    <WorkflowRunDialog Vm="runPrompt" />
}
@code {
    [Parameter] public Guid ProjectId { get; set; }
    [Parameter] public Guid? RunId { get; set; }
    [Parameter] public Guid? SubmissionId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "conversation")] public Guid? ConversationId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "agent")] public Guid? AgentId { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "task")] public string? TaskHint { get; set; }
    [Parameter, SupplyParameterFromQuery(Name = "source")] public Guid? SourceHint { get; set; }
    private (Guid, string?, Guid?)? _appliedSourceHint;
    private ChatComposer _composer = null!;
    private bool _focusComposer;
    private WorkflowQueryEditor? _chartQueryEditor;
    private async Task SaveChartQueryAsync() => await Vm.SaveChartQueryAsync(_chartQueryEditor is null ? Vm.ChartSqlDraft : await _chartQueryEditor.ReadAsync());
    private async Task LaunchDashboardTileAsync(string key, DashboardAction? action)
    {
        if (key == "workflow") await Vm.StartWorkflowChatAsync();
        else if (key is "chat" or "chart") { Vm.OpenChat(); if (!string.IsNullOrWhiteSpace(action?.Prompt)) Vm.ApplyTaskHint(action.Prompt); _focusComposer = true; }
        else if (action is not null) await Vm.StartDashboardActionAsync(action.Prompt);
    }
    private void PrepareBranch(Action action)
    {
        action();
        _focusComposer = Vm.BranchPending;
    }
    private void CloseWorkspace()
    {
        Vm.CloseWorkspace();
        _focusComposer = true;
    }
    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));
    protected override async Task OnParametersSetAsync()
    {
        await Vm.LoadAsync(ProjectId, ConversationId, RunId, SubmissionId);
        if (AgentId is { } selectedAgent && ConversationId is null && !Vm.ChatOpen)
            Vm.SelectAgent(selectedAgent.ToString());
        var hint = (ProjectId, TaskHint, SourceHint);
        if (TaskHint == "sources" && _appliedSourceHint != hint)
        {
            _appliedSourceHint = hint;
            Vm.ApplyTaskHint(SourceHint is { } source
                ? $"Help me choose and build a data pipeline for source {source}. Inspect its metadata and existing workflows, then ask what processing and retrieval outcome I need."
                : "Help me connect data and choose a pipeline. Identify the source from my description, check the supported connectors and existing sources, then guide me through the secure connection form. Ask what data I have and what I want to do with it.");
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var ct = _chartRefresh.Token;
            try { await Vm.InitializeBrowserAsync(); }
            catch (JSDisconnectedException) when (ct.IsCancellationRequested) { return; }
            if (ct.IsCancellationRequested) return;
            _ = RefreshChartsAsync(ct);
        }
        if (_focusComposer && Vm.ChatOpen)
        {
            _focusComposer = false;
            await _composer.FocusAsync();
        }
    }
    private readonly CancellationTokenSource _chartRefresh = new();
    private async Task RefreshChartsAsync(CancellationToken ct)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(10));
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
                await InvokeAsync(async () =>
                {
                    if (!Vm.ChatOpen || Vm.ExpandedDashboardChartId is not null) await Vm.RefreshDashboardChartsAsync(ct);
                });
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
    }
    public async ValueTask DisposeAsync()
    {
        _chartRefresh.Cancel();
        _chartRefresh.Dispose();
        await Vm.DisposePageAsync();
    }
}
