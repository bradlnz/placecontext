@using PlaceContext.Application.Access.Models
@page "/project/{ProjectId:guid}/dashboard"
@page "/project/{ProjectId:guid}/dashboard/runs/{RunId:guid}"
@page "/project/{ProjectId:guid}/dashboard/runs/{RunId:guid}/submission/{SubmissionId:guid}"
@attribute [Authorize(Policy = Permission.ProjectsView)]
@layout PlaceContext.Host.Components.Layout.ProjectLayout
@implements IAsyncDisposable
@inject BuildChatViewModel Vm
@using PlaceContext.Application.Build

<PageTitle>PlaceContext — Dashboard</PageTitle>
<div id="@Vm.ViewId" class="build-chat @(Vm.ShowHistory ? "history-open" : "") @(Vm.WorkspaceVisible ? "conversation-active" : "") @(Vm.WorkspaceOpen ? "workspace-preview-open" : "") @(Vm.ExpandedDashboardChartId is not null ? "dashboard-chart-expanded" : "") @(Vm.HumanInputRequest is not null ? "human-input-pending" : "")">
    @if (Vm.ShowHistory)
    {
        <aside id="@(Vm.ViewId + "-build-history")" class="chat-history" aria-label="Sessions">
            <header><h2>Sessions</h2><button class="chat-icon-button" aria-label="Close sessions" @onclick="() => Vm.ShowHistory = false"><AppIcon Kind="close" /></button></header>
            <button class="dcbtn history-new" disabled="@Vm.NavigationLocked" @onclick="Vm.NewAsync"><AppIcon Kind="plus" /> New session</button>
            <label class="visually-hidden" for="@(Vm.ViewId + "-history-search")">Search recent sessions by title</label>
            <input id="@(Vm.ViewId + "-history-search")" class="history-search" type="search" placeholder="Search recent sessions" maxlength="200" @bind="Vm.HistoryQuery" @bind:event="oninput" />
            <p class="history-label">RECENT</p>
            @if (Vm.Conversations.Count == 0)
            { <div class="history-empty"><AppIcon Kind="message" /><p>A fresh start.</p><span>Your sessions will appear here.</span></div> }
            @if (Vm.Conversations.Count > 0 && !Vm.FilteredConversations.Any())
            { <p class="history-empty" role="status">No matching sessions. Try a different title.</p> }
            @foreach (var chat in Vm.FilteredConversations)
            {
                <button class="history-item @(chat.Id == Vm.Conversation.Id ? "active" : "")" title="@chat.Title" disabled="@Vm.NavigationLocked" @onclick="() => Vm.OpenAsync(chat.Id)"><AppIcon Kind="message" /><span>@chat.Title</span>@if (chat.Status is PlaceContext.Application.Build.BuildRunStatus.Queued or PlaceContext.Application.Build.BuildRunStatus.Running) { <small>@chat.Status</small> }</button>
            }
            <div class="history-foot"><AppIcon Kind="ledger" /><span>Private to you.<br />Connected to this project.</span></div>
        </aside>
    }
    <section class="chat-main" aria-label="Dashboard workspace">
        <header class="chat-header">
            <div class="chat-header-start">
                <button class="chat-icon-button" aria-label="History" title="Session history" aria-expanded="@Vm.ShowHistory" aria-controls="@(Vm.ViewId + "-build-history")" @onclick="Vm.ToggleHistoryAsync"><AppIcon Kind="history" /></button>
                <button class="chat-icon-button" aria-label="New chat" title="New chat" disabled="@Vm.NavigationLocked" @onclick="Vm.NewAsync"><AppIcon Kind="edit" /></button>
                            <div class="model-picker">
                                <label for="@(Vm.ViewId + "-chat-agent")" class="visually-hidden">Agent</label><select id="@(Vm.ViewId + "-chat-agent")" value="@(Vm.Conversation.AgentId ?? DashboardSettings.DefaultAgentId)" @onchange="e => Vm.SelectAgent(e.Value?.ToString())" disabled="@(Vm.Locked || Vm.AgentLoading || Vm.ChartQuerySaving)">@foreach (var profile in Vm.DashboardAgents) { <option value="@profile.Id">@profile.DisplayName</option> }</select>
                            </div>
            </div>
            <div class="chat-header-actions">
                @if (Vm.Conversation.ParentConversationId is { } parentId)
                { <button type="button" class="chat-toolbar-button" aria-label="Open original session" title="Open original session" disabled="@Vm.NavigationLocked" @onclick="() => Vm.OpenAsync(parentId)"><AppIcon Kind="history" /><span>Original session</span></button> }
                @if (Vm.Conversation.Messages.Count > 0 && !Vm.WorkspaceVisible)
                { <button type="button" class="chat-toolbar-button" aria-label="Open workspace" @onclick="Vm.OpenWorkspace"><AppIcon Kind="chain" /><span>Workspace</span></button> }
                <a class="chat-toolbar-button" href="@($"/project/{ProjectId}/workflows")"><AppIcon Kind="chain" /><span>Workflows</span></a>
                @if (Vm.Conversation.Messages.Count > 0)
                {
                    @if (Vm.CanShareDemo) { <button type="button" class="chat-icon-button" aria-label="Share session" title="Share session" disabled="@Vm.NavigationLocked" @onclick="Vm.OpenDemoShareAsync"><AppIcon Kind="share" /></button> }
                    <button class="chat-icon-button delete-chat" aria-label="Delete session" title="Delete session" disabled="@Vm.Locked" @onclick="() => Vm.ConfirmDelete = true"><AppIcon Kind="trash" /></button>
                }
            </div>
        </header>
        <div class="build-body" aria-busy="@(Vm.Loading ? "true" : "false")">
        @if (Vm.Loading)
        {
            <div class="conversation-loading" role="status" aria-live="polite" aria-atomic="true"><div><p>Loading session <span class="thinking-dots" aria-hidden="true"><span></span><span></span><span></span></span></p><div aria-hidden="true"><Skeleton Kind="list" Rows="3" /></div></div></div>
        }
        <div id="@(Vm.ViewId + "-thread")" inert="@Vm.Loading" class="chat-content @(Vm.Conversation.Messages.Count == 0 ? "empty-chat" : "") @(!Vm.ChatOpen ? "dashboard-landing" : "")">
            <div class="chat-messages" role="log" aria-label="Chat messages" aria-live="polite" aria-busy="@(Vm.Busy || Vm.Submitting ? "true" : "false")">
                @if (!Vm.Loading && Vm.Conversation.Messages.Count == 0)
                {
                    <div class="chat-welcome">
                        @if (!Vm.ChatOpen)
                        {
                            <p class="dashboard-layout-status" role="status" aria-live="polite"></p>
                            <div class="dashboard-actions" @key="(Vm.Conversation.AgentId ?? DashboardSettings.DefaultAgentId)" aria-label="Dashboard tiles">
                            @foreach (var key in Vm.Tiles.OrderedTiles())
                            {
                                var action = Vm.Tiles.TileAction(key);
                                var chart = Vm.Tiles.Charts.FirstOrDefault(c => c.Id.ToString() == key);
                                var chartResult = chart is null ? null : Vm.DashboardChartResults.GetValueOrDefault(chart.Id);
                                var title = action?.Title ?? (chart is null ? null : PlaceContext.Application.Features.ChartSpec.TryParse(chart.ChartJson)?.Title) ?? (key == "workflow" ? "Run a workflow" : key == "chat" ? "Ask a question" : key == "chart" ? "Add chart" : "Chart");
                                var layoutDisabled = Vm.Locked || Vm.AgentLoading || Vm.AgentOpen;
                                <article class="dashboard-tile tile-@Vm.Tiles.TileSize(key) @(Vm.Tiles.TileRowStarts.Contains(key) ? "tile-row-start" : "") @(chart is not null ? "dashboard-chart" : "")" @key="key" data-tile="@key" data-tile-size="@Vm.Tiles.TileSize(key)" data-tile-column="@Vm.Tiles.TilePositions.GetValueOrDefault(key)?.Column" data-tile-row="@Vm.Tiles.TilePositions.GetValueOrDefault(key)?.Row"
                                         data-move-enabled="@(!layoutDisabled ? "true" : "false")">
                                        <div class="dashboard-move" aria-label="@($"Move {title}")">
                                            <button type="button" class="dashboard-drag-handle" disabled="@layoutDisabled" aria-label="@($"Move {title}")" title="Drag to rearrange · arrow keys also work">⠿ Move</button>
                                            @if (action is not null)
                                            { <button type="button" class="chat-icon-button" disabled="@layoutDisabled" aria-label="@($"Edit {title}")" title="Edit tile" @onclick="() => Vm.EditDashboardTile(key)"><AppIcon Kind="edit" /></button> }
                                            <button type="button" class="chat-icon-button" disabled="@layoutDisabled" aria-label="@($"Remove {title} from dashboard")" title="Remove tile" @onclick="() => Vm.RemoveDashboardTileAsync(key)"><AppIcon Kind="trash" /></button>
                                        </div>
                                    <button type="button" class="dashboard-resize" aria-label="@($"Resize {title}")" aria-description="@($"Current size: {Vm.Tiles.TileSize(key)}. Drag to resize or use the arrow keys.")" title="Drag to resize · arrow keys also work" disabled="@layoutDisabled"><span aria-hidden="true">↘</span></button>
                                    @if (chart is not null)
                                    {
                                        <div class="dashboard-chart-heading"><h2>@title</h2><button class="chat-icon-button" aria-label="@(chart.Sql is null ? $"Use SQL for {title}" : $"Edit query for {title}")" title="@(chart.Sql is null ? "This chart uses built-in counts. Switch to a SQL query." : "Edit the saved SQL query")" disabled="@(Vm.Locked || Vm.AgentLoading)" @onclick="() => Vm.EditChartQueryAsync(chart)"><AppIcon Kind="edit" /></button><button class="chat-icon-button" aria-label="@($"Expand {title}")" disabled="@(chartResult?.Spec is null)" @onclick="() => Vm.OpenDashboardChart(chart)"><AppIcon Kind="external-link" /></button></div>
                                        <small class="dashboard-chart-date">Live · refreshes every 10 seconds @if (chartResult?.UpdatedAt is { } updated) { <span>· Updated @Vm.Presentation.DateTime(updated)</span> }</small>
                                        <div class="dashboard-chart-content">
                                            @if (chartResult?.Error is { } chartError) { <p role="status">@chartError</p> }
                                            else if (chartResult?.Spec is { } chartSpec) { <BuildChart Spec="chartSpec" Source="@chart.Source" /> }
                                            else { <p role="status">@(chartResult is null ? "Loading current data…" : "No matching data.")</p> }
                                        </div>
                                    }
                                    else
                                    {
                                        <button type="button" class="dashboard-action" disabled="@(Vm.NavigationLocked || (key != "workflow" && key != "chat" && key != "chart" && !Vm.CanStartChat))" @onclick="() => LaunchDashboardTileAsync(key, action)">
                                            <span class="dashboard-action-icon"><AppIcon Kind="@(key == "workflow" ? "play" : key == "chart" ? "data.graph" : "message")" /></span>
                                            <span><strong>@title</strong><small>@(action?.Description ?? action?.Prompt)</small></span>
                                        </button>
                                    }
                                </article>
                            }
                            </div>
                        }
                    </div>
                }
                @foreach (var message in Vm.Conversation.Messages.OfType<System.Text.Json.Nodes.JsonNode>())
                {
                    var role = BuildChatViewModel.Role(message);
                    if (role == "tool")
                    {
                        <div class="result-items">
                            @if (Vm.ResultChart(message) is { } chart)
                            { <button type="button" class="result-item" @onclick="() => Vm.OpenChart(chart)"><AppIcon Kind="data.graph" /><span>@(chart.Spec.Title ?? "Chart")<small>Open chart</small></span><AppIcon Kind="arrow-right" /></button> }
                            @foreach (var item in Vm.ResultItems(message))
                            {
                                <button type="button" class="result-item" @onclick="() => Vm.OpenPreviewAsync(item)"><AppIcon Kind="@(item.Kind == "job" ? "code" : item.Kind == "artifact" ? "file" : "chain")" /><span>@item.Name<small>Open @(item.Kind == "workflow-run" ? "run" : item.Kind == "workflow" ? "workflow" : item.Kind == "artifact" ? "artifact" : "job")</small></span><AppIcon Kind="arrow-right" /></button>
                            }
                        </div>
                        <details class="tool-result"><summary><AppIcon Kind="logs" /> Action result</summary><RunOutput Value="@(Vm.Presentation.Json(BuildChatViewModel.Text(message)))" Label="Action result JSON" /></details>
                    }
                    else
                    {
                        <article class="chat-message @role">
                            <div class="message-author"><span>@if (role == "user") { <AppIcon Kind="human" /> } else { <AssistantAvatar /> }</span><strong>@(role == "user" ? "You" : "Assistant")</strong></div>
                            @if (BuildChatViewModel.JsonReply(message) is { } json)
                            { <RunOutput Value="@json" Label="Assistant JSON response" /> }
                            else if (BuildChatViewModel.Text(message).Length > 0)
                            {
                                @if (role == "assistant")
                                { <div class="message-text message-markdown">@((MarkupString)BuildChatViewModel.FormatReply(BuildChatViewModel.Text(message)))</div> }
                                else
                                { <div class="message-text">@BuildChatViewModel.Text(message)</div> }
                            }
                            @if (BuildChatViewModel.SuggestedAnswers(message).Any())
                            {
                                <div class="suggested-answers" role="group" aria-label="Suggested answers">
                                    @foreach (var answer in BuildChatViewModel.SuggestedAnswers(message))
                                    {
                                        <button type="button" class="dcbtn" disabled="@(!Vm.CanAnswer(message))" @onclick="() => Vm.AnswerAsync(message, answer)">@answer</button>
                                    }
                                </div>
                                <p class="answer-hint">Choose an answer to send, or type your own below.</p>
                            }
                            @if (message["dashboard_action"]?.ToString() == "choose_workflow")
                            { <button type="button" class="dcbtn" disabled="@Vm.NavigationLocked" @onclick="Vm.StartWorkflowChatAsync">Choose a workflow</button> }
                            @foreach (var url in BuildChatViewModel.ImageUrls(message)) { <img class="message-image" src="@url" alt="Image attached to your message" /> }
                            @foreach (var call in BuildChatViewModel.Calls(message)) { <details class="tool-call"><summary><AppIcon Kind="agent" /> @(call["function"]?["name"])</summary><RunOutput Value="@(Vm.Presentation.Json(call["function"]?["arguments"]?.ToString() ?? ""))" Label="Tool arguments JSON" /></details> }
                            @if (BuildChatViewModel.Text(message).Length > 0)
                            {
                                <div class="message-actions" role="group" aria-label="@(role == "user" ? "Your message actions" : "Assistant message actions")">
                                    <button type="button" @onclick="() => Vm.CopyMessageAsync(message)">Copy</button>
                                    @if (role == "user" && !BuildChatViewModel.ImageUrls(message).Any())
                                    { <button type="button" disabled="@(!Vm.CanEditMessage(message))" title="Edit the message in a new session" @onclick="() => PrepareBranch(() => Vm.EditMessage(message))">Edit</button> }
                                    @if (role == "assistant" && !BuildChatViewModel.Calls(message).Any())
                                    {
                                        <button type="button" disabled="@(!Vm.CanRetryMessage(message))" title="Review the prompt before retrying in a new session" @onclick="() => PrepareBranch(() => Vm.RetryMessage(message))">Retry</button>
                                        <button type="button" disabled="@(!Vm.CanBranchMessage(message))" title="Continue from this reply in a new session" @onclick="() => PrepareBranch(() => Vm.BranchFromMessage(message))">Branch from here</button>
                                    }
                                </div>
                            }
                        </article>
                    }
                }
                @if (Vm.HumanInputRequest is { } humanInput)
                {
                    <section class="chat-human-input" aria-label="Workflow question" @key="humanInput.Id">
                        <div class="message-author"><span><AppIcon Kind="human" /></span><strong>Workflow needs your response</strong></div>
                        <p class="answer-hint">@Vm.PreviewRun?.ChainName · Workflow paused</p>
                        <div class="message-text message-markdown">@((MarkupString)BuildChatViewModel.FormatReply(humanInput.Instructions ?? "Review the workflow and respond to continue."))</div>
                        @if (Vm.PreviewRun?.FinalOutput is { Length: > 0 } context)
                        { <details class="tool-result"><summary>Review workflow context</summary><RunOutput Value="@Vm.Presentation.Json(context)" Label="Workflow review context" /></details> }
                        @if (humanInput.ResponseType == PlaceContext.Domain.ValueObjects.LoopChainAction.YesNoResponse)
                        {
                            <p class="answer-hint">A No answer follows the workflow’s configured No branch.</p>
                            <div class="suggested-answers" role="group" aria-label="Answer workflow question">
                                <button type="button" class="dcbtn" aria-pressed="@(Vm.HumanAnswer == true)" disabled="@(Vm.SubmittingHumanInput || !Vm.CanRespondToWorkflow)" @onclick="() => Vm.SelectHumanAnswer(humanInput.Id, true)">Yes</button>
                                <button type="button" class="dcbtn" aria-pressed="@(Vm.HumanAnswer == false)" disabled="@(Vm.SubmittingHumanInput || !Vm.CanRespondToWorkflow)" @onclick="() => Vm.SelectHumanAnswer(humanInput.Id, false)">No</button>
                            </div>
                            @if (Vm.HumanAnswer is { } answer)
                            {
                                <div class="human-input-actions"><button type="button" class="dcbtn primary" disabled="@Vm.SubmittingHumanInput" @onclick="() => Vm.SubmitHumanInputAsync(humanInput.Id)">@(Vm.SubmittingHumanInput ? "Submitting…" : answer ? "Confirm Yes" : "Confirm No")</button><button type="button" class="dcbtn" disabled="@Vm.SubmittingHumanInput" @onclick="() => Vm.SelectHumanAnswer(humanInput.Id, null)">Cancel</button></div>
                            }
                        }
                        else
                        {
                            @foreach (var step in humanInput.Steps)
                            {
                                @foreach (var field in step.Parameters)
                                {
                                    var fieldId = $"{Vm.ViewId}-human-{step.Index}-{field.Name}";
                                    <div class="dcfield"><label for="@fieldId">@(field.Label ?? "Your response") @(field.Required ? "*" : "")</label><textarea id="@fieldId" class="dcinput" rows="4" required="@field.Required" disabled="@(Vm.SubmittingHumanInput || !Vm.CanRespondToWorkflow)" value="@Vm.GetHumanInput(step.Index, field.Name)" @oninput="@(e => Vm.SetHumanInput(step.Index, field.Name, e.Value?.ToString() ?? ""))"></textarea></div>
                                }
                            }
                            <button type="button" class="dcbtn primary" disabled="@(Vm.SubmittingHumanInput || !Vm.CanRespondToWorkflow)" @onclick="() => Vm.SubmitHumanInputAsync(humanInput.Id)">@(Vm.SubmittingHumanInput ? "Submitting…" : "Submit and continue")</button>
                        }
                        @if (!Vm.CanRespondToWorkflow) { <p class="answer-hint">You need permission to run workflows to respond.</p> }
                        @if (Vm.HumanInputError is { } inputError) { <p class="error-notice" role="alert">@inputError</p> }
                    </section>
                }
                @if (Vm.HumanInputNotice is { } inputNotice) { <p class="chat-notice" role="status">@inputNotice</p> }
                @if (Vm.Busy || Vm.Submitting)
                {
                    <div class="thinking" role="status" aria-live="polite" aria-atomic="true">
                        <span class="toolbar-avatar" aria-hidden="true"><AssistantAvatar /></span>
                        <span>@(Vm.Submitting ? "Sending your message" : Vm.Conversation.Status == BuildRunStatus.Queued ? "Waiting for the assistant" : "Assistant is working")</span>
                        <span class="thinking-dots" aria-hidden="true"><span></span><span></span><span></span></span>
                    </div>
                }
            </div>
            <div class="chat-bottom">
                @if (Vm.Error is not null && Vm.Error != Vm.Conversation.Messages.LastOrDefault()?["content"]?.ToString())
                { <p class="chat-notice error-notice" role="alert"><AppIcon Kind="warning" /> @Vm.Error</p> }
                @if (Vm.Notice is not null) { <p class="chat-notice" role="status">@Vm.Notice</p> }
                @if (Vm.BranchPending)
                {
                    <div class="branch-draft" role="status">
                        <div><strong>@Vm.BranchLabel</strong><p>The original is preserved. Sending may run tools again; completed actions remain applied.</p></div>
                        <button type="button" class="dcbtn" disabled="@Vm.Submitting" @onclick="Vm.CancelBranch">Cancel</button>
                    </div>
                }
                <div class="chat-entry" hidden="@(!Vm.ChatOpen)">
                @if (Vm.ChatOpen && Vm.Conversation.Messages.Count == 0)
                {
                    <h2 class="chat-entry-title">How can I help?</h2>
                    <p class="chat-entry-description">Explore your project, create a chart, or get help with a workflow.</p>
                }
                <ChatComposer @ref="_composer" Vm="Vm" />
                @if (Vm.ModelSetupHint is not null)
                { <div class="composer-note" role="status">@Vm.ModelSetupHint</div> }
                else if (!Vm.Loading && !Vm.Models.Contains(Vm.Conversation.Model))
                { <div class="model-setup" role="status"><span>This agent needs a model. Choose its connection and model in Agents.</span><a class="dcbtn" href="@($"/project/{ProjectId}/agents")">Open Agents</a></div> }
                else { <div class="composer-note">@(Vm.Listening ? "Listening… Stop dictation to review and send." : "The assistant can make changes to this project. Review action results.")</div> }
                </div>
            </div>
        </div>
            <div class="build-divider" inert="@(Vm.Loading || !Vm.WorkspaceVisible)" role="separator" tabindex="0" aria-label="Resize chat and workspace" aria-orientation="vertical" aria-valuemin="30" aria-valuemax="70" aria-valuenow="50" aria-controls="@(Vm.ViewId + "-thread " + Vm.ViewId + "-workspace")" title="Drag to resize · arrow keys to adjust"></div>
            <section id="@(Vm.ViewId + "-workspace")" class="build-workspace" aria-label="Dashboard workspace" inert="@(Vm.Loading || !Vm.WorkspaceVisible)">
                <header class="preview-heading">
                    <h2>@(Vm.WorkflowPickerOpen ? "Run a workflow" : Vm.PreviewArtifact?.Title ?? Vm.PreviewChart?.Spec.Title ?? Vm.PreviewItem?.Name ?? "Workspace")</h2>
                    @if (Vm.PreviewArtifact is not null || Vm.ArtifactPreviewLoading || Vm.ArtifactPreviewError is not null)
                    { <button type="button" class="dcbtn" @onclick="Vm.CloseArtifactPreview">@(Vm.PreviewRun is not null ? "Back to run" : "Back to workspace")</button> }
                    @if (Vm.PreviewEditorUrl is { } editorUrl)
                    { <a href="@editorUrl" target="_blank" rel="noopener" class="chat-icon-button" aria-label="@(Vm.PreviewItem?.Kind == "workflow-run" ? "Open run in a new tab" : "Open editor in a new tab")" title="Open full view in a new tab"><AppIcon Kind="external-link" /></a> }
                    <button type="button" class="chat-icon-button" aria-label="Close workspace" title="Close workspace" @onclick="CloseWorkspace"><AppIcon Kind="close" /></button>
                </header>
                @if (Vm.WorkflowPickerOpen)
                {
                    <div class="preview-content workflow-picker">
                        <p class="preview-description">Choose a workflow, then click Run workflow to complete its input form. Selecting a workflow does not start it.</p>
                        @if (Vm.WorkflowPickerLoading) { <Skeleton Kind="list" Rows="3" /> }
                        else if (Vm.WorkflowPickerError is { } pickerError)
                        { <p role="alert">@pickerError</p><button class="dcbtn" @onclick="Vm.StartWorkflowChatAsync">Try again</button> }
                        else if (Vm.WorkflowPickerRestricted)
                        {
                            <p role="status">@(string.IsNullOrWhiteSpace(Vm.WorkflowPickerAgentName) ? "This agent" : Vm.WorkflowPickerAgentName) does not have access to run workflows. Choose an agent with run access or update its workflow capabilities.</p>
                            <a class="dcbtn" href="@($"/project/{ProjectId}/agents")">Manage agents</a>
                        }
                        else if (Vm.AvailableWorkflows.Count == 0)
                        { <p>No workflows yet in this project.</p><a class="dcbtn" href="@($"/project/{ProjectId}/workflows")">Open workflows</a> }
                        else
                        {
                            <div class="result-items" aria-label="Available workflows">
                                @foreach (var choice in Vm.AvailableWorkflows)
                                {
                                    <button type="button" class="result-item" @key="choice.Id" @onclick="() => Vm.SelectWorkflowAsync(choice.Id)"><AppIcon Kind="chain" /><span>@choice.Name<small>@choice.Description</small></span><AppIcon Kind="arrow-right" /></button>
                                }
                            </div>
                        }
                    </div>
                }
                else if (Vm.ArtifactPreviewLoading)
                {
                    <div class="preview-content" role="status">Opening artifact…</div>
                }
                else if (Vm.ArtifactPreviewError is { } artifactError)
                {
                    <div class="preview-content" role="alert">@artifactError</div>
                }
                else if (Vm.PreviewArtifact is { } artifact)
                {
                    <ArtifactPreview @key="artifact.Id" Artifact="artifact" Json="@Vm.PreviewArtifactJson" JsonError="@Vm.PreviewArtifactJsonError" JsonTruncated="@Vm.PreviewArtifactJsonTruncated" />
                }
                else if (Vm.PreviewChart is { } previewChart)
                {
                    <div class="preview-content preview-chart">
                        <button class="dcbtn" disabled="@(Vm.Locked || Vm.AgentLoading || !previewChart.Live || Vm.IsChartPinned(previewChart) || Vm.Tiles.Charts.Count >= 8)" @onclick="() => Vm.PinDashboardChartAsync(previewChart)">@(Vm.IsChartPinned(previewChart) ? "Pinned to dashboard" : "Pin to dashboard")</button>
                        @if (!previewChart.Live) { <p class="hint">Ask for a live chart to pin current data to your dashboard.</p> }
                        @if (Vm.Tiles.Charts.Count >= 8 && !Vm.IsChartPinned(previewChart)) { <p>The dashboard supports up to 8 pinned charts.</p> }
                        @if (Vm.ExpandedDashboardChartId is { } expanded && Vm.DashboardChartResults.GetValueOrDefault(expanded) is { } liveResult)
                        {
                            @if (liveResult.Error is { } liveError) { <p role="status">@liveError</p> }
                            else if (liveResult.Spec is { } liveSpec) { <BuildChart Spec="liveSpec" Source="@previewChart.Source" /> }
                            else { <p role="status">No matching data.</p> }
                        }
                        else { <BuildChart Spec="previewChart.Spec" Source="@previewChart.Source" /> }
                    </div>
                }
                else if (Vm.PreviewItem is { } preview)
                {
                    <div class="preview-content @(Vm.PreviewWorkflow is not null ? "preview-workflow" : "")">
                        @if (Vm.PreviewLoading) { <Skeleton Kind="list" Rows="3" /> }
                        else if (Vm.PreviewError is not null) { <p role="alert">@Vm.PreviewError</p><button class="dcbtn" @onclick="() => Vm.OpenPreviewAsync(preview)">Try again</button> }
                        else if (preview.Kind == "workflow-run")
                        {
                            <div class="preview-run-summary">
                                <span class="preview-run-status" role="status" style="color:@Vm.Presentation.StatusColor(Vm.PreviewRunStatus ?? "Queued")">@Vm.PreviewRunStatus</span>
                                <a class="dcbtn" href="@Vm.PreviewEditorUrl">Open full run <AppIcon Kind="arrow-right" /></a>
                            </div>
                            @if (Vm.PreviewRun is { } run)
                            {
                                <p class="preview-description">Started @Vm.Presentation.DateTime(run.StartedAt) · @(run.FinishedAt is { } finished ? Vm.Presentation.Duration(run.StartedAt, finished) : "Updates automatically")</p>
                                <ExecutionApprovalPanel @key="run.Id" ProjectId="run.ProjectId" RunIds="@(new[] { run.Id }.Concat(run.Steps.Select(s => s.RunId).OfType<Guid>()).ToArray())" />
                                @if (Vm.RunArtifactsError is { } artifactsError) { <p role="alert">@artifactsError</p> }
                                @if (Vm.PreviewRunArtifacts.Count > 0)
                                {
                                    <div class="result-items" aria-label="Workflow artifacts">
                                    @foreach (var file in Vm.PreviewRunArtifacts)
                                    {
                                        <button class="result-item" @onclick="() => Vm.OpenArtifactAsync(file.Id, file.RunId)"><AppIcon Kind="file" /><span>@file.Title<small>@file.ContentType</small></span><AppIcon Kind="arrow-right" /></button>
                                    }
                                    </div>
                                }
                                @if (run.InputRequest is { SubmittedValues: null } request && Vm.HumanInputRequest is null)
                                {
                                    <div class="preview-run-notice" role="status"><strong>Input needed</strong><p>@request.Instructions</p><a href="@Vm.PreviewEditorUrl">Respond in the run view</a></div>
                                }
                                @if (run.FinishedAt is not null)
                                {
                                    <div class="approval-actions">
                                        <button class="dcbtn" aria-pressed="@Vm.ShowPreviewResult" @onclick="Vm.ShowRunResult">Result</button>
                                        <button class="dcbtn" aria-pressed="@(!Vm.ShowPreviewResult)" @onclick="Vm.ShowRunSteps">Steps and logs</button>
                                    </div>
                                }
                                @if (Vm.ShowPreviewResult)
                                {
                                    <section class="preview-step-output" aria-label="Workflow result" role="region">
                                        <h3>Workflow result · @run.Status</h3>
                                        @foreach (var failed in run.Steps.Where(step => step.Error is not null))
                                        { <p role="alert"><strong>@failed.JobName:</strong> @failed.Error</p> }
                                        @if (run.FinalOutput is { Length: > 0 } result)
                                        { <RunOutput Value="@Vm.Presentation.Json(result)" Label="Final workflow output" /> }
                                        else { <p>No final output was recorded.</p> }
                                        <p class="preview-description">@run.Steps.Count(step => step.Status == "Succeeded") of @run.Steps.Count steps succeeded. Open Steps and logs for execution details.</p>
                                    </section>
                                }
                                else
                                {
                                <nav class="preview-run-steps" aria-label="Workflow run steps">
                                    @foreach (var step in run.Steps)
                                    {
                                        <button type="button" @key="step.Index" class="preview-run-step" aria-pressed="@(Vm.PreviewStep?.Index == step.Index ? "true" : "false")" @onclick="() => Vm.SelectPreviewStepAsync(step)">
                                            <span class="preview-step-number">@(step.Index + 1)</span><strong>@step.JobName</strong><span style="color:@Vm.Presentation.StatusColor(step.Status)">@step.Status</span>
                                        </button>
                                        @if (step.ActionType == "parallelWorkflows")
                                        {
                                            <SubWorkflowRunLink Step="step" Compact="true" />
                                        }
                                    }
                                </nav>
                                @if (Vm.PreviewStep is { } selected)
                                {
                                    <section class="preview-step-output" aria-label="Step output" @key="(run.Id, selected.Index)">
                                        <SubWorkflowRunLink ProjectId="ProjectId" Step="selected" />
                                        <h3>Step @(selected.Index + 1) · @selected.JobName</h3>
                                        @if (selected.ActionType == "qemu")
                                        { <VirtualMachineReplay Run="run" Step="selected.Index" /> }
                                        @if (selected.Error is { } stepError) { <p role="alert">@stepError</p> }
                                        @if (selected.Output is { } output) { <RunOutput Value="@Vm.Presentation.Json(output)" Label="Step output" /> }
                                        @if (selected.Provider is { } provider) { <p class="preview-description">@provider @selected.ExternalId</p> }
                                        @if (selected.AgentActivity is { Count: > 0 })
                                        { <WorkflowAgentActivity Step="selected" OnRunClick="Vm.OpenPreviewStepLogsAsync" /> }
                                        @if (Vm.PreviewStepError is { } outputError) { <p role="alert">@outputError</p> }
                                        @if (Vm.PreviewStepRun is { } jobRun)
                                        {
                                            @foreach (var shard in jobRun.ShardResults.Where(x => x.Artifact is not null))
                                            { <RunOutput Value="@Vm.Presentation.Json(shard.Artifact!)" Label="@($"Shard {shard.Index + 1} output")" /> }
                                            @if (jobRun.ReduceResult?.Artifact is { } reduced) { <RunOutput Value="@Vm.Presentation.Json(reduced)" Label="Reduce output" /> }
                                            <JobRunLogs @key="jobRun.Id" Run="jobRun" />
                                        }
                                        else if (selected.Output is null && selected.AgentActivity is not { Count: > 0 } && Vm.PreviewStepError is null)
                                        { <p class="preview-description">@(selected.Status is "Pending" or "Running" ? "Waiting for step output… Updates appear here as the step runs." : "No output was recorded for this step.")</p> }
                                    </section>
                                }
                                }
                                @if (!Vm.ShowPreviewResult && run.FinalOutput is { Length: > 0 } finalOutput)
                                { <details class="job-source"><summary>@(run.FinishedAt is null ? "Current workflow output" : "Final workflow output")</summary><RunOutput Value="@Vm.Presentation.Json(finalOutput)" /></details> }
                            }
                            else if (Vm.PreviewSubmission is { } receipt)
                            {
                                <p class="preview-description">Submitted @Vm.Presentation.DateTime(receipt.SubmittedAt)</p>
                                @if (receipt.Error is { } error) { <p role="alert">@error</p> }
                                <p class="preview-description">@(receipt.FinishedAt is null ? "Waiting for a worker. Steps and output will appear here automatically." : "This submission ended before a workflow run was available.")</p>
                            }
                        }
                        else if (Vm.PreviewWorkflow is { } workflow)
                        {
                            <div class="preview-run-summary">
                                <button type="button" class="dcbtn" disabled="@Vm.NavigationLocked" @onclick="Vm.StartWorkflowChatAsync">Choose another workflow</button>
                                @if (!Vm.PreparingWorkflowRun)
                                { <button type="button" class="dcbtn primary" disabled="@Vm.NavigationLocked" @onclick="Vm.PrepareWorkflowRunAsync"><AppIcon Kind="play" /> Run workflow</button> }
                            </div>
                            @if (Vm.PreparingWorkflowRun)
                            { <p class="preview-run-notice" role="status">Loading workflow input fields…</p> }
                            else
                            { <p class="preview-description">Review and complete the input form before starting.</p> }
                            @if (Vm.WorkflowRunError is { } inputError) { <p role="alert">@inputError</p> }
                            @if (!string.IsNullOrWhiteSpace(workflow.Description)) { <p class="preview-description">@workflow.Description</p> }
                            @if (!Vm.WorkflowSelectedForRun && !Vm.PreparingWorkflowRun)
                            { <ChainCanvas @key="workflow.Id" Stages="workflow.Stages" ReadOnly="true" OnOpenJob="Vm.OpenJobPreviewAsync" /> }
                        }
                        else if (Vm.PreviewJob is { } job)
                        {
                            var stages = new[] { new JobChainStageView(new[] { new JobChainStepView(job.Id, job.Name) }) };
                            <p class="preview-description">@job.Description</p>
                            <ChainCanvas @key="job.Id" Stages="stages" ReadOnly="true" />
                            <p class="preview-description">@(job.MapRuntimeId ?? job.MapImage) · @job.ReturnType</p>
                            @foreach (var file in job.MapFiles)
                            { <details class="job-source" open><summary>@file.Path</summary><pre>@file.Content</pre></details> }
                            @if (job.MapFiles.Count == 0 && job.MapSource is not null)
                            { <details class="job-source" open><summary>@(job.MapEntrypoint ?? "Source")</summary><pre>@job.MapSource</pre></details> }
                            @foreach (var file in job.ReduceFiles)
                            { <details class="job-source"><summary>Reduce · @file.Path</summary><pre>@file.Content</pre></details> }
                        }
                    </div>
                }
                else
                {
                <div class="workspace-content">
                    @if (!Vm.Conversation.Messages.OfType<System.Text.Json.Nodes.JsonNode>().Any(message => BuildChatViewModel.Role(message) == "tool"))
                    {
                        <div class="workspace-empty">
                            <AppIcon Kind="chain" />
                            <h3>Your build will take shape here</h3>
                            <p>Keep the session going on the left. Action results will appear here as the assistant works.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var message in Vm.Conversation.Messages.OfType<System.Text.Json.Nodes.JsonNode>().Where(message => BuildChatViewModel.Role(message) == "tool"))
                        {
                            <div class="result-items">
                                @if (Vm.ResultChart(message) is { } chart)
                            { <button type="button" class="result-item" @onclick="() => Vm.OpenChart(chart)"><AppIcon Kind="data.graph" /><span>@(chart.Spec.Title ?? "Chart")<small>Open chart</small></span><AppIcon Kind="arrow-right" /></button> }
                            @foreach (var item in Vm.ResultItems(message))
                                { <button type="button" class="result-item" @onclick="() => Vm.OpenPreviewAsync(item)"><AppIcon Kind="@(item.Kind == "job" ? "code" : "chain")" /><span>@item.Name<small>Open @(item.Kind == "workflow-run" ? "run" : item.Kind == "workflow" ? "canvas" : "job")</small></span><AppIcon Kind="arrow-right" /></button> }
                            </div>
                            <details class="tool-result"><summary><AppIcon Kind="logs" /> Action result</summary><RunOutput Value="@(Vm.Presentation.Json(BuildChatViewModel.Text(message)))" Label="Action result JSON" /></details>
                        }
                    }
                </div>
                }
            </section>
        </div>
    </section>
</div>
@if (Vm.EditingTileKey is { } editingTileKey)
{
    <div class="dcmodal-overlay" @onclick="Vm.CloseTileEditor" @onkeydown='e => { if (e.Key == "Escape") Vm.CloseTileEditor(); }'>
        <section class="dcmodal" role="dialog" aria-modal="true" aria-labelledby="tile-editor-title" @onclick:stopPropagation="true">
            <header class="dcmodal-head"><h3 id="tile-editor-title">Edit tile</h3><button type="button" class="dcslide-x" aria-label="Close tile editor" disabled="@Vm.AgentLoading" @onclick="Vm.CloseTileEditor"><AppIcon Kind="close" /></button></header>
            <div class="dcmodal-body">
                <div class="dcfield"><label for="tile-edit-title">Title</label><input id="tile-edit-title" class="dcinput" maxlength="60" @bind="Vm.TileTitleDraft" @bind:event="oninput" disabled="@Vm.AgentLoading" /></div>
                <div class="dcfield"><label for="tile-edit-description">Description</label><textarea id="tile-edit-description" class="dcinput" rows="3" maxlength="300" placeholder="A short explanation of what this tile does." @bind="Vm.TileDescriptionDraft" @bind:event="oninput" disabled="@Vm.AgentLoading"></textarea></div>
                @if (editingTileKey != "workflow")
                {
                    <div class="dcfield"><label for="tile-edit-prompt">Prompt</label><textarea id="tile-edit-prompt" class="dcinput" rows="8" maxlength="2000" @bind="Vm.TilePromptDraft" @bind:event="oninput" disabled="@Vm.AgentLoading"></textarea></div>
                    <p>@(editingTileKey is "chat" or "chart" ? "This fills the chat input so you can review it before sending." : "This request is sent to the assistant when you open the tile.")</p>
                }
                else { <p>This tile opens the workflow picker.</p> }
                @if (Vm.TileEditError is { } tileError) { <p role="alert">@tileError</p> }
            </div>
            <footer class="dcmodal-foot"><button type="button" class="dcbtn" disabled="@Vm.AgentLoading" @onclick="Vm.CloseTileEditor">Cancel</button><button type="button" class="dcbtn primary" disabled="@Vm.AgentLoading" @onclick="Vm.SaveDashboardTileAsync">@(Vm.AgentLoading ? "Saving…" : "Save changes")</button></footer>
        </section>
    </div>
}
@if (Vm.ShowDemoShare)
{
