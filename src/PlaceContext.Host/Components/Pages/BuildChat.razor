            </div>
            <div class="dcmodal-foot"><button class="dcbtn" disabled="@Vm.ChartQuerySaving" @onclick="Vm.CloseChartQuery">Cancel</button><button class="dcbtn primary" disabled="@Vm.ChartQuerySaving" @onclick="SaveChartQueryAsync">@(Vm.ChartQuerySaving ? "Saving…" : "Save query")</button></div>
        </section>
