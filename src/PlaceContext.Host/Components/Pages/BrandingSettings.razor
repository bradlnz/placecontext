@page "/settings/branding"
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@using PlaceContext.Host.Branding
@inject BrandingService Branding
@inject PortalUiState Ui
@inject NavigationManager Nav

<PageTitle>placecontext — Branding</PageTitle>

<div style="padding:24px; max-width:760px; margin:0 auto">
    <h2 style="font-size:18px; font-weight:600; margin:0 0 4px">Whitelabel branding</h2>
    <div style="font-size:12px; color:var(--text-3); margin-bottom:18px">
        Make the portal yours — a name, a logo, and the shell colors. Applies to everyone in this workspace;
        leave a field empty to keep the default.
    </div>

    <div class="dccard" style="padding:18px; display:flex; flex-direction:column; gap:14px">
        <div style="display:flex; gap:12px">
            <div class="dcfield" style="flex:1">
                <label>Product name</label>
                <input class="dcinput" @bind="_name" placeholder="placecontext" />
            </div>
            <div class="dcfield" style="flex:1">
                <label>Logo <span class="code" style="margin-left:4px">png/svg, ≤200 KB</span></label>
                <InputFile OnChange="OnLogo" accept="image/png,image/svg+xml,image/jpeg,image/webp" class="dcinput" style="padding:6px" />
            </div>
        </div>
        @if (!string.IsNullOrEmpty(_logo))
        {
            <div style="display:flex; align-items:center; gap:10px">
                <img src="@_logo" alt="logo" style="height:34px; border-radius:6px; background:var(--card-2); padding:4px" />
                <button class="dcbtn" style="padding:3px 10px; font-size:11px" @onclick="@(() => _logo = null)">remove logo</button>
            </div>
        }
        <div style="display:flex; gap:12px; flex-wrap:wrap">
            <div class="dcfield"><label>Background</label><input type="color" class="dcinput" style="height:36px; padding:3px" @bind="_bg" /></div>
            <div class="dcfield"><label>Panels & cards</label><input type="color" class="dcinput" style="height:36px; padding:3px" @bind="_panel" /></div>
            <div class="dcfield"><label>Text</label><input type="color" class="dcinput" style="height:36px; padding:3px" @bind="_text" /></div>
            <div class="dcfield"><label>Accent</label><input type="color" class="dcinput" style="height:36px; padding:3px" @bind="_accent" /></div>
        </div>
        <div style="display:flex; gap:10px; align-items:center">
            <button class="dcbtn primary" disabled="@_busy" @onclick="SaveAsync">@(_busy ? "Saving…" : "Save branding")</button>
            <button class="dcbtn" disabled="@_busy" @onclick="ResetAsync">Reset to default</button>
            @if (_message is not null)
            {
                <span style="font-size:12px; color:var(--text-3)">@_message</span>
            }
        </div>
        <div class="dchint">Changes apply on the next page load. Colors override the dark theme's shell variables.</div>
    </div>
</div>

@code {
    private string _name = "";
    private string? _logo;
    private string _bg = "#0a0c0e", _panel = "#0d1013", _text = "#e6edf3", _accent = "#43d675";
    private bool _busy;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        Ui.Set("Branding", "whitelabel the portal for this workspace");
        var b = await Branding.GetAsync();
        _name = b.ProductName ?? "";
        _logo = b.LogoDataUri;
        _bg = b.BgColor ?? _bg;
        _panel = b.PanelColor ?? _panel;
        _text = b.TextColor ?? _text;
        _accent = b.AccentColor ?? _accent;
    }

    private async Task OnLogo(InputFileChangeEventArgs e)
    {
        _message = null;
        var file = e.File;
        if (file.Size > 200 * 1024) { _message = "Logo too large — keep it under 200 KB."; return; }
        using var ms = new MemoryStream();
        await file.OpenReadStream(200 * 1024).CopyToAsync(ms);
        _logo = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private async Task SaveAsync()
    {
        _busy = true;
        _message = null;
        try
        {
            await Branding.SetAsync(new TenantBranding(
                string.IsNullOrWhiteSpace(_name) ? null : _name.Trim(),
                _logo, _bg, _panel, _text, _accent));
            _message = "Saved — reloading…";
            Nav.NavigateTo("/settings/branding", forceLoad: true);
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ResetAsync()
    {
        _busy = true;
        try
        {
            await Branding.SetAsync(new TenantBranding());
            Nav.NavigateTo("/settings/branding", forceLoad: true);
        }
        catch (Exception ex) { _message = ex.Message; }
        finally { _busy = false; }
    }
}
