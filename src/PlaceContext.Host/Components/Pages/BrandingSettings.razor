@page "/settings/branding"
@layout PlaceContext.Host.Components.Layout.SettingsLayout
@attribute [Authorize(Policy = Policies.DefaultAdmin)]
@using PlaceContext.Host.Components.ViewModels
@inject BrandingSettingsViewModel Vm
@implements IDisposable

<PageTitle>placecontext — Branding</PageTitle>
<div class="page">
    <h2 class="title">Whitelabel branding</h2>
    <div class="intro">
        Make the portal yours — a name, a logo, and the shell colors. Applies to everyone in this workspace; leave a field empty to keep the default.
    </div>
    <div class="dccard card">
        <div class="row">
            <div class="dcfield grow">
                <label>Product name</label>
                <input class="dcinput" @bind="Vm.Name" placeholder="placecontext" />
            </div>
            <div class="dcfield grow">
                <label>Logo <span class="code code-gap">png/svg, ≤200 KB</span></label>
                <InputFile OnChange="Vm.SetLogoAsync" accept="image/png,image/svg+xml,image/jpeg,image/webp"
                           class="dcinput" style="padding:6px" />
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Vm.Logo))
        {
            <div class="logo-row">
                <img src="@Vm.Logo" alt="logo" class="logo-preview" />
                <button class="dcbtn btn-sm" @onclick="Vm.RemoveLogo">remove logo</button>
            </div>
        }
        <div class="color-row">
            <div class="dcfield">
                <label>Background</label>
                <input type="color" class="dcinput color-input" @bind="Vm.Background" />
            </div>
            <div class="dcfield">
                <label>Panels & cards</label>
                <input type="color" class="dcinput color-input" @bind="Vm.Panel" />
            </div>
            <div class="dcfield">
                <label>Text</label>
                <input type="color" class="dcinput color-input" @bind="Vm.Text" />
            </div>
            <div class="dcfield">
                <label>Accent</label>
                <input type="color" class="dcinput color-input" @bind="Vm.Accent" />
            </div>
        </div>
        <div class="actions">
            <button class="dcbtn primary" disabled="@Vm.Busy" @onclick="Vm.SaveAsync">
                @(Vm.Busy ? "Saving…" : "Save branding")
            </button>
            <button class="dcbtn" disabled="@Vm.Busy" @onclick="Vm.ResetAsync">Reset to default</button>
            @if (Vm.Message is not null)
            {
                <span class="msg">@Vm.Message</span>
            }
        </div>
        <div class="dchint">Changes apply on the next page load. Colors override the dark theme's shell variables.</div>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync() => await Vm.LoadAsync();

    protected override void OnInitialized() => Vm.Attach(() => InvokeAsync(StateHasChanged));

    public void Dispose() => Vm.Detach();
}
