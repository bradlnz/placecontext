{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DetailedErrors": true,
  "PlaceContext": {
    "TypeSafe": {
      "RequestsPerSecond": 1,
      "TokensPerSecond": 65536
    },
    "Qemu": {
      "Agent": {
        "Provider": "codex",
        "Model": "gpt-6-astra"
      }
    },
    "AgentWorkflows": {
      "SimulateSubscriptions": true
    },
    "Scheduling": {
      "MaxConcurrentChains": 12
    }
  }
}
