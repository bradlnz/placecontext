<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\PlaceContext.Agents\PlaceContext.Agents.csproj" />
    <ProjectReference Include="..\PlaceContext.Agents\PlaceContext.Agents.Infrastructure.csproj" />
    <ProjectReference Include="..\PlaceContext.Infrastructure\PlaceContext.Infrastructure.csproj" />
    <ProjectReference Include="..\PlaceContext.Application\PlaceContext.Application.csproj" />
    <ProjectReference Include="..\PlaceContext.Domain\PlaceContext.Domain.csproj" />
    <ProjectReference Include="..\PlaceContext.Jobs\PlaceContext.Jobs.csproj" />
    <ProjectReference Include="..\PlaceContext.Jobs\PlaceContext.Jobs.Infrastructure.csproj" />
    <ProjectReference Include="..\PlaceContext.Operations\PlaceContext.Operations.csproj" />
    <ProjectReference Include="..\PlaceContext.Crm\PlaceContext.Crm.csproj" />
    <ProjectReference Include="..\PlaceContext.Crm\PlaceContext.Crm.Infrastructure.csproj" />
    <ProjectReference Include="..\PlaceContext.Data\PlaceContext.Data.csproj" />
    <ProjectReference Include="..\PlaceContext.Data\PlaceContext.Data.Infrastructure.csproj" />
    <ProjectReference Include="..\PlaceContext.Search\PlaceContext.Search.csproj" />
    <ProjectReference Include="..\PlaceContext.Search\PlaceContext.Search.Infrastructure.csproj" />
    <ProjectReference Include="..\PlaceContext.Settings\PlaceContext.Settings.csproj" />
    <ProjectReference Include="..\PlaceContext.Vault\PlaceContext.Vault.csproj" />
    <ProjectReference Include="..\PlaceContext.Vault\PlaceContext.Vault.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlaceContext.Artifacts\PlaceContext.Artifacts.csproj" />
    <ProjectReference Include="..\PlaceContext.Artifacts\PlaceContext.Artifacts.Infrastructure.csproj" />
    <ProjectReference Include="..\PlaceContext.AgentChat\PlaceContext.AgentChat.csproj" />
    <ProjectReference Include="..\PlaceContext.AgentChat\PlaceContext.AgentChat.Infrastructure.csproj" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.16.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.16.0" />
  </ItemGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Auth\templates\*.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\join.sh"
             Link="wwwroot\join.sh"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <EmbeddedResource Include="Wiki\*.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- App owns these edge contracts/read models; Host compiles links while its Blazor shell and
         blocked Dashboard composition remain as migration scaffolding. -->
    <Compile Include="..\PlaceContext.App\Dashboard\*.cs"
             Link="Records\%(Filename)%(Extension)" />
    <Compile Include="..\PlaceContext.App\Wiki\WikiArticle.cs"
             Link="Wiki\WikiArticle.cs" />
    <Compile Include="..\PlaceContext.App\Wiki\WikiLibrary.cs"
             Link="Wiki\WikiLibrary.cs" />
  </ItemGroup>

</Project>
