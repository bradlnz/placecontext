# Licensor activation signing key (secret — never commit)
tools/activation-signing-key.pem

# Locally-built image tarball for k3s import (build artifact)
deploy/*.tar

# Compiled TUI binary (build with: make -C deploy/tui)
deploy/tui/pctl-tui
deploy/tui/dist/

# Release packages (build with: pctl package)
dist/

# Headscale mesh runtime state (templated/generated on the control droplet)
deploy/headscale/*.live.*
deploy/headscale/tenants.list

# Terraform state, plans, local vars (may contain the DO API token) and provider cache
deploy/terraform/.terraform/
deploy/terraform/.terraform.lock.hcl
deploy/terraform/*.tfstate
deploy/terraform/*.tfstate.*
deploy/terraform/*.tfvars
deploy/terraform/*.tfplan
!deploy/terraform/*.tfvars.example
deploy/terraform-app/.terraform/
deploy/terraform-app/.terraform.lock.hcl
deploy/terraform-app/*.tfstate
deploy/terraform-app/*.tfstate.*
deploy/terraform-app/*.tfvars
deploy/terraform-app/*.tfplan
!deploy/terraform-app/*.tfvars.example

# agent worktrees (isolated, never commit)
.claude/worktrees/

